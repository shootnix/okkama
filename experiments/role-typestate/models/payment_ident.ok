// Small model for generic experiments: every state view also narrows to the
// read-only `Identified` role.
module payment_ident;

role Identified { id() is string; }
role Created {
    id() is string;
    authorize() is ^Authorized;
}
role Authorized {
    id() is string;
    capture() is ^Captured;
}
role Captured { id() is string; }

enum Stage = (created, authorized, captured);

object Payment does Identified, Created, Authorized, Captured {
    has key is string;
    has stage is Stage = Stage.created;
    Payment(:key);
    id() is string { key; }
    authorize() is ^Payment { ^stage = Stage.authorized; }
    capture() is ^Payment { ^stage = Stage.captured; }
}

object Payments {
    Payments();
    open(id is string) is Created { Payment(key: id); }
}

// Bounded generic: the body sees only Identified; callers get T back.
object Audit<T: Identified> {
    has value is T;
    Audit(:value);
    label() is string { "audit " + value.id(); }
    get() is T { value; }
}
