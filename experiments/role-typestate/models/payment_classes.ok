// Model for Pattern A: one concrete immutable class per payment state.
// Transitions are ordinary actions constructing the next state object.
module payment_classes;

object Created {
    has id is string;
    has amount is int;
    Created(:id, :amount);
    authorize() is Authorized { Authorized(id: id, amount: amount); }
    decline(reason is string) is Declined { Declined(id: id, reason: reason); }
}

object Authorized {
    has id is string;
    has amount is int;
    Authorized(:id, :amount);
    capture() is Captured { Captured(id: id, amount: amount); }
    describe() is string { "authorized " + id + " " + amount.string(); }
}

object Captured {
    has id is string;
    has amount is int;
    Captured(:id, :amount);
    refund() is Refunded { Refunded(id: id, amount: amount); }
    describe() is string { "captured " + id + " " + amount.string(); }
}

object Refunded {
    has id is string;
    has amount is int;
    Refunded(:id, :amount);
    describe() is string { "refunded " + id + " " + amount.string(); }
}

object Declined {
    has id is string;
    has reason is string;
    Declined(:id, :reason);
    describe() is string { "declined " + id + ": " + reason; }
}

