// Model for Pattern D (hybrid, the recommended shape):
//   * one concrete immutable class `Payment` with a private ADT `stage`
//     carrying per-state data (the authorization code exists only after
//     approval);
//   * roles as state views: each exposes only the operations of its state;
//   * successors for in-class transitions (static must-use);
//   * ADT `Authorization` for alternative outcomes, payloads typed by role;
//   * `confirm` re-checks the stage at runtime for callers that bypass the
//     roles through the concrete class.
module payment_hybrid;

enum InvalidTransition is Error = (invalid_transition(action is string));

enum PaymentError is Error = (payment_error(reason is string));

// What an external gateway answered: boundary data, never trusted as state.
enum GatewayReply = (approved(code is string), declined(reason is string), unavailable(detail is string));

role Gateway {
    authorize(id is string, amount is int) is GatewayReply;
}

enum Stage = (
    created,
    authorized(code is string),
    captured(code is string),
    refunded(code is string),
    declined(reason is string)
);

role Created {
    id() is string;
    authorize(gateway is Gateway) is Authorization;
}
role Authorized {
    id() is string;
    code() is string;
    capture() is ^Captured;
}
role Captured {
    id() is string;
    refund() is ^Refunded;
}
role Refunded { id() is string; }
role Declined {
    id() is string;
    reason() is string;
}

enum Authorization = (
    approved(payment is Authorized),
    declined(payment is Declined),
    failed(error is PaymentError)
);

object Payment does Created, Authorized, Captured, Refunded, Declined {
    has key is string;
    has amount is int;
    has stage is Stage = Stage.created;

    Payment(:key, :amount) {
        confirm self.amount > 0 else throw PaymentError.payment_error("amount must be positive");
    }

    id() is string { key; }

    authorize(gateway is Gateway) is Authorization {
        confirm stage == Stage.created else throw InvalidTransition.invalid_transition("authorize");
        match gateway.authorize(key, amount) {
            case GatewayReply.approved(code) { Authorization.approved(self.approve(code)); }
            case GatewayReply.declined(reason) { Authorization.declined(self.decline(reason)); }
            case GatewayReply.unavailable(detail) { Authorization.failed(PaymentError.payment_error(detail)); }
        }
    }

    code() is string {
        match stage {
            case Stage.authorized(code) { code; }
            else { throw InvalidTransition.invalid_transition("code"); }
        }
    }

    reason() is string {
        match stage {
            case Stage.declined(reason) { reason; }
            else { throw InvalidTransition.invalid_transition("reason"); }
        }
    }

    capture() is ^Payment {
        let code = match stage {
            case Stage.authorized(code) { code; }
            else { throw InvalidTransition.invalid_transition("capture"); }
        };
        ^stage = Stage.captured(code);
    }

    refund() is ^Payment {
        let code = match stage {
            case Stage.captured(code) { code; }
            else { throw InvalidTransition.invalid_transition("refund"); }
        };
        ^stage = Stage.refunded(code);
    }

    // Internal transitions used by authorize(): private successors, callable
    // only through `self`, still guarded at runtime.
    private:
    approve(code is string) is ^Payment {
        confirm stage == Stage.created else throw InvalidTransition.invalid_transition("approve");
        ^stage = Stage.authorized(code);
    }
    decline(reason is string) is ^Payment {
        confirm stage == Stage.created else throw InvalidTransition.invalid_transition("decline");
        ^stage = Stage.declined(reason);
    }
}

// The intended entry point: callers receive the Created view only.
object Payments {
    Payments();
    open(id is string, amount is int) is Created { Payment(key: id, amount: amount); }
}

// Gateways for experiments.
object ApprovingGateway does Gateway {
    ApprovingGateway();
    authorize(id is string, amount is int) is GatewayReply { GatewayReply.approved("auth-" + id); }
}
object DecliningGateway does Gateway {
    DecliningGateway();
    authorize(id is string, amount is int) is GatewayReply { GatewayReply.declined("insufficient funds"); }
}
object DownGateway does Gateway {
    DownGateway();
    authorize(id is string, amount is int) is GatewayReply { GatewayReply.unavailable("gateway timeout"); }
}
