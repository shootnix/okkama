// Model for Pattern C: the payment state is one ADT value; operations take
// the whole state, match it, and either return the next state or throw.
// The type system knows only "PaymentState", never which variant it holds.
module payment_adt;

object InvalidTransition does Error {
    has action is string;
    InvalidTransition(:action);
    text() is string { "invalid transition: " + action; }
}

enum PaymentState = (
    created(id is string),
    authorized(id is string, code is string),
    captured(id is string, code is string),
    refunded(id is string),
    declined(id is string, reason is string)
);

object Processor {
    Processor();

    authorize(state is PaymentState, code is string) is PaymentState {
        match state {
            case PaymentState.created(id) { PaymentState.authorized(id, code); }
            else { throw InvalidTransition(action: "authorize"); }
        }
    }
    capture(state is PaymentState) is PaymentState {
        match state {
            case PaymentState.authorized(id, code) { PaymentState.captured(id, code); }
            else { throw InvalidTransition(action: "capture"); }
        }
    }
    refund(state is PaymentState) is PaymentState {
        match state {
            case PaymentState.captured(id, _) { PaymentState.refunded(id); }
            else { throw InvalidTransition(action: "refund"); }
        }
    }
    describe(state is PaymentState) is string {
        match state {
            case PaymentState.created(id) { "created " + id; }
            case PaymentState.authorized(id, code) { "authorized " + id + " " + code; }
            case PaymentState.captured(id, code) { "captured " + id + " " + code; }
            case PaymentState.refunded(id) { "refunded " + id; }
            case PaymentState.declined(id, reason) { "declined " + id + ": " + reason; }
        }
    }
}
