// Experiment F / Pattern C. capture() on a created state type-checks (the
// parameter type is the whole ADT) and is rejected only at runtime.
// EXPECT: runtime-error: InvalidTransition.invalid_transition("capture")
module app;
import "../models/payment_adt" take Processor, PaymentState;

main() is int {
    let s = Processor().capture(PaymentState.created("p"));
    0;
}
