// Experiment B. `any` is opaque: a boxed role reference cannot be narrowed
// back to another (or the same) role implicitly.
// EXPECT: check-error: Cannot initialize variable "again" of type Authorized with any
module app;
import "../models/payment_views" take Payments, Authorized;

main() is int {
    let boxed is any = Payments().open("p");
    let again is Authorized = boxed;
    0;
}
