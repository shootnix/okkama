// Experiment G / Pattern D. The Created view survives authorization, so the
// same payment can be authorized twice against the external gateway (two
// holds). Neither the type system nor the in-memory stage can see this:
// it needs idempotency / durable state at the gateway or database.
// EXPECT: run-ok
// STDOUT: auth-p|auth-p
module app;
import "io/stdout" take Stdout;
import "../models/payment_hybrid" take Payments, Authorization, ApprovingGateway;

object Show {
    Show();
    code(outcome is Authorization) is string {
        outcome ?? .approved(p): p.code() !! _: "other";
    }
}

main() is int {
    let created = Payments().open("p", 1);
    let first = created.authorize(ApprovingGateway());
    let second = created.authorize(ApprovingGateway());
    Stdout().writeln(Show().code(first));
    Stdout().writeln(Show().code(second));
    0;
}
