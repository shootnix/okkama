// Experiment B / Pattern B1. A `take` import exposes only the listed names;
// the state class is not a binding. (A plain import of the same module would
// still expose it as `payment_roles.SettledCharge`, see b_forge_state_class.)
// EXPECT: check-error: Undefined action "SettledCharge"
module app;
import "../models/payment_roles" take Payments;

main() is int {
    let c = SettledCharge(key: "forged");
    0;
}
