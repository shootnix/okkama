// Experiment G. Passing a successor through a generic container consumes the
// obligation (field bind) and `get()` returns a plain T: the result can then
// be discarded. The role restriction (T = Authorized) survives (see
// negative/b_generic_box), but the must-use property does not.
// Violation remains possible.
// EXPECT: run-ok
module app;
import "../models/payment_views" take Payments;

object Box<T> {
    has value is T;
    Box(:value);
    get() is T { value; }
}

main() is int {
    Box(value: Payments().open("p").authorize()).get();
    0;
}
