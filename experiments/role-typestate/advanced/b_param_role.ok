// Experiment B. A role-typed parameter exposes only the role's actions even
// when the argument is the concrete class that implements every role.
// EXPECT: check-error: Role "Authorized" has no action "refund"
module app;
import "../models/payment_views";

object Desk {
    Desk();
    settle(payment is payment_views.Authorized) is string {
        let r = payment.refund();
        "x";
    }
}

main() is int { 0; }
