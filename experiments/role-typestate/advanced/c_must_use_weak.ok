// Experiment C9 / Pattern B2. "Must use" is satisfied by ANY consumption:
// a read-only receiver call (id()), or boxing into `any`, discharges the
// obligation without the next state ever being acted upon.
// EXPECT: run-ok
// STDOUT: p
module app;
import "io/stdout" take Stdout;
import "../models/payment_views" take Payments;

main() is int {
    let authorized = Payments().open("p").authorize();
    Stdout().writeln(authorized.id());
    let boxed is any = Payments().open("q").authorize();
    0;
}
