// Experiment B / Pattern B2. A caller that names the concrete class gets the
// union of all state operations: interface restriction is bypassed
// statically. Only the runtime `confirm` on the private `stage` field stops
// capture() on a fresh payment.
// EXPECT: runtime-error: InvalidTransition.invalid_transition("capture")
module app;
import "../models/payment_views";

main() is int {
    let p = payment_views.Payment(key: "p");
    let captured = p.capture();
    captured.id();
    0;
}
