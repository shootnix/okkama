// Experiment E. Maybe<Role>: a role-typed state can be optional. Fallback
// extraction (`else throw`) and compact choices keep the static role type.
// The successor obligation of authorize() is consumed by packing it into
// Maybe.some(...).
// EXPECT: run-ok
// STDOUT: captured p|no payment
module app;
import "io/stdout" take Stdout;
import "../models/payment_views" take Payments, Authorized, InvalidTransition;

object Lookup {
    Lookup();
    find(id is string) is Maybe<Authorized> {
        if id == "p" { Maybe.some(Payments().open(id).authorize()); } else { Maybe<Authorized>.none; }
    }
}

main() is int {
    let out = Stdout();
    let found = Lookup().find("p") else throw InvalidTransition.invalid_transition("lookup");
    out.writeln("captured " + found.capture().id());
    let text = Lookup().find("x")
        ?? .some(payment): "captured " + payment.capture().id()
        !! .none: "no payment";
    out.writeln(text);
    0;
}
