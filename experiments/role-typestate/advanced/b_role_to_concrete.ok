// Experiment B / Pattern B2. A role reference never converts back to the
// concrete class (no downcast).
// EXPECT: check-error: Cannot initialize variable "full" of type Payment with Created
module app;
import "../models/payment_views";

main() is int {
    let created = payment_views.Payments().open("p");
    let full is payment_views.Payment = created;
    0;
}
