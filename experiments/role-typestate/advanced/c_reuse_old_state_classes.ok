// Experiment C7/C8 / Pattern A. Same result with class-per-state.
// EXPECT: run-ok
// STDOUT: captured p 1|captured p 1
module app;
import "io/stdout" take Stdout;
import "../models/payment_classes" take Created;

main() is int {
    let authorized = Created(id: "p", amount: 1).authorize();
    Stdout().writeln(authorized.capture().describe());
    Stdout().writeln(authorized.capture().describe());
    0;
}
