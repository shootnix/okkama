// Experiment B (adversarial). An object that does Error is rejected outright
// (errors are error enums), so a role reference can never carry a throwable
// object: the escape through throw/catch cannot be written.
// EXPECT: check-error: Object "Payment" cannot do Error: errors are enums, declare `enum Payment is Error = (...)`
module app;

role Created {
    text() is string;
    authorize() is string;
}
object Payment does Created, Error {
    Payment();
    text() is string { "payment"; }
    authorize() is string { "authorized"; }
    capture() is string { "captured via catch"; }
}

main() is int {
    let created is Created = Payment();
    try {
        throw created;
    } catch e is Payment {
        let x = e.capture();
    }
    0;
}
