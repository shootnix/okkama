// Experiment D. A generic ADT carries a role-typed payload: T is inferred as
// the role (Authorized), and the extracted value keeps that static type.
// EXPECT: run-ok
// STDOUT: captured p
module app;
import "io/stdout" take Stdout;
import "../models/payment_hybrid" take Payments, Authorization, Authorized, ApprovingGateway, PaymentError;

enum Outcome<T> = (ok(value is T), err(error is PaymentError));

object Step {
    Step();
    approved(outcome is Authorization) is Outcome<Authorized> {
        match outcome {
            case Authorization.approved(payment) { Outcome.ok(payment); }
            case Authorization.declined(payment) { Outcome<Authorized>.err(PaymentError(reason: payment.reason())); }
            case Authorization.failed(error) { Outcome<Authorized>.err(error); }
        }
    }
}

main() is int {
    let result = Step().approved(Payments().open("p", 1).authorize(ApprovingGateway()));
    let text = result
        ?? .ok(payment): "captured " + payment.capture().id()
        !! .err(error): "error " + error.text();
    Stdout().writeln(text);
    0;
}
