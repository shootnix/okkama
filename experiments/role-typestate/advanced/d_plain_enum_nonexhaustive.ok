// Experiment D. Payload-free enums keep the legacy rule: a statement match
// without all cases (and without else) is accepted. Only enums that the
// checker treats as variant enums enforce exhaustiveness. `okkama lint`
// reports it as warning[non-exhaustive-match].
// EXPECT: run-ok
// STDOUT: created
module app;
import "io/stdout" take Stdout;

enum Stage = (created, authorized, captured);

main() is int {
    let stage = Stage.created;
    match stage {
        case Stage.created { Stdout().writeln("created"); }
        case Stage.authorized { Stdout().writeln("authorized"); }
    }
    0;
}
