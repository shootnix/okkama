// Experiment D. The ADT outcome of authorize() is an ordinary value: it can be
// discarded. Exhaustiveness forces handling only when the caller matches.
// (The successor obligations created inside authorize() were consumed by
// packing them into the enum.) Violation remains possible.
// EXPECT: run-ok
module app;
import "../models/payment_hybrid" take Payments, ApprovingGateway;

main() is int {
    Payments().open("p", 1).authorize(ApprovingGateway());
    0;
}
