// Experiment E. Optional authorization token as boundary data: the gateway may
// or may not return a token. Maybe models the data, not the state: the state
// transition (approve) happens only when a token is present.
// EXPECT: run-ok
// STDOUT: approved with tok-1|declined: no token
module app;
import "io/stdout" take Stdout;
import "../models/payment_hybrid" take Payments, Authorization, Gateway, GatewayReply;

object TokenGateway does Gateway {
    has token is Maybe<string>;
    TokenGateway(:token);
    authorize(id is string, amount is int) is GatewayReply {
        token ?? .some(t): GatewayReply.approved(t) !! .none: GatewayReply.declined("no token");
    }
}

object Report {
    Report();
    text(outcome is Authorization) is string {
        outcome
            ?? .approved(p): "approved with " + p.code()
            !! .declined(p): "declined: " + p.reason()
            !! .failed(e): "failed: " + e.text();
    }
}

main() is int {
    let out = Stdout();
    out.writeln(Report().text(Payments().open("a", 1).authorize(TokenGateway(token: Maybe.some("tok-1")))));
    out.writeln(Report().text(Payments().open("b", 1).authorize(TokenGateway(token: Maybe<string>.none))));
    0;
}
