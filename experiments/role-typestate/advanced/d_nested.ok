// Experiment D. Nested ADTs model a longer workflow: a settlement either
// completed with a Captured payment or must retry after another Authorization.
// Each level is matched separately (nested patterns are not supported).
// EXPECT: run-ok
// STDOUT: settled p|retry: declined insufficient funds
module app;
import "io/stdout" take Stdout;
import "../models/payment_hybrid" take Payments, Authorization, Captured, Gateway, ApprovingGateway, DecliningGateway;

enum Settlement = (settled(payment is Captured), retry(after is Authorization));

object Settler {
    Settler();
    settle(id is string, gateway is Gateway) is Settlement {
        let outcome = Payments().open(id, 1).authorize(gateway);
        match outcome {
            case Authorization.approved(payment) { Settlement.settled(payment.capture()); }
            else { Settlement.retry(outcome); }
        }
    }
    describe(settlement is Settlement) is string {
        match settlement {
            case Settlement.settled(payment) { "settled " + payment.id(); }
            case Settlement.retry(after) {
                let why = match after {
                    case Authorization.declined(payment) { "declined " + payment.reason(); }
                    case Authorization.failed(error) { "failed " + error.text(); }
                    case Authorization.approved(payment) { "approved " + payment.id(); }
                };
                "retry: " + why;
            }
        }
    }
}

main() is int {
    let s = Settler();
    Stdout().writeln(s.describe(s.settle("p", ApprovingGateway())));
    Stdout().writeln(s.describe(s.settle("q", DecliningGateway())));
    0;
}
