// Experiment G / Pattern D. Assigning a fresh concrete Payment to the
// Authorized view type-checks (Payment does Authorized); reading the
// authorization code fails at runtime because no code exists yet.
// EXPECT: runtime-error: invalid transition: code
module app;
import "../models/payment_hybrid";

main() is int {
    let view is payment_hybrid.Authorized = payment_hybrid.Payment(key: "p", amount: 1);
    let code = view.code();
    0;
}
