// Experiment B / Pattern B2. A concrete Payment may be assigned to ANY role it
// does, so a freshly created payment can be viewed as `Authorized` without
// any authorization: the role is a claim, not evidence of state. The static
// check passes; the private stage + confirm rejects it at runtime.
// EXPECT: runtime-error: invalid transition: capture
module app;
import "../models/payment_views";

main() is int {
    let forged is payment_views.Authorized = payment_views.Payment(key: "p");
    let captured = forged.capture();
    captured.id();
    0;
}
