// Experiment E. Presence<Role>: missing / none / some states over a role-typed
// value. Compact choice keeps the role type in .some; fold() explicitly merges
// missing and none into Maybe.none.
// EXPECT: run-ok
// STDOUT: some p|none|missing|folded: absent
module app;
import "io/stdout" take Stdout;
import "../models/payment_views" take Payments, Authorized;

object Describe {
    Describe();
    show(value is Presence<Authorized>) is string {
        value
            ?? .some(payment): "some " + payment.capture().id()
            !! .none: "none"
            !! .missing: "missing";
    }
}

main() is int {
    let out = Stdout();
    let present is Presence<Authorized> = Presence.some(Payments().open("p").authorize());
    out.writeln(Describe().show(present));
    out.writeln(Describe().show(Presence<Authorized>.none));
    out.writeln(Describe().show(Presence<Authorized>.missing));
    let folded = Presence<Authorized>.missing.fold()
        ?? .some(payment): "folded: " + payment.id()
        !! .none: "folded: absent";
    out.writeln(folded);
    0;
}
