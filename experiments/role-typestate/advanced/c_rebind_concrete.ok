// Experiment C6 / Pattern B2. Through the concrete class, rebinding to the
// successor is legal (`payment = payment.authorize();`): the name "moves"
// to the new state, which is the closest existing idiom to consumption. It is
// a convention: another alias can still hold the old state.
// EXPECT: run-ok
// STDOUT: p
module app;
import "io/stdout" take Stdout;
import "../models/payment_views";

main() is int {
    let payment = payment_views.Payment(key: "p");
    let old = payment;
    payment = payment.authorize();
    payment = payment.capture();
    Stdout().writeln(old.id());
    let again = old.authorize();
    again.id();
    payment.id();
    0;
}
