// Experiment C7/C8 / Pattern B2. The old immutable state remains usable after
// a transition, and the same Authorized value can be captured twice. Each
// successor is a fresh object; the runtime `confirm` checks only the stage of
// the receiver, which never changes. Double authorization and double capture
// are NOT prevented statically or by the in-memory runtime check.
// EXPECT: run-ok
// STDOUT: p|p|p|p
module app;
import "io/stdout" take Stdout;
import "../models/payment_views" take Payments;

main() is int {
    let out = Stdout();
    let created = Payments().open("p");
    let first = created.authorize();
    let second = created.authorize();
    let c1 = first.capture();
    let c2 = first.capture();
    out.writeln(second.id());
    out.writeln(c1.id());
    out.writeln(c2.id());
    out.writeln(created.id());
    0;
}
