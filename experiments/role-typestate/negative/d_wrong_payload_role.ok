// Experiment D / Pattern D. A Created view cannot be packed as an approved (Authorized) outcome.
// EXPECT: check-error: Variant payload must be Authorized, got Created
module app;
import "../models/payment_hybrid" take Payments, Authorization, ApprovingGateway;

main() is int {
    let outcome = Payments().open("p", 1).authorize(ApprovingGateway());
    let forged = Authorization.approved(Payments().open("q", 1));
    0;
}
