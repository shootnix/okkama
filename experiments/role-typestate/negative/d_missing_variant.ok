// Experiment D / Pattern D. A match that forgets the failed outcome is rejected.
// EXPECT: check-error: Non-exhaustive match: missing failed
module app;
import "../models/payment_hybrid" take Payments, Authorization, ApprovingGateway;

main() is int {
    let outcome = Payments().open("p", 1).authorize(ApprovingGateway());
    let s = match outcome {
        case Authorization.approved(payment) { payment.id(); }
        case Authorization.declined(payment) { payment.reason(); }
    };
    0;
}
