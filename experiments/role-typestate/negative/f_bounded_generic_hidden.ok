// Experiment G / generics. After the bounded generic round trip T is still
// Authorized: authorize() remains hidden.
// EXPECT: check-error: Role "Authorized" has no action "authorize"
module app;
import "../models/payment_ident" take Payments, Audit;

main() is int {
    let audit = Audit(value: Payments().open("p").authorize());
    let again = audit.get().authorize();
    0;
}
