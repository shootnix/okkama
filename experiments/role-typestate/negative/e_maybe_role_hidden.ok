// Experiment E. Extracting from Maybe<Authorized> keeps the Authorized type;
// refund() remains hidden.
// EXPECT: check-error: Role "Authorized" has no action "refund"
module app;
import "../models/payment_views" take Payments, Authorized, InvalidTransition;

main() is int {
    let maybe is Maybe<Authorized> = Maybe.some(Payments().open("p").authorize());
    let found = maybe else throw InvalidTransition.invalid_transition("lookup");
    let r = found.refund();
    0;
}
