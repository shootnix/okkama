// Experiment C9 / Pattern B2. The obligation is path-sensitive: consuming the
// successor in only one branch still leaves it pending on the other path.
// EXPECT: check-error: Successor action result must be used
module app;
import "../models/payment_views" take Payments;

main() is int {
    let authorized = Payments().open("p").authorize();
    if 1 > 2 {
        let c = authorized.capture();
        c.id();
    }
    0;
}
