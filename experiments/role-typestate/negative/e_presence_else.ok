// Experiment E. Presence<T> has no direct fallback: the caller must choose a
// policy (fold() or a three-way choice), so missing cannot silently become a
// state.
// EXPECT: check-error: Optional fallback requires Maybe<T>
module app;
import "../models/payment_views" take Payments, Authorized, InvalidTransition;

main() is int {
    let p is Presence<Authorized> = Presence<Authorized>.missing;
    let a = p else throw InvalidTransition(action: "x");
    0;
}
