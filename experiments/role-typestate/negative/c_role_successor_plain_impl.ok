// Experiment C3. A role transition declared `is ^Authorized` cannot be
// implemented by an ordinary action that constructs another class: role
// conformance requires a successor (^Self where Self does Authorized).
// EXPECT: check-error: must return ^Authorized for role "Created"
module app;

role Authorized { capture() is string; }
role Created { authorize() is ^Authorized; }
object Held does Authorized {
    Held();
    capture() is string { "captured"; }
}
object Fresh does Created {
    Fresh();
    authorize() is Authorized { Held(); }
}

main() is int { 0; }
