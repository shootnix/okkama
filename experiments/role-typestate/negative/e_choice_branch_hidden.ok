// Experiment E. Inside a compact choice branch the payload keeps its role type.
// EXPECT: check-error: Role "Authorized" has no action "authorize"
module app;
import "../models/payment_views" take Payments, Authorized;

main() is int {
    let maybe is Maybe<Authorized> = Maybe.some(Payments().open("p").authorize());
    let text = maybe ?? .some(p): p.authorize().id() !! .none: "none";
    0;
}
