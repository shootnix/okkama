// Experiment G. A successor bound as an action value: does its call still
// carry the must-use obligation? Yes: discarding the call is rejected.
// EXPECT: check-error: Successor action result must be used
module app;
import "../models/payment_views" take Payments;

main() is int {
    let authorized = Payments().open("p").authorize();
    let capture = authorized.capture;
    capture();
    0;
}
