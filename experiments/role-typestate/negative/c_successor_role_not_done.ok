// Experiment C2. `is ^SomeRole` on an object that does not even do the role
// is rejected by the same rule (before the fix: internal compiler error).
// EXPECT: check-error: Successor action "authorize" on object "Created" must return ^Created
module app;

role Authorized { capture() is string; }
object Created {
    has authorized is bool = false;
    Created();
    authorize() is ^Authorized { ^authorized = true; }
}

main() is int {
    let a = Created().authorize();
    let s = a.capture();
    0;
}
