// Experiment C6 / Pattern B2. Rebinding the same variable to the next state
// is rejected: rebinding keeps the variable's declared state type, so a
// variable can never silently change from Created to Authorized.
// EXPECT: check-error: Cannot rebind variable "payment": role type "Created" cannot be rebound; bind the next state to a new name
module app;
import "../models/payment_views" take Payments;

main() is int {
    let payment = Payments().open("p");
    payment = payment.authorize();
    0;
}
