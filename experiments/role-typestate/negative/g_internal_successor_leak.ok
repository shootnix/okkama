// Experiment G / Pattern D. The internal transition approve() is a private
// successor, so even a caller that names the concrete `Payment` cannot
// authorize without a gateway. (Before private successors were allowed it
// was public and this program ran, printing the forged code.)
// EXPECT: check-error: Action "approve" on object "Payment" is private
module app;
import "io/stdout" take Stdout;
import "../models/payment_hybrid";

main() is int {
    let authorized = payment_hybrid.Payment(key: "p", amount: 1).approve("forged");
    Stdout().writeln(authorized.code());
    0;
}
