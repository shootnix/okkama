// Experiment C3. Implementing a role successor `^Authorized` with `^Self`
// requires Self to do Authorized as well.
// EXPECT: check-error: must return ^Authorized for role "Created"
module app;

role Authorized { capture() is string; }
role Created { authorize() is ^Authorized; }
object Fresh does Created {
    has done is bool = false;
    Fresh();
    authorize() is ^Fresh { ^done = true; }
}

main() is int { 0; }
