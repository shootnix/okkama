// Experiment B (adversarial), closed by the language. Originally a role that
// exposes text() could be narrowed to Error, thrown, and caught as the
// concrete class, recovering every hidden action. Objects can no longer do
// Error (errors are error enums), so the escape cannot be written: the class
// is rejected at its declaration.
// EXPECT: check-error: Object "Payment" cannot do Error: errors are enums, declare `enum Payment is Error = (...)`
module app;
import "io/stdout" take Stdout;

role Created {
    text() is string;
    authorize() is string;
}
object Payment does Created, Error {
    Payment();
    text() is string { "payment"; }
    authorize() is string { "authorized"; }
    capture() is string { "captured via catch"; }
}

main() is int {
    let created is Created = Payment();
    let error is Error = created;
    try {
        throw error;
    } catch e is Payment {
        Stdout().writeln(e.capture());
    }
    0;
}
