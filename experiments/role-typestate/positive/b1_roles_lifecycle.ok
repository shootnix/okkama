// Experiment A / Pattern B1: roles define per-state operations; ordinary
// actions declared `is NextRole` construct a different concrete class.
// Answers the preliminary question for NON-successor actions: a role-typed
// result may be produced by constructing any class that `does` the role.
// EXPECT: run-ok
// STDOUT: authorized p1|captured p1|refunded p1|declined p2: no funds
module app;
import "io/stdout" take Stdout;
import "../models/payment_roles" take Payments, Created, Authorized, Captured, Refunded;

main() is int {
    let out = Stdout();
    let created is Created = Payments().open("p1");
    let authorized is Authorized = created.authorize();
    out.writeln("authorized " + authorized.id());
    let captured is Captured = authorized.capture();
    out.writeln("captured " + captured.id());
    let refunded is Refunded = captured.refund();
    out.writeln("refunded " + refunded.id());
    let declined = Payments().open("p2").decline("no funds");
    out.writeln("declined " + declined.id() + ": " + declined.reason());
    0;
}
