// Experiment A+C / Pattern B2: one class, roles as state views, successors
// declared on roles as `^NextRole`. Calling a successor through a role
// returns a restricted `^NextRole` reference (covariant successor result).
// EXPECT: run-ok
// STDOUT: authorized p1|captured p1|refunded p1
module app;
import "io/stdout" take Stdout;
import "../models/payment_views" take Payments, Created, Authorized, Captured, Refunded;

main() is int {
    let out = Stdout();
    let created is Created = Payments().open("p1");
    let authorized is Authorized = created.authorize();
    out.writeln("authorized " + authorized.id());
    let captured = authorized.capture();
    out.writeln("captured " + captured.id());
    let refunded = captured.refund();
    out.writeln("refunded " + refunded.id());
    0;
}
