// Experiment G / generics. A bounded generic `Audit<T: Identified>` accepts
// any state view that narrows to Identified and returns it with its exact
// role type: T = Authorized keeps capture() available after the round trip.
// Before the fix, IR lowering of the bound call `value.id()` on a ROLE-typed
// T failed with "builtin role adapters ... not implemented".
// EXPECT: run-ok
// STDOUT: audit p|p
module app;
import "io/stdout" take Stdout;
import "../models/payment_ident" take Payments, Audit;

main() is int {
    let audit = Audit(value: Payments().open("p").authorize());
    Stdout().writeln(audit.label());
    Stdout().writeln(audit.get().capture().id());
    0;
}
