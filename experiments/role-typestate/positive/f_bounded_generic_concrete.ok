// Experiment G / generics. Control for advanced/f_bounded_generic_role: the
// same bounded generic works when T is the concrete class. Note that T is
// then the full Payment type, so a concrete value keeps every action.
// EXPECT: run-ok
// STDOUT: audit p|p
module app;
import "io/stdout" take Stdout;
import "../models/payment_ident";

main() is int {
    let audit = payment_ident.Audit(value: payment_ident.Payment(key: "p"));
    Stdout().writeln(audit.label());
    Stdout().writeln(audit.get().authorize().capture().id());
    0;
}
