// Experiment F / Pattern C (ADT state). Valid sequence runs; every operation
// accepts any PaymentState, so validity is checked only at runtime.
// EXPECT: run-ok
// STDOUT: authorized p a1|captured p a1|refunded p
module app;
import "io/stdout" take Stdout;
import "../models/payment_adt" take Processor, PaymentState;

main() is int {
    let out = Stdout();
    let pr = Processor();
    let authorized = pr.authorize(PaymentState.created("p"), "a1");
    out.writeln(pr.describe(authorized));
    let captured = pr.capture(authorized);
    out.writeln(pr.describe(captured));
    out.writeln(pr.describe(pr.refund(captured)));
    0;
}
