// Experiment B / generics. Control: narrowing a state view to the read-only
// Identified role works outside generics.
// EXPECT: run-ok
// STDOUT: p
module app;
import "io/stdout" take Stdout;
import "../models/payment_ident" take Payments, Identified;

main() is int {
    let authorized = Payments().open("p").authorize();
    let ident is Identified = authorized;
    Stdout().writeln(ident.id());
    0;
}
