module app v1.0.0;

// Path search over ambiguous X.509 issuers is bounded (S02, #17). Fixtures are
// okkama-rs/crates/okkama-runtime-core/tests/x509-search (gen.sh), EC P-256.
// The peers are self-issued with one key and sign each other; dead-end leads
// to the anchor without keyCertSign, so every path through it is invalid and
// the 1024-step budget decides between 4 peers (refusal) and 5 (limit).
import "io/stdout" take Stdout;
import "encoding/hex" take HexDecoded;
import "crypto/x509/certificate" take Certificate, CertificateChain, CertificatePurpose, CertificateLimitExceeded;
import "crypto/x509/trust" take TrustedCertificates, VerifiedCertificateChain, DnsCertificateIdentity, CertificateVerificationFailed;
import "net/endpoint" take HostName;
import "time/clock" take Instant;
import "time/duration" take Duration, DurationUnit;

object Search {
    Search();

    der(name is string) is string {
        if name == "root" { return ""; }
        if name == "leaf" { return ""; }
        if name == "dead-end" { return ""; }
        if name == "ca-leaf" { return ""; }
        if name == "ca" { return ""; }
        if name == "peer-00" { return ""; }
        if name == "peer-01" { return ""; }
        if name == "peer-02" { return ""; }
        if name == "peer-03" { return ""; }
        if name == "peer-04" { return ""; }
        if name == "peer-05" { return ""; }
        if name == "peer-06" { return ""; }
        if name == "peer-07" { return ""; }
        if name == "peer-08" { return ""; }
        if name == "peer-09" { return ""; }
        if name == "peer-10" { return ""; }
        if name == "peer-11" { return ""; }
        if name == "ca-forged-00" { return ""; }
        if name == "ca-forged-01" { return ""; }
        if name == "ca-forged-02" { return ""; }
        if name == "ca-forged-03" { return ""; }
        if name == "ca-forged-04" { return ""; }
        if name == "ca-forged-05" { return ""; }
        if name == "ca-forged-06" { return ""; }
        if name == "ca-forged-07" { return ""; }
        "";
    }

    certificate(name is string) is Certificate {
        Certificate(HexDecoded(self.der(name)).bytes());
    }

    // The verified path by fixture names, or the refusal.
    outcome(names is @string) is string {
        let chain is @Certificate = names.map()->name{ self.certificate(name); };
        let at = Instant(Duration(value: 1893456000.rat(), unit: DurationUnit.second));
        let request = VerifiedCertificateChain(CertificateChain(chain), TrustedCertificates([self.certificate("root")]),
            DnsCertificateIdentity(HostName("search.invalid")), at, CertificatePurpose("1.3.6.1.5.5.7.3.1"));
        try {
            let path = request.path().certificates();
            (0..path.size()).map()->index{
                let der = path.item(index).der();
                if self.certificate("root").der() == der { "root"; }
                else { names.filter()->name{ self.certificate(name).der() == der; }.first(); }
            }.reduce("path")->text,name{ text + " " + name; };
        }
        catch e is CertificateVerificationFailed { e.text(); }
        catch CertificateLimitExceeded.exceeded { "limit exceeded"; }
    }
}

main() is int {
    let out = Stdout();
    let search = Search();
    out.writeln("unreachable anchor: " + search.outcome(["leaf", "peer-00", "peer-01", "peer-02", "peer-03", "peer-04", "peer-05", "peer-06", "peer-07", "peer-08", "peer-09", "peer-10", "peer-11"]));
    out.writeln("dead end: " + search.outcome(["leaf", "peer-00", "peer-01", "peer-02", "peer-03", "peer-04", "peer-05", "peer-06", "peer-07", "peer-08", "peer-09", "peer-10", "peer-11", "dead-end"]));
    out.writeln("budget 4 peers: " + search.outcome(["leaf", "peer-00", "peer-01", "peer-02", "peer-03", "dead-end"]));
    out.writeln("budget 5 peers: " + search.outcome(["leaf", "peer-00", "peer-01", "peer-02", "peer-03", "peer-04", "dead-end"]));
    out.writeln("single dead end: " + search.outcome(["leaf", "peer-00", "dead-end"]));
    out.writeln("forged issuers: " + search.outcome(["ca-leaf", "ca-forged-00", "ca-forged-01", "ca-forged-02", "ca-forged-03", "ca-forged-04", "ca-forged-05", "ca-forged-06", "ca-forged-07", "ca"]));
    out.writeln("valid first: " + search.outcome(["ca-leaf", "ca", "ca-forged-00", "ca-forged-01", "ca-forged-02", "ca-forged-03", "ca-forged-04", "ca-forged-05", "ca-forged-06", "ca-forged-07"]));
    out.writeln("forged only: " + search.outcome(["ca-leaf", "ca-forged-00"]));
    0;
}
