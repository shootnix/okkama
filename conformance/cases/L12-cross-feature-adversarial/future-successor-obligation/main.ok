module app v1.0.0;

import "io/stdout" take Stdout;

object Counter {
    has n is int;
    Counter(:n);
    async bumped() is ^Counter { ^n = n + 1; }
    n() is int { n; }
}

async main() is int {
    let updated = await Counter(n: 1).bumped();
    Stdout().writeln(updated.n().string());
    0;
}
