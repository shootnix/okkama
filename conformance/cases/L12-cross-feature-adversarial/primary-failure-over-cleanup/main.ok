module app v1.0.0;

import "io/stdout" take Stdout;
import "db/sqlite" take SqliteMemory;
import "db/transaction" take TransactionOptions;
import "db/statement" take Statement;
import "db/value" take DbText;
import "db/error" take DbFailure;

enum CleanupFailed is Error = (cleanup_failed);

object Cleaner {
    Cleaner();
    fail() is void {
        Stdout().writeln("cleanup ran");
        throw CleanupFailed.cleanup_failed;
    }
}

async main() is int {
    let connection = await SqliteMemory().connection();
    defer await connection.settled();
    defer connection.close();
    await connection.execution(Statement("CREATE TABLE users(email TEXT UNIQUE)"));
    await connection.execution(Statement(text: "INSERT INTO users VALUES(?)", values: [DbText("a@x")]));
    let outcome = try {
        let tx = await connection.transaction(TransactionOptions());
        defer Cleaner().fail();
        await tx.execution(Statement(text: "INSERT INTO users VALUES(?)", values: [DbText("a@x")]));
        let done = await tx.commit();
        "committed";
    } catch e is DbFailure {
        "primary database failure";
    } catch e is CleanupFailed {
        "cleanup failure won";
    };
    Stdout().writeln(outcome);
    0;
}
