module app v1.0.0;

import "io/stdout" take Stdout;
import "json" take Json, JsonField, ParsedJson;
import "db/sqlite" take SqliteMemory;
import "db/statement" take Statement;
import "db/value" take DbDecimal, ObservedDbValue;
import "math/decimal" take Decimal;

async main() is int {
    let request = ParsedJson(origin: "{\"amount\": 123456789012345678901234567890.000000001}").value();
    let amount is Decimal = request.number("amount");
    let connection = await SqliteMemory().connection();
    defer await connection.settled();
    defer connection.close();
    await connection.execution(Statement("CREATE TABLE ledger(amount TEXT)"));
    await connection.execution(Statement("INSERT INTO ledger VALUES(?)", [DbDecimal(amount)]));
    let rows = await connection.rows(Statement("SELECT amount FROM ledger"));
    let row = await rows.row();
    rows.close();
    let restored = Decimal(ObservedDbValue(row.value("amount")).text());
    let reply = (Json(fields: [JsonField("amount", Json(value: restored))])).string();
    let reparsed is Decimal = ParsedJson(origin: reply).value().number("amount");
    Stdout().writeln(reparsed.coefficient().string() + " e" + reparsed.exponent().string());
    0;
}
