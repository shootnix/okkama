module app v1.0.0;

import "io/stdout" take Stdout;
import "async/channel" take Channel, Sending, Receiving, ChannelClosed, InvalidChannelCapacity;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "async/collect" take AllFutures, Raced, NoFutures;
import "async/cancellation" take Cancellation, Cancelling;
import "async/atomic" take Atomic;

object Job {
    has name is string;
    has result is int;
    Job(:name, :result);
    async run() is int {
        Stdout().writeln("running " + name);
        result;
    }
}

object Quiet {
    has result is int;
    Quiet(:result);
    async run() is int { result; }
}

object Broken does Error {
    Broken();
    text() is string { "broken"; }
}

object Failing {
    Failing();
    async run() is int {
        Stdout().writeln("failing body");
        throw Broken();
    }
}

object Values {
    Values();
    async v(label is string, value is int) is int {
        Stdout().writeln(label);
        value;
    }
    async flag(label is string, value is bool) is bool {
        Stdout().writeln(label);
        value;
    }
    async log(text is string) is void {
        Stdout().writeln(text);
    }
}

async main() is int {
    let out = Stdout();
    let cell is Atomic<int> = Atomic(value: 1);
    cell.replace(5);
    let first = cell.compare_and_replace(5, 6);
    let second = cell.compare_and_replace(5, 7);
    out.writeln(cell.value().string());
    out.writeln((if first { "swapped"; } else { "kept"; }) + " " + (if second { "swapped"; } else { "kept"; }));
    0;
}
