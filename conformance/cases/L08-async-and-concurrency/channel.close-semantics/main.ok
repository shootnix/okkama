module app v1.0.0;

import "io/stdout" take Stdout;
import "async/channel" take Channel, Sending, Receiving, ChannelClosed, InvalidChannelCapacity;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "async/collect" take AllFutures, Raced, NoFutures;
import "async/cancellation" take Cancellation, Cancelling;
import "async/atomic" take Atomic;

object Job {
    has name is string;
    has result is int;
    Job(:name, :result);
    async run() is int {
        Stdout().writeln("running " + name);
        result;
    }
}

object Quiet {
    has result is int;
    Quiet(:result);
    async run() is int { result; }
}

object Broken does Error {
    Broken();
    text() is string { "broken"; }
}

object Failing {
    Failing();
    async run() is int {
        Stdout().writeln("failing body");
        throw Broken();
    }
}

object Values {
    Values();
    async v(label is string, value is int) is int {
        Stdout().writeln(label);
        value;
    }
    async flag(label is string, value is bool) is bool {
        Stdout().writeln(label);
        value;
    }
    async log(text is string) is void {
        Stdout().writeln(text);
    }
}

async main() is int {
    let out = Stdout();
    let channel is Channel<int> = Channel(capacity: 2);
    let sending = channel.sending();
    await sending.send(5);
    sending.close();
    sending.close();
    let first = await channel.receiving().item();
    let drained = try { await channel.receiving().item(); } catch e is ChannelClosed { -1; };
    let late_send = try { await sending.send(6); 0; } catch e is ChannelClosed { -2; };
    out.writeln(first.string() + " " + drained.string() + " " + late_send.string());
    0;
}
