module app v1.0.0;

import "io/stdout" take Stdout;
import "async/event" take Event;

object Waiter {
    has gate is Event;
    has id is int;
    Waiter(:gate, :id);
    async run() is int {
        await gate.wait();
        Stdout().writeln("woke " + id.string());
        id;
    }
}

async main() is int {
    let gate = Event();
    let first = spawn Waiter(gate: gate, id: 1).run();
    let second = spawn Waiter(gate: gate, id: 2).run();
    let third = spawn Waiter(gate: gate, id: 3).run();
    gate.set();
    Stdout().writeln("main: set returned");
    Stdout().writeln("sum " + ((await first) + (await second) + (await third)).string());
    0;
}
