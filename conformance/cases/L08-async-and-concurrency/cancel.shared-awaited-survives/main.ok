module app v1.0.0;

import "io/stdout" take Stdout;
import "async/event" take Event;

object Child {
    has started is Event;
    has never is Event;
    has release is Event;
    Child(:started, :never, :release);
    async run() is int {
        defer await self.settle();
        started.set();
        await never.wait();
        1;
    }
    async settle() is void {
        await release.wait();
        Stdout().writeln("child settled");
    }
}

object Parent {
    has pending is Future<int>;
    Parent(:pending);
    async run() is int {
        await pending;
    }
}

object Watcher {
    has pending is Future<int>;
    Watcher(:pending);
    async run() is int {
        await pending;
    }
}

async main() is int {
    let started = Event();
    let never = Event();
    let release = Event();
    let child = spawn Child(started: started, never: never, release: release).run();
    let watcher = spawn Watcher(pending: child).run();
    let parent = spawn Parent(pending: child).run();
    await started.wait();
    parent.cancel();
    Stdout().writeln("cancel requested");
    let r = try { await parent; } catch e is Cancelled { -1; };
    Stdout().writeln(r.string());
    release.set();
    never.set();
    Stdout().writeln((await watcher).string());
    Stdout().writeln((await child).string());
    0;
}
