module app v1.0.0;

import "io/stdout" take Stdout;

object Job {
    has name is string;
    has result is int;
    Job(:name, :result);
    async run() is int {
        Stdout().writeln("running " + name);
        result;
    }
}

object Quiet {
    has result is int;
    Quiet(:result);
    async run() is int { result; }
}

object Broken does Error {
    Broken();
    text() is string { "broken"; }
}

object Failing {
    Failing();
    async run() is int {
        Stdout().writeln("failing body");
        throw Broken();
    }
}

object Values {
    Values();
    async v(label is string, value is int) is int {
        Stdout().writeln(label);
        value;
    }
    async flag(label is string, value is bool) is bool {
        Stdout().writeln(label);
        value;
    }
    async log(text is string) is void {
        Stdout().writeln(text);
    }
}

async main() is int {
    let out = Stdout();
    let pending = Job(name: "never", result: 1).run();
    pending.cancel();
    pending.cancel();
    let r = try {
        await pending;
    } catch e is Cancelled {
        -1;
    };
    out.writeln(r.string());
    out.writeln(if pending.done() && pending.cancelled() { "cancelled"; } else { "?"; });
    0;
}
