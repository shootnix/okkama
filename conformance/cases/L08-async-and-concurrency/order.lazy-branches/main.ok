module app v1.0.0;

import "io/stdout" take Stdout;

object Job {
    has name is string;
    has result is int;
    Job(:name, :result);
    async run() is int {
        Stdout().writeln("running " + name);
        result;
    }
}

object Quiet {
    has result is int;
    Quiet(:result);
    async run() is int { result; }
}

object Broken does Error {
    Broken();
    text() is string { "broken"; }
}

object Failing {
    Failing();
    async run() is int {
        Stdout().writeln("failing body");
        throw Broken();
    }
}

object Values {
    Values();
    async v(label is string, value is int) is int {
        Stdout().writeln(label);
        value;
    }
    async flag(label is string, value is bool) is bool {
        Stdout().writeln(label);
        value;
    }
    async log(text is string) is void {
        Stdout().writeln(text);
    }
}

async main() is int {
    let out = Stdout();
    let v = Values();
    let skipped = false && (await v.flag("never and", true));
    let taken = true || (await v.flag("never or", false));
    let m = ["k": 1];
    let present = m["k"] else (await v.v("never fallback", 0));
    let locals = 5;
    let resumed = await v.v("resumed", locals + 1);
    out.writeln((if skipped || !taken { 0; } else { present + resumed; }).string());
    0;
}
