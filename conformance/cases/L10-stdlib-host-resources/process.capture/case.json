{
  "schema": "ocs-case/1",
  "id": "L10.process.capture",
  "title": "a child process runs without a shell and is captured",
  "purpose": "Observe host-resource behaviour inside the case's isolated working directory.",
  "level": "L10",
  "contracts": [
    {
      "contract": "STD.OS.COMMAND",
      "aspects": [
        "normal"
      ]
    },
    {
      "contract": "STD.OS.COMMAND_CAPTURE",
      "aspects": [
        "normal"
      ]
    },
    {
      "contract": "STD.OS.PROCESS",
      "aspects": [
        "normal"
      ]
    }
  ],
  "mode": "run",
  "sources": [
    "main.ok"
  ],
  "entry": "main.ok",
  "requires": {
    "environment": [
      "stdout",
      "process-spawn"
    ]
  },
  "expect": {
    "outcome": "success",
    "exit_status": 0,
    "stdout": {
      "text": "a b|c;d\nsuccess\n1\n"
    }
  },
  "spec_refs": [
    "std/os/command.ok",
    "std/os/command_capture.ok",
    "POSIX printf/false"
  ],
  "budget": {
    "timeout_s": 30
  },
  "provenance": {
    "origin": "authored for OCS 0.1.0 from the cited contract text",
    "expected_basis": "os/command never invokes a shell, so `a b` and `c;d` stay single arguments; POSIX printf formats them and `false` exits 1."
  },
  "status": "mandatory"
}
