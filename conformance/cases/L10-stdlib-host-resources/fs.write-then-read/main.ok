module app v1.0.0;

import "io/stdout" take Stdout;
import "fs/file" take File, FileMode, FileEntry, FileContent, FileSystemFailure;
import "fs/path" take Path;
import "fs/directory" take Directory, DirectoryEntries;
import "fs/temp" take TemporaryDirectory;
import "encoding/utf" take Utf8Decoded;

main() is int {
    {
        let file = File(mode: FileMode.writing, path: Path("out.txt"));
        defer file.close();
        file.text().writeln("first line");
        file.text().write("second ", "line\n");
    }
    let content = Utf8Decoded(origin: FileContent(origin: FileEntry(path: Path("out.txt"))).bytes()).string();
    Stdout().write(content);
    0;
}
