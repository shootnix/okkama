module app v1.0.0;

import "io/stdout" take Stdout;
import "fs/file" take File, FileMode;
import "fs/entry" take FileEntry;
import "fs/error" take FileError;
import "fs/path" take Path;
import "fs/directory" take Directory, DirectoryEntries;
import "fs/temp" take TemporaryDirectory;
import "encoding/utf" take Utf8Decoded;

main() is int {
    {
        let file = File(path: Path("out.txt"), mode: FileMode.writing);
        defer file.close();
        file.text().writeln("first line");
        file.text().write("second ", "line\n");
    }
    let content = File(path: Path("out.txt")).text().content();
    Stdout().write(content);
    0;
}
