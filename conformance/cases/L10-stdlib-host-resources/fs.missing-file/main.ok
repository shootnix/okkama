module app v1.0.0;

import "io/stdout" take Stdout;
import "fs/file" take File, FileMode, FileEntry, FileContent, FileSystemFailure;
import "fs/path" take Path;
import "fs/directory" take Directory, DirectoryEntries;
import "fs/temp" take TemporaryDirectory;
import "encoding/utf" take Utf8Decoded;

main() is int {
    let out = Stdout();
    let r = try {
        let bytes = FileContent(origin: FileEntry(path: Path("does-not-exist.txt"))).bytes();
        "read";
    } catch e is FileSystemFailure {
        "failure " + e.code();
    };
    out.writeln(r);
    0;
}
