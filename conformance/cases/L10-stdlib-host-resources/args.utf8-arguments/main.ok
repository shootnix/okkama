module app v1.0.0;

import "io/stdout" take Stdout;
import "cli/arguments" take ProcessArguments, Utf8Arguments;

main() is int {
    let args = Utf8Arguments(ProcessArguments());
    Stdout().writeln(args.size().string());
    for args -> a {
        Stdout().writeln("[" + a + "]");
    }
    0;
}
