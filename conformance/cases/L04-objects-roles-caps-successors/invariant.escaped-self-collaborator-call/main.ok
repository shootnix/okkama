module ocs/escaped_self_collaborator v1.0.0;

import "io/stdout" take Stdout;

object Echo {
    Echo();
    said(text is string) is string {
        Stdout().writeln(text);
        text;
    }
}

object Leaf {
    has up is Tree;
    has seen is string = "";
    Leaf(up is Tree) {
        self.up = up;
        seen = up.greeted(Echo().said("argument"));
    }
}

object Tree {
    has name is string;
    has leaf is Maybe<Leaf>;
    Tree(name is string) {
        self.name = name;
        leaf = Maybe.some(Leaf(self));
    }
    greeted(text is string) is string { text + " " + name; }
}

main() is int {
    Stdout().writeln("start");
    Tree("oak");
    Stdout().writeln("unreachable");
    0;
}
