module app v1.0.0;

import "io/stdout" take Stdout;

object Counter {
    has value is int;
    Counter(:value);
    increment() is ^Counter { ^value = value + 1; }
    value() is int { value; }
}

main() is int {
    let out = Stdout();
    let counter = Counter(value: 0);
    for 1..=3 -> n {
        counter = counter.increment();
    }
    out.writeln(counter.value().string());
    let typed is Counter = Counter(value: 10);
    typed = typed.increment();
    out.writeln(typed.value().string());
    0;
}
