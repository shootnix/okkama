module app v1.0.0;

import "io/stdout" take Stdout;

object Vault {
    Vault();
    open() is int { self.secret(); }
    peek(other is Vault) is int { other.secret(); }
    private:
    secret() is int { 7; }
}

main() is int {
    let out = Stdout();
    let x = Vault().secret();
    out.writeln("unreachable");
    0;
}
