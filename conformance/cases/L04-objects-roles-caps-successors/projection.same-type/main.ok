module app v1.0.0;

import "io/stdout" take Stdout;

object Number {
    has origin is int;
    Number(origin is int) {
        origin = origin;
    }
    #projected
    copy() is Number { self; }
}

main() is int {
    let out = Stdout();
    let n = Number(1);
    out.writeln("unreachable");
    0;
}
