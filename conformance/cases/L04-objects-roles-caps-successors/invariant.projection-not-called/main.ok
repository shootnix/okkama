module app v1.0.0;

import "io/stdout" take Stdout;

enum NegativeValue is Error = (negative_value);

object Checked {
    has value is int;
    Checked(value is int) {
        self.value = value;
        confirm value >= 0 else throw NegativeValue.negative_value;
    }

    positive() is int {
        Stdout().writeln("projection ran");
        value;
    }
}

main() is int {
    let out = Stdout();
    let r = try {
        Checked(-3).positive();
    } catch e is NegativeValue {
        -1;
    };
    out.writeln(r.string());
    out.writeln((Checked(4).positive()).string());
    0;
}
