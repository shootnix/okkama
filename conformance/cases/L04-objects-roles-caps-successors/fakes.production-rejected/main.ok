module app v1.0.0;

import "async/atomic" take Atomic;

import "io/stdout" take Stdout;

role Books {
    remember(id is int, title is string) is void;
    title(id is int) is string;
    count() is int;

    fake {
        has titles is Atomic<%int:string> = Atomic([:]);
        has prefix is string = "fake:";
        remember(id is int, title is string) is void {
            titles.replace(titles.value() + [id: title]);
        }
        title(id is int) is string {
            prefix + titles.value()[id];
        }
        count() is int {
            titles.value().size();
        }
    }
}

main() is int {
    let out = Stdout();
    let b is Books = Books.fake();
    out.writeln("unreachable");
    0;
}
