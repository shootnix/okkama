module app v1.0.0;

import "io/stdout" take Stdout;

role Named { name() is string; }

object Plain does Named {
    has label is string;
    Plain(:label);
    name() is string { label; }
}

object Registry {
    has first is Named;
    has pick is (string) is bool;
    Registry(:first, :pick);
    names() is @Named {
        once let kept is @Named = [first];
        kept;
    }
    chosen() is (string) is bool {
        once let kept = pick;
        kept;
    }
}

main() is int {
    let registry = Registry(first: Plain(label: "a"), pick: (s is string) is bool { s == "a"; });
    Stdout().writeln(registry.names().size(), " ", registry.names()[0].name(), " ", registry.chosen()("a"));
    0;
}
