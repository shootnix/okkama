module app v1.0.0;

import "io/stdout" take Stdout;

object Counter {
    has count is int;
    Counter(:count);
    count() is int { count; }
    bumped() is ^Counter { ^count = count + 1; }
}

main() is int {
    let out = Stdout();
    let later = Counter(count: 1).bumped();
    let wanted = Counter(count: 4).count() > 0;
    let show = () is int { if wanted { later.count(); } else { 0; } };
    show();
    0;
}
