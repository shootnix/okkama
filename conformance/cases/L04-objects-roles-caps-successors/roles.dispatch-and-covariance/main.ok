module app v1.0.0;

import "io/stdout" take Stdout;

role Package {
    open() is ^Package;
    label() is string;
}

object Box does Package {
    has opened is bool = false;
    Box() {}
    open() is ^Box { ^opened = true; }
    label() is string { if opened { "open box"; } else { "closed box"; } }
    extra() is int { 1; }
}

main() is int {
    let out = Stdout();
    let p is Package = Box();
    let q = p.open();
    out.writeln(p.label());
    out.writeln(q.label());
    let items is @Package = [Box(), Box().open()];
    for items -> item {
        out.writeln(item.label());
    }
    0;
}
