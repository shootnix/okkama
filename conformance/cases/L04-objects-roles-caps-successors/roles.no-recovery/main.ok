module app v1.0.0;

import "io/stdout" take Stdout;

role Package {
    open() is ^Package;
    label() is string;
}

object Box does Package {
    has opened is bool = false;
    Box() {}
    open() is ^Box { ^opened = true; }
    label() is string { if opened { "open box"; } else { "closed box"; } }
    extra() is int { 1; }
}

main() is int {
    let out = Stdout();
    let p is Package = Box();
    let b is Box = p;
    out.writeln("unreachable");
    0;
}
