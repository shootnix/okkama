module app v1.0.0;

import "io/stdout" take Stdout;

enum AlreadyOpen is Error = (already_open);

object Bottle {
    has opened is bool = false;
    has sips is int = 0;
    Bottle() {}
    open() is ^Bottle {
        confirm !opened else throw AlreadyOpen.already_open;
        ^opened = true;
    }
    sip() is ^Bottle {
        ^sips = sips + 1;
    }
    state() is string { (if opened { "open"; } else { "closed"; }) + "/" + sips.string(); }
}

main() is int {
    let out = Stdout();
    let opened = Bottle().open();
    let outcome = try {
        let twice = opened.open();
        twice.state();
    } catch e is AlreadyOpen {
        e.text();
    };
    out.writeln(outcome);
    out.writeln(opened.state());
    0;
}
