module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

object Thrower {
    Thrower();
    fail(key is string) is void {
        throw NotFound.not_found(key);
    }
}

object Fragile {
    Fragile();
    destroy {
        Stdout().writeln("fragile destroy");
        throw Denied.denied;
    }
}

main() is int {
    let out = Stdout();
    let r = try {
        let bad = Fragile();
        defer Thrower().fail("defer");
        "completed";
    } catch e is NotFound {
        "defer wins";
    } catch e is Denied {
        "destroy wins";
    };
    out.writeln(r);
    0;
}
