module app v1.0.0;

import "io/stdout" take Stdout;

object Res {
    has name is string;
    Res(:name);
    use() is string { name; }
    destroy {
        Stdout().writeln("destroy " + name);
    }
}

object Log {
    Log();
    say(text is string) is void {
        Stdout().writeln(text);
    }
    value(text is string, v is int) is int {
        Stdout().writeln(text);
        v;
    }
}

object Counter {
    has value is int;
    Counter(:value);
    increment() is ^Counter { ^value = value + 1; }
    value() is int { value; }
}

main() is int {
    let out = Stdout();
    let log = Log();
    {
        let counter = Counter(value: 1);
        defer log.say("first registered: " + counter.value().string());
        defer log.say("second registered");
        counter = counter.increment();
        log.say("body end");
    }
    log.say("after block");
    0;
}
