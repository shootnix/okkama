module app v1.0.0;

import "io/stdout" take Stdout;

enum Coded is Error = (coded(code is int));

main() is int {
    let out = Stdout();
    try {
        throw Coded.coded(7);
    } catch e is Error {
        let n = match e { case Coded.coded(code) { code; } };
    }
    out.writeln("unreachable");
    0;
}
