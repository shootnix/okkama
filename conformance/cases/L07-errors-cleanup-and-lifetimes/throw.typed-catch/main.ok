module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    let r = try {
        throw NotFound.not_found("k1");
        "no";
    } catch e is NotFound {
        "caught " + e.text();
    };
    out.writeln(r);
    0;
}
