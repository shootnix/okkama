module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

object Thrower {
    Thrower();
    fail(key is string) is void {
        throw NotFound.not_found(key);
    }
}

main() is int {
    let out = Stdout();
    let r = try {
        defer out.writeln("last registered runs first");
        defer Thrower().fail("from defer");
        defer out.writeln("defer after failing one");
        throw Denied.denied;
        "none";
    } catch e is Denied {
        "body failure wins";
    } catch e is NotFound {
        "defer failure won";
    };
    out.writeln(r);
    0;
}
