module app v1.0.0;

import "io/stdout" take Stdout;

object Res {
    has name is string;
    Res(:name);
    use() is string { name; }
    destroy {
        Stdout().writeln("destroy " + name);
    }
}

object Log {
    Log();
    say(text is string) is void {
        Stdout().writeln(text);
    }
    value(text is string, v is int) is int {
        Stdout().writeln(text);
        v;
    }
}

main() is int {
    let out = Stdout();
    {
        let a = Res(name: "a");
        let b = Res(name: "b");
        let c = Res(name: "c");
        out.writeln("block end");
    }
    out.writeln("after");
    0;
}
