module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    let fine = try { 1 + 1; } catch e is Error { 0; };
    let failed = try { throw Denied.denied; 1; } catch e is Denied { 99; };
    out.writeln(fine.string() + " " + failed.string());
    out.writeln((try { 5; } catch e is Error { 0; } * 2).string());
    0;
}
