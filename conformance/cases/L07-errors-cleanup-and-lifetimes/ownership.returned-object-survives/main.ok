module app v1.0.0;

import "io/stdout" take Stdout;

object Res {
    has name is string;
    Res(:name);
    use() is string { name; }
    destroy {
        Stdout().writeln("destroy " + name);
    }
}

object Log {
    Log();
    say(text is string) is void {
        Stdout().writeln(text);
    }
    value(text is string, v is int) is int {
        Stdout().writeln(text);
        v;
    }
}

object Factory {
    Factory();
    make() is Res {
        let fresh = Res(name: "made-res");
        Stdout().writeln("made");
        fresh;
    }
}

main() is int {
    let out = Stdout();
    {
        let r = Factory().make();
        out.writeln("caller has " + r.use());
    }
    out.writeln("after");
    0;
}
