module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    let r = try {
        try {
            throw Denied.denied;
            "none";
        } catch e is NotFound {
            "inner";
        }
    } catch e is Denied {
        "outer " + e.text();
    };
    out.writeln(r);
    0;
}
