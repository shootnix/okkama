module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    let r = try {
        defer out.writeln("try cleanup");
        throw Denied.denied;
        "none";
    } catch e is Denied {
        "handled";
    };
    out.writeln(r);
    0;
}
