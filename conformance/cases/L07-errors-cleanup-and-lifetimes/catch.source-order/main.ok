module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    let specific = try {
        throw NotFound.not_found("a");
        "none";
    } catch e is NotFound {
        "specific";
    } catch e is Error {
        "general";
    };
    out.writeln(specific);
    let general_first = try {
        throw NotFound.not_found("a");
        "none";
    } catch e is Error {
        "general";
    } catch e is NotFound {
        "specific";
    };
    out.writeln(general_first);
    0;
}
