module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    let problem is Error = NotFound.not_found("r");
    let r = try {
        throw problem;
        "no";
    } catch e is NotFound {
        "concrete catch " + e.text();
    };
    out.writeln(r);
    0;
}
