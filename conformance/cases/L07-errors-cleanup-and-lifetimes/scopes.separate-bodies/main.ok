module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    try {
        let x = 1;
        throw Denied.denied;
    } catch e is Denied {
        let x = 2;
        out.writeln(x.string());
    }
    0;
}
