module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

main() is int {
    let out = Stdout();
    let r = try {
        try {
            throw NotFound.not_found("same");
        } catch e is NotFound {
            throw;
        }
        "none";
    } catch outer is NotFound {
        outer.text();
    };
    out.writeln(r);
    0;
}
