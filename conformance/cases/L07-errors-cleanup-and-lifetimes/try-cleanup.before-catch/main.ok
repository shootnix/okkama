module app v1.0.0;

import "io/stdout" take Stdout;

enum NotFound is Error = (not_found(key is string));

enum Denied is Error = (denied);

object Res {
    has name is string;
    Res(:name);
    use() is string { name; }
    destroy {
        Stdout().writeln("destroy " + name);
    }
}

object Log {
    Log();
    say(text is string) is void {
        Stdout().writeln(text);
    }
    value(text is string, v is int) is int {
        Stdout().writeln(text);
        v;
    }
}

main() is int {
    let out = Stdout();
    try {
        let r = Res(name: "try-owned");
        throw Denied.denied;
    } catch e is Denied {
        out.writeln("in catch");
    }
    0;
}
