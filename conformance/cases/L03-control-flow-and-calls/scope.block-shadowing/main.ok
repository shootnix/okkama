module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    let x = 1;
    {
        let x = 2;
        out.writeln(x.string());
        {
            let x = 3;
            out.writeln(x.string());
        }
        out.writeln(x.string());
    }
    out.writeln(x.string());
    0;
}
