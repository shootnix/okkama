module app v1.0.0;

import "io/stdout" take Stdout;

object MathBox {
    MathBox();
    factorial(n is int) is int {
        if n <= 1 { 1; } else { n * self.factorial(n - 1); }
    }
    fib(n is int) is int {
        if n < 2 { n; } else { self.fib(n - 1) + self.fib(n - 2); }
    }
    even(n is int) is bool {
        if n == 0 { true; } else { self.odd(n - 1); }
    }
    odd(n is int) is bool {
        if n == 0 { false; } else { self.even(n - 1); }
    }
}

main() is int {
    let out = Stdout();
    let m = MathBox();
    out.writeln(m.factorial(10).string());
    out.writeln(m.fib(15).string());
    out.writeln(if m.even(10) { "even"; } else { "odd"; });
    0;
}
