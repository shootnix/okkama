module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    let xs = [10, 20, 30, 40];
    out.writeln(xs[0].string() + " " + xs[3].string());
    out.writeln(xs.size().string());
    let mid = xs.slice(1, 3);
    out.writeln(mid.size().string() + " " + mid[0].string());
    out.writeln(xs.slice(4, 4).size().string());
    out.writeln(xs[byte(2).int()].string());
    0;
}
