module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    let items = [1, 3, 5, 6, 7, 8];
    let even = items.any() -> x { out.writeln("any sees " + x.string()); x % 2 == 0; };
    out.writeln("any " + even.string());
    let small = items.all() -> x { out.writeln("all sees " + x.string()); x < 5; };
    out.writeln("all " + small.string());
    let first = items.find() -> x { x > 4; };
    out.writeln(first ?? .some(v): "find " + v.string() !! .none: "none");
    let missing = (1..=10).find() -> n { n > 100; };
    out.writeln(missing ?? .some(v): v.string() !! .none: "range none");
    let empty is @int = [];
    out.writeln((empty.any() -> x { true; }).string() + " " + (empty.all() -> x { false; }).string());
    let prices is %string:int = ["apple": 120, "pear": 140];
    out.writeln((prices.any() -> name, price { price > 130; }).string() + " " + (prices.all() -> name, price { name.length() > 3; }).string());
    0;
}
