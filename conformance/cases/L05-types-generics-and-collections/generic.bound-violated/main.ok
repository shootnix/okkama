module app v1.0.0;

import "io/stdout" take Stdout;

role Ranked<T> {
    beats(other is T) is bool;
}

object Best<T: Ranked<T>> {
    has first is T;
    has second is T;
    Best(:first, :second);
}

main() is int {
    let out = Stdout();
    let best = Best(first: 1, second: 2);
    out.writeln("unreachable");
    0;
}
