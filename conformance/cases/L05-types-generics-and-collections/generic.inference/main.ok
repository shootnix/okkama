module app v1.0.0;

import "io/stdout" take Stdout;

object Box<T> {
    has value is T;
    Box(:value);
    get() is T { value; }
}

object Taker {
    Taker();
    ints(values is @int) is int { values.size(); }
    boxed(box is Box<int>) is int { box.get(); }
    anything(values is @any) is int { values.size(); }
}

main() is int {
    let out = Stdout();
    let a = Box(value: 7);
    let b = Box(value: [1, 2]);
    let c = Box(value: Box(value: "inner"));
    out.writeln(Taker().boxed(a).string());
    out.writeln(b.get().size().string());
    out.writeln(c.get().get());
    0;
}
