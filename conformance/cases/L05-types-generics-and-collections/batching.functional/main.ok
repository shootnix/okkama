module app v1.0.0;

import "collections/iteration" take Batching, Iterating, Cursor;
import "async/atomic" take Atomic;
import "io/stdout" take Stdout;

// Hands out the batches it was given, one per batch() call, then [] for ever,
// and reports each call.
object Recorded does Batching<int> {
    has batches is @@int;
    has served is Atomic<int>;
    has out is Stdout;

    Recorded(batches is @@int, out is Stdout) {
        self.batches = batches;
        self.out = out;
        served = Atomic(0);
    }

    batch() is @int {
        let at = served.value();
        served.replace(at + 1);
        out.writeln("batch " + at.string());
        if at < batches.size() {
            batches[at];
        }
        else {
            [];
        }
    }
}

main() is int {
    let out = Stdout();
    let doubled is @int = Recorded([[1, 2], [3]], out).map() -> n { n * 2; };
    out.writeln(doubled.map() -> n { n.string(); }.join(","));
    let odd is @int = Recorded([[1, 2], [3]], out).filter() -> n { n % 2 == 1; };
    out.writeln(odd.map() -> n { n.string(); }.join(","));
    let sum = Recorded([[1, 2], [3]], out).reduce(0) -> total, n { total + n; };
    out.writeln(sum.string());
    let found = Recorded([[1, 2], [3]], out).find() -> n { n > 1; };
    out.writeln((found else -1).string());
    0;
}
