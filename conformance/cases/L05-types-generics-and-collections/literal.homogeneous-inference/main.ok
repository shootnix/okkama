module app v1.0.0;

import "io/stdout" take Stdout;

object Box<T> {
    has value is T;
    Box(:value);
    get() is T { value; }
}

object Taker {
    Taker();
    ints(values is @int) is int { values.size(); }
    boxed(box is Box<int>) is int { box.get(); }
    anything(values is @any) is int { values.size(); }
}

main() is int {
    let out = Stdout();
    let xs = [1, 2, 3];
    out.writeln(Taker().ints(xs).string());
    let empty = [];
    out.writeln(Taker().ints(empty).string());
    0;
}
