module app v1.0.0;

import "io/stdout" take Stdout;
import "collections/set" take KeyedSet;
import "collections/frequencies" take KeyedFrequencies;

enum Suit = (hearts, spades);

object Card {
    has rank is int;
    has suit is Suit;
    Card(rank is int, suit is Suit) { self.rank = rank; self.suit = suit; }
    label() is string { rank.string() + if suit == Suit.hearts { "H"; } else { "S"; }; }
}

object Index<T> {
    has entries is %T:int;
    Index(items is @T) {
        let empty is %T:int = [:];
        entries = items.reduce(empty) -> found, item {
            let seen = found[item] else 0;
            found + [item: seen + 1];
        };
    }
    count(item is T) is int { entries[item] else 0; }
    size() is int { entries.size(); }
}

object Wrap<U> {
    has inner is Index<U>;
    Wrap(items is @U) { inner = Index(items: items); }
    count(item is U) is int { inner.count(item); }
}

main() is int {
    let out = Stdout();
    let words = Index(items: ["b", "a", "b"]);
    out.writeln(words.size().string() + " " + words.count("b").string() + " " + words.count("z").string());
    let cards = Wrap(items: [Card(10, Suit.hearts), Card(2, Suit.spades), Card(10, Suit.hearts)]);
    out.writeln(cards.count(Card(10, Suit.hearts)).string());
    let suits = KeyedSet(values: [Suit.spades, Suit.hearts, Suit.spades]);
    for suits -> suit { out.writeln(if suit == Suit.hearts { "hearts"; } else { "spades"; }); }
    let ranks = KeyedFrequencies(values: [3, 1, 3, 3]);
    for ranks -> frequency { out.writeln(frequency.item().string() + ":" + frequency.amount().string()); }
    0;
}
