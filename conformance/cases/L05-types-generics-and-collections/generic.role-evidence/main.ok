module app v1.0.0;

import "io/stdout" take Stdout;

role Echo<T> {
    echo(value is T) is T;
}

object EchoBox<T> does Echo<T> {
    EchoBox();
    echo(value is T) is T { value; }
}

main() is int {
    let out = Stdout();
    let e is Echo<int> = EchoBox();
    out.writeln(e.echo(5).string());
    0;
}
