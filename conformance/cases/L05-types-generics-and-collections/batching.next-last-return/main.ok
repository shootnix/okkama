module app v1.0.0;

import "collections/iteration" take Batching, Iterating, Cursor;
import "async/atomic" take Atomic;
import "io/stdout" take Stdout;

// Hands out the batches it was given, one per batch() call, then [] for ever,
// and reports each call.
object Recorded does Batching<int> {
    has batches is @@int;
    has served is Atomic<int>;
    has out is Stdout;

    Recorded(batches is @@int, out is Stdout) {
        self.batches = batches;
        self.out = out;
        served = Atomic(0);
    }

    batch() is @int {
        let at = served.value();
        served.replace(at + 1);
        out.writeln("batch " + at.string());
        if at < batches.size() {
            batches[at];
        }
        else {
            [];
        }
    }
}

object Finder {
    has out is Stdout;
    Finder(out is Stdout) { self.out = out; }

    first_above(limit is int) is int {
        for Recorded([[1, 2], [3, 4], [5]], out) -> n {
            if n > limit {
                return n;
            }
        }
        -1;
    }
}

main() is int {
    let out = Stdout();
    for Recorded([[1, 2], [3, 4], [5]], out) -> n {
        next if n % 2 == 1;
        last if n > 3;
        out.writeln("kept " + n.string());
    }
    out.writeln("found " + Finder(out).first_above(2).string());
    0;
}
