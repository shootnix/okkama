module app v1.0.0;
import "conformance/check" take Checks;
import "db/value" take DbValue,ObservedDbValue,DbValueKind,DbNull,DbInteger,DbDecimal,DbFloating,DbBoolean,DbText,DbBytes;
import "db/sqlite" take SqliteMemory;
import "db/statement" take Statement,DbLimits,DbBoundaryLimit;
import "db/query" take Query;
import "numbers/bigint" take BigInt;
import "math/decimal" take Decimal;

async main() is int {
    let c=Checks();
    c=c.ok("direct int",ObservedDbValue(DbInteger(7)).integer().string() == "7");
    c=c.ok("some int",ObservedDbValue(DbInteger(Maybe<int>.some(7))).integer().string() == "7");
    c=c.ok("none int",DbInteger(Maybe<int>.none).kind() == DbValueKind.null_value);
    c=c.ok("direct BigInt",ObservedDbValue(DbInteger(BigInt("9223372036854775808"))).integer().string() == "9223372036854775808");
    c=c.ok("some BigInt",ObservedDbValue(DbInteger(Maybe<BigInt>.some(BigInt("9223372036854775808")))).integer().string() == "9223372036854775808");
    c=c.ok("none BigInt",DbInteger(Maybe<BigInt>.none).kind() == DbValueKind.null_value);
    c=c.ok("direct Decimal",ObservedDbValue(DbDecimal(Decimal("1.25"))).decimal().string() == "1.25");
    c=c.ok("some Decimal",ObservedDbValue(DbDecimal(Maybe<Decimal>.some(Decimal("1.25")))).decimal().string() == "1.25");
    c=c.ok("none Decimal",DbDecimal(Maybe<Decimal>.none).kind() == DbValueKind.null_value);
    c=c.ok("direct float",ObservedDbValue(DbFloating(1.5)).floating() == 1.5);
    c=c.ok("some float",ObservedDbValue(DbFloating(Maybe<float>.some(1.5))).floating() == 1.5);
    c=c.ok("none float",DbFloating(Maybe<float>.none).kind() == DbValueKind.null_value);
    c=c.ok("direct bool",ObservedDbValue(DbBoolean(false)).boolean() == false);
    c=c.ok("some bool",ObservedDbValue(DbBoolean(Maybe<bool>.some(false))).boolean() == false);
    c=c.ok("none bool",DbBoolean(Maybe<bool>.none).kind() == DbValueKind.null_value);
    c=c.ok("direct string",ObservedDbValue(DbText("")).text() == "");
    c=c.ok("some string",ObservedDbValue(DbText(Maybe<string>.some(""))).text() == "");
    c=c.ok("none string",DbText(Maybe<string>.none).kind() == DbValueKind.null_value);
    c=c.ok("direct @byte",ObservedDbValue(DbBytes(@byte(0.byte(),255.byte()))).bytes().size() == 2);
    c=c.ok("some @byte",ObservedDbValue(DbBytes(Maybe<@byte>.some(@byte(0.byte(),255.byte())))).bytes().size() == 2);
    c=c.ok("none @byte",DbBytes(Maybe<@byte>.none).kind() == DbValueKind.null_value);
    c=c.ok("explicit NULL",DbNull().kind() == DbValueKind.null_value);
    c=c.ok("signed minimum",ObservedDbValue(DbInteger(-9223372036854775808)).integer().string() == "-9223372036854775808");
    c=c.ok("signed maximum",ObservedDbValue(DbInteger(9223372036854775807)).integer().string() == "9223372036854775807");
    let connection=await SqliteMemory().connection();
    defer await connection.settled();defer connection.close();
    await connection.execution(Statement("CREATE TABLE users(id INTEGER, name TEXT, nick TEXT, enabled INTEGER, data BLOB)"));
    let name="Ada'); DROP TABLE users; --";
    let nick=Maybe<string>.none;
    let parameters is @DbValue=[DbInteger(7),DbText(name),DbText(nick),DbBoolean(false),DbBytes(@byte(0.byte(),255.byte()))];
    await connection.execution(Statement(text: "INSERT INTO users VALUES(?,?,?,?,?)",values: parameters));
    let row=await Query(connection,Statement(text: "SELECT * FROM users WHERE id=?",values: [DbInteger(7)])).one();
    c=c.ok("bound integer",row.int("id")==7);
    c=c.ok("SQL syntax stays data",row.text("name")==name);
    c=c.ok("bound NULL",row.maybe("nick").text() ?? .none: true !! _: false);
    c=c.ok("SQLite bool is integer",row.flag("enabled")==false);
    c=c.ok("binary exact",row.bytes("data")==@byte(0.byte(),255.byte()));
    let prepared=await connection.prepared("SELECT ? AS id, ? AS name, ? AS nick");
    defer prepared.close();
    let rows=await prepared.rows(DbInteger(8),DbText(""),DbText(Maybe<string>.none));
    defer rows.close();
    let prepared_row=await rows.row();
    c=c.ok("prepared int",prepared_row.int("id")==8);
    c=c.ok("prepared empty text",prepared_row.text("name")=="");
    c=c.ok("prepared NULL",prepared_row.maybe("nick").text() ?? .none: true !! _: false);
    c=c.ok("parameter count limit preserved",try { Statement(text: "SELECT ?",values: [DbInteger(1)],limits: DbLimits(0,10,100));false; } catch e is DbBoundaryLimit { true; });
    c=c.ok("UTF8 byte limit preserved",try { Statement(text: "SELECT ?",values: [DbText("é")],limits: DbLimits(1,1,100));false; } catch e is DbBoundaryLimit { true; });
    c.done();
}
