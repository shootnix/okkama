module app v1.0.0;

import "io/stdout" take Stdout;
import "net/tcp" take TcpConnecting, TcpConnection;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "net/failure" take NetworkFailure;
import "cli/arguments" take ProcessArguments, Utf8Arguments;
import "strings/parse" take ParsedInt;
import "encoding/utf" take Utf8Decoded, Utf8Encoded;
import "io/decorators" take ByteSnapshot;

async main() is int {
    let out = Stdout();
    let port = value ParsedInt(Utf8Arguments(ProcessArguments()).item(0));
    let connection = await TcpConnecting(IpEndpoint(IpAddress("127.0.0.1"), port)).connection();
    defer connection.close();
    let collected = loop {
        let chunk = await connection.input().bytes(1024);
        last chunk if chunk.size() > 0;
    };
    let tail = await connection.input().bytes(1024);
    out.writeln(Utf8Decoded(origin: collected).string());
    out.writeln("eof bytes " + tail.size().string());
    0;
}
