module app v1.0.0;

// A TCP read that is interrupted, by a timeout and by a cancelled task, must
// leave nothing pending that could take the reply sent afterwards: the next
// read gets all of it (#264: these reads await their native work directly).
import "io/stdout" take Stdout;
import "net/tcp" take TcpConnecting, TcpConnection;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "cli/arguments" take ProcessArguments, Utf8Arguments;
import "strings/parse" take Number;
import "encoding/utf" take Utf8Decoded, Utf8Encoded;
import "io/decorators" take ByteSnapshot;
import "async/timeout" take Within, TimedOut;
import "async/atomic" take Atomic;
import "time/duration" take Duration, DurationUnit;
import "time/clock" take SystemClock;

object Reader {
    has connection is TcpConnection;
    Reader(:connection);
    async bytes() is @byte { await connection.input().bytes(64); }
}

async main() is int {
    let out = Stdout();
    let port = Number(Utf8Arguments(ProcessArguments()).item(0)).int();
    let connection = await TcpConnecting(IpEndpoint(IpAddress("127.0.0.1"), port)).connection();
    defer connection.close();
    // The peer answers only after a whole line, so both reads find nothing.
    let timed = try {
        await Within(Reader(connection: connection).bytes(), Duration(1.rat() / 10.rat(), DurationUnit.second), SystemClock()).result();
        "read early";
    } catch TimedOut.elapsed { "timed out"; };
    out.writeln(timed);
    let task = spawn Reader(connection: connection).bytes();
    task.cancel();
    let cancelled = try { await task; "read early"; } catch e is Cancelled { "cancelled"; };
    out.writeln(cancelled);
    await connection.output().write(ByteSnapshot(Utf8Encoded(origin: "ping\n").bytes()));
    let text = Atomic("");
    loop {
        let chunk = await connection.input().bytes(64);
        if chunk.size() == 0 { last; }
        text.replace(text.value() + Utf8Decoded(origin: chunk).string());
    }
    out.write(text.value());
    0;
}
