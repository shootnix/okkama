module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln("[" + " \t\n\r  x y　  ".trim() + "]");
    out.writeln("​x​".trim().length().string());
    out.writeln("   ".trim().length().string());
    out.writeln("a\r\n".chomp().length().string());
    out.writeln("a\n\n".chomp().length().string());
    out.writeln("a\r".chomp().length().string());
    out.writeln("\r\n".chomp().length().string());
    out.writeln("".chomp().length().string());
    0;
}
