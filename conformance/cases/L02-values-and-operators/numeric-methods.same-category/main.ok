module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln(if 1.less(2) { "t"; } else { "f"; });
    out.writeln(if 2.more_or_equal(2) { "t"; } else { "f"; });
    out.writeln(if 1.5.less_or_equal(2.5) { "t"; } else { "f"; });
    out.writeln(if byte(1).more(byte(2)) { "t"; } else { "f"; });
    0;
}
