module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    let a is @int = [];
    let b is @int = [];
    out.writeln(if a == b { "t"; } else { "f"; });
    out.writeln(if [1] == [1, 2] { "t"; } else { "f"; });
    out.writeln(if ["a": 1] == ["a": 2] { "t"; } else { "f"; });
    0;
}
