module app v1.0.0;

import "io/stdout" take Stdout;

object Tracer {
    Tracer();
    mark(label is string, value is int) is int {
        Stdout().writeln(label);
        value;
    }
}

object Pair {
    Pair();
    combine(left is int, right is int) is int { left * 10 + right; }
}

main() is int {
    let out = Stdout();
    let t = Tracer();
    let sum = t.mark("a", 1) + t.mark("b", 2) * t.mark("c", 3);
    out.writeln(sum.string());
    let combined = Pair().combine(t.mark("first", 4), t.mark("second", 5));
    out.writeln(combined.string());
    0;
}
