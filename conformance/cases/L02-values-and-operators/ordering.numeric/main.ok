module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln(if 1 < 2 { "t"; } else { "f"; });
    out.writeln(if 2 <= 2 { "t"; } else { "f"; });
    out.writeln(if 3 > 3 { "t"; } else { "f"; });
    out.writeln(if 3 >= 3 { "t"; } else { "f"; });
    out.writeln(if float(1) < 1.5 { "t"; } else { "f"; });
    out.writeln(if byte(3) > byte(2) { "t"; } else { "f"; });
    out.writeln(if rat(1, 2) < 1.rat() { "t"; } else { "f"; });
    0;
}
