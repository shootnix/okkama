module app v1.0.0;

import "io/stdout" take Stdout;

object Bag {
    Bag();
    size() is int { 99; }
    length() is int { 7; }
}

main() is int {
    let out = Stdout();
    out.writeln(Bag().size().string());
    out.writeln(Bag().length().string());
    out.writeln([1, 2].size().string());
    0;
}
