module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    let max = 9223372036854775807;
    let min = -9223372036854775807 - 1;
    out.writeln((max + 1).string());
    out.writeln((min - 1).string());
    out.writeln((max * 2).string());
    out.writeln((-min).string());
    out.writeln((min * -1).string());
    out.writeln((min % -1).string());
    0;
}
