module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln(if byte(1) == byte(1) { "eq"; } else { "?"; });
    out.writeln(if byte(1) < byte(2) { "lt"; } else { "?"; });
    out.writeln([10, 20, 30][byte(1).int()].string());
    let r = [byte(1).int()..=byte(3).int()];
    out.writeln(r.size().string());
    out.writeln(if r[0] == 1 { "int elements"; } else { "?"; });
    out.writeln((float(byte(1)) * 2.5).string());
    0;
}
