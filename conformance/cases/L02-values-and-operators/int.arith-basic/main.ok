module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln((7 + 5).string());
    out.writeln((7 - 5).string());
    out.writeln((7 * 5).string());
    out.writeln((7 % 5).string());
    out.writeln((-7 + 5).string());
    out.writeln((5 - 7).string());
    0;
}
