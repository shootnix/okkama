module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln("banana".replace("na", "NA"));
    out.writeln("banana".replace_first("na", "NA"));
    out.writeln("a-b-c".replace("-", ""));
    out.writeln("abc".replace("x", "y"));
    out.writeln("héé".replace("é", "e"));
    0;
}
