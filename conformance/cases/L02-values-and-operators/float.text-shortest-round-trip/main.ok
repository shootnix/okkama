module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln((0.1 + 0.2).string());
    out.writeln((1.1 * 1.1).string());
    out.writeln((1.0 / 3.0).string());
    out.writeln(string(2.0 / 3.0));
    out.writeln(0.5.string());
    out.writeln(3.0.string());
    out.writeln(123.456.string());
    0;
}
