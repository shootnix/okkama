module app v1.0.0;

import "io/stdout" take Stdout;

object Tracer {
    Tracer();
    mark(label is string, value is int) is int {
        Stdout().writeln(label);
        value;
    }
}

object Pair {
    Pair();
    combine(left is int, right is int) is int { left * 10 + right; }
}

main() is int {
    let out = Stdout();
    let t = Tracer();
    let bytes = @byte(t.mark("x", 1), t.mark("y", 2));
    out.writeln(bytes.size().string());
    0;
}
