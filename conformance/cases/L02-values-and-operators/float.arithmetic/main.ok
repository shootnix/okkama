module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln((1.5 * 2.0).string());
    out.writeln((0.5 - 0.75).string());
    out.writeln((7.0 / 2.0).string());
    out.writeln((1.5 + float(1)).string());
    out.writeln((float(3) / 2.0).string());
    out.writeln((-0.5).string());
    0;
}
