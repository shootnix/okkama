module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln(if 1 == 1 { "t"; } else { "f"; });
    out.writeln(if 1 != 2 { "t"; } else { "f"; });
    out.writeln(if "a" == "a" { "t"; } else { "f"; });
    out.writeln(if "a" != "b" { "t"; } else { "f"; });
    out.writeln(if true == true { "t"; } else { "f"; });
    out.writeln(if 1.5 == 1.5 { "t"; } else { "f"; });
    out.writeln(if 'x' == 'y' { "t"; } else { "f"; });
    0;
}
