module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln("[" + "  hi  ".trim() + "]");
    out.writeln("[" + "line\n".chomp() + "]");
    out.writeln("[" + "line".chomp() + "]");
    let original = " x ";
    let trimmed = original.trim();
    out.writeln("[" + original + "][" + trimmed + "]");
    0;
}
