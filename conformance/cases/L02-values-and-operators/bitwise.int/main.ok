module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln((12 & 10).string());
    out.writeln((12 | 10).string());
    out.writeln((12 ^ 10).string());
    out.writeln((~0).string());
    out.writeln((~5).string());
    out.writeln((-1 & 255).string());
    0;
}
