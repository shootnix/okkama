module app v1.0.0;
import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln((2).pow(100).string());
    out.writeln((3).pow(0).string() + " " + (-2).pow(3).string() + " " + (0).pow(0).string());
    out.writeln((2.rat() / 3.rat()).pow(3).string());
    out.writeln((2.rat()).pow(-3).string());
    out.writeln((1.5).pow(2.0).string());
    let big is int = (10).pow(30);
    out.writeln((big / big).string());
    0;
}
