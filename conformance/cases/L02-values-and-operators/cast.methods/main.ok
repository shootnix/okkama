module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln(5.float().string());
    out.writeln(3.7.int().string());
    out.writeln((-3.7).int().string());
    out.writeln(200.byte().string());
    out.writeln(0.125.rat().string());
    out.writeln(3.rat().string());
    out.writeln(byte(9).rat().string());
    out.writeln(rat(7, 2).byte().string());
    out.writeln(true.string());
    0;
}
