module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln(int(-3.9).string());
    out.writeln(int(3.9).string());
    out.writeln(int(byte(7)).string());
    out.writeln(int(rat(7, 2)).string());
    out.writeln(float(3).string());
    out.writeln(float(rat(1, 4)).string());
    out.writeln(string(101));
    out.writeln(string(true) + string(false));
    out.writeln(string(rat(1, 2)));
    out.writeln(string(byte(7)));
    out.writeln(string(2.5));
    out.writeln(string("x"));
    out.writeln(int(-9223372036854775807 - 1).string());
    0;
}
