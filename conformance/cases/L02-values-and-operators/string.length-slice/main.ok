module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln("héllo".length().string());
    out.writeln("hello".slice(0, 2));
    out.writeln("héllo".slice(1, 2));
    out.writeln("a😀b".slice(1, 2));
    out.writeln("a😀b".length().string());
    0;
}
