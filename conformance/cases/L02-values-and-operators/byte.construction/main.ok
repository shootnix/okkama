module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln(byte(255).string());
    out.writeln(byte(0).string());
    out.writeln(byte(255.9).string());
    out.writeln(byte(-0.5).string());
    out.writeln(byte(rat(511, 2)).string());
    out.writeln(byte(byte(7)).string());
    0;
}
