module ocs/ini_native_equivalence v1.0.0;

// Each case: hex UTF-8 text, the input/section/entry budgets, and the hex
// UTF-8 of what the native parser gave: "E line:column message" for a failure,
// otherwise "[section]name=value|..." with ";" between sections.
import "config/ini" take ParsedIni, InvalidIni;
import "encoding/hex" take HexDecoded;
import "encoding/utf" take Utf8Decoded;
import "strings/parse" take Number;
import "io/stdout" take Stdout;

object Outcome {
    Outcome();
    of(text is string, input is int, sections is int, entries is int) is string {
        try {
            let document = ParsedIni(origin: text, maximum_input: input, maximum_sections: sections, maximum_entries: entries).document();
            let parts is @string = document.sections().map() -> section {
                let bindings is @string = section.entries().map() -> entry { entry.name() + "=" + entry.value(); };
                "[" + section.name() + "]" + bindings.join("|");
            };
            parts.join(";");
        } catch InvalidIni.located(line, column, message) {
            "E " + line.string() + ":" + column.string() + " " + message;
        }
    }
    text(hex is string) is string { Utf8Decoded(HexDecoded(hex).bytes()).string(); }
}

