module app v1.0.0;

import "conformance/check" take Checks;
import "time/zone" take Zone, Zoned, Fold, ZonedDateTime, ZoneObservation, MissingLocalTime, TimeZoneDatabaseVersion;
import "time/rfc3339" take Rfc3339;
import "time/iso" take IsoText, IsoLocalDateTime;
import "time/duration" take Duration, DurationUnit;

main() is int {
    let berlin = Zone("Europe/Berlin");
    let utc = Duration(value: 0.rat(), unit: DurationUnit.second);
    let resolved = (text is string, fold is Fold) is string {
        Rfc3339(origin: Zoned(local: IsoText(text).local_date_time(), zone: berlin, fold: fold).instant(), offset: utc).string();
    };
    let summer = Rfc3339("2026-10-25T00:30:00Z").instant();
    let winter = Rfc3339("2026-10-25T01:30:00Z").instant();
    let c = Checks();
    c = c.same_text("database version", TimeZoneDatabaseVersion().string(), "2026c");
    c = c.same_text("winter local time", resolved("2026-01-15T12:00:00", Fold.earlier), "2026-01-15T11:00:00Z");
    c = c.same_text("fold earlier", resolved("2026-10-25T02:30:00", Fold.earlier), "2026-10-25T00:30:00Z");
    c = c.same_text("fold later", resolved("2026-10-25T02:30:00", Fold.later), "2026-10-25T01:30:00Z");
    c = c.same_text("gap", try { resolved("2026-03-29T02:30:00", Fold.earlier); } catch MissingLocalTime.zone(name) { "MissingLocalTime " + name; }, "MissingLocalTime Europe/Berlin");
    c = c.same_text("summer local view", IsoLocalDateTime(origin: ZonedDateTime(instant: summer, zone: berlin).local_datetime()).string(), "2026-10-25T02:30:00");
    c = c.same_text("summer offset", ZonedDateTime(instant: summer, zone: berlin).offset().seconds().string(), "7200");
    c = c.same_text("summer abbreviation", ZoneObservation(origin: ZonedDateTime(instant: summer, zone: berlin)).abbreviation(), "CEST");
    c = c.same_text("winter abbreviation", berlin.abbreviation(winter), "CET");
    c = c.same_text("winter is not daylight saving", berlin.daylight_saving(winter).string(), "false");
    c.done();
}
