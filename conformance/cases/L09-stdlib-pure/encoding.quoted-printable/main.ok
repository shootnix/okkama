module app v1.0.0;

import "conformance/check" take Checks;
import "encoding/quoted_printable" take QuotedPrintableEncoded, QuotedPrintableDecoded, InvalidQuotedPrintable;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;

main() is int {
    let c = Checks();
    c = c.same_text("control and equals", Utf8Decoded(origin: QuotedPrintableEncoded(origin: [byte(0), byte(61), byte(255)]).bytes()).string(), "=00=3D=FF");
    c = c.same_text("space before CRLF", Utf8Decoded(origin: QuotedPrintableEncoded(origin: Utf8Encoded(origin: "a b \r\nc").bytes()).bytes()).string(), "a b=20\r\nc");
    c = c.same_ints("decode lowercase hex", QuotedPrintableDecoded(origin: Utf8Encoded(origin: "=3d=ff").bytes()).bytes().map() -> b { b.int(); }, [61, 255]);
    c = c.same_text("malformed escape", try { let probe = QuotedPrintableDecoded(origin: Utf8Encoded(origin: "a=G1").bytes()).bytes(); "no error"; } catch e is InvalidQuotedPrintable { "offset " + e.offset().string(); }, "offset 1");
    c.done();
}
