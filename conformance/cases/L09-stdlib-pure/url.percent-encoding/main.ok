module app v1.0.0;

import "conformance/check" take Checks;
import "url/percent" take PercentEncoded, PercentDecoded, UrlComponent, InvalidPercentEncoding;

main() is int {
    let c = Checks();
    c = c.same_text("data component", PercentEncoded(origin: "a&b=c+d", component: UrlComponent.data).string(), "a%26b%3Dc%2Bd");
    c = c.same_text("space and utf8", PercentEncoded(origin: "a b/ü", component: UrlComponent.data).string(), "a%20b%2F%C3%BC");
    c = c.same_text("unreserved kept", PercentEncoded(origin: "AZaz09-._~", component: UrlComponent.data).string(), "AZaz09-._~");
    c = c.same_text("decode once", PercentDecoded("%252F").string(), "%2F");
    c = c.same_text("invalid escape", try { let probe = PercentDecoded("%zz").string(); "no error"; } catch InvalidPercentEncoding.at(offset) { "offset " + offset.string(); }, "offset 0");
    c.done();
}
