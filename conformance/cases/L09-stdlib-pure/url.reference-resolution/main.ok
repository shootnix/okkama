module app v1.0.0;

import "conformance/check" take Checks;
import "url/value" take ParsedUrl;

main() is int {
    let c = Checks();
    c = c.same_text("g", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("g").parts()).string(), "http://a/b/c/g");
    c = c.same_text("./g", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("./g").parts()).string(), "http://a/b/c/g");
    c = c.same_text("g/", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("g/").parts()).string(), "http://a/b/c/g/");
    c = c.same_text("/g", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("/g").parts()).string(), "http://a/g");
    c = c.same_text("//g", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("//g").parts()).string(), "http://g");
    c = c.same_text("?y", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("?y").parts()).string(), "http://a/b/c/d;p?y");
    c = c.same_text("g?y", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("g?y").parts()).string(), "http://a/b/c/g?y");
    c = c.same_text("#s", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("#s").parts()).string(), "http://a/b/c/d;p?q#s");
    c = c.same_text("..", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("..").parts()).string(), "http://a/b/");
    c = c.same_text("../g", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("../g").parts()).string(), "http://a/b/g");
    c = c.same_text("../../g", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("../../g").parts()).string(), "http://a/g");
    c = c.same_text("../../../g", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("../../../g").parts()).string(), "http://a/g");
    c = c.same_text("./g/.", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("./g/.").parts()).string(), "http://a/b/c/g/");
    c = c.same_text("g;x=1/../y", ParsedUrl("http://a/b/c/d;p?q").parts().resolved(ParsedUrl("g;x=1/../y").parts()).string(), "http://a/b/c/y");
    c.done();
}
