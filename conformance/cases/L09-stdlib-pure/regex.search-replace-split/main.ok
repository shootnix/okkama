module app v1.0.0;

import "conformance/check" take Checks;
import "regex/pattern" take Regex, InvalidRegex;
import "regex/search" take FirstRegexMatch, EntireRegexMatch, RegexMatches;
import "regex/replace" take RegexSubstitution, LiteralRegexReplacement, ExpandedRegexReplacement;
import "regex/split" take RegexParts;
import "regex/escape" take EscapedRegex;

main() is int {
    let c = Checks();
    c = c.same_text("first match", FirstRegexMatch(origin: "one 22 three", regex: Regex("\\d+")).text(), "22");
    c = c.same_bool("absent match", RegexMatches(origin: "abc", regex: Regex("\\d")).found(), false);
    c = c.same_text("literal substitution", RegexSubstitution(origin: "a1 b22", regex: Regex("\\d+"), replacing: LiteralRegexReplacement("N")).string(), "aN bN");
    c = c.same_int("substitution count", RegexSubstitution(origin: "a1 b22", regex: Regex("\\d+"), replacing: LiteralRegexReplacement("N")).amount(), 2);
    c = c.same_text("named groups", RegexSubstitution(origin: "Ada Lovelace", regex: Regex("(?<first>\\w+) (?<last>\\w+)"), replacing: ExpandedRegexReplacement("${last}, ${first}")).string(), "Lovelace, Ada");
    c = c.same_text("literal dollar", RegexSubstitution(origin: "x", regex: Regex("x"), replacing: LiteralRegexReplacement("$1")).string(), "$1");
    c = c.same_texts("split keeps empty", (RegexParts(origin: "a,,b", regex: Regex(","))).map() -> p { p; }, ["a", "", "b"]);
    c = c.same_text("escaped literal", EntireRegexMatch(origin: "price: $5.00", regex: Regex(EscapedRegex("price: $5.00").string())).text(), "price: $5.00");
    c.done();
}
