module app v1.0.0;

import "conformance/check" take Checks;
import "numbers/bigint" take BigInt, BigDivisionByZero, InvalidBigInt;
import "numbers/bigrational" take BigRational, ZeroBigRationalDenominator;

main() is int {
    let c = Checks();
    c = c.same_int("bits of 2^64", BigInt("18446744073709551616").bits(), 65);
    c = c.same_text("square of 2^64", ((BigInt("18446744073709551616") * BigInt("18446744073709551616"))).string(), "340282366920938463463374607431768211456");
    c = c.same_text("2^100", (BigInt("2").power(100)).string(), "1267650600228229401496703205376");
    c = c.same_text("truncating quotient", ((BigInt("-7") / BigInt("2"))).string(), "-3");
    c = c.same_text("remainder sign", ((BigInt("-7") % BigInt("2"))).string(), "-1");
    c = c.same_text("gcd", (BigInt("12").gcd(BigInt("18"))).string(), "6");
    c = c.same_text("lcm", (BigInt("12").lcm(BigInt("18"))).string(), "36");
    c = c.same_text("normalised zeros", BigInt("-0007").string(), "-7");
    c = c.same_int("sign", BigInt("-5").sign(), -1);
    c.done();
}
