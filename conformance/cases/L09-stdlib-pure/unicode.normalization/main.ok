module app v1.0.0;

import "conformance/check" take Checks;
import "unicode/normalization" take Normalized, NormalizationForm;

main() is int {
    let c = Checks();
    c = c.same_int("nfd decomposes", (Normalized(origin: "é", form: NormalizationForm.nfd).string()).length(), 2);
    c = c.same_text("nfc composes", Normalized(origin: "é", form: NormalizationForm.nfc).string(), "é");
    c = c.same_text("nfkc compatibility", Normalized(origin: "ﬃ", form: NormalizationForm.nfkc).string(), "ffi");
    c = c.same_text("nfc keeps ligature", Normalized(origin: "ﬃ", form: NormalizationForm.nfc).string(), "ﬃ");
    c.done();
}
