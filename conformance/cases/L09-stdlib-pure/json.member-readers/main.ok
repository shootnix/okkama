module app v1.0.0;

import "conformance/check" take Checks;
import "json" take Json, ParsedJson, WrongJsonKind, InvalidJsonNumber;

main() is int {
    let c = Checks();
    let doc = ParsedJson("{\"nil\":null,\"empty\":\"\",\"zero\":0,\"flag\":false,\"decimal\":1.25,\"big\":9223372036854775808,\"items\":[],\"object\":{}}").root();
    c = c.same_bool("value preserves missing", doc.presence("absent").value() ?? .missing: true !! _: false, true);
    c = c.same_bool("value folds missing", doc.maybe("absent").value() ?? .none: true !! _: false, true);
    c = c.same_bool("value preserves none", doc.presence("nil").value() ?? .none: true !! _: false, true);
    c = c.same_bool("value folds none", doc.maybe("nil").value() ?? .none: true !! _: false, true);
    c = c.same_bool("object preserves missing", doc.presence("absent").object() ?? .missing: true !! _: false, true);
    c = c.same_bool("object folds missing", doc.maybe("absent").object() ?? .none: true !! _: false, true);
    c = c.same_bool("object preserves none", doc.presence("nil").object() ?? .none: true !! _: false, true);
    c = c.same_bool("object folds none", doc.maybe("nil").object() ?? .none: true !! _: false, true);
    c = c.same_bool("text preserves missing", doc.presence("absent").text() ?? .missing: true !! _: false, true);
    c = c.same_bool("text folds missing", doc.maybe("absent").text() ?? .none: true !! _: false, true);
    c = c.same_bool("text preserves none", doc.presence("nil").text() ?? .none: true !! _: false, true);
    c = c.same_bool("text folds none", doc.maybe("nil").text() ?? .none: true !! _: false, true);
    c = c.same_bool("int preserves missing", doc.presence("absent").int() ?? .missing: true !! _: false, true);
    c = c.same_bool("int folds missing", doc.maybe("absent").int() ?? .none: true !! _: false, true);
    c = c.same_bool("int preserves none", doc.presence("nil").int() ?? .none: true !! _: false, true);
    c = c.same_bool("int folds none", doc.maybe("nil").int() ?? .none: true !! _: false, true);
    c = c.same_bool("boolean preserves missing", doc.presence("absent").boolean() ?? .missing: true !! _: false, true);
    c = c.same_bool("boolean folds missing", doc.maybe("absent").boolean() ?? .none: true !! _: false, true);
    c = c.same_bool("boolean preserves none", doc.presence("nil").boolean() ?? .none: true !! _: false, true);
    c = c.same_bool("boolean folds none", doc.maybe("nil").boolean() ?? .none: true !! _: false, true);
    c = c.same_bool("number preserves missing", doc.presence("absent").number() ?? .missing: true !! _: false, true);
    c = c.same_bool("number folds missing", doc.maybe("absent").number() ?? .none: true !! _: false, true);
    c = c.same_bool("number preserves none", doc.presence("nil").number() ?? .none: true !! _: false, true);
    c = c.same_bool("number folds none", doc.maybe("nil").number() ?? .none: true !! _: false, true);
    c = c.same_bool("integer preserves missing", doc.presence("absent").integer() ?? .missing: true !! _: false, true);
    c = c.same_bool("integer folds missing", doc.maybe("absent").integer() ?? .none: true !! _: false, true);
    c = c.same_bool("integer preserves none", doc.presence("nil").integer() ?? .none: true !! _: false, true);
    c = c.same_bool("integer folds none", doc.maybe("nil").integer() ?? .none: true !! _: false, true);
    c = c.same_bool("list preserves missing", doc.presence("absent").list() ?? .missing: true !! _: false, true);
    c = c.same_bool("list folds missing", doc.maybe("absent").list() ?? .none: true !! _: false, true);
    c = c.same_bool("list preserves none", doc.presence("nil").list() ?? .none: true !! _: false, true);
    c = c.same_bool("list folds none", doc.maybe("nil").list() ?? .none: true !! _: false, true);
    c = c.same_text("maybe reads empty", (doc.maybe("empty").text() else panic "unexpected absence"), "");
    c = c.same_text("presence reads empty", (doc.presence("empty").text().fold() else panic "unexpected absence"), "");
    c = c.same_int("maybe reads zero", (doc.maybe("zero").int() else panic "unexpected absence"), 0);
    c = c.same_int("presence reads zero", (doc.presence("zero").int().fold() else panic "unexpected absence"), 0);
    c = c.same_bool("maybe reads flag", (doc.maybe("flag").boolean() else panic "unexpected absence"), false);
    c = c.same_bool("presence reads flag", (doc.presence("flag").boolean().fold() else panic "unexpected absence"), false);
    c = c.same_text("maybe reads decimal", (doc.maybe("decimal").number() else panic "unexpected absence").string(), "1.25");
    c = c.same_text("presence reads decimal", (doc.presence("decimal").number().fold() else panic "unexpected absence").string(), "1.25");
    c = c.same_text("maybe reads big", (doc.maybe("big").integer() else panic "unexpected absence").string(), "9223372036854775808");
    c = c.same_text("presence reads big", (doc.presence("big").integer().fold() else panic "unexpected absence").string(), "9223372036854775808");
    c = c.same_int("maybe reads items", (doc.maybe("items").list() else panic "unexpected absence").size(), 0);
    c = c.same_int("presence reads items", (doc.presence("items").list().fold() else panic "unexpected absence").size(), 0);
    c = c.same_int("maybe reads object", (doc.maybe("object").object() else panic "unexpected absence").names().size(), 0);
    c = c.same_int("presence reads object", (doc.presence("object").object().fold() else panic "unexpected absence").names().size(), 0);
    c = c.same_text("lazy fallback", doc.maybe("empty").text() else panic "eager fallback", "");
    c = c.same_text("missing fallback", doc.maybe("absent").text() else "guest", "guest");
    c = c.same_text("null fallback", doc.presence("nil").text().fold() else "guest", "guest");
    c = c.same_text("maybe rejects zero as text", try { doc.maybe("zero").text(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/zero");
    c = c.same_text("maybe rejects decimal as int", try { doc.maybe("decimal").int(); "no error"; } catch failure is InvalidJsonNumber { failure.pointer(); }, "/decimal");
    c = c.same_text("maybe rejects big as int", try { doc.maybe("big").int(); "no error"; } catch failure is InvalidJsonNumber { failure.pointer(); }, "/big");
    c = c.same_text("maybe rejects flag as list", try { doc.maybe("flag").list(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/flag");
    c = c.same_text("maybe rejects items as object", try { doc.maybe("items").object(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/items");
    c = c.same_text("maybe rejects object as list", try { doc.maybe("object").list(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/object");
    c = c.same_bool("maybe rejects scalar parent", try { Json(0).maybe("name"); false; } catch failure is WrongJsonKind { true; }, true);
    c = c.same_text("presence rejects zero as text", try { doc.presence("zero").text(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/zero");
    c = c.same_text("presence rejects decimal as int", try { doc.presence("decimal").int(); "no error"; } catch failure is InvalidJsonNumber { failure.pointer(); }, "/decimal");
    c = c.same_text("presence rejects big as int", try { doc.presence("big").int(); "no error"; } catch failure is InvalidJsonNumber { failure.pointer(); }, "/big");
    c = c.same_text("presence rejects flag as list", try { doc.presence("flag").list(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/flag");
    c = c.same_text("presence rejects items as object", try { doc.presence("items").object(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/items");
    c = c.same_text("presence rejects object as list", try { doc.presence("object").list(); "no error"; } catch failure is WrongJsonKind { failure.pointer(); }, "/object");
    c = c.same_bool("presence rejects scalar parent", try { Json(0).presence("name"); false; } catch failure is WrongJsonKind { true; }, true);
    c.done();
}
