module app v1.0.0;

import "conformance/check" take Checks;
import "math/aggregate" take Minimum, Maximum, Sum, Product, Hypotenuse;
import "collections/sequence" take EmptySequence;

object Empty {
    Empty();
    floats() is @float {
        let e is @float = [];
        e;
    }
    ints() is @int {
        let e is @int = [];
        e;
    }
}

main() is int {
    let c = Checks();
    c = c.same_int("minimum", Minimum(values: [3, 9, 4]).value(), 3);
    c = c.same_int("maximum", Maximum(values: [3, 9, 4]).value(), 9);
    c = c.same_float("sum", Sum(values: [0.5, 0.25]).value(), 0.75);
    c = c.same_float("product", Product(values: [2.0, 4.0]).value(), 8.0);
    c = c.same_float("hypotenuse", Hypotenuse(values: [3.0, 4.0]).value(), 5.0);
    c = c.same_float("empty sum", Sum(values: Empty().floats()).value(), 0.0);
    c = c.same_text("empty minimum", try { let probe = Minimum(values: Empty().ints()).value(); "no error"; } catch e is EmptySequence { "EmptySequence"; }, "EmptySequence");
    c.done();
}
