module app v1.0.0;

import "conformance/check" take Checks;
import "math/aggregate" take Extremes, Numbers;
import "collections/sequence" take EmptySequence;

object Empty {
    Empty();
    floats() is @float {
        let e is @float = [];
        e;
    }
    ints() is @int {
        let e is @int = [];
        e;
    }
}

main() is int {
    let c = Checks();
    c = c.same_int("minimum", Extremes([3, 9, 4]).minimum(), 3);
    c = c.same_int("maximum", Extremes([3, 9, 4]).maximum(), 9);
    c = c.same_float("sum", Numbers([0.5, 0.25]).sum(), 0.75);
    c = c.same_float("product", Numbers([2.0, 4.0]).product(), 8.0);
    c = c.same_float("hypotenuse", Numbers([3.0, 4.0]).hypotenuse(), 5.0);
    c = c.same_float("empty sum", Numbers(Empty().floats()).sum(), 0.0);
    c = c.same_text("empty minimum", try { let probe = Extremes(Empty().ints()).minimum(); "no error"; } catch e is EmptySequence { "EmptySequence"; }, "EmptySequence");
    c.done();
}
