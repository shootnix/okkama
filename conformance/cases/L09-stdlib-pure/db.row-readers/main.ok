module app v1.0.0;
import "conformance/check" take Checks;
import "db/row" take Row,Column,DbColumns,InvalidRow,MissingColumn,AmbiguousColumn;
import "db/read" take RowValueFailure;
import "db/value" take DbValue,DbValueKind,DbValueWriting,DbValueCapture,ObservedDbValue,InvalidDbValue,DbNull,DbText,DbInteger,DbBoolean,DbDecimal,DbFloating,DbBytes;
import "numbers/bigint" take BigInt;
import "math/decimal" take Decimal;
import "async/atomic" take Atomic;
import "db/statement" take DbLimits,DbBoundaryLimit;

object ChangingText does DbValue {
    has calls is Atomic<int>;
    ChangingText() { calls=Atomic(0); }
    kind() is DbValueKind { DbValueKind.text; }
    print(output is DbValueWriting) is void { calls.replace(calls.value()+1);output.text(calls.value().string()); }
    calls() is int { calls.value(); }
}
object BrokenPrinter does DbValue {
    has mode is int;
    BrokenPrinter(mode is int) { self.mode=mode; }
    kind() is DbValueKind { DbValueKind.text; }
    print(output is DbValueWriting) is void {
        if mode==1 { output.text("first");output.text("second"); }
        if mode==2 { output.null_value(); }
    }
}
object EscapedSchemaRow {
    EscapedSchemaRow();
    value() is Row {
        let columns=[Column(index: 0,name: "saved",declaration: "INTEGER")];
        Row(columns: columns,values: [DbInteger(BigInt("7"))]);
    }
}
main() is int {
    let c = Checks();
    let row = Row(columns: [Column(0,"nil",""), Column(1,"empty",""), Column(2,"zero",""), Column(3,"one",""), Column(4,"two",""), Column(5,"flag",""), Column(6,"amount",""), Column(7,"ratio",""), Column(8,"data",""), Column(9,"big",""), Column(10,"min",""), Column(11,"max","")], values: [DbNull(), DbText(""), DbInteger(BigInt("0")), DbInteger(BigInt("1")), DbInteger(BigInt("2")), DbBoolean(false), DbDecimal(Decimal("1.25")), DbFloating(1.5), DbBytes([]), DbInteger(BigInt("9223372036854775808")), DbInteger(BigInt("-9223372036854775808")), DbInteger(BigInt("9223372036854775807"))]);
    let duplicate = Row(columns: [Column(0,"x",""),Column(1,"x","")], values: [DbNull(),DbNull()]);
    c = c.ok("value NULL", row.maybe("nil").cell() ?? .none: true !! _: false);
    c = c.ok("value missing", row.presence("absent").cell() ?? .missing: true !! _: false);
    c = c.ok("value presence NULL", row.presence("nil").cell() ?? .none: true !! _: false);
    c = c.ok("int NULL", row.maybe("nil").int() ?? .none: true !! _: false);
