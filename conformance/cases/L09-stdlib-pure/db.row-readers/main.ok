module app v1.0.0;
import "conformance/check" take Checks;
import "db/row" take Row,Column,MissingColumn,AmbiguousColumn;
import "db/read" take RowReader,RowValueFailure;
import "db/value" take DbNull,DbText,DbInteger,DbBoolean,DbDecimal,DbFloating,DbBytes;
import "numbers/bigint" take BigInt;
import "math/decimal" take Decimal;

main() is int {
    let c = Checks();
    let row = Row([Column(0,"nil",""), Column(1,"empty",""), Column(2,"zero",""), Column(3,"one",""), Column(4,"two",""), Column(5,"flag",""), Column(6,"amount",""), Column(7,"ratio",""), Column(8,"data",""), Column(9,"big",""), Column(10,"min",""), Column(11,"max","")], [DbNull(), DbText(""), DbInteger(BigInt("0")), DbInteger(BigInt("1")), DbInteger(BigInt("2")), DbBoolean(false), DbDecimal(Decimal("1.25")), DbFloating(1.5), DbBytes([]), DbInteger(BigInt("9223372036854775808")), DbInteger(BigInt("-9223372036854775808")), DbInteger(BigInt("9223372036854775807"))]);
    let duplicate = Row([Column(0,"x",""),Column(1,"x","")], [DbNull(),DbNull()]);
    c = c.ok("value NULL", row.maybe("nil").value() ?? .none: true !! _: false);
    c = c.ok("value missing", row.presence("absent").value() ?? .missing: true !! _: false);
    c = c.ok("value presence NULL", row.presence("nil").value() ?? .none: true !! _: false);
    c = c.ok("int NULL", row.maybe("nil").int() ?? .none: true !! _: false);
    c = c.ok("int missing", row.presence("absent").int() ?? .missing: true !! _: false);
    c = c.ok("int presence NULL", row.presence("nil").int() ?? .none: true !! _: false);
    c = c.ok("integer NULL", row.maybe("nil").integer() ?? .none: true !! _: false);
    c = c.ok("integer missing", row.presence("absent").integer() ?? .missing: true !! _: false);
    c = c.ok("integer presence NULL", row.presence("nil").integer() ?? .none: true !! _: false);
    c = c.ok("decimal NULL", row.maybe("nil").decimal() ?? .none: true !! _: false);
    c = c.ok("decimal missing", row.presence("absent").decimal() ?? .missing: true !! _: false);
    c = c.ok("decimal presence NULL", row.presence("nil").decimal() ?? .none: true !! _: false);
    c = c.ok("floating NULL", row.maybe("nil").floating() ?? .none: true !! _: false);
    c = c.ok("floating missing", row.presence("absent").floating() ?? .missing: true !! _: false);
    c = c.ok("floating presence NULL", row.presence("nil").floating() ?? .none: true !! _: false);
    c = c.ok("boolean NULL", row.maybe("nil").boolean() ?? .none: true !! _: false);
    c = c.ok("boolean missing", row.presence("absent").boolean() ?? .missing: true !! _: false);
    c = c.ok("boolean presence NULL", row.presence("nil").boolean() ?? .none: true !! _: false);
    c = c.ok("flag NULL", row.maybe("nil").flag() ?? .none: true !! _: false);
    c = c.ok("flag missing", row.presence("absent").flag() ?? .missing: true !! _: false);
    c = c.ok("flag presence NULL", row.presence("nil").flag() ?? .none: true !! _: false);
    c = c.ok("text NULL", row.maybe("nil").text() ?? .none: true !! _: false);
    c = c.ok("text missing", row.presence("absent").text() ?? .missing: true !! _: false);
    c = c.ok("text presence NULL", row.presence("nil").text() ?? .none: true !! _: false);
    c = c.ok("bytes NULL", row.maybe("nil").bytes() ?? .none: true !! _: false);
    c = c.ok("bytes missing", row.presence("absent").bytes() ?? .missing: true !! _: false);
    c = c.ok("bytes presence NULL", row.presence("nil").bytes() ?? .none: true !! _: false);
    c = c.ok("strict empty", row.text("empty") == "");
    c = c.ok("maybe empty", (row.maybe("empty").text() else panic "unexpected NULL") == "");
    c = c.ok("presence empty", (row.presence("empty").text().fold() else panic "unexpected absence") == "");
    c = c.ok("strict zero", row.int("zero") == 0);
    c = c.ok("maybe zero", (row.maybe("zero").int() else panic "unexpected NULL") == 0);
    c = c.ok("presence zero", (row.presence("zero").int().fold() else panic "unexpected absence") == 0);
    c = c.ok("strict flag", row.boolean("flag") == false);
    c = c.ok("maybe flag", (row.maybe("flag").boolean() else panic "unexpected NULL") == false);
    c = c.ok("presence flag", (row.presence("flag").boolean().fold() else panic "unexpected absence") == false);
    c = c.ok("strict zero", row.flag("zero") == false);
    c = c.ok("maybe zero", (row.maybe("zero").flag() else panic "unexpected NULL") == false);
    c = c.ok("presence zero", (row.presence("zero").flag().fold() else panic "unexpected absence") == false);
    c = c.ok("strict one", row.flag("one") == true);
    c = c.ok("maybe one", (row.maybe("one").flag() else panic "unexpected NULL") == true);
    c = c.ok("presence one", (row.presence("one").flag().fold() else panic "unexpected absence") == true);
    c = c.ok("strict amount", row.decimal("amount") .string() == "1.25");
    c = c.ok("maybe amount", (row.maybe("amount").decimal() else panic "unexpected NULL") .string() == "1.25");
    c = c.ok("presence amount", (row.presence("amount").decimal().fold() else panic "unexpected absence") .string() == "1.25");
    c = c.ok("strict ratio", row.floating("ratio") == 1.5);
    c = c.ok("maybe ratio", (row.maybe("ratio").floating() else panic "unexpected NULL") == 1.5);
    c = c.ok("presence ratio", (row.presence("ratio").floating().fold() else panic "unexpected absence") == 1.5);
    c = c.ok("strict data", row.bytes("data") .size() == 0);
    c = c.ok("maybe data", (row.maybe("data").bytes() else panic "unexpected NULL") .size() == 0);
    c = c.ok("presence data", (row.presence("data").bytes().fold() else panic "unexpected absence") .size() == 0);
    c = c.ok("strict big", row.integer("big") .string() == "9223372036854775808");
    c = c.ok("maybe big", (row.maybe("big").integer() else panic "unexpected NULL") .string() == "9223372036854775808");
    c = c.ok("presence big", (row.presence("big").integer().fold() else panic "unexpected absence") .string() == "9223372036854775808");
    c = c.ok("strict min", row.int("min") .string() == "-9223372036854775808");
    c = c.ok("maybe min", (row.maybe("min").int() else panic "unexpected NULL") .string() == "-9223372036854775808");
    c = c.ok("presence min", (row.presence("min").int().fold() else panic "unexpected absence") .string() == "-9223372036854775808");
    c = c.ok("strict max", row.int("max") .string() == "9223372036854775807");
    c = c.ok("maybe max", (row.maybe("max").int() else panic "unexpected NULL") .string() == "9223372036854775807");
    c = c.ok("presence max", (row.presence("max").int().fold() else panic "unexpected absence") .string() == "9223372036854775807");
    c = c.ok("missing stays error", try { row.maybe("absent").text() else "fallback"; false; } catch e is MissingColumn { e.name() == "absent"; });
    c = c.ok("strict rejects nil text", try { row.text("nil"); false; } catch e is RowValueFailure { e.column() == "nil" && e.expected() == "text"; });
    c = c.ok("strict rejects empty int", try { row.int("empty"); false; } catch e is RowValueFailure { e.column() == "empty" && e.expected() == "int"; });
    c = c.ok("maybe rejects empty int", try { row.maybe("empty").int(); false; } catch e is RowValueFailure { e.column() == "empty"; });
    c = c.ok("strict rejects two flag", try { row.flag("two"); false; } catch e is RowValueFailure { e.column() == "two" && e.expected() == "flag"; });
    c = c.ok("maybe rejects two flag", try { row.maybe("two").flag(); false; } catch e is RowValueFailure { e.column() == "two"; });
    c = c.ok("strict rejects flag flag", try { row.flag("flag"); false; } catch e is RowValueFailure { e.column() == "flag" && e.expected() == "flag"; });
    c = c.ok("maybe rejects flag flag", try { row.maybe("flag").flag(); false; } catch e is RowValueFailure { e.column() == "flag"; });
    c = c.ok("strict rejects one boolean", try { row.boolean("one"); false; } catch e is RowValueFailure { e.column() == "one" && e.expected() == "boolean"; });
    c = c.ok("maybe rejects one boolean", try { row.maybe("one").boolean(); false; } catch e is RowValueFailure { e.column() == "one"; });
    c = c.ok("strict rejects big int", try { row.int("big"); false; } catch e is RowValueFailure { e.column() == "big" && e.expected() == "int"; });
    c = c.ok("maybe rejects big int", try { row.maybe("big").int(); false; } catch e is RowValueFailure { e.column() == "big"; });
    c = c.ok("ambiguous duplicate.text(\"x\")", try { duplicate.text("x"); false; } catch e is AmbiguousColumn { e.name() == "x"; });
    c = c.ok("ambiguous duplicate.maybe(\"x\").text()", try { duplicate.maybe("x").text(); false; } catch e is AmbiguousColumn { e.name() == "x"; });
    c = c.ok("ambiguous duplicate.presence(\"x\").text()", try { duplicate.presence("x").text(); false; } catch e is AmbiguousColumn { e.name() == "x"; });
    c = c.ok("NULL fallback", (row.maybe("nil").text() else "guest") == "guest");
    c = c.ok("legacy adapter", RowReader(row).text("empty") == "");
    c.done();
}
