module app v1.0.0;

import "conformance/check" take Checks;
import "json" take ParsedJson, InvalidJson, DuplicateJsonMember;
import "math/decimal" take Decimal;

main() is int {
    let c = Checks();
    c = c.same_text("trailing comma", try { let probe = ParsedJson(origin: "[1,]").value().items(); "no error"; } catch e is InvalidJson { "line " + e.line().string(); }, "line 1");
    c = c.same_text("duplicate member", try { let probe = ParsedJson(origin: "{\"a\":1,\"a\":2}").value().int("a"); "no error"; } catch e is DuplicateJsonMember { e.name(); }, "a");
    c = c.same_text("single quotes", try { let probe = ParsedJson(origin: "{'a':1}").value().names(); "no error"; } catch e is InvalidJson { "invalid"; }, "invalid");
    c.done();
}
