module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    for [1, 2, 3] -> n {
        if n == 1 {
            out.writeln("one");
        } else if n == 2 {
            out.writeln("two");
        } else {
            out.writeln("many");
        }
    }
    0;
}
