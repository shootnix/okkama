module app v1.0.0;

import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    out.writeln((1 + 2 * 3).string());
    out.writeln(((1 + 2) * 3).string());
    out.writeln((-2 * 3 + 10).string());
    out.writeln((7 % 4 * 2).string());
    out.writeln((1 << 1 + 1).string());
    0;
}
