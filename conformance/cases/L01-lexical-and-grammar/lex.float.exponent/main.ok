module app v1.0.0;

import "io/stdout" take Stdout;

object Scale {
    Scale();
    of(value is float) is string { value.string(); }
}

main() is int {
    let out = Stdout();
    let scale = Scale();
    out.writeln(scale.of(1.5e-3));
    out.writeln(scale.of(2.5E+2));
    out.writeln(if 1e5 == 100000.0 { "1e5 is 100000.0"; } else { "different"; });
    out.writeln(if 2e+10 == 20000000000.0 && 1_000e-3 == 1.0 && 25E-1 == 2.5 { "forms agree"; } else { "different"; });
    out.writeln(if 4.9e-324 > 0.0 && -0e5 == 0.0 { "subnormal and zero"; } else { "different"; });
    let steps = (1e2).int();
    out.writeln(steps.string());
    0;
}
