module app v1.0.0;

import "io/stdout" take Stdout;

object Number {
    has origin is int;
    Number(origin is int) {
        origin = origin;
    }

    doubled() is int { origin * 2; }

    rendered() is string { "n=" + origin.string(); }
}

main() is int {
    let out = Stdout();
    out.writeln((Number(21).doubled()).string());
    out.writeln(Number(5).rendered());
    0;
}
