module app v1.0.0;

object Counter {
    has n is int = 0;
    Counter();
    value() is int { n; }
    touch() is void { n; }
    bumped() is ^Counter { ^n = n + 1; }
    async later() is int { n; }
    sum(a is int, b is int) is int { a + b; }
    many(values is ...int) is int { 0; }
}

main() is int {
    0;
}
