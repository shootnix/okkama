module bench/persistence v1.0.0;

// map-keep-versions (write): k versions `base + [new key: v]` of n keys, all kept alive in an array (#331 case B).
// Generated by persistence/gen.py from scenarios.py; edit those, not this file.
import "io/stdout" take Stdout, Stderr;
import "runtime/process" take process_arguments;
import "runtime/time" take monotonic_clock;


object Input {
    Input();

    make(n is int) is %int:int {
        self.pairs(n);
    }

    values(n is int) is @int { (0..n).map() -> i { (i * 7919 + 13) % 10007; }; }

    pairs(n is int) is %int:int {
        let m is %int:int = (0..n).reduce([:]) -> acc, i { acc + [i * 2: i]; };
        m;
    }

    tree(lo is int, hi is int) is @int {
        if hi - lo <= 32 { return (lo..hi).map() -> i { (i * 7919 + 13) % 10007; }; }
        let mid = lo + ((hi - lo) / 2).int();
        self.tree(lo, mid) + self.tree(mid, hi);
    }

    text(length is int) is string {
        if length <= 64 { return "abcdefg,".repeat(8).slice(0, length); }
        let half = (length / 2).int();
        self.text(half) + self.text(length - half);
    }
}

object Work {
    Work();

    run(input is %int:int, n is int, k is int) is int {
        let kept is @%int:int = (0..k).reduce([]) -> all, j { all + [input + [j * 2 + 1: j]]; };
        kept.size() + kept[k - 1].size();
    }

    rand(x is int) is int { (x * 48271) % 2147483647; }
}

object Rounds {
    Rounds();
    run(input is %int:int, n is int, k is int, left is int, check is int) is int {
        if left == 0 { return check; }
        let started = monotonic_clock();
        let got = Work().run(input, n, k);
        Stderr().writeln("iteration " + (monotonic_clock() - started).string());
        self.run(input, n, k, left - 1, check + got);
    }
}

object Args {
    Args();
    number(text is @byte) is int { text.reduce(0) -> value, digit { value * 10 + digit.int() - 48; }; }
}

main() is int {
    let arguments = process_arguments();
    let n = Args().number(arguments[0]);
    let k = Args().number(arguments[1]);
    let reps = Args().number(arguments[2]);
    let started = monotonic_clock();
    let input = Input().make(n);
    Stderr().writeln("setup " + (monotonic_clock() - started).string());
    let warm = Work().run(input, n, k);
    let check = Rounds().run(input, n, k, reps, 0);
    Stdout().writeln(warm.string() + " " + check.string());
    0;
}
