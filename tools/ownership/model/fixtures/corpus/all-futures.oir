# Full finite translation of tests/ownership-corpus/all-futures.ok
# Plain arithmetic, Events and TAP plumbing omitted; schedule explicit.
profile own
scope.begin main async
scope.begin collected
future first new A bound
future second new B bound
collect.all results first second first
assert.items results @result:first @result:second @result:first
get a results 0
get duplicate results 2
use a
use duplicate
check ''
collect.all again first second first
get b again 1
use b
check ''
scope.end collected
check BA
reset.log
scope.begin empty
collect.all empty_result
use empty_result
scope.end empty
check ''
scope.begin block
future waiting void - bound
future.body waiting 'new localL L' suspend
future failed fail Stop bound
future.body failed 'new localF F' suspend
future.start waiting
future.start failed
future.settle failed
collect.all results waiting failed
assert.failure Stop Cancelled
check FL
scope.end block
check FL
scope.end main
