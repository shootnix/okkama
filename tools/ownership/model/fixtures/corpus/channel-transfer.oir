# Full finite translation of tests/ownership-corpus/channel-transfer.ok
# Plain arithmetic, Events and TAP plumbing omitted; schedule explicit.
profile own
scope.begin main async
scope.begin block
storage ch channel
new r R
storage.set ch message r
scope.begin receiver
scope.begin helper
storage.get received ch message
exit.prepare helper received
scope.end helper
exit.commit helper receiver
use received
check ''
scope.end receiver
check R
storage.close ch
scope.end block
check R
reset.log
scope.begin blocked
storage rendezvous channel
future task void - bound
future.body task 'new localL L' 'new messageM M' suspend
future.start task
# Send not accepted: M remains with the sending action.
check ''
future.request-cancel task
await cancelled task
assert.failure Cancelled
check ML
storage.close rendezvous
scope.end blocked
check ML
scope.end main
