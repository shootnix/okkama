+
+struct RegisterLease<'a> {
+    slots: Vec<Value>,
+    pool: &'a RefCell<Vec<Vec<Value>>>,
+}
+
+impl<'a> RegisterLease<'a> {
+    fn new(pool: &'a RefCell<Vec<Vec<Value>>>, count: usize) -> Self {
+        let mut slots = pool.borrow_mut().pop().unwrap_or_default();
+        slots.resize(count, Value::Undef);
+        Self { slots, pool }
+    }
+}
+
+impl Drop for RegisterLease<'_> {
+    fn drop(&mut self) {
+        // Values may release runtime state. Never hold a pool borrow during drop.
+        self.slots.clear();
+        // Bound both the number of cached buffers and each buffer's capacity.
+        if self.slots.capacity() > 4096 { return; }
+        let mut pool = self.pool.borrow_mut();
+        if pool.len() < 16 {
+            pool.push(std::mem::take(&mut self.slots));
+        }
+    }
 }
 
