  "reproduction_script": "import pathlib,subprocess,os,json,statistics\nroot=pathlib.Path('/Volumes/SamsungSSD/stuff/okkama-new');variants={'baseline':{},'gc_off':{'OKKAMA_GC':'off'},'jit_threshold_1':{'OKKAMA_JIT_THRESHOLD':'1'}};order=list(variants)\nresult={'note':'Diagnostic runtime settings only. GC off is not a production recommendation.','runs':3,'warmups':4,'samples':[]}\nfor i in range(3):\n for mode in order[i:]+order[:i]:\n  env=dict(os.environ,OKKAMA_STDLIB_DIR=str(root/'std'),DB_BENCH_ROWS='5000',DB_BENCH_LOOKUPS='500',DB_BENCH_WARMUPS='4')\n  for k in ['OKKAMA_JIT','OKKAMA_ENGINE','OKKAMA_JIT_THRESHOLD','OKKAMA_GC']:env.pop(k,None)\n  env.update(variants[mode]);p=subprocess.run([str(root/'okkama-rs/target/release/okkama'),'run','--engine','sparrow',str(root/'benchmarks/db/main.ok')],env=env,capture_output=True,text=True,timeout=120)\n  if p.returncode:raise RuntimeError(p.stdout+p.stderr)\n  data={};sums={}\n  for line in p.stdout.splitlines():\n   phase,ns,total=line.split();data[phase]=int(ns)/1e6;sums[phase]=int(total)\n  if result['samples']:assert sums==result['samples'][0]['sums']\n  result['samples'].append(dict(iteration=i,variant=mode,ms=data,sums=sums));print(i,mode,data,flush=True)\nresult['summary']={v:{k:statistics.median(s['ms'][k] for s in result['samples'] if s['variant']==v) for k in data} for v in variants}\n(root/'benchmarks/db/results/rusqlite-runtime-probes.json').write_text(json.dumps(result,indent=2)+'\\n')\n",
