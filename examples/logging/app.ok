module examples/logging/app v1.0.0;

import "logging/named" take NamedLogging, LogProcessReading;
import "logging/name" take LogName;
import "logging/level" take LogLevel;
import "logging/field" take LogFields;
import "logging/filter" take AllowedLogs, LevelThresholds, LevelOverride;
import "logging/redact" take RedactedLogs;
import "logging/stream" take TextStreamLogs, JsonStreamLogs;
import "logging/write" take BroadcastLogs, CollectedLogs;
import "json" take Json, JsonField;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration, DurationUnit;
import "time/zone" take FixedZone;
import "io/stdout" take Stdout;

// A program logs through NamedLogging: a name, where records go, a clock and
// the fields every record carries. Records pass through writers: a filter by
// level, a redaction of secret fields, then text lines on stdout and records
// kept in memory. A real program passes SystemClock() and leaves the process
// out; this one fixes both, so its output is the same on every run.

object FixedClock does Timing {
    FixedClock();

    instant() is Instant {
        Instant(Duration(value: 1700000000.rat(), unit: DurationUnit.second));
    }

    monotonic_instant() is MonotonicInstant {
        MonotonicInstant(Duration(value: 0.rat(), unit: DurationUnit.second));
    }

    async wait(duration is Duration) is void {}
}

object FixedProcess does LogProcessReading {
    FixedProcess();

    id() is int {
        4242;
    }
}

main() is int {
    let utc = FixedZone(name: "UTC", offset: Duration(value: 0.rat(), unit: DurationUnit.second));
    let kept = CollectedLogs();
    // Debug is shown for "shop.db" only; everything else starts at info.
    let levels = LevelThresholds(fallback: LogLevel.info, overrides: [LevelOverride(name: LogName(["shop", "db"]), level: LogLevel.debug)]);
    let destination = AllowedLogs(
        origin: RedactedLogs(
            origin: BroadcastLogs([TextStreamLogs(origin: Stdout(), zone: utc), kept]),
            names: ["card"],
            replacement: Json("[hidden]"),
        ),
        allowing: levels,
    );
    let shop = NamedLogging(
        name: LogName(["shop"]),
        destination: destination,
        clock: FixedClock(),
        fields: LogFields([JsonField("region", "eu")]),
        process: FixedProcess(),
    );

    shop.log(LogLevel.info, "started");
    shop.log(LogLevel.debug, "not shown: shop is at info");
    let db = shop.child("db");
    db.log(LogLevel.debug, "connected", LogFields([JsonField("pool", 4)]));
    shop.log(LogLevel.info, "paid", LogFields([JsonField("order", 17), JsonField("card", "4111 1111 1111 1111")]));
    try {
        throw InvalidOrder.empty;
    }
    catch error is InvalidOrder {
        shop.log(LogLevel.error, "order refused", LogFields([JsonField("order", 18)]), error);
    }

    Stdout().writeln("kept " + kept.size().string() + " records; the last one as JSON:");
    JsonStreamLogs(Stdout()).write(kept.records().last());
    0;
}

enum InvalidOrder is Error = (empty);
