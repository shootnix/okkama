module db_readers v1.0.0;
import "db/row" take Row,Column;
import "db/value" take DbInteger,DbText,DbNull;
import "numbers/bigint" take BigInt;
import "io/stdout" take Stdout;

main() is int {
    let row = Row(
        [Column(0,"id","INTEGER"),Column(1,"name","TEXT"),Column(2,"nickname","TEXT")],
        [DbInteger(BigInt("42")),DbText("Anton"),DbNull()]
    );
    let out = Stdout();
    out.writeln(row.int("id").string() + ": " + row.text("name"));
    out.writeln(row.maybe("nickname").text() else "anonymous");
    let note = row.presence("email").text()
        ?? .some(email): email
        !! .none: "SQL NULL"
        !! .missing: "Column not selected";
    out.writeln(note);
    0;
}
