module examples/crypto/secrets v1.0.0;

import "crypto/chacha20_poly1305" take ChaCha20Poly1305;
import "crypto/error" take AuthenticationFailed;
import "crypto/hmac" take Hmac, HmacHash;
import "crypto/nonce" take CounterNonce, SystemEntropy;
import "crypto/password" take Argon2Policy, PasswordCheck, PasswordHash;
import "crypto/secret" take SecretBytes;
import "io/stdout" take Stdout;

// Three everyday tasks: sign a message with HMAC and check the signature,
// store a password as an Argon2 hash and check a login, and encrypt a record
// so that any change to it is detected. Keys live in SecretBytes; the
// entropy and the nonce are explicit values.

main() is int {
    let out = Stdout();

    // 1. HMAC: the receiver recomputes and compares in constant time.
    let key = SecretBytes("shared key");
    let signed = Hmac(hash: HmacHash.sha256, key: key, text: "amount=100");
    let signature = signed.bytes();
    out.writeln("signature ", signed.hex().slice(0, 16), "…");
    out.writeln("genuine: ", Hmac(hash: HmacHash.sha256, key: key, text: "amount=100").matches(signature));
    out.writeln("forged: ", Hmac(hash: HmacHash.sha256, key: key, text: "amount=999").matches(signature));

    // 2. Passwords: store the hash, never the password.
    let stored = PasswordHash(
        password: SecretBytes("correct horse"),
        policy: Argon2Policy(),
        entropy: SystemEntropy(),
    ).string();
    out.writeln("stored as ", stored.slice(0, 10), "…");
    out.writeln("login ok: ", PasswordCheck(stored: stored, password: SecretBytes("correct horse")).matches());
    out.writeln("login wrong: ", PasswordCheck(stored: stored, password: SecretBytes("battery staple")).matches());

    // 3. Authenticated encryption: a nonce never repeats for one key.
    let cipher = ChaCha20Poly1305(SecretBytes((0..32).map() -> index { byte(index); }));
    let nonce = CounterNonce(prefix: [byte(0), byte(0), byte(0), byte(1)], counter: 1, size: 12).bytes();
    let sealed = cipher.sealed(nonce, "record 7", "balance: 42");
    out.writeln("sealed ", sealed.size(), " bytes (text + ", cipher.tag_size(), "-byte tag)");
    out.writeln("opened: ", cipher.opened_text(nonce, "record 7", sealed));
    let tampered = try {
        cipher.opened(nonce, "record 8", sealed);
        "accepted";
    }
    catch failure is AuthenticationFailed {
        "refused";
    };
    out.writeln("wrong header: " + tampered);
    0;
}
