module examples/crypto/secrets v1.0.0;

import "crypto/chacha20_poly1305" take ChaCha20Poly1305;
import "crypto/error" take AuthenticationFailed;
import "crypto/hmac" take Hmac, HmacHash;
import "crypto/nonce" take CounterNonce, SystemEntropy;
import "crypto/password" take Argon2Policy, PasswordCheck, PasswordHash;
import "crypto/secret" take SecretBytes;
import "encoding/hex" take HexEncoded;
import "encoding/utf" take Utf8Decoded, Utf8Encoded;
import "io/stdout" take Stdout;

// Three everyday tasks: sign a message with HMAC and check the signature,
// store a password as an Argon2 hash and check a login, and encrypt a record
// so that any change to it is detected. Keys live in SecretBytes; the
// entropy and the nonce are explicit values.

main() is int {
    let out = Stdout();

    // 1. HMAC: the receiver recomputes and compares in constant time.
    let key = SecretBytes(Utf8Encoded(origin: "shared key").bytes());
    let message = Utf8Encoded(origin: "amount=100").bytes();
    let signature = Hmac(hash: HmacHash.sha256, key: key, origin: message).bytes();
    out.writeln("signature " + HexEncoded(signature).string().slice(0, 16) + "…");
    out.writeln("genuine: ", Hmac(hash: HmacHash.sha256, key: key, origin: message).matches(signature));
    let forged = Utf8Encoded(origin: "amount=999").bytes();
    out.writeln("forged: ", Hmac(hash: HmacHash.sha256, key: key, origin: forged).matches(signature));

    // 2. Passwords: store the hash, never the password.
    let stored = PasswordHash(
        password: SecretBytes(Utf8Encoded(origin: "correct horse").bytes()),
        policy: Argon2Policy(),
        entropy: SystemEntropy(),
    ).string();
    out.writeln("stored as " + stored.slice(0, 10) + "…");
    out.writeln("login ok: ", PasswordCheck(stored: stored, password: SecretBytes(Utf8Encoded(origin: "correct horse").bytes())).matches());
    out.writeln("login wrong: ", PasswordCheck(stored: stored, password: SecretBytes(Utf8Encoded(origin: "battery staple").bytes())).matches());

    // 3. Authenticated encryption: a nonce never repeats for one key.
    let cipher = ChaCha20Poly1305(SecretBytes((0..32).map() -> index { byte(index); }));
    let nonce = CounterNonce(prefix: [byte(0), byte(0), byte(0), byte(1)], counter: 1, size: 12).bytes();
    let header = Utf8Encoded(origin: "record 7").bytes();
    let sealed = cipher.sealed(nonce, header, Utf8Encoded(origin: "balance: 42").bytes());
    out.writeln("sealed ", sealed.size(), " bytes (text + ", cipher.tag_size(), "-byte tag)");
    out.writeln("opened: ", Utf8Decoded(cipher.opened(nonce, header, sealed)));
    let tampered = try {
        cipher.opened(nonce, Utf8Encoded(origin: "record 8").bytes(), sealed);
        "accepted";
    }
    catch failure is AuthenticationFailed {
        "refused";
    };
    out.writeln("wrong header: " + tampered);
    0;
}
