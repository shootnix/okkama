module json_readers v1.0.0;

import "json" take ParsedJson;
import "io/stdout" take Stdout;

main() is int {
    let out = Stdout();
    let body = ParsedJson("{\"name\":\"\",\"active\":false}").root();
    let name = body.maybe("name").text() else "anonymous";
    let age = body.maybe("age").int() else 18;
    let active = body.maybe("active").boolean() else true;
    out.writeln("name=[" + name + "], age=" + age.string());
    out.writeln(active ?? "active" !! "inactive");
    for ["{}", "{\"name\":null}", "{\"name\":\"Anton\"}"] -> source {
        let patch = ParsedJson(source).root();
        let action = patch.presence("name").text()
            ?? .some(value): "New name: " + value
            !! .none: "Clear the name"
            !! .missing: "Keep the current name";
        out.writeln(action);
    }
    0;
}
