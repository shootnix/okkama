module examples/terminal/colors v1.0.0;

import "terminal/capability" take DetectedTerminalCapabilities, TerminalColorDepth, ColorPolicy;
import "terminal/style" take StyledText, TextStyle, NamedColor, RgbColor, DefaultColor, BasicColor,
    TextAttribute;
import "terminal/width" take DisplayWidth;
import "os/environment" take Environment;
import "io/stdout" take Stdout;

// How many colors a terminal shows is decided once, from what the terminal
// reports, the environment (NO_COLOR, TERM, COLORTERM) and the program's
// policy. Styled text then renders for that depth: true color, 256 colors,
// 8 colors, or plain text when colors are off. A real program reads
// TerminalSession().capabilities(); this one shows the decisions for fixed
// environments, and prints the escape codes instead of sending them.

object DepthName {
    has depth is TerminalColorDepth;

    DepthName(depth is TerminalColorDepth) {
        self.depth = depth;
    }

    string() is string {
        match depth {
            case TerminalColorDepth.disabled {
                "no colors";
            }
            case TerminalColorDepth.basic {
                "8 colors";
            }
            case TerminalColorDepth.indexed {
                "256 colors";
            }
            case TerminalColorDepth.true_color {
                "true color";
            }
        }
    }
}

main() is int {
    let out = Stdout();
    let cases = [
        ["xterm-256color", "", "automatic, TERM=xterm-256color"],
        ["xterm", "truecolor", "automatic, COLORTERM=truecolor"],
        ["dumb", "", "automatic, TERM=dumb"],
    ];
    for cases -> spec {
        let values = if spec[1] == "" {
            ["TERM": spec[0]];
        }
        else {
            ["TERM": spec[0], "COLORTERM": spec[1]];
        };
        let found = DetectedTerminalCapabilities(
            input: true,
            output: true,
            native_depth: TerminalColorDepth.basic,
            columns: 80,
            rows: 24,
            environment: Environment(values: values),
            policy: ColorPolicy.automatic
        ).capabilities();
        out.writeln(spec[2], " -> ", DepthName(found::Support::colors));
    }
    let piped = DetectedTerminalCapabilities(
        input: false,
        output: false,
        native_depth: TerminalColorDepth.true_color,
        columns: 0,
        rows: 0,
        environment: Environment(values: ["TERM": "xterm"]),
        policy: ColorPolicy.automatic
    ).capabilities();
    out.writeln("output to a pipe -> ", DepthName(piped::Support::colors));

    let warning = StyledText(
        origin: "warning",
        style: TextStyle(
            foreground: NamedColor(BasicColor.yellow),
            background: DefaultColor(),
            attributes: [TextAttribute.bold]
        )
    );
    let brand = StyledText(
        origin: "okkama",
        style: TextStyle(
            foreground: RgbColor(red: 200.byte(), green: 30.byte(), blue: 30.byte()),
            background: DefaultColor(),
            attributes: []
        )
    );
    for [
        TerminalColorDepth.true_color,
        TerminalColorDepth.indexed,
        TerminalColorDepth.basic,
        TerminalColorDepth.disabled
    ] -> depth {
        let shown = (warning.rendered(depth) + " " + brand.rendered(depth)).replace("\u{1b}", "ESC");
        out.writeln(DepthName(depth), ": ", shown);
    }

    // Wide characters take two columns; combining marks take none.
    for ["abc", "日本", "e\u{301}"] -> text {
        out.writeln("width of ", text, ": ", DisplayWidth(text).columns());
    }
    0;
}
