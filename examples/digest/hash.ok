module examples/digest/hash v1.0.0;

import "digest/blake2" take Blake2b;
import "digest/sha2" take Sha256, Sha512;
import "digest/sha3" take Sha3_256;
import "io/stdout" take Stdout;

// Hash text or bytes with SHA-2, SHA-3 and BLAKE2: all at once, or piece by
// piece as they arrive. A digest object is a running state; state(…)
// continues it without changing the original, so one prefix can branch into
// many. hex() writes the digest, bytes() gives it raw.

main() is int {
    let out = Stdout();
    let text = "hello world";

    out.writeln("sha256   ", Sha256(text).hex());
    out.writeln("sha512   ", Sha512(text).hex().slice(0, 32), "…");
    out.writeln("sha3-256 ", Sha3_256(text).hex());
    out.writeln("blake2b  ", Blake2b(length: 64, text: text).hex().slice(0, 32), "…");

    // Piece by piece gives the same digest as all at once.
    let streamed = Sha256().state("hello ").state("world");
    out.writeln("streamed matches: ", streamed.hex() == Sha256(text).hex());

    // A shared prefix branches without being recomputed.
    let prefix = Sha256().state("user:");
    let ada = prefix.state("ada");
    let bob = prefix.state("bob");
    out.writeln("branches differ: ", ada.hex() != bob.hex());
    0;
}
