module examples/web/https v1.0.0;

import "web/app" take WebApplication;
import "web/routing" take WebRoutes, Get;
import "web/request" take WebRequest;
import "web/reply" take TextReply;
import "http/message" take Responding;
import "http/client" take HttpClient;
import "http/endpoint" take LoopbackEndpoints;
import "http/version" take HttpVersion;
import "net/tls" take TlsIdentity;
import "crypto/x509/trust" take PemTrustStore;
import "collections/set" take Set, OrderedSet;
import "time/duration" take Duration;
import "io/stdout" take Stdout;

// HTTPS with HTTP/2. The server offers h2 and http/1.1 by ALPN: a client that
// speaks HTTP/2 gets it, an older one gets HTTP/1.1. The program serves on a
// free loopback port with a certificate made for this example, calls itself
// with both kinds of client, and drains. A real service reads its own
// certificate chain and key and calls
// `await WebApplication(routes).listen(address: "0.0.0.0", port: 8443, tls: identity);`
// which serves until SIGTERM or SIGINT, then lets the requests in flight
// finish within 10 seconds and returns.

object Greeting {
    Greeting();

    async hello(request is WebRequest) is Responding {
        TextReply("hello, " + request.path().text("name"));
    }
}

async main() is int {
    let out = Stdout();
    let routes = WebRoutes(Get(path: "/hello/:name", endpoint: Greeting().hello));
    let identity = TlsIdentity(certificates: CERTIFICATE, key: KEY);
    let server = (await WebApplication(routes).server("127.0.0.1", 0, identity)).started();
    let base = "https://127.0.0.1:" + server::Local::port.string();
    let both is Set<HttpVersion> = OrderedSet([HttpVersion.http_1_1, HttpVersion.http_2]);
    let modern = HttpClient(
        trust: PemTrustStore(AUTHORITY),
        endpoints: LoopbackEndpoints(),
        protocols: both
    );
    let older = HttpClient(trust: PemTrustStore(AUTHORITY), endpoints: LoopbackEndpoints());
    for [modern, older] -> client {
        let page = await client.get(base + "/hello/Ada");
        let version = if page::Head::version == HttpVersion.http_2 {
            "HTTP/2";
        }
        else {
            "HTTP/1.1";
        };
        out.writeln(version, " ", page::Head::code, " ", await page.text());
        client.close();
    }
    await server.drain(limit: Duration(seconds: 5));
    out.writeln("drained");
    0;
}

