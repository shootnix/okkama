module app v1.0.0;
import "config/ini" take ParsedIni, IniString;
object ExampleResult {
    ExampleResult();
    value() is string {
        let settings = ParsedIni("# explicit Okkama INI\n[settings]\nname=Ada\npath=C:\\tmp");
        IniString(settings).string();
    }
}

main() is int {
    ExampleResult().value();
    return 0;
}
