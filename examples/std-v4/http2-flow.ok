module app v1.0.0;
import "http/internal/http2_flow" take Http2FlowWindow,Http2SendCredit,Http2DataPayload,Http2WindowFrame,Http2WindowIncrement,Http2NoCredit;
import "http/internal/http2_frame" take Http2Frame,Http2FrameHeader,Http2FaultScope;
import "io/stdout" take Stdout;
// Pure accounting example; connection scheduler and transport own live flow.
main() is int{
    let data=Http2DataPayload(Http2Frame(Http2FrameHeader(0.byte(),9.byte(),1,5),[2.byte(),65.byte(),66.byte(),0.byte(),0.byte()]));
    let credit=Http2SendCredit(Http2FlowWindow(Http2FaultScope.connection,0,10),Http2FlowWindow(Http2FaultScope.stream,1,2));
    confirm try{credit=credit.spent(data.flow_bytes());false;}catch failure is Http2NoCredit{true;};
    let update=Http2WindowIncrement(Http2WindowFrame(1,3).frame());
    credit=Http2SendCredit(credit.connection(),credit.stream().credited(update.amount()));credit=credit.spent(data.flow_bytes());
    confirm credit.connection().remaining()==5 && credit.stream().remaining()==0;
    confirm data.bytes().size()==2 && data.flow_bytes()==5;
    Stdout().writeln("DATA: 2 application bytes, 5 flow bytes; both windows charged");0;
}
