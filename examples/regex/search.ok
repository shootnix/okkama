module examples/regex/search v1.0.0;

import "regex/pattern" take Regex, RegexFlag, NoRegexMatch;
import "regex/search" take FirstRegexMatch, EntireRegexMatch;
import "io/stdout" take Stdout;

// Find the first match, every match, named groups, and check a whole string.
// The regex answers the common questions itself: found and all.

main() is int {
    let out = Stdout();
    let log = "GET /index 200 12ms; POST /login 401 3ms; GET /about 200 7ms";
    let request = Regex("(?<method>[A-Z]+) (?<path>/\\w*) (?<status>\\d{3})");

    let first = FirstRegexMatch(origin: log, regex: request);
    out.writeln("first: ", first.text(), " at ", first.range()::Bounds::start);

    for request.all(log) -> found {
        out.writeln(found.group("method").text() + " " + found.group("path").text() + " -> " + found.group("status").text());
    }

    let failures = request.all(log).reduce(0) -> count, found {
        if found.group("status").text().starts_with("4") {
            count + 1;
        }
        else {
            count;
        }
    };
    out.writeln("failures: ", failures);
    out.writeln("any 5xx: ", Regex(" 5\\d\\d ").found(log));

    // A whole string, case-insensitively.
    let code = Regex(expression: "[a-z]{3}-\\d{4}", flags: [RegexFlag.ignore_case]);
    for ["ABC-1234", "abc-12345"] -> text {
        let verdict = try {
            EntireRegexMatch(origin: text, regex: code).text() + " is a code";
        }
        catch error is NoRegexMatch {
            text + " is not a code";
        };
        out.writeln(verdict);
    }
    0;
}
