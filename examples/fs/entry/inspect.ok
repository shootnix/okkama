module examples/fs/entry/inspect v1.0.0;

import "fs/entry" take FileEntry;
import "fs/file" take File, FileMode;
import "fs/path" take Path;
import "fs/stat" take FileKind;
import "io/stdout" take Stdout;

// A path on disk: is something there, what is it, how big, who may read it;
// then copy it, move it and remove it. Reading and writing belong to fs/file.

main() is int {
    let out = Stdout();
    let notes = FileEntry(path: Path("notes.txt"));
    out.writeln("before: ", notes.existence());

    let file = File(path: notes.path(), mode: FileMode.writing);
    file.text().writeln("buy milk");
    file.close();

    let stat = notes.stat();
    out.writeln("after: ", notes.existence());
    out.writeln("file: ", stat::Shape::kind == FileKind.file);
    out.writeln("bytes: ", stat::Shape::size);
    out.writeln("owner reads: ", stat.mode().owner()::Access::readable);

    // copy keeps the permission bits; neither copy nor move replaces what is
    // already there unless asked with overwrite: true.
    notes.copy(Path("notes.bak"));
    let backup = FileEntry(path: Path("notes.bak"));
    out.writeln("copied: ", backup.stat()::Shape::size, " bytes");
    notes.move(Path("notes.old"));
    let old = FileEntry(path: Path("notes.old"));
    out.writeln("moved: ", notes.existence(), " ", old.existence());
    backup.move(destination: Path("notes.old"), overwrite: true);
    out.writeln("backup over old: ", backup.existence(), " ", old.existence());
    old.remove();
    out.writeln("removed: ", old.existence());
    0;
}
