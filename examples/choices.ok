module choices v1.0.0;

import "io/stdout" take Stdout;

enum Status = (ready, failed);

object Patch {
    Patch();
    name() is Presence<string> { Presence.missing; }
}

main() is int {
    let out = Stdout();
    let enabled = true;
    let label = enabled ?? "enabled" !! "disabled";
    out.writeln(label);

    let description = Patch().name()
        ?? .some(value): "New name: " + value
        !! .none: "Clear the name"
        !! .missing: "Keep the current name";
    out.writeln(description);

    let optional = Maybe.some("");
    let name = optional ?? .some(value): value !! _: "anonymous";
    out.writeln("Empty string is present: " + (name == "" ?? "yes" !! "no"));

    let status = Status.ready ?? .ready: "ready" !! .failed: "failed";
    out.writeln(status);

    // Nested choices are forbidden, even inside parentheses.
    // Extract the inner decision to an independent local variable instead.
    let fallback = enabled ?? "guest" !! "offline";
    let display = Patch().name().fold() else fallback;
    out.writeln(display);
    if true { 0 } else { 1 };
}
