#!/usr/bin/env bash
# Запуск самодостаточных примеров галереи Okkama из любой рабочей папки.
# Использование: ./examples/gallery/run quicksort; run dirstat PATH; run check.
set -euo pipefail
GALLERY_DIR="$(cd "$(dirname "$0")" && pwd)"
REPOSITORY_DIR="$(cd "$GALLERY_DIR/../.." && pwd)"
# Интерпретатор: `okkama` из PATH (make install) или собранный в okkama-rs.
OKKAMA="${OKKAMA:-$(command -v okkama || echo "$REPOSITORY_DIR/okkama-rs/target/release/okkama")}"
export OKKAMA_GALLERY_DIR="$GALLERY_DIR"
export OKKAMA_STDLIB_DIR="$REPOSITORY_DIR/std"
example_name="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi
case "$example_name" in
  help|--help|-h)
    echo 'Run: ./examples/gallery/run NAME [ARGS]; see examples/gallery/README.md'
    ;;
  check) exec python3 "$GALLERY_DIR/script/check.py" "$@" ;;
  *)
    [[ "$example_name" =~ ^[a-z0-9-]+(/[a-z0-9-]+)*$ ]] || { echo 'Invalid example name' >&2; exit 2; }
    entry="$GALLERY_DIR/$example_name.ok"
    [[ -f "$entry" ]] || { echo 'Unknown example; see README.md' >&2; exit 2; }
    exec "$OKKAMA" "$entry" "$@"
    ;;
esac
