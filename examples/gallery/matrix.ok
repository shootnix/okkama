// Матрицы без изменения ячеек
// Задача: Умножить матрицы, транспонировать и проверить определитель.
// Запуск из корня: ./examples/gallery/run matrix
// Без аргументов выполняется встроенный пример; результат — stdout и проверки confirm.
// Приёмы Okkama: вложенные map/reduce, проверка размеров, чистые значения.
// Исходная задача: https://github.com/ash/rakupp/blob/main/examples/matrix.raku
// Объяснение и ожидаемый результат: examples/gallery/README.md.

module gallery/matrix v1.0.0;
import "io/stdout" take Stdout;
object Matrices {
    Matrices();
    columns(matrix is @@int) is int {
        confirm matrix.size()>0 && matrix[0].size()>0;
        let width=matrix[0].size();
        confirm matrix.reduce(true)->ok,row{ok && row.size()==width;};width;
    }
    transpose(matrix is @@int) is @@int {
        let width=self.columns(matrix);
        (0..width).map()->column{matrix.map()->row{row[column];};};
    }
    multiply(left is @@int,right is @@int) is @@int {
        confirm self.columns(left)==right.size();let columns=self.transpose(right);
        left.map()->row{columns.map()->column{
            (0..row.size()).reduce(0)->sum,i{sum+row[i]*column[i];};
        };};
    }
    identity(size is int) is @@int {
        confirm size>0;
        (0..size).map()->row{(0..size).map()->column{if row==column{1;}else{0;}};};
    }
    determinant(m is @@int) is int {
        confirm m.size()==3 && self.columns(m)==3;
        m[0][0]*(m[1][1]*m[2][2]-m[1][2]*m[2][1])
        -m[0][1]*(m[1][0]*m[2][2]-m[1][2]*m[2][0])
        +m[0][2]*(m[1][0]*m[2][1]-m[1][1]*m[2][0]);
    }
}
main() is int {
    let math=Matrices();let a=[[1,2,3],[4,5,6]];let b=[[7,8],[9,10],[11,12]];
    let product=math.multiply(a,b);confirm product==[[58,64],[139,154]];
    for product->row{Stdout().writeln(row.map()->n{n.string();}.join(" "));}
    let square=[[2,0,1],[3,5,4],[1,1,0]];
    confirm math.multiply(square,math.identity(3))==square;
    confirm math.transpose(math.transpose(a))==a;
    confirm math.determinant(square)==-10;
    Stdout().writeln("determinant = "+math.determinant(square).string());0;
}
