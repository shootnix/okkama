// Статическая диагностика: повторное объявление роли.
// Файл намеренно содержит ошибку и анализируется без выполнения main.
// Проверка: ./examples/gallery/run check --analysis-only
module gallery/analysis/duplicate_role v1.0.0;
role Reading{value() is int;}role Reading{value() is int;}main() is int{0;}
