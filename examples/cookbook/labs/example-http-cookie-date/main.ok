// Разобрать Expires в ответе сервера
//
// Разобрать Expires из Set-Cookie: ParsedCookieDate применяет специальную грамматику cookie-date.
//
// Запуск: ./examples/cookbook/run lab example-http-cookie-date
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-http-cookie-date
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "http/cookie_date" take ParsedCookieDate;
import "http/date" take HttpDate;
import "io/stdout" take Stdout;
main() is int {
    let expiry=ParsedCookieDate("Wednesday, 09-Jun-21 10:18:14 GMT").value();
    Stdout().writeln(HttpDate(expiry).string());
    confirm HttpDate(expiry).string()=="Wed, 09 Jun 2021 10:18:14 GMT";
    0;
}
