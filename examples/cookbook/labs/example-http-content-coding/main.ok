// Представить Content-Encoding ответа
//
// Обозначить Content-Encoding: ContentCoding представляет каноническое имя преобразования содержимого.
//
// Запуск: ./examples/cookbook/run lab example-http-content-coding
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-http-content-coding
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "http/content_coding" take ContentCoding;
import "io/stdout" take Stdout;
main() is int {
    Stdout().writeln(ContentCoding("GZip").string());
    Stdout().writeln(ContentCoding("X-Custom").string());0;
}
