// Адресовать имя клиента в шаблоне
//
// Назвать вложенное значение шаблона: TemplatePath сохраняет точные сегменты user.name.
//
// Запуск: ./examples/cookbook/run lab example-template-path
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-template-path
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "template/path" take TemplatePath, TemplatePathFromString;
import "compare" take Order;
object ExampleResult {
    ExampleResult();
    value() is any {
        let name = TemplatePathFromString("user.name").value();
        let literal = TemplatePath(["user.name"]);
        [name.string(), name.segments().size(), literal.order(name) == Order.greater];
    }
}

main() is int {
    ExampleResult().value();
    return 0;
}
