// Получить сведения локального интерфейса
//
// Проверить адрес и принадлежность подсети: IpAddress и IpNetwork работают с IPv4 и IPv6.
//
// Запуск: ./examples/cookbook/run lab example-network-interface
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-network-interface
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "net/ip" take IpAddress, IpInterface;
import "net/interface" take NetworkInterface;
import "io/stdout" take Stdout;

main() is int {
    let addresses is @IpInterface=[IpInterface(IpAddress("192.0.2.7"),24),
        IpInterface(IpAddress("2001:db8::8"),64)];
    let interface=NetworkInterface("example0",2,addresses,true,false);
    Stdout().writeln(interface.name()+" #"+interface.index().string());
    for interface.addresses() -> address {Stdout().writeln(address.string());}
    0;
}
