// Проверить JSON-поля заказа
//
// Из API пришли номер заказа и имя клиента; значения следует прочитать со строгими типами.
//
// Запуск: ./examples/cookbook/run lab recipe-json-read
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#recipe-json-read
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module cookbook/json_read v1.0.0;
import "json/parse" take ParsedJson;
import "json/read" take JsonView;
import "io/stdout" take Stdout;

main() is int {
    let order = JsonView(ParsedJson("{\"id\":4711,\"customer\":{\"name\":\"Ада\"}}"));
    confirm order.int("id") == 4711;
    Stdout().writeln(order.member("customer").text("name"));
    0;
}
