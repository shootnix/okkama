// Сформировать HTML-карточку заказа
//
// Сформировать HTML-карточку клиента: HtmlTemplate применяет экранирование по контексту подстановки.
//
// Запуск: ./examples/cookbook/run lab example-template-html
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-template-html
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "template/html" take HtmlTemplate;
import "json" take Json;
import "io/stdout" take Stdout;
main() is int {
    HtmlTemplate("<p title=\"{{.}}\">Hello {{.}}</p>\n").write(Json("Ada & <friends>"),Stdout());
    0;
}
