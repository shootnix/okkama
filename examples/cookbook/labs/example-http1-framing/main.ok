// Определить длину и способ передачи тела
//
// Разобрать стартовую строку и поля HTTP/1: ParsedHttp1RequestHead и ParsedHttp1ResponseHead проверяют head и бюджеты.
//
// Запуск: ./examples/cookbook/run lab example-http1-framing
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-http1-framing
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "http/http1_head" take ParsedHttp1ResponseHead;
import "http/http1_framing" take Http1ResponseFraming,Http1BodyKind;
import "http/method" take Method;
import "io/stdout" take Stdout;
main() is int {
    let head=ParsedHttp1ResponseHead("HTTP/1.1 200 OK\r\nContent-Length: 4\r\nConnection: close\r\n\r\n").value();
    let plan=Http1ResponseFraming(head,Method("GET")).plan();
    confirm plan.kind()==Http1BodyKind.fixed && !plan.reuse_after_eof();
    Stdout().writeln(plan.length().string());0;
}
