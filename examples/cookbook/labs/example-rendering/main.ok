// Собрать уведомление и JSON-сумму заказа
//
// Собрать короткое уведомление с подстановками: Formatted связывает шаблон и значения слотов {}.
//
// Запуск: ./examples/cookbook/run lab example-rendering
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-rendering
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module example v1.0.0;

import "strings/format" take Formatted;
import "json" take Json, JsonField;
import "math/decimal" take Decimal;

object ExampleResult {
    ExampleResult();
    value() is string {
        let greeting = Formatted(pattern: "Hello, {}!", values: ["Ada"]);
        (Json(fields: [
            JsonField(name: "greeting", value: Json(greeting.string())),
            JsonField(name: "amount", value: Json(Decimal("12.50"))),
        ])).string();
    }
}

main() is int {
    ExampleResult().value();
    return 0;
}
