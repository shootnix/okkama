// Разобрать структуру шаблона для инструмента проверки
//
// Посмотреть структуру шаблона перед обработкой: TemplateTree представляет узлы и вложенные секции.
//
// Запуск: ./examples/cookbook/run lab example-template-tree
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-template-tree
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "template/tree" take TemplateTree;
import "io/stdout" take Stdout;

main() is int {
    let nodes=TemplateTree("{{#users}}Hello {{name}}!{{/users}}{{>footer}}").nodes();
    Stdout().writeln(nodes[0].text());
    Stdout().writeln(nodes[0].children().size().string());
    Stdout().writeln(nodes[1].text());
    0;
}
