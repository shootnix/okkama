// Выгрузить строки таблицы в CSV
//
// Описать CSV-выгрузку товаров: CsvField, CsvRecord, CsvRows и CsvString задают записи и строковое представление.
//
// Запуск: ./examples/cookbook/run lab example-csv
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-csv
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "csv" take CsvString;
object ExampleResult {
    ExampleResult();
    value() is string {
        let rows is @@string = [["name", "note"], ["Ada", "commas, and quotes: \""]];
        CsvString(rows: rows).string();
    }
}

main() is int {
    ExampleResult().value();
    return 0;
}
