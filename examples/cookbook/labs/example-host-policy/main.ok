// Ограничить сетевые адреса клиента
//
// Связать сервер с портом: HostEndpoint и IpEndpoint отделяют DNS-имя от числового адреса.
//
// Запуск: ./examples/cookbook/run lab example-host-policy
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-host-policy
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "net/endpoint" take HostName, HostEndpoint;
import "net/public_suffix" take PublicSuffixList;
import "io/stdout" take Stdout;
main() is int {
    let host=HostName("BÜCHER.example");
    Stdout().writeln(HostEndpoint(host,443).string());
    let rules=PublicSuffixList();
    Stdout().writeln(rules.version());
    Stdout().writeln(rules.registrable(HostName("a.www.ck")).ascii());
    0;
}
