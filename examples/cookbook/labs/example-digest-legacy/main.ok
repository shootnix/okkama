// Сверить MD5 или SHA-1 старой выгрузки
//
// Сверить поле MD5 или SHA-1 старого формата обмена: Md5 и Sha1 вычисляют совместимое байтовое представление.
//
// Запуск: ./examples/cookbook/run lab example-digest-legacy
// Результат: stdout и проверки confirm, предусмотренные примером.
// Книга: docs/Okkama-Stdlib-RU.md#example-digest-legacy
// Условия и входы конкретного рецепта: LABS.md и раздел книги по указанному якорю.

module app v1.0.0;
import "digest/legacy" take Md5, Sha1;
import "encoding/utf" take Utf8Encoded;
import "encoding/hex" take HexEncoded;
import "io/stdout" take Stdout;

main() is int {
    let prefix = Md5(Utf8Encoded("ab").bytes());
    let complete = prefix.state(Utf8Encoded("c").bytes());
    Stdout().writeln(HexEncoded(complete.bytes()).string());
    Stdout().writeln(HexEncoded(Sha1(Utf8Encoded("abc").bytes()).bytes()).string());
    Stdout().writeln(HexEncoded(prefix.bytes()).string());
    0;
}
