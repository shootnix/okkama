module examples/time/zones v1.0.0;

import "time/zone" take Zone, ZonedDateTime, Fold, MissingLocalTime;
import "time/iso" take IsoText;
import "io/stdout" take Stdout;

// A meeting at 09:00 in Berlin: the instant it is, and what the clock shows
// in New York then. Zones come from the bundled IANA tzdata.

main() is int {
    let out = Stdout();
    let berlin = Zone("Europe/Berlin");
    let york = Zone("America/New_York");

    let meeting = berlin.instant(IsoText("2026-12-01T09:00:00").local_date_time());
    out.writeln("instant: " + meeting.string());
    let there = ZonedDateTime(instant: meeting, zone: york);
    out.writeln("New York: " + there.local_datetime().string() + " " + there.abbreviation());

    // When summer time ends, 02:30 happens twice: the earlier one is taken
    // unless the fold asks for the later.
    let twice = IsoText("2026-10-25T02:30:00").local_date_time();
    let early = berlin.instant(twice);
    let late = berlin.instant(local: twice, fold: Fold.later);
    out.writeln("02:30 twice: " + early.string() + " and " + late.string());

    // When it starts, 02:30 never happens.
    let gap = try {
        berlin.instant(IsoText("2026-03-29T02:30:00").local_date_time()).string();
    }
    catch MissingLocalTime.zone(name) {
        "no 02:30 in " + name + " that night";
    };
    out.writeln(gap);
    0;
}
