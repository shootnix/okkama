module examples/statistics/describe v1.0.0;

import "io/stdout" take Stdout;
import "statistics" take Modes, Pairs, Population, QuantileMethod, Sample, StatisticsError;

// Describe a set of measurements: centre, spread and quartiles of a sample,
// the same data taken as a whole population, the most frequent values, and
// a straight line fitted through paired data.

main() is int {
    let out = Stdout();
    let latencies = [12.0, 15.0, 11.0, 30.0, 14.0, 13.0, 15.0, 16.0];

    let sample = Sample(values: latencies);
    out.writeln("mean ", sample.mean(), " ms, median ", sample.median(), " ms");
    out.writeln("sample deviation ", sample.deviation());
    out.writeln("quartiles " + sample.quantiles(4).map() -> q { q.string(); }.join(", "));
    out.writeln("inclusive " + sample.quantiles(count: 4, method: QuantileMethod.inclusive).map() -> q { q.string(); }.join(", "));
    out.writeln("population variance ", Population(values: latencies).variance());
    out.writeln("most frequent ", Modes(values: latencies).first());

    let hours = [1.0, 2.0, 3.0, 4.0];
    let costs = [3.0, 5.0, 7.0, 9.0];
    let fit = Pairs(left: hours, right: costs).line();
    out.writeln("cost = ", fit::Line::slope, " * hours + ", fit::Line::intercept);
    out.writeln("6 hours cost ", fit.prediction(at: 6.0));

    let empty is @float = [];
    let refused = try {
        Sample(values: empty).mean().string();
    }
    catch StatisticsError.because(message) {
        message;
    };
    out.writeln(refused);
    0;
}
