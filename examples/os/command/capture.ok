module examples/os/command/capture v1.0.0;

import "fs/path" take Path;
import "os/command" take Command, InheritedCommand;
import "os/run" take Run;
import "os/command_capture" take CommandCapture, CaptureLimitExceeded;
import "os/directory" take WorkingDirectory;
import "os/environment" take Environment;
import "os/pipeline_capture" take PipelineCapture;
import "io/stdout" take Stdout;

// Run a program and collect what it prints. No shell is involved: each
// argument reaches the program as one exact string. Run finds a program on
// PATH and runs it with this process's environment; CommandCapture over a
// Command sets the environment, directory, input and limit. Output is bounded.

async main() is int {
    let out = Stdout();

    // Arguments with spaces and semicolons stay whole.
    out.writeln(await Run("printf", ["%s|%s", "a b", "c;d"]).text());
    out.writeln("success: ", (await Run("printf", ["x"]).completion()).exit().success());

    // Explicit context: an environment of our own, and the exit code.
    let check = Command(
        program: Path("sh"),
        arguments: ["-c", "echo \"$GREETING\" >&2; exit 3"],
        environment: Environment().addition("GREETING", "hello from stderr"),
        directory: WorkingDirectory(),
    );
    let checked = await CommandCapture(origin: check, limit: 1024).completion();
    out.write("stderr: " + checked::Captured::errors);
    out.writeln("exit code: ", checked.exit().code());

    // Standard input, then a pipeline: sort | uniq -c style counting.
    let sort = InheritedCommand(program: Path("sort"));
    let unique = InheritedCommand(program: Path("uniq"));
    let counted = await PipelineCapture(commands: [sort, unique], text: "b\na\nb\n", limit: 1024).completion();
    let words = counted::Captured::output;
    out.write("unique: " + words.replace("\n", " "));
    out.writeln("");

    // Too much output is an error, not a silent cut.
    let noisy = InheritedCommand(program: Path("printf"), arguments: ["0123456789"]);
    let verdict = try {
        await CommandCapture(origin: noisy, limit: 4).completion();
        "fit";
    }
    catch failure is CaptureLimitExceeded {
        "over the limit";
    };
    out.writeln("noisy: " + verdict);
    0;
}
