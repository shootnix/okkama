module examples/os/process/talk v1.0.0;

import "encoding/utf" take Utf8Decoded, Utf8Encoded;
import "fs/path" take Path;
import "io/decorators" take ByteSnapshot;
import "os/command" take InheritedCommand;
import "os/process" take ExitKind, Process, ProcessInput, ProcessOutput, Signal;
import "io/stdout" take Stdout;

// Talk to a running program: write to its input, close it to send EOF, read
// its output, wait for its exit. Nothing starts until the first question.
// A long-running program is stopped with a signal.

async main() is int {
    let out = Stdout();

    let upper = Process(command: InheritedCommand(program: Path("tr"), arguments: ["a-z", "A-Z"]));
    let input = ProcessInput(origin: upper);
    input.write(ByteSnapshot(Utf8Encoded(origin: "quiet words\n").bytes()));
    input.close();
    let output = ProcessOutput(origin: upper);
    let heard = Utf8Decoded(origin: output.bytes(64)).string();
    out.write("heard: " + heard);
    out.writeln("exit: " + (await upper.exit()).success().string());
    upper.close();

    let sleeper = Process(command: InheritedCommand(program: Path("sleep"), arguments: ["60"]));
    out.writeln("running: " + sleeper.running().string());
    sleeper.signal(Signal.terminate);
    let ended = await sleeper.exit();
    out.writeln("terminated: " + (ended::Status::kind == ExitKind.terminated).string());
    out.writeln("running: " + sleeper.running().string());
    sleeper.close();
    0;
}
