module examples/http/websocket/echo v1.0.0;

import "http/server" take HttpServer, ServerDrain;
import "http/server_policy" take ServerPolicy;
import "http/handler" take Handling, HandlingResult, WebSocketHandling, WebSocketHandlingResult;
import "http/request_context" take HttpRequestContext;
import "http/message" take Request;
import "http/header" take Headers, Header, HeaderName;
import "http/websocket" take WebSocketConnection, WebSocketLimits, TextWebSocketMessage, WebSocketClosed;
import "http/websocket_server" take WebSocketUpgrade;
import "http/websocket_origin" take SameOriginWebSockets;
import "http/websocket_client" take WebSocketConnecting, WebSocketPolicy;
import "http/endpoint" take ListedNetworks;
import "net/tcp" take TcpListening;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress, IpNetwork;
import "net/dns" take FixedResolution;
import "net/tls" take TlsClientPolicy;
import "crypto/x509/trust" take TrustedCertificates;
import "url/value" take ParsedUrl;
import "async/scope" take FutureGroup;
import "time/clock" take SystemClock;
import "time/duration" take Duration, DurationUnit;
import "io/stdout" take Stdout;

// A WebSocket server and client in one program. The handler answers an
// upgrade with a WebSocketUpgrade and an application object; the application
// then talks over the connection until the client closes. The server checks
// the Origin against its own URL, so the client sends one.

object Shouting does Handling, WebSocketHandling {
    Shouting();

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        WebSocketHandlingResult(
            origin: WebSocketUpgrade(
                protocols: [],
                limits: WebSocketLimits(),
                access: SameOriginWebSockets(),
                deadline: Duration(value: 5.rat(), unit: DurationUnit.second),
            ),
            application: self,
        );
    }

    async handle(connection is WebSocketConnection, request is Request, context is HttpRequestContext) is WebSocketHandling {
        try {
            loop {
                let message = await connection.message();
                await connection.send(TextWebSocketMessage(message.text().upper() + "!"));
            }
        }
        catch e is WebSocketClosed {
            self;
        }
        self;
    }
}

async main() is int {
    let out = Stdout();
    let clock = SystemClock();
    let listener = await TcpListening(IpEndpoint(address: IpAddress("127.0.0.1"), port: 0)).acceptance();
    let site = "http://127.0.0.1:" + listener.local_endpoint()::Parts::port.string();
    let server = HttpServer(origin: listener, handling: Shouting(), policy: ServerPolicy(), clock: clock, destination: ParsedUrl(site + "/").parts());
    let serving is FutureGroup<HttpServer> = FutureGroup();
    serving.start(server.serve());

    let connection = await WebSocketConnecting(
        url: ParsedUrl("ws://127.0.0.1:" + server.local_endpoint()::Parts::port.string() + "/shout").parts(),
        protocols: [],
        headers: Headers([Header(name: HeaderName("Origin"), value: site)]),
        resolver: FixedResolution([]),
        tls: TlsClientPolicy(TrustedCertificates([])),
        policy: WebSocketPolicy(
            limits: WebSocketLimits(),
            opening: Duration(value: 5.rat(), unit: DurationUnit.second),
            closing: Duration(value: 2.rat(), unit: DurationUnit.second),
            access: ListedNetworks([IpNetwork(address: IpAddress("127.0.0.0"), prefix: 8)]),
        ),
        clock: clock,
    ).connection();
    for ["hello", "how are you"] -> text {
        await connection.send(TextWebSocketMessage(text));
        out.writeln(text + " -> " + (await connection.message()).text());
    }
    await connection.close(1000, "bye");
    out.writeln("closed: " + connection.closed().string());

    await ServerDrain(server: server, limit: Duration(value: 5.rat(), unit: DurationUnit.second), clock: clock).drain();
    await serving.wait();
    0;
}
