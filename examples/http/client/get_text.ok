module examples/http/client/get_text v1.0.0;

import "http/client" take HttpClient;
import "http/status" take Status;
import "net/tcp" take TcpListening, TcpAcceptance;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress, IpNetwork;
import "net/dns" take FixedResolution;
import "http/endpoint" take ListedNetworks;
import "io/stdout" take Stdout;
import "io/decorators" take ByteSnapshot;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "async/atomic" take Atomic;
import "strings/parse" take Number;

// GET a page and print it as text, decoded by its charset.

async main() is int {
    let listener = await TcpListening(IpEndpoint(address: IpAddress("127.0.0.1"), port: 0)).acceptance();
    defer listener.close();
    let server = LocalServer(listener);
    // A real program writes HttpClient(); this one reaches its own local server.
    let client = HttpClient(
        resolver: FixedResolution([]),
        endpoints: ListedNetworks([IpNetwork(address: IpAddress("127.0.0.0"), prefix: 8)])
    );
    defer client.close();
    let answer is async (string) is bool = server.answer;
    let serving = spawn answer(
        "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 14\r\nConnection: close\r\n\r\nHello, wörld!"
    );

    let page = await client.get(server.url("/hello"));
    if page::Head::status == Status.ok {
        Stdout().writeln(await page.text());
    }

    await serving;
    0;
}

// Stands in for a real server: on 127.0.0.1 it takes one request, prints its
// first line and answers with `reply`.
hidden object LocalServer {
    has listener is TcpAcceptance;

    LocalServer(listener is TcpAcceptance) {
        self.listener = listener;
    }

    url(path is string) is string {
        "http://127.0.0.1:" + listener.local_endpoint().port().string() + path;
    }

    async answer(reply is string) is bool {
        let connection = await listener.connection();
        defer connection.close();
        let received = Atomic("");
        loop {
            let chunk = await connection.input().bytes(4096);
            if chunk.size() == 0 {
                last;
            }
            received.replace(received.value() + Utf8Decoded(chunk).string());
            let parts = received.value().split("\r\n\r\n");
            if parts.size() >= 2 {
                let sizes = parts[0].split("\r\n").filter() -> line {
                    line.lower().starts_with("content-length:");
                };
                let expected = if sizes.size() == 1 {
                    Number(sizes[0].split(":")[1].trim()).int();
                }
                else {
                    0;
                };
                if received.value().length() >= parts[0].length() + 4 + expected {
                    last;
                }
            }
        }
        Stdout().writeln("server got: " + received.value().split("\r\n")[0]);
        await connection.output().write(ByteSnapshot(Utf8Encoded(reply).bytes()));
        true;
    }
}
