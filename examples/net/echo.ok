module examples/net/echo v1.0.0;

import "encoding/utf" take Utf8Decoded, Utf8Encoded;
import "io/decorators" take ByteSnapshot;
import "io/stdout" take Stdout;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "net/tcp" take TcpConnecting, TcpListening, TcpOptions;

// A TCP echo over loopback: listen on a port the system picks, connect to
// it, send a line and read it back. Nothing leaves the machine. Each side
// closes what it opened.

async main() is int {
    let out = Stdout();
    let listener = await TcpListening(local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 0)).acceptance();
    defer listener.close();
    let port = listener.local_endpoint()::Parts::port;
    out.writeln("listening on a system-chosen port: " + (port > 0).string());

    let client = await TcpConnecting(
        remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: port),
        options: TcpOptions(keep_alive: false, no_delay: true),
    ).connection();
    defer client.close();
    let server = await listener.connection();
    defer server.close();
    out.writeln("peer is loopback: " + (server.endpoints().remote_endpoint().address() == IpAddress("127.0.0.1")).string());

    await client.output().write(ByteSnapshot(Utf8Encoded(origin: "hello over tcp").bytes()));
    let received = await server.input().bytes(64);
    await server.output().write(ByteSnapshot(received));
    let echoed = await client.input().bytes(64);
    out.writeln("echoed: " + Utf8Decoded(echoed).string());
    0;
}
