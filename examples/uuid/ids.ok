module examples/uuid/ids v1.0.0;

import "io/stdout" take Stdout;
import "strings/format" take Formatted;
import "random/source" take SecureRandom;
import "uuid/generation" take Uuid3, Uuid4s, Uuid5, Uuid8;
import "uuid/value" take InvalidUuid, Uuid, UuidBytes, UuidText, UuidVariant;

// Read a UUID from text, rebuild it from bytes, derive stable names from a
// namespace, pack custom bits, and draw random ones. Every maker is a Uuid
// and answers the same questions.

main() is int {
    let out = Stdout();
    let id is Uuid = UuidText("550E8400-E29B-41D4-A716-446655440000");
    out.writeln(Formatted("{} version {}, RFC variant: {}", id, id.version(), id.variant() == UuidVariant.rfc));
    out.writeln("from bytes: ", UuidBytes(id.bytes()));

    let dns is Uuid = UuidText("6ba7b810-9dad-11d1-80b4-00c04fd430c8");
    out.writeln("v3 ", Uuid3(namespace: dns, name: "www.example.com"));
    out.writeln("v5 ", Uuid5(namespace: dns, name: "www.example.com"));
    out.writeln("v8 ", Uuid8(high: 1, middle: 2, low: 3));

    let random = Uuid4s(random: SecureRandom()).sample();
    out.writeln(Formatted("random is version {}, {} characters", random.version(), random.string().length()));

    let refused = try {
        UuidText(origin: "550e8400e29b41d4a716446655440000").string();
    }
    catch InvalidUuid.because(message) {
        message;
    };
    out.writeln(refused);
    0;
}
