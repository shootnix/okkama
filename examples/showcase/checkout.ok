// Showcase: error enums, try?, catch patterns and the ?? !! ternary.
// Run: okkama examples/showcase/checkout.ok
module shop v1.0.0;

import "io/stdout" take Stdout;

enum PaymentError is Error = (
    declined(reason is string),
    timeout(ms is int)
);

object Gateway {
    Gateway();

    charge(cents is int) is string {
        confirm cents > 0 else throw PaymentError.declined("empty cart");
        "receipt #" + cents.string();
    }
}

main() is int {
    let out = Stdout();
    let gateway = Gateway();

    let receipt = try? gateway.charge(1500) else "no receipt";
    out.writeln(receipt);

    try {
        gateway.charge(0);
    }
    catch PaymentError.declined(reason) { out.writeln("declined: " + reason); }
    catch PaymentError.timeout(_) { out.writeln("try again later"); }

    out.writeln(receipt.length() > 10 ?? "paid" !! "unpaid");
    0;
}
