// Showcase: error enums with a cause, try? / try!, catch by case and by type list.
// Run: okkama examples/showcase/errors.ok
module app v1.0.0;

import "io/stdout" take Stdout;

enum DbError is Error = (
    connection(host is string),
    query(sql is string, code is int),
    closed
);

enum RepoError is Error = (db(cause is DbError), missing(id is int));

object Repo {
    Repo();

    find(id is int) is string {
        if id == 0 { throw RepoError.missing(id); }
        if id < 0 { throw RepoError.db(DbError.query("select", 42)); }
        "user " + id.string();
    }
}

main() is int {
    let out = Stdout();
    let repo = Repo();

    out.writeln(try? repo.find(0) else "nobody");

    let found = try {
        repo.find(-1);
    }
    catch RepoError.missing(id) {
        "no user " + id.string();
    }
    catch e is RepoError, DbError {
        e.text();
    };
    out.writeln(found);

    out.writeln(try! repo.find(7));
    0;
}
