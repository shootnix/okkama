// Book 20.2, 31.5; async/collect: result graph and duplicate future identities.
module ownership v1.0.0;

import "tap" take Tap;
import "async/atomic" take Atomic;
import "async/collect" take AllFutures;
import "async/event" take Event;

object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }

    label() is string {
        name;
    }

    destroy {
        log.replace(log.value() + name);
    }
}

enum Stop is Error = (now);

object Work {
    Work();
    async make(name is string, log is Atomic<string>) is Res {
        Res(name, log);
    }

    async waiting(log is Atomic<string>, ready is Event, never is Event) is Res {
        let local = Res("L", log);
        ready.set();
        await never.wait();
        Res("wrong", log);
    }

    async failed(log is Atomic<string>, ready is Event) is Res {
        await ready.wait();
        let local = Res("F", log);
        throw Stop.now;
    }
}

async main() is int {
    let t = Tap(6);
    let log = Atomic("");
    defer log.close();
    {
        let first = Work().make("A", log);
        let second = Work().make("B", log);
        let origins is @Future<Res> = [first, second, first];
        let collector is AllFutures<Res> = AllFutures(origins: origins);
        let results = await collector.results();
        results.item(0).label();
        results.item(2).label();
        t.note("all futures retains result graph including duplicate positions: " + log.value());
        t = t.is(log.value(), "", "all futures retains result graph including duplicate positions");
        let again = await collector.results();
        again.item(1).label();
        t.note("repeated collection shares settled values: " + log.value());
        t = t.is(log.value(), "", "repeated collection shares settled values");
    }

    t.note("duplicate future result closes once in reverse creation order: " + log.value());
    t = t.is(log.value(), "BA", "duplicate future result closes once in reverse creation order");
    log.replace("");
    {
        let origins is @Future<Res> = [];
        let empty = await AllFutures(origins: origins).results();
        empty.size();
    }

    t.note("empty collector introduces no resource: " + log.value());
    t = t.is(log.value(), "", "empty collector introduces no resource");
    {
        let ready = Event();
        let origins is @Future<Res> = [Work().waiting(log, ready, Event()), Work().failed(log, ready)];
        try {
            let results = await AllFutures(origins: origins).results();
            results.size();
        }

        catch e is Stop {
            t.note("failed input cleans itself before cancelled sibling: " + log.value());
            t = t.is(log.value(), "FL", "failed input cleans itself before cancelled sibling");
        }
    }

    t.note("failed collector settles after all resource cleanup: " + log.value());
    t = t.is(log.value(), "FL", "failed collector settles after all resource cleanup");
    t.done();
}
