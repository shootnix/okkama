// Book 12.2–12.7, 14.3, 15, 20.1–20.3: lexical ownership, fresh inputs, unwind, aggregates.
// Generated by gen.py, seed 560, case 053.
// scope=block; temporary=receiver; exit=normal; aggregate=array.
// A then B are constructed irrespective of map/capture traversal.
module ownership v1.0.0;

import "tap" take Tap;
import "async/atomic" take Atomic;

enum Stop is Error = (now);
object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }
    label() is string { name; }
    destroy { log.replace(log.value() + name); }
}
object Pair {
    has left is Res;
    has right is Res;
    Pair(left is Res, right is Res) {
        self.left = left;
        self.right = right;
    }
}
object Inspect {
    Inspect();
    take(value is Res) is void { value.label(); }
}

main() is int {
    let t = Tap(4);
    let log = Atomic("");
    defer log.close();
    {
        let outer = Res("O", log);
        t.note("outer resource stays live: " + log.value());
        t = t.is(log.value(), "", "outer resource stays live");
        try {
            {
                let head = Res("H", log);
                let aggregate = [Res("A", log), Res("B", log)];
                Res("T", log).label();
                t.note("temporary closes while aggregate stays live: " + log.value());
                t = t.is(log.value(), "T", "temporary closes while aggregate stays live");
                defer log.replace(log.value() + "d");
                0; // no resource escapes the scope tail
            }
            log.replace(log.value() + "s");
        } catch e is Stop {
            log.replace(log.value() + "c");
        }
        t.note("scope cleanup precedes continuation: " + log.value());
        t = t.is(log.value(), "TdBAHs", "scope cleanup precedes continuation");
    }
    t.note("outer cleanup follows inner cleanup: " + log.value());
    t = t.is(log.value(), "TdBAHsO", "outer cleanup follows inner cleanup");
    t.done();
}
