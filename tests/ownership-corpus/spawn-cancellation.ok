// Book 15, 20.3, 31.5: cooperative spawn, cancellation waits for child cleanup.
module ownership v1.0.0;

import "tap" take Tap;
import "async/atomic" take Atomic;
import "async/event" take Event;

object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }

    label() is string {
        name;
    }

    destroy {
        log.replace(log.value() + name);
    }
}

object Work {
    Work();
    async child(log is Atomic<string>, ready is Event, gate is Event) is int {
        let b = Res("B", log);
        defer log.replace(log.value() + "d");
        ready.set();
        await gate.wait();
        1;
    }

    async parent(log is Atomic<string>, ready is Event, gate is Event) is int {
        let a = Res("A", log);
        await self.child(log, ready, gate);
    }
}

async main() is int {
    let t = Tap(5);
    let log = Atomic("");
    defer log.close();
    let ready = Event();
    let task = spawn Work().parent(log, ready, Event());
    await ready.wait();
    t.note("spawned parent and child resources stay live while suspended: " + log.value());
    t = t.is(log.value(), "", "spawned parent and child resources stay live while suspended");
    task.cancel();
    t.note("requesting cancellation is not completion: " + log.value());
    t = t.is(log.value(), "", "requesting cancellation is not completion");
    try {
        await task;
    } catch e is Cancelled {
        t.note("child cleanup completes before parent cleanup and catch: " + log.value());
        t = t.is(log.value(), "dBA", "child cleanup completes before parent cleanup and catch");
    }

    t.note("cancelled future settles only after full unwind: " + log.value());
    t = t.is(log.value(), "dBA", "cancelled future settles only after full unwind");
    task.cancel();
    t.note("repeated cancellation does not destroy twice: " + log.value());
    t = t.is(log.value(), "dBA", "repeated cancellation does not destroy twice");
    t.done();
}
