// Pending #578: cold-futures.
// Book 20.2: "An escaping Future transfers fresh owned dependencies; borrowed outer resources retain their existing owner."
// Book 20.2, 31.5: lazy futures retain receiver and arguments before startup.
module ownership v1.0.0;

import "tap" take Tap;
import "async/atomic" take Atomic;

object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }

    label() is string {
        name;
    }

    destroy {
        log.replace(log.value() + name);
    }
}

object Receiver {
    has name is string;
    has log is Atomic<string>;
    Receiver(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }

    async read(arg is Res) is string {
        name + arg.label();
    }

    destroy {
        log.replace(log.value() + name);
    }
}

object Factory {
    Factory();
    make(log is Atomic<string>) is Future<string> {
        Receiver("R", log).read(Res("A", log));
    }
}

async main() is int {
    let t = Tap(2);
    let log = Atomic("");
    defer log.close();
    {
        let cold = Factory().make(log);
        t.note("escaping unstarted future transfers fresh dependencies: " + log.value());
        t = t.is(log.value(), "", "escaping unstarted future transfers fresh dependencies");
    }

    log.replace("");
    {
        let cold = Factory().make(log);
        cold.cancel();
        t.note("cancel request alone does not run resource cleanup: " + log.value());
        t = t.is(log.value(), "", "cancel request alone does not run resource cleanup");
        try {
            await cold;
        } catch e is Cancelled {
            e.text();
        }
    }

    t.done();
}
