// Book 20.2, 31.5: lazy futures retain receiver and arguments before startup.
module ownership v1.0.0;

import "tap" take Tap;
import "async/atomic" take Atomic;

object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }

    label() is string {
        name;
    }

    destroy {
        log.replace(log.value() + name);
    }
}

object Receiver {
    has name is string;
    has log is Atomic<string>;
    Receiver(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }

    async read(arg is Res) is string {
        name + arg.label();
    }

    destroy {
        log.replace(log.value() + name);
    }
}

object Factory {
    Factory();
    make(log is Atomic<string>) is Future<string> {
        Receiver("R", log).read(Res("A", log));
    }
}

async main() is int {
    let t = Tap(10);
    let log = Atomic("");
    defer log.close();
    {
        let cold = Factory().make(log);
        t.note("escaping unstarted future transfers fresh dependencies: " + log.value());
        t = t.is(log.value(), "", "escaping unstarted future transfers fresh dependencies");
    }

    t.note("never-awaited future releases dependencies once: " + log.value());
    t = t.is(log.value(), "AR", "never-awaited future releases dependencies once");
    log.replace("");
    {
        let cold = Factory().make(log);
        cold.cancel();
        t.note("cancel request alone does not run resource cleanup: " + log.value());
        t = t.is(log.value(), "", "cancel request alone does not run resource cleanup");
        try {
            await cold;
        } catch e is Cancelled {
            e.text();
        }
    }

    t.note("cancelled-before-start future releases dependencies: " + log.value());
    t = t.is(log.value(), "AR", "cancelled-before-start future releases dependencies");
    log.replace("");
    {
        let receiver = Receiver("R", log);
        let arg = Res("A", log);
        {
            let cold = receiver.read(arg);
        }

        t.note("cold future borrows existing caller-owned dependencies: " + log.value());
        t = t.is(log.value(), "", "cold future borrows existing caller-owned dependencies");
    }

    t.note("outer owner retains borrowed future dependencies: " + log.value());
    t = t.is(log.value(), "AR", "outer owner retains borrowed future dependencies");
    log.replace("");
    {
        let cold = Factory().make(log);
        let first = await cold;
        t.note("escaped future result: " + first);
        t = t.is(first, "RA", "escaped future runs with live dependencies");
        let second = await cold;
        t.note("repeated await result: " + second);
        t = t.is(second, "RA", "repeated await uses cached result");
        t.note("await keeps dependencies in future owner: " + log.value());
        t = t.is(log.value(), "", "await keeps dependencies in future owner");
    }

    t.note("awaited future releases dependencies once in reverse order: " + log.value());
    t = t.is(log.value(), "AR", "awaited future releases dependencies once in reverse order");
    t.done();
}
