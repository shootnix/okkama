module plist/value v1.0.0;

import "collections/sequence" take Sequencing;
import "numbers/bigint" take BigInt;
import "time/clock" take Instant;

// Immutable property-list values, independent from JSON and any wire format.
// Scalars retain their exact payloads: arbitrary signed BigInt, finite float,
// exact Unicode string/bytes, Instant, and nonnegative BigInt UID. No coercion,
// timezone conversion, reference resolution or serialization-specific narrowing.
//
//     let value = PlistDictionary([
//         PlistMember("enabled", PlistBoolean(true)),
//         PlistMember("name", PlistString("Okkama")),
//     ]);
//     value.membership("enabled"); // true
//     value.print(recipient);      // one nominal members event
//
// print() emits exactly one typed event; the recipient chooses recursion and
// owns traversal/output limits. No reflection, casting, hidden I/O or JSON
// conversion. Repeated calls repeat the event; callback failures propagate.
// Container constructors never call child kind()/print(). Custom PlistValue
// implementations are accepted nominally, with their own behavior/lifetime.
//
// Arrays/dictionaries snapshot size once, then ascending items once, borrowing
// their source without cursor/first/last/close calls. Negative maximum_items
// fails before source observation; negative/excess size fails before item reads.
// Default cardinality is 1024; zero accepts empty input. Source errors propagate
// and stop reads. Queries use retained snapshots, which can escape the source
// scope. No resource acquisition or destroy. Cardinality bounds references,
// not complete tree depth/bytes; scalar payload sizes remain caller-owned.
//
// Dictionary members are ordered nominal entries rather than a native map.
// Names are exact strings, including empty; no trimming/case/Unicode folding.
// Duplicate detection is O(n²) after snapshot; lookup O(n), storage O(n).
// Duplicate/missing names have distinct typed errors retaining the exact name.
// XML/binary parsing and writing belong to later modules, not this model.
// Contract: docs/std/plist-value-guide.md.
// Run: OKKAMA_STDLIB_DIR=std perl okkama-pl/bin/okkama -t std/plist/value.ok

enum PlistKind = (boolean_value, integer_value, real_value, string_value, data_value, date_value, array_value, dictionary_value, uid_value);

role PlistValue {
    kind() is PlistKind;
    print(to is PlistWriting) is void;
}

role PlistWriting {
    boolean(value is bool) is void;
    integer(value is BigInt) is void;
    real(value is float) is void;
    text(value is string) is void;
    data(value is @byte) is void;
    date(value is Instant) is void;
    elements(values is Sequencing<PlistValue>) is void;
    members(values is Sequencing<PlistMember>) is void;
    uid(value is BigInt) is void;
}

object PlistBoolean does PlistValue {
    has origin is bool;

    PlistBoolean(value is bool) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.boolean_value;
    }

    bool() is bool {
        origin;
    }

    print(to is PlistWriting) is void {
        to.boolean(origin);
    }
}

object PlistInteger does PlistValue {
    has origin is BigInt;

    PlistInteger(value is BigInt) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.integer_value;
    }

    integer() is BigInt {
        origin;
    }

    print(to is PlistWriting) is void {
        to.integer(origin);
    }
}

object PlistReal does PlistValue {
    has origin is float;

    PlistReal(value is float) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.real_value;
    }

    float() is float {
        origin;
    }

    print(to is PlistWriting) is void {
        to.real(origin);
    }
}

object PlistString does PlistValue {
    has origin is string;

    PlistString(value is string) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.string_value;
    }

    string() is string {
        origin;
    }

    print(to is PlistWriting) is void {
        to.text(origin);
    }
}

object PlistData does PlistValue {
    has origin is @byte;

    PlistData(value is @byte) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.data_value;
    }

    bytes() is @byte {
        origin;
    }

    print(to is PlistWriting) is void {
        to.data(origin);
    }
}

object PlistDate does PlistValue {
    has origin is Instant;

    PlistDate(value is Instant) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.date_value;
    }

    instant() is Instant {
        origin;
    }

    print(to is PlistWriting) is void {
        to.date(origin);
    }
}

// UIDs are opaque nonnegative identifiers. This model never resolves them to
// another object, and never narrows them to a particular binary field width.
object PlistUid does PlistValue {
    has origin is BigInt;

    PlistUid(value is BigInt) {
        confirm value.sign() >= 0 else throw InvalidPlistUid.invalid;
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.uid_value;
    }

    number() is BigInt {
        origin;
    }

    print(to is PlistWriting) is void {
        to.uid(origin);
    }
}

object PlistMember {
    has key is string;
    has origin is PlistValue;

    PlistMember(name is string, value is PlistValue) {
        key = name;
        origin = value;
    }

    name() is string {
        key;
    }

    value() is PlistValue {
        origin;
    }
}

object PlistArray does PlistValue {
    has origin is @PlistValue;

    PlistArray(values is Sequencing<PlistValue>) {
        origin = PlistArraySnapshot(source: values, maximum: 1024).items();
    }

    PlistArray(values is Sequencing<PlistValue>, maximum_items is int) {
        origin = PlistArraySnapshot(source: values, maximum: maximum_items).items();
    }

    kind() is PlistKind {
        PlistKind.array_value;
    }

    values() is Sequencing<PlistValue> {
        origin;
    }

    print(to is PlistWriting) is void {
        to.elements(origin);
    }
}

object PlistDictionary does PlistValue {
    has origin is @PlistMember;

    PlistDictionary(members is Sequencing<PlistMember>) {
        origin = PlistDictionarySnapshot(source: members, maximum: 1024).items();
    }

    PlistDictionary(members is Sequencing<PlistMember>, maximum_items is int) {
        origin = PlistDictionarySnapshot(source: members, maximum: maximum_items).items();
    }

    kind() is PlistKind {
        PlistKind.dictionary_value;
    }

    members() is Sequencing<PlistMember> {
        origin;
    }

    membership(name is string) is bool {
        for origin -> member {
            if member.name() == name {
                return true;
            }
        }
        false;
    }

    value(name is string) is PlistValue {
        for origin -> member {
            if member.name() == name {
                return member.value();
            }
        }
        throw MissingPlistMember.name(name);
    }

    print(to is PlistWriting) is void {
        to.members(origin);
    }
}

// Internal preconstruction snapshots shared by constructor overloads. Imported
// only as implementation collaborators; Okkama has no module-private objects.
hidden object PlistArraySnapshot {
    has origin is @PlistValue;

    PlistArraySnapshot(source is Sequencing<PlistValue>, maximum is int) {
        confirm maximum >= 0 else throw InvalidPlistContainerLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidPlistContainerSize.invalid;
        confirm size <= maximum else throw PlistContainerLimitExceeded.exceeded;
        let values is @PlistValue = (0..size).map() -> index {
            let value is PlistValue = source.item(index);
            value;
        };
        origin = values;
    }

    items() is @PlistValue {
        origin;
    }
}

hidden object PlistDictionarySnapshot {
    has origin is @PlistMember;

    PlistDictionarySnapshot(source is Sequencing<PlistMember>, maximum is int) {
        confirm maximum >= 0 else throw InvalidPlistContainerLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidPlistContainerSize.invalid;
        confirm size <= maximum else throw PlistContainerLimitExceeded.exceeded;
        let values is @PlistMember = (0..size).map() -> index {
            source.item(index);
        };
        for (0..size) -> index {
            for (0..index) -> previous {
                confirm values[previous].name() != values[index].name()
                    else throw DuplicatePlistMember.name(values[index].name());
            }
        }
        origin = values;
    }

    items() is @PlistMember {
        origin;
    }
}

enum InvalidPlistUid is Error = (invalid);

enum MissingPlistMember is Error = (name(name is string));

enum DuplicatePlistMember is Error = (name(name is string));

enum InvalidPlistContainerLimit is Error = (invalid);

enum InvalidPlistContainerSize is Error = (invalid);

enum PlistContainerLimitExceeded is Error = (exceeded);

test "plist scalar payloads keep their own nominal kinds" {
    test.ok(PlistBoolean(true).bool());
    test.ok(PlistString("text").kind() == PlistKind.string_value);
    test.is(PlistString(" text ").string(), " text ");
    test.is(PlistData([byte(0), byte(255)]).bytes().size(), 2);
    test.is(PlistReal(1.25).float(), 1.25);
}

test "plist containers preserve order and exact member names" {
    let value = PlistDictionary(
        [PlistMember(name: "z", value: PlistBoolean(true)), PlistMember(name: "", value: PlistString("last"))]
    );
    test.is(value.members().item(0).name(), "z");
    test.is(value.members().item(1).name(), "");
    test.ok(value.membership(""));
    test.ok(!value.membership("Z"));
    test.ok(PlistArray([value]).values().item(0).kind() == PlistKind.dictionary_value);
}

test "plist missing duplicate and cardinality failures are typed" {
    test.is(
        try {
            PlistDictionary([]).value("lost");
            "bad";
        }
        catch MissingPlistMember.name(name) {
            name;
        },
        "lost"
    );
    test.is(
        try {
            PlistDictionary([PlistMember(name: "x", value: PlistString("")), PlistMember(name: "x", value: PlistString(""))]);
            "bad";
        }
        catch DuplicatePlistMember.name(name) {
            name;
        },
        "x"
    );
    test.is(PlistArray(values: [], maximum_items: 0).values().size(), 0);
    test.throws(InvalidPlistContainerLimit) {
        PlistArray(values: [], maximum_items: -1);
    };
    test.ok(try {
        PlistDictionary(members: [PlistMember("x", PlistBoolean(true))], maximum_items: 0);
        false;
    }
    catch error is PlistContainerLimitExceeded {
        true;
    });
}
