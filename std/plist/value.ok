module plist/value v1.0.0;

import "collections/sequence" take Sequencing;
import "numbers/bigint" take BigInt;
import "time/clock" take Instant;
import "async/atomic" take Atomic;

// Immutable property-list values, independent from JSON and any wire format.
// Scalars retain their exact payloads: arbitrary signed BigInt, finite float,
// exact Unicode string/bytes, Instant, and nonnegative BigInt UID. No coercion,
// timezone conversion, reference resolution or serialization-specific narrowing.
//
//     let value = PlistDictionary(
//         PlistMember("enabled", PlistBoolean(true)),
//         PlistMember("name", PlistString("Okkama")),
//     );
//     value.membership("enabled"); // true
//     value.print(recipient);      // one nominal members event
//
// print() emits exactly one typed event; the recipient chooses recursion and
// owns traversal/output limits. No reflection, casting, hidden I/O or JSON
// conversion. Repeated calls repeat the event; callback failures propagate.
// Container constructors never call child kind()/print(). Custom PlistValue
// implementations are accepted nominally, with their own behavior/lifetime.
//
// Arrays/dictionaries snapshot size once, then ascending items once, borrowing
// their source without cursor/first/last/close calls. Negative maximum_items
// fails before source observation; negative/excess size fails before item reads.
// Default cardinality is 1024; zero accepts empty input. Source errors propagate
// and stop reads. Queries use retained snapshots, which can escape the source
// scope. No resource acquisition or destroy. Cardinality bounds references,
// not complete tree depth/bytes; scalar payload sizes remain caller-owned.
//
// Dictionary members are ordered nominal entries rather than a native map.
// Names are exact strings, including empty; no trimming/case/Unicode folding.
// Duplicate detection is O(n²) after snapshot; lookup O(n), storage O(n).
// Duplicate/missing names have distinct typed errors retaining the exact name.
// XML/binary parsing and writing belong to later modules, not this model.
// Contract: docs/std/plist-value-guide.md.
// Run: okkama run -t std/plist/value.ok

enum PlistKind = (boolean_value, integer_value, real_value, string_value, data_value, date_value, array_value, dictionary_value, uid_value);

role PlistValue {
    kind() is PlistKind;
    print(to is PlistWriting) is void;
}

role PlistWriting {
    boolean(value is bool) is void;
    integer(value is BigInt) is void;
    real(value is float) is void;
    text(value is string) is void;
    data(value is @byte) is void;
    date(value is Instant) is void;
    elements(values is Sequencing<PlistValue>) is void;
    members(values is Sequencing<PlistMember>) is void;
    uid(value is BigInt) is void;
}

object PlistBoolean does PlistValue {
    has origin is bool;

    PlistBoolean(value is bool) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.boolean_value;
    }

    bool() is bool {
        origin;
    }

    print(to is PlistWriting) is void {
        to.boolean(origin);
    }
}

object PlistInteger does PlistValue {
    has origin is BigInt;

    PlistInteger(value is BigInt) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.integer_value;
    }

    integer() is BigInt {
        origin;
    }

    print(to is PlistWriting) is void {
        to.integer(origin);
    }
}

object PlistReal does PlistValue {
    has origin is float;

    PlistReal(value is float) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.real_value;
    }

    float() is float {
        origin;
    }

    print(to is PlistWriting) is void {
        to.real(origin);
    }
}

object PlistString does PlistValue {
    has origin is string;

    PlistString(value is string) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.string_value;
    }

    string() is string {
        origin;
    }

    print(to is PlistWriting) is void {
        to.text(origin);
    }
}

object PlistData does PlistValue {
    has origin is @byte;

    PlistData(value is @byte) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.data_value;
    }

    bytes() is @byte {
        origin;
    }

    print(to is PlistWriting) is void {
        to.data(origin);
    }
}

object PlistDate does PlistValue {
    has origin is Instant;

    PlistDate(value is Instant) {
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.date_value;
    }

    instant() is Instant {
        origin;
    }

    print(to is PlistWriting) is void {
        to.date(origin);
    }
}

// UIDs are opaque nonnegative identifiers. This model never resolves them to
// another object, and never narrows them to a particular binary field width.
object PlistUid does PlistValue {
    has origin is BigInt;

    PlistUid(value is BigInt) {
        confirm value.sign() >= 0 else throw InvalidPlistUid.invalid;
        origin = value;
    }

    kind() is PlistKind {
        PlistKind.uid_value;
    }

    number() is BigInt {
        origin;
    }

    print(to is PlistWriting) is void {
        to.uid(origin);
    }
}

object PlistMember {
    has key is string;
    has origin is PlistValue;

    PlistMember(name is string, value is PlistValue) {
        key = name;
        origin = value;
    }

    name() is string {
        key;
    }

    value() is PlistValue {
        origin;
    }
}

object PlistArray does PlistValue {
    has origin is @PlistValue;

    PlistArray(values is Sequencing<PlistValue>) {
        origin = PlistArraySnapshot(source: values, maximum: 1024).items();
    }

    // The same, one argument per part: PlistArray(a, b).
    PlistArray(values is ...PlistValue) {
        let listed is @PlistValue = values...;
        origin = PlistArraySnapshot(source: listed, maximum: 1024).items();
    }

    PlistArray(values is Sequencing<PlistValue>, maximum_items is int) {
        origin = PlistArraySnapshot(source: values, maximum: maximum_items).items();
    }

    kind() is PlistKind {
        PlistKind.array_value;
    }

    values() is Sequencing<PlistValue> {
        origin;
    }

    print(to is PlistWriting) is void {
        to.elements(origin);
    }
}

// A dictionary reads like json (#141): text(name), int(name), float(name),
// boolean(name), data(name) for bytes, date(name) for an Instant, get(name)
// for a nested dictionary, dictionaries(name) for an array of them, texts(name)
// and ints(name) for arrays, and maybe(name) for a key that may be absent:
//
//     let info = ParsedPlist(bytes).dictionary();
//     info.text("CFBundleIdentifier");
//     info.date("Built");
//     info.maybe("LSUIElement").boolean() else false;
//
// A missing key is MissingPlistMember; a value of another kind is
// PlistKindMismatch, which names the key and both kinds. No value is
// converted: an integer is not a real.
object PlistDictionary does PlistValue {
    has origin is @PlistMember;
    has positions is %string:int;

    PlistDictionary(members is Sequencing<PlistMember>) {
        let snapshot = PlistDictionarySnapshot(source: members, maximum: 1024);
        origin = snapshot.items();
        positions = snapshot.positions();
    }

    // The same, one argument per part: PlistDictionary(a, b).
    PlistDictionary(members is ...PlistMember) {
        let listed is @PlistMember = members...;
        let snapshot = PlistDictionarySnapshot(source: listed, maximum: 1024);
        origin = snapshot.items();
        positions = snapshot.positions();
    }

    PlistDictionary(members is Sequencing<PlistMember>, maximum_items is int) {
        let snapshot = PlistDictionarySnapshot(source: members, maximum: maximum_items);
        origin = snapshot.items();
        positions = snapshot.positions();
    }

    kind() is PlistKind {
        PlistKind.dictionary_value;
    }

    members() is Sequencing<PlistMember> {
        origin;
    }

    membership(name is string) is bool {
        positions.has(name);
    }

    value(name is string) is PlistValue {
        confirm positions.has(name) else throw MissingPlistMember.name(name);
        let index = positions[name];
        origin[index].value();
    }

    print(to is PlistWriting) is void {
        to.members(origin);
    }

    text(name is string) is string {
        PlistRead(name: name, value: self.value(name)).text();
    }

    int(name is string) is int {
        PlistRead(name: name, value: self.value(name)).int();
    }

    float(name is string) is float {
        PlistRead(name: name, value: self.value(name)).float();
    }

    boolean(name is string) is bool {
        PlistRead(name: name, value: self.value(name)).boolean();
    }

    data(name is string) is @byte {
        PlistRead(name: name, value: self.value(name)).data();
    }

    date(name is string) is Instant {
        PlistRead(name: name, value: self.value(name)).date();
    }

    // The nested dictionary under name.
    get(name is string) is PlistDictionary {
        PlistRead(name: name, value: self.value(name)).dictionary();
    }

    // The dictionaries of an array of them.
    dictionaries(name is string) is @PlistDictionary {
        PlistRead(name: name, value: self.value(name)).dictionaries();
    }

    texts(name is string) is @string {
        PlistRead(name: name, value: self.value(name)).texts();
    }

    ints(name is string) is @int {
        PlistRead(name: name, value: self.value(name)).ints();
    }

    // A key that may be absent: its reads give Maybe, so a fallback is
    // `info.maybe("LSUIElement").boolean() else false`; a value of another kind
    // is still PlistKindMismatch.
    maybe(name is string) is PlistMaybeReader {
        PlistMaybeReader(dictionary: self, name: name);
    }
}

// The reads of a key that may be absent; see PlistDictionary.maybe.
object PlistMaybeReader {
    has dictionary is PlistDictionary;
    has name is string;

    PlistMaybeReader(dictionary is PlistDictionary, name is string) {
        self.dictionary = dictionary;
        self.name = name;
    }

    text() is Maybe<string> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.text(name));
        }
        Maybe<string>.none;
    }

    int() is Maybe<int> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.int(name));
        }
        Maybe<int>.none;
    }

    float() is Maybe<float> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.float(name));
        }
        Maybe<float>.none;
    }

    boolean() is Maybe<bool> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.boolean(name));
        }
        Maybe<bool>.none;
    }

    data() is Maybe<@byte> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.data(name));
        }
        Maybe<@byte>.none;
    }

    date() is Maybe<Instant> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.date(name));
        }
        Maybe<Instant>.none;
    }

    get() is Maybe<PlistDictionary> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.get(name));
        }
        Maybe<PlistDictionary>.none;
    }

    texts() is Maybe<@string> {
        if dictionary.membership(name) {
            return Maybe.some(dictionary.texts(name));
        }
        Maybe<@string>.none;
    }
}

// A value of another kind than the read asked for: the key (with [index] for
// an array item), the kind asked for and the kind found.
enum PlistKindMismatch is Error = (member(name is string, expected is PlistKind, found is PlistKind));

// One value read as the kind asked for.
hidden object PlistRead {
    has name is string;
    has value is PlistValue;

    PlistRead(name is string, value is PlistValue) {
        self.name = name;
        self.value = value;
    }

    text() is string {
        self.seen(PlistKind.string_value).string();
    }

    int() is int {
        self.seen(PlistKind.integer_value).int();
    }

    float() is float {
        self.seen(PlistKind.real_value).float();
    }

    boolean() is bool {
        self.seen(PlistKind.boolean_value).bool();
    }

    data() is @byte {
        self.seen(PlistKind.data_value).bytes();
    }

    date() is Instant {
        self.seen(PlistKind.date_value).instant();
    }

    dictionary() is PlistDictionary {
        PlistDictionary(self.seen(PlistKind.dictionary_value).member_list());
    }

    dictionaries() is @PlistDictionary {
        let items = self.items();
        (0..items.size()).map() -> index {
            PlistRead(name: name + "[" + index.string() + "]", value: items[index]).dictionary();
        };
    }

    texts() is @string {
        let items = self.items();
        (0..items.size()).map() -> index {
            PlistRead(name: name + "[" + index.string() + "]", value: items[index]).text();
        };
    }

    ints() is @int {
        let items = self.items();
        (0..items.size()).map() -> index {
            PlistRead(name: name + "[" + index.string() + "]", value: items[index]).int();
        };
    }

    hidden items() is @PlistValue {
        self.seen(PlistKind.array_value).item_list();
    }

    hidden seen(expected is PlistKind) is PlistCapture {
        let found = value.kind();
        confirm found == expected else throw PlistKindMismatch.member(name, expected, found);
        let capture = PlistCapture();
        value.print(capture);
        capture;
    }
}

// What one print() gave, for the kinds read.
hidden object PlistCapture does PlistWriting {
    has truth is Atomic<bool>;
    has number is Atomic<int>;
    has real_number is Atomic<float>;
    has words is Atomic<string>;
    has octets is Atomic<@byte>;
    has moments is Atomic<@Instant>;
    has element_values is Atomic<@PlistValue>;
    has member_values is Atomic<@PlistMember>;

    PlistCapture() {
        truth = Atomic(false);
        number = Atomic(0);
        real_number = Atomic(0.0);
        words = Atomic("");
        let no_bytes is @byte = [];
        octets = Atomic(no_bytes);
        let no_moments is @Instant = [];
        moments = Atomic(no_moments);
        let no_elements is @PlistValue = [];
        element_values = Atomic(no_elements);
        let no_members is @PlistMember = [];
        member_values = Atomic(no_members);
    }

    boolean(value is bool) is void {
        truth.replace(value);
    }

    integer(value is BigInt) is void {
        number.replace(value.int());
    }

    real(value is float) is void {
        real_number.replace(value);
    }

    text(value is string) is void {
        words.replace(value);
    }

    data(value is @byte) is void {
        octets.replace(value);
    }

    date(value is Instant) is void {
        moments.replace([value]);
    }

    elements(values is Sequencing<PlistValue>) is void {
        let listed is @PlistValue = (0..values.size()).map() -> index {
            values.item(index);
        };
        element_values.replace(listed);
    }

    members(values is Sequencing<PlistMember>) is void {
        let listed is @PlistMember = (0..values.size()).map() -> index {
            values.item(index);
        };
        member_values.replace(listed);
    }

    uid(value is BigInt) is void {}

    bool() is bool {
        truth.value();
    }

    int() is int {
        number.value();
    }

    float() is float {
        real_number.value();
    }

    string() is string {
        words.value();
    }

    bytes() is @byte {
        octets.value();
    }

    instant() is Instant {
        moments.value()[0];
    }

    item_list() is @PlistValue {
        element_values.value();
    }

    member_list() is @PlistMember {
        member_values.value();
    }
}

// Internal preconstruction snapshots shared by constructor overloads. Imported
// only as implementation collaborators; Okkama has no module-private objects.
hidden object PlistArraySnapshot {
    has origin is @PlistValue;

    PlistArraySnapshot(source is Sequencing<PlistValue>, maximum is int) {
        confirm maximum >= 0 else throw InvalidPlistContainerLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidPlistContainerSize.invalid;
        confirm size <= maximum else throw PlistContainerLimitExceeded.exceeded;
        let values is @PlistValue = (0..size).map() -> index {
            let value is PlistValue = source.item(index);
            value;
        };
        origin = values;
    }

    items() is @PlistValue {
        origin;
    }
}

hidden object PlistDictionarySnapshot {
    has origin is @PlistMember;
    has positioned is %string:int;

    PlistDictionarySnapshot(source is Sequencing<PlistMember>, maximum is int) {
        confirm maximum >= 0 else throw InvalidPlistContainerLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidPlistContainerSize.invalid;
        confirm size <= maximum else throw PlistContainerLimitExceeded.exceeded;
        let values is @PlistMember = (0..size).map() -> index {
            source.item(index);
        };
        let empty is %string:int = [:];
        positioned = (0..size).reduce(empty) -> kept, index {
            let name = values[index].name();
            confirm !kept.has(name) else throw DuplicatePlistMember.name(name);
            kept + [name: index];
        };
        origin = values;
    }

    items() is @PlistMember {
        origin;
    }

    // The member positions by name.
    positions() is %string:int {
        positioned;
    }
}

enum InvalidPlistUid is Error = (invalid);

enum MissingPlistMember is Error = (name(name is string));

enum DuplicatePlistMember is Error = (name(name is string));

enum InvalidPlistContainerLimit is Error = (invalid);

enum InvalidPlistContainerSize is Error = (invalid);

enum PlistContainerLimitExceeded is Error = (exceeded);

test "plist scalar payloads keep their own nominal kinds" {
    test.ok(PlistBoolean(true).bool());
    test.ok(PlistString("text").kind() == PlistKind.string_value);
    test.is(PlistString(" text ").string(), " text ");
    test.is(PlistData([byte(0), byte(255)]).bytes().size(), 2);
    test.is(PlistReal(1.25).float(), 1.25);
}

test "plist containers preserve order and exact member names" {
    let value = PlistDictionary(
        PlistMember(name: "z", value: PlistBoolean(true)),
        PlistMember(name: "", value: PlistString("last"))
    );
    test.is(value.members().item(0).name(), "z");
    test.is(value.members().item(1).name(), "");
    test.ok(value.membership(""));
    test.ok(!value.membership("Z"));
    test.ok(PlistArray(value).values().item(0).kind() == PlistKind.dictionary_value);
}

test "plist missing duplicate and cardinality failures are typed" {
    test.is(
        try {
            PlistDictionary().value("lost");
            "bad";
        }
        catch MissingPlistMember.name(name) {
            name;
        },
        "lost"
    );
    test.is(
        try {
            PlistDictionary(
                PlistMember(name: "x", value: PlistString("")),
                PlistMember(name: "x", value: PlistString(""))
            );
            "bad";
        }
        catch DuplicatePlistMember.name(name) {
            name;
        },
        "x"
    );
    test.is(PlistArray(values: [], maximum_items: 0).values().size(), 0);
    test.throws(InvalidPlistContainerLimit) {
        PlistArray(values: [], maximum_items: -1);
    };
    test.ok(try {
        PlistDictionary(members: [PlistMember("x", PlistBoolean(true))], maximum_items: 0);
        false;
    }
    catch error is PlistContainerLimitExceeded {
        true;
    });
}
