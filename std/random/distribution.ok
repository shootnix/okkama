module random/distribution v1.0.0;

import "random/source" take Randomizing, PcgRandom;
import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "collections/combining" take UnequalSizes;
import "math/constants" take PI, TAU;
import "runtime/random_distribution" take distribution_uniform, distribution_log, distribution_exp,
    distribution_sqrt, distribution_cos, distribution_acos, distribution_power, distribution_angle;

// Stateful distribution views over an injected Randomizing capability.
// Calling sample() advances that source.
//
//     let dice = UniformIntegers(random: random, start: 1, stop: 7);
//     let roll is int = dice.sample();
//
//     let noise = NormalDistribution(
//         random: random,
//         mean: 0.0,
//         deviation: 1.0,
//     );
//     let value is float = noise.sample();
//
// Integer and float uniforms are half-open. Samples chooses without
// replacement and rejects count outside 0..values.size(). Choices and weighted
// choices require non-empty values. Weights must be non-negative, have the same
// size as values, and contain at least one positive value.
// The current immutable linked-list removal used by Samples costs O(n*count);
// it can later be replaced by a persistent indexed collection without changing
// this public contract.
//
// Continuous algorithms are fixed for seeded reproducibility: Box-Muller for
// normal values, Marsaglia-Tsang for gamma, two independent gamma samples for
// beta, and Best-Fisher rejection for von Mises. Degenerate normal and
// log-normal distributions with zero deviation consume no random values.

// Values drawn from a distribution, one per sample().
role Distribution<T> {
    // The next value.
    sample() is T;
}

// Ints spread evenly from start up to, not including, stop.
object UniformIntegers does Distribution<int> {
    has random is Randomizing;
    has beginning is int;
    has ending is int;

    // Uniform ints in [start, stop) from random.
    UniformIntegers(random is Randomizing, start is int, stop is int) {
        confirm start < stop
            else throw InvalidDistribution.because(
                "uniform integer range must satisfy start < stop"
            );
        self.random = random;
        beginning = start;
        ending = stop;
    }

    // The next value.
    sample() is int {
        random.integer(beginning, ending);
    }
}

// Floats spread evenly from start up to stop.
object UniformFloats does Distribution<float> {
    has random is Randomizing;
    has beginning is float;
    has ending is float;

    // Uniform floats in [start, stop) from random.
    UniformFloats(random is Randomizing, start is float, stop is float) {
        confirm start < stop
            else throw InvalidDistribution.because("uniform float range must satisfy start < stop");
        self.random = random;
        beginning = start;
        ending = stop;
    }

    // The next value.
    sample() is float {
        distribution_uniform(beginning, ending, random.float());
    }
}

// The normal (Gaussian) distribution.
object NormalDistribution does Distribution<float> {
    has random is Randomizing;
    has center is float;
    has spread is float;

    // Mean and standard deviation; the deviation must be positive.
    NormalDistribution(
        random is Randomizing,
        mean is float,
        deviation is float,
    ) {
        confirm deviation >= 0.0
            else throw InvalidDistribution.because("normal deviation must be non-negative");
        self.random = random;
        center = mean;
        spread = deviation;
    }

    // The next value.
    sample() is float {
        if spread == 0.0 {
            center;
        }
        else {
            center + spread * (StandardNormal(random: random).sample());
        }
    }
}

hidden object StandardNormal {
    has random is Randomizing;

    StandardNormal(random is Randomizing) {
        self.random = random;
    }

    sample() is float {
        let radius is float = distribution_sqrt(
            -2.0 * distribution_log(1.0 - random.float())
        );
        let angle is float = TAU * random.float();
        radius * distribution_cos(angle);
    }
}

// The exponential distribution.
object ExponentialDistribution does Distribution<float> {
    has random is Randomizing;
    has rate is float;

    // rate, the inverse of the mean; it must be positive.
    ExponentialDistribution(random is Randomizing, rate is float) {
        confirm rate > 0.0
            else throw InvalidDistribution.because("exponential rate must be positive");
        self.random = random;
        self.rate = rate;
    }

    // The next value.
    sample() is float {
        -distribution_log(1.0 - random.float()) / rate;
    }
}

// The gamma distribution.
object GammaDistribution does Distribution<float> {
    has random is Randomizing;
    has shape is float;
    has scale is float;

    // Positive shape and scale.
    GammaDistribution(
        random is Randomizing,
        shape is float,
        scale is float,
    ) {
        confirm shape > 0.0
            else throw InvalidDistribution.because("gamma shape must be positive");
        confirm scale > 0.0
            else throw InvalidDistribution.because("gamma scale must be positive");
        self.random = random;
        self.shape = shape;
        self.scale = scale;
    }

    // The next value.
    sample() is float {
        scale * (GammaUnit(random: random, shape: shape).sample());
    }
}

hidden object GammaUnit {
    has random is Randomizing;
    has shape is float;

    GammaUnit(random is Randomizing, shape is float) {
        self.random = random;
        self.shape = shape;
    }

    sample() is float {
        if shape < 1.0 {
            let boosted is float = GammaUnit(
                random: random,
                shape: shape + 1.0,
            ).sample();
            boosted * distribution_power(random.float(), 1.0 / shape);
        }
        else {
            GammaCandidate(random: random, shape: shape).sample();
        }
    }
}

hidden object GammaCandidate {
    has random is Randomizing;
    has shape is float;

    GammaCandidate(random is Randomizing, shape is float) {
        self.random = random;
        self.shape = shape;
    }

    sample() is float {
        let adjusted is float = shape - 0.3333333333333333;
        let factor is float = 1.0 / distribution_sqrt(9.0 * adjusted);
        let normal is float = StandardNormal(random: random).sample();
        let base is float = 1.0 + factor * normal;
        if base <= 0.0 {
            self.sample();
        }
        else {
            let cube is float = base * base * base;
            let uniform is float = random.float();
            let square is float = normal * normal;
            if uniform == 0.0
                || uniform < 1.0 - 0.0331 * square * square
                || distribution_log(uniform) <
                0.5 * square +
                adjusted * (1.0 - cube + distribution_log(cube)) {
                    adjusted * cube;
                }
                else {
                    self.sample();
                }
        }
    }
}

// The beta distribution, values in 0 to 1.
object BetaDistribution does Distribution<float> {
    has random is Randomizing;
    has alpha is float;
    has beta is float;

    // Positive alpha and beta.
    BetaDistribution(
        random is Randomizing,
        alpha is float,
        beta is float,
    ) {
        confirm alpha > 0.0
            else throw InvalidDistribution.because("beta alpha must be positive");
        confirm beta > 0.0
            else throw InvalidDistribution.because("beta beta must be positive");
        self.random = random;
        self.alpha = alpha;
        self.beta = beta;
    }

    // The next value.
    sample() is float {
        BetaSample(random: random, alpha: alpha, beta: beta).sample();
    }
}

hidden object BetaSample {
    has random is Randomizing;
    has alpha is float;
    has beta is float;

    BetaSample(random is Randomizing, alpha is float, beta is float) {
        self.random = random;
        self.alpha = alpha;
        self.beta = beta;
    }

    sample() is float {
        let left is float = GammaUnit(random: random, shape: alpha).sample();
        let right is float = GammaUnit(random: random, shape: beta).sample();
        if left == 0.0 && right == 0.0 {
            self.sample();
        }
        else {
            if left == 0.0 {
                0.0;
            }
            else {
                if right == 0.0 {
                    1.0;
                }
                else {
                    if left > right {
                        1.0 / (1.0 + right / left);
                    }
                    else {
                        let ratio is float = left / right;
                        ratio / (1.0 + ratio);
                    }
                }
            }
        }
    }
}

// Values whose logarithm is normal.
object LogNormalDistribution does Distribution<float> {
    has random is Randomizing;
    has center is float;
    has spread is float;

    // mean and deviation of the logarithm.
    LogNormalDistribution(
        random is Randomizing,
        mean is float,
        deviation is float,
    ) {
        confirm deviation >= 0.0
            else throw InvalidDistribution.because("log-normal deviation must be non-negative");
        self.random = random;
        center = mean;
        spread = deviation;
    }

    // The next value.
    sample() is float {
        if spread == 0.0 {
            distribution_exp(center);
        }
        else {
            distribution_exp(
                center + spread * (StandardNormal(random: random).sample())
            );
        }
    }
}

// The von Mises distribution of angles, in radians.
object VonMisesDistribution does Distribution<float> {
    has random is Randomizing;
    has center is float;
    has concentration is float;

    // The mean angle and a concentration of zero or more.
    VonMisesDistribution(
        random is Randomizing,
        mean is float,
        concentration is float,
    ) {
        confirm concentration >= 0.0
            else throw InvalidDistribution.because("von Mises concentration must be non-negative");
        self.random = random;
        center = mean;
        self.concentration = concentration;
    }

    // The next value.
    sample() is float {
        if concentration <= 0.000001 {
            distribution_angle(center + TAU * random.float());
        }
        else {
            VonMisesSample(
                random: random,
                mean: center,
                concentration: concentration,
            ).sample();
        }
    }
}

hidden object VonMisesSample {
    has random is Randomizing;
    has center is float;
    has concentration is float;

    VonMisesSample(
        random is Randomizing,
        mean is float,
        concentration is float,
    ) {
        self.random = random;
        center = mean;
        self.concentration = concentration;
    }

    sample() is float {
        let scaling is float = 0.5 / concentration;
        let ratio is float = scaling +
            distribution_sqrt(1.0 + scaling * scaling);
        VonMisesCandidate(
            random: random,
            mean: center,
            ratio: ratio,
        ).sample();
    }
}

hidden object VonMisesCandidate {
    has random is Randomizing;
    has center is float;
    has ratio is float;

    VonMisesCandidate(
        random is Randomizing,
        mean is float,
        ratio is float,
    ) {
        self.random = random;
        center = mean;
        self.ratio = ratio;
    }

    sample() is float {
        let cosine is float = distribution_cos(
            PI * random.float()
        );
        let delta is float = cosine / (ratio + cosine);
        let uniform is float = random.float();
        if uniform < 1.0 - delta * delta
            || uniform <= (1.0 - delta) * distribution_exp(delta) {
                let reciprocal is float = 1.0 / ratio;
                let projected is float = (reciprocal + cosine) /
                    (1.0 + reciprocal * cosine);
                let bounded is float = if projected < -1.0 {
                    -1.0;
                }
                else {
                    if projected > 1.0 {
                        1.0;
                    }
                    else {
                        projected;
                    }
                };
                let angle is float = distribution_acos(bounded);
                if random.float() > 0.5 {
                    distribution_angle(center + angle);
                }
                else {
                    distribution_angle(center - angle);
                }
            }
            else {
                self.sample();
            }
    }
}

// The Pareto distribution.
object ParetoDistribution does Distribution<float> {
    has random is Randomizing;
    has shape is float;
    has scale is float;

    // Positive shape and scale.
    ParetoDistribution(
        random is Randomizing,
        shape is float,
        scale is float,
    ) {
        confirm shape > 0.0
            else throw InvalidDistribution.because("Pareto shape must be positive");
        confirm scale > 0.0
            else throw InvalidDistribution.because("Pareto scale must be positive");
        self.random = random;
        self.shape = shape;
        self.scale = scale;
    }

    // The next value.
    sample() is float {
        scale / distribution_power(1.0 - random.float(), 1.0 / shape);
    }
}

// The Weibull distribution.
object WeibullDistribution does Distribution<float> {
    has random is Randomizing;
    has shape is float;
    has scale is float;

    // Positive shape and scale.
    WeibullDistribution(
        random is Randomizing,
        shape is float,
        scale is float,
    ) {
        confirm shape > 0.0
            else throw InvalidDistribution.because("Weibull shape must be positive");
        confirm scale > 0.0
            else throw InvalidDistribution.because("Weibull scale must be positive");
        self.random = random;
        self.shape = shape;
        self.scale = scale;
    }

    // The next value.
    sample() is float {
        scale * distribution_power(
            -distribution_log(1.0 - random.float()),
            1.0 / shape,
        );
    }
}

// One of the values, each as likely as the others.
object Choices<T> does Distribution<T> {
    has random is Randomizing;
    has origin is Sequencing<T>;

    // Picks from values, which must not be empty.
    Choices(random is Randomizing, values is Sequencing<T>) {
        confirm values.size() > 0
            else throw InvalidDistribution.because("choices require non-empty values");
        self.random = random;
        origin = values;
    }

    // The next value.
    sample() is T {
        origin.item(random.integer(0, origin.size()));
    }
}

// One of the values, as likely as its weight.
object WeightedChoices<T> does Distribution<T> {
    has random is Randomizing;
    has origin is Sequencing<T>;
    has weights is Sequencing<float>;
    has scaling is float;
    has total is float;

    // Picks from values with weights of the same length, none negative and not
    // all zero.
    WeightedChoices(
        random is Randomizing,
        values is Sequencing<T>,
        weights is Sequencing<float>,
    ) {
        confirm values.size() == weights.size() else throw UnequalSizes.unequal;
        confirm values.size() > 0
            else throw InvalidDistribution.because("weighted choices require non-empty values");
        let valid is bool = (0..weights.size()).reduce(true) -> valid, index {
            valid && weights.item(index) >= 0.0;
        };
        confirm valid
            else throw InvalidDistribution.because("weights must be non-negative");
        let maximum is float = (0..weights.size()).reduce(0.0) -> largest, index {
            if weights.item(index) > largest {
                weights.item(index);
            }
            else {
                largest;
            }
        };
        confirm maximum > 0.0
            else throw InvalidDistribution.because("weighted choices require a positive weight");
        self.random = random;
        origin = values;
        self.weights = weights;
        scaling = maximum;
        let normalized is float = (0..weights.size()).reduce(0.0) -> sum, index {
            sum + weights.item(index) / maximum;
        };
        total = normalized;
    }

    // The next value.
    sample() is T {
        WeightedSelection(
            values: origin,
            weights: weights,
            scaling: scaling,
            target: distribution_uniform(0.0, total, random.float()),
            position: 0,
            cumulative: 0.0,
        ).sample();
    }
}

hidden object WeightedSelection<T> {
    has values is Sequencing<T>;
    has weights is Sequencing<float>;
    has scaling is float;
    has target is float;
    has position is int;
    has cumulative is float;

    WeightedSelection(
        values is Sequencing<T>,
        weights is Sequencing<float>,
        scaling is float,
        target is float,
        position is int,
        cumulative is float,
    ) {
        self.values = values;
        self.weights = weights;
        self.scaling = scaling;
        self.target = target;
        self.position = position;
        self.cumulative = cumulative;
    }

    sample() is T {
        let following is float = cumulative +
            weights.item(position) / scaling;
        if target < following || position == values.size() - 1 {
            values.item(position);
        }
        else {
            WeightedSelection(
                values: values,
                weights: weights,
                scaling: scaling,
                target: target,
                position: position + 1,
                cumulative: following,
            ).sample();
        }
    }
}

// count different values picked without repeats.
object Samples<T> does Distribution<@T> {
    has random is Randomizing;
    has origin is Sequencing<T>;
    has amount is int;

    // count values of values, at most its size.
    Samples(
        random is Randomizing,
        values is Sequencing<T>,
        count is int,
    ) {
        confirm count >= 0 && count <= values.size()
            else throw InvalidDistribution.because(
                "sample count must be between zero and the values size"
            );
        self.random = random;
        origin = values;
        amount = count;
    }

    // The next value.
    sample() is @T {
        let empty is @T = [];
        if amount == 0 {
            empty;
        }
        else {
            let no_positions is List<int> = EmptyList();
            let positions is List<int> = (0..origin.size()).reduce(no_positions) -> items, index {
                items.prefix(index);
            };
            let no_selected is List<int> = EmptyList();
            let reversed is List<int> = IndexSamples(
                random: random,
                positions: positions,
                count: amount,
                selected: no_selected,
            ).sample();
            let ordered is List<int> = reversed.reduce(EmptyList()) -> items, index {
                items.prefix(index);
            };
            ordered.map() -> index {
                origin.item(index);
            };
        }
    }
}

hidden object IndexSamples {
    has random is Randomizing;
    has positions is List<int>;
    has amount is int;
    has selected is List<int>;

    IndexSamples(
        random is Randomizing,
        positions is List<int>,
        count is int,
        selected is List<int>,
    ) {
        self.random = random;
        self.positions = positions;
        amount = count;
        self.selected = selected;
    }

    sample() is List<int> {
        if amount == 0 {
            selected;
        }
        else {
            let removal is ListRemoval<int> = ListRemoval(
                origin: positions,
                index: random.integer(0, positions.size()),
            );
            IndexSamples(
                random: random,
                positions: removal.remainder(),
                count: amount - 1,
                selected: selected.prefix(removal.item()),
            ).sample();
        }
    }
}

// A list with one item taken out, for sampling.
object ListRemoval<T> {
    has origin is List<T>;
    has index is int;

    // origin without the item at index.
    ListRemoval(origin is List<T>, index is int) {
        self.origin = origin;
        self.index = index;
    }

    // The item taken out.
    item() is T {
        if index == 0 {
            origin.first();
        }
        else {
            ListRemoval(origin: origin.tail(), index: index - 1).item();
        }
    }

    // The list without it.
    remainder() is List<T> {
        if index == 0 {
            origin.tail();
        }
        else {
            ListRemoval(origin: origin.tail(), index: index - 1)
                .remainder()
                .prefix(origin.first());
        }
    }
}

// The values in a random order: a shuffle.
object PermutationSamples<T> does Distribution<@T> {
    has random is Randomizing;
    has origin is Sequencing<T>;

    // Shuffles values.
    PermutationSamples(random is Randomizing, values is Sequencing<T>) {
        self.random = random;
        origin = values;
    }

    // The next value.
    sample() is @T {
        Samples(random: random, values: origin, count: origin.size()).sample();
    }
}

// A parameter the distribution does not take; message says which.
enum InvalidDistribution is Error = (because(message is string));

test "seeded samples keep each distribution's shape" {
    let random = PcgRandom(seed: 42);
    let normal = NormalDistribution(random: random, mean: 10.0, deviation: 2.0);
    let total = (0..2000).reduce(0.0) -> sum, n {
        sum + normal.sample();
    };
    test.ok(total / 2000.0 > 9.8 && total / 2000.0 < 10.2);
    let gamma = GammaDistribution(random: random, shape: 0.5, scale: 2.0);
    let beta = BetaDistribution(random: random, alpha: 2.0, beta: 5.0);
    let circle = VonMisesDistribution(random: random, mean: 0.0, concentration: 4.0);
    for (0..500) -> n {
        test.ok(gamma.sample() > 0.0);
        let b = beta.sample();
        test.ok(b >= 0.0 && b <= 1.0);
        let angle = circle.sample();
        test.ok(angle >= 0.0 && angle < TAU);
    }
}

test "choices honour weights and samples are distinct" {
    let random = PcgRandom(seed: 7);
    let weighted = WeightedChoices(random: random, values: ["never", "always"], weights: [0.0, 1.0]);
    for (0..200) -> n {
        test.is(weighted.sample(), "always");
    }
    let picked = Samples(random: random, values: [1, 2, 3, 4, 5, 6], count: 4).sample();
    test.is(picked.size(), 4);
    let distinct = picked.reduce(0) -> count, item {
        count + picked.filter() -> other {
            other == item;
        }.size();
    };
    test.is(distinct, 4);
}
