module random/source v1.0.0;

import "runtime/random" take PcgState, pcg_state, pcg_integer, pcg_float, pcg_bytes,
    random_sample_accepted, random_integer_from_sample, random_float_from_sample;
import "runtime/system" take secure_random;

// Stateful random sources with one compact capability.
//
//     let repeatable is Randomizing = PcgRandom(seed: 42);
//     let index is int = repeatable.integer(0, 10); // 0 through 9
//     let fraction is float = repeatable.float();   // 0.0 <= x < 1.0
//     let token is @byte = repeatable.bytes(16);
//
//     let secure is Randomizing = SecureRandom();
//     let nonce is @byte = secure.bytes(24);
//
// PcgRandom is PCG-XSH-RR 64/32 (pcg32), with multiplier
// 6364136223846793005 and fixed stream increment 1442695040888963407.
// Construction performs the standard zero-state advance, adds the signed seed
// modulo 2^64, then advances again. Each integer consumes pairs of 32-bit
// outputs until rejection sampling accepts one. float consumes two outputs and
// forms 53 random bits. bytes emits each 32-bit output little-endian; an
// incomplete final word discards its unused bytes. This sequence is part of the
// public reproducibility contract.
//
// PcgRandom owns an opaque mutable stream. Copies of the object share that
// stream, just as copies of a reading capability share their underlying input.
// It is reproducible, not cryptographically secure. SecureRandom has no seed
// constructor and reads fresh operating-system entropy for every operation.
// Integer ranges are always non-empty and half-open [start, stop). Random byte
// requests are capped at 16 MiB per call.

role Randomizing {
    integer(start is int, stop is int) is int;
    float() is float;
    bytes(size is int) is @byte;
}

object PcgRandom does Randomizing {
    has state is PcgState;

    PcgRandom(seed is int) {
        state = pcg_state(seed);
    }

    integer(start is int, stop is int) is int {
        confirm start < stop else throw InvalidRandomRange.detailed(start, stop);
        pcg_integer(state, start, stop);
    }

    float() is float {
        pcg_float(state);
    }

    bytes(size is int) is @byte {
        confirm size >= 0 && size <= 16777216
            else throw InvalidRandomSize.detailed(size, 16777216);
        pcg_bytes(state, size);
    }
}

object SecureRandom does Randomizing {
    SecureRandom();

    integer(start is int, stop is int) is int {
        confirm start < stop else throw InvalidRandomRange.detailed(start, stop);
        self.draw(start, stop);
    }

    float() is float {
        random_float_from_sample(SecureBytes(size: 7).bytes());
    }

    bytes(size is int) is @byte {
        confirm size >= 0 && size <= 16777216
            else throw InvalidRandomSize.detailed(size, 16777216);
        SecureBytes(size: size).bytes();
    }

    // An unbiased integer in start..stop: a sample outside the accepted
    // range is drawn again.
    hidden draw(start is int, stop is int) is int {
        let sample is @byte = SecureBytes(size: 8).bytes();
        if random_sample_accepted(sample, start, stop) {
            random_integer_from_sample(sample, start, stop);
        }
        else {
            self.draw(start, stop);
        }
    }
}

object SecureBytes {
    has amount is int;

    SecureBytes(size is int) {
        amount = size;
    }

    bytes() is @byte {
        if amount == 0 {
            [];
        }
        else {
            try {
                let result is @byte = secure_random(amount);
                confirm result.size() == amount
                    else throw UnavailableRandom.unavailable;
                result;
            }
            catch failure is NativeFailure {
                throw UnavailableRandom.unavailable;
            }
        }
    }
}

enum InvalidRandomRange is Error = (detailed(start is int, stop is int));

enum InvalidRandomSize is Error = (detailed(requested is int, maximum is int));

enum UnavailableRandom is Error = (unavailable);

test "a seeded source repeats the published PCG32 sequence" {
    // The first two pcg32 outputs for seed 42, little-endian; checked
    // against an independent implementation of the stated algorithm.
    test.is(PcgRandom(42).bytes(8), [byte(214), byte(123), byte(245), byte(194), byte(169), byte(196), byte(7), byte(107)]);
    let random = PcgRandom(42);
    test.is(random.integer(0, 100), 5);
    test.is(random.integer(0, 100), 15);
    test.is(random.integer(-5, 5), 3);
    test.is(random.float(), 0.7960081833279878);
    // Copies share one stream: a draw through either advances both.
    let shared = PcgRandom(9);
    let copy = shared;
    let first = shared.integer(0, 1000000);
    let second = copy.integer(0, 1000000);
    let fresh = PcgRandom(9);
    test.is(fresh.integer(0, 1000000), first);
    test.is(fresh.integer(0, 1000000), second);
    test.is(PcgRandom(7).bytes(3), PcgRandom(7).bytes(3));
    test.is(PcgRandom(7).bytes(0).size(), 0);
}

test "ranges are half-open and never empty" {
    let random is Randomizing = PcgRandom(1);
    for (0..200) -> index {
        let roll = random.integer(1, 7);
        test.ok(roll >= 1 && roll < 7);
        let fraction = random.float();
        test.ok(fraction >= 0.0 && fraction < 1.0);
    }
    test.is(random.integer(3, 4), 3);
    test.is(
        try {
            random.integer(4, 4);
        }
        catch InvalidRandomRange.detailed(start, stop) {
            start * 10 + stop;
        },
        44
    );
    test.is(
        try {
            random.bytes(-1).size();
        }
        catch InvalidRandomSize.detailed(requested, maximum) {
            requested;
        },
        -1
    );
}

test "secure source answers within the same contract" {
    let secure is Randomizing = SecureRandom();
    test.is(secure.bytes(24).size(), 24);
    for (0..50) -> index {
        let roll = secure.integer(-3, 3);
        test.ok(roll >= -3 && roll < 3);
        let fraction = secure.float();
        test.ok(fraction >= 0.0 && fraction < 1.0);
    }
    test.is(SecureBytes(size: 5).bytes().size(), 5);
}
