module numbers/bigint v1.0.0;

import "compare" take Comparing, Order;
import "operators" take Adding, Subtracting, Multiplying, Dividing, Remaindering, Negating;
import "runtime/bigint" take bigint_valid, bigint_canonical, bigint_sign, bigint_bits, bigint_order,
    bigint_difference, bigint_sum, bigint_product, bigint_quotient, bigint_remainder, bigint_gcd,
    bigint_lcm, bigint_power;

// Immutable arbitrary-precision integer foundation.
//
//     let count = BigInt(origin: "18446744073709551616");
//     count.sign();                  // 1
//     count.bits();                  // 65
//     count.string();                // canonical decimal
//
// Construction accepts an optional minus followed by decimal digits. It never
// trims whitespace or accepts `+`; leading zeroes are normalized.
//
// Arithmetic is the operators (#215): `a + b`, `a - b`, `a * b`, `a / b`,
// `a % b`, `-a`, and `<`, `<=`, `>`, `>=`. Division truncates toward zero
// (unlike int, whose `/` gives a rat); the remainder has the dividend's sign;
// both throw BigDivisionByZero. gcd/lcm are non-negative; gcd(0,0)=0 and
// lcm(0,n)=0.
//
//     let quotient = count / BigInt("3");
//     BigInt("2").power(100, 101);
//
// power() requires exponent >= 0 and a positive result bit budget (1048576
// by default). 0^0 is 1. An oversized result throws BigPowerLimitExceeded;
// impossible budgets are rejected before heavy exponentiation. This bounds
// result bits, not all backend memory or wall-clock time.
object BigInt does Comparing<BigInt>, Adding<BigInt, BigInt>, Subtracting<BigInt, BigInt>, Multiplying<BigInt, BigInt>, Dividing<BigInt, BigInt>, Remaindering<BigInt, BigInt>, Negating<BigInt> {
    has origin is string;

    BigInt(origin is string) {
        confirm bigint_valid(origin) else throw InvalidBigInt.invalid;
        self.origin = bigint_canonical(origin);
    }

    sign() is int {
        bigint_sign(origin);
    }

    bits() is int {
        bigint_bits(origin);
    }

    order(other is BigInt) is Order {
        let result is int = bigint_order(origin, other.string());
        if result < 0 {
            Order.less;
        }
        else {
            if result > 0 {
                Order.greater;
            }
            else {
                Order.equal;
            }
        }
    }

    string() is string {
        origin;
    }

    // The canonical decimal digits, already checked by the constructor.
    cap Digits {
        text is string {
            origin;
        }
    }

    // a + b
    plus(other is BigInt) is BigInt {
        BigInt(bigint_sum(origin, other.string()));
    }

    // a - b
    minus(other is BigInt) is BigInt {
        BigInt(bigint_difference(origin, other.string()));
    }

    // a * b
    times(other is BigInt) is BigInt {
        BigInt(bigint_product(origin, other.string()));
    }

    // a / b: truncates toward zero, unlike int's `/`, which gives a rat.
    divided(other is BigInt) is BigInt {
        confirm other.sign() != 0 else throw BigDivisionByZero.by_zero;
        BigInt(bigint_quotient(origin, other.string()));
    }

    // a % b: the sign of the dividend.
    remainder(other is BigInt) is BigInt {
        confirm other.sign() != 0 else throw BigDivisionByZero.by_zero;
        BigInt(bigint_remainder(origin, other.string()));
    }

    // -a
    negated() is BigInt {
        BigInt(bigint_difference("0", origin));
    }

    // Non-negative; gcd(0, 0) = 0.
    gcd(other is BigInt) is BigInt {
        BigInt(bigint_gcd(origin, other.string()));
    }

    // Non-negative; lcm(0, n) = 0.
    lcm(other is BigInt) is BigInt {
        BigInt(bigint_lcm(origin, other.string()));
    }

    // self^exponent with at most 1048576 result bits.
    power(exponent is int) is BigInt {
        self.power(exponent, 1048576);
    }

    // self^exponent with at most maximum_bits result bits; 0^0 is 1.
    power(exponent is int, maximum_bits is int) is BigInt {
        confirm exponent >= 0 else throw InvalidBigExponent.exponent(exponent);
        confirm maximum_bits > 0 else throw InvalidBigPowerLimit.maximum_bits(maximum_bits);
        try {
            BigInt(bigint_power(origin, exponent, maximum_bits));
        }
        catch failure is NativeFailure {
            if failure.code() == "resource_exhausted" {
                throw BigPowerLimitExceeded.maximum_bits(maximum_bits);
            }
            else {
                throw failure;
            }
        }
    }
}

enum InvalidBigInt is Error = (invalid);

enum BigDivisionByZero is Error = (by_zero);

enum InvalidBigExponent is Error = (exponent(exponent is int));

enum InvalidBigPowerLimit is Error = (maximum_bits(maximum_bits is int));

enum BigPowerLimitExceeded is Error = (maximum_bits(maximum_bits is int));

test "arbitrary precision arithmetic" {
    let big = BigInt("18446744073709551616");
    test.is(big.sign(), 1);
    test.is(big.bits(), 65);
    test.is((big + BigInt("1")).string(), "18446744073709551617");
    test.is((big * big).string(), "340282366920938463463374607431768211456");
    test.is((big - big).sign(), 0);
    test.is((-big).string(), "-18446744073709551616");
    test.is(BigInt("0042").string(), "42");
    test.is(BigInt("-0").string(), "0");
    test.ok(BigInt("2") < big && big >= big);
}

test "division truncates toward zero and the remainder follows the dividend" {
    test.is((BigInt("-7") / BigInt("2")).string(), "-3");
    test.is((BigInt("-7") % BigInt("2")).string(), "-1");
    test.is((BigInt("7") % BigInt("-2")).string(), "1");
    test.is(
        try {
            (BigInt("1") / BigInt("0")).string();
        }
        catch error is BigDivisionByZero {
            "by zero";
        },
        "by zero"
    );
    test.is(BigInt("12").gcd(BigInt("-18")).string(), "6");
    test.is(BigInt("0").gcd(BigInt("0")).string(), "0");
    test.is(BigInt("4").lcm(BigInt("6")).string(), "12");
    test.is(BigInt("0").lcm(BigInt("6")).string(), "0");
}

test "power is bounded by a bit budget" {
    test.is(BigInt("2").power(100).string(), "1267650600228229401496703205376");
    test.is(BigInt("0").power(0).string(), "1");
    test.is(
        try {
            BigInt("2").power(100, 100).string();
        }
        catch BigPowerLimitExceeded.maximum_bits(bits) {
            "over " + bits.string();
        },
        "over 100"
    );
    test.is(
        try {
            BigInt("2").power(-1).string();
        }
        catch InvalidBigExponent.exponent(exponent) {
            "exponent " + exponent.string();
        },
        "exponent -1"
    );
    for ["", "+1", " 1", "1.0", "0x10", "-"] -> invalid {
        test.is(
            try {
                BigInt(invalid).string();
            }
            catch error is InvalidBigInt {
                "invalid";
            },
            "invalid"
        );
    }
}
