module numbers/bigrational v1.0.0;

import "compare" take Comparing, Order;
import "numbers/bigint" take BigInt;

// Canonical exact ratio: positive denominator, gcd=1, unique zero 0/1.
//
//     let third = BigRational(numerator: BigInt("1"), denominator: BigInt("3"));
//     third.plus(third).string();    // "2/3"
//     third.divided(third).string(); // "1/1"
object BigRational does Comparing<BigRational> {
    has upper, lower is BigInt;

    BigRational(numerator is BigInt, denominator is BigInt) {
        confirm denominator.sign() != 0 else throw ZeroBigRationalDenominator.zero;
        let common = numerator.gcd(denominator);
        let divisor = if denominator.sign() < 0 {
            (BigInt("0") - common);
        }
        else {
            common;
        };
        upper = (numerator / divisor);
        lower = (denominator / divisor);
    }

    numerator() is BigInt {
        upper;
    }

    denominator() is BigInt {
        lower;
    }

    order(other is BigRational) is Order {
        let left = (upper * other.denominator());
        let right = (other.numerator() * lower);
        left.order(right);
    }

    string() is string {
        upper.string() + "/" + lower.string();
    }

    plus(other is BigRational) is BigRational {
        BigRational(
            numerator: (upper * other.denominator() + other.numerator() * lower),
            denominator: (lower * other.denominator())
        );
    }

    minus(other is BigRational) is BigRational {
        BigRational(
            numerator: (upper * other.denominator() - other.numerator() * lower),
            denominator: (lower * other.denominator())
        );
    }

    times(other is BigRational) is BigRational {
        BigRational(
            numerator: (upper * other.numerator()),
            denominator: (lower * other.denominator())
        );
    }

    divided(other is BigRational) is BigRational {
        confirm other.numerator().sign() != 0 else throw BigRationalDivisionByZero.by_zero;
        BigRational(
            numerator: (upper * other.denominator()),
            denominator: (lower * other.numerator())
        );
    }
}

enum ZeroBigRationalDenominator is Error = (zero);

enum BigRationalDivisionByZero is Error = (by_zero);

test "rationals add, subtract, multiply and divide exactly" {
    let half = BigRational(numerator: BigInt("1"), denominator: BigInt("2"));
    let third = BigRational(numerator: BigInt("1"), denominator: BigInt("3"));
    test.is(half.plus(third).string(), "5/6");
    test.is(half.minus(third).string(), "1/6");
    test.is(third.minus(half).string(), "-1/6");
    test.is(half.times(third).string(), "1/6");
    test.is(half.divided(third).string(), "3/2");
    let zero = BigRational(numerator: BigInt("0"), denominator: BigInt("5"));
    test.ok(try {
        half.divided(zero);
        false;
    }
    catch e is BigRationalDivisionByZero {
        true;
    });
}
