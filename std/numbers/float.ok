module numbers/float v1.0.0;

import "encoding/binary" take FloatBytes, Binary, FloatWidth, Signedness;
import "encoding/utf" take ByteOrder;
import "runtime/format" take sprintf_values;
import "numbers/bigint" take BigInt;
import "numbers/bigrational" take BigRational;
import "math/decimal" take Decimal;
import "compare" take Order;

// A finite binary64 value's shortest significant decimal candidate is accepted
// only within its exact nearest-even rounding interval. No float comparison or
// Perl stringification decides that boundary. Zero's sign is a separate identity.
object ShortestFloat {
    has origin is float;

    ShortestFloat(origin is float) {
        self.origin = origin;
    }

    negative() is bool {
        self.binary()[0].int() >= 128;
    }

    // The IEEE 754 binary64 bytes, most significant first.
    hidden binary() is @byte {
        FloatBytes(value: origin, width: FloatWidth.bits64, order: ByteOrder.big).bytes();
    }

    // The magnitude's bits: the binary64 pattern without its sign.
    hidden bits() is int {
        let bytes = self.binary();
        let magnitude is @byte = (0..8).map() -> index {
            if index == 0 {
                (bytes[0].int() & 127).byte();
            }
            else {
                bytes[index];
            }
        };
        Binary(bytes: magnitude, order: ByteOrder.big).int(Signedness.unsigned);
    }

    decimal() is Decimal {
        let bits is int = self.bits();
        if bits == 0 {
            return Decimal("0");
        }
        let interval = Binary64RoundingInterval(bits);
        let lower = interval.lower();
        let upper = interval.upper();
        let inclusive = bits % 2 == 0;
        let arguments is @any = [origin];
        for (1..18) -> precision {
            let candidate = Decimal(sprintf_values("%." + precision.string() + "g", arguments));
            if FloatDecimalCandidate(candidate).inside(lower, upper, inclusive) {
                return candidate;
            }
        }
        throw InvalidFloatRepresentation.invalid;
    }
}

hidden object Binary64RoundingInterval {
    has coefficient, shift is int;
    has narrow is bool;

    Binary64RoundingInterval(bits is int) {
        confirm bits > 0 && bits < 9218868437227405312
            else throw InvalidFloatRepresentation.invalid;
        let exponent = (bits / 4503599627370496).int();
        let fraction = bits % 4503599627370496;
        coefficient = fraction + (if exponent == 0 {
            0;
        }
        else {
            4503599627370496;
        });
        shift = if exponent == 0 {
            -1074;
        }
        else {
            exponent - 1075;
        };
        // At a normal power of two, except the smallest normal, the preceding
        // binade has half the spacing. The maximum-finite upper boundary uses
        // the same exact formula; its odd significand excludes the overflow tie.
        narrow = fraction == 0 && exponent > 1;
    }

    lower() is BigRational {
        if narrow {
            self.ratio(4 * coefficient - 1, shift - 2);
        }
        else {
            self.ratio(2 * coefficient - 1, shift - 1);
        }
    }

    upper() is BigRational {
        self.ratio(2 * coefficient + 1, shift - 1);
    }

    // numerator · 2^power, exactly.
    hidden ratio(numerator is int, power is int) is BigRational {
        let whole = BigInt(numerator.string());
        if power >= 0 {
            BigRational(numerator: (whole * BigInt("2").power(power, 1100)), denominator: BigInt("1"));
        }
        else {
            BigRational(numerator: whole, denominator: BigInt("2").power(-power, 1100));
        }
    }
}

hidden object FloatDecimalCandidate {
    has numerator, denominator is BigInt;

    FloatDecimalCandidate(origin is Decimal) {
        let coefficient = origin.coefficient();
        let absolute = if coefficient.sign() < 0 {
            (BigInt("0") - coefficient);
        }
        else {
            coefficient;
        };
        let exponent = origin.exponent();
        confirm exponent >= -400 && exponent <= 400 else throw InvalidFloatRepresentation.invalid;
        if exponent >= 0 {
            let power = BigInt("10").power(exponent, 1400);
            numerator = (absolute * power);
            denominator = BigInt("1");
        }
        else {
            numerator = absolute;
            denominator = BigInt("10").power(-exponent, 1400);
        }
    }

    inside(lower is BigRational, upper is BigRational, inclusive is bool) is bool {
        let low = self.order(lower);
        let high = self.order(upper);
        (low == Order.greater || (inclusive && low == Order.equal))
            && (high == Order.less || (inclusive && high == Order.equal));
    }

    hidden order(other is BigRational) is Order {
        (numerator * other.denominator()).order((other.numerator() * denominator));
    }
}

enum InvalidFloatRepresentation is Error = (invalid);

test "binary64 tenth has a one-digit decimal representative" {
    test.is(ShortestFloat(0.1).decimal().string(), "1e-1");
}
