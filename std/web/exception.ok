module web/exception v1.0.0;
import "http/handler" take HandlingResult,HandlingKind,WebSocketHandling,WrongHandlingKind;
import "http/message" take Response;
import "http/status" take Status;
import "http/websocket_server" take WebSocketUpgrade;
import "json" take Json,JsonField;
import "encoding/utf" take Utf8Encoded;
import "web/internal/reply" take ReplyHeaders,ReplyResponse,InvalidReply;

// An HTTP failure. Endpoints and exception scopes throw Exception or return a
// Problem; the framework turns a thrown Exception into its Problem response.
// The body is RFC 9457 problem details with type about:blank:
//
//     throw Exception.status(404, "user 7 not found");
//     // {"type":"about:blank","title":"Not Found","status":404,"detail":"user 7 not found"}
//
//     Problem(401, "token expired").header("WWW-Authenticate", "Bearer");
//
// detail is sent to the client: never put internal diagnostics into it.
enum Exception is Error = (status(code is int, detail is string));

// The problem-details reply of an HTTP failure (4xx or 5xx).
object Problem does HandlingResult {
    has code is int;
    has message is string;
    has extra is ReplyHeaders;

    Problem(status is int, detail is string) {
        confirm status >= 400 && status <= 599 else throw InvalidReply.because("problem status must be 4xx or 5xx");
        code = status;
        message = detail;
        extra = ReplyHeaders();
    }

    header(name is string, value is string) is ^Problem { ^extra = extra.added(name, value); }
    status() is int { code; }
    detail() is string { message; }
    title() is string { let phrase = Status(code).phrase(); if phrase == "" { "HTTP " + code.string(); } else { phrase; } }

    kind() is HandlingKind { HandlingKind.response; }
    response() is Response {
        let problem = Json([
            JsonField("type", "about:blank"),
            JsonField("title", self.title()),
            JsonField("status", code),
            JsonField("detail", message)
        ]);
        ReplyResponse(code, "application/problem+json", Utf8Encoded(problem.string()).bytes(), extra).response();
    }
    websocket() is WebSocketUpgrade { throw WrongHandlingKind.mismatch; }
    application() is WebSocketHandling { throw WrongHandlingKind.mismatch; }
}

test "problems name status, title and detail" {
    test.is(Exception.status(404, "user 7 not found").text(), "Exception.status(404, \"user 7 not found\")");
    test.is(Problem(404, "user 7 not found").title(), "Not Found");
    test.is(Problem(599, "x").title(), "HTTP 599");
    test.ok(try { Problem(302, "x"); false; } catch failure is InvalidReply { true; });
}
