module web/exception v1.0.0;

// An HTTP failure. Endpoints and exception scopes throw Exception or answer a
// ProblemReply; the framework turns a thrown Exception into its ProblemReply.
// The body is RFC 9457 problem details with type about:blank:
//
//     throw Exception.status(404, "user 7 not found");
//     // {"type":"about:blank","title":"Not Found","status":404,"detail":"user 7 not found"}
//
//     ProblemReply(status: Status.unauthorized, detail: "token expired",
//         headers: Headers(Header(name: "WWW-Authenticate", value: "Bearer")))
//
// detail is sent to the client: never put internal diagnostics into it.

import "http/message" take Response, Responding;
import "http/status" take Status, StatusCode;
import "http/header" take Headers, Header;
import "json" take Json, JsonField;
import "encoding/utf" take Utf8Encoded;
import "web/internal/reply" take ReplyResponse, InvalidReply;

// An HTTP failure an endpoint throws: `throw Exception.status(404, "no such
// note")`.
enum Exception is Error = (status(code is int, detail is string));

// The problem-details reply of an HTTP failure (4xx or 5xx).
object ProblemReply does Responding {
    has code is Status;
    has message is string;
    has given is Headers;

    // An `application/problem+json` reply with status and detail (RFC 9457).
    ProblemReply(status is Status, detail is string, headers is Headers = Headers()) {
        let number = StatusCode(status).number();
        confirm number >= 400 && number <= 599
            else throw InvalidReply.because("problem status must be 4xx or 5xx");
        code = status;
        message = detail;
        given = headers;
    }

    // The status's reason phrase.
    title() is string {
        let phrase = StatusCode(code).phrase();
        if phrase == "" {
            "HTTP " + StatusCode(code).number().string();
        }
        else {
            phrase;
        }
    }

    // The response it makes.
    response() is Response {
        let problem = Json(
            JsonField("type", "about:blank"),
            JsonField("title", self.title()),
            JsonField("status", StatusCode(code).number()),
            JsonField("detail", message)
        );
        ReplyResponse(
            status: code,
            media: "application/problem+json",
            content: Utf8Encoded(problem.string()).bytes(),
            headers: given
        ).response();
    }

    // The status and detail.
    cap Problem {
        status is Status {
            code;
        }

        detail is string {
            message;
        }
    }
}

test "problems name status, title and detail" {
    test.is(
        Exception.status(404, "user 7 not found").text(),
        "Exception.status(404, \"user 7 not found\")"
    );
    test.is(ProblemReply(status: Status.not_found, detail: "user 7 not found").title(), "Not Found");
    test.is(ProblemReply(status: Status.other(599), detail: "x").title(), "HTTP 599");
    test.throws(InvalidReply) {
        ProblemReply(status: Status.found, detail: "x");
    };
    let refused = ProblemReply(
        status: Status.unauthorized,
        detail: "token expired",
        headers: Headers(Header(name: "WWW-Authenticate", value: "Bearer"))
    ).response();
    test.is(refused::Head::status, Status.unauthorized);
    test.is(refused::Head::headers.entries().size(), 3);
}
