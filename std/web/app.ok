module web/app v1.0.0;

import "http/server" take HttpServer;
import "http/server_policy" take ServerPolicy;
import "net/tcp" take TcpListening;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress, IpNetwork;
import "time/clock" take Timing, SystemClock;
import "web/routing" take WebRoutes, Get, Post, Scope;
import "web/request" take WebRequest;
import "http/method" take MethodName;
import "web/reply" take Text;
import "http/handler" take HandlingResult;
import "http/client" take HttpClient;
import "http/endpoint" take ListedNetworks;
import "http/body" take TextBody;
import "http/status" take Status;
import "net/dns" take FixedResolution;
import "async/scope" take FutureGroup;
import "time/duration" take Duration, DurationUnit;

// Binds a route table to a plaintext HTTP/1.1 listener.
//
//     await WebApplication(routes).listen("127.0.0.1", 8000);
//
// The address is an IP literal; no name resolution happens here. listen()
// serves until the server is closed. server() binds and returns the std
// HttpServer without serving, for callers that own the lifetime themselves:
// port 0 picks a free port, local_endpoint() reports it, and server.drain(limit:)
// drains it.

object WebApplication {
    has routes is WebRoutes;
    has policy is ServerPolicy;
    has clock is Timing;

    WebApplication(routes is WebRoutes) {
        self.routes = routes;
        policy = ServerPolicy();
        clock = SystemClock();
    }

    WebApplication(routes is WebRoutes, policy is ServerPolicy, clock is Timing) {
        self.routes = routes;
        self.policy = policy;
        self.clock = clock;
    }

    async server(address is string, port is int) is HttpServer {
        let listener = await TcpListening(port: port, address: IpAddress(address)).listener();
        HttpServer(listener: listener, handling: routes.table(), policy: policy, clock: clock);
    }

    async listen(address is string, port is int) is void {
        let server = await self.server(address, port);
        defer await server.settled();
        defer server.close();
        await server.serve();
    }
}

hidden object Greetings {
    Greetings();

    async hello(request is WebRequest) is HandlingResult {
        Text(status: 200, text: "Hello, " + request.path("name") + (request.query("mark") else "") + "!");
    }

    async echo(request is WebRequest) is HandlingResult {
        Text(status: 201, text: (await request.text(1024)).upper());
    }

    async missing(request is WebRequest) is HandlingResult {
        Text(status: 404, text: "no " + MethodName(request.method()).string() + " here");
    }
}

async test "a web application routes requests over loopback and drains" {
    let greetings = Greetings();
    let routes = WebRoutes(
        routings: [Scope(prefix: "/api", routings: [Get(path: "/hello/:name", endpoint: greetings.hello), Post(path: "/echo", endpoint: greetings.echo)])],
        fallback: greetings.missing,
    );
    let server = await WebApplication(routes).server("127.0.0.1", 0);
    let workers is FutureGroup<HttpServer> = FutureGroup();
    workers.start(server.serve());
    let base = "http://127.0.0.1:" + server.local_endpoint()::Parts::port.string();
    let client = HttpClient(
        resolver: FixedResolution([]),
        endpoints: ListedNetworks([IpNetwork(address: IpAddress("127.0.0.0"), prefix: 8)])
    );
    test.is(await (await client.get(base + "/api/hello/Ada?mark=%21")).text(), "Hello, Ada!!");
    let created = await client.post(url: base + "/api/echo", body: TextBody(text: "quiet"));
    test.is(created::Head::status, Status.created);
    test.is(await created.text(), "QUIET");
    let lost = await client.get(base + "/nowhere");
    test.is(lost::Head::status, Status.not_found);
    test.is(await lost.text(), "no GET here");
    client.close();
    await server.drain(limit: Duration(value: 5.rat(), unit: DurationUnit.second));
    await workers.wait();
}
