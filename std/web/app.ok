async test "a web application serves HTTPS with HTTP/2 and HTTP/1.1 by ALPN" {
    let greetings = Greetings();
    let routes = WebRoutes(Get(path: "/hello/:name", endpoint: greetings.hello));
    let identity = TlsIdentity(certificates: HTTPS_TEST_CERTIFICATE, key: HTTPS_TEST_KEY);
    let server = (await WebApplication(routes).server("127.0.0.1", 0, identity)).started();
    let base = "https://127.0.0.1:" + server::Local::port.string();
    let both is Set<HttpVersion> = OrderedSet([HttpVersion.http_1_1, HttpVersion.http_2]);
    let modern = HttpClient(
        trust: PemTrustStore(HTTPS_TEST_CA),
        endpoints: LoopbackEndpoints(),
        protocols: both
    );
    let page = await modern.get(base + "/hello/Ada");
    test.is(page::Head::version == HttpVersion.http_2, true);
    test.is(await page.text(), "Hello, Ada!");
    modern.close();
    let older = HttpClient(trust: PemTrustStore(HTTPS_TEST_CA), endpoints: LoopbackEndpoints());
    let plain = await older.get(base + "/hello/Bo");
    test.is(plain::Head::version == HttpVersion.http_1_1, true);
    test.is(await plain.text(), "Hello, Bo!");
    older.close();
    await server.drain(limit: Duration(seconds: 5));
    test.is(server.closed(), true);
}
