module web/reply v1.0.0;

import "http/status" take Status, StatusCode;
import "http/message" take Request, Response, Responding;
import "http/header" take Headers, Header, HeaderName;
import "json" take Json, JsonField;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "http/body" take BodyOpening, ByteBody;
import "http/sse" take ServerEvent, EventBody, EventStreamHeaders;
import "async/channel" take Channel, Receiving;
import "http/static" take StaticFiles, StaticPolicy;
import "fs/root" take FileRoot;
import "mime/types" take StandardMediaTypes;
import "web/request" take WebRequest;
import "http/target" take OriginTarget;
import "http/request_context" take HttpRequestContext;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "async/cancellation" take Cancellation;
import "fs/temp" take TemporaryDirectory;
import "fs/directory" take Directory;
import "fs/file" take File, FileMode;
import "fs/path" take Path;
import "web/internal/reply" take ReplyResponse, EmptyReplyResponse, OpenedReplyResponse,
    OpenedReplyFields, ReplyMediaType, BodyStatus, InvalidReply;

// Endpoint replies. Each one builds a std Response with the defaults of its
// kind and takes only what differs: status: and headers:. Content-Type and
// Content-Length belong to the reply; any other field comes in headers:
//
//     TextReply("ok")
//     TextReply(text: "no access", status: Status.forbidden)
//     JsonReply(value: user, headers: Headers(Header(name: "Cache-Control", value: "no-store")))
//     RedirectReply(location: "/notes", headers: Headers(SetCookie(name: "sid", value: token)))
//
// An endpoint that needs full control answers a Response itself: both are
// Responding.

// text/plain in UTF-8, 200 unless told.
object TextReply does Responding {
    has text is string;
    has code is Status;
    has given is Headers;

    // text as UTF-8 with status (200 unless told) and headers.
    TextReply(text is string, status is Status = Status.ok, headers is Headers = Headers()) {
        self.text = text;
        code = BodyStatus(status).status();
        given = headers;
    }

    // The response it makes.
    response() is Response {
        ReplyResponse(
            status: code,
            media: "text/plain; charset=utf-8",
            content: Utf8Encoded(text).bytes(),
            headers: given
        ).response();
    }
}

// text/html in UTF-8, 200 unless told.
object HtmlReply does Responding {
    has html is string;
    has code is Status;
    has given is Headers;

    // html as UTF-8 with status and headers.
    HtmlReply(html is string, status is Status = Status.ok, headers is Headers = Headers()) {
        self.html = html;
        code = BodyStatus(status).status();
        given = headers;
    }

    // The response it makes.
    response() is Response {
        ReplyResponse(
            status: code,
            media: "text/html; charset=utf-8",
            content: Utf8Encoded(html).bytes(),
            headers: given
        ).response();
    }
}

// application/json, 200 unless told.
object JsonReply does Responding {
    has value is Json;
    has code is Status;
    has given is Headers;

    // value as compact JSON with status and headers.
    JsonReply(value is Json, status is Status = Status.ok, headers is Headers = Headers()) {
        self.value = value;
        code = BodyStatus(status).status();
        given = headers;
    }

    // The response it makes.
    response() is Response {
        ReplyResponse(
            status: code,
            media: "application/json",
            content: Utf8Encoded(value.string()).bytes(),
            headers: given
        ).response();
    }
}

// 201 with a Location field and the created representation as JSON.
object CreatedReply does Responding {
    has location is string;
    has value is Json;
    has given is Headers;

    // 201 with location and value as JSON.
    CreatedReply(location is string, value is Json, headers is Headers = Headers()) {
        confirm location != ""
            else throw InvalidReply.because("a created reply requires a location");
        self.location = location;
        self.value = value;
        given = headers;
    }

    // The response it makes.
    response() is Response {
        let fields = given.addition(Header(name: "Location", value: location));
        ReplyResponse(
            status: Status.created,
            media: "application/json",
            content: Utf8Encoded(value.string()).bytes(),
            headers: fields
        ).response();
    }
}

// A redirect to location: 303 See Other unless told; 301, 302, 307 and 308
// are the others.
object RedirectReply does Responding {
    has location is string;
    has code is Status;
    has given is Headers;

    // To location with status, 303 See Other unless told.
    RedirectReply(
        location is string,
        status is Status = Status.see_other,
        headers is Headers = Headers()
    ) {
        let number = StatusCode(status).number();
        confirm number == 301 || number == 302 || number == 303 || number == 307 || number == 308
            else throw InvalidReply.because("redirect status must be 301, 302, 303, 307 or 308");
        confirm location != "" else throw InvalidReply.because("a redirect requires a location");
        self.location = location;
        code = status;
        given = headers;
    }

    // The response it makes.
    response() is Response {
        EmptyReplyResponse(
            status: code,
            headers: given.addition(Header(name: "Location", value: location))
        ).response();
    }
}

// 204: no representation and no framing field.
object NoContentReply does Responding {
    has given is Headers;

    // 204 with headers.
    NoContentReply(headers is Headers = Headers()) {
        given = headers;
    }

    // The response it makes.
    response() is Response {
        EmptyReplyResponse(status: Status.no_content, headers: given).response();
    }
}

// Bytes of a media type, 200 unless told: BytesReply(bytes: png, media_type: "image/png").
object BytesReply does Responding {
    has bytes is @byte;
    has media is string;
    has code is Status;
    has given is Headers;

    // bytes as media_type with status and headers.
    BytesReply(
        bytes is @byte,
        media_type is string,
        status is Status = Status.ok,
        headers is Headers = Headers()
    ) {
        self.bytes = bytes;
        media = ReplyMediaType(media_type).string();
        code = BodyStatus(status).status();
        given = headers;
    }

    // The response it makes.
    response() is Response {
        ReplyResponse(status: code, media: media, content: bytes, headers: given).response();
    }
}

// A body read while it is sent, such as a generated export:
// StreamReply(body: opening, media_type: "text/csv"). Content-Length is
// declared when the body knows its length; otherwise HTTP/1.1 sends the body
// in chunks.
object StreamReply does Responding {
    has body is BodyOpening;
    has media is string;
    has code is Status;
    has given is Headers;

    // body as media_type with status and headers.
    StreamReply(
        body is BodyOpening,
        media_type is string,
        status is Status = Status.ok,
        headers is Headers = Headers()
    ) {
        self.body = body;
        media = ReplyMediaType(media_type).string();
        code = BodyStatus(status).status();
        given = headers;
    }

    // The response it makes.
    response() is Response {
        OpenedReplyResponse(
            status: code,
            fixed: OpenedReplyFields(media: media, body: body).fields(),
            body: body,
            headers: given
        ).response();
    }
}

// Server-sent events from a channel, as text/event-stream (#82):
//
//     let events is Channel<ServerEvent> = Channel(capacity: 16);
//     spawn clock.ticks(events.sending());
//     EventsReply(events.receiving())
//
// The stream ends when the channel closes. The reply sends Cache-Control:
// no-cache and X-Accel-Buffering: no, so proxies pass each event on at once.
object EventsReply does Responding {
    has events is Receiving<ServerEvent>;
    has given is Headers;

    // Sends each event received from events until it closes.
    EventsReply(events is Receiving<ServerEvent>, headers is Headers = Headers()) {
        self.events = events;
        given = headers;
    }

    // The response it makes.
    response() is Response {
        let stream = EventStreamHeaders().headers().entries();
        let fixed is @Header = (0..stream.size()).map() -> index {
            stream.item(index);
        };
        OpenedReplyResponse(
            status: Status.ok,
            fixed: fixed,
            body: EventBody(events),
            headers: given
        ).response();
    }
}

// One file from an endpoint, with validators, ranges and the Content-Type of
// its name (#82):
//
//     FileReply(request: request, root: reports, path: "2026/q3.pdf")
//
// path is below root and "/"-separated. A missing file is 404, a path that
// would leave the root 400, and a conditional or range request is answered as
// http/static answers it.
object FileReply does Responding {
    has request is WebRequest;
    has root is FileRoot;
    has path is string;
    has given is Headers;

    // The file at path below root, for request.
    FileReply(
        request is WebRequest,
        root is FileRoot,
        path is string,
        headers is Headers = Headers()
    ) {
        self.request = request;
        self.root = root;
        self.path = path;
        given = headers;
    }

    // The response it makes.
    response() is Response {
        let files = StaticFiles(root: root, media: StandardMediaTypes(), policy: StaticPolicy());
        let answer = files.file_response(request.request(), path);
        let extra = given.entries();
        let fields = (0..extra.size()).reduce(answer::Head::headers) -> kept, index {
            let field = extra.item(index);
            let lowered = field.name().lowercase();
            confirm lowered != "content-type"
                && lowered != "content-length"
                && lowered != "transfer-encoding"
                else throw InvalidReply.because(
                    field.name().string() + " is owned by the reply itself"
                );
            kept.addition(field);
        };
        Response(
            status: answer::Head::status,
            headers: fields,
            body: answer.body(),
            version: answer::Head::version
        );
    }
}

test "a text reply declares its representation and keeps the given fields" {
    let response = TextReply(text: "Привет", headers: Headers(Header(name: "X-Trace", value: "t1"))).response();
    test.is(response::Head::status, Status.ok);
    test.is(response::Head::headers.entries().size(), 3);
    test.is(response::Head::headers.first(HeaderName("Content-Type")), "text/plain; charset=utf-8");
    test.is(response.body().length().string(), "12");
    test.is(TextReply("ok").response()::Head::headers.entries().size(), 2);
    test.is(
        TextReply(text: "no", status: Status.forbidden).response()::Head::status,
        Status.forbidden
    );
    test.is(NoContentReply().response()::Head::headers.entries().size(), 0);
    test.throws(InvalidReply) {
        TextReply(text: "x", status: Status.no_content);
    };
}

test "redirects and created replies carry their location" {
    let moved = RedirectReply("/notes").response();
    test.is(moved::Head::status, Status.see_other);
    test.is(moved::Head::headers.first(HeaderName("Location")), "/notes");
    test.is(moved::Head::headers.first(HeaderName("Content-Length")), "0");
    test.is(
        RedirectReply(location: "/x", status: Status.permanent_redirect).response()::Head::status,
        Status.permanent_redirect
    );
    test.throws(InvalidReply) {
        RedirectReply(location: "/x", status: Status.ok);
    };
    let created = CreatedReply(location: "/notes/7", value: Json(JsonField("id", 7))).response();
    test.is(created::Head::status, Status.created);
    test.is(created::Head::headers.first(HeaderName("Location")), "/notes/7");
    test.is(
        JsonReply(Json(JsonField("a", 1))).response()::Head::headers.first(
            HeaderName("Content-Type")
        ),
        "application/json"
    );
    test.is(
        HtmlReply("<p>hi</p>").response()::Head::headers.first(HeaderName("Content-Type")),
        "text/html; charset=utf-8"
    );
}

test "bytes and streams declare their media type" {
    let png is @byte = [137.byte(), 80.byte(), 78.byte(), 71.byte()];
    let bytes = BytesReply(bytes: png, media_type: "image/png").response();
    test.is(bytes::Head::headers.text("Content-Type"), "image/png");
    test.is(bytes::Head::headers.int("Content-Length"), 4);
    test.throws(InvalidReply) {
        BytesReply(bytes: png, media_type: "png");
    };
    let sized = StreamReply(body: ByteBody(png), media_type: "application/octet-stream").response();
    test.is(sized::Head::headers.int("Content-Length"), 4);
    let channel is Channel<ServerEvent> = Channel(capacity: 1);
    let open = StreamReply(body: EventBody(channel.receiving()), media_type: "text/plain").response();
    test.ok(!open::Head::headers.membership(HeaderName("Content-Length")));
    channel.receiving().close();
}

async test "an events reply streams its channel as text/event-stream" {
    let channel is Channel<ServerEvent> = Channel(capacity: 2);
    let sending = channel.sending();
    await sending.send(ServerEvent("hello"));
    sending.close();
    let response = EventsReply(channel.receiving()).response();
    test.is(response::Head::headers.text("Content-Type"), "text/event-stream; charset=utf-8");
    test.is(response::Head::headers.text("Cache-Control"), "no-cache");
    let input = response.body().reading();
    defer input.close();
    test.is(Utf8Decoded(await input.bytes(1024)).string(), "data: hello\n\n");
}

test "a file reply answers with the file and keeps the given fields" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "web-file-reply-");
    let base = scratch.path();
    let report = File(path: base.child("q3.txt"), mode: FileMode.writing);
    report.text().write("profit");
    report.close();
    let root = FileRoot(directory: Directory(path: base));
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
        local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
        remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: 50000)
    );
    let request = WebRequest(
        request: Request(target: OriginTarget(path: "/report", query: Maybe<string>.none)),
        context: HttpRequestContext(
            details: ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1),
            cancellation: Cancellation().cancelling()
        )
    );
    let answer = FileReply(
        request: request,
        root: root,
        path: "q3.txt",
        headers: Headers(Header(name: "Content-Disposition", value: "attachment"))
    ).response();
    test.is(answer::Head::status, Status.ok);
    test.is(answer::Head::headers.text("Content-Disposition"), "attachment");
    test.is(answer::Head::headers.int("Content-Length"), 6);
    test.is(answer::Head::headers.text("Content-Type"), "text/plain");
    test.is(
        FileReply(request: request, root: root, path: "missing.txt").response()::Head::status,
        Status.not_found
    );
    test.throws(InvalidReply) {
        FileReply(
            request: request,
            root: root,
            path: "q3.txt",
            headers: Headers(Header(name: "Content-Type", value: "text/html"))
        ).response();
    };
    root.close();
    scratch.close();
}
