module web/around v1.0.0;

import "web/routing" take Surrounding, WebRouting, ExceptionScope, Fallback, WebRoutes, Around, Get,
    Scope;
import "http/routing" take Route, RoutePattern, SlashPolicy;
import "web/reply" take TextReply, StreamReply;
import "http/body_coding" take GzipEncodedBody, BrotliEncodedBody;
import "http/body" take ByteBody, UnknownBodyLength, BodyOpening, OneShotBody;
import "http/negotiation" take AcceptedContentCodings;
import "http/content_coding" take ContentCoding;
import "compression/gzip" take GzipCompressed, GzipDecompressed;
import "compression/brotli" take BrotliCompressor, BrotliCompressed, BrotliDecompressed;
import "compression/state" take UnsupportedCompression;
import "http/handler" take Handling, HandlingResult, ResponseHandling;
import "web/request" take WebRequest;
import "web/exception" take Exception, ProblemReply;
import "http/message" take Request, Response, Responding;
import "http/status" take Status, StatusCode;
import "http/header" take Headers, Header, HeaderName, HeadersWithout;
import "numbers/bigint" take BigInt;
import "compare" take Order;
import "http/method" take Method, MethodName;
import "http/request_context" take HttpRequestContext;
import "http/target" take OriginTarget;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "io/stream" take WritingText;
import "time/clock" take Timing, SystemClock, MonotonicInstant, Instant;
import "time/duration" take Duration;
import "crypto/constant_time" take ConstantTimeEqual;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "async/atomic" take Atomic;
import "async/cancellation" take Cancellation;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "testing/time" take ManualClock;

// Code that goes around endpoints with web/routing's Around (#77):
//
//     WebRoutes(
//         Around(AccessLog(Stdout())),
//         Get(path: "/notes", endpoint: notes.list),
//         Scope("/admin", Around(BearerAuth(token: secret)), Get(path: "/stats", endpoint: admin.stats)),
//     )
//
// An application's own around-handler does web/routing's Surrounding.

// One line on out per request: the client's address, the method and the
// target, the status and the time the rest of the chain took:
//
//     127.0.0.1 "GET /notes?limit=5" 200 0.412 ms
//
// A request that fails with an error other than an Exception is written with
// status 500, and the error passes on.
object AccessLog does Surrounding {
    has out is WritingText;
    has clock is Timing;

    AccessLog(out is WritingText, clock is Timing = SystemClock()) {
        self.out = out;
        self.clock = clock;
    }

    async around(request is WebRequest, inner is async (WebRequest) is Responding) is Responding {
        let start = clock.monotonic_instant();
        let answer is Responding = try {
            await inner(request);
        }
        catch failure is Error {
            out.writeln(self.line(request, "500", start));
            throw failure;
        };
        out.writeln(
            self.line(request, StatusCode(answer.response()::Head::status).number().string(), start)
        );
        answer;
    }

    hidden line(request is WebRequest, status is string, start is MonotonicInstant) is string {
        let micros = (clock.monotonic_instant().minus(start)::Span::seconds * 1000000.rat()).int();
        let whole = (micros / 1000).int();
        let part = (micros - whole * 1000).string();
        let address = request.context().endpoints().remote_endpoint().address().string();
        let target = request.request()::Head::target.string();
        let method = MethodName(request.method()).string();
        let took = whole.string() + "." + "000".slice(0, 3 - part.length()) + part;
        address + " \"" + method + " " + target + "\" " + status + " " + took + " ms";
    }
}

// Lets a request through only with the token in `Authorization: Bearer
// <token>`; any other gets 401 with `WWW-Authenticate: Bearer`. The token is
// compared in constant time.
object BearerAuth does Surrounding {
    has token is string;

    BearerAuth(token is string) {
        confirm token != ""
            else throw InvalidBearerAuth.because("a bearer token must not be empty");
        self.token = token;
    }

    async around(request is WebRequest, inner is async (WebRequest) is Responding) is Responding {
        let given = request.header().maybe("Authorization").text() else "";
        if !given.lower().starts_with("bearer ") {
            return ProblemReply(
                status: Status.unauthorized,
                detail: "a bearer token is required",
                headers: Headers(Header(name: "WWW-Authenticate", value: "Bearer"))
            );
        }
        let supplied = given.slice(7, given.length()).trim();
        if !ConstantTimeEqual(
            left: Utf8Encoded(token).bytes(),
            right: Utf8Encoded(supplied).bytes()
        ).matches() {
            return ProblemReply(
                status: Status.unauthorized,
                detail: "the bearer token is not valid",
                headers: Headers(
                    Header(name: "WWW-Authenticate", value: "Bearer error=\"invalid_token\"")
                )
            );
        }
        await inner(request);
    }
}

// Cross-origin requests from one origin, in one line of a table or a scope:
//
//     WebRoutes(Cors(origin: "https://app.example"), Resource("/notes", Get(notes.list), Post(notes.add)))
//
// A preflight OPTIONS request below it is answered 204 with the method and the
// headers it asks for, before any Around (a browser sends no credentials then);
// a route of its own for OPTIONS on a path still wins. Replies to requests from
// the origin carry Access-Control-Allow-Origin. "*" allows every origin;
// credentials are not allowed.
object Cors does WebRouting {
    has origin is string;

    Cors(origin is string) {
        confirm origin != "" else throw InvalidCors.because("an origin is required");
        self.origin = origin;
    }

    routes(prefix is string, scopes is @ExceptionScope) is @Route {
        [
            Route(
                method: Method.options,
                pattern: RoutePattern(prefix + "/*preflight"),
                handling: CorsPreflight(origin)
            )
        ];
    }

    fallback() is Maybe<Fallback> {
        Maybe<Fallback>.none;
    }

    around() is Maybe<Surrounding> {
        Maybe.some(CorsMarking(origin));
    }

    slashes() is Maybe<SlashPolicy> {
        Maybe<SlashPolicy>.none;
    }
}

enum InvalidCors is Error = (because(reason is string));

// The Access-Control-Allow-Origin a request from origin gets, if any.
hidden object CorsOrigin {
    has allowed is string;
    has request is Request;

    CorsOrigin(allowed is string, request is Request) {
        self.allowed = allowed;
        self.request = request;
    }

    fields() is @Header {
        let given = request::Head::headers.maybe("Origin").text() else "";
        if given == "" || (allowed != "*" && given != allowed) {
            let none_here is @Header = [];
            return none_here;
        }
        if allowed == "*" {
            [Header(name: "Access-Control-Allow-Origin", value: "*")];
        }
        else {
            [
                Header(name: "Access-Control-Allow-Origin", value: given),
                Header(name: "Vary", value: "Origin")
            ];
        }
    }
}

hidden object CorsPreflight does Handling {
    has origin is string;

    CorsPreflight(origin is string) {
        self.origin = origin;
    }

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        let allowed = CorsOrigin(allowed: origin, request: request).fields();
        let asked = request::Head::headers.maybe("Access-Control-Request-Method").text() else "";
        let fields is @Header = if allowed.size() == 0 || asked == "" {
            allowed;
        }
        else {
            let requested = request::Head::headers.maybe("Access-Control-Request-Headers").text() else "";
            let named is @Header = if requested == "" {
                [];
            }
            else {
                [Header(name: "Access-Control-Allow-Headers", value: requested)];
            };
            allowed + [
                Header(name: "Access-Control-Allow-Methods", value: asked),
                Header(name: "Access-Control-Max-Age", value: "600")
            ] + named;
        };
        ResponseHandling(Response(status: Status.no_content, headers: Headers(entries: fields)));
    }
}

hidden object CorsMarking does Surrounding {
    has origin is string;

    CorsMarking(origin is string) {
        self.origin = origin;
    }

    async around(request is WebRequest, inner is async (WebRequest) is Responding) is Responding {
        let answer = await inner(request);
        let fields = CorsOrigin(allowed: origin, request: request.request()).fields();
        if fields.size() == 0 {
            return answer;
        }
        let response = answer.response();
        let marked = fields.reduce(response::Head::headers) -> headers, field {
            headers.addition(field);
        };
        Response(
            status: response::Head::status,
            headers: marked,
            body: response.body(),
            version: response::Head::version
        );
    }
}

// Replies compressed for clients that accept it (#186, #184): text, JSON,
// JavaScript, XML and SVG of at least minimum bytes (1 KiB unless told) that
// carry no Content-Encoding of their own:
//
//     WebRoutes(Around(Compression()), Get(path: "/notes", endpoint: notes.list))
//
// Brotli (br, level 5) goes to a client that takes it at least as gladly as
// gzip, whatever order it lists them in; gzip to the others. The JVM engine
// has no Brotli codec and sends gzip only.
//
// A reply in memory is compressed whole and keeps a Content-Length; a streamed
// one is compressed as it goes. A compressed reply says Vary: Accept-Encoding,
// its strong ETag becomes weak and it no longer offers ranges. HEAD, 204, 206
// and 304 replies pass as they are.
object Compression does Surrounding {
    has minimum is int;
    has brotli is bool;

    Compression(minimum is int = 1024) {
        confirm minimum >= 0
            else throw InvalidCompression.because("the minimum size must not be negative");
        self.minimum = minimum;
        brotli = CompressionCodecs().brotli();
    }

    async around(request is WebRequest, inner is async (WebRequest) is Responding) is Responding {
        let answer = await inner(request);
        let response = answer.response();
        let coding = self.coding(request, response);
        if coding == "" {
            return answer;
        }
        let body = response.body();
        let small = match body.contained() {
            case Maybe.some(bytes) {
                bytes.size() < minimum;
            }
            else {
                try {
                    body.length().order(BigInt(minimum)) == Order.less;
                }
                catch failure is UnknownBodyLength {
                    false;
                };
            }
        };
        if small {
            return answer;
        }
        let kept = HeadersWithout(
            origin: response::Head::headers,
            names: [
                HeaderName("Content-Length"),
                HeaderName("Accept-Ranges"),
                HeaderName("ETag"),
                HeaderName("Vary")
            ]
        ).headers();
        let tag = response::Head::headers.maybe("ETag").text() else "";
        let tagged = if tag == "" {
            kept;
        }
        else {
            if tag.starts_with("W/") {
                kept.addition(Header(name: "ETag", value: tag));
            }
            else {
                kept.addition(Header(name: "ETag", value: "W/" + tag));
            }
        };
        let varied = response::Head::headers.maybe("Vary").text() else "";
        let marked = tagged.addition(Header(name: "Content-Encoding", value: coding)).addition(
            Header(name: "Vary", value: if varied == "" {
                "Accept-Encoding";
            }
            else {
                varied + ", Accept-Encoding";
            })
        );
        match body.contained() {
            case Maybe.some(bytes) {
                let packed = if coding == "br" {
                    BrotliCompressed(origin: bytes, level: 5).bytes();
                }
                else {
                    GzipCompressed(bytes).bytes();
                };
                Response(
                    status: response::Head::status,
                    headers: marked.addition(
                        Header(name: "Content-Length", value: packed.size().string())
                    ),
                    body: ByteBody(packed),
                    version: response::Head::version
                );
            }
            else {
                let encoded is BodyOpening = if coding == "br" {
                    BrotliEncodedBody(origin: body);
                }
                else {
                    GzipEncodedBody(origin: body);
                };
                Response(
                    status: response::Head::status,
                    headers: marked,
                    body: encoded,
                    version: response::Head::version
                );
            }
        };
    }

    // The coding for this reply, "br" or "gzip", or "" when it is not to be
    // compressed.
    hidden coding(request is WebRequest, response is Response) is string {
        let code = response::Head::code;
        if request.method() == Method.head
            || code < 200
            || code == 204
            || code == 206
            || code == 304 {
                return "";
            }
        let headers = response::Head::headers;
        if headers.membership(HeaderName("Content-Encoding")) {
            return "";
        }
        let media = (headers.maybe("Content-Type").text() else "").lower();
        let type = (media.split(";")[0] else "").trim();
        let compressible = type.starts_with("text/")
            || type == "application/json"
            || type == "application/javascript"
            || type == "application/xml"
            || type == "image/svg+xml"
            || type.ends_with("+json")
            || type.ends_with("+xml");
        let accepted = request.header().list("Accept-Encoding");
        if !compressible || accepted.size() == 0 {
            return "";
        }
        let codings = AcceptedContentCodings(accepted.join(", "));
        let gzip = codings.quality(ContentCoding("gzip"));
        let br = codings.quality(ContentCoding("br"));
        if brotli && br.acceptable() && br.order(gzip) != Order.less {
            return "br";
        }
        if gzip.acceptable() {
            return "gzip";
        }
        "";
    }
}

// Which codecs this engine has: the JVM has no Brotli (#184).
hidden object CompressionCodecs {
    CompressionCodecs() {}

    brotli() is bool {
        try {
            BrotliCompressor(level: 0);
            true;
        }
        catch failure is UnsupportedCompression {
            false;
        };
    }
}

enum InvalidCompression is Error = (because(reason is string));

enum InvalidBearerAuth is Error = (because(reason is string));

// Lines written to an Atomic, for the tests below.
hidden object AroundLines does WritingText {
    has lines is Atomic<@string>;

    AroundLines(lines is Atomic<@string>) {
        self.lines = lines;
    }

    write(values is ...string) is void {
        let listed is @string = values...;
        lines.replace(lines.value() + [listed.join("")]);
    }

    writeln(values is ...string) is void {
        let listed is @string = values...;
        lines.replace(lines.value() + [listed.join("")]);
    }
}

hidden object AroundProbe {
    AroundProbe() {}

    async answer(request is WebRequest) is Responding {
        Response(status: Status.ok);
    }

    async gone(request is WebRequest) is Responding {
        throw Exception.status(410, "gone");
    }
}

// The status a table answers to a GET of target with an Authorization field.
hidden object AroundDispatch {
    has routes is WebRoutes;

    AroundDispatch(routes is WebRoutes) {
        self.routes = routes;
    }

    async status(path is string, query is Maybe<string>, authorization is string) is string {
        let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
            local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
            remote: IpEndpoint(address: IpAddress("192.0.2.7"), port: 50000)
        );
        let context = HttpRequestContext(
            details: ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1),
            cancellation: Cancellation().cancelling()
        );
        let headers = if authorization == "" {
            Headers();
        }
        else {
            Headers(Header(name: "Authorization", value: authorization));
        };
        let request = Request(target: OriginTarget(path: path, query: query), headers: headers);
        let result = await routes.handling(request, context);
        let response = result.response();
        let code = StatusCode(response::Head::status).number().string();
        if response::Head::status == Status.unauthorized {
            return code + " " + response::Head::headers.first(HeaderName("WWW-Authenticate"));
        }
        code;
    }
}

async test "an access log writes one line per request" {
    let empty is @string = [];
    let lines = Atomic(empty);
    defer lines.close();
    let probe = AroundProbe();
    let clock = ManualClock(start: Instant(origin: Duration(seconds: 0)));
    let table = AroundDispatch(
        WebRoutes(
            Around(AccessLog(out: AroundLines(lines), clock: clock)),
            Get(path: "/notes", endpoint: probe.answer),
            Get(path: "/gone", endpoint: probe.gone),
        )
    );
    test.is(await table.status("/notes", Maybe.some("limit=5"), ""), "200");
    test.is(await table.status("/gone", Maybe<string>.none, ""), "410");
    test.is(await table.status("/missing", Maybe<string>.none, ""), "404");
    test.is(
        lines.value().join("\n"),
        "192.0.2.7 \"GET /notes?limit=5\" 200 0.000 ms\n192.0.2.7 \"GET /gone\" 410 0.000 ms\n192.0.2.7 \"GET /missing\" 404 0.000 ms"
    );
}

async test "bearer authentication lets only the token through" {
    let probe = AroundProbe();
    let table = AroundDispatch(
        WebRoutes(
            Get(path: "/open", endpoint: probe.answer),
            Scope(
                "/admin",
                Around(BearerAuth(token: "s3cret")),
                Get(path: "/stats", endpoint: probe.answer)
            ),
        )
    );
    test.is(await table.status("/open", Maybe<string>.none, ""), "200");
    test.is(await table.status("/admin/stats", Maybe<string>.none, "Bearer s3cret"), "200");
    test.is(await table.status("/admin/stats", Maybe<string>.none, "bearer  s3cret "), "200");
    test.is(await table.status("/admin/stats", Maybe<string>.none, ""), "401 Bearer");
    test.is(await table.status("/admin/stats", Maybe<string>.none, "Basic czNjcmV0"), "401 Bearer");
    test.is(
        await table.status("/admin/stats", Maybe<string>.none, "Bearer s3cre"),
        "401 Bearer error=\"invalid_token\""
    );
    test.throws(InvalidBearerAuth) {
        BearerAuth(token: "");
    };
}

async test "cors answers preflights and marks replies to its origin" {
    let probe = AroundProbe();
    let routes = WebRoutes(
        Cors(origin: "https://app.example"),
        Around(BearerAuth(token: "s3cret")),
        Get(path: "/notes", endpoint: probe.answer),
    );
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
        local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
        remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: 50000)
    );
    let context = HttpRequestContext(
        details: ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1),
        cancellation: Cancellation().cancelling()
    );
    let preflight = await routes.handling(
        Request(
            target: OriginTarget(path: "/notes", query: Maybe<string>.none),
            method: Method.options,
            headers: Headers(
                Header(name: "Origin", value: "https://app.example"),
                Header(name: "Access-Control-Request-Method", value: "POST"),
                Header(name: "Access-Control-Request-Headers", value: "authorization, content-type"),
            )
        ),
        context
    );
    let answered = preflight.response();
    test.is(answered::Head::status, Status.no_content);
    test.is(answered::Head::headers.text("Access-Control-Allow-Origin"), "https://app.example");
    test.is(answered::Head::headers.text("Access-Control-Allow-Methods"), "POST");
    test.is(
        answered::Head::headers.text("Access-Control-Allow-Headers"),
        "authorization, content-type"
    );
    let actual = await routes.handling(
        Request(
            target: OriginTarget(path: "/notes", query: Maybe<string>.none),
            headers: Headers(
                Header(name: "Origin", value: "https://app.example"),
                Header(name: "Authorization", value: "Bearer s3cret"),
            )
        ),
        context
    );
    test.is(actual.response()::Head::status, Status.ok);
    test.is(
        actual.response()::Head::headers.text("Access-Control-Allow-Origin"),
        "https://app.example"
    );
    test.is(actual.response()::Head::headers.text("Vary"), "Origin");
    let foreign = await routes.handling(
        Request(
            target: OriginTarget(path: "/notes", query: Maybe<string>.none),
            headers: Headers(
                Header(name: "Origin", value: "https://evil.example"),
                Header(name: "Authorization", value: "Bearer s3cret"),
            )
        ),
        context
    );
    test.ok(
        !foreign.response()::Head::headers.membership(HeaderName("Access-Control-Allow-Origin"))
    );
}

// Answers with a long text, a short one, a stream of unknown length, a
// compressed body, JSON of unknown length and an image, for the test below.
hidden object CompressionProbe {
    CompressionProbe() {}

    async long(request is WebRequest) is Responding {
        TextReply(
            text: "tea ".repeat(1000),
            headers: Headers(Header(name: "ETag", value: "\"v1\""))
        );
    }

    async short(request is WebRequest) is Responding {
        TextReply("tea");
    }

    async stream(request is WebRequest) is Responding {
        StreamReply(
            body: GzipEncodedBody(origin: ByteBody(Utf8Encoded("milk ".repeat(1000)).bytes())),
            media_type: "text/plain"
        );
    }

    async json(request is WebRequest) is Responding {
        StreamReply(
            body: OneShotBody(ByteBody(Utf8Encoded("{\"tea\": 1}".repeat(300)).bytes()).reading()),
            media_type: "application/json"
        );
    }

    async image(request is WebRequest) is Responding {
        Response(
            status: Status.ok,
            headers: Headers(Header(name: "Content-Type", value: "image/png")),
            body: ByteBody(Utf8Encoded("x".repeat(5000)).bytes())
        );
    }
}

async test "replies are compressed for clients that accept it" {
    let probe = CompressionProbe();
    let routes = WebRoutes(
        Around(Compression()),
        Get(path: "/long", endpoint: probe.long),
        Get(path: "/short", endpoint: probe.short),
        Get(path: "/stream", endpoint: probe.stream),
        Get(path: "/image", endpoint: probe.image),
        Get(path: "/json", endpoint: probe.json),
    );
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
        local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
        remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: 50000)
    );
    let context = HttpRequestContext(
        details: ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1),
        cancellation: Cancellation().cancelling()
    );
    let gzip = Headers(Header(name: "Accept-Encoding", value: "br;q=0.5, gzip;q=0.8"));
    let long = (await routes.handling(
        Request(target: OriginTarget(path: "/long", query: Maybe<string>.none), headers: gzip),
        context
    )).response();
    test.is(long::Head::headers.text("Content-Encoding"), "gzip");
    test.is(long::Head::headers.text("Vary"), "Accept-Encoding");
    test.is(long::Head::headers.text("ETag"), "W/\"v1\"");
    let packed = long.body().contained() else [];
    test.is(long::Head::headers.int("Content-Length"), packed.size());
    test.is(
        Utf8Decoded(GzipDecompressed(origin: packed, limit: 10000).bytes()).string(),
        "tea ".repeat(1000)
    );
    let plain = (await routes.handling(
        Request(target: OriginTarget(path: "/long", query: Maybe<string>.none)),
        context
    )).response();
    test.ok(!plain::Head::headers.membership(HeaderName("Content-Encoding")));
    let short = (await routes.handling(
        Request(target: OriginTarget(path: "/short", query: Maybe<string>.none), headers: gzip),
        context
    )).response();
    test.ok(!short::Head::headers.membership(HeaderName("Content-Encoding")));
    let image = (await routes.handling(
        Request(target: OriginTarget(path: "/image", query: Maybe<string>.none), headers: gzip),
        context
    )).response();
    test.ok(!image::Head::headers.membership(HeaderName("Content-Encoding")));
    let refused = Headers(Header(name: "Accept-Encoding", value: "gzip;q=0, identity"));
    let none_wanted = (await routes.handling(
        Request(target: OriginTarget(path: "/long", query: Maybe<string>.none), headers: refused),
        context
    )).response();
    test.ok(!none_wanted::Head::headers.membership(HeaderName("Content-Encoding")));
    // A browser lists gzip first and br later at the same weight: br wins
    // where the engine has it (#184).
    let browser = Headers(Header(name: "Accept-Encoding", value: "gzip, deflate, br, zstd"));
    let brotli = CompressionCodecs().brotli();
    let chosen = if brotli {
        "br";
    }
    else {
        "gzip";
    };
    let packed_long = (await routes.handling(
        Request(target: OriginTarget(path: "/long", query: Maybe<string>.none), headers: browser),
        context
    )).response();
    test.is(packed_long::Head::headers.text("Content-Encoding"), chosen);
    if brotli {
        let squeezed = packed_long.body().contained() else [];
        test.is(packed_long::Head::headers.int("Content-Length"), squeezed.size());
        test.is(
            Utf8Decoded(BrotliDecompressed(origin: squeezed, limit: 10000).bytes()).string(),
            "tea ".repeat(1000)
        );
    }
    let only_br = Headers(Header(name: "Accept-Encoding", value: "br"));
    let streamed = (await routes.handling(
        Request(target: OriginTarget(path: "/json", query: Maybe<string>.none), headers: only_br),
        context
    )).response();
    if brotli {
        test.is(streamed::Head::headers.text("Content-Encoding"), "br");
        test.ok(!streamed::Head::headers.membership(HeaderName("Content-Length")));
        let reading = streamed.body().reading();
        let empty is @byte = [];
        let gathered = Atomic(empty);
        loop {
            let chunk = await reading.bytes(4096);
            if chunk.size() == 0 {
                last;
            }
            gathered.replace(gathered.value() + chunk);
        }
        test.is(
            Utf8Decoded(BrotliDecompressed(origin: gathered.value(), limit: 10000).bytes()).string(),
            "{\"tea\": 1}".repeat(300)
        );
    }
    else {
        test.ok(!streamed::Head::headers.membership(HeaderName("Content-Encoding")));
    }
}
