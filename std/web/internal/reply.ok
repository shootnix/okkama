module web/internal/reply v1.0.0;

import "http/message" take Response;
import "http/status" take Status, StatusCode;
import "http/header" take Headers, Header, HeaderName;
import "http/body" take ByteBody, EmptyBody;

// Shared response assembly for web/reply and web/exception. A reply owns its
// representation and framing fields; the headers a caller gives may carry any
// other field, but never Content-Type, Content-Length or Transfer-Encoding.

// The response of a reply with a representation.
object ReplyResponse {
    has code is Status;
    has media is string;
    has content is @byte;
    has given is Headers;

    ReplyResponse(status is Status, media is string, content is @byte, headers is Headers) {
        code = BodyStatus(status).status();
        self.media = media;
        self.content = content;
        given = headers;
    }

    response() is Response {
        let fixed is @Header = [
            Header(name: "Content-Type", value: media),
            Header(name: "Content-Length", value: content.size().string())
        ];
        Response(status: code, headers: ReplyFields(fixed: fixed, given: given).headers(), body: ByteBody(content));
    }
}

// Bodiless replies: 204 carries no framing field at all; redirects declare
// length 0 so the connection stays reusable.
object EmptyReplyResponse {
    has code is Status;
    has given is Headers;

    EmptyReplyResponse(status is Status, headers is Headers) {
        code = status;
        given = headers;
    }

    response() is Response {
        let fixed is @Header = if code == Status.no_content {
            let bare is @Header = [];
            bare;
        }
        else {
            [Header(name: "Content-Length", value: "0")];
        };
        Response(status: code, headers: ReplyFields(fixed: fixed, given: given).headers(), body: EmptyBody());
    }
}

// The reply's own fields, then the given ones, which may not take over the
// representation or the framing.
hidden object ReplyFields {
    has fixed is @Header;
    has given is Headers;

    ReplyFields(fixed is @Header, given is Headers) {
        self.fixed = fixed;
        self.given = given;
    }

    headers() is Headers {
        let more = given.entries();
        let extra is @Header = (0..more.size()).map() -> index {
            let field = more.item(index);
            let lowered = field.name().lowercase();
            confirm lowered != "content-type" && lowered != "content-length" && lowered != "transfer-encoding"
                else throw InvalidReply.because(field.name().string() + " is owned by the reply itself");
            field;
        };
        Headers(entries: fixed + extra, limits: given.limits());
    }
}

// Statuses that carry a representation body.
object BodyStatus {
    has code is Status;

    BodyStatus(status is Status) {
        let number = StatusCode(status).number();
        confirm number >= 200 && number <= 599 && number != 204 && number != 205 && number != 304
            else throw InvalidReply.because("status " + number.string() + " cannot carry a body");
        code = status;
    }

    status() is Status {
        code;
    }
}

enum InvalidReply is Error = (because(reason is string));

test "framing headers are owned by the reply" {
    let owned = Headers(Header(name: "Content-Length", value: "1"));
    test.throws(InvalidReply) {
        ReplyResponse(status: Status.ok, media: "text/plain", content: [], headers: owned).response();
    };
    let traced = Headers(Header(name: "X-Trace", value: "a"), Header(name: "Cache-Control", value: "no-store"));
    let response = ReplyResponse(status: Status.ok, media: "text/plain", content: [104.byte()], headers: traced).response();
    test.is(response::Head::headers.entries().size(), 4);
    test.is(response::Head::headers.first(HeaderName("Content-Length")), "1");
}

test "only representation statuses carry bodies" {
    test.is(BodyStatus(Status.ok).status(), Status.ok);
    test.throws(InvalidReply) {
        BodyStatus(Status.no_content);
    };
    test.throws(InvalidReply) {
        BodyStatus(Status.not_modified);
    };
    test.throws(InvalidReply) {
        BodyStatus(Status.switching_protocols);
    };
}
