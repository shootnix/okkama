module web/routing v1.0.0;

import "http/routing" take Routes, Route, RoutePattern, RouteRejecting;
import "http/handler" take Handling, HandlingResult;
import "http/request_context" take HttpRequestContext;
import "http/message" take Request;
import "http/method" take Method, MethodName;
import "web/request" take WebRequest;
import "web/exception" take Exception, Problem;

// Route tables built from controller actions. An endpoint is any bound action
// of type `async (WebRequest) is HandlingResult`, so one controller object can
// serve many routes and keep its dependencies in its own fields:
//
//     WebRoutes(
//         [
//             Get("/health", system.health),
//             Scope("/api", [
//                 Scope("/users", UserExceptions(), [
//                     Post("", users.register),
//                     Get("/:id", users.show)
//                 ])
//             ])
//         ],
//         system.missing
//     );
//
// Everything compiles into one std http/routing.Routes, so its rules are kept:
// overlapping patterns for one method are rejected at construction, a known
// path with another method gets 405 with Allow, and HEAD uses GET. Requests
// Routes rejects itself (405, malformed path) are answered by WebRejection as
// Exception problem replies, Allow included.
//
// Paths: a Scope prefix starts with "/" and does not end with it. A route path
// is "" (the scope itself, only inside a Scope) or starts with "/". The full
// pattern is the concatenation of prefixes and the route path.
//
// Exceptions: an ExceptionScope wraps every endpoint below its Scope. Its
// scoped() calls the endpoint and translates the errors it knows into
// Exception replies; unknown errors propagate to the next outer scope.
// Scopes run outermost first, so the innermost one sees errors first. After all
// scopes, the framework itself answers: a thrown Exception becomes its reply.
// Request bodies are read through web/request.RequestJson, which raises its own
// 422 Exception; JSON errors from server-side data are not translated. Any other
// error propagates to the std HttpServer, which answers 500 without a body;
// cancellation and timeouts keep their std meaning.

role ExceptionScope {
    async scoped(request is WebRequest, endpoint is async (WebRequest) is HandlingResult) is HandlingResult;
}

role WebRouting {
    routes(prefix is string, scopes is @ExceptionScope) is @Route;
}

object Get does WebRouting {
    has origin is MethodRoute;

    Get(path is string, endpoint is async (WebRequest) is HandlingResult) {
        origin = MethodRoute(method: Method.get, path: path, endpoint: endpoint);
    }

    routes(prefix is string, scopes is @ExceptionScope) is @Route {
        origin.routes(prefix, scopes);
    }
}

object Post does WebRouting {
    has origin is MethodRoute;

    Post(path is string, endpoint is async (WebRequest) is HandlingResult) {
        origin = MethodRoute(method: Method.post, path: path, endpoint: endpoint);
    }

    routes(prefix is string, scopes is @ExceptionScope) is @Route {
        origin.routes(prefix, scopes);
    }
}

object Put does WebRouting {
    has origin is MethodRoute;

    Put(path is string, endpoint is async (WebRequest) is HandlingResult) {
        origin = MethodRoute(method: Method.put, path: path, endpoint: endpoint);
    }

    routes(prefix is string, scopes is @ExceptionScope) is @Route {
        origin.routes(prefix, scopes);
    }
}

object Patch does WebRouting {
    has origin is MethodRoute;

    Patch(path is string, endpoint is async (WebRequest) is HandlingResult) {
        origin = MethodRoute(method: Method.patch, path: path, endpoint: endpoint);
    }

    routes(prefix is string, scopes is @ExceptionScope) is @Route {
        origin.routes(prefix, scopes);
    }
}

object Delete does WebRouting {
    has origin is MethodRoute;

    Delete(path is string, endpoint is async (WebRequest) is HandlingResult) {
        origin = MethodRoute(method: Method.delete, path: path, endpoint: endpoint);
    }

    routes(prefix is string, scopes is @ExceptionScope) is @Route {
        origin.routes(prefix, scopes);
    }
}

object Scope does WebRouting {
    has prefix is string;
    has own is @ExceptionScope;
    has routings is @WebRouting;

    Scope(prefix is string, routings is @WebRouting) {
        self.prefix = WebPrefix(prefix).string();
        let bare is @ExceptionScope = [];
        own = bare;
        self.routings = routings;
    }

    Scope(prefix is string, exceptions is ExceptionScope, routings is @WebRouting) {
        self.prefix = WebPrefix(prefix).string();
        let single is @ExceptionScope = [exceptions];
        own = single;
        self.routings = routings;
    }

    routes(outer is string, scopes is @ExceptionScope) is @Route {
        let inner = ScopeList(left: scopes, right: own).scopes();
        let empty is @Route = [];
        routings.reduce(empty) -> all, routing {
            RouteList(left: all, right: routing.routes(outer + prefix, inner)).routes();
        };
    }
}

// The application's route table. It is the Handling given to HttpServer.
object WebRoutes does Handling {
    has origin is Routes;

    WebRoutes(routings is @WebRouting, fallback is async (WebRequest) is HandlingResult) {
        let bare is @ExceptionScope = [];
        origin = WebRouteTable(routings: routings, scopes: bare, fallback: fallback).routes();
    }

    WebRoutes(
        routings is @WebRouting,
        exceptions is ExceptionScope,
        fallback is async (WebRequest) is HandlingResult
    ) {
        let single is @ExceptionScope = [exceptions];
        origin = WebRouteTable(routings: routings, scopes: single, fallback: fallback).routes();
    }

    // The compiled std table. WebApplication serves it directly, which saves one
    // await level per request compared with going through handling().
    table() is Routes {
        origin;
    }

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        await origin.handling(request, context);
    }
}

hidden object WebRouteTable {
    has routings is @WebRouting;
    has scopes is @ExceptionScope;
    has fallback is async (WebRequest) is HandlingResult;

    WebRouteTable(
        routings is @WebRouting,
        scopes is @ExceptionScope,
        fallback is async (WebRequest) is HandlingResult
    ) {
        self.routings = routings;
        self.scopes = scopes;
        self.fallback = fallback;
    }

    routes() is Routes {
        let empty is @Route = [];
        let all is @Route = routings.reduce(empty) -> collected, routing {
            RouteList(left: collected, right: routing.routes("", scopes)).routes();
        };
        Routes(routes: all, fallback: WebEndpoint(fallback, scopes), rejection: WebRejection());
    }
}

// Requests rejected by std Routes before any endpoint runs get problem bodies too.
hidden object WebRejection does RouteRejecting {
    WebRejection();

    malformed(request is Request, reason is string) is HandlingResult {
        Problem(status: 400, detail: reason);
    }

    disallowed(request is Request, allowed is @string) is HandlingResult {
        Problem(
            405,
            "method " + MethodName(request::Head::method).string() + " is not allowed here"
        ).header(
            "Allow",
            allowed.join(", ")
        );
    }
}

hidden object MethodRoute {
    has method is Method;
    has path is string;
    has endpoint is async (WebRequest) is HandlingResult;

    MethodRoute(method is Method, path is string, endpoint is async (WebRequest) is HandlingResult) {
        confirm path == "" || path.slice(0, 1) == "/"
            else throw InvalidWebRoute.because("route path must be empty or start with /: " + path);
        self.method = method;
        self.path = path;
        self.endpoint = endpoint;
    }

    routes(prefix is string, scopes is @ExceptionScope) is @Route {
        let pattern = prefix + path;
        confirm pattern != ""
            else throw InvalidWebRoute.because("an empty route path is only valid inside a Scope");
        [Route(method: method, pattern: RoutePattern(pattern), handling: WebEndpoint(endpoint, scopes))];
    }
}

hidden object WebPrefix {
    has origin is string;

    WebPrefix(origin is string) {
        confirm origin.length() > 1
            && origin.slice(0, 1) == "/"
            && origin.slice(origin.length() - 1, origin.length()) != "/"
            else throw InvalidWebRoute.because(
                "scope prefix must start with / and not end with it: " + origin
            );
        self.origin = origin;
    }

    string() is string {
        origin;
    }
}

// Adapts one endpoint and its scope chain to std Handling.
hidden object WebEndpoint does Handling {
    has endpoint is async (WebRequest) is HandlingResult;
    has scopes is @ExceptionScope;

    WebEndpoint(endpoint is async (WebRequest) is HandlingResult, scopes is @ExceptionScope) {
        self.endpoint = endpoint;
        self.scopes = scopes;
    }

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        try {
            await ScopedEndpoint(endpoint: endpoint, scopes: scopes, index: 0).call(WebRequest(request: request, context: context));
        }
        catch Exception.status(code, detail) {
            Problem(status: code, detail: detail);
        }
    }
}

// scopes[index] wraps the rest of the chain; past the last scope is the endpoint.
hidden object ScopedEndpoint {
    has endpoint is async (WebRequest) is HandlingResult;
    has scopes is @ExceptionScope;
    has index is int;

    ScopedEndpoint(
        endpoint is async (WebRequest) is HandlingResult,
        scopes is @ExceptionScope,
        index is int
    ) {
        self.endpoint = endpoint;
        self.scopes = scopes;
        self.index = index;
    }

    async call(request is WebRequest) is HandlingResult {
        if index == scopes.size() {
            await endpoint(request);
        }
        else {
            await scopes[index].scoped(request, ScopedEndpoint(endpoint: endpoint, scopes: scopes, index: index + 1).call);
        }
    }
}

hidden object RouteList {
    has left is @Route;
    has right is @Route;

    RouteList(left is @Route, right is @Route) {
        self.left = left;
        self.right = right;
    }

    routes() is @Route {
        let joined is @Route = (0..left.size() + right.size()).map() -> index {
            if index < left.size() {
                left[index];
            }
            else {
                right[index - left.size()];
            }
        };
        joined;
    }
}

hidden object ScopeList {
    has left is @ExceptionScope;
    has right is @ExceptionScope;

    ScopeList(left is @ExceptionScope, right is @ExceptionScope) {
        self.left = left;
        self.right = right;
    }

    scopes() is @ExceptionScope {
        let joined is @ExceptionScope = (0..left.size() + right.size()).map() -> index {
            if index < left.size() {
                left[index];
            }
            else {
                right[index - left.size()];
            }
        };
        joined;
    }
}

enum InvalidWebRoute is Error = (because(reason is string));

test "scope prefixes are absolute and have no trailing slash" {
    test.is(WebPrefix("/api").string(), "/api");
    test.throws(InvalidWebRoute) {
        WebPrefix("/api/");
    };
    test.throws(InvalidWebRoute) {
        WebPrefix("api");
    };
    test.throws(InvalidWebRoute) {
        WebPrefix("/");
    };
}
