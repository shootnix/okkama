module web/request v1.0.0;

import "http/method" take Method;
import "http/message" take Request, BodyLimitExceeded;
import "http/request_context" take HttpRequestContext;
import "http/header" take HeaderName, MissingHeader;
import "http/target" take RequestTargetKind, OriginTarget;
import "http/media_type" take HttpMediaType, InvalidHttpMediaType;

import "url/query" take QueryParameters, QueryLimitExceeded;
import "url/form" take ParsedForm, InvalidFormEncoding;
import "json" take Json, JsonKind, JsonKindName, JsonLocation, JsonMaybeReader, ParsedJson, JsonError;
import "math/decimal" take Decimal;
import "numbers/bigint" take BigInt;
import "encoding/utf" take Utf8Encoded, Utf8Decoded, InvalidUtf8;
import "web/exception" take Exception;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "async/cancellation" take Cancellation;

// The request as an endpoint sees it: route parameters, query, fields and a
// body read under an explicit byte limit. Client mistakes become Exception
// values with the matching status (400, 413, 415) so the endpoint never has to
// translate transport problems itself. The std Request and context stay
// reachable through request() and context().
//
// The body can be consumed once: text(), json(), form() and bytes() all read it.

object WebRequest {
    has origin is Request;
    has details is HttpRequestContext;

    WebRequest(request is Request, context is HttpRequestContext) {
        origin = request;
        details = context;
    }

    request() is Request {
        origin;
    }

    context() is HttpRequestContext {
        details;
    }

    method() is Method {
        origin::Head::method;
    }

    // Route parameter declared by the matched pattern. A missing name means the
    // endpoint is mounted on a pattern that does not declare it: a server bug.
    path(name is string) is string {
        let parameters = details.parameters();
        confirm parameters.has(name) else throw MissingRouteParameter.name(name);
        parameters[name];
    }

    // A query parameter, or none: request.query("limit") else "10". A required
    // one: request.query("q") else throw Exception.status(400, "q required").
    query(name is string) is Maybe<string> {
        let parameters = self.parameters();
        if parameters.membership(name) {
            Maybe<string>.some(parameters.first(name));
        }
        else {
            Maybe<string>.none;
        }
    }

    // Query decoded the way browsers and URLSearchParams encode it
    // (application/x-www-form-urlencoded: "+" is a space). The raw RFC 3986
    // query stays available through request().target().query(). It is decoded
    // once per request, however many parameters an endpoint reads (#75).
    parameters() is QueryParameters {
        once let parameters = self.decoded_query();
        parameters;
    }

    hidden decoded_query() is QueryParameters {
        let kind = origin::Head::target.kind();
        let raw is Maybe<string> = if kind == RequestTargetKind.origin {
            origin::Head::target.query();
        }
        else {
            if kind == RequestTargetKind.absolute {
                let url = origin::Head::target.url();
                url::Parts::query;
            }
            else {
                Maybe<string>.none;
            }
        };
        try {
            ParsedForm(Utf8Encoded(raw else "").bytes()).parameters();
        }
        catch failure is InvalidFormEncoding {
            throw Exception.status(400, "invalid query: " + failure.text());
        }
        catch failure is QueryLimitExceeded {
            throw Exception.status(400, failure.text());
        }
    }

    header(name is string) is string {
        try {
            origin::Head::headers.first(HeaderName(name));
        }
        catch failure is MissingHeader {
            throw Exception.status(400, "missing header: " + name);
        }
    }

    header(name is string, fallback is string) is string {
        let field = HeaderName(name);
        if origin::Head::headers.membership(field) {
            origin::Head::headers.first(field);
        }
        else {
            fallback;
        }
    }

    async bytes(limit is int) is @byte {
        confirm limit >= 0 else throw InvalidBodyLimit.limit(limit);
        let content = try {
            await origin.bytes(limit: limit);
        }
        catch e is BodyLimitExceeded {
            throw Exception.status(413, "request body exceeds " + limit.string() + " bytes");
        };
        content;
    }

    async text(limit is int) is string {
        let content = await self.bytes(limit);
        try {
            Utf8Decoded(content).string();
        }
        catch failure is InvalidUtf8 {
            throw Exception.status(400, "request body is not valid UTF-8");
        }
    }

    // Requires application/json or a +json media type. The document is parsed
    // eagerly, so syntax errors are a 400 here and never escape later as JsonError.invalid;
    // reading errors of the returned RequestJson are 422.
    async json(limit is int) is RequestJson {
        self.media("json");
        let document = try {
            ParsedJson(await self.text(limit)).root();
        }
        catch failure is JsonError {
            throw Exception.status(400, "invalid JSON body: " + failure.text());
        };
        RequestJson(document);
    }

    // Requires application/x-www-form-urlencoded.
    async form(limit is int) is QueryParameters {
        self.media("form");
        let content = await self.bytes(limit);
        try {
            ParsedForm(content).parameters();
        }
        catch failure is InvalidFormEncoding {
            throw Exception.status(400, failure.text());
        }
    }

    hidden media(expected is string) is void {
        let field = HeaderName("Content-Type");
        confirm origin::Head::headers.membership(field)
            else throw Exception.status(415, "Content-Type is required");
        let media = try {
            HttpMediaType(origin::Head::headers.first(field));
        }
        catch failure is InvalidHttpMediaType {
            throw Exception.status(415, "invalid Content-Type");
        };
        let suffix = media::Type::subtype.split("+");
        let accepted = media::Type::type == "application"
            && if expected == "json" {
                media::Type::subtype == "json"
                    || (suffix.size() > 1 && suffix[suffix.size() - 1] == "json");
            }
            else {
                media::Type::subtype == "x-www-form-urlencoded";
            };
        confirm accepted
            else throw Exception.status(
                415,
                "unsupported Content-Type: " + media::Type::type + "/" + media::Type::subtype
            );
    }
}

enum MissingRouteParameter is Error = (name(name is string));

enum InvalidBodyLimit is Error = (limit(limit is int));

// The request body as JSON. Same reading API as json.Json, but every reading
// failure is the client's: it becomes Exception.status(422, …) naming the JSON pointer.
// Server-side JSON read through a plain Json keeps its own errors, so a bug in
// server data is never reported to the client as 422.
object RequestJson {
    has origin is Json;

    RequestJson(origin is Json) {
        self.origin = origin;
    }

    root() is Json {
        origin;
    }

    kind() is JsonKind {
        origin.kind();
    }

    pointer() is string {
        origin.pointer();
    }

    text() is string {
        try {
            origin.text();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    number() is Decimal {
        try {
            origin.number();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    boolean() is bool {
        try {
            origin.boolean();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    integer() is BigInt {
        try {
            origin.integer();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    int() is int {
        try {
            origin.int();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    size() is int {
        try {
            origin.size();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    names() is @string {
        try {
            origin.names();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    has(name is string) is bool {
        try {
            origin.has(name);
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    items() is @RequestJson {
        let values = try {
            origin.items();
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        };
        let wrapped is @RequestJson = values.map() -> value {
            RequestJson(value);
        };
        wrapped;
    }

    at(index is int) is RequestJson {
        try {
            RequestJson(origin.at(index));
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    get(name is string) is RequestJson {
        try {
            RequestJson(origin.get(name));
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    // A member that may be absent or null: fallback readers over json's
    // maybe(name), with a present member of another kind as 422.
    optional(name is string) is RequestJsonOptional {
        try {
            RequestJsonOptional(origin.maybe(name));
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    text(name is string) is string {
        self.get(name).text();
    }

    number(name is string) is Decimal {
        self.get(name).number();
    }

    integer(name is string) is BigInt {
        self.get(name).integer();
    }

    int(name is string) is int {
        self.get(name).int();
    }

    boolean(name is string) is bool {
        self.get(name).boolean();
    }

    list(name is string) is @RequestJson {
        self.get(name).items();
    }
}

object RequestJsonOptional {
    has origin is JsonMaybeReader;

    RequestJsonOptional(origin is JsonMaybeReader) {
        self.origin = origin;
    }

    present() is bool {
        origin.present();
    }

    pointer() is string {
        origin.pointer();
    }

    // The member as a node of any kind; absent or null is a 422.
    node() is RequestJson {
        let found = origin.node() else throw Exception.status(
            422,
            JsonProblem().missing(origin.pointer())
        );
        RequestJson(found);
    }

    text(fallback is string) is string {
        try {
            origin.text() else fallback;
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    number(fallback is Decimal) is Decimal {
        try {
            origin.number() else fallback;
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    boolean(fallback is bool) is bool {
        try {
            origin.boolean() else fallback;
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    int(fallback is int) is int {
        try {
            origin.int() else fallback;
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        }
    }

    items() is @RequestJson {
        let values is @Json = try {
            origin.list() else [];
        }
        catch failure is JsonError {
            throw JsonProblem().failure(failure);
        };
        let wrapped is @RequestJson = values.map() -> value {
            RequestJson(value);
        };
        wrapped;
    }
}

// The client-facing detail of a JSON reading failure (sent in 422 problems).
// One translation for every reader (#84).
hidden object JsonProblem {
    JsonProblem();

    // A failure to read the document the client sent, as the 422 the client
    // sees; any other failure stays as it is.
    failure(origin is JsonError) is Error {
        match origin {
            case JsonError.wrong_kind(pointer, expected, actual) {
                Exception.status(422, self.kind(pointer, expected, actual));
            }
            case JsonError.missing(location) {
                Exception.status(422, self.missing(location));
            }
            case JsonError.invalid_number(location, spelling, reason) {
                Exception.status(422, self.number(location, spelling, reason));
            }
            else {
                origin;
            }
        }
    }

    kind(pointer is string, expected is JsonKind, actual is JsonKind) is string {
        "JSON value at " + JsonLocation(pointer).string() + " must be " + JsonKindName(expected).string() + ", found " + JsonKindName(
            actual
        ).string();
    }

    missing(location is string) is string {
        "JSON value at " + JsonLocation(location).string() + " is missing";
    }

    number(location is string, spelling is string, reason is string) is string {
        "JSON number " + spelling + " at " + JsonLocation(location).string() + ": " + reason;
    }
}

test "request JSON reading failures are 422 exceptions at the pointer" {
    let body = RequestJson(ParsedJson("{\"name\":\"Ada\",\"age\":\"x\",\"nick\":null}").root());
    test.is(body.text("name"), "Ada");
    test.is(
        try {
            body.int("age");
            "no";
        }
        catch Exception.status(code, detail) {
            code.string() + " " + detail;
        },
        "422 JSON value at /age must be number, found string"
    );
    test.is(
        try {
            body.text("missing");
            "no";
        }
        catch Exception.status(_, detail) {
            detail;
        },
        "JSON value at /missing is missing"
    );
    test.is(body.optional("nick").text("anonymous"), "anonymous");
    test.is(
        try {
            body.optional("age").int(0);
            "no";
        }
        catch Exception.status(code, detail) {
            code.string() + " " + detail;
        },
        "422 JSON value at /age must be number, found string"
    );
}

test "the query is decoded once and read many times" {
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
        local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
        remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: 50000)
    );
    let context = HttpRequestContext(
        details: ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1),
        cancellation: Cancellation().cancelling()
    );
    let request = WebRequest(
        request: Request(target: OriginTarget(path: "/", query: Maybe.some("a=1&b=x+y&a=2"))),
        context: context
    );
    test.is(request.query("a") else "", "1");
    test.is(request.query("b") else "", "x y");
    test.is(request.query("c") else "none", "none");
    test.is(request.parameters().first("a"), "1");
    let broken = WebRequest(
        request: Request(target: OriginTarget(path: "/", query: Maybe.some("a=%FF"))),
        context: context
    );
    for [1, 2] -> attempt {
        test.is(
            try {
                broken.query("a") else "";
            }
            catch Exception.status(code, _) {
                code.string();
            },
            "400"
        );
    }
}

