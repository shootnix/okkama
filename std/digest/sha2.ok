        ^digest = continued;
    }
}

// SHA-512.
object Sha512 does Digesting {
    has digest is HostDigest;

    // An empty digest; state(bytes) feeds it.
    Sha512() {
        digest = HostDigest(algorithm: "sha512", key: [], width: 0);
    }

    // The digest of these bytes.
    Sha512(origin is @byte) {
        digest = HostDigest(algorithm: "sha512", key: [], width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Sha512(text is string) {
        digest = HostDigest(algorithm: "sha512", key: [], width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest of everything fed so far and then origin; this one stays as it
    // is.
    state(origin is @byte) is ^Sha512 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Sha512 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// SHA-512/256: SHA-512 cut to 32 bytes, with its own start.
object Sha512_256 does Digesting {
    has digest is HostDigest;

    // An empty digest; state(bytes) feeds it.
    Sha512_256() {
        digest = HostDigest(algorithm: "sha512-256", key: [], width: 0);
    }

    // The digest of these bytes.
    Sha512_256(origin is @byte) {
        digest = HostDigest(algorithm: "sha512-256", key: [], width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Sha512_256(text is string) {
        digest = HostDigest(algorithm: "sha512-256", key: [], width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest of everything fed so far and then origin; this one stays as it
    // is.
    state(origin is @byte) is ^Sha512_256 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Sha512_256 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

test "SHA-2 matches FIPS 180-4 examples" {
    let abc = [97.byte(), 98.byte(), 99.byte()];
    test.is(
        HexEncoded(Sha256(abc).bytes()).string(),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    );
    test.is(
        HexEncoded(Sha224(abc).bytes()).string(),
        "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7"
    );
    test.is(
        HexEncoded(Sha384(abc).bytes()).string(),
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
    );
    test.is(
        HexEncoded(Sha512(abc).bytes()).string(),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    );
    test.is(
        HexEncoded(Sha512_256(abc).bytes()).string(),
        "53048e2681941ef99b2e29b76b4c7dabe4c2d0c634fc6d46e0e2f13107e7af23"
    );
    test.is(
        HexEncoded(Sha256().bytes()).string(),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    );
}

test "SHA-2 successors branch immutably" {
    let prefix = Sha256([97.byte(), 98.byte()]);
    let whole = prefix.state([99.byte()]);
    let other = prefix.state([100.byte()]);
    test.is(whole.bytes(), Sha256([97.byte(), 98.byte(), 99.byte()]).bytes());
    test.is(other.bytes(), Sha256([97.byte(), 98.byte(), 100.byte()]).bytes());
    test.is(prefix.bytes(), Sha256([97.byte(), 98.byte()]).bytes());
    test.is(prefix.state([]).bytes(), prefix.bytes());
    test.is(Sha512().bytes().size(), 64);
}

test "a digest takes text and writes itself as hex" {
    test.is(Sha256("abc").hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    test.is(Sha256().state("ab").state([99.byte()]).hex(), Sha256("abc").hex());
    test.is(Sha256("abc").bytes(), Sha256([97.byte(), 98.byte(), 99.byte()]).bytes());
    test.is(Sha256("é").hex(), Sha256([195.byte(), 169.byte()]).hex());
}

