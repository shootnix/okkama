module digest/sha2 v1.0.0;

import "digest/state" take Digesting;
import "encoding/utf" take Utf8Encoded;
import "digest/host" take HostDigest;

// SHA-2 (FIPS 180-4) over the host provider. Each object is the digest of an
// ordered byte history: the empty constructor binds empty input, the @byte
// constructor binds one chunk, state(bytes) returns a successor over the
// appended history and leaves this digest, its earlier observations and other
// branches unchanged. bytes() returns raw bytes (28/32/48/64/32 bytes for
// Sha224/Sha256/Sha384/Sha512/Sha512_256) and hex() the same as lowercase
// hex. Text is hashed as UTF-8. Construction creates a host state; there is
// no I/O.
//
//     Sha256("hello world").hex();                   // b94d27b9...
//     Sha256().state("ab").state([99.byte()]).hex();  // ba7816bf... for "abc"
import "encoding/hex" take HexEncoded;

// SHA-224.
object Sha224 does Digesting {
    has digest is HostDigest;

    // An empty digest; state(bytes) feeds it.
    Sha224() {
        digest = HostDigest(algorithm: "sha224", key: [], width: 0);
    }

    // The digest of these bytes.
    Sha224(origin is @byte) {
        digest = HostDigest(algorithm: "sha224", key: [], width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Sha224(text is string) {
        digest = HostDigest(algorithm: "sha224", key: [], width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest of everything fed so far and then origin; this one stays as it
    // is.
    state(origin is @byte) is ^Sha224 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Sha224 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// SHA-256, the usual choice.
object Sha256 does Digesting {
    has digest is HostDigest;

    // An empty digest; state(bytes) feeds it.
    Sha256() {
        digest = HostDigest(algorithm: "sha256", key: [], width: 0);
    }

    // The digest of these bytes.
    Sha256(origin is @byte) {
        digest = HostDigest(algorithm: "sha256", key: [], width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Sha256(text is string) {
        digest = HostDigest(algorithm: "sha256", key: [], width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest of everything fed so far and then origin; this one stays as it
    // is.
    state(origin is @byte) is ^Sha256 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Sha256 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// SHA-384.
object Sha384 does Digesting {
    has digest is HostDigest;

    // An empty digest; state(bytes) feeds it.
    Sha384() {
        digest = HostDigest(algorithm: "sha384", key: [], width: 0);
    }

    // The digest of these bytes.
    Sha384(origin is @byte) {
        digest = HostDigest(algorithm: "sha384", key: [], width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Sha384(text is string) {
        digest = HostDigest(algorithm: "sha384", key: [], width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest of everything fed so far and then origin; this one stays as it
    // is.
    state(origin is @byte) is ^Sha384 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Sha384 {
