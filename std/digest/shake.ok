module digest/shake v1.0.0;

// SHAKE128 and SHAKE256 extendable-output functions (FIPS 202) over the host
// provider. The output length is part of the object: bytes() returns exactly
// `length` bytes (1..1048576, InvalidShakeLength otherwise), and successors
// keep it. A longer output of the same history starts with the shorter one.
//
//     Shake128(32, message).bytes(); // 32 raw bytes

import "digest/state" take Digesting;
import "encoding/utf" take Utf8Encoded;
import "digest/host" take HostDigest;
import "encoding/hex" take HexEncoded;

// SHAKE128: as many output bytes as asked for.
object Shake128 does Digesting {
    has digest is HostDigest;

    // An empty SHAKE128 giving length bytes, 1 to 1048576.
    Shake128(length is int) {
        confirm length >= 1 && length <= 1048576 else throw InvalidShakeLength.length(length);
        digest = HostDigest(algorithm: "shake128", key: [], width: length);
    }

    // SHAKE128 of these bytes, length bytes long.
    Shake128(length is int, origin is @byte) {
        confirm length >= 1 && length <= 1048576 else throw InvalidShakeLength.length(length);
        digest = HostDigest(algorithm: "shake128", key: [], width: length).appended(origin);
    }

    // Text, as UTF-8.
    Shake128(length is int, text is string) {
        confirm length >= 1 && length <= 1048576 else throw InvalidShakeLength.length(length);
        digest = HostDigest(algorithm: "shake128", key: [], width: length).appended(Utf8Encoded(text).bytes());
    }

    // The output.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The function continued with origin.
    state(origin is @byte) is ^Shake128 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Shake128 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// SHAKE256: as many output bytes as asked for.
object Shake256 does Digesting {
    has digest is HostDigest;

    // An empty SHAKE256 giving length bytes, 1 to 1048576.
    Shake256(length is int) {
        confirm length >= 1 && length <= 1048576 else throw InvalidShakeLength.length(length);
        digest = HostDigest(algorithm: "shake256", key: [], width: length);
    }

    // SHAKE256 of these bytes, length bytes long.
    Shake256(length is int, origin is @byte) {
        confirm length >= 1 && length <= 1048576 else throw InvalidShakeLength.length(length);
        digest = HostDigest(algorithm: "shake256", key: [], width: length).appended(origin);
    }

    // Text, as UTF-8.
    Shake256(length is int, text is string) {
        confirm length >= 1 && length <= 1048576 else throw InvalidShakeLength.length(length);
        digest = HostDigest(algorithm: "shake256", key: [], width: length).appended(Utf8Encoded(text).bytes());
    }

    // The output.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The function continued with origin.
    state(origin is @byte) is ^Shake256 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Shake256 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// An output length outside 1 to 1048576.
enum InvalidShakeLength is Error = (length(length is int));

test "SHAKE matches FIPS 202 empty-message outputs" {
    test.is(
        HexEncoded(Shake128(32).bytes()).string(),
        "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26"
    );
    test.is(
        HexEncoded(Shake256(32).bytes()).string(),
        "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f"
    );
    test.is(Shake128(length: 64, origin: [1.byte()]).bytes().slice(0, 32), Shake128(length: 32, origin: [1.byte()]).bytes());
    test.ok(try {
        Shake256(0);
        false;
    }
    catch InvalidShakeLength.length(length) {
        length == 0;
    });
}
