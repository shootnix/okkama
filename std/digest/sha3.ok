module digest/sha3 v1.0.0;

// SHA-3 digests (FIPS 202) of 28, 32, 48 or 64 bytes.
//
//     let digest = Sha3_256(Utf8Encoded("hello").bytes()).bytes();
//     let streamed = Sha3_512().state(head).state(rest).bytes();
//
// They follow digest/state: each state is a value, fed piece by piece.

import "digest/state" take Digesting;
import "encoding/utf" take Utf8Encoded;
import "digest/host" take HostDigest;

import "encoding/hex" take HexEncoded;

// SHA3-224.
object Sha3_224 does Digesting {
    has digest is HostDigest;

    // An empty digest; state(bytes) feeds it.
    Sha3_224() {
        digest = HostDigest(algorithm: "sha3-224", key: [], width: 0);
    }

    // The digest of these bytes.
    Sha3_224(origin is @byte) {
        digest = HostDigest(algorithm: "sha3-224", key: [], width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Sha3_224(text is string) {
        digest = HostDigest(algorithm: "sha3-224", key: [], width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest of everything fed so far and then origin; this one stays as it
    // is.
    state(origin is @byte) is ^Sha3_224 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Sha3_224 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// SHA3-256.
object Sha3_256 does Digesting {
    has digest is HostDigest;

    // An empty digest; state(bytes) feeds it.
    Sha3_256() {
        digest = HostDigest(algorithm: "sha3-256", key: [], width: 0);
    }

    // The digest of these bytes.
    Sha3_256(origin is @byte) {
        digest = HostDigest(algorithm: "sha3-256", key: [], width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Sha3_256(text is string) {
        digest = HostDigest(algorithm: "sha3-256", key: [], width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest of everything fed so far and then origin; this one stays as it
    // is.
    state(origin is @byte) is ^Sha3_256 {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Sha3_256 {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

