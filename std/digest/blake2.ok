module digest/blake2 v1.0.0;

// BLAKE2 digests (RFC 7693), plain and keyed.
//
//     let digest = Blake2b(length: 32, origin: data).bytes();
//     let tag = Blake2bMac(key: secret, origin: message).bytes();
//
// Blake2b gives 16, 20, 28, 32, 48 or 64 bytes, Blake2s 16, 20, 28 or 32; the
// length is a parameter of BLAKE2, not a truncation. The keyed forms give full
// width (64 or 32 bytes) and take a SecretBytes key of 1 to 64 or 1 to 32
// bytes.

import "digest/state" take Digesting;
import "encoding/utf" take Utf8Encoded;
import "digest/host" take HostDigest;
import "crypto/secret" take SecretBytes;
import "encoding/hex" take HexEncoded;

// BLAKE2b with the output length given.
object Blake2b does Digesting {
    has digest is HostDigest;

    // An empty BLAKE2b of length bytes.
    Blake2b(length is int) {
        confirm length == 16
            || length == 20
            || length == 28
            || length == 32
            || length == 48
            || length == 64
            else throw InvalidBlake2Length.length(length);
        digest = HostDigest(algorithm: "blake2b", key: [], width: length);
    }

    // BLAKE2b of these bytes.
    Blake2b(length is int, origin is @byte) {
        confirm length == 16
            || length == 20
            || length == 28
            || length == 32
            || length == 48
            || length == 64
            else throw InvalidBlake2Length.length(length);
        digest = HostDigest(algorithm: "blake2b", key: [], width: length).appended(origin);
    }

    // Text, as UTF-8.
    Blake2b(length is int, text is string) {
        confirm length == 16
            || length == 20
            || length == 28
            || length == 32
            || length == 48
            || length == 64
            else throw InvalidBlake2Length.length(length);
        digest = HostDigest(algorithm: "blake2b", key: [], width: length).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest continued with origin.
    state(origin is @byte) is ^Blake2b {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Blake2b {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// BLAKE2s with the output length given.
object Blake2s does Digesting {
    has digest is HostDigest;

    // An empty BLAKE2s of length bytes.
    Blake2s(length is int) {
        confirm length == 16 || length == 20 || length == 28 || length == 32
            else throw InvalidBlake2Length.length(length);
        digest = HostDigest(algorithm: "blake2s", key: [], width: length);
    }

    // BLAKE2s of these bytes.
    Blake2s(length is int, origin is @byte) {
        confirm length == 16 || length == 20 || length == 28 || length == 32
            else throw InvalidBlake2Length.length(length);
        digest = HostDigest(algorithm: "blake2s", key: [], width: length).appended(origin);
    }

    // Text, as UTF-8.
    Blake2s(length is int, text is string) {
        confirm length == 16 || length == 20 || length == 28 || length == 32
            else throw InvalidBlake2Length.length(length);
        digest = HostDigest(algorithm: "blake2s", key: [], width: length).appended(Utf8Encoded(text).bytes());
    }

    // The digest.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The digest continued with origin.
    state(origin is @byte) is ^Blake2s {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Blake2s {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// Keyed BLAKE2b, 64 bytes: a MAC.
object Blake2bMac does Digesting {
    has digest is HostDigest;

    // An empty MAC with key.
    Blake2bMac(key is SecretBytes) {
        digest = HostDigest(algorithm: "blake2b-mac", key: key.export_bytes(), width: 0);
    }

    // The MAC of these bytes.
    Blake2bMac(key is SecretBytes, origin is @byte) {
        digest = HostDigest(algorithm: "blake2b-mac", key: key.export_bytes(), width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Blake2bMac(key is SecretBytes, text is string) {
        digest = HostDigest(algorithm: "blake2b-mac", key: key.export_bytes(), width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The tag.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The MAC continued with origin.
    state(origin is @byte) is ^Blake2bMac {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Blake2bMac {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// Keyed BLAKE2s, 32 bytes: a MAC.
object Blake2sMac does Digesting {
    has digest is HostDigest;

    // An empty MAC with key.
    Blake2sMac(key is SecretBytes) {
        digest = HostDigest(algorithm: "blake2s-mac", key: key.export_bytes(), width: 0);
    }

    // The MAC of these bytes.
    Blake2sMac(key is SecretBytes, origin is @byte) {
        digest = HostDigest(algorithm: "blake2s-mac", key: key.export_bytes(), width: 0).appended(origin);
    }

    // Text, as UTF-8.
    Blake2sMac(key is SecretBytes, text is string) {
        digest = HostDigest(algorithm: "blake2s-mac", key: key.export_bytes(), width: 0).appended(Utf8Encoded(text).bytes());
    }

    // The tag.
    bytes() is @byte {
        digest.bytes();
    }

    // The digest as lowercase hex.
    hex() is string {
        HexEncoded(self.bytes()).string();
    }

    // The MAC continued with origin.
    state(origin is @byte) is ^Blake2sMac {
        let continued = digest.appended(origin);
        ^digest = continued;
    }

    // Text, as UTF-8: Sha256().state("hello ").state("world").
    state(text is string) is ^Blake2sMac {
        let continued = digest.appended(Utf8Encoded(text).bytes());
        ^digest = continued;
    }
}

// A length BLAKE2 does not take.
enum InvalidBlake2Length is Error = (length(length is int));

test "BLAKE2 matches RFC 7693 abc examples" {
    let abc = [97.byte(), 98.byte(), 99.byte()];
    test.is(
        HexEncoded(Blake2b(length: 64, origin: abc).bytes()).string(),
        "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"
    );
    test.is(
        HexEncoded(Blake2s(length: 32, origin: abc).bytes()).string(),
        "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982"
    );
    test.ok(Blake2b(length: 32, origin: abc).bytes() != Blake2b(length: 64, origin: abc).bytes().slice(0, 32));
    test.ok(try {
        Blake2s(64);
        false;
    }
    catch InvalidBlake2Length.length(length) {
        length == 64;
    });
}

test "keyed BLAKE2 depends on the key" {
    let message = [1.byte(), 2.byte()];
    let first = Blake2bMac(key: SecretBytes([7.byte()]), origin: message).bytes();
    test.is(first.size(), 64);
    test.ok(first != Blake2bMac(key: SecretBytes([8.byte()]), origin: message).bytes());
    test.is(
        Blake2sMac(SecretBytes([7.byte()])).state(message).bytes(),
        Blake2sMac(key: SecretBytes([7.byte()]), origin: message).bytes()
    );
}
