module url/query v1.0.0;

import "url/percent" take PercentEncoded, UrlComponent;
import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "encoding/utf" take Utf8Encoded, Utf8Decoded, InvalidUtf8;
import "io/buffer" take ByteBuffer;
import "error" take InvalidArgument;

object QueryParameter {
    has key, text is string;
    has assignment is bool;

    QueryParameter(name is string) {
        key = name;
        text = "";
        assignment = false;
    }

    QueryParameter(name is string, value is string) {
        key = name;
        text = value;
        assignment = true;
    }

    name() is string {
        key;
    }

    value() is string {
        text;
    }

    assigned() is bool {
        assignment;
    }
}

object QueryParameters {
    has origin is @QueryParameter;

    QueryParameters(entries is Sequencing<QueryParameter>) {
        origin = ParameterSnapshot(origin: entries, maximum: 10000).entries();
    }

    // The same, one argument per part: QueryParameters(a, b).
    QueryParameters(entries is ...QueryParameter) {
        let listed is @QueryParameter = entries...;
        origin = ParameterSnapshot(origin: listed, maximum: 10000).entries();
    }

    QueryParameters(entries is Sequencing<QueryParameter>, maximum_parameters is int) {
        origin = ParameterSnapshot(origin: entries, maximum: maximum_parameters).entries();
    }

    entries() is Sequencing<QueryParameter> {
        origin;
    }

    membership(name is string) is bool {
        origin.reduce(false) -> found, entry {
            found || entry.name() == name;
        };
    }

    first(name is string) is string {
        for origin -> entry {
            if entry.name() == name {
                return entry.value();
            }
        }
        throw MissingQueryParameter.name(name);
    }

    values(name is string) is Sequencing<string> {
        let matches is @QueryParameter = origin.filter() -> entry {
            entry.name() == name;
        };
        let values is @string = matches.map() -> entry {
            entry.value();
        };
        values;
    }

    string() is string {
        let encoded is @string = origin.map() -> entry {
            let name = PercentEncoded(origin: entry.name(), component: UrlComponent.data).string();
            if entry.assigned() {
                name + "=" + PercentEncoded(origin: entry.value(), component: UrlComponent.data).string();
            }
            else {
                name;
            }
        };
        encoded.join("&");
    }
}

// The parameters of a query string, decoded as RFC 3986 query text (not
// HTML form text: "+" stays "+").
//
//     let page = ParsedUrl("https://example.com/search?q=okkama&page=2").parts();
//     let parameters = ParsedQuery(page::Parts::query else "").parameters();
//     parameters.first("q");     // "okkama"
object ParsedQuery {
    has origin is string;
    has maximum_parameters, maximum_bytes is int;

    ParsedQuery(origin is string) {
        self.origin = origin;
        maximum_parameters = 10000;
        maximum_bytes = 1048576;
    }

    ParsedQuery(origin is string, maximum_parameters is int, maximum_bytes is int) {
        confirm maximum_parameters >= 0 && maximum_bytes >= 0
            else throw InvalidArgument.because("query limits must be nonnegative");
        self.origin = origin;
        self.maximum_parameters = maximum_parameters;
        self.maximum_bytes = maximum_bytes;
    }

    parameters() is QueryParameters {
        confirm origin.length() <= maximum_bytes
            else throw QueryLimitExceeded.kind("bytes");
        ParameterParsing(
            origin: Utf8Encoded(origin).bytes(),
            form: false,
            maximum_parameters: maximum_parameters,
            maximum_bytes: maximum_bytes
        ).parameters();
    }
}

enum MissingQueryParameter is Error = (name(name is string));

enum InvalidQueryEncoding is Error = (located(offset is int, reason is string));

enum QueryLimitExceeded is Error = (kind(kind is string));

// Importable collaborators shared with form parsing; no mutable parser state
// escapes. Snapshot sources are observed exactly once in index order.
hidden object ParameterSnapshot {
    has origin is Sequencing<QueryParameter>;
    has maximum is int;

    ParameterSnapshot(origin is Sequencing<QueryParameter>, maximum is int) {
        confirm maximum >= 0 else throw InvalidArgument.because("query limit must be nonnegative");
        self.origin = origin;
        self.maximum = maximum;
    }

    entries() is @QueryParameter {
        let size = origin.size();
        confirm size >= 0
            else throw InvalidArgument.because("query source size must be nonnegative");
        confirm size <= maximum else throw QueryLimitExceeded.kind("parameters");
        let entries is @QueryParameter = (0..size).map() -> index {
            origin.item(index);
        };
        entries;
    }
}

object ParameterParsing {
    has origin is @byte;
    has form is bool;
    has maximum_parameters, maximum_bytes is int;

    ParameterParsing(origin is @byte, form is bool, maximum_parameters is int, maximum_bytes is int) {
        confirm maximum_parameters >= 0 && maximum_bytes >= 0
            else throw InvalidArgument.because("query limits must be nonnegative");
        self.origin = origin;
        self.form = form;
        self.maximum_parameters = maximum_parameters;
        self.maximum_bytes = maximum_bytes;
    }

    parameters() is QueryParameters {
        let size = origin.size();
        confirm size <= maximum_bytes else throw QueryLimitExceeded.kind("bytes");
        let parts = ParameterParts();
        if size > 0 {
            let stops = (0..size + 1).filter() -> index {
                index == size || origin[index] == byte(38);
            };
            for stops -> end {
                let start = parts.start();
                if form && start == end {
                    parts = parts.skipping(end + 1);
                }
                else {
                    confirm parts.size() < maximum_parameters
                        else throw QueryLimitExceeded.kind("parameters");
                    let equals = (start..end).reduce(-1) -> found, index {
                        if found < 0 && origin[index] == byte(61) {
                            index;
                        }
                        else {
                            found;
                        }
                    };
                    let split = if equals < 0 {
                        end;
                    }
                    else {
                        equals;
                    };
                    let name = ParameterText(
                        origin: origin.slice(start, split),
                        form: form,
                        offset: start
                    ).string();
                    let value = if equals < 0 {
                        "";
                    }
                    else {
                        ParameterText(
                            origin: origin.slice(equals + 1, end),
                            form: form,
                            offset: equals + 1
                        ).string();
                    };
                    let entry = if form || equals >= 0 {
                        QueryParameter(name: name, value: value);
                    }
                    else {
                        QueryParameter(name);
                    };
                    parts = parts.following(end + 1, entry);
                }
            }
        }
        QueryParameters(entries: parts.entries(), maximum_parameters: maximum_parameters);
    }
}

hidden object ParameterParts {
    has position is int;
    has reversed is List<QueryParameter>;

    ParameterParts() {
        position = 0;
        let empty is List<QueryParameter> = EmptyList();
        reversed = empty;
    }

    start() is int {
        position;
    }

    size() is int {
        reversed.size();
    }

    skipping(position is int) is ^ParameterParts {
        ^position = position;
    }

    following(position is int, entry is QueryParameter) is ^ParameterParts {
        ^position = position;
        ^reversed = reversed.prefix(entry);
    }

    entries() is @QueryParameter {
        let backwards is @QueryParameter = reversed.map() -> entry {
            entry;
        };
        let entries is @QueryParameter = (0..backwards.size()).map() -> index {
            backwards[backwards.size() - index - 1];
        };
        entries;
    }
}

hidden object ParameterPosition {
    has source, decoded is int;

    ParameterPosition() {
        source = 0;
        decoded = 0;
    }

    source() is int {
        source;
    }

    decoded() is int {
        decoded;
    }

    following(width is int) is ^ParameterPosition {
        ^source = source + width;
        ^decoded = decoded + 1;
    }
}

hidden object ParameterText {
    has origin is @byte;
    has form is bool;
    has offset is int;

    ParameterText(origin is @byte, form is bool, offset is int) {
        self.origin = origin;
        self.form = form;
        self.offset = offset;
    }

    string() is string {
        let output = ByteBuffer();
        defer output.closing().close();
        let writer = output.writing();
        let cursor = ParameterPosition();
        loop {
            let index = cursor.source();
            last if index == origin.size();
            let width = self.width(index);
            let octet = if width == 3 {
                (self.digit(origin[index + 1]) * 16 + self.digit(origin[index + 2])).byte();
            }
            else {
                if form && origin[index] == byte(43) {
                    byte(32);
                }
                else {
                    origin[index];
                }
            };
            writer.write([octet]);
            cursor = cursor.following(width);
        }
        try {
            Utf8Decoded(output.content().bytes()).string();
        }
        catch InvalidUtf8.at(offset) {
            let cursor = ParameterPosition();
            loop {
                if cursor.decoded() == offset {
                    throw InvalidQueryEncoding.located(offset + cursor.source(), "invalid UTF-8");
                }
                cursor = cursor.following(self.width(cursor.source()));
            }
        }
    }

    hidden width(index is int) is int {
        if origin[index] != byte(37) {
            return 1;
        }
        confirm origin.size() - index >= 3
            else throw InvalidQueryEncoding.located(offset + index, "incomplete percent escape");
        confirm self.digit(origin[index + 1]) >= 0 && self.digit(origin[index + 2]) >= 0
            else throw InvalidQueryEncoding.located(offset + index, "invalid percent escape");
        3;
    }

    hidden digit(octet is byte) is int {
        let value = octet.int();
        if value >= 48 && value <= 57 {
            return value - 48;
        }
        if value >= 65 && value <= 70 {
            return value - 55;
        }
        if value >= 97 && value <= 102 {
            return value - 87;
        }
        -1;
    }
}

test "flags and duplicate parameters retain their identity" {
    let entries = ParsedQuery("a&a=&a=1").parameters();
    test.is(entries.string(), "a&a=&a=1");
    test.is(entries.values("a").size(), 3);
}
