module url/percent v1.0.0;

import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "encoding/hex" take HexDecoded, InvalidHex;
import "io/buffer" take ByteBuffer;
import "io/decorators" take ByteSnapshot;

// Whole-component choices preserve their grammatical separators. Use data for
// a single query name/value. These choices do not validate URL structure.
enum UrlComponent = (data, userinfo, path_segment, path, query, fragment);

// Encode decoded text exactly once; '%' is data even in a preexisting %HH.
// Non-ASCII scalars are UTF-8 encoded before escaping individual octets.
object PercentEncoded {
    has origin is string;
    has component is UrlComponent;

    PercentEncoded(origin is string, component is UrlComponent) {
        self.origin = origin;
        self.component = component;
    }

    string() is string {
        // Text with nothing to escape stays as it is (#503).
        let plain = origin.characters().reduce(true) -> clean, character {
            clean && character.code() < 128 && self.safe(character.code());
        };
        if plain {
            return origin;
        }
        let digits = "0123456789ABCDEF";
        let chunks is @string = Utf8Encoded(origin).bytes().map() -> octet {
            let value = octet.int();
            if self.safe(value) {
                value.char().string();
            }
            else {
                let high = (value / 16).int();
                let low = value % 16;
                "%" + digits.slice(high, high + 1) + digits.slice(low, low + 1);
            }
        };
        chunks.join("");
    }

    hidden safe(value is int) is bool {
        if (value >= 65 && value <= 90)
            || (value >= 97 && value <= 122)
            || (value >= 48 && value <= 57)
            || value == 45
            || value == 46
            || value == 95
            || value == 126 {
                return true;
            }
        if component == UrlComponent.data {
            return false;
        }
        // sub-delims and colon are shared by all remaining choices.
        if value == 33
            || value == 36
            || value == 38
            || value == 39
            || value == 40
            || value == 41
            || value == 42
            || value == 43
            || value == 44
            || value == 59
            || value == 61
            || value == 58 {
                return true;
            }
        if component == UrlComponent.userinfo {
            return false;
        }
        if value == 64 {
            return true;
        }
        if component == UrlComponent.path_segment {
            return false;
        }
        if value == 47 {
            return true;
        }
        value == 63 && (component == UrlComponent.query || component == UrlComponent.fragment);
    }
}

// Percent grammar is checked when observed. Literal Unicode contributes UTF-8;
// '+' stays '+'. bytes() supports binary output; string() preserves InvalidUtf8.
object PercentDecoded {
    has origin is string;

    PercentDecoded(origin is string) {
        self.origin = origin;
    }

    // Literal runs between escapes are encoded whole, not one character at
    // a time (#503); text without '%' is its own UTF-8.
    bytes() is @byte {
        if !origin.contains("%") {
            return Utf8Encoded(origin).bytes();
        }
        let parts = origin.split("%");
        let output = ByteBuffer();
        defer output.closing().close();
        let writer = output.writing();
        writer.write(ByteSnapshot(Utf8Encoded(parts[0]).bytes()));
        (1..parts.size()).reduce(parts[0].length()) -> at, index {
            let part = parts[index];
            confirm part.length() >= 2 else throw InvalidPercentEncoding.at(at);
            let octets = try {
                HexDecoded(part.slice(0, 2)).bytes();
            }
            catch failure is InvalidHex {
                throw InvalidPercentEncoding.at(at);
            };
            writer.write(ByteSnapshot(octets));
            if part.length() > 2 {
                writer.write(ByteSnapshot(Utf8Encoded(part.slice(2, part.length())).bytes()));
            }
            at + 1 + part.length();
        };
        output.content().bytes();
    }

    string() is string {
        if !origin.contains("%") {
            return origin;
        }
        Utf8Decoded(self.bytes()).string();
    }
}

enum InvalidPercentEncoding is Error = (at(offset is int));

test "query data does not inject separators" {
    test.is(
        PercentEncoded(origin: "a&b=c+d", component: UrlComponent.data).string(),
        "a%26b%3Dc%2Bd"
    );
    test.is(PercentDecoded("a%26b%3Dc%2Bd").string(), "a&b=c+d");
}

test "decoding happens once" {
    test.is(PercentDecoded("%252F").string(), "%2F");
}

test "escapes are found between literal runs" {
    test.is(PercentDecoded("caf%C3%A9 au lait").string(), "caf\u{e9} au lait");
    test.is(PercentDecoded("%D0%92%D0%B0%D1%81%D1%8F").string(), "\u{412}\u{430}\u{441}\u{44f}");
    test.is(PercentDecoded("plain").string(), "plain");
    test.is(PercentDecoded("\u{e9}t\u{e9}%21").string(), "\u{e9}t\u{e9}!");
}

test "a broken escape names its offset" {
    test.throws(InvalidPercentEncoding) {
        PercentDecoded("a%").bytes();
    };
    test.throws(InvalidPercentEncoding) {
        PercentDecoded("ok%2").bytes();
    };
    test.throws(InvalidPercentEncoding) {
        PercentDecoded("%%41").bytes();
    };
    test.throws(InvalidPercentEncoding) {
        PercentDecoded("x%zz").bytes();
    };
    let offset = try {
        PercentDecoded("ab%41c%4").string();
        -1;
    }
    catch InvalidPercentEncoding.at(found) {
        found;
    };
    test.is(offset, 6);
}
