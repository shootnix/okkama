module diff v1.0.0;

import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "collections/iteration" take Cursor;
import "runtime/diff" take diff_script;
import "cell" take Cell;

enum InvalidDiff is Error = (because(reason is string));

enum DiffLimitExceeded is Error = (off_budget);

hidden object DiffListValues<T> {
    has values is @T;

    DiffListValues(origin is List<T>, reverse is bool) {
        let cursor is Cell<Cursor<T>> = Cell(origin.cursor());
        let items is @T = (0..origin.size()).map() -> index {
            let current = cursor.value();
            let item = current.item();
            cursor.replace(current.successor());
            item;
        };
        let values is @T = (0..items.size()).map() -> index {
            items[if reverse {
                items.size() - index - 1;
            }
            else {
                index;
            }];
        };
        self.values = values;
    }

    values() is @T {
        values;
    }
}

hidden object DiffLines {
    has values is @string;

    DiffLines(origin is Sequencing<string>) {
        let size = origin.size();
        confirm size >= 0 && size <= 512
            else throw InvalidDiff.because("line count must be 0..512");
        let values is @string = (0..size).map() -> index {
            let text = origin.item(index);
            confirm text.length() <= 4096 && text.split("\n").size() == 1
                else throw InvalidDiff.because("line length or embedded LF");
            text;
        };
        let scalars = values.reduce(0) -> sum, text {
            sum + text.length();
        };
        confirm scalars <= 1048576 else throw InvalidDiff.because("aggregate input length");
        self.values = values;
    }

    values() is @string {
        values;
    }
}

enum DiffEditKind = (equal, removed, added);

object DiffEdit {
    has kind is DiffEditKind;
    has text is string;
    has left, right is int;

    DiffEdit(kind is DiffEditKind, text is string, left is int, right is int) {
        self.kind = kind;
        self.text = text;
        self.left = left;
        self.right = right;
    }

    // One line of the comparison: kept, removed or added, with its text and
    // its index on each side.
    cap Line {
        kind is DiffEditKind {
            kind;
        }

        text is string {
            text;
        }

        left is int {
            left;
        }

        right is int {
            right;
        }
    }
}

hidden object DiffSearching {
    has left, right is @string;

    DiffSearching(left is @string, right is @string) {
        self.left = left;
        self.right = right;
    }

    values() is @DiffEdit {
        let script = try {
            diff_script(left, right);
        }
        catch error is NativeFailure {
            if error.code() == "invalid_data" {
                throw InvalidDiff.because(error.message());
            }
            throw UnavailableDiff.because(error.message());
        };
        let values is @DiffEdit = (0..(script.size() / 3).int()).map() -> index {
            let kind = script[index * 3];
            let x = script[index * 3 + 1];
            let y = script[index * 3 + 2];
            if kind == 0 {
                DiffEdit(kind: DiffEditKind.equal, text: left[x], left: x, right: y);
            }
            else if kind == 1 {
                DiffEdit(kind: DiffEditKind.removed, text: left[x], left: x, right: y);
            }
            else {
                DiffEdit(kind: DiffEditKind.added, text: right[y], left: x, right: y);
            }
        };
        values;
    }
}

enum UnavailableDiff is Error = (because(reason is string));

hidden object DiffScript {
    has left, right is @string;
    has edits is @DiffEdit;

    DiffScript(left is Sequencing<string>, right is Sequencing<string>) {
        let first = DiffLines(left).values();
        let second = DiffLines(right).values();
        self.left = first;
        self.right = second;
        edits = DiffSearching(left: first, right: second).values();
    }

    edits() is @DiffEdit {
        edits;
    }

    left_size() is int {
        left.size();
    }

    right_size() is int {
        right.size();
    }
}

hidden object MatchingBlock {
    has left, right, amount is int;

    MatchingBlock(left is int, right is int, size is int) {
        self.left = left;
        self.right = right;
        amount = size;
    }

    left() is int {
        left;
    }

    right() is int {
        right;
    }

    size() is int {
        amount;
    }
}

hidden object MatchingBlocks {
    has values is @MatchingBlock;

    MatchingBlocks(script is DiffScript) {
        let edits = script.edits();
        let empty is List<MatchingBlock> = EmptyList();
        let blocks is Cell<List<MatchingBlock>> = Cell(empty);
        for edits -> edit {
            if edit::Line::kind == DiffEditKind.equal {
                let current = blocks.value();
                if current.size() > 0
                    && current.first().left() + current.first().size() == edit::Line::left
                    && current.first().right() + current.first().size() == edit::Line::right {
                        let previous = current.first();
                        blocks.replace(
                            current.tail().prefix(
                                MatchingBlock(
                                    left: previous.left(),
                                    right: previous.right(),
                                    size: previous.size() + 1
                                )
                            )
                        );
                    }
                    else {
                        blocks.replace(current.prefix(MatchingBlock(left: edit::Line::left, right: edit::Line::right, size: 1)));
                    }
            }
        }
        values = DiffListValues(
            origin: blocks.value().prefix(MatchingBlock(script.left_size(), script.right_size(), 0)),
            reverse: true
        ).values();
    }

    values() is Sequencing<MatchingBlock> {
        values;
    }
}

hidden object DiffSpan {
    has start, end is int;

    DiffSpan(start is int, end is int) {
        self.start = start;
        self.end = end;
    }

    start() is int {
        start;
    }

    end() is int {
        end;
    }
}

hidden object DiffHunks {
    has values is @DiffSpan;

    DiffHunks(edits is @DiffEdit, context is int) {
        confirm context >= 0 && context <= 64
            else throw InvalidDiff.because("context must be 0..64");
        let empty is List<DiffSpan> = EmptyList();
        let spans is Cell<List<DiffSpan>> = Cell(empty);
        for (0..edits.size()) -> index {
            if edits[index]::Line::kind != DiffEditKind.equal {
                let start = if index > context {
                    index - context;
                }
                else {
                    0;
                };
                let end = if index + context + 1 < edits.size() {
                    index + context + 1;
                }
                else {
                    edits.size();
                };
                let current = spans.value();
                if current.size() > 0 && current.first().end() >= start {
                    let previous = current.first();
                    spans.replace(current.tail().prefix(DiffSpan(start: previous.start(), end: end)));
                }
                else {
                    spans.replace(current.prefix(DiffSpan(start: start, end: end)));
                }
            }
        }
        values = DiffListValues(origin: spans.value(), reverse: true).values();
    }

    values() is @DiffSpan {
        values;
    }
}

hidden object DiffRange {
    has start, amount is int;

    DiffRange(start is int, amount is int) {
        self.start = start;
        self.amount = amount;
    }

    unified() is string {
        let first = if amount == 0 {
            start;
        }
        else {
            start + 1;
        };
        first.string() + (if amount == 1 {
            "";
        }
        else {
            "," + amount.string();
        });
    }

    context() is string {
        if amount == 0 {
            start.string();
        }
        else {
            (start + 1).string() + (if amount == 1 {
                "";
            }
            else {
                "," + (start + amount).string();
            });
        }
    }
}

hidden object DiffPrinting {
    has script is DiffScript;
    has context is int;

    DiffPrinting(script is DiffScript, context is int) {
        self.script = script;
        self.context = context;
    }

    string(context_style is bool) is string {
        let edits = script.edits();
        let spans = DiffHunks(edits: edits, context: context).values();
        if spans.size() == 0 {
            return "";
        }
        let texts is @string = spans.map() -> span {
            let first = edits[span.start()];
            let left = (span.start()..span.end()).reduce(0) -> sum, index {
                sum + (if edits[index]::Line::kind != DiffEditKind.added {
                    1;
                }
                else {
                    0;
                });
            };
            let right = (span.start()..span.end()).reduce(0) -> sum, index {
                sum + (if edits[index]::Line::kind != DiffEditKind.removed {
                    1;
                }
                else {
                    0;
                });
            };
            let old_range = DiffRange(start: first::Line::left, amount: left);
            let new_range = DiffRange(start: first::Line::right, amount: right);
            if context_style {
                let rows = DiffContextRows(edits: edits, span: span).values();
                "***************\n*** " + old_range.context() + " ****\n" + rows[0] + "--- " + new_range.context() + " ----\n" + rows[1];
            }
            else {
                let rows is @string = (span.start()..span.end()).map() -> index {
                    let edit = edits[index];
                    (match edit::Line::kind {
                        case DiffEditKind.equal {
                            " ";
                        }
                        case DiffEditKind.removed {
                            "-";
                        }
                        else {
                            "+";
                        }
                    }) + edit::Line::text + "\n";
                };
                "@@ -" + old_range.unified() + " +" + new_range.unified() + " @@\n" + rows.join("");
            }
        };
        let amount = texts.reduce(0) -> sum, text {
            sum + text.length();
        };
        confirm amount <= 1048576 else throw DiffLimitExceeded.off_budget;
        (if context_style {
            "*** left\n--- right\n";
        }
        else {
            "--- left\n+++ right\n";
        }) + texts.join("");
    }
}

hidden object DiffContextRows {
    has values is @string;

    DiffContextRows(edits is @DiffEdit, span is DiffSpan) {
        let empty is List<string> = EmptyList();
        let left is Cell<List<string>> = Cell(empty);
        let right is Cell<List<string>> = Cell(empty);
        let position = Cell(span.start());
        loop {
            if position.value() >= span.end() {
                last;
            }
            let current = edits[position.value()];
            if current::Line::kind == DiffEditKind.equal {
                let text = "  " + current::Line::text + "\n";
                left.replace(left.value().prefix(text));
                right.replace(right.value().prefix(text));
                position.replace(position.value() + 1);
            }
            else {
                let start = position.value();
                loop {
                    if position.value() >= span.end()
                        || edits[position.value()]::Line::kind == DiffEditKind.equal {
                            last;
                        }
                    position.replace(position.value() + 1);
                }
                let removed = (start..position.value()).reduce(false) -> found, index {
                    found || edits[index]::Line::kind == DiffEditKind.removed;
                };
                let added = (start..position.value()).reduce(false) -> found, index {
                    found || edits[index]::Line::kind == DiffEditKind.added;
                };
                for (start..position.value()) -> index {
                    let edit = edits[index];
                    if edit::Line::kind == DiffEditKind.removed {
                        left.replace(left.value().prefix((if added {
                            "! ";
                        }
                        else {
                            "- ";
                        }) + edit::Line::text + "\n"));
                    }
                    else {
                        right.replace(right.value().prefix((if removed {
                            "! ";
                        }
                        else {
                            "+ ";
                        }) + edit::Line::text + "\n"));
                    }
                }
            }
        }
        values = [
            DiffListValues(origin: left.value(), reverse: true).values().join(""),
            DiffListValues(origin: right.value(), reverse: true).values().join("")
        ];
    }

    values() is @string {
        values;
    }
}

// Diff compares two sequences of lines, once, and answers in several forms.
//
//     let changes = Diff(left: before, right: after);
//     changes.unified();              // unified text, 3 lines of context
//     changes.unified(1);
//     changes.contextual();           // the context format
//     changes.ratio();                // 0.0 .. 1.0, as difflib's ratio()
//     for changes.edits() -> edit {
//         edit::Line::kind;           // equal, removed or added
//     }
//
// Equal inputs print as "". Context is 0..64 lines. A comparison that would
// exceed the work budget throws DiffLimitExceeded.
object Diff {
    has left, right is Sequencing<string>;

    Diff(left is Sequencing<string>, right is Sequencing<string>) {
        self.left = left;
        self.right = right;
    }

    // Every line of both sides, in order: kept, removed or added.
    edits() is @DiffEdit {
        self.script().edits();
    }

    unified() is string {
        self.unified(3);
    }

    unified(context is int) is string {
        confirm context >= 0 && context <= 64
            else throw InvalidDiff.because("context must be 0..64");
        DiffPrinting(script: self.script(), context: context).string(false);
    }

    contextual() is string {
        self.contextual(3);
    }

    contextual(context is int) is string {
        confirm context >= 0 && context <= 64
            else throw InvalidDiff.because("context must be 0..64");
        DiffPrinting(script: self.script(), context: context).string(true);
    }

    // Twice the matched lines over all lines: 1.0 when equal, 0.0 when
    // nothing matches.
    ratio() is float {
        let script = self.script();
        let size = script.left_size() + script.right_size();
        let blocks = MatchingBlocks(script).values();
        let matched = (0..blocks.size()).reduce(0) -> sum, index {
            sum + blocks.item(index).size();
        };
        if size == 0 {
            1.0;
        }
        else {
            (2 * matched).float() / size.float();
        }
    }

    hidden script() is DiffScript {
        memo let script = DiffScript(left: left, right: right);
        script;
    }
}

test "unchanged lines have no diff" {
    test.is(Diff(left: ["same"], right: ["same"]).unified(), "");
}

test "one comparison answers in unified and context form" {
    let changes = Diff(left: ["a", "b", "c", "d"], right: ["a", "x", "c", "d", "e"]);
    test.is(changes.unified(), "--- left\n+++ right\n@@ -1,4 +1,5 @@\n a\n-b\n+x\n c\n d\n+e\n");
    test.is(changes.unified(0), "--- left\n+++ right\n@@ -2 +2 @@\n-b\n+x\n@@ -4,0 +5 @@\n+e\n");
    test.is(
        changes.contextual(),
        "*** left\n--- right\n***************\n*** 1,4 ****\n  a\n! b\n  c\n  d\n--- 1,5 ----\n  a\n! x\n  c\n  d\n+ e\n",
    );
    test.throws(InvalidDiff) {
        changes.unified(65);
    };
    test.throws(InvalidDiff) {
        changes.contextual(-1);
    };
}

test "the ratio is twice the matched lines over all lines" {
    test.is(Diff(left: ["a", "b", "c", "d"], right: ["a", "x", "c", "d", "e"]).ratio(), 2.0 / 3.0);
    test.is(Diff(left: ["a"], right: ["a"]).ratio(), 1.0);
    test.is(Diff(left: ["a"], right: ["b"]).ratio(), 0.0);
    let nothing is @string = [];
    test.is(Diff(left: nothing, right: nothing).ratio(), 1.0);
    test.is(Diff(left: nothing, right: ["a"]).unified(), "--- left\n+++ right\n@@ -0,0 +1 @@\n+a\n");
}

test "edits walk both sides in order with their indexes" {
    let edits = Diff(left: ["a", "b"], right: ["b", "c"]).edits();
    let shown is @string = edits.map() -> edit {
        let mark = if edit::Line::kind == DiffEditKind.equal {
            "=";
        }
        else if edit::Line::kind == DiffEditKind.removed {
            "-";
        }
        else {
            "+";
        };
        mark + edit::Line::text + edit::Line::left.string() + edit::Line::right.string();
    };
    test.is(shown, ["-a00", "=b10", "+c21"]);
}
