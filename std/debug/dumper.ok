module debug/dumper v1.0.0;

import "runtime/debug" take data_kind, data_type, data_size, data_leaf, data_names, data_keys, data_items;

// Detailed dump of any value for debugging, after Perl's Data::Printer:
// its type, size and everything inside — object fields (private ones too),
// array elements, map pairs — indented by nesting.
//
//     let dump = Dumper(order);
//     dump.type();   // "Order"
//     dump.size();   // 3 (fields)
//     dump.all();    // multi-line dump
//     Dumper(order).max_depth(1).all();   // nested values as `{...}`
//
//     Order {
//         id: 7,
//         lines: @Line (2) [
//             [0] Line {
//                 sku: "A-1",
//                 count: 2
//             },
//             [1] Line {
//                 sku: "B-9",
//                 count: 1
//             }
//         ],
//         status: Status.paid
//     }
//
// Types are runtime types: an empty collection has element type `?`, a
// collection of different types `(A | B)`. Actions, futures and native
// objects are not looked into. The format is for people, not for parsing.
object Dumper {
    has value is any;
    // Deeper levels are shown as `{...}` / `[...]`.
    has depth is int = 8;
    // Longer collections show their first elements and `... N more`.
    has limit is int = 100;

    Dumper(target is any) { value = target; }

    // The same dump looking at most `levels` levels deep (default 8).
    max_depth(levels is int) is ^Dumper { ^depth = levels; }

    // The same dump showing at most `count` elements of a collection (default 100).
    max_items(count is int) is ^Dumper { ^limit = count; }

    // Runtime type: `Point`, `Box<int>`, `@int`, `%string:int`, `string`.
    type() is string { data_type(value); }

    // Category: int, float, rat, bool, byte, char, string, enum, array, map,
    // object, action, future, failure, native.
    kind() is string { data_kind(value); }

    // Elements of an array or map, characters of a string, fields of an
    // object; 0 for other values.
    size() is int { data_size(value); }

    // Field names of an object, in declaration order; empty for other values.
    fields() is @string { data_names(value); }

    // Everything as a multi-line dump; a single value with its type.
    all() is string {
        let category = data_kind(value);
        if category == "array" || category == "map" || category == "object" {
            return self.render(value, "", 0);
        }
        let text = data_leaf(value);
        if category == "string" {
            return text + " (string, " + data_size(value).string() + " chars)";
        }
        text + " (" + data_type(value) + ")";
    }

    render(item is any, indent is string, level is int) is string {
        let category = data_kind(item);
        if category == "array" { return self.array(item, indent, level); }
        if category == "map" { return self.map(item, indent, level); }
        if category == "object" { return self.object(item, indent, level); }
        data_leaf(item);
    }

    array(item is any, indent is string, level is int) is string {
        let count = data_size(item);
        let head = data_type(item) + " (" + count.string() + ")";
        if count == 0 { return head + " []"; }
        if level >= depth { return head + " [...]"; }
        let inner = indent + "    ";
        let parts = data_items(item);
        let shown = if count > limit { limit; } else { count; };
        let lines is @string = (0..shown).map() -> index {
            inner + "[" + index.string() + "] " + self.render(parts[index], inner, level + 1);
        };
        head + " [\n" + lines.join(",\n") + self.more(count, shown, inner) + "\n" + indent + "]";
    }

    map(item is any, indent is string, level is int) is string {
        let count = data_size(item);
        let head = data_type(item) + " (" + count.string() + ")";
        if count == 0 { return head + " {}"; }
        if level >= depth { return head + " {...}"; }
        let inner = indent + "    ";
        let keys = data_keys(item);
        let parts = data_items(item);
        let shown = if count > limit { limit; } else { count; };
        let lines is @string = (0..shown).map() -> index {
            inner + data_leaf(keys[index]) + ": " + self.render(parts[index], inner, level + 1);
        };
        head + " {\n" + lines.join(",\n") + self.more(count, shown, inner) + "\n" + indent + "}";
    }

    object(item is any, indent is string, level is int) is string {
        let head = data_type(item);
        let names = data_names(item);
        let count = names.size();
        if count == 0 { return head + " {}"; }
        if level >= depth { return head + " {...}"; }
        let inner = indent + "    ";
        let parts = data_items(item);
        let lines is @string = (0..count).map() -> index {
            inner + names[index] + ": " + self.render(parts[index], inner, level + 1);
        };
        head + " {\n" + lines.join(",\n") + "\n" + indent + "}";
    }

    more(count is int, shown is int, inner is string) is string {
        if count > shown { return ",\n" + inner + "... " + (count - shown).string() + " more"; }
        "";
    }
}

test "type, kind and size describe the value" {
    test.is(Dumper(42).type(), "int");
    test.is(Dumper("héllo").size(), 5);
    test.is(Dumper([1, 2, 3]).type(), "@int");
    test.is(Dumper([1, 2, 3]).size(), 3);
    test.is(Dumper(["a": 1]).type(), "%string:int");
    test.is(Dumper(["a": 1]).kind(), "map");
    let mixed is @any = [1, "two"];
    test.is(Dumper(mixed).type(), "@(int | string)");
    let empty is @string = [];
    test.is(Dumper(empty).type(), "@?");
    test.is(Dumper(Dumper(1)).type(), "Dumper");
    test.is(Dumper(Dumper(1)).fields().join(","), "value,depth,limit");
}

test "all shows nested values with indices, keys and fields" {
    test.is(Dumper(42).all(), "42 (int)");
    test.is(Dumper("ab").all(), "\"ab\" (string, 2 chars)");
    test.is(Dumper([[1], [2, 3]]).all(), "@@int (2) [\n    [0] @int (1) [\n        [0] 1\n    ],\n    [1] @int (2) [\n        [0] 2,\n        [1] 3\n    ]\n]");
    test.is(Dumper(["b": true, "a": false]).all(), "%string:bool (2) {\n    \"a\": false,\n    \"b\": true\n}");
    test.is(Dumper(Dumper('x')).all(), "Dumper {\n    value: 'x',\n    depth: 8,\n    limit: 100\n}");
}

test "depth and item limits shorten big values" {
    test.is(Dumper([[1], [2]]).max_depth(1).all(), "@@int (2) [\n    [0] @int (1) [...],\n    [1] @int (1) [...]\n]");
    test.is(Dumper([1, 2, 3]).max_items(1).all(), "@int (3) [\n    [0] 1,\n    ... 2 more\n]");
}
