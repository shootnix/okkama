module strings/parse v1.0.0;

// Strict projections from textual spellings to builtin scalar values.
// Constructors never trim whitespace and never accept a leading `+`.
//
//     value ParsedInt("42");            // decimal by default
//     value ParsedInt("ff", 16);        // 255
//     value ParsedInt("0xFF", 0);       // base 0 detects prefixes
//     value ParsedByte("11111111", 2);  // byte(255)
//     string value ParsedRat("6/8");    // "3/4"
//
// Explicit bases span 2..36. Only base 0 recognizes 0b/0B, 0o/0O and
// 0x/0X. ParsedRat accepts an integer or `numerator/positive-denominator`.
// Errors retain the exact, unmodified source string.

object ParsedInt {
    has source is string;
    has radix is int;

    ParsedInt(origin is string) {
        source = origin;
        radix = 10;

        confirm self.source.length() > 0 && self.source != "-"
            else throw InvalidInteger(self.source);
        confirm self.radix == 0 || (self.radix >= 2 && self.radix <= 36)
            else throw InvalidInteger(self.source);
    }

    ParsedInt(origin is string, base is int) {
        source = origin;
        radix = base;

        confirm self.source.length() > 0 && self.source != "-"
            else throw InvalidInteger(self.source);
        confirm self.radix == 0 || (self.radix >= 2 && self.radix <= 36)
            else throw InvalidInteger(self.source);
    }

    #projected
    value() is int {
        let negative is bool = source.slice(0, 1) == "-";
        let offset is int = if negative { 1; } else { 0; };
        let prefix is string = if offset + 2 <= source.length() {
            source.slice(offset, offset + 2);
        }
        else {
            "";
        };
        let prefixed is bool = radix == 0 && match prefix {
            case "0b", "0B", "0o", "0O", "0x", "0X" { true; }
            else { false; }
        };
        let base is int = if radix != 0 {
            radix;
        }
        else {
            match prefix {
                case "0b", "0B" { 2; }
                case "0o", "0O" { 8; }
                case "0x", "0X" { 16; }
                else { 10; }
            }
        };
        let start is int = if prefixed { offset + 2; } else { offset; };
        confirm start < source.length()
            else throw InvalidInteger(source);
        let magnitude is int = (start..source.length())
            .reduce(0) -> result, index {
                result * base + self.digit(index, base);
            };

        if negative {
            -magnitude;
        }
        else {
            magnitude;
        }
    }

    test "parses integer spellings" {
        test.is(value ParsedInt("0"), 0);
        test.is(value ParsedInt("42"), 42);
        test.is(value ParsedInt("-42"), -42);
        test.is(value ParsedInt("0042"), 42);
        test.is(value ParsedInt("ff", 16), 255);
        test.is(value ParsedInt("Z", 36), 35);
        test.is(value ParsedInt("0b101010", 0), 42);
        test.is(value ParsedInt("-0X2A", 0), -42);
    }

    test "rejects non-integer spellings" {
        for ["", "-", "+1", "1.0", " 1", "1 ", "12x"] -> invalid {
            try {
                value ParsedInt(invalid);
                test.fail("invalid integer was accepted: " + invalid);
            }
            catch error is InvalidInteger {
                test.is(error.source(), invalid);
            }
        }
    }

    private:

    digit(index is int, base is int) is int {
        let symbol is string = source.slice(index, index + 1);

        let result is int = match symbol {
            case "0" { 0; }
            case "1" { 1; }
            case "2" { 2; }
            case "3" { 3; }
            case "4" { 4; }
            case "5" { 5; }
            case "6" { 6; }
            case "7" { 7; }
            case "8" { 8; }
            case "9" { 9; }
            case "a", "A" { 10; }
            case "b", "B" { 11; }
            case "c", "C" { 12; }
            case "d", "D" { 13; }
            case "e", "E" { 14; }
            case "f", "F" { 15; }
            case "g", "G" { 16; }
            case "h", "H" { 17; }
            case "i", "I" { 18; }
            case "j", "J" { 19; }
            case "k", "K" { 20; }
            case "l", "L" { 21; }
            case "m", "M" { 22; }
            case "n", "N" { 23; }
            case "o", "O" { 24; }
            case "p", "P" { 25; }
            case "q", "Q" { 26; }
            case "r", "R" { 27; }
            case "s", "S" { 28; }
            case "t", "T" { 29; }
            case "u", "U" { 30; }
            case "v", "V" { 31; }
            case "w", "W" { 32; }
            case "x", "X" { 33; }
            case "y", "Y" { 34; }
            case "z", "Z" { 35; }
            else {
                throw InvalidInteger(source);
            }
        };
        confirm result < base else throw InvalidInteger(source);
        result;
    }
}

object ParsedFloat {
    has source is string;

    ParsedFloat(origin is string) {
        source = origin;

        confirm self.source.length() > 0 && self.source != "-"
            else throw InvalidFloat(self.source);
    }

    #projected
    value() is float {
        let negative is bool = source.slice(0, 1) == "-";
        let offset is int = if negative { 1; } else { 0; };
        let decimal is int = self.decimal(offset);

        if decimal == -1 {
            try {
                let res is int = value ParsedInt(source);
                res.float();
            }
            catch error is InvalidInteger {
                throw InvalidFloat(source);
            }
        }
        else {
            confirm decimal > offset && decimal + 1 < source.length()
                else throw InvalidFloat(source);

            let whole is float = self.digits(offset, decimal);
            let fraction is float = self.digits(decimal + 1, source.length());
            let divisor is float = ((decimal + 1)..source.length())
                .reduce(1.0) -> result, index {
                    result * 10.0;
                };
            let magnitude is float = whole + fraction / divisor;

            if negative {
                -magnitude;
            }
            else {
                magnitude;
            }
        }
    }

    test "parses float spellings" {
        test.is(value ParsedFloat("0.0"), 0.0);
        test.is(value ParsedFloat("42"), 42.0);
        test.is(value ParsedFloat("255"), 255.0);
        test.is(value ParsedFloat("42.5"), 42.5);
        test.is(value ParsedFloat("-42.5"), -42.5);
        test.is(value ParsedFloat("001.050"), 1.05);
        test.is(value ParsedFloat("42"), 42.0);
        test.is(value ParsedFloat("255"), 255.0);
    }

    test "rejects non-float spellings" {
        for ["", "-", ".5", "1.", "+1.0", "1.2.3", "1e3", " 1.0", "1.0 "] -> invalid {
            try {
                value ParsedFloat(invalid);
                test.fail("invalid float was accepted: " + invalid);
            }
            catch error is InvalidFloat {
                test.is(error.source(), invalid);
            }
        }
    }

    private:

    decimal(offset is int) is int {
        (offset..source.length()).reduce(-1) -> found, index {
            if source.slice(index, index + 1) == "." {
                confirm found == -1 else throw InvalidFloat(source);
                index;
            }
            else {
                found;
            }
        };
    }

    digits(start is int, end is int) is float {
        (start..end).reduce(0.0) -> result, index {
            result * 10.0 + self.digit(index);
        };
    }

    digit(index is int) is float {
        let symbol is string = source.slice(index, index + 1);

        match symbol {
            case "0" { 0.0; }
            case "1" { 1.0; }
            case "2" { 2.0; }
            case "3" { 3.0; }
            case "4" { 4.0; }
            case "5" { 5.0; }
            case "6" { 6.0; }
            case "7" { 7.0; }
            case "8" { 8.0; }
            case "9" { 9.0; }

            else {
                throw InvalidFloat(source);
            }
        }
    }
}

object ParsedRat {
    has source is string;

    ParsedRat(origin is string) {
        source = origin;

        confirm self.source.length() > 0
            else throw InvalidRational(self.source);
    }

    #projected
    value() is rat {
        let parts is @string = source.split("/");
        confirm parts.size() == 1 || parts.size() == 2
            else throw InvalidRational(source);

        try {
            let numerator is int = value ParsedInt(parts[0]);
            let denominator is int = if parts.size() == 1 {
                1;
            }
            else {
                value ParsedInt(parts[1]);
            };
            confirm denominator > 0
                else throw InvalidRational(source);
            rat(numerator, denominator);
        }
        catch error is InvalidInteger {
            throw InvalidRational(source);
        }
    }

    test "parses rational spellings" {
        test.is((value ParsedRat("42")).string(), "42");
        test.is((value ParsedRat("6/8")).string(), "3/4");
        test.is((value ParsedRat("-6/8")).string(), "-3/4");
    }

    test "rejects non-rational spellings" {
        for ["", "/", "1/", "/2", "1/0", "1/-2", "+1/2", " 1/2", "1/2 "] -> invalid {
            try {
                value ParsedRat(invalid);
                test.fail("invalid rational was accepted: " + invalid);
            }
            catch error is InvalidRational {
                test.is(error.source(), invalid);
            }
        }
    }
}

object ParsedBool {
    has source is string;

    ParsedBool(origin is string) {
        source = origin;
    }

    #projected
    value() is bool {
        match source {
            case "true" { true; }
            case "false" { false; }
            else {
                throw InvalidBoolean(source);
            }
        }
    }

    test "parses boolean spellings" {
        test.is(value ParsedBool("true"), true);
        test.is(value ParsedBool("false"), false);
    }

    test "rejects non-boolean spellings" {
        for ["", "1", "0", "True", "FALSE", " true", "false "] -> invalid {
            try {
                value ParsedBool(invalid);
                test.fail("invalid boolean was accepted: " + invalid);
            }
            catch error is InvalidBoolean {
                test.is(error.source(), invalid);
            }
        }
    }
}

object ParsedByte {
    has source is string;
    has radix is int;

    ParsedByte(origin is string) {
        source = origin;
        radix = 10;

        confirm self.source.length() > 0 else throw InvalidByte(self.source);
        confirm self.radix == 0 || (self.radix >= 2 && self.radix <= 36)
            else throw InvalidByte(self.source);
    }

    ParsedByte(origin is string, base is int) {
        source = origin;
        radix = base;

        confirm self.source.length() > 0 else throw InvalidByte(self.source);
        confirm self.radix == 0 || (self.radix >= 2 && self.radix <= 36)
            else throw InvalidByte(self.source);
    }

    #projected
    value() is byte {
        let prefix is string = if 2 <= source.length() {
            source.slice(0, 2);
        }
        else {
            "";
        };
        let prefixed is bool = radix == 0 && match prefix {
            case "0b", "0B", "0o", "0O", "0x", "0X" { true; }
            else { false; }
        };
        let base is int = if radix != 0 {
            radix;
        }
        else {
            match prefix {
                case "0b", "0B" { 2; }
                case "0o", "0O" { 8; }
                case "0x", "0X" { 16; }
                else { 10; }
            }
        };
        let start is int = if prefixed { 2; } else { 0; };
        confirm start < source.length()
            else throw InvalidByte(source);
        let integer is int = (start..source.length())
            .reduce(0) -> result, index {
                let digit is int = self.digit(index, base);
                let candidate is int = result * base + digit;
                confirm candidate <= 255
                    else throw InvalidByte(source);
                candidate;
            };

        integer.byte();
    }

    test "parses byte spellings" {
        test.is(value ParsedByte("0"), byte(0));
        test.is(value ParsedByte("255"), byte(255));
        test.is(value ParsedByte("0007"), byte(7));
        test.is(value ParsedByte("000255"), byte(255));
        test.is(value ParsedByte("ff", 16), byte(255));
        test.is(value ParsedByte("0B11111111", 0), byte(255));
    }

    test "rejects invalid byte spellings and bounds" {
        for ["", "-", "-1", "256", "999999999999999999999", "+1", "1.0", " 1", "1 ", "byte"] -> invalid {
            try {
                value ParsedByte(invalid);
                test.fail("invalid byte was accepted: " + invalid);
            }
            catch error is InvalidByte {
                test.is(error.source(), invalid);
            }
        }
    }

    private:

    digit(index is int, base is int) is int {
        let symbol is string = source.slice(index, index + 1);

        let result is int = match symbol {
            case "0" { 0; }
            case "1" { 1; }
            case "2" { 2; }
            case "3" { 3; }
            case "4" { 4; }
            case "5" { 5; }
            case "6" { 6; }
            case "7" { 7; }
            case "8" { 8; }
            case "9" { 9; }
            case "a", "A" { 10; }
            case "b", "B" { 11; }
            case "c", "C" { 12; }
            case "d", "D" { 13; }
            case "e", "E" { 14; }
            case "f", "F" { 15; }
            case "g", "G" { 16; }
            case "h", "H" { 17; }
            case "i", "I" { 18; }
            case "j", "J" { 19; }
            case "k", "K" { 20; }
            case "l", "L" { 21; }
            case "m", "M" { 22; }
            case "n", "N" { 23; }
            case "o", "O" { 24; }
            case "p", "P" { 25; }
            case "q", "Q" { 26; }
            case "r", "R" { 27; }
            case "s", "S" { 28; }
            case "t", "T" { 29; }
            case "u", "U" { 30; }
            case "v", "V" { 31; }
            case "w", "W" { 32; }
            case "x", "X" { 33; }
            case "y", "Y" { 34; }
            case "z", "Z" { 35; }
            else {
                throw InvalidByte(source);
            }
        };
        confirm result < base else throw InvalidByte(source);
        result;
    }
}

object InvalidInteger does Error {
    has source is string;

    InvalidInteger(str is string) {
        self.source = str;
    }

    source() is string {
        source;
    }

    #projected
    text() is string {
        "invalid integer: " + source;
    }
}

object InvalidFloat does Error {
    has source is string;

    InvalidFloat(str is string) {
        self.source = str;
    }

    source() is string {
        source;
    }

    #projected
    text() is string {
        "invalid float: " + source;
    }
}

object InvalidRational does Error {
    has source is string;

    InvalidRational(str is string) {
        self.source = str;
    }

    source() is string {
        source;
    }

    #projected
    text() is string {
        "invalid rational: " + source;
    }
}

object InvalidBoolean does Error {
    has source is string;

    InvalidBoolean(str is string) {
        self.source = str;
    }

    source() is string {
        source;
    }

    #projected
    text() is string {
        "invalid boolean: " + source;
    }
}

object InvalidByte does Error {
    has source is string;

    InvalidByte(str is string) {
        self.source = str;
    }

    source() is string {
        source;
    }

    #projected
    text() is string {
        "invalid byte: " + source;
    }
}
