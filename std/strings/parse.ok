module strings/parse v1.0.0;

// Strict readings of numbers and truth values written as text. Nothing is
// trimmed and a leading `+` is never accepted.
//
//     Number("42").int();             // 42
//     Number("ff").int(16);           // 255
//     Number("0x2A").int(0);          // base 0 reads the 0b, 0o and 0x prefixes
//     Number("11111111").byte(2);     // byte 255
//     Number("6/8").rat().string();   // "3/4"
//     Number("-42.5").float();        // -42.5
//     Truth("true").bool();           // true
//
// Explicit bases span 2..36. A rational is an integer or
// `numerator/positive-denominator`. Errors keep the exact source text.

import "runtime/number_text" take int_parse_valid, int_parse;

// A number written as text, read as the type asked for.
object Number {
    has source is string;

    Number(origin is string) {
        source = origin;
    }

    int(base is int = 10) is int {
        confirm source.length() > 0
            && source != "-"
            && (base == 0 || (base >= 2 && base <= 36))
            && int_parse_valid(source, base)
            else throw InvalidInteger.source(source);
        int_parse(source, base);
    }

    float() is float {
        confirm source.length() > 0 && source != "-" else throw InvalidFloat.source(source);
        let negative is bool = source.slice(0, 1) == "-";
        let offset is int = if negative {
            1;
        }
        else {
            0;
        };
        let decimal is int = self.point(offset);

        if decimal == -1 {
            try {
                let res is int = self.int();
                res.float();
            }
            catch error is InvalidInteger {
                throw InvalidFloat.source(source);
            }
        }
        else {
            confirm decimal > offset && decimal + 1 < source.length()
                else throw InvalidFloat.source(source);

            let whole is float = self.decimal_run(offset, decimal);
            let fraction is float = self.decimal_run(decimal + 1, source.length());
            let divisor is float = ((decimal + 1)..source.length())
                .reduce(1.0) -> result, index {
                    result * 10.0;
                };
            let magnitude is float = whole + fraction / divisor;

            if negative {
                -magnitude;
            }
            else {
                magnitude;
            }
        }
    }

    rat() is rat {
        confirm source.length() > 0 else throw InvalidRational.source(source);
        let parts is @string = source.split("/");
        confirm parts.size() == 1 || parts.size() == 2
            else throw InvalidRational.source(source);

        try {
            let numerator is int = Number(parts[0]).int();
            let denominator is int = if parts.size() == 1 {
                1;
            }
            else {
                Number(parts[1]).int();
            };
            confirm denominator > 0
                else throw InvalidRational.source(source);
            rat(numerator, denominator);
        }
        catch error is InvalidInteger {
            throw InvalidRational.source(source);
        }
    }

    byte(base is int = 10) is byte {
        confirm source.length() > 0 && (base == 0 || (base >= 2 && base <= 36))
            else throw InvalidByte.source(source);
        let prefix is string = if 2 <= source.length() {
            source.slice(0, 2);
        }
        else {
            "";
        };
        let prefixed is bool = base == 0
            && match prefix {
                case "0b", "0B", "0o", "0O", "0x", "0X" {
                    true;
                }
                else {
                    false;
                }
            };
        let radix is int = if base != 0 {
            base;
        }
        else {
            match prefix {
                case "0b", "0B" {
                    2;
                }
                case "0o", "0O" {
                    8;
                }
                case "0x", "0X" {
                    16;
                }
                else {
                    10;
                }
            }
        };
        let start is int = if prefixed {
            2;
        }
        else {
            0;
        };
        confirm start < source.length()
            else throw InvalidByte.source(source);
        let integer is int = (start..source.length())
            .reduce(0) -> result, index {
                let digit is int = self.digit(index, radix);
                let candidate is int = result * radix + digit;
                confirm candidate <= 255
                    else throw InvalidByte.source(source);
                candidate;
            };

        integer.byte();
    }

    test "reads integer spellings" {
        test.is(Number("0").int(), 0);
        test.is(Number("42").int(), 42);
        test.is(Number("-42").int(), -42);
        test.is(Number("0042").int(), 42);
        test.is(Number("ff").int(16), 255);
        test.is(Number("Z").int(36), 35);
        test.is(Number("0b101010").int(0), 42);
        test.is(Number("-0X2A").int(0), -42);
    }

    test "rejects non-integer spellings and bases" {
        for ["", "-", "+1", "1.0", " 1", "1 ", "12x"] -> invalid {
            test.is(
                try {
                    Number(invalid).int();
                    "accepted";
                }
                catch InvalidInteger.source(source) {
                    source;
                },
                invalid
            );
        }
        test.is(
            try {
                Number("1").int(37);
                "accepted";
            }
            catch InvalidInteger.source(source) {
                source;
            },
            "1"
        );
    }

    test "reads float spellings" {
        test.is(Number("0.0").float(), 0.0);
        test.is(Number("42").float(), 42.0);
        test.is(Number("42.5").float(), 42.5);
        test.is(Number("-42.5").float(), -42.5);
        test.is(Number("001.050").float(), 1.05);
    }

    test "rejects non-float spellings" {
        for ["", "-", ".5", "1.", "+1.0", "1.2.3", "1e3", " 1.0", "1.0 "] -> invalid {
            test.is(
                try {
                    Number(invalid).float();
                    "accepted";
                }
                catch InvalidFloat.source(source) {
                    source;
                },
                invalid
            );
        }
    }

    test "reads rational spellings" {
        test.is(Number("42").rat().string(), "42");
        test.is(Number("6/8").rat().string(), "3/4");
        test.is(Number("-6/8").rat().string(), "-3/4");
    }

    test "rejects non-rational spellings" {
        for ["", "/", "1/", "/2", "1/0", "1/-2", "+1/2", " 1/2", "1/2 "] -> invalid {
            test.is(
                try {
                    Number(invalid).rat();
                    "accepted";
                }
                catch InvalidRational.source(source) {
                    source;
                },
                invalid
            );
        }
    }

    test "reads byte spellings" {
        test.is(Number("0").byte(), byte(0));
        test.is(Number("255").byte(), byte(255));
        test.is(Number("0007").byte(), byte(7));
        test.is(Number("000255").byte(), byte(255));
        test.is(Number("ff").byte(16), byte(255));
        test.is(Number("0B11111111").byte(0), byte(255));
    }

    test "rejects invalid byte spellings and bounds" {
        for ["", "-", "-1", "256", "999999999999999999999", "+1", "1.0", " 1", "1 ", "byte"] -> invalid {
            test.is(
                try {
                    Number(invalid).byte();
                    "accepted";
                }
                catch InvalidByte.source(source) {
                    source;
                },
                invalid
            );
        }
    }

    hidden point(offset is int) is int {
        (offset..source.length()).reduce(-1) -> found, index {
            if source.slice(index, index + 1) == "." {
                confirm found == -1 else throw InvalidFloat.source(source);
                index;
            }
            else {
                found;
            }
        };
    }

    hidden decimal_run(start is int, end is int) is float {
        (start..end).reduce(0.0) -> result, index {
            result * 10.0 + self.decimal_digit(index);
        };
    }

    hidden decimal_digit(index is int) is float {
        let symbol is string = source.slice(index, index + 1);

        match symbol {
            case "0" {
                0.0;
            }
            case "1" {
                1.0;
            }
            case "2" {
                2.0;
            }
            case "3" {
                3.0;
            }
            case "4" {
                4.0;
            }
            case "5" {
                5.0;
            }
            case "6" {
                6.0;
            }
            case "7" {
                7.0;
            }
            case "8" {
                8.0;
            }
            case "9" {
                9.0;
            }

            else {
                throw InvalidFloat.source(source);
            }
        }
    }

    hidden digit(index is int, base is int) is int {
        let symbol is string = source.slice(index, index + 1);

        let result is int = match symbol {
            case "0" {
                0;
            }
            case "1" {
                1;
            }
            case "2" {
                2;
            }
            case "3" {
                3;
            }
            case "4" {
                4;
            }
            case "5" {
                5;
            }
            case "6" {
                6;
            }
            case "7" {
                7;
            }
            case "8" {
                8;
            }
            case "9" {
                9;
            }
            case "a", "A" {
                10;
            }
            case "b", "B" {
                11;
            }
            case "c", "C" {
                12;
            }
            case "d", "D" {
                13;
            }
            case "e", "E" {
                14;
            }
            case "f", "F" {
                15;
            }
            case "g", "G" {
                16;
            }
            case "h", "H" {
                17;
            }
            case "i", "I" {
                18;
            }
            case "j", "J" {
                19;
            }
            case "k", "K" {
                20;
            }
            case "l", "L" {
                21;
            }
            case "m", "M" {
                22;
            }
            case "n", "N" {
                23;
            }
            case "o", "O" {
                24;
            }
            case "p", "P" {
                25;
            }
            case "q", "Q" {
                26;
            }
            case "r", "R" {
                27;
            }
            case "s", "S" {
                28;
            }
            case "t", "T" {
                29;
            }
            case "u", "U" {
                30;
            }
            case "v", "V" {
                31;
            }
            case "w", "W" {
                32;
            }
            case "x", "X" {
                33;
            }
            case "y", "Y" {
                34;
            }
            case "z", "Z" {
                35;
            }
            else {
                throw InvalidByte.source(source);
            }
        };
        confirm result < base else throw InvalidByte.source(source);
        result;
    }
}

// A truth value written as text: exactly "true" or "false".
object Truth {
    has source is string;

    Truth(origin is string) {
        source = origin;
    }

    bool() is bool {
        match source {
            case "true" {
                true;
            }
            case "false" {
                false;
            }
            else {
                throw InvalidBoolean.source(source);
            }
        }
    }

    test "reads truth spellings" {
        test.is(Truth("true").bool(), true);
        test.is(Truth("false").bool(), false);
        for ["", "1", "0", "True", "FALSE", " true", "false "] -> invalid {
            test.is(
                try {
                    Truth(invalid).bool();
                    "accepted";
                }
                catch InvalidBoolean.source(source) {
                    source;
                },
                invalid
            );
        }
    }
}

enum InvalidInteger is Error = (source(source is string));

enum InvalidFloat is Error = (source(source is string));

enum InvalidRational is Error = (source(source is string));

enum InvalidBoolean is Error = (source(source is string));

enum InvalidByte is Error = (source(source is string));
