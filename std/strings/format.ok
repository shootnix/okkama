module strings/format v1.0.0;

// Exact, typed interpolation: only {} denotes a slot; other braces are literal.
//
//     Formatted("{} version {}", id, id.version()).string();
//     out.writeln(Formatted("{} of {} done", done, total));
//
// Each value after the pattern is turned into text by its own string(), as
// any `...string` tail does: numbers, bool, char, and objects that answer
// string(). Formatted(pattern:, values:) takes texts already made.

object Formatted {
    has pattern is string;
    has values is @string;

    Formatted(:pattern, :values);

    Formatted(pattern is string, values is ...string) {
        self.pattern = pattern;
        let listed is @string = values...;
        self.values = listed;
    }

    string() is string {
        let parts is @string = pattern.split("{}");
        confirm parts.size() == values.size() + 1 else throw InvalidFormat.invalid;
        (0..values.size()).reduce(parts[0]) -> result, index {
            result + values[index] + parts[index + 1];
        };
    }
}

enum InvalidFormat is Error = (invalid);

test "slots are filled in order and other braces stay" {
    test.is(Formatted(pattern: "{} + {} = {}", values: ["1", "2", "3"]).string(), "1 + 2 = 3");
    test.is(Formatted(pattern: "{x} {}", values: ["a"]).string(), "{x} a");
    test.is(Formatted(pattern: "plain", values: []).string(), "plain");
    test.is(Formatted(pattern: "{}", values: ["{}"]).string(), "{}");
    for [["{} {}", "one"], ["none", "extra"]] -> wrong {
        test.is(
            try {
                Formatted(pattern: wrong[0], values: [wrong[1]]).string();
            }
            catch error is InvalidFormat {
                "invalid";
            },
            "invalid"
        );
    }
}

object FormatProbe {
    FormatProbe();

    string() is string {
        "probe";
    }
}

test "values after the pattern turn into text" {
    test.is(Formatted("{} + {} = {}", 1, 2, 3).string(), "1 + 2 = 3");
    test.is(Formatted("{} is {}, {} and {}", FormatProbe(), true, 1.5, 'x').string(), "probe is true, 1.5 and x");
    test.is(Formatted("plain").string(), "plain");
    test.is(Formatted("{}/{}", 3 / 4, "s").string(), "3/4/s");
}
