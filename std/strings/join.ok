module strings/join v1.0.0;

import "collections/iteration" take Iterating;
import "collections/list" take List, EmptyList;

// A bounded snapshot of strings and their literal separator.
// Construction traverses the source once; string() observes only the snapshot.
object Joined {
    has snapshot is JoinedParts;

    Joined(separator is string, values is Iterating<string>) {
        snapshot = values.reduce(JoinedParts(separator: separator, maximum_items: 10000, maximum_length: 1048576)) -> parts, value {
            parts.following(value);
        };
    }

    Joined(
        separator is string,
        values is Iterating<string>,
        maximum_items is int,
        maximum_length is int
    ) {
        confirm maximum_items >= 0 && maximum_length >= 0 else throw InvalidJoinLimits.invalid;
        snapshot = values.reduce(JoinedParts(separator: separator, maximum_items: maximum_items, maximum_length: maximum_length)) -> parts, value {
            parts.following(value);
        };
    }

    string() is string {
        snapshot.string();
    }
}

// Importable immutable snapshot collaborator; no module-private declarations.
object JoinedParts {
    has separator is string;
    has maximum_items, maximum_length is int;
    has used is int = 0;
    has values is List<string>;

    JoinedParts(separator is string, maximum_items is int, maximum_length is int) {
        confirm maximum_items >= 0 && maximum_length >= 0 else throw InvalidJoinLimits.invalid;
        self.separator = separator;
        self.maximum_items = maximum_items;
        self.maximum_length = maximum_length;
        let empty is List<string> = EmptyList();
        values = empty;
    }

    following(value is string) is ^JoinedParts {
        confirm values.size() < maximum_items else throw JoinLimitExceeded.kind(JoinLimit.items);
        let gap = if values.size() > 0 {
            separator.length();
        }
        else {
            0;
        };
        confirm gap <= maximum_length - used else throw JoinLimitExceeded.kind(JoinLimit.length);
        confirm value.length() <= maximum_length - used - gap
            else throw JoinLimitExceeded.kind(JoinLimit.length);
        ^used = used + gap + value.length();
        ^values = values.prefix(value);
    }

    string() is string {
        let backwards is @string = values.map() -> value {
            value;
        };
        let ordered is @string = (0..backwards.size()).map() -> index {
            backwards[backwards.size() - 1 - index];
        };
        ordered.join(separator);
    }
}

enum JoinLimit = (items, length);

enum InvalidJoinLimits is Error = (invalid);

enum JoinLimitExceeded is Error = (kind(kind is JoinLimit));

test "joined keeps order and its separator" {
    test.is(Joined(separator: ", ", values: ["a", "b", "c"]).string(), "a, b, c");
    test.is(Joined(separator: "-", values: ["only"]).string(), "only");
    let nothing is @string = [];
    test.is(Joined(separator: "-", values: nothing).string(), "");
    test.is(Joined(separator: "", values: ["a", "", "b"]).string(), "ab");
}

test "limits bound the items and the length" {
    test.is(Joined(separator: ",", values: ["ab", "cd"], maximum_items: 2, maximum_length: 5).string(), "ab,cd");
    let refused = (values is @string, items is int, length is int) is string {
        try {
            Joined(separator: ",", values: values, maximum_items: items, maximum_length: length).string();
        }
        catch JoinLimitExceeded.kind(kind) {
            if kind == JoinLimit.items {
                "items";
            }
            else {
                "length";
            }
        }
    };
    test.is(refused(["a", "b", "c"], 2, 100), "items");
    test.is(refused(["ab", "cd"], 5, 4), "length");
    test.is(
        try {
            Joined(separator: ",", values: ["a"], maximum_items: -1, maximum_length: 10).string();
        }
        catch error is InvalidJoinLimits {
            "invalid";
        },
        "invalid"
    );
    let parts = JoinedParts(separator: " ", maximum_items: 3, maximum_length: 20).following("x").following("y");
    test.is(parts.string(), "x y");
}
