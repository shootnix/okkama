module size v1.0.0;

// A role for things that know how many elements they hold.
//
//     let parts is Sizing = buffer.content();
//     parts.size();
//
// Collections, buffers and sequences do it, so code can ask any of them the
// same way.

// Something that knows how many elements it holds.
role Sizing {
    // How many.
    size() is int;
}
