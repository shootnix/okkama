module cli/arguments v1.0.0;

// The process's arguments, as bytes or text.
//
//     let arguments = ProcessArguments().strings();      // without the program name
//     ProcessArguments().first();                        // the first argument's bytes
//
// Arguments are the bytes the system passed, never shell text. At most 4096
// arguments and 1 MiB are read by default.

import "collections/sequence" take Sequencing, EmptySequence;
import "collections/iteration" take Cursor, Iterating;
import "error" take OutOfRange;
import "runtime/process" take process_arguments;
import "encoding/utf" take Utf8Decoded, InvalidUtf8;

// Explicit argv bytes; never shell text. The host supplies the already split
// sequence. Bounded snapshots can outlive a borrowed argument provider.
object ProcessArguments does Sequencing<@byte>, Iterating<@byte> {
    has origin is @@byte;

    // The arguments of this process, at most 4096 and 1 MiB.
    ProcessArguments() {
        origin = ArgumentSnapshot(
            arguments: process_arguments(),
            maximum_arguments: 4096,
            maximum_bytes: 1048576
        ).items();
    }

    // These arguments, for tests.
    ProcessArguments(arguments is Sequencing<@byte>) {
        origin = ArgumentSnapshot(
            arguments: arguments,
            maximum_arguments: 4096,
            maximum_bytes: 1048576
        ).items();
    }

    // These arguments within the limits; ArgumentLimitExceeded beyond.
    ProcessArguments(arguments is Sequencing<@byte>, maximum_arguments is int, maximum_bytes is int) {
        origin = ArgumentSnapshot(
            arguments: arguments,
            maximum_arguments: maximum_arguments,
            maximum_bytes: maximum_bytes
        ).items();
    }

    // Walks the arguments.
    cursor() is Cursor<@byte> {
        origin.cursor();
    }

    // How many.
    size() is int {
        origin.size();
    }

    // The argument at index.
    item(index is int) is @byte {
        confirm index >= 0 && index < origin.size() else throw OutOfRange.because("out of range");
        origin[index];
    }

    // The first argument.
    first() is @byte {
        confirm origin.size() > 0 else throw EmptySequence.empty;
        origin[0];
    }

    // The last argument.
    last() is @byte {
        confirm origin.size() > 0 else throw EmptySequence.empty;
        origin[origin.size() - 1];
    }

    // The arguments as text, read as strict UTF-8. A bad one throws
    // InvalidArgumentEncoding with its index and byte offset.
    strings() is @string {
        (0..origin.size()).map() -> index {
            try {
                Utf8Decoded(origin[index]).string();
            }
            catch InvalidUtf8.at(offset) {
                throw InvalidArgumentEncoding.located(index, offset);
            }
        };
    }
}

hidden object ArgumentSnapshot {
    has origin is @@byte;

    ArgumentSnapshot(arguments is Sequencing<@byte>, maximum_arguments is int, maximum_bytes is int) {
        confirm maximum_arguments >= 0 && maximum_bytes >= 0
            else throw ArgumentLimitExceeded.exceeded;
        let size = arguments.size();
        confirm size >= 0 && size <= maximum_arguments else throw ArgumentLimitExceeded.exceeded;
        let result = (0..size).reduce(ArgumentParts(maximum_bytes)) -> old, index {
            old.added(arguments.item(index));
        };
        origin = result.items();
    }

    items() is @@byte {
        origin;
    }
}

hidden object ArgumentParts {
    has origin is @@byte;
    has remaining is int;

    ArgumentParts(maximum is int) {
        origin = [];
        remaining = maximum;
    }

    added(argument is @byte) is ^ArgumentParts {
        confirm argument.size() <= remaining else throw ArgumentLimitExceeded.exceeded;
        let revised is @@byte = origin + [argument];
        ^origin = revised;
        ^remaining = remaining - argument.size();
    }

    items() is @@byte {
        origin;
    }
}

// An argument that is not UTF-8; index and offset say where.
enum InvalidArgumentEncoding is Error = (located(index is int, offset is int));

// More arguments or bytes than the limits.
enum ArgumentLimitExceeded is Error = (exceeded);

test "argument boundaries do not reinterpret shell text" {
    let result = ProcessArguments([[97.byte(), 32.byte(), 98.byte()], []]).strings();
    test.is(result, ["a b", ""]);
}

test "an argument that is not UTF-8 is refused with its place" {
    test.ok(try {
        ProcessArguments([[97.byte()], [98.byte(), 255.byte()]]).strings();
        false;
    }
    catch InvalidArgumentEncoding.located(index, offset) {
        index == 1 && offset == 1;
    });
    test.throws(ArgumentLimitExceeded) {
        ProcessArguments(
            arguments: [[97.byte()], [98.byte()]],
            maximum_arguments: 1,
            maximum_bytes: 10
        );
    };
}
