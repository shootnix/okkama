module cli/parse v1.0.0;
import "collections/sequence" take Sequencing;
import "async/atomic" take Atomic;
import "cli/spec" take CliCommand,Option,Flag,OperandCardinality;
import "config/key" take SettingKey;
import "config/source" take Settings,SettingEntry,SettingOverlay,SettingSource,SettingSourceKind;
import "compare" take Order;
import "strings/parse" take ParsedFloat;

// Parsing is repeatable and has no I/O. Branch commands accept options then one
// child name; leaves accept options and operands. Ancestor aliases cease to be
// recognized after selecting a child. -- affects the remaining complete argv.
object ParsedCommand{
    has origin is CliCommand;
    has arguments is @string;
    ParsedCommand(origin is CliCommand,arguments is Sequencing<string>){
        let size=arguments.size();
        confirm size>=0 && size<=4096 else throw CliFailure(0,"","argument count budget");
        let snapshot is @string=(0..size).map()->index{arguments.item(index);};
        let length=snapshot.reduce(0)->used,value{used+value.length();};
        confirm length<=1048576 else throw CliFailure(0,"","argument text budget");
        self.origin=origin;self.arguments=snapshot;
    }
    #projected
    value() is Invocation{CliParsing(origin,arguments).value();}
}
object Invocation{
    has selected is CliCommand;
    has names is @string;
    has entries is Settings;
    Invocation(command is CliCommand,path is @string,settings is Settings){selected=command;names=path;entries=settings;}
    command() is CliCommand{selected;}
    path() is Sequencing<string>{names;}
    settings() is Settings{entries;}
}
object CliOperandToken{
    has token is string;
    has index is int;
    CliOperandToken(token is string,index is int){self.token=token;self.index=index;}
    token() is string{token;}
    index() is int{index;}
}
object CliParsing{
    has command is Atomic<CliCommand>;
    has path is Atomic<@string>;
    has position is Atomic<int>;
    has literal is Atomic<bool>;
    has operands is Atomic<@CliOperandToken>;
    has entries is Atomic<SettingOverlay>;
    has arguments is @string;
    has source is SettingSource;
    CliParsing(origin is CliCommand,arguments is @string){
        command=Atomic(origin);path=Atomic([origin.name()]);position=Atomic(0);literal=Atomic(false);
        let empty is @CliOperandToken=[];operands=Atomic(empty);entries=Atomic(SettingOverlay());
        self.arguments=arguments;source=SettingSource(SettingSourceKind.command_line,"argv");
    }
    value() is Invocation{
        loop{
            let at=position.value();
            if at>=arguments.size(){last;}
            let token=arguments[at];
            if !literal.value() && token=="--"{literal.replace(true);position.replace(at+1);next;}
            if !literal.value() && token.length()>1 && token.slice(0,1)=="-"{
                self.option(token,at);
            }else{self.operand(token,at);}
        }
        confirm command.value().children().size()==0 else throw CliFailure(arguments.size(),"","child command required");
        self.finish_operands();
        Invocation(command.value(),path.value(),Settings(entries.value().entries()));
    }
    private:
    option_index(name is string) is int{command.value().syntax().option_index(name);}
    flag_index(name is string) is int{command.value().syntax().flag_index(name);}
    option(token is string,at is int) is void{
        if token.slice(0,2)=="--"{
            let name=token.split("=").first();
            let option=self.option_index(name);let flag=self.flag_index(name);
            if option>=0{
                let descriptor=command.value().syntax().options().item(option);
                if token.length()>name.length(){
                    self.value_option(descriptor,token.slice(name.length()+1,token.length()),at);
                    position.replace(at+1);
                }else{self.following_value(descriptor,at);}
            }else if flag>=0{
                confirm token==name else throw CliFailure(at,token,"flags cannot take a value");
                self.flag(command.value().syntax().flags().item(flag));position.replace(at+1);
            }else{throw CliFailure(at,token,"unknown option");}
        }else{
            let exact_option=self.option_index(token);let exact_flag=self.flag_index(token);
            if exact_option>=0{self.following_value(command.value().syntax().options().item(exact_option),at);}
            else if exact_flag>=0{self.flag(command.value().syntax().flags().item(exact_flag));position.replace(at+1);}
            else if try{ParsedFloat(token).value();true;}catch e is Error{false;}{self.operand(token,at);}
            else{
                position.replace(at+1);
                for (1..token.length())->index{
                    let name="-"+token.slice(index,index+1);
                    let option=self.option_index(name);let flag=self.flag_index(name);
                    if option>=0{
                        confirm index==token.length()-1 else throw CliFailure(at,token,"value option must be final in a short cluster");
                        self.following_value(command.value().syntax().options().item(option),at);
                    }else if flag>=0{self.flag(command.value().syntax().flags().item(flag));}
                    else{throw CliFailure(at,token,"unknown short option");}
                }
            }
        }
    }
    following_value(option is Option,at is int) is void{
        confirm at+1<arguments.size() else throw CliFailure(at,arguments[at],"missing option value");
        self.value_option(option,arguments[at+1],at);position.replace(at+2);
    }
    value_option(option is Option,text is string,at is int) is void{
        let old=entries.value();
        if old.membership(option.key()){
            confirm option.value().repeated() else throw CliFailure(at,arguments[at],"scalar option repeated");
            let previous=old.entry(option.key()).values();
            let revised is @string=(0..previous.size()+1).map()->index{
                if index<previous.size(){previous.item(index);}else{text;}
            };
            entries.replace(entries.value().replaced(SettingEntry(option.key(),revised,source)));
        }else{entries.replace(entries.value().replaced(SettingEntry(option.key(),[text],source)));}
    }
    flag(flag is Flag) is void{entries.replace(entries.value().replaced(SettingEntry(flag.key(),[flag.present()],source)));}
    operand(token is string,at is int) is void{
        let children=command.value().children();
        if children.size()>0{
            let found=(0..children.size()).reduce(-1)->old,index{if children.item(index).name()==token{index;}else{old;}};
            confirm found>=0 else throw CliFailure(at,token,"unknown child command");
            let old_path=path.value();
            let revised is @string=(0..old_path.size()+1).map()->index{if index<old_path.size(){old_path[index];}else{token;}};
            path.replace(revised);command.replace(children.item(found));
        }else{
            let old=operands.value();
            let revised is @CliOperandToken=(0..old.size()+1).map()->index{
                if index<old.size(){old[index];}else{CliOperandToken(token,at);}
            };
            operands.replace(revised);
        }
        position.replace(at+1);
    }
    finish_operands() is void{
        let specs=command.value().syntax().operands();let values=operands.value();
        let consumed=Atomic(0);
        for specs->spec{
            let at=consumed.value();
            let remaining=values.size()-at;
            confirm spec.cardinality()!=OperandCardinality.required || remaining>0
                else throw CliFailure(arguments.size(),"","missing required operand: "+spec.name());
            let size=if spec.cardinality()==OperandCardinality.repeated{remaining;}else{if remaining>0{1;}else{0;}};
            if size>0 || spec.cardinality()==OperandCardinality.repeated{
                let texts is @string=(0..size).map()->index{values[at+index].token();};
                entries.replace(entries.value().replaced(SettingEntry(spec.key(),texts,source)));
            }
            consumed.replace(at+size);
        }
        let count=consumed.value();
        if count<values.size(){throw CliFailure(values[count].index(),values[count].token(),"unexpected operand");}
    }
}
object CliFailure does Error{
    has at is int;
    has origin,message is string;
    CliFailure(index is int,token is string,message is string){at=index;origin=token;self.message=message;}
    index() is int{at;}
    token() is string{origin;}
    text() is string{message;}
}
