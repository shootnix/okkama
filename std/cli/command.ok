module cli/command v1.0.0;

import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "collections/iteration" take CursorItems;
import "collections/ordering" take LowerBound, Ranked;
import "compare" take Comparing, Order;
import "async/atomic" take Atomic;
import "config/key" take SettingKey;
import "config/source" take Settings, SettingEntry, SettingOverlay, SettingSource, SettingSourceKind,
    SettingKeyIndex;
import "encoding/utf" take Utf8Encoded;
import "strings/parse" take Number, Truth;
import "terminal/width" take WrappedDisplay, DisplayWidth;

// How many values an operand takes.
enum OperandCount = (required, optional, repeated);

// Specification objects describe syntax, never callbacks or process exits.
// An option, a flag and an operand are named by their long name, without
// dashes; that name also reads them back from an Invocation. A key is needed
// only to layer the command line over configuration (SettingKey([name]) by
// default).

object Option {
    has setting is SettingKey;
    has spellings is @string;
    has long, letter, placeholder, text is string;
    has many is bool;

    Option(
        name is string,
        short is string = "",
        value is string = "VALUE",
        repeated is bool = false,
        help is string = "",
    ) {
        setting = SettingKey([name]);
        spellings = CliSpellings(name: name, short: short).names();
        confirm value != "" else throw InvalidCommandSyntax.because("empty placeholder");
        long = name;
        letter = short;
        placeholder = value;
        many = repeated;
        text = help;
    }

    Option(
        name is string,
        key is SettingKey,
        short is string = "",
        value is string = "VALUE",
        repeated is bool = false,
        help is string = "",
    ) {
        setting = key;
        spellings = CliSpellings(name: name, short: short).names();
        confirm value != "" else throw InvalidCommandSyntax.because("empty placeholder");
        long = name;
        letter = short;
        placeholder = value;
        many = repeated;
        text = help;
    }

    // The option as declared: --name, -short, its value placeholder.
    cap Spec {
        name is string {
            long;
        }

        short is string {
            letter;
        }

        value is string {
            placeholder;
        }

        repeated is bool {
            many;
        }

        help is string {
            text;
        }
    }

    key() is SettingKey {
        setting;
    }

    // The spellings on the command line: "--name" and, if given, "-n".
    names() is @string {
        spellings;
    }
}

object Flag {
    has setting is SettingKey;
    has spellings is @string;
    has long, letter, text is string;

    Flag(name is string, short is string = "", help is string = "") {
        setting = SettingKey([name]);
        spellings = CliSpellings(name: name, short: short).names();
        long = name;
        letter = short;
        text = help;
    }

    Flag(name is string, key is SettingKey, short is string = "", help is string = "") {
        setting = key;
        spellings = CliSpellings(name: name, short: short).names();
        long = name;
        letter = short;
        text = help;
    }

    // The flag as declared.
    cap Spec {
        name is string {
            long;
        }

        short is string {
            letter;
        }

        help is string {
            text;
        }
    }

    key() is SettingKey {
        setting;
    }

    names() is @string {
        spellings;
    }
}

object Operand {
    has setting is SettingKey;
    has label, text is string;
    has amount is OperandCount;

    Operand(name is string, count is OperandCount = OperandCount.required, help is string = "") {
        confirm name != "" else throw InvalidCommandSyntax.because("empty placeholder");
        setting = SettingKey([name]);
        label = name;
        amount = count;
        text = help;
    }

    Operand(
        name is string,
        key is SettingKey,
        count is OperandCount = OperandCount.required,
        help is string = "",
    ) {
        confirm name != "" else throw InvalidCommandSyntax.because("empty placeholder");
        setting = key;
        label = name;
        amount = count;
        text = help;
    }

    // The operand as declared; its name is the placeholder in usage text.
    cap Spec {
        name is string {
            label;
        }

        count is OperandCount {
            amount;
        }

        help is string {
            text;
        }
    }

    key() is SettingKey {
        setting;
    }
}

// The command-line spellings of a long name and an optional short letter.
hidden object CliSpellings {
    has name, short is string;

    CliSpellings(:name, :short);

    names() is @string {
        let long = "--" + name;
        CliOptionName(long);
        if short == "" {
            [long];
        }
        else {
            let letter = "-" + short;
            CliOptionName(letter);
            [long, letter];
        }
    }
}

hidden object CliOptionName {
    CliOptionName(name is string) {
        let bytes = Utf8Encoded(name).bytes();
        confirm bytes.size() >= 2 && bytes.size() <= 128 && bytes[0].int() == 45
            else throw InvalidCommandSyntax.because("option name must start with a dash");
        if bytes[1].int() == 45 {
            confirm bytes.size() > 2 else throw InvalidCommandSyntax.because("-- is reserved");
            for (2..bytes.size()) -> index {
                let code = bytes[index].int();
                confirm (code >= 97 && code <= 122)
                    || (code >= 48 && code <= 57)
                    || (index > 2 && code == 45)
                    else throw InvalidCommandSyntax.because("invalid long option name");
            }
        }
        else {
            confirm bytes.size() == 2 && bytes[1].int() >= 33 && bytes[1].int() <= 126
                else throw InvalidCommandSyntax.because(
                    "short name must be one visible ASCII character"
                );
        }
    }
}

hidden object CommandSyntax {
    has options is @Option;
    has flags is @Flag;
    has operands is @Operand;
    has aliases is CliAliasIndex;

    CommandSyntax(
        options is Sequencing<Option>,
        flags is Sequencing<Flag>,
        operands is Sequencing<Operand>
    ) {
        let option_count = options.size();
        let flag_count = flags.size();
        let operand_count = operands.size();
        confirm option_count >= 0
            && flag_count >= 0
            && operand_count >= 0
            && option_count + flag_count + operand_count <= 1024
            else throw InvalidCommandSyntax.because("syntax declaration budget");
        let options_copy is @Option = (0..option_count).map() -> index {
            options.item(index);
        };
        let flags_copy is @Flag = (0..flag_count).map() -> index {
            flags.item(index);
        };
        let operands_copy is @Operand = (0..operand_count).map() -> index {
            operands.item(index);
        };
        self.options = options_copy;
        self.flags = flags_copy;
        self.operands = operands_copy;
        let validation = CliSyntaxValidation(options: options_copy, flags: flags_copy, operands: operands_copy);
        validation.validate();
        aliases = validation.aliases();
    }

    options() is Sequencing<Option> {
        options;
    }

    flags() is Sequencing<Flag> {
        flags;
    }

    operands() is Sequencing<Operand> {
        operands;
    }

    option_index(name is string) is int {
        let index = aliases.position(name);
        if index >= 0 && index < options.size() {
            index;
        }
        else {
            -1;
        }
    }

    flag_index(name is string) is int {
        let index = aliases.position(name);
        if index >= options.size() {
            index - options.size();
        }
        else {
            -1;
        }
    }
}

// Validation is a separate collaborator, including constructor-time checks.
hidden object CliSyntaxValidation {
    has options is @Option;
    has flags is @Flag;
    has operands is @Operand;
    has lookup is CliAliasIndex;

    CliSyntaxValidation(options is @Option, flags is @Flag, operands is @Operand) {
        self.options = options;
        self.flags = flags;
        self.operands = operands;
        lookup = CliAliasIndex(options: options, flags: flags);
    }

    aliases() is CliAliasIndex {
        lookup;
    }

    validate() is void {
        let declarations = options.size() + flags.size();
        let keys is @SettingKey = (0..declarations).map() -> index {
            self.key(index);
        };
        let ranked is @Ranked<int, SettingKey> = (0..declarations).map() -> index {
            Ranked(item: index, key: keys[index]);
        };
        let sorted = ranked.ordering();
        let incompatible = (0..sorted.size()).reduce(CliKeyFailure(position: declarations, message: "")) -> old, index {
            if index > 0
                && sorted[index - 1].key().order(sorted[index].key()) == Order.equal
                && sorted[index - 1].item() < options.size() {
                    old.earlier(sorted[index].item(), "incompatible declarations share a key");
                }
                else {
                    old;
                }
        };
        let alternatives is @CliFlagAlternative = (0..flags.size()).map() -> index {
            CliFlagAlternative(
                identity: keys[index + options.size()],
                value: "true",
                position: index + options.size()
            );
        };
        let ordered = alternatives.ordering();
        let conflict = (0..ordered.size()).reduce(incompatible) -> old, index {
            if index > 0
                && ordered[index - 1].key().order(ordered[index].key()) == Order.equal
                && ordered[index - 1].present() == ordered[index].present() {
                    old.earlier(
                        ordered[index].index(),
                        "flag alternatives must declare distinct values"
                    );
                }
                else {
                    old;
                }
        };
        for (0..declarations) -> index {
            confirm index != lookup.duplicate_index()
                else throw InvalidCommandSyntax.because("duplicate option name");
            confirm index != conflict.index()
                else throw InvalidCommandSyntax.because(conflict.reason());
        }
        let declared = SettingKeyIndex(keys);
        let operand_keys is @SettingKey = operands.map() -> operand {
            operand.key();
        };
        let operand_index = SettingKeyIndex(operand_keys);
        let prefix = (0..operands.size()).reduce(CliOperandPrefix(repeated: operands.size(), optional: operands.size())) -> prior, index {
            confirm declared.position(operand_keys[index]) < 0
                else throw InvalidCommandSyntax.because("operand key is already declared");
            let duplicate = operand_index.position(operand_keys[index]);
            let same = if duplicate < index {
                duplicate;
            }
            else {
                operands.size();
            };
            let repeated = prior.repeated();
            let optional = prior.optional();
            let operand = operands[index];
            let required = operand::Spec::count == OperandCount.required;
            // The first previous operand decides; checks at that position keep
            // their legacy order: duplicate, repeated, required-after-optional.
            confirm !(same < index && same <= repeated && (!required || same <= optional))
                else throw InvalidCommandSyntax.because("duplicate operand key");
            confirm !(repeated < index && (!required || repeated <= optional))
                else throw InvalidCommandSyntax.because("repeated operand must be last");
            confirm !(required && optional < index)
                else throw InvalidCommandSyntax.because("required operand follows optional operand");
            CliOperandPrefix(
                repeated: if repeated > index && operand::Spec::count == OperandCount.repeated {
                    index;
                }
                else {
                    repeated;
                },
                optional: if optional > index && !required {
                    index;
                }
                else {
                    optional;
                },
            );
        };
    }

    hidden key(index is int) is SettingKey {
        if index < options.size() {
            options[index].key();
        }
        else {
            flags[index - options.size()].key();
        }
    }
}

hidden object CliKeyFailure {
    has position is int;
    has message is string;

    CliKeyFailure(position is int, message is string) {
        self.position = position;
        self.message = message;
    }

    index() is int {
        position;
    }

    reason() is string {
        message;
    }

    earlier(index is int, reason is string) is CliKeyFailure {
        if index < position {
            CliKeyFailure(position: index, message: reason);
        }
        else {
            self;
        }
    }
}

hidden object CliFlagAlternative does Comparing<CliFlagAlternative> {
    has identity is SettingKey;
    has value is string;
    has position is int;

    CliFlagAlternative(identity is SettingKey, value is string, position is int) {
        self.identity = identity;
        self.value = value;
        self.position = position;
    }

    key() is SettingKey {
        identity;
    }

    present() is string {
        value;
    }

    index() is int {
        position;
    }

    order(other is CliFlagAlternative) is Order {
        let key = identity.order(other.key());
        let present = value.order(other.present());
        if key != Order.equal {
            key;
        }
        else {
            if present != Order.equal {
                present;
            }
            else {
                position.order(other.index());
            }
        }
    }
}

hidden object CliOperandPrefix {
    has repeated, optional is int;

    CliOperandPrefix(repeated is int, optional is int) {
        self.repeated = repeated;
        self.optional = optional;
    }

    repeated() is int {
        repeated;
    }

    optional() is int {
        optional;
    }
}

// Cached immutable aliases. Explicit ordinal preserves declaration order even
// though linked-list prefix builds the materialization in reverse order.
hidden object CliAliasSlot does Comparing<CliAliasSlot> {
    has spelling is string;
    has ordinal is int;

    CliAliasSlot(spelling is string, ordinal is int) {
        self.spelling = spelling;
        self.ordinal = ordinal;
    }

    name() is string {
        spelling;
    }

    ordinal() is int {
        ordinal;
    }

    order(other is CliAliasSlot) is Order {
        let result = spelling.order(other.name());
        if result == Order.equal {
            ordinal.order(other.ordinal());
        }
        else {
            result;
        }
    }
}

hidden object CliAliasIndex {
    has names is @string;
    has positions is @int;
    has duplicate is int;

    CliAliasIndex(options is @Option, flags is @Flag) {
        let count = options.size() + flags.size();
        let empty is List<CliAliasSlot> = EmptyList();
        let slots is List<CliAliasSlot> = (0..count).reduce(empty) -> items, index {
            let aliases = if index < options.size() {
                options[index].names();
            }
            else {
                flags[index - options.size()].names();
            };
            (0..aliases.size()).reduce(items) -> prior, alias {
                prior.prefix(CliAliasSlot(spelling: aliases.item(alias), ordinal: index * 32 + alias));
            };
        };
        let materialized is @CliAliasSlot = CursorItems(slots.cursor()).map() -> slot {
            slot;
        };
        let sorted = materialized.ordering();
        let spellings is @string = sorted.map() -> slot {
            slot.name();
        };
        let indices is @int = sorted.map() -> slot {
            (slot.ordinal() / 32).int();
        };
        names = spellings;
        positions = indices;
        duplicate = (0..spellings.size()).reduce(count) -> earliest, index {
            if index > 0 && spellings[index - 1] == spellings[index] && indices[index] < earliest {
                indices[index];
            }
            else {
                earliest;
            }
        };
    }

    duplicate_index() is int {
        duplicate;
    }

    position(name is string) is int {
        let index = LowerBound(origin: names, item: name).index();
        if index < names.size() && names[index] == name {
            positions[index];
        }
        else {
            -1;
        }
    }
}

// A command: its options, flags and operands, or the subcommands it branches
// into. It reads an argument list into an Invocation and writes its own
// usage text and shell completion.
//
//     let greet = CliCommand(
//         name: "greet",
//         summary: "Greet one person",
//         options: [Option(name: "name", short: "n", value: "NAME", help: "Person to greet")],
//         flags: [Flag(name: "help", short: "h", help: "Show this help")],
//     );
//     let call = greet.invocation(ProcessArguments().strings());
//     if call.flag("help") { Stdout().write(greet.usage(program: "greet")); }
//     let person = call.text("name") else "world";
object CliCommand {
    has label, text is string;
    has declared_options is @Option;
    has declared_flags is @Flag;
    has declared_operands is @Operand;
    has declared_commands is @CliCommand;

    CliCommand(
        name is string,
        summary is string = "",
        options is @Option = [],
        flags is @Flag = [],
        operands is @Operand = [],
        commands is @CliCommand = [],
    ) {
        confirm name != "" && name.length() <= 128
            else throw InvalidCommandSyntax.because("invalid command name");
        confirm name.slice(0, 1) != "-"
            else throw InvalidCommandSyntax.because("command name starts with a dash");
        for Utf8Encoded(name).bytes() -> octet {
            confirm octet.int() > 32 && octet.int() != 127
                else throw InvalidCommandSyntax.because(
                    "command names exclude whitespace, controls and dashes"
                );
        }
        confirm commands.size() <= 1024
            else throw InvalidCommandSyntax.because("child command budget");
        confirm commands.size() == 0 || operands.size() == 0
            else throw InvalidCommandSyntax.because("branch commands cannot have operands");
        // Validation only: the parser builds the same index when it reads.
        CommandSyntax(options: options, flags: flags, operands: operands);
        // Uniqueness sorts only cached names; the published children keep order.
        let names is @string = commands.map() -> child {
            child::Spec::name;
        };
        let ordered = names.ordering();
        for (0..ordered.size()) -> index {
            if index > 0 {
                confirm (ordered[index - 1] != ordered[index])
                    else throw InvalidCommandSyntax.because("duplicate child command");
            }
        }
        confirm CliTreeBudget(children: commands, remaining: 31).size() <= 4095
            else throw InvalidCommandSyntax.because("command tree exceeds 4096 nodes");
        label = name;
        text = summary;
        declared_options = options;
        declared_flags = flags;
        declared_operands = operands;
        declared_commands = commands;
    }

    // The command as declared.
    cap Spec {
        name is string {
            label;
        }

        summary is string {
            text;
        }
    }

    options() is @Option {
        declared_options;
    }

    flags() is @Flag {
        declared_flags;
    }

    operands() is @Operand {
        declared_operands;
    }

    commands() is @CliCommand {
        declared_commands;
    }

    // The arguments read by this command: values by name, the selected
    // subcommand, the operands. A bad argument throws CliFailure with its
    // index. Reading is pure and repeatable.
    invocation(arguments is Sequencing<string>) is Invocation {
        CliParsing(origin: self, arguments: CliArgumentSnapshot(arguments: arguments).strings()).invocation();
    }

    // The usage text of this command, wrapped to width columns.
    usage(program is string, width is int = 80) is string {
        Usage(origin: self, program: program, width: width).string();
    }

    // A completion script for shell.
    completion(program is string, shell is CompletionShell) is string {
        ShellCompletion(origin: self, program: program, shell: shell).string();
    }
}

hidden object CliTreeBudget {
    has count is int;

    CliTreeBudget(children is Sequencing<CliCommand>, remaining is int) {
        confirm remaining >= 0 || children.size() == 0
            else throw InvalidCommandSyntax.because("command tree exceeds 32 levels");
        count = children.reduce(0) -> used, child {
            let added = 1 + CliTreeBudget(children: child.commands(), remaining: remaining - 1).size();
            confirm added <= 4096 - used
                else throw InvalidCommandSyntax.because("command tree exceeds 4096 nodes");
            used + added;
        };
    }

    size() is int {
        count;
    }
}

enum InvalidCommandSyntax is Error = (because(reason is string));

// Parsing is repeatable and has no I/O. Branch commands accept options then one
// child name; leaves accept options and operands. Ancestor aliases cease to be
// recognized after selecting a child. -- affects the remaining complete argv.
// The arguments as read: the selected subcommand and every value by the name
// of its option, flag or operand.
//
//     let call = command.invocation(arguments);
//     let person = call.text("name") else "world";   // Maybe: absent is none
//     let count = call.int("count") else 1;           // a malformed number throws
//     let tags is @string = call.texts("tag");         // a repeated option
//     if call.flag("verbose") { … }
//     let files is @string = call.operands();
//     if call.command() == add { … }                  // the declared object
//
// Reading a name that no command on the path declares throws
// UndeclaredCliName: it is a mistake in the program, not in the arguments.
object Invocation {
    has selected is CliCommand;
    has commands is @CliCommand;
    has entries is Settings;

    Invocation(command is CliCommand, path is @CliCommand, settings is Settings) {
        selected = command;
        commands = path;
        entries = settings;
    }

    // The command the arguments selected: the root, or a subcommand.
    command() is CliCommand {
        selected;
    }

    // The names of the commands from the root to the selected one.
    path() is @string {
        commands.map() -> command {
            command::Spec::name;
        };
    }

    // Every value as a setting, to layer over configuration.
    settings() is Settings {
        entries;
    }

    // The value of an option, the last one if it was repeated.
    text(name is string) is Maybe<string> {
        let values = self.values(self.option_key(name));
        if values.size() == 0 {
            Maybe<string>.none;
        }
        else {
            Maybe.some(values[values.size() - 1]);
        }
    }

    // Every value of a repeated option, in order.
    texts(name is string) is @string {
        self.values(self.option_key(name));
    }

    int(name is string) is Maybe<int> {
        match self.text(name) {
            case Maybe.some(text) {
                let number = try {
                    Number(text).int();
                }
                catch failure is Error {
                    throw CliFailure.detailed(-1, text, "--" + name + ": expected an integer");
                };
                Maybe.some(number);
            }
            else {
                Maybe<int>.none;
            }
        }
    }

    float(name is string) is Maybe<float> {
        match self.text(name) {
            case Maybe.some(text) {
                let number = try {
                    Number(text).float();
                }
                catch failure is Error {
                    throw CliFailure.detailed(-1, text, "--" + name + ": expected a number");
                };
                Maybe.some(number);
            }
            else {
                Maybe<float>.none;
            }
        }
    }

    bool(name is string) is Maybe<bool> {
        match self.text(name) {
            case Maybe.some(text) {
                let truth = try {
                    Truth(text).bool();
                }
                catch failure is Error {
                    throw CliFailure.detailed(-1, text, "--" + name + ": expected true or false");
                };
                Maybe.some(truth);
            }
            else {
                Maybe<bool>.none;
            }
        }
    }

    // Whether a flag was given.
    flag(name is string) is bool {
        let found = (0..commands.size()).reduce(Maybe<SettingKey>.none) -> key, index {
            let declared is @Flag = commands[index].flags().filter() -> flag {
                flag::Spec::name == name;
            };
            if declared.size() == 1 {
                Maybe.some(declared[0].key());
            }
            else {
                key;
            }
        };
        let key = found else throw UndeclaredCliName.name(name);
        entries.membership(key);
    }

    // The operands of the selected command, in order.
    operands() is @string {
        selected.operands().reduce([]) -> all, operand {
            all + self.values(operand.key());
        };
    }

    hidden option_key(name is string) is SettingKey {
        let found = (0..commands.size()).reduce(Maybe<SettingKey>.none) -> key, index {
            let declared is @Option = commands[index].options().filter() -> option {
                option::Spec::name == name;
            };
            if declared.size() == 1 {
                Maybe.some(declared[0].key());
            }
            else {
                key;
            }
        };
        found else throw UndeclaredCliName.name(name);
    }

    hidden values(key is SettingKey) is @string {
        if entries.membership(key) {
            let values = entries.entry(key).values();
            (0..values.size()).map() -> index {
                values.item(index);
            };
        }
        else {
            [];
        }
    }
}

enum UndeclaredCliName is Error = (name(name is string));

hidden object CliOperandToken {
    has token is string;
    has index is int;

    CliOperandToken(token is string, index is int) {
        self.token = token;
        self.index = index;
    }

    token() is string {
        token;
    }

    index() is int {
        index;
    }
}

// The arguments, taken once and checked against the budgets.
hidden object CliArgumentSnapshot {
    has arguments is Sequencing<string>;

    CliArgumentSnapshot(:arguments);

    strings() is @string {
        let size = arguments.size();
        confirm size >= 0 && size <= 4096
            else throw CliFailure.detailed(0, "", "argument count budget");
        let snapshot is @string = (0..size).map() -> index {
            arguments.item(index);
        };
        let length = snapshot.reduce(0) -> used, value {
            used + value.length();
        };
        confirm length <= 1048576 else throw CliFailure.detailed(0, "", "argument text budget");
        snapshot;
    }
}

hidden object CliParsing {
    has command is Atomic<CliCommand>;
    has syntax is Atomic<CommandSyntax>;
    has path is Atomic<@CliCommand>;
    has position is Atomic<int>;
    has literal is Atomic<bool>;
    has operands is Atomic<@CliOperandToken>;
    has entries is Atomic<SettingOverlay>;
    has arguments is @string;
    has source is SettingSource;

    CliParsing(origin is CliCommand, arguments is @string) {
        command = Atomic(origin);
        syntax = Atomic(CommandSyntax(options: origin.options(), flags: origin.flags(), operands: origin.operands()));
        let root is @CliCommand = [origin];
        path = Atomic(root);
        position = Atomic(0);
        literal = Atomic(false);
        let empty is @CliOperandToken = [];
        operands = Atomic(empty);
        entries = Atomic(SettingOverlay());
        self.arguments = arguments;
        source = SettingSource(SettingSourceKind.command_line, "argv");
    }

    invocation() is Invocation {
        loop {
            let at = position.value();
            if at >= arguments.size() {
                last;
            }
            let token = arguments[at];
            if !literal.value() && token == "--" {
                literal.replace(true);
                position.replace(at + 1);
                next;
            }
            if !literal.value() && token.length() > 1 && token.slice(0, 1) == "-" {
                self.option(token, at);
            }
            else {
                self.operand(token, at);
            }
        }
        confirm command.value().commands().size() == 0
            else throw CliFailure.detailed(arguments.size(), "", "child command required");
        self.finish_operands();
        Invocation(command: command.value(), path: path.value(), settings: Settings(entries.value().entries()));
    }

    hidden option_index(name is string) is int {
        syntax.value().option_index(name);
    }

    hidden flag_index(name is string) is int {
        syntax.value().flag_index(name);
    }

    hidden option(token is string, at is int) is void {
        if token.slice(0, 2) == "--" {
            let name = token.split("=").first();
            let option = self.option_index(name);
            let flag = self.flag_index(name);
            if option >= 0 {
                let descriptor = syntax.value().options().item(option);
                if token.length() > name.length() {
                    self.value_option(
                        descriptor,
                        token.slice(name.length() + 1, token.length()),
                        at
                    );
                    position.replace(at + 1);
                }
                else {
                    self.following_value(descriptor, at);
                }
            }
            else if flag >= 0 {
                confirm token == name
                    else throw CliFailure.detailed(at, token, "flags cannot take a value");
                self.flag(syntax.value().flags().item(flag));
                position.replace(at + 1);
            }
            else {
                throw CliFailure.detailed(at, token, "unknown option");
            }
        }
        else {
            let exact_option = self.option_index(token);
            let exact_flag = self.flag_index(token);
            if exact_option >= 0 {
                self.following_value(syntax.value().options().item(exact_option), at);
            }
            else if exact_flag >= 0 {
                self.flag(syntax.value().flags().item(exact_flag));
                position.replace(at + 1);
            }
            else if try {
                Number(token).float();
                true;
            }
            catch e is Error {
                false;
            } {
                self.operand(token, at);
            }
            else {
                position.replace(at + 1);
                for (1..token.length()) -> index {
                    let name = "-" + token.slice(index, index + 1);
                    let option = self.option_index(name);
                    let flag = self.flag_index(name);
                    if option >= 0 {
                        confirm index == token.length() - 1
                            else throw CliFailure.detailed(
                                at,
                                token,
                                "value option must be final in a short cluster"
                            );
                        self.following_value(syntax.value().options().item(option), at);
                    }
                    else if flag >= 0 {
                        self.flag(syntax.value().flags().item(flag));
                    }
                    else {
                        throw CliFailure.detailed(at, token, "unknown short option");
                    }
                }
            }
        }
    }

    hidden following_value(option is Option, at is int) is void {
        confirm at + 1 < arguments.size()
            else throw CliFailure.detailed(at, arguments[at], "missing option value");
        self.value_option(option, arguments[at + 1], at);
        position.replace(at + 2);
    }

    hidden value_option(option is Option, text is string, at is int) is void {
        let old = entries.value();
        if old.membership(option.key()) {
            confirm option::Spec::repeated
                else throw CliFailure.detailed(at, arguments[at], "scalar option repeated");
            let previous = old.entry(option.key()).values();
            let revised is @string = (0..previous.size() + 1).map() -> index {
                if index < previous.size() {
                    previous.item(index);
                }
                else {
                    text;
                }
            };
            entries.replace(entries.value().replaced(SettingEntry(option.key(), revised, source)));
        }
        else {
            entries.replace(entries.value().replaced(SettingEntry(option.key(), [text], source)));
        }
    }

    hidden flag(flag is Flag) is void {
        entries.replace(
            entries.value().replaced(SettingEntry(flag.key(), ["true"], source))
        );
    }

    hidden operand(token is string, at is int) is void {
        let children = command.value().commands();
        if children.size() > 0 {
            let found = (0..children.size()).reduce(-1) -> old, index {
                let child = children[index];
                if child::Spec::name == token {
                    index;
                }
                else {
                    old;
                }
            };
            confirm found >= 0 else throw CliFailure.detailed(at, token, "unknown child command");
            let selected = children[found];
            path.replace(path.value() + [selected]);
            command.replace(selected);
            syntax.replace(CommandSyntax(options: selected.options(), flags: selected.flags(), operands: selected.operands()));
        }
        else {
            let old = operands.value();
            let revised is @CliOperandToken = (0..old.size() + 1).map() -> index {
                if index < old.size() {
                    old[index];
                }
                else {
                    CliOperandToken(token: token, index: at);
                }
            };
            operands.replace(revised);
        }
        position.replace(at + 1);
    }

    hidden finish_operands() is void {
        let specs = syntax.value().operands();
        let values = operands.value();
        let consumed = Atomic(0);
        for specs -> spec {
            let at = consumed.value();
            let remaining = values.size() - at;
            confirm spec::Spec::count != OperandCount.required || remaining > 0
                else throw CliFailure.detailed(
                    arguments.size(),
                    "",
                    "missing required operand: " + spec::Spec::name
                );
            let size = if spec::Spec::count == OperandCount.repeated {
                remaining;
            }
            else {
                if remaining > 0 {
                    1;
                }
                else {
                    0;
                }
            };
            if size > 0 || spec::Spec::count == OperandCount.repeated {
                let texts is @string = (0..size).map() -> index {
                    values[at + index].token();
                };
                entries.replace(entries.value().replaced(SettingEntry(spec.key(), texts, source)));
            }
            consumed.replace(at + size);
        }
        let count = consumed.value();
        if count < values.size() {
            throw CliFailure.detailed(
                values[count].index(),
                values[count].token(),
                "unexpected operand"
            );
        }
    }
}

enum CliFailure is Error = (detailed(index is int, token is string, message is string));

enum CompletionShell = (bash, zsh, fish);

hidden object Usage {
    has origin is CliCommand;
    has program is string;
    has width is int;

    Usage(origin is CliCommand, program is string, width is int) {
        self.origin = origin;
        self.program = program;
        self.width = width;
    }

    string() is string {
        confirm width >= 8 else throw InvalidHelpWidth.invalid;
        DisplayWidth(program).value();
        let options = if origin.options().size() + origin.flags().size() > 0 {
            " [OPTIONS]";
        }
        else {
            "";
        };
        let operands_lines is @string = origin.operands().map() -> operand {
            let value = operand::Spec::name + if operand::Spec::count == OperandCount.repeated {
                "...";
            }
            else {
                "";
            };
            " " + if operand::Spec::count == OperandCount.required {
                "<" + value + ">";
            }
            else {
                "[" + value + "]";
            };
        };
        let operands = operands_lines.join("");
        let children = if origin.commands().size() > 0 {
            " <COMMAND>";
        }
        else {
            "";
        };
        let values_lines is @string = origin.options().map() -> option {
            let names is @string = option.names().map() -> name {
                name;
            };
            "  " + names.join(", ") + " <" + option::Spec::value + ">" +
                if option::Spec::repeated {
                    "...";
                }
                else {
                    "";
                } + (if option::Spec::help == "" { "\n"; } else { "\n    " + option::Spec::help + "\n"; });
        };
        let values = values_lines.join("");
        let flags_lines is @string = origin.flags().map() -> flag {
            let names is @string = flag.names().map() -> name {
                name;
            };
            "  " + names.join(", ") + (if flag::Spec::help == "" { "\n"; } else { "\n    " + flag::Spec::help + "\n"; });
        };
        let flags = flags_lines.join("");
        let files_lines is @string = origin.operands().map() -> operand {
            "  " + operand::Spec::name + if operand::Spec::count == OperandCount.repeated {
                "...";
            }
            else {
                "";
            } + (if operand::Spec::help == "" { "\n"; } else { "\n    " + operand::Spec::help + "\n"; });
        };
        let files = files_lines.join("");
        let commands_lines is @string = origin.commands().map() -> child {
            "  " + child::Spec::name + (if child::Spec::summary == "" { "\n"; } else { "\n    " + child::Spec::summary + "\n"; });
        };
        let commands = commands_lines.join("");
        let text = "Usage: " + program + options + operands + children + "\n" + origin::Spec::summary + "\n" +
            if values + flags != "" {
                "\nOptions:\n" + values + flags;
            }
            else {
                "";
            } +
            if files != "" {
                "\nOperands:\n" + files;
            }
            else {
                "";
            } +
            if commands != "" {
                "\nCommands:\n" + commands;
            }
            else {
                "";
            };
        WrappedDisplay(text, width).string();
    }
}

// Static union of declared aliases and child names. No runtime callbacks,
// filesystem suggestions or implicit option-value guesses are installed.
hidden object ShellCompletion {
    has origin is CliCommand;
    has program is string;
    has shell is CompletionShell;

    ShellCompletion(origin is CliCommand, program is string, shell is CompletionShell) {
        self.origin = origin;
        self.program = program;
        self.shell = shell;
    }

    string() is string {
        DisplayWidth(program).value();
        let codes is @string = Utf8Encoded(program).bytes().map() -> octet {
            octet.int().string();
        };
        let function = "_okkama_" + codes.join("_");
        let words = CompletionWords(origin).items();
        if shell == CompletionShell.fish {
            let lines is @string = words.map() -> word {
                let declaration = if word.length() > 2 && word.slice(0, 2) == "--" {
                    " -l " + FishCompletionLiteral(word.slice(2, word.length())).string();
                }
                else {
                    if word.length() == 2 && word.slice(0, 1) == "-" {
                        " -s " + FishCompletionLiteral(word.slice(1, 2)).string();
                    }
                    else {
                        " -a " + FishCompletionLiteral(FishCompletionLiteral(word).string()).string();
                    }
                };
                "complete -c " + FishCompletionLiteral(program).string() + " -f" + declaration + "\n";
            };
            if words.size() > 0 {
                lines.join("");
            }
            else {
                "complete -c " + FishCompletionLiteral(program).string() + " -f\n";
            }
        }
        else {
            let quoted is @string = words.map() -> word {
                CompletionLiteral(word).string();
            };
            let literals = quoted.join(" ");
            if shell == CompletionShell.bash {
                let iteration = if words.size() > 0 {
                    "  for candidate in " + literals + "; do\n    if [[ \"$candidate\" == \"$cur\"* ]]; then COMPREPLY+=(\"$candidate\"); fi\n  done\n";
                }
                else {
                    "";
                };
                function + "() {\n  local candidate cur=\"${COMP_WORDS[COMP_CWORD]}\"\n  COMPREPLY=()\n" + iteration + "}\ncomplete -F " + function + " -- " + CompletionLiteral(
                    program
                ).string() + "\n";
            }
            else {
                let operation = if words.size() > 0 {
                    "  compadd -- " + literals + "\n";
                }
                else {
                    "  return 0\n";
                };
                function + "() {\n" + operation + "}\ncompdef " + function + " " + CompletionLiteral(
                    program
                ).string() + "\n";
            }
        }
    }
}

hidden object CompletionWords {
    has origin is @string;

    CompletionWords(command is CliCommand) {
        let all = command.options().reduce(CompletionNames()) -> old, option {
            option.names().reduce(old) -> state, name {
                state.added(name);
            };
        };
        let flags = command.flags().reduce(all) -> old, flag {
            flag.names().reduce(old) -> state, name {
                state.added(name);
            };
        };
        let children = command.commands().reduce(flags) -> old, child {
            CompletionWords(child).items().reduce(old.added(child::Spec::name)) -> state, name {
                state.added(name);
            };
        };
        origin = children.items();
    }

    items() is @string {
        origin;
    }
}

hidden object CompletionNames {
    has origin is @string;

    CompletionNames() {
        origin = [];
    }

    added(name is string) is ^CompletionNames {
        let found = origin.reduce(false) -> old, value {
            old || value == name;
        };
        if !found {
            let revised is @string = (0..origin.size() + 1).map() -> index {
                if index < origin.size() {
                    origin[index];
                }
                else {
                    name;
                }
            };
            ^origin = revised;
        }
    }

    items() is @string {
        origin;
    }
}

hidden object CompletionLiteral {
    has origin is string;

    CompletionLiteral(origin is string) {
        self.origin = origin;
    }

    string() is string {
        "'" + origin.replace("'", "'\"'\"'") + "'";
    }
}

hidden object FishCompletionLiteral {
    has origin is string;

    FishCompletionLiteral(origin is string) {
        self.origin = origin;
    }

    string() is string {
        "'" + origin.replace("\\", "\\\\").replace("'", "\\'") + "'";
    }
}

enum InvalidHelpWidth is Error = (invalid);

test "options, flags and operands are read back by name" {
    let greet = CliCommand(
        name: "greet",
        options: [
            Option(name: "name", short: "n", value: "NAME"),
            Option(name: "times", value: "N"),
            Option(name: "tag", short: "t", repeated: true),
        ],
        flags: [Flag(name: "loud", short: "l"), Flag(name: "help", short: "h")],
        operands: [Operand(name: "FILE", count: OperandCount.repeated)],
    );
    let call = greet.invocation(["-n", "Ada", "--times=3", "-lt", "x", "--tag", "y", "a.txt", "--", "-b.txt"]);
    test.is(call.text("name") else "world", "Ada");
    test.is(call.int("times") else 1, 3);
    test.ok(call.flag("loud"));
    test.ok(!call.flag("help"));
    test.is(call.texts("tag"), ["x", "y"]);
    test.is(call.text("tag") else "", "y");
    test.is(call.operands(), ["a.txt", "-b.txt"]);
    test.is(call.path(), ["greet"]);
    test.ok(call.command() == greet);
    let empty = greet.invocation([]);
    test.ok(empty.text("name") == Maybe<string>.none);
    test.ok(empty.int("times") == Maybe<int>.none);
    test.is(empty.texts("tag"), []);
    test.is(empty.operands(), []);
}

test "typed readers name the option when a value is malformed" {
    let tool = CliCommand(
        name: "tool",
        options: [Option(name: "count"), Option(name: "ratio"), Option(name: "dry")],
    );
    let call = tool.invocation(["--count", "x", "--ratio", "0.5", "--dry", "maybe"]);
    test.ok(try {
        call.int("count");
        false;
    }
    catch CliFailure.detailed(index, token, message) {
        token == "x" && message == "--count: expected an integer";
    });
    test.is(call.float("ratio") else 0.0, 0.5);
    test.throws(CliFailure) {
        call.bool("dry");
    };
    test.is(tool.invocation(["--dry", "true"]).bool("dry") else false, true);
    test.throws(UndeclaredCliName) {
        call.text("cuont");
    };
    test.throws(UndeclaredCliName) {
        call.flag("verbose");
    };
}

test "a subcommand is the declared object; ancestor options stop at the child" {
    let add = CliCommand(name: "add", summary: "Add an item", operands: [Operand(name: "TEXT")]);
    let list = CliCommand(name: "list", summary: "Show items", flags: [Flag(name: "all")]);
    let todo = CliCommand(name: "todo", flags: [Flag(name: "verbose", short: "v")], commands: [add, list]);
    let call = todo.invocation(["-v", "add", "buy milk"]);
    test.ok(call.command() == add);
    test.ok(call.command() != list);
    test.is(call.path(), ["todo", "add"]);
    test.is(call.operands(), ["buy milk"]);
    test.ok(call.flag("verbose"));
    test.ok(todo.invocation(["list", "--all"]).flag("all"));
    test.ok(try {
        todo.invocation(["list", "-v"]);
        false;
    }
    catch CliFailure.detailed(index, token, message) {
        index == 1 && message == "unknown short option";
    });
    test.ok(try {
        todo.invocation(["remove"]);
        false;
    }
    catch CliFailure.detailed(index, token, message) {
        index == 0 && token == "remove" && message == "unknown child command";
    });
    test.throws(CliFailure) {
        todo.invocation([]);
    };
}

test "bad arguments are refused with their index" {
    let copy = CliCommand(
        name: "copy",
        options: [Option(name: "mode", short: "m")],
        operands: [Operand(name: "FROM"), Operand(name: "TO")],
    );
    let failures is @string = [["--mode"], ["--colour"], ["a"], ["a", "b", "c"], ["--mode", "x", "--mode", "y", "a", "b"]].map() -> arguments {
        try {
            copy.invocation(arguments);
            "accepted";
        }
        catch CliFailure.detailed(index, token, message) {
            index.string() + " " + message;
        };
    };
    test.is(failures, [
        "0 missing option value",
        "0 unknown option",
        "1 missing required operand: TO",
        "2 unexpected operand",
        "2 scalar option repeated",
    ]);
}

test "declarations are checked when made" {
    test.throws(InvalidCommandSyntax) {
        CliCommand(name: "x", options: [Option(name: "a"), Option(name: "a")]);
    };
    test.throws(InvalidCommandSyntax) {
        CliCommand(name: "x", flags: [Flag(name: "Bad")]);
    };
    test.throws(InvalidCommandSyntax) {
        CliCommand(name: "x", operands: [Operand(name: "A", count: OperandCount.repeated), Operand(name: "B")]);
    };
    test.throws(InvalidCommandSyntax) {
        CliCommand(name: "-x");
    };
    test.throws(InvalidCommandSyntax) {
        CliCommand(name: "x", operands: [Operand(name: "A")], commands: [CliCommand(name: "y")]);
    };
    test.throws(InvalidCommandSyntax) {
        CliCommand(name: "x", commands: [CliCommand(name: "y"), CliCommand(name: "y")]);
    };
    let option = Option(name: "name", short: "n", value: "NAME", help: "Person");
    test.is(option::Spec::name, "name");
    test.is(option::Spec::short, "n");
    test.is(option::Spec::value, "NAME");
    test.is(option.names(), ["--name", "-n"]);
}

test "usage and completion come from the declaration" {
    let greet = CliCommand(
        name: "greet",
        summary: "Greet one person",
        options: [Option(name: "name", short: "n", value: "NAME", help: "Person to greet")],
        flags: [Flag(name: "help", short: "h", help: "Show this help")],
    );
    test.is(
        greet.usage(program: "greet"),
        "Usage: greet [OPTIONS]\nGreet one person\n\nOptions:\n  --name, -n <NAME>\n    Person to greet\n  --help, -h\n    Show this help\n",
    );
    for [CompletionShell.bash, CompletionShell.zsh, CompletionShell.fish] -> shell {
        let script = greet.completion(program: "greet", shell: shell);
        test.ok(script.contains("name") && script.contains("help") && script.contains("greet"));
    }
    test.throws(InvalidHelpWidth) {
        greet.usage(program: "greet", width: 4);
    };
}
