module mail/imap_command v1.0.0;
import "encoding/utf" take Utf8Decoded;

import "mail/imap_command_reading" take ImapTag;
import "mail/imap_name" take ImapMailboxName;
import "mail/imap_search" take MailMatching;
import "mail/imap_uid" take ImapUidSet;
import "mail/mailbox" take MailFlags, MailFlagKind, SystemMailFlag;
import "mail/message" take MailMessage;
import "collections/sequence" take Sequencing;
import "mime/media_type" take MimeItems;
import "encoding/utf" take Utf8Encoded;
import "io/decorators" take ByteSnapshot;
import "io/buffer" take ByteBuffer;
import "error" take InvalidArgument, InvalidState;

enum ImapSimpleCommand = (capability, noop, logout, check, close, unselect, idle);
enum ImapMailboxCommand = (select, examine, create, delete, subscribe, unsubscribe, status);
enum ImapDatum = (uid, flags, headers, body, message);
enum FlagChange = (replace, add, remove);

// Closed command representations. Constructor calls use named arguments when
// arities overlap. No constructor accepts raw command/criteria text.
// APPEND uses one synchronizing literal; caller must await continuation before
// sending literal_bytes(). UID operations never fall back to sequence numbers.
object ImapCommand {
    has text is ImapCommandText;has payload is @ByteSnapshot;
    ImapCommand(simple is ImapSimpleCommand) {
        let name=match simple {
            case ImapSimpleCommand.capability {"CAPABILITY";} case ImapSimpleCommand.noop {"NOOP";}
            case ImapSimpleCommand.logout {"LOGOUT";} case ImapSimpleCommand.check {"CHECK";}
            case ImapSimpleCommand.close {"CLOSE";} case ImapSimpleCommand.unselect {"UNSELECT";}
            case ImapSimpleCommand.idle {"IDLE";}
        };text=ImapCommandText(name);payload=[];
    }
    ImapCommand(operation is ImapMailboxCommand, mailbox is ImapMailboxName) {
        let name=match operation {
            case ImapMailboxCommand.select {"SELECT";} case ImapMailboxCommand.examine {"EXAMINE";}
            case ImapMailboxCommand.create {"CREATE";} case ImapMailboxCommand.delete {"DELETE";}
            case ImapMailboxCommand.subscribe {"SUBSCRIBE";} case ImapMailboxCommand.unsubscribe {"UNSUBSCRIBE";}
            case ImapMailboxCommand.status {"STATUS";}
        };
        let suffix=if operation==ImapMailboxCommand.status {" (MESSAGES RECENT UNSEEN UIDNEXT UIDVALIDITY)";} else {"";};
        text=ImapCommandText(name+" "+mailbox.quoted()+suffix);payload=[];
    }
    ImapCommand(source is ImapMailboxName, destination is ImapMailboxName) {
        text=ImapCommandText("RENAME "+source.quoted()+" "+destination.quoted());payload=[];
    }
    ImapCommand(reference is ImapMailboxName, pattern is ImapMailboxName, subscribed is bool) {
        // Pattern is quoted as a string; its '*'/'%' retain IMAP wildcard meaning.
        let name=if subscribed {"LSUB";} else {"LIST";};
        text=ImapCommandText(name+" "+reference.quoted()+" "+pattern.quoted());payload=[];
    }
    ImapCommand(matching is MailMatching) {
        text=ImapCommandText("UID SEARCH "+matching.key().string());payload=[];
    }
    ImapCommand(uids is ImapUidSet, data is Sequencing<ImapDatum>) {
        text=ImapCommandText("UID FETCH "+uids.argument()+" ("+ImapFetchData(data).string()+")");payload=[];
    }
    ImapCommand(uids is ImapUidSet, flags is MailFlags, change is FlagChange) {
        let action=match change {case FlagChange.replace {"FLAGS";} case FlagChange.add {"+FLAGS";} case FlagChange.remove {"-FLAGS";}};
        text=ImapCommandText("UID STORE "+uids.argument()+" "+action+" "+ImapWritableFlags(flags).string());payload=[];
    }
    ImapCommand(uids is ImapUidSet, destination is ImapMailboxName, move is bool) {
        let name=if move {"UID MOVE";} else {"UID COPY";};
        text=ImapCommandText(name+" "+uids.argument()+" "+destination.quoted());payload=[];
    }
    ImapCommand(expunged is ImapUidSet) {
        text=ImapCommandText("UID EXPUNGE "+expunged.argument());payload=[];
    }
    ImapCommand(mailbox is ImapMailboxName, message is MailMessage, flags is MailFlags) {
        let bytes=message.bytes();
        confirm bytes.size()<=16777216 else throw InvalidArgument("IMAP APPEND message exceeds 16777216 bytes");
        for bytes -> octet {confirm octet.int()!=0 else throw InvalidArgument("IMAP APPEND ordinary literal excludes NUL");}
        text=ImapCommandText("APPEND "+mailbox.quoted()+" "+ImapWritableFlags(flags).string()+" {"+bytes.size().string()+"}");
        payload=[ByteSnapshot(bytes)];
    }
    bytes(tag is ImapTag) is @byte {Utf8Encoded(tag.string()+" "+text.string()+"\r\n").bytes();}
    literal() is bool {payload.size()>0;}
    literal_bytes() is @byte {
        confirm self.literal() else throw InvalidState("IMAP command has no continuation payload");
        let buffer=ByteBuffer(payload[0].bytes());defer buffer.closing().close();
        buffer.writing().write(ByteSnapshot([13.byte(),10.byte()]));buffer.content().bytes();
    }
    name() is string {text.string().split(" ")[0];}
    uid_operation() is string {
        confirm self.name()=="UID" else throw InvalidState("not an IMAP UID command");
        text.string().split(" ")[1];
    }
}
object ImapCommandText {
    has value is string;
    ImapCommandText(origin is string) {
        confirm origin.length()<=65536 else throw InvalidArgument("IMAP command text exceeds 65536 bytes");
        for Utf8Encoded(origin).bytes() -> octet {
            confirm octet.int()>=32 && octet.int()<=126 else throw InvalidArgument("IMAP command text must be printable ASCII");
        }
        value=origin;
    }
    string() is string {value;}
}
object ImapFetchData {
    has value is string;
    ImapFetchData(origin is Sequencing<ImapDatum>) {
        let size=origin.size();confirm size>=0 && size<=5 else throw InvalidArgument("IMAP FETCH accepts at most five requested data kinds");
        let names is MimeItems<string>=MimeItems();names=names.following("UID");
        for (0..size) -> index {
            let name=match origin.item(index) {
                case ImapDatum.uid {"UID";} case ImapDatum.flags {"FLAGS";}
                case ImapDatum.headers {"BODY.PEEK[HEADER]";} case ImapDatum.body {"BODY.PEEK[TEXT]";}
                case ImapDatum.message {"BODY.PEEK[]";}
            };
            let present=names.entries().reduce(false) -> found,previous {found || previous==name;};
            if !present {names=names.following(name);}
        }
        value=names.entries().join(" ");
    }
    string() is string {value;}
}
object ImapWritableFlags {
    has value is string;
    ImapWritableFlags(origin is MailFlags) {
        let flags is @string=(0..origin.size()).map() -> index {
            let flag=origin.item(index);
            confirm flag.kind()!=MailFlagKind.system || flag.system()!=SystemMailFlag.recent
                else throw InvalidArgument("IMAP Recent is a server observation, not a writable flag");
            flag.string();
        };
        value="("+flags.join(" ")+")";
    }
    string() is string {value;}
}

test "mailbox command uses a quoted canonical name" {
    let command=ImapCommand(operation:ImapMailboxCommand.select,mailbox:ImapMailboxName("Drafts & Notes"));
    test.is(Utf8Decoded(command.bytes(ImapTag("O1"))).string(),"O1 SELECT \"Drafts &- Notes\"\r\n");test.is(command.literal(),false);
}
