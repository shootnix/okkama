module mail/smtp_reading v1.0.0;

// Reading one SMTP reply from a stream, keeping the bytes read past it.
//
//     let read = await SmtpReplyReading(socket).read();
//     read.reply().code();                 // 220
//     let next = await SmtpReplyReading(origin: socket, prefix: read.remainder()).read();
//
// One read at a time per stream. A read that fails part way may have consumed
// input: the session is then over; do not retry it.

import "io/stream" take AsyncReading;
import "mail/smtp_reply" take SmtpReply, SmtpReplyDecoder, SmtpReplyLimits, SmtpLimitExceeded;
import "io/decorators" take InvalidReading;
import "error" take InvalidArgument;

// Reads one reply.
object SmtpReplyReading {
    has pending is Future<SmtpReplyRead>;

    // Reads from origin with the default limits.
    SmtpReplyReading(origin is AsyncReading) {
        pending = SmtpReplyInput(
            origin: origin,
            prefix: [],
            limits: SmtpReplyLimits(),
            chunk_bytes: 4096
        ).read();
    }

    // Reads prefix first, then origin.
    SmtpReplyReading(origin is AsyncReading, prefix is @byte) {
        pending = SmtpReplyInput(
            origin: origin,
            prefix: prefix,
            limits: SmtpReplyLimits(),
            chunk_bytes: 4096
        ).read();
    }

    // The same within limits, chunk_bytes at a time.
    SmtpReplyReading(
        origin is AsyncReading,
        prefix is @byte,
        limits is SmtpReplyLimits,
        chunk_bytes is int
    ) {
        pending = SmtpReplyInput(
            origin: origin,
            prefix: prefix,
            limits: limits,
            chunk_bytes: chunk_bytes
        ).read();
    }

    // The reply and what came after it; the same future on every call.
    read() is Future<SmtpReplyRead> {
        pending;
    }
}

// A reply read from a stream, and the bytes after it.
object SmtpReplyRead {
    has value is SmtpReply;
    has tail is @byte;
    has count is int;

    // What decoder completed.
    SmtpReplyRead(decoder is SmtpReplyDecoder) {
        value = decoder.finish();
        tail = decoder.remainder();
        count = decoder.consumed();
    }

    // The reply.
    reply() is SmtpReply {
        value;
    }

    // The bytes read past it.
    remainder() is @byte {
        tail;
    }

    // How many bytes the reply took.
    consumed() is int {
        count;
    }
}

hidden object SmtpReplyInput {
    has origin is AsyncReading;
    has prefix is @byte;
    has limits is SmtpReplyLimits;
    has chunk_bytes is int;

    SmtpReplyInput(
        origin is AsyncReading,
        prefix is @byte,
        limits is SmtpReplyLimits,
        chunk_bytes is int
    ) {
        confirm chunk_bytes > 0
            else throw InvalidArgument.because("SMTP read chunk size must be positive");
        confirm prefix.size() <= limits::Limits::wire_bytes
            else throw SmtpLimitExceeded.kind("chunk_bytes");
        self.origin = origin;
        self.prefix = prefix;
        self.limits = limits;
        self.chunk_bytes = chunk_bytes;
    }

    async read() is SmtpReplyRead {
        let decoder = SmtpReplyDecoder(limits);
        decoder = decoder.fed(prefix);
        loop {
            last if decoder.complete();
            let remaining = limits::Limits::wire_bytes - decoder.consumed();
            confirm remaining > 0 else throw SmtpLimitExceeded.kind("wire_bytes");
            let requested = if chunk_bytes < remaining {
                chunk_bytes;
            }
            else {
                remaining;
            };
            let chunk = await origin.bytes(requested);
            confirm chunk.size() <= requested
                else throw InvalidReading.because("SMTP origin returned more bytes than requested");
            if chunk.size() == 0 {
                decoder.finish();
            }
            decoder = decoder.fed(chunk);
        }
        SmtpReplyRead(decoder);
    }
}

test "SMTP read result preserves a completed decoder snapshot" {
    let decoder = SmtpReplyDecoder();
    decoder = decoder.fed([50.byte(), 53.byte(), 48.byte(), 13.byte(), 10.byte(), 1.byte()]);
    let read = SmtpReplyRead(decoder);
    test.is(read.reply().code(), 250);
    test.is(read.consumed(), 5);
    test.is(read.remainder(), [1.byte()]);
}
