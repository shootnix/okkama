module mail/imap_data v1.0.0;

// The structure of an untagged response: atoms, quoted strings, literals and
// parenthesized lists.
//
//     for ParsedImapData(response).entries() -> value {
//         if value.kind() == ImapValueKind.list { value.entries(); }
//         else { value.string(); }
//     }
//
// NIL, "" and () stay distinct; absent() tells NIL. Literals stay bytes. By
// default 8192 tokens nested at most 64 deep.

import "mail/imap_response" take ParsedImapResponse;

import "mail/imap_response" take ImapResponse, ImapResponseKind, ImapResponsePartKind;
import "mime/media_type" take MimeItems, MimePosition;
import "collections/sequence" take Sequencing;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "io/buffer" take ByteBuffer;
import "error" take InvalidArgument, InvalidState;

// An atom, a quoted string, a literal, a literal8 or a list.
enum ImapValueKind = (atom, quoted, literal, literal8, list);

// A token of the scanner.
enum ImapTokenKind = (atom, quoted, literal, literal8, opening, closing);

// How large a structure may be.
object ImapDataLimits {
    has tokens, depth is int;

    // 8192 tokens, depth 64.
    ImapDataLimits() {
        tokens = 8192;
        depth = 64;
    }

    // The limits as given.
    ImapDataLimits(tokens is int, depth is int) {
        confirm tokens >= 0 && depth >= 0
            else throw InvalidArgument.because("IMAP data limits must be nonnegative");
        self.tokens = tokens;
        self.depth = depth;
    }

    // Tokens and depth.
    cap Limits {
        tokens is int {
            tokens;
        }

        depth is int {
            depth;
        }
    }
}

// One value of a response.
object ImapValue {
    has kind is ImapValueKind;
    has content is @byte;
    has entries is @ImapValue;

    // As given.
    ImapValue(kind is ImapValueKind, content is @byte, entries is @ImapValue) {
        confirm (kind == ImapValueKind.list && content.size() == 0)
            || (kind != ImapValueKind.list && entries.size() == 0)
            else throw InvalidArgument.because(
                "IMAP value cannot contain both bytes and list entries"
            );
        self.kind = kind;
        self.content = content;
        self.entries = entries;
    }

    // Its kind.
    kind() is ImapValueKind {
        kind;
    }

    // Its bytes; InvalidState for a list.
    bytes() is @byte {
        confirm kind != ImapValueKind.list
            else throw InvalidState.because("IMAP list has no scalar bytes");
        content;
    }

    // Its bytes as UTF-8.
    string() is string {
        Utf8Decoded(self.bytes()).string();
    }

    // The values of a list; InvalidState for a scalar.
    entries() is Sequencing<ImapValue> {
        confirm kind == ImapValueKind.list
            else throw InvalidState.because("IMAP scalar is not a list");
        entries;
    }

    // Whether it is NIL.
    absent() is bool {
        kind == ImapValueKind.atom && ImapDataUpper(self.string()).string() == "NIL";
    }
}

// The values of an untagged response.
object ParsedImapData {
    has entries is @ImapValue;

    // Reads origin within the default limits.
    ParsedImapData(origin is ImapResponse) {
        entries = ImapDataParsing(origin: origin, limits: ImapDataLimits()).entries();
    }

    // Reads origin within limits.
    ParsedImapData(origin is ImapResponse, limits is ImapDataLimits) {
        entries = ImapDataParsing(origin: origin, limits: limits).entries();
    }

    // Every value of the line, from `*` on; InvalidImapData for bad structure.
    entries() is Sequencing<ImapValue> {
        entries;
    }
}

// A response whose structure is not valid; reason says why.
enum InvalidImapData is Error = (because(reason is string));

// A structure over a limit; kind says which.
enum ImapDataLimitExceeded is Error = (kind(kind is string));

// One token; used inside mail/imap_data.
object ImapDataToken {
    has kind is ImapTokenKind;
    has bytes is @byte;

    // As given.
    ImapDataToken(kind is ImapTokenKind, bytes is @byte) {
        self.kind = kind;
        self.bytes = bytes;
    }

    // Its kind.
    kind() is ImapTokenKind {
        kind;
    }

    // Its bytes.
    bytes() is @byte {
        bytes;
    }
}

// Tokens gathered while scanning.
object ImapDataTokens {
    has entries is MimeItems<ImapDataToken>;
    has count is int;
    has limits is ImapDataLimits;

    // None yet, within limits.
    ImapDataTokens(limits is ImapDataLimits) {
        let empty is MimeItems<ImapDataToken> = MimeItems();
        entries = empty;
        count = 0;
        self.limits = limits;
    }

    // These tokens and one more.
    following(token is ImapDataToken) is ^ImapDataTokens {
        confirm count < limits::Limits::tokens else throw ImapDataLimitExceeded.kind("tokens");
        let appended = entries.following(token);
        ^entries = appended;
        ^count = count + 1;
    }

    // The tokens.
    entries() is @ImapDataToken {
        entries.entries();
    }
}

hidden object ImapDataParsing {
    has origin is ImapResponse;
    has limits is ImapDataLimits;

    ImapDataParsing(origin is ImapResponse, limits is ImapDataLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    entries() is @ImapValue {
        confirm origin.kind() == ImapResponseKind.untagged
            else throw InvalidImapData.because("data requires an untagged response");
        let name = origin.name();
        confirm name != "OK" && name != "NO" && name != "BAD" && name != "BYE" && name != "PREAUTH"
            else throw InvalidImapData.because("status text is not structured data");
        let tokens = ImapDataTokens(limits);
        let parts = origin.parts();
        for (0..parts.size()) -> index {
            let part = parts.item(index);
            if part.kind() == ImapResponsePartKind.text {
                let text = Utf8Decoded(part.bytes()).string();
                confirm text.length() >= 2
                    else throw InvalidImapData.because("missing syntax CRLF");
                if index > 0
                    && parts.item(index - 1).kind() != ImapResponsePartKind.text
                    && text.length() > 2 {
                        confirm text.slice(0, 1) == " " || text.slice(0, 1) == ")"
                            else throw InvalidImapData.because(
                                "literal requires a following separator"
                            );
                    }
                let end = MimePosition(text.length() - 2);
                if index + 1 < parts.size()
                    && parts.item(index + 1).kind() != ImapResponsePartKind.text {
                        // The framing layer already validated the terminal literal marker.
                        let start = MimePosition(end.index());
                        loop {
                            last if start.index() == 0
                                || text.slice(start.index() - 1, start.index()) == "{";
                            start = start.following(start.index() - 1);
                        }
                        confirm start.index() > 0
                            else throw InvalidImapData.because("literal payload without marker");
                        end = end.following(start.index() - 1);
                        if end.index() > 0 && text.slice(end.index() - 1, end.index()) == "~" {
                            end = end.following(end.index() - 1);
                        }
                    }
                tokens = ImapDataLexing(origin: text.slice(0, end.index()), initial: tokens).tokens();
            }
            else {
                let kind = if part.kind() == ImapResponsePartKind.literal {
                    ImapTokenKind.literal;
                }
                else {
                    ImapTokenKind.literal8;
                };
                tokens = tokens.following(ImapDataToken(kind: kind, bytes: part.bytes()));
            }
        }
        let flat = tokens.entries();
        let values is MimeItems<ImapValue> = MimeItems();
        let position = MimePosition(0);
        let parser = ImapDataTree(tokens: flat, limits: limits);
        loop {
            last if position.index() == flat.size();
            let parsed = parser.item(position.index(), 0);
            values = values.following(parsed.parsed());
            position = position.following(parsed.after());
        }
        let result = values.entries();
        confirm result.size() >= 2
            && result[0].kind() == ImapValueKind.atom
            && result[0].string() == "*"
            else throw InvalidImapData.because("missing untagged data prefix");
        result;
    }
}

// Scans response text into tokens.
object ImapDataLexing {
    has origin is string;
    has initial is ImapDataTokens;

    // Scans origin after initial.
    ImapDataLexing(origin is string, initial is ImapDataTokens) {
        self.origin = origin;
        self.initial = initial;
    }

    // The tokens.
    tokens() is ImapDataTokens {
        let tokens = initial;
        let at = MimePosition(0);
        loop {
            let start = at.index();
            last if start == origin.length();
            let char = origin.slice(start, start + 1);
            if char == " " {
                at = at.following(start + 1);
                next;
            }
            if char == "(" || char == ")" {
                let kind = if char == "(" {
                    ImapTokenKind.opening;
                }
                else {
                    ImapTokenKind.closing;
                };
                tokens = tokens.following(ImapDataToken(kind: kind, bytes: []));
                at = at.following(start + 1);
                next;
            }
            if char == "\"" {
                let buffer = ByteBuffer();
                defer buffer.closing().close();
                at = at.following(start + 1);
                loop {
                    confirm at.index() < origin.length()
                        else throw InvalidImapData.because("unterminated quoted value");
                    let raw = origin.slice(at.index(), at.index() + 1);
                    at = at.following(at.index() + 1);
                    last if raw == "\"";
                    let current = if raw == "\\" {
                        confirm at.index() < origin.length()
                            else throw InvalidImapData.because("unterminated escape");
                        let escaped = origin.slice(at.index(), at.index() + 1);
                        confirm escaped == "\"" || escaped == "\\"
                            else throw InvalidImapData.because("invalid quoted escape");
                        at = at.following(at.index() + 1);
                        escaped;
                    }
                    else {
                        raw;
                    };
                    buffer.writing().write(Utf8Encoded(current).bytes());
                }
                confirm at.index() == origin.length()
                    || origin.slice(at.index(), at.index() + 1) == " "
                    || origin.slice(at.index(), at.index() + 1) == ")"
                    else throw InvalidImapData.because(
                        "quoted value requires a following separator"
                    );
                tokens = tokens.following(
                    ImapDataToken(kind: ImapTokenKind.quoted, bytes: buffer.content().bytes())
                );
                next;
            }
            let brackets = MimePosition(0);
            loop {
                last if at.index() == origin.length();
                let current = origin.slice(at.index(), at.index() + 1);
                last if brackets.index() == 0
                    && (current == " " || current == "(" || current == ")");
                confirm current != "\"" && current != "{" && current != "}" && current != "\t"
                    else throw InvalidImapData.because("invalid data atom");
                if current == "[" {
                    brackets = brackets.following(brackets.index() + 1);
                }
                if current == "]" {
                    confirm brackets.index() > 0
                        else throw InvalidImapData.because("unmatched section bracket");
                    brackets = brackets.following(brackets.index() - 1);
                }
                at = at.following(at.index() + 1);
            }
            confirm brackets.index() == 0
                else throw InvalidImapData.because("unterminated section bracket");
            tokens = tokens.following(
                ImapDataToken(
                    kind: ImapTokenKind.atom,
                    bytes: Utf8Encoded(origin.slice(start, at.index())).bytes()
                )
            );
        }
        tokens;
    }
}

// Builds values from tokens.
object ImapDataTree {
    has tokens is @ImapDataToken;
    has limits is ImapDataLimits;

    // Over tokens, within limits.
    ImapDataTree(tokens is @ImapDataToken, limits is ImapDataLimits) {
        self.tokens = tokens;
        self.limits = limits;
    }

    // The value starting at at, depth deep.
    item(at is int, depth is int) is ImapParsedValue {
        confirm at < tokens.size() else throw InvalidImapData.because("missing data value");
        let token = tokens[at];
        confirm token.kind() != ImapTokenKind.closing
            else throw InvalidImapData.because("unexpected closing parenthesis");
        if token.kind() == ImapTokenKind.opening {
            confirm depth < limits::Limits::depth else throw ImapDataLimitExceeded.kind("depth");
            let values is MimeItems<ImapValue> = MimeItems();
            let position = MimePosition(at + 1);
            loop {
                confirm position.index() < tokens.size()
                    else throw InvalidImapData.because("unterminated data list");
                last if tokens[position.index()].kind() == ImapTokenKind.closing;
                let parsed = self.item(position.index(), depth + 1);
                values = values.following(parsed.parsed());
                position = position.following(parsed.after());
            }
            return ImapParsedValue(
                value: ImapValue(ImapValueKind.list, [], values.entries()),
                after: position.index() + 1
            );
        }
        let kind = match token.kind() {
            case ImapTokenKind.atom {
                ImapValueKind.atom;
            }
            case ImapTokenKind.quoted {
                ImapValueKind.quoted;
            }
            case ImapTokenKind.literal {
                ImapValueKind.literal;
            }
            case ImapTokenKind.literal8 {
                ImapValueKind.literal8;
            }
            else {
                throw InvalidImapData.because("invalid scalar token");
            }
        };
        ImapParsedValue(value: ImapValue(kind, token.bytes(), []), after: at + 1);
    }
}

// A value and where parsing goes on.
object ImapParsedValue {
    has value is ImapValue;
    has after is int;

    // As given.
    ImapParsedValue(value is ImapValue, after is int) {
        self.value = value;
        self.after = after;
    }

    // The value.
    parsed() is ImapValue {
        value;
    }

    // The next token index.
    after() is int {
        after;
    }
}

// ASCII uppercase.
object ImapDataUpper {
    has origin is string;

    // The text.
    ImapDataUpper(origin is string) {
        self.origin = origin;
    }

    // origin with a-z raised.
    string() is string {
        let bytes is @byte = Utf8Encoded(origin).bytes().map() -> octet {
            let code = octet.int();
            if code >= 97 && code <= 122 {
                (code - 32).byte();
            }
            else {
                octet;
            }
        };
        Utf8Decoded(bytes).string();
    }
}

test "data distinguishes NIL, empty string and empty list" {
    let values = ParsedImapData(
        ParsedImapResponse(Utf8Encoded("* ID (NIL \"\" ())\r\n").bytes()).response()
    ).entries().item(2).entries();
    test.is(values.item(0).absent(), true);
    test.is(values.item(1).absent(), false);
    test.is(values.item(2).entries().size(), 0);
}
