module mail/imap_session v1.0.0;

// Session state above an already authenticated owned command channel.
// This constructor is protocol infrastructure; it performs no authentication
// and does not assert that the supplied transport has verified TLS.
// Selection and observation updates share one lock with each whole operation.

import "mail/imap" take ImapCapabilities, ImapFeature;
import "mail/imap_exchange" take ImapCommandChannel, ImapChannelClosed;
import "mail/imap_command" take ImapCommand, ImapMailboxCommand, ImapDatum, FlagChange;
import "mail/imap_command_reading" take ImapCommandRead, ImapTag, ImapResponseObserving;
import "mail/imap_response" take ImapResponse;
import "mail/imap_name" take ImapMailboxName;
import "mail/imap_state" take ImapMailboxState;
import "mail/imap_metadata" take ImapMailbox, ImapSearchResult, ImapUnsigned, ImapStatusCode,
    ImapUidRanges;
import "mail/imap_data" take ParsedImapData, ImapValueKind, InvalidImapData;
import "mail/imap_message" take ImapFetch, ImapMessage, MissingImapDatum;
import "mail/imap_search" take MailMatching;
import "mail/imap_uid" take ImapUidSet, ImapUidSetLimits, ImapUidValidity, ImapUid, ImapSequence,
    MailboxUids, StaleImapUids;
import "mail/mailbox" take MailFlags;
import "collections/sequence" take Sequencing;
import "mime/media_type" take MimeItems;
import "numbers/bigint" take BigInt;
import "compare" take Order;
import "async/lock" take Lock, LockGuard;
import "async/channel" take Channel, Sending, ChannelClosed;
import "async/scope" take FutureGroup;
import "async/event" take Event;
import "io/stream" take Closing;
import "error" take InvalidState, InvalidArgument, UnsupportedOperation;
import "mail/message" take MailMessage;

object ImapSession does Closing {
    has origin is ImapCommandChannel;
    has capabilities is ImapCapabilities;
    has account is string;
    has lock is Lock;
    has states is Channel<ImapSessionState>;
    has initial is Future<Sending<ImapSessionState>>;
    has idle_control is Lock;
    has idle_slots is Channel<ImapIdleSlot>;
    has idle_initial is Future<Sending<ImapIdleSlot>>;

    ImapSession(origin is ImapCommandChannel, capabilities is ImapCapabilities, account is string) {
        confirm account.length() > 0 && account.length() <= 4096
            else throw InvalidArgument.because("IMAP account scope must contain 1..4096 characters");
        confirm capabilities.features().membership(ImapFeature.imap4rev1)
            && !capabilities.features().membership(ImapFeature.utf8_only)
            else throw UnsupportedOperation.because(
                "this session requires the IMAP4rev1 modified UTF-7 wire mode"
            );
        self.origin = origin;
        self.capabilities = capabilities;
        self.account = account;
        lock = Lock();
        let channel is Channel<ImapSessionState> = Channel(1);
        states = channel;
        initial = channel.sending().send(ImapSessionState());
        idle_control = Lock();
        let slots is Channel<ImapIdleSlot> = Channel(1);
        idle_slots = slots;
        idle_initial = slots.sending().send(ImapIdleSlot());
    }

    capabilities() is ImapCapabilities {
        capabilities;
    }

    account() is string {
        account;
    }

    event_capacity() is int {
        origin.limits()::Limits::responses;
    }

    closed() is bool {
        origin.closed();
    }

    close() is void {
        states.sending().close();
        idle_slots.sending().close();
        origin.close();
    }

    abort() is void {
        try {
            self.close();
        }
        catch failure is Error {}
        catch failure is NativeFailure {}
    }

    async mailboxes() is Sequencing<ImapMailbox> {
        let reply = await self.run(
            ImapCommand(
                reference: ImapMailboxName(""),
                pattern: ImapMailboxName("*"),
                subscribed: false
            ),
            [],
            [],
            false
        );
        let read = reply.read();
        read.require_success();
        let source = read.responses();
        let boxes is MimeItems<ImapMailbox> = MimeItems();
        for (0..source.size()) -> index {
            let response = source.item(index);
            if response.name() == "LIST" {
                boxes = boxes.following(ImapMailbox(response));
            }
        }
        boxes.entries();
    }

    async mailbox(name is ImapMailboxName) is SelectedMailbox {
        await self.select(name, false);
    }

    async examine(name is ImapMailboxName) is SelectedMailbox {
        await self.select(name, true);
    }

    async select(name is ImapMailboxName, read_only is bool) is SelectedMailbox {
        confirm !self.closed() else throw ImapChannelClosed.closed;
        await initial;
        let guard = await self.entry();
        defer guard.close();
        confirm !self.closed() else throw ImapChannelClosed.closed;
        let completed = Event();
        let cleanup = ImapSessionCleanup(origin: self, completed: completed);
        defer cleanup.close();
        let state = await states.receiving().item();
        state = state.cleared();
        let action = if read_only {
            ImapMailboxCommand.examine;
        }
        else {
            ImapMailboxCommand.select;
        };
        let result = await origin.request(ImapCommand(operation: action, mailbox: name)).read();
        if !result.successful() {
            await states.sending().send(state);
            completed.set();
            result.require_success();
        }
        let snapshot = ImapMailboxState(result: result, read_only: read_only);
        state = state.selected(name, snapshot);
        let token = state.selection().token();
        await states.sending().send(state);
        completed.set();
        SelectedMailbox(origin: self, token: token);
    }

    async observation(token is ImapSelectionToken) is ImapMailboxState {
        confirm !self.closed() else throw ImapChannelClosed.closed;
        await initial;
        let guard = await self.entry();
        defer guard.close();
        confirm !self.closed() else throw ImapChannelClosed.closed;
        let completed = Event();
        let cleanup = ImapSessionCleanup(origin: self, completed: completed);
        defer cleanup.close();
        let state = await states.receiving().item();
        try {
            state.require_selection(token);
        }
        catch failure is Error {
            await states.sending().send(state);
            completed.set();
            throw;
        }
        let result = state.selection().state();
        await states.sending().send(state);
        completed.set();
        result;
    }

    async run(
        command is ImapCommand,
        selected is @ImapSelectionToken,
        validity is @ImapUidValidity,
        writable is bool
    ) is ImapSessionReply {
        confirm !self.closed() else throw ImapChannelClosed.closed;
        await initial;
        let guard = await self.entry();
        defer guard.close();
        confirm !self.closed() else throw ImapChannelClosed.closed;
        let completed = Event();
        let cleanup = ImapSessionCleanup(origin: self, completed: completed);
        defer cleanup.close();
        let state = await states.receiving().item();
        try {
            confirm selected.size() <= 1 && validity.size() <= 1
                else throw InvalidState.because("invalid selected operation context");
            if selected.size() > 0 {
                state.require_selection(selected[0]);
                let current = state.selection().state();
                if validity.size() > 0 {
                    confirm current.uid_validity().order(validity[0]) == Order.equal
                        else throw StaleImapUids.stale;
                }
                confirm !writable || !current.read_only()
                    else throw InvalidState.because("selected mailbox is read-only");
            }
            else {
                confirm !writable && validity.size() == 0
                    else throw InvalidState.because("operation requires a selected mailbox");
            }
            if command.name() == "UID" {
                let operation = command.uid_operation();
                let features = capabilities.features();
                if operation == "MOVE" {
                    confirm features.membership(ImapFeature.move)
                        else throw UnsupportedOperation.because(
                            "IMAP MOVE is not supported; no implicit copy/delete fallback"
                        );
                }
                if operation == "EXPUNGE" {
                    confirm features.membership(ImapFeature.uid_plus)
                        else throw UnsupportedOperation.because(
                            "targeted IMAP EXPUNGE requires UIDPLUS in this wire mode"
                        );
                }
            }
        }
        catch failure is Error {
            await states.sending().send(state);
            completed.set();
            throw;
        }
        let result = await origin.request(command).read();
        let responses = result.responses();
        for (0..responses.size()) -> index {
            state = state.observed(responses.item(index));
        }
        state = state.observed(result.completion());
        if result.successful() && (command.name() == "RENAME" || command.name() == "DELETE") {
            state = state.cleared();
        }
        let selections = state.selections();
        await states.sending().send(state);
        completed.set();
        ImapSessionReply(result: result, selection: selections);
    }

    async entry() is LockGuard {
        confirm !self.closed() else throw ImapChannelClosed.closed;
        await idle_initial;
        let control = await idle_control.guard();
        defer control.close();
        let complete = Event();
        let cleanup = ImapSessionCleanup(origin: self, completed: complete);
        defer cleanup.close();
        let slot = await idle_slots.receiving().item();
        if slot.active() {
            slot.task().stop();
            try {
                await slot.task().outcome();
            }
            catch failure is Error {
                if self.closed() {
                    throw;
                }
            }
        }
        await idle_slots.sending().send(ImapIdleSlot());
        complete.set();
        // Keep the control lock until this acquisition, preventing an IDLE
        // registration from slipping between stop and the next command.
        await lock.guard();
    }

    async activate_idle(
        token is ImapSelectionToken,
        events is Sending<MailboxEvent>,
        stop is Event,
        finished is Event
    ) is ImapIdleTask {
        confirm !self.closed() else throw ImapChannelClosed.closed;
        confirm capabilities.features().membership(ImapFeature.idle)
            else throw UnsupportedOperation.because("IMAP IDLE is not advertised");
        await idle_initial;
        let control = await idle_control.guard();
        defer control.close();
        let complete = Event();
        let cleanup = ImapSessionCleanup(origin: self, completed: complete);
        defer cleanup.close();
        let slot = await idle_slots.receiving().item();
        if slot.active() {
            slot.task().stop();
            try {
                await slot.task().outcome();
            }
            catch failure is Error {
                if self.closed() {
                    throw;
                }
            }
        }
        let task = ImapIdleTask(
            origin: self,
            token: token,
            events: events,
            stop: stop,
            finished: finished
        );
        await idle_slots.sending().send(ImapIdleSlot(task));
        task.start();
        complete.set();
        task;
    }

    async idle_run(
        token is ImapSelectionToken,
        events is Sending<MailboxEvent>,
        stop is Event,
        finished is Event
    ) is int {
        let ending = ImapIdleEnding(events: events, finished: finished);
        defer ending.close();
        if stop.ready() {
            return 0;
        }
        confirm !self.closed() else throw ImapChannelClosed.closed;
        await initial;
        let guard = await lock.guard();
        defer guard.close();
        if stop.ready() {
            return 0;
        }
        confirm !self.closed() else throw ImapChannelClosed.closed;
        let completed = Event();
        let cleanup = ImapSessionCleanup(origin: self, completed: completed);
        defer cleanup.close();
        let state = await states.receiving().item();
        try {
            state.require_selection(token);
        }
        catch failure is Error {
            await states.sending().send(state);
            completed.set();
            throw;
        }
        let observer = ImapEventObservation(state: state.selection().state(), events: events);
        let replies = await origin.idle(stop, observer);
        if replies.size() > 0 {
            let result = replies[0];
            let responses = result.responses();
            for (0..responses.size()) -> index {
                state = state.observed(responses.item(index));
            }
            state = state.observed(result.completion());
        }
        await states.sending().send(state);
        completed.set();
        if replies.size() > 0 {
            replies[0].require_success();
        }
        1;
    }

    destroy {
        self.abort();
    }

    // Mailboxes as actions: await session.created(name), renamed(name, to:),
    // deleted(name); appended(mailbox, message:, flags:) stores a message.
    async created(name is ImapMailboxName) is ImapMailboxName {
        await CreatedImapMailbox(origin: self, name: name).mailbox();
    }

    async renamed(name is ImapMailboxName, to is ImapMailboxName) is ImapMailboxName {
        await RenamedImapMailbox(origin: self, source: name, destination: to).mailbox();
    }

    async deleted(name is ImapMailboxName) is ImapMailboxName {
        await ImapMailboxDeletion(origin: self, name: name).delete();
    }

    async appended(mailbox is ImapMailboxName, message is MailMessage, flags is MailFlags) is ImapAssignedUids {
        await AppendedMail(origin: self, mailbox: mailbox, message: message, flags: flags).uids();
    }
}

object SelectedMailbox does Closing {
    has origin is ImapSession;
    has token is ImapSelectionToken;

    SelectedMailbox(origin is ImapSession, token is ImapSelectionToken) {
        self.origin = origin;
        self.token = token;
    }

    name() is ImapMailboxName {
        token.name();
    }

    closed() is bool {
        origin.closed() || token.closed();
    }

    // Synchronous close aborts transport; it never sends expunging CLOSE.
    close() is void {
        origin.close();
    }

    async state() is ImapMailboxState {
        await origin.observation(token);
    }

    session() is ImapSession {
        origin;
    }

    context() is ImapSelectionToken {
        token;
    }

    // Mailbox changes as actions: await box.copied(uids, to: archive).
    async copied(uids is MailboxUids, to is ImapMailboxName) is ImapCopiedUids {
        await CopiedMail(origin: self, uids: uids, destination: to).uids();
    }

    async moved(uids is MailboxUids, to is ImapMailboxName) is ImapCopiedUids {
        await MovedMail(origin: self, uids: uids, destination: to).uids();
    }

    async expunged(uids is MailboxUids) is Sequencing<ImapSequence> {
        await ExpungedMail(origin: self, uids: uids).identifiers();
    }
}

object ImapSelectionToken {
    has name is ImapMailboxName;
    has generation is BigInt;
    has stopped is Event;

    ImapSelectionToken(name is ImapMailboxName, generation is BigInt) {
        self.name = name;
        self.generation = generation;
        stopped = Event();
    }

    name() is ImapMailboxName {
        name;
    }

    generation() is BigInt {
        generation;
    }

    closed() is bool {
        stopped.ready();
    }

    expire() is void {
        stopped.set();
    }
}

object ImapSelectedState {
    has token is ImapSelectionToken;
    has value is ImapMailboxState;

    ImapSelectedState(token is ImapSelectionToken, value is ImapMailboxState) {
        self.token = token;
        self.value = value;
    }

    token() is ImapSelectionToken {
        token;
    }

    state() is ImapMailboxState {
        value;
    }

    observed(response is ImapResponse) is ^ImapSelectedState {
        let updated = value.observed(response);
        ^value = updated;
    }
}

hidden object ImapSessionState {
    has serial is BigInt;
    has selection is @ImapSelectedState;

    ImapSessionState() {
        serial = BigInt(0);
        selection = [];
    }

    selections() is @ImapSelectedState {
        selection;
    }

    selection() is ImapSelectedState {
        confirm selection.size() == 1 else throw InvalidState.because("no IMAP mailbox selected");
        selection[0];
    }

    require_selection(token is ImapSelectionToken) is void {
        confirm !token.closed()
            && selection.size() == 1
            && selection[0].token().generation().order(token.generation()) == Order.equal
            else throw InvalidState.because("IMAP selection is no longer active");
    }

    cleared() is ^ImapSessionState {
        if selection.size() > 0 {
            selection[0].token().expire();
        }
        ^selection = [];
    }

    selected(name is ImapMailboxName, value is ImapMailboxState) is ^ImapSessionState {
        let following = (serial + BigInt(1));
        let token = ImapSelectionToken(name: name, generation: following);
        ^serial = following;
        ^selection = [ImapSelectedState(token: token, value: value)];
    }

    observed(response is ImapResponse) is ^ImapSessionState {
        if selection.size() > 0 {
            let updated = selection[0].observed(response);
            ^selection = [updated];
        }
    }
}

object ImapSessionReply {
    has result is ImapCommandRead;
    has selection is @ImapSelectedState;

    ImapSessionReply(result is ImapCommandRead, selection is @ImapSelectedState) {
        self.result = result;
        self.selection = selection;
    }

    read() is ImapCommandRead {
        result;
    }

    state() is ImapMailboxState {
        confirm selection.size() == 1 else throw InvalidState.because("no IMAP mailbox selected");
        selection[0].state();
    }
}

hidden object ImapSessionCleanup {
    has origin is ImapSession;
    has completed is Event;

    ImapSessionCleanup(origin is ImapSession, completed is Event) {
        self.origin = origin;
        self.completed = completed;
    }

    close() is void {
        if !completed.ready() {
            origin.abort();
        }
    }
}

object SearchedMail {
    has pending is Future<MailboxUids>;

    SearchedMail(origin is SelectedMailbox, matching is MailMatching) {
        pending = ImapSearching(origin: origin, command: ImapCommand(matching: matching)).read();
    }

    uids() is Future<MailboxUids> {
        pending;
    }
}

hidden object ImapSearching {
    has origin is SelectedMailbox;
    has command is ImapCommand;

    ImapSearching(origin is SelectedMailbox, command is ImapCommand) {
        self.origin = origin;
        self.command = command;
    }

    async read() is MailboxUids {
        let before = await origin.state();
        let epoch = before.uid_validity();
        let reply = await origin.session().run(command, [origin.context()], [epoch], false);
        let result = reply.read();
        result.require_success();
        // Do not relabel identifiers with a new epoch if UIDVALIDITY changed
        // while the server was producing this SEARCH result.
        confirm reply.state().uid_validity().order(epoch) == Order.equal
            else throw StaleImapUids.stale;
        let responses = result.responses();
        let matches is MimeItems<ImapUidSet> = MimeItems();
        for (0..responses.size()) -> index {
            let response = responses.item(index);
            if response.name() == "SEARCH" || response.name() == "ESEARCH" {
                matches = matches.following(
                    ImapSearchResult(
                        origin: response,
                        tag: ImapTag(result.completion().tag()),
                        limits: ImapUidSetLimits()
                    ).uids()
                );
            }
        }
        let values = matches.entries();
        confirm values.size() == 1
            else throw InvalidState.because("UID SEARCH requires exactly one result");
        confirm reply.state().persistent_uids()
            else throw UnsupportedOperation.because(
                "UIDNOTSTICKY cannot produce reusable mailbox UID snapshots"
            );
        MailboxUids(
            mailbox: origin.name(),
            validity: reply.state().uid_validity(),
            uids: values[0],
            account: origin.session().account()
        );
    }
}

object FetchedMail {
    has pending is Future<Sequencing<ImapMessage>>;

    FetchedMail(origin is SelectedMailbox, uids is MailboxUids, data is Sequencing<ImapDatum>) {
        let ids = uids.checked(origin.name(), uids.validity(), origin.session().account());
        pending = ImapFetching(
            origin: origin,
            uids: uids,
            command: ImapCommand(uids: ids, data: data),
            writable: false
        ).read();
    }

    messages() is Future<Sequencing<ImapMessage>> {
        pending;
    }
}

object ChangedMailFlags {
    has pending is Future<Sequencing<ImapMessage>>;

    ChangedMailFlags(
        origin is SelectedMailbox,
        uids is MailboxUids,
        flags is MailFlags,
        change is FlagChange
    ) {
        let ids = uids.checked(origin.name(), uids.validity(), origin.session().account());
        pending = ImapFetching(
            origin: origin,
            uids: uids,
            command: ImapCommand(uids: ids, flags: flags, change: change),
            writable: true
        ).read();
    }

    messages() is Future<Sequencing<ImapMessage>> {
        pending;
    }
}

hidden object ImapFetching {
    has origin is SelectedMailbox;
    has uids is MailboxUids;
    has command is ImapCommand;
    has writable is bool;

    ImapFetching(
        origin is SelectedMailbox,
        uids is MailboxUids,
        command is ImapCommand,
        writable is bool
    ) {
        self.origin = origin;
        self.uids = uids;
        self.command = command;
        self.writable = writable;
    }

    async read() is Sequencing<ImapMessage> {
        let reply = await origin.session().run(
            command,
            [origin.context()],
            [uids.validity()],
            writable
        );
        let result = reply.read();
        result.require_success();
        uids.checked(origin.name(), reply.state().uid_validity(), origin.session().account());
        let responses = result.responses();
        let messages is MimeItems<ImapMessage> = MimeItems();
        let wanted = uids.uids().entries();
        for (0..responses.size()) -> index {
            let response = responses.item(index);
            if response.name() == "FETCH" {
                let fetch = ImapFetch(response);
                if fetch.has_uid() {
                    let present = (0..wanted.size()).reduce(false) -> found, position {
                        found || wanted.item(position).order(fetch.uid()) == Order.equal;
                    };
                    if present {
                        messages = messages.following(ImapMessage(response));
                    }
                }
            }
        }
        messages.entries();
    }
}

enum MailboxEventKind = (exists, recent, expunge, flags, fetch, status, other);

object MailboxEvent {
    has response is ImapResponse;
    has state is ImapMailboxState;

    MailboxEvent(response is ImapResponse, state is ImapMailboxState) {
        self.response = response;
        self.state = state;
    }

    response() is ImapResponse {
        response;
    }

    state() is ImapMailboxState {
        state;
    }

    sequence() is ImapSequence {
        if response.name() == "FETCH" {
            return ImapFetch(response).sequence();
        }
        if response.name() == "EXPUNGE" {
            let values = ParsedImapData(response).entries();
            return ImapSequence(ImapUnsigned(origin: values.item(1).string(), nonzero: true).int());
        }
        throw MissingImapDatum.name("sequence");
    }

    uid() is ImapUid {
        confirm response.name() == "FETCH" else throw MissingImapDatum.name("UID");
        ImapFetch(response).uid();
    }

    flags() is MailFlags {
        confirm response.name() == "FETCH" else throw MissingImapDatum.name("FLAGS");
        ImapFetch(response).flags();
    }

    kind() is MailboxEventKind {
        match response.name() {
            case "EXISTS" {
                MailboxEventKind.exists;
            }
            case "RECENT" {
                MailboxEventKind.recent;
            }
            case "EXPUNGE" {
                MailboxEventKind.expunge;
            }
            case "FLAGS" {
                MailboxEventKind.flags;
            }
            case "FETCH" {
                MailboxEventKind.fetch;
            }
            case "OK", "NO", "BAD" {
                MailboxEventKind.status;
            }
            else {
                MailboxEventKind.other;
            }
        }
    }
}

object MailboxEvents {
    has origin is SelectedMailbox;
    has stop, finished, begun is Event;
    has events is Channel<MailboxEvent>;
    has activation is Future<ImapIdleTask>;

    MailboxEvents(origin is SelectedMailbox) {
        self.origin = origin;
        let stopped = Event();
        stop = stopped;
        let done = Event();
        finished = done;
        begun = Event();
        let channel is Channel<MailboxEvent> = Channel(origin.session().event_capacity());
        events = channel;
        activation = origin.session().activate_idle(
            origin.context(),
            channel.sending(),
            stopped,
            done
        );
    }

    closed() is bool {
        finished.ready() || origin.closed();
    }

    async event() is MailboxEvent {
        if self.closed() {
            if begun.ready() {
                let task = await activation;
                await task.outcome();
            }
            throw MailboxEventsClosed.closed;
        }
        begun.set();
        let task = try {
            await activation;
        }
        catch failure is Error {
            finished.set();
            events.sending().close();
            throw;
        };
        try {
            await events.receiving().item();
        }
        catch failure is ChannelClosed {
            await task.outcome();
            throw MailboxEventsClosed.closed;
        }
    }

    async next() is MailboxEvent {
        await self.event();
    }

    async close() is MailboxEvents {
        stop.set();
        if !begun.ready() {
            finished.set();
            activation.cancel();
            events.sending().close();
            return self;
        }
        let task = await activation;
        await task.outcome();
        self;
    }

    destroy {
        stop.set();
        if begun.ready() && !finished.ready() {
            origin.session().abort();
        }
    }
}

enum MailboxEventsClosed is Error = (closed);

object ImapIdleTask {
    has stop is Event;
    has started is Event;
    has pending is Future<int>;
    has group is FutureGroup<int>;

    ImapIdleTask(
        origin is ImapSession,
        token is ImapSelectionToken,
        events is Sending<MailboxEvent>,
        stop is Event,
        finished is Event
    ) {
        self.stop = stop;
        started = Event();
        let children is FutureGroup<int> = FutureGroup();
        group = children;
        pending = origin.idle_run(token, events, stop, finished);
    }

    start() is void {
        if !started.ready() {
            started.set();
            group.start(pending);
        }
    }

    stop() is void {
        stop.set();
    }

    outcome() is Future<int> {
        pending;
    }
}

hidden object ImapIdleSlot {
    has values is @ImapIdleTask;

    ImapIdleSlot() {
        values = [];
    }

    ImapIdleSlot(task is ImapIdleTask) {
        values = [task];
    }

    active() is bool {
        values.size() > 0;
    }

    task() is ImapIdleTask {
        confirm self.active() else throw InvalidState.because("no active IDLE operation");
        values[0];
    }
}

hidden object ImapIdleEnding {
    has events is Sending<MailboxEvent>;
    has finished is Event;

    ImapIdleEnding(events is Sending<MailboxEvent>, finished is Event) {
        self.events = events;
        self.finished = finished;
    }

    close() is void {
        events.close();
        finished.set();
    }
}

object ImapEventObservation does ImapResponseObserving {
    has states is Channel<ImapMailboxState>;
    has initial is Future<Sending<ImapMailboxState>>;
    has events is Sending<MailboxEvent>;

    ImapEventObservation(state is ImapMailboxState, events is Sending<MailboxEvent>) {
        let channel is Channel<ImapMailboxState> = Channel(1);
        states = channel;
        initial = channel.sending().send(state);
        self.events = events;
    }

    async observed(response is ImapResponse) is int {
        await initial;
        let state = await states.receiving().item();
        state = state.observed(response);
        await states.sending().send(state);
        await events.send(MailboxEvent(response: response, state: state));
        1;
    }
}

// Changes to mailboxes and messages (formerly mail/imap_changes).

object ImapAssignedUids {
    has values is @MailboxUids;

    ImapAssignedUids() {
        values = [];
    }

    ImapAssignedUids(value is MailboxUids) {
        values = [value];
    }

    known() is bool {
        values.size() > 0;
    }

    uids() is MailboxUids {
        confirm self.known() else throw MissingAssignedImapUids.missing;
        values[0];
    }
}

enum MissingAssignedImapUids is Error = (missing);

object ImapCopiedUids {
    has sources is ImapUidSet;
    has assigned is ImapAssignedUids;

    ImapCopiedUids(
        result is ImapCommandRead,
        requested is ImapUidSet,
        destination is ImapMailboxName,
        capabilities is ImapCapabilities,
        account is string
    ) {
        result.require_success();
        let code = ImapStatusCode(result.completion());
        if code.present() && code.name() == "COPYUID" {
            ImapUidPlus(capabilities).require();
            let arguments = code.arguments();
            confirm arguments.size() == 3
                && arguments.item(0).kind() == ImapValueKind.atom
                && arguments.item(1).kind() == ImapValueKind.atom
                && arguments.item(2).kind() == ImapValueKind.atom
                else throw InvalidImapData.because("invalid COPYUID code");
            let validity = ImapUidValidity(
                BigInt(
                    ImapUnsigned(origin: arguments.item(0).string(), nonzero: true).int().string()
                )
            );
            let source = ImapUidRanges(
                origin: arguments.item(1).string(),
                limits: ImapUidSetLimits()
            );
            let target = ImapUidRanges(
                origin: arguments.item(2).string(),
                limits: ImapUidSetLimits()
            );
            let from = source.uids();
            let to = target.uids();
            confirm from.entries().size() == to.entries().size()
                && source.expanded_count() == from.entries().size()
                && target.expanded_count() == to.entries().size()
                else throw InvalidImapData.because("COPYUID mapping must be one-to-one");
            let wanted = requested.entries();
            let actual = from.entries();
            for (0..actual.size()) -> index {
                let exists = (0..wanted.size()).reduce(false) -> found, position {
                    found || wanted.item(position).order(actual.item(index)) == Order.equal;
                };
                confirm exists
                    else throw InvalidImapData.because("COPYUID source was not requested");
            }
            sources = from;
            assigned = ImapAssignedUids(
                MailboxUids(mailbox: destination, validity: validity, uids: to, account: account)
            );
        }
        else {
            sources = ImapUidSet();
            assigned = ImapAssignedUids();
        }
    }

    sources() is ImapUidSet {
        sources;
    }

    assigned() is ImapAssignedUids {
        assigned;
    }
}

hidden object ImapUidPlus {
    has origin is ImapCapabilities;

    ImapUidPlus(origin is ImapCapabilities) {
        self.origin = origin;
    }

    require() is void {
        confirm origin.features().membership(ImapFeature.uid_plus)
            else throw InvalidImapData.because(
                "UID assignment without UIDPLUS advertisement in this wire mode"
            );
    }
}

object CopiedMail {
    has pending is Future<ImapCopiedUids>;

    CopiedMail(origin is SelectedMailbox, uids is MailboxUids, destination is ImapMailboxName) {
        pending = ImapCopying(origin: origin, uids: uids, destination: destination, move: false).uids();
    }

    uids() is Future<ImapCopiedUids> {
        pending;
    }
}

object MovedMail {
    has pending is Future<ImapCopiedUids>;

    MovedMail(origin is SelectedMailbox, uids is MailboxUids, destination is ImapMailboxName) {
        pending = ImapCopying(origin: origin, uids: uids, destination: destination, move: true).uids();
    }

    uids() is Future<ImapCopiedUids> {
        pending;
    }
}

hidden object ImapCopying {
    has origin is SelectedMailbox;
    has uids is MailboxUids;
    has destination is ImapMailboxName;
    has move is bool;

    ImapCopying(
        origin is SelectedMailbox,
        uids is MailboxUids,
        destination is ImapMailboxName,
        move is bool
    ) {
        uids.checked(origin.name(), uids.validity(), origin.session().account());
        self.origin = origin;
        self.uids = uids;
        self.destination = destination;
        self.move = move;
    }

    async uids() is ImapCopiedUids {
        let reply = await origin.session().run(
            ImapCommand(uids: uids.uids(), destination: destination, move: move),
            [origin.context()],
            [uids.validity()],
            move
        );
        reply.read().require_success();
        uids.checked(origin.name(), reply.state().uid_validity(), origin.session().account());
        ImapCopiedUids(
            result: reply.read(),
            requested: uids.uids(),
            destination: destination,
            capabilities: origin.session().capabilities(),
            account: origin.session().account()
        );
    }
}

object ExpungedMail {
    has pending is Future<Sequencing<ImapSequence>>;

    ExpungedMail(origin is SelectedMailbox, uids is MailboxUids) {
        pending = ImapExpunging(origin: origin, uids: uids).sequences();
    }

    identifiers() is Future<Sequencing<ImapSequence>> {
        pending;
    }
}

hidden object ImapExpunging {
    has origin is SelectedMailbox;
    has uids is MailboxUids;

    ImapExpunging(origin is SelectedMailbox, uids is MailboxUids) {
        uids.checked(origin.name(), uids.validity(), origin.session().account());
        self.origin = origin;
        self.uids = uids;
    }

    async sequences() is Sequencing<ImapSequence> {
        let reply = await origin.session().run(
            ImapCommand(expunged: uids.uids()),
            [origin.context()],
            [uids.validity()],
            true
        );
        let result = reply.read();
        result.require_success();
        uids.checked(origin.name(), reply.state().uid_validity(), origin.session().account());
        let removed is MimeItems<ImapSequence> = MimeItems();
        let responses = result.responses();
        for (0..responses.size()) -> index {
            let response = responses.item(index);
            if response.name() == "EXPUNGE" {
                let values = ParsedImapData(response).entries();
                removed = removed.following(
                    ImapSequence(ImapUnsigned(origin: values.item(1).string(), nonzero: true).int())
                );
            }
        }
        removed.entries();
    }
}

object AppendedMail {
    has pending is Future<ImapAssignedUids>;

    AppendedMail(
        origin is ImapSession,
        mailbox is ImapMailboxName,
        message is MailMessage,
        flags is MailFlags
    ) {
        pending = ImapAppending(
            origin: origin,
            mailbox: mailbox,
            command: ImapCommand(mailbox: mailbox, message: message, flags: flags)
        ).uids();
    }

    uids() is Future<ImapAssignedUids> {
        pending;
    }
}

hidden object ImapAppending {
    has origin is ImapSession;
    has mailbox is ImapMailboxName;
    has command is ImapCommand;

    ImapAppending(origin is ImapSession, mailbox is ImapMailboxName, command is ImapCommand) {
        self.origin = origin;
        self.mailbox = mailbox;
        self.command = command;
    }

    async uids() is ImapAssignedUids {
        let reply = await origin.run(command, [], [], false);
        let result = reply.read();
        result.require_success();
        let code = ImapStatusCode(result.completion());
        if !code.present() || code.name() != "APPENDUID" {
            return ImapAssignedUids();
        }
        ImapUidPlus(origin.capabilities()).require();
        let arguments = code.arguments();
        confirm arguments.size() == 2
            && arguments.item(0).kind() == ImapValueKind.atom
            && arguments.item(1).kind() == ImapValueKind.atom
            else throw InvalidImapData.because("invalid APPENDUID code");
        let validity = ImapUidValidity(
            BigInt(ImapUnsigned(origin: arguments.item(0).string(), nonzero: true).int().string())
        );
        let assigned = ImapUidSet(
            ImapUid(
                BigInt(
                    ImapUnsigned(origin: arguments.item(1).string(), nonzero: true).int().string()
                )
            )
        );
        ImapAssignedUids(
            MailboxUids(
                mailbox: mailbox,
                validity: validity,
                uids: assigned,
                account: origin.account()
            )
        );
    }
}

object CreatedImapMailbox {
    has pending is Future<ImapMailboxName>;

    CreatedImapMailbox(origin is ImapSession, name is ImapMailboxName) {
        pending = ImapMailboxChanging(
            origin: origin,
            name: name,
            command: ImapCommand(operation: ImapMailboxCommand.create, mailbox: name)
        ).mailbox();
    }

    mailbox() is Future<ImapMailboxName> {
        pending;
    }
}

object ImapMailboxDeletion {
    has pending is Future<ImapMailboxName>;

    ImapMailboxDeletion(origin is ImapSession, name is ImapMailboxName) {
        pending = ImapMailboxChanging(
            origin: origin,
            name: name,
            command: ImapCommand(operation: ImapMailboxCommand.delete, mailbox: name)
        ).mailbox();
    }

    delete() is Future<ImapMailboxName> {
        pending;
    }
}

object RenamedImapMailbox {
    has pending is Future<ImapMailboxName>;

    RenamedImapMailbox(
        origin is ImapSession,
        source is ImapMailboxName,
        destination is ImapMailboxName
    ) {
        pending = ImapMailboxChanging(
            origin: origin,
            name: destination,
            command: ImapCommand(source: source, destination: destination)
        ).mailbox();
    }

    mailbox() is Future<ImapMailboxName> {
        pending;
    }
}

object ImapSubscription {
    has pending is Future<ImapMailboxName>;

    ImapSubscription(origin is ImapSession, name is ImapMailboxName, subscribed is bool) {
        let action = if subscribed {
            ImapMailboxCommand.subscribe;
        }
        else {
            ImapMailboxCommand.unsubscribe;
        };
        pending = ImapMailboxChanging(
            origin: origin,
            name: name,
            command: ImapCommand(operation: action, mailbox: name)
        ).mailbox();
    }

    apply() is Future<ImapMailboxName> {
        pending;
    }
}

hidden object ImapMailboxChanging {
    has origin is ImapSession;
    has name is ImapMailboxName;
    has command is ImapCommand;

    ImapMailboxChanging(origin is ImapSession, name is ImapMailboxName, command is ImapCommand) {
        self.origin = origin;
        self.name = name;
        self.command = command;
    }

    async mailbox() is ImapMailboxName {
        let reply = await origin.run(command, [], [], false);
        reply.read().require_success();
        name;
    }
}

test "missing assigned UIDs are explicit rather than fabricated" {
    let assignment = ImapAssignedUids();
    test.is(assignment.known(), false);
    let absent = try {
        assignment.uids();
        false;
    }
    catch failure is MissingAssignedImapUids {
        true;
    };
    test.is(absent, true);
}

test "fresh session state has no selection and zero generation" {
    let state = ImapSessionState();
    test.is(state.selections().size(), 0);
    let cleared = state.cleared();
    test.is(cleared.selections().size(), 0);
}
