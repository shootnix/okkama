module mail/pop3_reply v1.0.0;

// POP3 replies: `+OK` or `-ERR`, and for some commands a multiline body ended
// by a lone dot.
//
//     let reply = ParsedPopReply(origin: bytes, mode: PopReplyMode.multiline).reply();
//     reply::Reply::successful;
//     reply::Reply::body;                  // the lines, dot-unstuffed
//
// A negative reply never has a body. Replies are bounded: 512 bytes of status,
// 1 MiB per line, 16 MiB of body and 100000 lines by default.

import "encoding/single_byte" take Latin1Decoded, Latin1Encoded;
import "encoding/utf" take Utf8Encoded;
import "mime/media_type" take MimePosition;
import "error" take InvalidArgument, InvalidState;

// Whether the reply has a multiline body.
enum PopReplyMode = (single, multiline);

// How large a reply may be.
object PopReplyLimits {
    has status_bytes, line_bytes, body_bytes, wire_bytes, lines is int;

    // 512 bytes of status, 1 MiB per line, 16 MiB of body, 32 MiB on the wire,
    // 100000 lines.
    PopReplyLimits() {
        status_bytes = 512;
        line_bytes = 1048576;
        body_bytes = 16777216;
        wire_bytes = 33554432;
        lines = 100000;
    }

    // The limits as given.
    PopReplyLimits(
        status_bytes is int,
        line_bytes is int,
        body_bytes is int,
        wire_bytes is int,
        lines is int
    ) {
        confirm status_bytes >= 0
            && line_bytes >= 0
            && body_bytes >= 0
            && wire_bytes >= 0
            && lines >= 0
            else throw InvalidArgument.because("POP3 reply limits must be nonnegative");
        self.status_bytes = status_bytes;
        self.line_bytes = line_bytes;
        self.body_bytes = body_bytes;
        self.wire_bytes = wire_bytes;
        self.lines = lines;
    }

    // The limits.
    cap Limits {
        status_bytes is int {
            status_bytes;
        }

        line_bytes is int {
            line_bytes;
        }

        body_bytes is int {
            body_bytes;
        }

        wire_bytes is int {
            wire_bytes;
        }

        lines is int {
            lines;
        }
    }
}

// Snapshot constructor is parser infrastructure, not an unchecked wire writer.
object PopReply {
    has success is bool;
    has summary is string;
    has content is @byte;
    has count is int;
    has multiple is bool;

    // As the parser builds it.
    PopReply(successful is bool, text is string, body is @byte, lines is int, multiline is bool) {
        confirm lines >= 0
            && (multiline || (body.size() == 0 && lines == 0))
            && (successful || !multiline)
            else throw InvalidArgument.because("inconsistent POP3 reply snapshot");
        success = successful;
        summary = text;
        content = body;
        count = lines;
        multiple = multiline;
    }

    // Whether it is +OK, the status text, the body, its line count and whether
    // it was multiline.
    cap Reply {
        successful is bool {
            success;
        }

        text is string {
            summary;
        }

        body is @byte {
            content;
        }

        lines is int {
            count;
        }

        multiline is bool {
            multiple;
        }
    }
}

// Reads a reply from chunks.
object PopReplyDecoder {
    has progress is PopReplyProgress;
    has limits is PopReplyLimits;
    has tail is @byte;

    // Nothing read yet, the default limits.
    PopReplyDecoder(mode is PopReplyMode) {
        let bounds = PopReplyLimits();
        limits = bounds;
        progress = PopReplyProgress(mode: mode, limits: bounds);
        tail = [];
    }

    // Nothing read yet, within limits.
    PopReplyDecoder(mode is PopReplyMode, limits is PopReplyLimits) {
        self.limits = limits;
        progress = PopReplyProgress(mode: mode, limits: limits);
        tail = [];
    }

    // This decoder after chunk; InvalidPopReply for bad input.
    fed(chunk is @byte) is ^PopReplyDecoder {
        confirm !progress.complete()
            else throw InvalidState.because("POP3 reply decoder is complete");
        confirm chunk.size() <= limits::Limits::wire_bytes
            else throw PopReplyLimitExceeded.kind("chunk_bytes");
        let state = progress;
        let end = MimePosition(chunk.size());
        for (0..chunk.size()) -> index {
            if state.complete() {
                end = end.following(index);
                last;
            }
            state = state.accepted(chunk[index]);
        }
        let rest is @byte = (end.index()..chunk.size()).map() -> index {
            chunk[index];
        };
        ^progress = state;
        ^tail = rest;
    }

    // Whether the reply is complete.
    complete() is bool {
        progress.complete();
    }

    // Bytes the reply took.
    consumed() is int {
        progress.consumed();
    }

    // The reply; InvalidPopReply before it is complete.
    reply() is PopReply {
        confirm self.complete() else throw InvalidState.because("POP3 reply is incomplete");
        progress.reply();
    }

    // The reply at the end of input; InvalidPopReply when it was cut short.
    finish() is PopReply {
        confirm self.complete()
            else throw InvalidPopReply.located(progress.consumed(), "truncated reply");
        progress.reply();
    }

    // Bytes past the reply.
    remainder() is @byte {
        confirm self.complete() else throw InvalidState.because("POP3 reply is incomplete");
        tail;
    }
}

// Exactly one reply read from bytes.
object ParsedPopReply {
    has origin is @byte;
    has mode is PopReplyMode;
    has limits is PopReplyLimits;

    // Reads origin with the default limits.
    ParsedPopReply(origin is @byte, mode is PopReplyMode) {
        self.origin = origin;
        self.mode = mode;
        limits = PopReplyLimits();
    }

    // Reads origin within limits.
    ParsedPopReply(origin is @byte, mode is PopReplyMode, limits is PopReplyLimits) {
        self.origin = origin;
        self.mode = mode;
        self.limits = limits;
    }

    // The reply; InvalidPopReply for anything but one whole reply.
    reply() is PopReply {
        confirm origin.size() <= limits::Limits::wire_bytes
            else throw PopReplyLimitExceeded.kind("wire_bytes");
        let decoder = PopReplyDecoder(mode: mode, limits: limits);
        decoder = decoder.fed(origin);
        let result = decoder.finish();
        confirm decoder.remainder().size() == 0
            else throw InvalidPopReply.located(decoder.consumed(), "trailing bytes after reply");
        result;
    }
}

// Bytes that are not a reply; offset and reason say where and why.
enum InvalidPopReply is Error = (located(offset is int, reason is string));

// A reply over a limit; kind says which.
enum PopReplyLimitExceeded is Error = (kind(kind is string));

hidden object PopStatusLine {
    has success is bool;
    has summary is string;

    PopStatusLine(origin is string, offset is int) {
        let positive = origin.length() >= 3 && origin.slice(0, 3) == "+OK";
        let negative = origin.length() >= 4 && origin.slice(0, 4) == "-ERR";
        confirm positive || negative
            else throw InvalidPopReply.located(offset, "expected +OK or -ERR");
        let end = if positive {
            3;
        }
        else {
            4;
        };
        confirm origin.length() == end || origin.slice(end, end + 1) == " "
            else throw InvalidPopReply.located(offset + end, "invalid status separator");
        success = positive;
        summary = if origin.length() == end {
            "";
        }
        else {
            origin.slice(end + 1, origin.length());
        };
    }

    successful() is bool {
        success;
    }

    text() is string {
        summary;
    }
}

hidden object PopReplyProgress {
    has limits is PopReplyLimits;
    has mode is PopReplyMode;
    has pending, content, summary is string;
    has used, count is int;
    has status_seen, success, done is bool;

    PopReplyProgress(mode is PopReplyMode, limits is PopReplyLimits) {
        self.mode = mode;
        self.limits = limits;
        pending = "";
        content = "";
        summary = "";
        used = 0;
        count = 0;
        status_seen = false;
        success = false;
        done = false;
    }

    complete() is bool {
        done;
    }

    consumed() is int {
        used;
    }

    reply() is PopReply {
        PopReply(
            successful: success,
            text: summary,
            body: Latin1Encoded(content).bytes(),
            lines: count,
            multiline: success && mode == PopReplyMode.multiline
        );
    }

    accepted(octet is byte) is ^PopReplyProgress {
        confirm !done else throw InvalidState.because("POP3 reply is complete");
        confirm used < limits::Limits::wire_bytes
            else throw PopReplyLimitExceeded.kind("wire_bytes");
        let line_limit = if status_seen {
            limits::Limits::line_bytes;
        }
        else {
            limits::Limits::status_bytes;
        };
        confirm pending.length() < line_limit
            else throw PopReplyLimitExceeded.kind(if status_seen {
                "line_bytes";
            }
            else {
                "status_bytes";
            });
        let value = octet.int();
        let cr = pending.length() > 0
            && pending.slice(pending.length() - 1, pending.length()) == "\r";
        if cr {
            confirm value == 10
                else throw InvalidPopReply.located(used, "CR must be followed by LF");
        }
        if value == 10 {
            confirm cr else throw InvalidPopReply.located(used, "bare LF");
            let line = pending.slice(0, pending.length() - 1);
            if !status_seen {
                let status = PopStatusLine(origin: line, offset: used - pending.length());
                ^success = status.successful();
                ^summary = status.text();
                ^status_seen = true;
                ^done = !status.successful() || mode == PopReplyMode.single;
            }
            else {
                if line == "." {
                    ^done = true;
                }
                else {
                    confirm count < limits::Limits::lines
                        else throw PopReplyLimitExceeded.kind("lines");
                    let start = if line.length() > 0 && line.slice(0, 1) == "." {
                        1;
                    }
                    else {
                        0;
                    };
                    let added = line.length() - start + 2;
                    confirm added <= limits::Limits::body_bytes - content.length()
                        else throw PopReplyLimitExceeded.kind("body_bytes");
                    ^content = content + line.slice(start, line.length()) + "\r\n";
                    ^count = count + 1;
                }
            }
            ^pending = "";
        }
        else {
            if !status_seen {
                confirm value == 13 || value == 9 || (value >= 32 && value <= 126)
                    else throw InvalidPopReply.located(used, "invalid ASCII status byte");
            }
            ^pending = pending + Latin1Decoded([octet]).string();
        }
        ^used = used + 1;
    }
}

test "POP3 negative multiline response retains the following reply" {
    let decoder = PopReplyDecoder(PopReplyMode.multiline);
    decoder = decoder.fed(Utf8Encoded("-ERR missing\r\n+OK\r\n").bytes());
    test.is(decoder.reply()::Reply::successful, false);
    test.is(decoder.reply()::Reply::multiline, false);
    test.is(decoder.remainder(), Utf8Encoded("+OK\r\n").bytes());
}

test "POP3 removes the terminal dot line and one stuffing dot" {
    let reply = ParsedPopReply(
        origin: Utf8Encoded("+OK\r\n..\r\n.\r\n").bytes(),
        mode: PopReplyMode.multiline
    ).reply();
    test.is(reply::Reply::body, [46.byte(), 13.byte(), 10.byte()]);
    test.is(reply::Reply::lines, 1);
}
