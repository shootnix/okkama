module mail/pop3_session v1.0.0;

// A POP3 session in the TRANSACTION state: listing, fetching and deleting
// messages.
//
//     let mailbox = session.mailbox();
//     let state = await mailbox.state();                    // STAT
//     let listing = await mailbox.messages();               // LIST and UIDL
//     for listing -> entry {
//         let message = await mailbox.message(entry.number());   // RETR, parsed
//         await mailbox.delete(entry.number());                   // DELE
//     }
//     await session.quit();                                 // deletions take effect
//
// The caller connects and authenticates, then hands the transport to
// PopSession. One command runs at a time. Deletions take effect at QUIT;
// PopDeleteReset undoes them before.

import "mail/pop3" take PopCapabilities, PopFeature, PopNumber, PopMessage, PopListingLimits,
    PopListing, PopMailboxState;
import "mail/pop3_reply" take PopReply, PopReplyMode, PopReplyLimits;
import "mail/pop3_reading" take PopReplyReading;
import "mail/message" take MailMessage, ParsedMail;
import "io/stream" take AsyncReading, AsyncWriting, Closing;
import "encoding/utf" take Utf8Encoded;
import "collections/sequence" take Sequencing;
import "async/atomic" take Atomic;
import "async/lock" take Lock;
import "async/event" take Event;
import "error" take InvalidArgument, UnsupportedOperation;

// An authenticated POP3 session.
object PopSession does Closing {
    has wire is PopWire;
    has capabilities is PopCapabilities;
    has limits is PopListingLimits;
    has lock is Lock;

    // Takes over input and output (closing owner) after login, with the
    // server's capabilities and the bytes already read.
    PopSession(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        capabilities is PopCapabilities,
        prefix is @byte,
        reply_limits is PopReplyLimits,
        listing_limits is PopListingLimits
    ) {
        wire = PopWire(
            input: input,
            output: output,
            owner: owner,
            prefix: prefix,
            limits: reply_limits
        );
        self.capabilities = capabilities;
        limits = listing_limits;
        lock = Lock();
    }

    // The server's capabilities.
    capabilities() is PopCapabilities {
        capabilities;
    }

    // The maildrop.
    mailbox() is PopMailbox {
        PopMailbox(self);
    }

    // Whether it was closed.
    closed() is bool {
        wire.closed();
    }

    // Closes the transport without QUIT; deletions are not applied.
    close() is void {
        wire.close();
    }

    // Closes the transport, ignoring errors.
    abort() is void {
        try {
            self.close();
        }
        catch failure is Error {}
        catch failure is NativeFailure {}
    }

    // STAT.
    async state() is PopMailboxState {
        confirm !self.closed() else throw PopSessionClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw PopSessionClosed.closed;
        let complete = Event();
        let cleanup = PopSessionCleanup(origin: self, complete: complete);
        defer cleanup.close();
        let command = PopCommand(PopSimpleCommand.stat);
        let reply = await wire.read(command);
        if !reply::Reply::successful {
            complete.set();
            throw PopCommandRejected.detailed(command.name(), reply::Reply::text);
        }
        let state = PopMailboxState(reply: reply, limits: limits);
        complete.set();
        state;
    }

    // LIST, and UIDL when the server has it.
    async messages() is Sequencing<PopMessage> {
        confirm !self.closed() else throw PopSessionClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw PopSessionClosed.closed;
        let complete = Event();
        let cleanup = PopSessionCleanup(origin: self, complete: complete);
        defer cleanup.close();
        let reply = await wire.read(PopCommand(PopSimpleCommand.list));
        if !reply::Reply::successful {
            complete.set();
            throw PopCommandRejected.detailed("LIST", reply::Reply::text);
        }
        // Validate LIST before sending another command or holding another body.
        let listed = PopListing(reply: reply, identifiers: [], limits: limits);
        let entries = listed.messages();
        let result = if capabilities.features().membership(PopFeature.uidl) {
            let ids = await wire.read(PopCommand(PopSimpleCommand.uidl));
            if !ids::Reply::successful {
                complete.set();
                throw PopCommandRejected.detailed("UIDL", ids::Reply::text);
            }
            let joined = PopListing(reply: reply, identifiers: [ids], limits: limits);
            joined.messages();
        }
        else {
            entries;
        };
        complete.set();
        result;
    }

    // Sends command and reads its reply; PopCommandRejected for -ERR.
    async run(command is PopCommand) is PopReply {
        // Typed command only: there is no arbitrary text constructor.
        confirm !self.closed() else throw PopSessionClosed.closed;
        if command.name() == "TOP" {
            confirm capabilities.features().membership(PopFeature.top)
                else throw UnsupportedOperation.because("POP3 TOP is not advertised");
        }
        if command.name() == "UIDL" {
            confirm capabilities.features().membership(PopFeature.uidl)
                else throw UnsupportedOperation.because("POP3 UIDL is not advertised");
        }
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw PopSessionClosed.closed;
        let complete = Event();
        let cleanup = PopSessionCleanup(origin: self, complete: complete);
        defer cleanup.close();
        let reply = await wire.read(command);
        if command.name() == "QUIT" {
            self.close();
        }
        complete.set();
        confirm reply::Reply::successful
            else throw PopCommandRejected.detailed(command.name(), reply::Reply::text);
        reply;
    }

    // QUIT: applies the deletions and ends the session.
    async quit() is void {
        await self.run(PopCommand(PopSimpleCommand.quit));
    }

    // RSET: undoes the deletions.
    async reset() is void {
        await self.run(PopCommand(PopSimpleCommand.reset));
    }

    destroy {
        self.abort();
    }
}

// The maildrop of a session.
object PopMailbox {
    has origin is PopSession;

    // The maildrop of origin.
    PopMailbox(origin is PopSession) {
        self.origin = origin;
    }

    // STAT.
    async state() is PopMailboxState {
        await origin.state();
    }

    // LIST, and UIDL when the server has it.
    async messages() is Sequencing<PopMessage> {
        await origin.messages();
    }

    // RETR: the message's bytes.
    async bytes(number is PopNumber) is @byte {
        let reply = await origin.run(
            PopCommand(operation: PopMessageCommand.retrieve, number: number)
        );
        reply::Reply::body;
    }

    // RETR: the message, parsed.
    async message(number is PopNumber) is MailMessage {
        let bytes = await self.bytes(number);
        ParsedMail(bytes).message();
    }

    // DELE: marks the message deleted.
    async delete(number is PopNumber) is void {
        await origin.run(PopCommand(operation: PopMessageCommand.delete, number: number));
    }

    // TOP: the header and the first lines of the body.
    async preview(number is PopNumber, lines is int) is @byte {
        let reply = await origin.run(PopCommand(number: number, lines: lines));
        reply::Reply::body;
    }
}

// The TOP of a message, fetched on demand.
object PreviewedPopMail {
    has pending is Future<@byte>;

    // lines of message number of origin.
    PreviewedPopMail(origin is PopMailbox, number is PopNumber, lines is int) {
        confirm lines >= 0
            else throw InvalidArgument.because("POP3 TOP line count must be nonnegative");
        pending = origin.preview(number, lines);
    }

    // The bytes.
    bytes() is Future<@byte> {
        pending;
    }
}

// Undoes the deletions of a session.
object PopDeleteReset {
    has origin is PopSession;

    // For origin.
    PopDeleteReset(origin is PopSession) {
        self.origin = origin;
    }

    // Sends RSET.
    async reset() is void {
        await origin.reset();
    }
}

// Closed command family for trusted protocol infrastructure. Building one only
// validates/encodes a value. Sending belongs to the session, never to projection.
enum PopSimpleCommand = (stat, list, uidl, reset, quit);

// Commands that take a message number.
enum PopMessageCommand = (retrieve, delete);

// A POP3 command.
object PopCommand {
    has name, line is string;
    has multiple is bool;

    // The command.
    PopCommand(operation is PopSimpleCommand) {
        let name = match operation {
            case PopSimpleCommand.stat {
                "STAT";
            }
            case PopSimpleCommand.list {
                "LIST";
            }
            case PopSimpleCommand.uidl {
                "UIDL";
            }
            case PopSimpleCommand.reset {
                "RSET";
            }
            case PopSimpleCommand.quit {
                "QUIT";
            }
        };
        self.name = name;
        line = name + "\r\n";
        multiple = operation == PopSimpleCommand.list || operation == PopSimpleCommand.uidl;
    }

    // The command for message number.
    PopCommand(operation is PopMessageCommand, number is PopNumber) {
        let name = if operation == PopMessageCommand.retrieve {
            "RETR";
        }
        else {
            "DELE";
        };
        self.name = name;
        line = name + " " + number.string() + "\r\n";
        multiple = operation == PopMessageCommand.retrieve;
    }

    // TOP with lines.
    PopCommand(number is PopNumber, lines is int) {
        confirm lines >= 0
            else throw InvalidArgument.because("POP3 TOP line count must be nonnegative");
        let encoded = "TOP " + number.string() + " " + lines.string() + "\r\n";
        name = "TOP";
        line = encoded;
        multiple = true;
        confirm encoded.length() <= 47
            else throw InvalidArgument.because("POP3 command exceeds base command budget");
    }

    // Its name, such as RETR.
    name() is string {
        name;
    }

    // The command line with CRLF.
    bytes() is @byte {
        Utf8Encoded(line).bytes();
    }

    // Whether its reply is multiline.
    mode() is PopReplyMode {
        if multiple {
            PopReplyMode.multiline;
        }
        else {
            PopReplyMode.single;
        }
    }
}

// Exclusively owned wire state, used only under its session's lock. Atomic
// stores immutable unread bytes; no Okkama field becomes mutable.
hidden object PopWire does Closing {
    has input is AsyncReading;
    has output is AsyncWriting;
    has owner is Closing;
    has prefix is Atomic<@byte>;
    has limits is PopReplyLimits;
    has stopped is Event;

    PopWire(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        prefix is @byte,
        limits is PopReplyLimits
    ) {
        confirm prefix.size() <= limits::Limits::wire_bytes && limits::Limits::wire_bytes > 0
            else throw InvalidArgument.because("invalid POP3 wire prefix/budget");
        self.input = input;
        self.output = output;
        self.owner = owner;
        self.limits = limits;
        self.prefix = Atomic(prefix);
        stopped = Event();
    }

    closed() is bool {
        stopped.ready() || owner.closed();
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            owner.close();
        }
    }

    async read(command is PopCommand) is PopReply {
        confirm !self.closed() else throw PopSessionClosed.closed;
        await output.write(command.bytes());
        let result = await PopReplyReading(
            origin: input,
            mode: command.mode(),
            prefix: prefix.value(),
            limits: limits,
            chunk_bytes: 4096
        ).read();
        confirm !self.closed() else throw PopSessionClosed.closed;
        prefix.replace(result.remainder());
        result.reply();
    }
}

hidden object PopSessionCleanup {
    has origin is PopSession;
    has complete is Event;

    PopSessionCleanup(origin is PopSession, complete is Event) {
        self.origin = origin;
        self.complete = complete;
    }

    close() is void {
        if !complete.ready() {
            origin.abort();
        }
    }
}

// The server answered -ERR; operation and reason say to what.
enum PopCommandRejected is Error = (detailed(operation is string, reason is string));

// The session was used after it closed.
enum PopSessionClosed is Error = (closed);

test "POP3 commands encode only typed operands" {
    test.is(PopCommand(PopSimpleCommand.quit).bytes(), Utf8Encoded("QUIT\r\n").bytes());
    test.is(PopCommand(number: PopNumber(1), lines: 0).bytes(), Utf8Encoded("TOP 1 0\r\n").bytes());
}
