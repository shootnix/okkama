module mail/pop3_reading v1.0.0;

// Reading one POP3 reply from a stream, keeping the bytes read past it.
//
//     let read = await PopReplyReading(origin: socket, mode: PopReplyMode.multiline).read();
//     read.reply()::Reply::successful;
//     read.remainder();                   // for the next read on the same stream
//
// The caller says whether the command answers in one line or many. A read that
// fails part way may have consumed input: the session is then over.

import "io/stream" take AsyncReading;
import "mail/pop3_reply" take PopReply, PopReplyMode, PopReplyDecoder, PopReplyLimits,
    PopReplyLimitExceeded;
import "io/decorators" take InvalidReading;
import "error" take InvalidArgument;

// Reads one reply.
object PopReplyReading {
    has pending is Future<PopReplyRead>;

    // Reads a reply of mode from origin.
    PopReplyReading(origin is AsyncReading, mode is PopReplyMode) {
        pending = PopReplyInput(
            origin: origin,
            mode: mode,
            prefix: [],
            limits: PopReplyLimits(),
            chunk_bytes: 4096
        ).read();
    }

    // Reads prefix first, then origin.
    PopReplyReading(origin is AsyncReading, mode is PopReplyMode, prefix is @byte) {
        pending = PopReplyInput(
            origin: origin,
            mode: mode,
            prefix: prefix,
            limits: PopReplyLimits(),
            chunk_bytes: 4096
        ).read();
    }

    // The same within limits, chunk_bytes at a time.
    PopReplyReading(
        origin is AsyncReading,
        mode is PopReplyMode,
        prefix is @byte,
        limits is PopReplyLimits,
        chunk_bytes is int
    ) {
        pending = PopReplyInput(
            origin: origin,
            mode: mode,
            prefix: prefix,
            limits: limits,
            chunk_bytes: chunk_bytes
        ).read();
    }

    // The reply and what came after it; the same future on every call.
    read() is Future<PopReplyRead> {
        pending;
    }
}

// A reply read from a stream, and the bytes after it.
object PopReplyRead {
    has value is PopReply;
    has tail is @byte;
    has count is int;

    // What decoder completed.
    PopReplyRead(decoder is PopReplyDecoder) {
        value = decoder.finish();
        tail = decoder.remainder();
        count = decoder.consumed();
    }

    // The reply.
    reply() is PopReply {
        value;
    }

    // The bytes read past it.
    remainder() is @byte {
        tail;
    }

    // How many bytes the reply took.
    consumed() is int {
        count;
    }
}

hidden object PopReplyInput {
    has origin is AsyncReading;
    has mode is PopReplyMode;
    has prefix is @byte;
    has limits is PopReplyLimits;
    has chunk_bytes is int;

    PopReplyInput(
        origin is AsyncReading,
        mode is PopReplyMode,
        prefix is @byte,
        limits is PopReplyLimits,
        chunk_bytes is int
    ) {
        confirm chunk_bytes > 0
            else throw InvalidArgument.because("POP3 read chunk size must be positive");
        confirm prefix.size() <= limits::Limits::wire_bytes
            else throw PopReplyLimitExceeded.kind("chunk_bytes");
        self.origin = origin;
        self.mode = mode;
        self.prefix = prefix;
        self.limits = limits;
        self.chunk_bytes = chunk_bytes;
    }

    async read() is PopReplyRead {
        let decoder = PopReplyDecoder(mode: mode, limits: limits);
        decoder = decoder.fed(prefix);
        loop {
            last if decoder.complete();
            let remaining = limits::Limits::wire_bytes - decoder.consumed();
            confirm remaining > 0 else throw PopReplyLimitExceeded.kind("wire_bytes");
            let requested = if chunk_bytes < remaining {
                chunk_bytes;
            }
            else {
                remaining;
            };
            let chunk = await origin.bytes(requested);
            confirm chunk.size() <= requested
                else throw InvalidReading.because("POP3 origin returned more bytes than requested");
            if chunk.size() == 0 {
                decoder.finish();
            }
            decoder = decoder.fed(chunk);
        }
        PopReplyRead(decoder);
    }
}

test "POP3 read snapshot preserves status and exact remainder" {
    let decoder = PopReplyDecoder(PopReplyMode.single);
    decoder = decoder.fed([43.byte(), 79.byte(), 75.byte(), 13.byte(), 10.byte(), 1.byte()]);
    let read = PopReplyRead(decoder);
    test.is(read.reply()::Reply::successful, true);
    test.is(read.consumed(), 5);
    test.is(read.remainder(), [1.byte()]);
}
