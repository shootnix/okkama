module mail/imap_name v1.0.0;

import "encoding/utf" take Utf8Encoded, Utf8Decoded, Utf16Encoded, Utf16Decoded, ByteOrder,
    InvalidUtf16;
import "encoding/base64" take Base64Encoded, Base64Decoded, InvalidBase64;
import "mime/media_type" take MimePosition;
import "io/buffer" take ByteBuffer;
import "io/decorators" take ByteSnapshot;
import "error" take InvalidArgument;

// Bounded, eager IMAP4rev1 mailbox-name values. No connection or negotiation.
// Modified UTF-7 uses UTF-16BE, comma instead of slash, no Base64 padding,
// &- for ampersand and maximal runs of non-printable/non-ASCII scalars.
// Decoding accepts only this canonical form. Codecs preserve all Unicode
// scalars without normalization; ImapMailboxName rejects ASCII controls.
// Quoting protects syntax, not LIST wildcard interpretation or authorization.
object ImapNameLimits {
    has scalars, wire_bytes is int;

    ImapNameLimits() {
        scalars = 4096;
        wire_bytes = 32768;
    }

    ImapNameLimits(scalars is int, wire_bytes is int) {
        confirm scalars >= 0 && wire_bytes >= 0
            else throw InvalidArgument.because("IMAP name limits must be nonnegative");
        self.scalars = scalars;
        self.wire_bytes = wire_bytes;
    }

    cap Limits {
        scalars is int {
            scalars;
        }

        wire_bytes is int {
            wire_bytes;
        }
    }
}

hidden object ImapUtf7Encoded {
    has value is string;

    ImapUtf7Encoded(origin is string) {
        value = ImapUtf7Encoder(origin: origin, limits: ImapNameLimits()).string();
    }

    ImapUtf7Encoded(origin is string, limits is ImapNameLimits) {
        value = ImapUtf7Encoder(origin: origin, limits: limits).string();
    }

    string() is string {
        value;
    }
}

object ImapUtf7Decoded {
    has value is string;

    ImapUtf7Decoded(origin is string) {
        value = ImapUtf7Parser(origin: origin, limits: ImapNameLimits()).string();
    }

    ImapUtf7Decoded(origin is string, limits is ImapNameLimits) {
        value = ImapUtf7Parser(origin: origin, limits: limits).string();
    }

    string() is string {
        value;
    }
}

object ImapMailboxName {
    has value, wire, argument is string;

    ImapMailboxName(origin is string) {
        let prepared = ImapNameValue(origin: origin, limits: ImapNameLimits());
        value = origin;
        wire = prepared.wire();
        argument = prepared.quoted();
    }

    ImapMailboxName(origin is string, limits is ImapNameLimits) {
        let prepared = ImapNameValue(origin: origin, limits: limits);
        value = origin;
        wire = prepared.wire();
        argument = prepared.quoted();
    }

    string() is string {
        value;
    }

    wire_name() is string {
        wire;
    }

    quoted() is string {
        argument;
    }
}

enum InvalidImapUtf7 is Error = (located(offset is int, reason is string));

enum InvalidImapMailboxName is Error = (at(offset is int));

enum ImapNameLimitExceeded is Error = (kind(kind is string));

hidden object ImapUtf7Encoder {
    has origin is string;
    has limits is ImapNameLimits;

    ImapUtf7Encoder(origin is string, limits is ImapNameLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    string() is string {
        confirm origin.length() <= limits::Limits::scalars
            else throw ImapNameLimitExceeded.kind("scalars");
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let output = ImapNameOutput(buffer: buffer, maximum: limits::Limits::wire_bytes);
        let start = MimePosition(0);
        // Code points by code (#173): printable ASCII is written as it is.
        let characters = origin.characters();
        for (0..characters.size()) -> index {
            let code = characters[index].code();
            if code >= 32 && code <= 126 {
                if start.index() < index {
                    output.write(ImapUtf7Run(origin.slice(start.index(), index)).string());
                }
                output.write(if code == 38 {
                    "&-";
                }
                else {
                    characters[index].string();
                });
                start = start.following(index + 1);
            }
        }
        if start.index() < origin.length() {
            output.write(ImapUtf7Run(origin.slice(start.index(), origin.length())).string());
        }
        Utf8Decoded(buffer.content().bytes()).string();
    }
}

hidden object ImapUtf7Run {
    has origin is string;

    ImapUtf7Run(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let encoded = Base64Encoded(Utf16Encoded(origin: origin, order: ByteOrder.big).bytes()).string();
        "&" + encoded.replace("=", "").replace("/", ",") + "-";
    }
}

hidden object ImapUtf7Parser {
    has origin is string;
    has limits is ImapNameLimits;

    ImapUtf7Parser(origin is string, limits is ImapNameLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    string() is string {
        confirm origin.length() <= limits::Limits::wire_bytes
            else throw ImapNameLimitExceeded.kind("wire_bytes");
        let characters = origin.characters();
        for (0..characters.size()) -> index {
            let code = characters[index].code();
            confirm code >= 32 && code <= 126
                else throw InvalidImapUtf7.located(index, "wire name must be printable ASCII");
        }
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let position = MimePosition(0);
        let count = MimePosition(0);
        loop {
            let start = position.index();
            last if start == origin.length();
            let piece = if characters[start].code() != 38 {
                position = position.following(start + 1);
                characters[start].string();
            }
            else {
                let end = MimePosition(start + 1);
                loop {
                    last if end.index() == characters.size() || characters[end.index()].code() == 45;
                    end = end.following(end.index() + 1);
                }
                confirm end.index() < origin.length()
                    else throw InvalidImapUtf7.located(start, "unterminated shift");
                position = position.following(end.index() + 1);
                if end.index() == start + 1 {
                    "&";
                }
                else {
                    ImapUtf7Shift(origin: origin.slice(start + 1, end.index()), offset: start).string();
                }
            };
            confirm piece.length() <= limits::Limits::scalars - count.index()
                else throw ImapNameLimitExceeded.kind("scalars");
            buffer.writing().write(ByteSnapshot(Utf8Encoded(piece).bytes()));
            count = count.following(count.index() + piece.length());
        }
        let decoded = Utf8Decoded(buffer.content().bytes()).string();
        confirm ImapUtf7Encoded(origin: decoded, limits: limits).string() == origin
            else throw InvalidImapUtf7.located(0, "noncanonical shift or encoded printable ASCII");
        decoded;
    }
}

hidden object ImapUtf7Shift {
    has origin is string;
    has offset is int;

    ImapUtf7Shift(origin is string, offset is int) {
        self.origin = origin;
        self.offset = offset;
    }

    string() is string {
        let characters = origin.characters();
        for (0..characters.size()) -> index {
            let code = characters[index].code();
            confirm (code >= 65 && code <= 90)
                || (code >= 97 && code <= 122)
                || (code >= 48 && code <= 57)
                || code == 43
                || code == 44
                else throw InvalidImapUtf7.located(
                    offset + 1 + index,
                    "invalid modified Base64 alphabet"
                );
        }
        let remainder = origin.length() % 4;
        confirm remainder != 1 else throw InvalidImapUtf7.located(offset, "invalid Base64 quantum");
        let padded = origin.replace(",", "/") + (if remainder == 2 {
            "==";
        }
        else {
            if remainder == 3 {
                "=";
            }
            else {
                "";
            }
        });
        let bytes = try {
            Base64Decoded(padded).bytes();
        }
        catch failure is InvalidBase64 {
            throw InvalidImapUtf7.located(offset, "invalid Base64 padding bits");
        };
        try {
            Utf16Decoded(origin: bytes, order: ByteOrder.big).string();
        }
        catch failure is InvalidUtf16 {
            throw InvalidImapUtf7.located(offset, "invalid UTF-16BE shift");
        }
    }
}

hidden object ImapNameValue {
    has wire, argument is string;

    ImapNameValue(origin is string, limits is ImapNameLimits) {
        confirm origin.length() <= limits::Limits::scalars
            else throw ImapNameLimitExceeded.kind("scalars");
        for (0..origin.length()) -> index {
            let bytes = Utf8Encoded(origin.slice(index, index + 1)).bytes();
            confirm bytes.size() != 1 || (bytes[0].int() >= 32 && bytes[0].int() != 127)
                else throw InvalidImapMailboxName.at(index);
        }
        let encoded = ImapUtf7Encoded(origin: origin, limits: limits).string();
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let output = ImapNameOutput(buffer: buffer, maximum: limits::Limits::wire_bytes);
        output.write("\"");
        for (0..encoded.length()) -> index {
            let char = encoded.slice(index, index + 1);
            if char == "\"" || char == "\\" {
                output.write("\\");
            }
            output.write(char);
        }
        output.write("\"");
        wire = encoded;
        argument = Utf8Decoded(buffer.content().bytes()).string();
    }

    wire() is string {
        wire;
    }

    quoted() is string {
        argument;
    }
}

hidden object ImapNameOutput {
    has buffer is ByteBuffer;
    has maximum is int;

    ImapNameOutput(buffer is ByteBuffer, maximum is int) {
        self.buffer = buffer;
        self.maximum = maximum;
    }

    write(origin is string) is void {
        confirm origin.length() <= maximum - buffer.content().size()
            else throw ImapNameLimitExceeded.kind("wire_bytes");
        buffer.writing().write(ByteSnapshot(Utf8Encoded(origin).bytes()));
    }
}

test "IMAP modified UTF-7 preserves ampersands and supplementary scalars" {
    test.is(ImapUtf7Encoded("A&😀").string(), "A&-&2D3eAA-");
    test.is(ImapUtf7Decoded("A&-&2D3eAA-").string(), "A&😀");
}

test "IMAP mailbox argument is always quoted" {
    test.is(ImapMailboxName("NIL").quoted(), "\"NIL\"");
    test.is(ImapMailboxName("").quoted(), "\"\"");
}

test "IMAP names encode runs, decode shifts and name failures by offset" {
    let limits = ImapNameLimits();
    test.is(
        ImapUtf7Encoded(origin: "Входящие/Spam & Ham", limits: limits).string(),
        "&BBIERQQ+BDQETwRJBDgENQ-/Spam &- Ham"
    );
    test.is(
        ImapUtf7Parser(origin: "&BBIERQQ+BDQETwRJBDgENQ-/Spam &- Ham", limits: limits).string(),
        "Входящие/Spam & Ham"
    );
    let offsets is @int = ["a&Zm9v", "a&AG!-", "ab" + 7.char().string()].map() -> wire {
        try {
            ImapUtf7Parser(origin: wire, limits: limits).string();
            -1;
        }
        catch InvalidImapUtf7.located(at, _reason) {
            at;
        }
    };
    test.is(offsets, [1, 4, 2]);
}
