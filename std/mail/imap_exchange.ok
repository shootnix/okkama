module mail/imap_exchange v1.0.0;

// The command channel of an IMAP connection: tags, literals, responses in
// order. ImapSession uses it.
//
// One command runs at a time; its tag is chosen when it starts. A tagged NO or
// BAD comes back for the caller to handle; a transport or protocol failure
// closes the connection.

import "mail/imap_command" take ImapCommand, ImapSimpleCommand;
import "mail/imap_command_reading" take ImapTag, ImapCommandLimits, ImapCommandRead,
    ImapCommandInput, ImapReplyMode, ImapContinuationWriting, ImapNoContinuation,
    ImapCommandLimitExceeded, ImapResponseObserving;
import "io/stream" take AsyncReading, AsyncWriting, Closing;
import "async/channel" take Channel, Sending;
import "async/lock" take Lock;
import "async/event" take Event;
import "async/scope" take FutureScope, Supervising;
import "numbers/bigint" take BigInt;
import "encoding/utf" take Utf8Encoded;
import "error" take InvalidState;

// Sends commands on a connection and reads their responses.
object ImapCommandChannel does Closing {
    has input is AsyncReading;
    has output is AsyncWriting;
    has owner is Closing;
    has limits is ImapCommandLimits;
    has lock is Lock;
    has stopped is Event;
    has states is Channel<ImapExchangeState>;
    has initial is Future<Sending<ImapExchangeState>>;

    // Takes over input and output (closing owner), with the bytes already read,
    // within limits.
    ImapCommandChannel(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        prefix is @byte,
        limits is ImapCommandLimits
    ) {
        confirm prefix.size() <= limits::Limits::wire_bytes
            else throw ImapCommandLimitExceeded.kind("prefix_bytes");
        confirm limits::Limits::responses > 0 else throw ImapCommandLimitExceeded.kind("responses");
        confirm limits::Limits::wire_bytes > 0 && limits.response()::Limits::wire_bytes > 0
            else throw ImapCommandLimitExceeded.kind("wire_bytes");
        self.input = input;
        self.output = output;
        self.owner = owner;
        self.limits = limits;
        lock = Lock();
        stopped = Event();
        let channel is Channel<ImapExchangeState> = Channel(1);
        states = channel;
        initial = channel.sending().send(ImapExchangeState(prefix: prefix, serial: BigInt(1)));
    }

    // A pending exchange of command.
    request(command is ImapCommand) is ImapCommandExchange {
        ImapCommandExchange(origin: self, command: command);
    }

    // Its limits.
    limits() is ImapCommandLimits {
        limits;
    }

    // Whether it was closed.
    closed() is bool {
        stopped.ready() || owner.closed();
    }

    // Closes the connection.
    close() is void {
        if !stopped.ready() {
            stopped.set();
            states.sending().close();
            owner.close();
        }
    }

    // Closes the connection, ignoring errors.
    abort() is void {
        try {
            self.close();
        }
        catch failure is Error {}
        catch failure is NativeFailure {}
    }

    // Sends command and reads every response through its tagged completion.
    async perform(command is ImapCommand) is ImapCommandRead {
        confirm !self.closed() else throw ImapChannelClosed.closed;
        await initial;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw ImapChannelClosed.closed;
        let completed = Event();
        let cleanup = ImapExchangeCleanup(origin: self, complete: completed);
        defer cleanup.close();
        let state = await states.receiving().item();
        let tag = ImapTag("O" + state.serial().string());
        let continuation is ImapContinuationWriting = if command.literal() {
            ImapLiteralWriting(output: output, command: command);
        }
        else {
            ImapNoContinuation();
        };
        let logout = command.name() == "LOGOUT";
        await output.write(command.bytes(tag));
        let result = await ImapCommandInput(
            origin: input,
            tag: tag,
            prefix: state.prefix(),
            limits: limits,
            mode: ImapReplyMode(continuation, logout)
        ).read();
        let following = ImapExchangeState(
            prefix: result.remainder(),
            serial: (state.serial() + BigInt(1))
        );
        await states.sending().send(following);
        completed.set();
        if logout {
            self.close();
        }
        result;
    }

    // IDLE until stop fires, giving untagged responses to observer.
    async idle(stop is Event, observer is ImapResponseObserving) is @ImapCommandRead {
        confirm !self.closed() else throw ImapChannelClosed.closed;
        await initial;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw ImapChannelClosed.closed;
        if stop.ready() {
            return [];
        }
        let completed = Event();
        let cleanup = ImapExchangeCleanup(origin: self, complete: completed);
        defer cleanup.close();
        let state = await states.receiving().item();
        let tag = ImapTag("O" + state.serial().string());
        await output.write(ImapCommand(simple: ImapSimpleCommand.idle).bytes(tag));
        let action = ImapIdleWireInput(
            input: input,
            output: output,
            tag: tag,
            prefix: state.prefix(),
            limits: limits,
            stop: stop,
            observer: observer
        );
        let scope is FutureScope<int, ImapCommandRead> = FutureScope(action: action.run);
        let result = await scope.outcome();
        await states.sending().send(
            ImapExchangeState(prefix: result.remainder(), serial: (state.serial() + BigInt(1)))
        );
        completed.set();
        [result];
    }

    destroy {
        self.abort();
    }
}

// One command and its responses.
object ImapCommandExchange {
    has pending is Future<ImapCommandRead>;

    // command on origin.
    ImapCommandExchange(origin is ImapCommandChannel, command is ImapCommand) {
        pending = origin.perform(command);
    }

    // The responses through completion; the same future on every call.
    read() is Future<ImapCommandRead> {
        pending;
    }
}

hidden object ImapExchangeState {
    has prefix is @byte;
    has serial is BigInt;

    ImapExchangeState(prefix is @byte, serial is BigInt) {
        self.prefix = prefix;
        self.serial = serial;
    }

    prefix() is @byte {
        prefix;
    }

    serial() is BigInt {
        serial;
    }
}

hidden object ImapExchangeCleanup {
    has origin is ImapCommandChannel;
    has complete is Event;

    ImapExchangeCleanup(origin is ImapCommandChannel, complete is Event) {
        self.origin = origin;
        self.complete = complete;
    }

    close() is void {
        if !complete.ready() {
            origin.abort();
        }
    }
}

// Sends the literals of a command as the server asks for them.
object ImapLiteralWriting does ImapContinuationWriting {
    has output is AsyncWriting;
    has command is ImapCommand;

    // Writes command's literals to output.
    ImapLiteralWriting(output is AsyncWriting, command is ImapCommand) {
        self.output = output;
        self.command = command;
    }

    // Writes the next piece; the number of pieces written.
    async write() is int {
        await output.write(command.literal_bytes());
        1;
    }
}

// The channel was used after it closed.
enum ImapChannelClosed is Error = (closed);

hidden object ImapIdleWireInput {
    has input is AsyncReading;
    has output is AsyncWriting;
    has tag is ImapTag;
    has prefix is @byte;
    has limits is ImapCommandLimits;
    has stop is Event;
    has observer is ImapResponseObserving;

    ImapIdleWireInput(
        input is AsyncReading,
        output is AsyncWriting,
        tag is ImapTag,
        prefix is @byte,
        limits is ImapCommandLimits,
        stop is Event,
        observer is ImapResponseObserving
    ) {
        self.input = input;
        self.output = output;
        self.tag = tag;
        self.prefix = prefix;
        self.limits = limits;
        self.stop = stop;
        self.observer = observer;
    }

    async run(group is Supervising<int>) is ImapCommandRead {
        let sent = Event();
        let continuation = ImapIdleContinuation(
            output: output,
            stop: stop,
            sent: sent,
            group: group
        );
        let result = await ImapCommandInput(
            origin: input,
            tag: tag,
            prefix: prefix,
            limits: limits,
            mode: ImapReplyMode(continuation, false, observer)
        ).read();
        if !sent.ready() {
            group.cancel();
        }
        confirm !result.successful() || sent.ready()
            else throw InvalidState.because("IDLE completed before DONE was sent");
        result;
    }
}

// Sends DONE to end IDLE.
object ImapIdleContinuation does ImapContinuationWriting {
    has output is AsyncWriting;
    has stop, sent is Event;
    has group is Supervising<int>;

    // Writes DONE to output once stop fires.
    ImapIdleContinuation(
        output is AsyncWriting,
        stop is Event,
        sent is Event,
        group is Supervising<int>
    ) {
        self.output = output;
        self.stop = stop;
        self.sent = sent;
        self.group = group;
    }

    // Waits for stop and writes DONE.
    async write() is int {
        group.start(ImapDoneWriting(output: output, stop: stop, sent: sent).write());
        1;
    }
}

hidden object ImapDoneWriting {
    has output is AsyncWriting;
    has stop, sent is Event;

    ImapDoneWriting(output is AsyncWriting, stop is Event, sent is Event) {
        self.output = output;
        self.stop = stop;
        self.sent = sent;
    }

    async write() is int {
        await stop.wait();
        sent.set();
        await output.write(Utf8Encoded("DONE\r\n").bytes());
        1;
    }
}

test "exchange state retains exact unread bytes and unbounded serial" {
    let state = ImapExchangeState(prefix: [0.byte(), 255.byte()], serial: BigInt(4294967296));
    test.is(state.prefix(), [0.byte(), 255.byte()]);
    test.is(state.serial().string(), "4294967296");
}
