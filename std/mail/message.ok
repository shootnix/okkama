module mail/message v1.0.0;

// Content and delivery preparation do not infer an SMTP envelope.
// Bodies are borrowed; rendering uses MIME bounds and observes bytes once.
// Address/origination policy remains with future addressed-message consumers.

import "mime/part" take MimeBody, MimePart, MimeLimits, ParsedMime, InvalidMime, BinaryBody,
    TextBody;
import "mime/word" take EncodedWord;
import "random/source" take Randomizing, SecureRandom, PcgRandom;
import "time/clock" take Timing, SystemClock, Instant;
import "encoding/hex" take HexEncoded;
import "collections/sequence" take Sequencing;
import "testing/time" take ManualClock;
import "message/header" take MessageHeader, MessageHeaderName, MessageHeaders;
import "io/stream" take ByteSource;
import "compare" take Order;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "time/zone" take ZonedDateTime, FixedZone, Fold;
import "time/date" take Date, Weekday, InvalidDate;
import "time/day" take TimeOfDay, InvalidTimeOfDay;
import "time/local_datetime" take LocalDateTime;
import "time/duration" take Duration, DurationUnit;
import "mime/media_type" take MimeItems, MimePosition;
import "error" take InvalidArgument;

object MailMessage does ByteSource {
    has content is MimePart;
    has bounds is MimeLimits;

    MailMessage(part is MimePart) {
        content = part;
        bounds = part.limits();
    }

    MailMessage(headers is MessageHeaders, body is MimeBody) {
        let limits = MimeLimits();
        bounds = limits;
        content = MimePart(headers: headers, body: body, limits: limits);
    }

    MailMessage(headers is MessageHeaders, body is MimeBody, limits is MimeLimits) {
        bounds = limits;
        content = MimePart(headers: headers, body: body, limits: limits);
    }

    // MailMessage(from: "Ada <ada@example.test>", to: ["grace@example.test"],
    // subject: "Lunch?", text: "Shall we?"): Date is now, Message-ID is fresh
    // and the body is UTF-8 text. clock: and random: fix them, as tests do.
    MailMessage(
        from is string,
        to is Sequencing<string>,
        subject is string,
        text is string,
        clock is Timing = SystemClock(),
        random is Randomizing = SecureRandom()
    ) {
        let addresses is @string = (0..to.size()).map() -> index {
            to.item(index);
        };
        confirm addresses.size() > 0
            else throw InvalidArgument.because("a message needs a recipient");
        let parts = from.split("@");
        let domain = if parts.size() > 1 {
            parts[parts.size() - 1].split(">")[0];
        }
        else {
            "localhost";
        };
        let ascii = Utf8Encoded(subject).bytes().reduce(true) -> plain, octet {
            plain && octet.int() < 128;
        };
        let title = if ascii {
            subject;
        }
        else {
            EncodedWord(subject).string();
        };
        let utc = FixedZone(name: "UTC", offset: Duration(seconds: 0));
        let headers = MessageHeaders(
            MessageHeader(name: MessageHeaderName("From"), value: from),
            MessageHeader(name: MessageHeaderName("To"), value: addresses.join(", ")),
            MessageHeader(name: MessageHeaderName("Subject"), value: title),
            MessageHeader(
                name: MessageHeaderName("Date"),
                value: MailDate(ZonedDateTime(instant: clock.instant(), zone: utc)).string()
            ),
            MessageHeader(
                name: MessageHeaderName("Message-ID"),
                value: MessageId("<" + HexEncoded(random.bytes(16)).string() + "@" + domain + ">").string()
            ),
            MessageHeader(name: MessageHeaderName("MIME-Version"), value: "1.0"),
            MessageHeader(
                name: MessageHeaderName("Content-Type"),
                value: "text/plain; charset=utf-8"
            ),
        );
        let limits = MimeLimits();
        bounds = limits;
        content = MimePart(
            headers: headers,
            body: TextBody(origin: text, charset: "utf-8"),
            limits: limits
        );
    }

    part() is MimePart {
        content;
    }

    headers() is MessageHeaders {
        content.headers();
    }

    body() is MimeBody {
        content.body();
    }

    limits() is MimeLimits {
        bounds;
    }

    bytes() is @byte {
        content.bytes();
    }

    // The message to read: headers and body as text, each line ending in
    // "\n". bytes() is the wire form, with CRLF.
    string() is string {
        Utf8Decoded(content.bytes()).string().split("\r\n").join("\n");
    }
}

object ParsedMail {
    has origin is @byte;
    has limits is MimeLimits;

    ParsedMail(origin is @byte) {
        self.origin = origin;
        limits = MimeLimits();
    }

    ParsedMail(origin is @byte, limits is MimeLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    message() is MailMessage {
        try {
            let part = ParsedMime(origin: origin, limits: limits).part();
            MailMessage(part);
        }
        catch InvalidMime.located(offset, reason) {
            throw InvalidMail.located(offset, reason);
        }
    }
}

object DeliveredMail does ByteSource {
    has content is MailMessage;

    DeliveredMail(origin is MailMessage) {
        content = origin;
    }

    bytes() is @byte {
        let entries = content.headers().entries();
        let size = entries.size();
        let fields is @MessageHeader = (0..size).map() -> index {
            entries.item(index);
        };
        let public_fields is @MessageHeader = fields.filter() -> field {
            field.name().order(MessageHeaderName("Bcc")) != Order.equal
                && field.name().order(MessageHeaderName("Resent-Bcc")) != Order.equal;
        };
        content.part().headers(
            MessageHeaders(entries: public_fields, maximum_entries: size),
            content.limits()
        ).bytes();
    }
}

object MessageId {
    has origin is string;

    MessageId(origin is string) {
        MailIdentifier(origin).validate();
        self.origin = origin;
    }

    string() is string {
        origin;
    }
}

enum InvalidMail is Error = (located(offset is int, reason is string));

// Numeric dates are immutable snapshots; a custom zone is observed once.
object MailDate {
    has text is string;

    MailDate(origin is ZonedDateTime) {
        text = MailDatePrinting(origin: origin, known: true).string();
    }

    MailDate(origin is ZonedDateTime, offset_known is bool) {
        text = MailDatePrinting(origin: origin, known: offset_known).string();
    }

    string() is string {
        text;
    }
}

object ParsedMailDate {
    has origin is string;
    has maximum is int;

    ParsedMailDate(origin is string) {
        self.origin = origin;
        maximum = 4096;
    }

    ParsedMailDate(origin is string, maximum_bytes is int) {
        confirm maximum_bytes >= 0
            else throw InvalidArgument.because("mail date bound must be nonnegative");
        self.origin = origin;
        maximum = maximum_bytes;
    }

    date_time() is ZonedDateTime {
        MailDateParsing(origin: origin, maximum: maximum).parsed().date_time();
    }

    offset_known() is bool {
        MailDateParsing(origin: origin, maximum: maximum).parsed().offset_known();
    }
}

hidden object MailDatePrinting {
    has origin is ZonedDateTime;
    has known is bool;

    MailDatePrinting(origin is ZonedDateTime, known is bool) {
        self.origin = origin;
        self.known = known;
    }

    string() is string {
        let offset = origin.offset();
        let raw = offset::Span::seconds;
        let elapsed = origin.instant().unix_duration();
        confirm elapsed::Span::seconds.denominator() == "1"
            else throw InvalidMail.located(0, "mail time must contain whole seconds");
        confirm raw.denominator() == "1"
            else throw InvalidMail.located(0, "mail offset must contain whole seconds");
        let seconds = raw.int();
        confirm seconds % 60 == 0 && seconds > -86400 && seconds < 86400
            else throw InvalidMail.located(
                0,
                "mail offset must contain whole minutes within one day"
            );
        confirm known || seconds == 0
            else throw InvalidMail.located(0, "unknown mail offset must have zero displacement");
        let local = try {
            LocalDateTime(date: Date(1970, 1, 1), time: TimeOfDay(0, 0, 0, 0)).plus(
                elapsed.plus(offset)
            );
        }
        catch failure is InvalidDate {
            throw InvalidMail.located(0, "mail date outside supported calendar");
        };
        let date = local.date();
        let time = local.time();
        let calendar = MailCalendar();
        confirm date::Calendar::year >= 1900 && time::Clock::nanosecond == 0
            else throw InvalidMail.located(
                0,
                "mail dates require years 1900..9999 and whole seconds"
            );
        let magnitude = if seconds < 0 {
            -seconds;
        }
        else {
            seconds;
        };
        let sign = if seconds < 0 || !known {
            "-";
        }
        else {
            "+";
        };
        calendar.weekday(date.weekday()) + ", " + calendar.padded(date::Calendar::day) + " " + calendar.month(
            date::Calendar::month
        ) + " " + date::Calendar::year.string() + " " +
            calendar.padded(time::Clock::hour) + ":" + calendar.padded(time::Clock::minute) + ":" + calendar.padded(
                time::Clock::second
            ) + " " +
            sign + calendar.padded((magnitude / 3600).int()) + calendar.padded(
                ((magnitude % 3600) / 60).int()
            );
    }
}

hidden object MailParsedDate {
    has local is LocalDateTime;
    has offset is MailDateOffset;

    MailParsedDate(local is LocalDateTime, offset is MailDateOffset) {
        self.local = local;
        self.offset = offset;
    }

    date_time() is ZonedDateTime {
        let zone = FixedZone(
            name: "mail",
            offset: Duration(offset.seconds().rat(), DurationUnit.second)
        );
        ZonedDateTime(instant: zone.instant(local, Fold.earlier), zone: zone);
    }

    offset_known() is bool {
        offset.known();
    }
}

hidden object MailDateOffset {
    has displacement is int;
    has recognized is bool;

    MailDateOffset(seconds is int, known is bool) {
        displacement = seconds;
        recognized = known;
    }

    seconds() is int {
        displacement;
    }

    known() is bool {
        recognized;
    }
}

hidden object MailDateParsing {
    has origin is string;
    has maximum is int;

    MailDateParsing(origin is string, maximum is int) {
        self.origin = origin;
        self.maximum = maximum;
    }

    parsed() is MailParsedDate {
        let tokens = MailDateTokens(origin: origin, maximum: maximum).values();
        let count = tokens.size();
        let calendar = MailCalendar();
        confirm count == 5 || count == 6
            else throw InvalidMail.located(0, "mail date requires day month year time zone");
        let start = if count == 6 {
            1;
        }
        else {
            0;
        };
        let day = calendar.number(tokens[start], 1, 2);
        let month = calendar.month_number(tokens[start + 1]);
        let year_text = tokens[start + 2];
        let number = calendar.number(year_text, 2, 4);
        let year = if year_text.length() == 2 {
            if number < 50 {
                2000 + number;
            }
            else {
                1900 + number;
            }
        }
        else {
            if year_text.length() == 3 {
                1900 + number;
            }
            else {
                number;
            }
        };
        confirm year >= 1900 else throw InvalidMail.located(0, "mail year must be at least 1900");
        let clock = tokens[start + 3].split(":");
        confirm clock.size() == 2 || clock.size() == 3
            else throw InvalidMail.located(0, "mail time requires HH:MM[:SS]");
        let hour = calendar.number(clock[0], 2, 2);
        let minute = calendar.number(clock[1], 2, 2);
        let second = if clock.size() == 3 {
            calendar.number(clock[2], 2, 2);
        }
        else {
            0;
        };
        let local = try {
            LocalDateTime(date: Date(year, month, day), time: TimeOfDay(hour, minute, second, 0));
        }
        catch failure is InvalidDate {
            throw InvalidMail.located(0, "invalid mail calendar date");
        }
        catch failure is InvalidTimeOfDay {
            throw InvalidMail.located(0, "invalid mail time (leap seconds are unsupported)");
        };
        if start == 1 {
            confirm calendar.lower(tokens[0]) == calendar.lower(
                calendar.weekday(local.date().weekday()) + ","
            )
                else throw InvalidMail.located(0, "mail weekday does not match date");
        }
        MailParsedDate(local: local, offset: self.zone(tokens[start + 4]));
    }

    hidden zone(text is string) is MailDateOffset {
        let calendar = MailCalendar();
        let name = calendar.lower(text);
        if text.length() == 5 && (text.slice(0, 1) == "+" || text.slice(0, 1) == "-") {
            let hour = calendar.number(text.slice(1, 3), 2, 2);
            let minute = calendar.number(text.slice(3, 5), 2, 2);
            confirm hour <= 23 && minute <= 59
                else throw InvalidMail.located(0, "mail numeric offset outside range");
            let sign = if text.slice(0, 1) == "-" {
                -1;
            }
            else {
                1;
            };
            return MailDateOffset(
                seconds: sign * (hour * 3600 + minute * 60),
                known: text != "-0000"
            );
        }
        let hours = match name {
            case "ut", "gmt" {
                0;
            }
            case "est" {
                -5;
            }
            case "edt" {
                -4;
            }
            case "cst" {
                -6;
            }
            case "cdt" {
                -5;
            }
            case "mst" {
                -7;
            }
            case "mdt" {
                -6;
            }
            case "pst" {
                -8;
            }
            case "pdt" {
                -7;
            }
            else {
                100;
            }
        };
        if hours != 100 {
            return MailDateOffset(seconds: hours * 3600, known: true);
        }
        if name.length() == 1 && "abcdefghiklmnopqrstuvwxyz".split(name).size() == 2 {
            return MailDateOffset(seconds: 0, known: false);
        }
        throw InvalidMail.located(0, "unsupported mail date zone");
    }
}

hidden object MailDateTokens {
    has origin is string;
    has maximum is int;

    MailDateTokens(origin is string, maximum is int) {
        self.origin = origin;
        self.maximum = maximum;
    }

    values() is @string {
        confirm origin.length() <= maximum
            else throw InvalidMail.located(0, "mail date input bound exceeded");
        // Characters are read by code (#175). A token is a run of plain characters outside
        // comments, taken whole with one slice; spaces, tabs, folds and comments separate.
        let characters = origin.characters();
        let size = characters.size();
        let tokens is MimeItems<string> = MimeItems();
        let start = MimePosition(-1);
        let depth = MimePosition(0);
        let consumed = MimePosition(0);
        for (0..size) -> index {
            if index >= consumed.index() {
                let value = characters[index].code();
                confirm value < 128
                    else throw InvalidMail.located(index, "mail date must be ASCII");
                if depth.index() == 0 && value >= 33 && value <= 126 && value != 40 && value != 41 {
                    if start.index() < 0 {
                        start = start.following(index);
                    }
                }
                else {
                    if start.index() >= 0 {
                        tokens = tokens.following(origin.slice(start.index(), index));
                        start = start.following(-1);
                    }
                    if value == 13 {
                        confirm index + 2 < size
                            && characters[index + 1].code() == 10
                            && (characters[index + 2].code() == 32
                            || characters[index + 2].code() == 9)
                            else throw InvalidMail.located(index, "invalid mail date folding");
                        consumed = consumed.following(index + 2);
                    }
                    else {
                        confirm value == 9 || (value >= 32 && value <= 126)
                            else throw InvalidMail.located(index, "invalid mail date character");
                        if value == 92 && depth.index() > 0 {
                            confirm index + 1 < size
                                else throw InvalidMail.located(index, "unterminated comment escape");
                            let code = characters[index + 1].code();
                            confirm code == 9 || (code >= 32 && code <= 126)
                                else throw InvalidMail.located(
                                    index + 1,
                                    "invalid escaped comment character"
                                );
                            consumed = consumed.following(index + 2);
                        }
                        else {
                            if value == 40 {
                                confirm depth.index() < 32
                                    else throw InvalidMail.located(
                                        index,
                                        "mail date comment depth exceeded"
                                    );
                                depth = depth.following(depth.index() + 1);
                            }
                            else {
                                if value == 41 {
                                    confirm depth.index() > 0
                                        else throw InvalidMail.located(
                                            index,
                                            "unexpected comment close"
                                        );
                                    depth = depth.following(depth.index() - 1);
                                }
                            }
                        }
                    }
                }
            }
        }
        confirm depth.index() == 0
            else throw InvalidMail.located(origin.length(), "unterminated mail date comment");
        if start.index() >= 0 {
            tokens = tokens.following(origin.slice(start.index(), size));
        }
        tokens.entries();
    }
}

hidden object MailCalendar {
    MailCalendar();

    lower(text is string) is string {
        let bytes is @byte = Utf8Encoded(text).bytes().map() -> octet {
            let value = octet.int();
            if value >= 65 && value <= 90 {
                (value + 32).byte();
            }
            else {
                octet;
            }
        };
        Utf8Decoded(bytes).string();
    }

    number(text is string, minimum is int, maximum is int) is int {
        confirm text.length() >= minimum && text.length() <= maximum
            else throw InvalidMail.located(0, "invalid mail date number width");
        Utf8Encoded(text).bytes().reduce(0) -> result, octet {
            let value = octet.int();
            confirm value >= 48 && value <= 57
                else throw InvalidMail.located(0, "invalid mail date number");
            result * 10 + value - 48;
        };
    }

    padded(number is int) is string {
        if number < 10 {
            "0" + number.string();
        }
        else {
            number.string();
        }
    }

    month(number is int) is string {
        let names = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
        ];
        names[number - 1];
    }

    month_number(text is string) is int {
        let name = self.lower(text);
        for (1..13) -> number {
            if self.lower(self.month(number)) == name {
                return number;
            }
        }
        throw InvalidMail.located(0, "invalid mail month");
    }

    weekday(day is Weekday) is string {
        match day {
            case Weekday.monday {
                "Mon";
            }
            case Weekday.tuesday {
                "Tue";
            }
            case Weekday.wednesday {
                "Wed";
            }
            case Weekday.thursday {
                "Thu";
            }
            case Weekday.friday {
                "Fri";
            }
            case Weekday.saturday {
                "Sat";
            }
            case Weekday.sunday {
                "Sun";
            }
        }
    }
}

hidden object MailIdentifier {
    has origin is string;

    MailIdentifier(origin is string) {
        self.origin = origin;
    }

    validate() is void {
        let size = origin.length();
        confirm size >= 5 && size <= 998
            else throw InvalidMail.located(0, "message identifier length outside 5..998");
        // Characters are read by code (#175).
        let characters = origin.characters();
        confirm characters[0].code() == 60 && characters[size - 1].code() == 62
            else throw InvalidMail.located(0, "message identifier requires angle brackets");
        // The first @ is past the opening < and before the closing >.
        let at = origin.find("@") else -1;
        confirm at > 0 else throw InvalidMail.located(1, "message identifier requires @");
        self.atom(characters, 1, at);
        if characters[at + 1].code() == 91 {
            confirm characters[size - 2].code() == 93
                else throw InvalidMail.located(size - 2, "unclosed identifier literal");
            for (at + 2..size - 2) -> index {
                let value = characters[index].code();
                confirm (value >= 33 && value <= 90) || (value >= 94 && value <= 126)
                    else throw InvalidMail.located(index, "invalid identifier literal character");
            }
        }
        else {
            self.atom(characters, at + 1, size - 1);
        }
    }

    hidden atom(characters is @char, start is int, stop is int) is void {
        confirm start < stop else throw InvalidMail.located(start, "empty identifier atom");
        for (start..stop) -> index {
            let value = characters[index].code();
            if value == 46 {
                confirm index > start && index + 1 < stop && characters[index - 1].code() != 46
                    else throw InvalidMail.located(index, "empty identifier dot segment");
            }
            else {
                // Letters, digits and the punctuation ! # $ % & ' * + - / = ? ^ _ ` { | } ~.
                let allowed = match value {
                    case 33, 35, 36, 37, 38, 39, 42, 43, 45, 47, 61, 63, 94, 95, 96, 123, 124, 125, 126 {
                        true;
                    }
                    else {
                        (value >= 48 && value <= 57)
                            || (value >= 65 && value <= 90)
                            || (value >= 97 && value <= 122);
                    }
                };
                confirm allowed
                    else throw InvalidMail.located(index, "invalid identifier atom character");
            }
        }
    }
}

test "delivery preparation retains the source message" {
    let fields = MessageHeaders(
        MessageHeader(name: MessageHeaderName("Bcc"), value: "private@example.test")
    );
    let message = MailMessage(headers: fields, body: BinaryBody([]));
    test.is(DeliveredMail(message).bytes().size(), 2);
    test.is(message.headers().entries().size(), 1);
}

test "message identifiers preserve case and literal spelling" {
    test.is(MessageId("<a.1@[IPv6:::1]>").string(), "<a.1@[IPv6:::1]>");
    let invalid = try {
        MessageId("<a..b@example.test>");
        false;
    }
    catch failure is InvalidMail {
        true;
    };
    test.ok(invalid);
}

test "mail dates preserve unknown zero offsets" {
    let parsed = ParsedMailDate("Fri, 21 Nov 1997 09:55:06 -0000");
    test.is(
        MailDate(origin: parsed.date_time(), offset_known: parsed.offset_known()).string(),
        "Fri, 21 Nov 1997 09:55:06 -0000"
    );
}

test "a message from its fields sets its date, identifier and content type" {
    let clock = ManualClock(Instant(Duration(seconds: 1700000000)));
    let message = MailMessage(
        from: "Ada <ada@example.test>",
        to: ["grace@example.test", "alan@example.test"],
        subject: "Lunch?",
        text: "Shall we?\r\n",
        clock: clock,
        random: PcgRandom(7),
    );
    let fields = message.headers();
    test.is(fields.first(MessageHeaderName("To")), "grace@example.test, alan@example.test");
    test.is(fields.first(MessageHeaderName("Date")), "Tue, 14 Nov 2023 22:13:20 +0000");
    test.is(fields.first(MessageHeaderName("Message-ID")).split("@")[1], "example.test>");
    test.is(fields.first(MessageHeaderName("Content-Type")), "text/plain; charset=utf-8");
    let back = ParsedMail(message.bytes()).message();
    test.is(back.headers().first(MessageHeaderName("Subject")), "Lunch?");
    test.ok(message.string().contains("\nSubject: Lunch?\n"));
    test.ok(message.string().ends_with("\n\nShall we?\n"));
    test.ok(!message.string().contains("\r"));
    let other = MailMessage(
        from: "a@b.test",
        to: ["c@d.test"],
        subject: "Привет",
        text: "",
        clock: clock,
        random: PcgRandom(1)
    );
    test.is(other.headers().first(MessageHeaderName("Subject")).slice(0, 8), "=?UTF-8?");
    test.throws(InvalidArgument) {
        let nobody is @string = [];
        MailMessage(
            from: "a@b.test",
            to: nobody,
            subject: "x",
            text: "",
            clock: clock,
            random: PcgRandom(1)
        );
    };
}

test "mail date tokens and message identifiers are read by position" {
    test.is(
        MailDateTokens(origin: "Thu, 12 Nov 2026 20:26:19 +0500", maximum: 998).values(),
        ["Thu,", "12", "Nov", "2026", "20:26:19", "+0500"]
    );
    test.is(
        MailDateTokens(
            origin: " Thu,(day (nested \\) x)) 12\tNov\r\n 2026(c)20:26:19 +0500 (UTC) ",
            maximum: 998
        ).values(),
        ["Thu,", "12", "Nov", "2026", "20:26:19", "+0500"]
    );
    test.is(MailDateTokens(origin: "a\\b  c\r\n\t", maximum: 99).values(), ["a\\b", "c"]);
    test.is(MailDateTokens(origin: "", maximum: 99).values().size(), 0);
    let control = "12" + Utf8Decoded([1.byte()]).string();
    let dates is @int = [
        "12 Nov é",
        "12\r\nNov",
        "12\r\n",
        control,
        "(a \\",
        "(a \\é)",
        "a)",
        "(a",
        "((((((((((((((((((((((((((((((((("
    ].map() -> date {
        try {
            MailDateTokens(origin: date, maximum: 99).values();
            -1;
        }
        catch InvalidMail.located(at, _reason) {
            at;
        }
    };
    test.is(dates, [7, 2, 2, 2, 3, 4, 1, 2, 32]);
    let identifiers is @int = [
        "<a.b@c.d>",
        "<a@[1.2.3.4]>",
        "<!#$%&'*+-/=?^_`{|}~@x>",
        "abc@d>",
        "<abcd>",
        "<a..b@c>",
        "<.ab@c>",
        "<ab.@c>",
        "<a b@c>",
        "<aé@c>",
        "<ид@c>",
        "<a@[1\\2]>",
        "<a@[1.2>",
        "<@b.c>",
        "<ab@>",
        "<a@b@c>",
        "<a>@b>",
        "<a@b(c>"
    ].map() -> identifier {
        try {
            MailIdentifier(identifier).validate();
            -1;
        }
        catch InvalidMail.located(at, _reason) {
            at;
        }
    };
    test.is(identifiers, [-1, -1, -1, 0, 1, 3, 1, 3, 2, 2, 1, 5, 6, 1, 4, 4, 2, 4]);
}
