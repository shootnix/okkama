module mail/mbox v1.0.0;

// mbox archives in the mboxrd flavour: messages one after another, each behind
// a `From ` line.
//
//     let record = MboxRecord(separator: MboxSeparator("From ada@example.test Thu Nov 13 10:00:00 2026"), message: message);
//     let bytes = MboxArchive(record).bytes();
//     let back = ParsedMbox(bytes).records();
//     back.first().message();
//
// Lines of the archive end in LF, messages inside keep CRLF, and a `From ` line
// inside a message is quoted with `>` and unquoted when read. By default an
// archive holds 1000 messages and 64 MiB. Mbox in mail/mbox_store keeps one in
// a file.

import "mail/message" take MailMessage, ParsedMail;
import "mime/part" take MimePart, MimeLimits, MimeLimitFailure;
import "mime/media_type" take MimeItems, MimePosition;
import "collections/sequence" take Sequencing;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "io/stream" take ByteSource;
import "io/buffer" take ByteBuffer;
import "error" take InvalidArgument;

// The `From ` line before a message.
object MboxSeparator {
    has origin is string;

    // The line, without its newline: printable ASCII, 8 to 998 long, `From `
    // and a sender; InvalidMbox otherwise.
    MboxSeparator(origin is string) {
        confirm origin.length() >= 8 && origin.length() <= 998
            else throw InvalidMbox.located(0, "separator length outside 8..998");
        for (0..origin.length()) -> index {
            let bytes = Utf8Encoded(origin.slice(index, index + 1)).bytes();
            let value = bytes[0].int();
            confirm bytes.size() == 1 && value >= 32 && value <= 126
                else throw InvalidMbox.located(index, "separator must be printable ASCII");
        }
        confirm origin.slice(0, 5) == "From " && origin.slice(5, 6) != " "
            else throw InvalidMbox.located(0, "separator requires From and a sender token");
        let spaces = (6..origin.length()).filter() -> index {
            origin.slice(index, index + 1) == " ";
        };
        confirm spaces.size() > 0 else throw InvalidMbox.located(5, "separator lacks metadata");
        let present = (spaces[0] + 1..origin.length()).reduce(false) -> found, index {
            found || origin.slice(index, index + 1) != " ";
        };
        confirm present else throw InvalidMbox.located(spaces[0], "separator lacks metadata");
        self.origin = origin;
    }

    // The line.
    string() is string {
        origin;
    }
}

// A message with its separator line.
object MboxRecord {
    has separator is MboxSeparator;
    has message is MailMessage;

    // message behind separator.
    MboxRecord(separator is MboxSeparator, message is MailMessage) {
        self.separator = separator;
        self.message = message;
    }

    // The separator.
    separator() is MboxSeparator {
        separator;
    }

    // The message.
    message() is MailMessage {
        message;
    }
}

// How large an archive may be.
object MboxLimits {
    has messages, wire_bytes is int;
    has mime is MimeLimits;

    // 1000 messages, 64 MiB and the default MIME limits.
    MboxLimits() {
        messages = 1000;
        wire_bytes = 67108864;
        mime = MimeLimits();
    }

    // The limits as given.
    MboxLimits(messages is int, wire_bytes is int, mime is MimeLimits) {
        confirm messages >= 0 && wire_bytes >= 0
            else throw InvalidArgument.because("mbox bounds must be nonnegative");
        self.messages = messages;
        self.wire_bytes = wire_bytes;
        self.mime = mime;
    }

    // The MIME limits of each message.
    mime() is MimeLimits {
        mime;
    }

    // Messages and bytes in all.
    cap Limits {
        messages is int {
            messages;
        }

        wire_bytes is int {
            wire_bytes;
        }
    }
}

// Records as an mbox archive.
object MboxArchive does ByteSource {
    has records is @MboxRecord;
    has limits is MboxLimits;

    // The records, within the default limits.
    MboxArchive(records is Sequencing<MboxRecord>) {
        let bounds = MboxLimits();
        self.records = MboxRecordsSnapshot(origin: records, maximum: bounds::Limits::messages).values();
        limits = bounds;
    }

    // The same, one argument per part: MboxArchive(a, b).
    MboxArchive(records is ...MboxRecord) {
        let listed is @MboxRecord = records...;
        let bounds = MboxLimits();
        self.records = MboxRecordsSnapshot(origin: listed, maximum: bounds::Limits::messages).values();
        limits = bounds;
    }

    // The records within limits.
    MboxArchive(records is Sequencing<MboxRecord>, limits is MboxLimits) {
        self.records = MboxRecordsSnapshot(origin: records, maximum: limits::Limits::messages).values();
        self.limits = limits;
    }

    // The archive.
    bytes() is @byte {
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let output = MboxOutput(
            buffer: buffer,
            maximum: limits::Limits::wire_bytes,
            kind: "wire_bytes"
        );
        for records -> record {
            let message = record.message();
            let wire = MimePart(
                headers: message.headers(),
                body: message.body(),
                limits: limits.mime()
            ).bytes();
            output.write(Utf8Encoded(record.separator().string() + "\n").bytes());
            let start = MimePosition(0);
            loop {
                last if start.index() == wire.size();
                let end = MboxMimeLine(origin: wire, start: start.index()).end();
                let line = MboxBytes(origin: wire, start: start.index(), stop: end).bytes();
                if MboxFromLine(line).escaped() {
                    output.write([62.byte()]);
                }
                output.write(line);
                output.write([10.byte()]);
                start = start.following(end + 2);
            }
            output.write([10.byte()]);
        }
        buffer.content().bytes();
    }
}

// An archive read from bytes.
object ParsedMbox {
    has origin is @byte;
    has limits is MboxLimits;

    // Reads origin within the default limits.
    ParsedMbox(origin is @byte) {
        self.origin = origin;
        limits = MboxLimits();
    }

    // Reads origin within limits.
    ParsedMbox(origin is @byte, limits is MboxLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    // The records; InvalidMbox says where the bytes are wrong.
    records() is Sequencing<MboxRecord> {
        MboxParsing(origin: origin, limits: limits).records();
    }
}

// Bytes that are not an archive; offset and reason say where and why.
enum InvalidMbox is Error = (located(offset is int, reason is string));

// An archive over a limit; kind says which.
enum MboxLimitExceeded is Error = (kind(kind is string));

hidden object MboxRecordsSnapshot {
    has origin is Sequencing<MboxRecord>;
    has maximum is int;

    MboxRecordsSnapshot(origin is Sequencing<MboxRecord>, maximum is int) {
        self.origin = origin;
        self.maximum = maximum;
    }

    values() is @MboxRecord {
        let size = origin.size();
        confirm size >= 0
            else throw InvalidArgument.because("mbox source size must be nonnegative");
        confirm size <= maximum else throw MboxLimitExceeded.kind("messages");
        let values is @MboxRecord = (0..size).map() -> index {
            origin.item(index);
        };
        values;
    }
}

hidden object MboxOutput {
    has buffer is ByteBuffer;
    has maximum is int;
    has kind is string;

    MboxOutput(buffer is ByteBuffer, maximum is int, kind is string) {
        self.buffer = buffer;
        self.maximum = maximum;
        self.kind = kind;
    }

    write(bytes is @byte) is void {
        if bytes.size() > maximum - buffer.content().size() {
            if kind == "message_bytes" {
                throw MimeLimitFailure.kind("body_bytes");
            }
            throw MboxLimitExceeded.kind(kind);
        }
        buffer.writing().write(bytes);
    }
}

hidden object MboxBytes {
    has origin is @byte;
    has start, stop is int;

    MboxBytes(origin is @byte, start is int, stop is int) {
        self.origin = origin;
        self.start = start;
        self.stop = stop;
    }

    bytes() is @byte {
        let bytes is @byte = (start..stop).map() -> index {
            origin[index];
        };
        bytes;
    }
}

hidden object MboxFromLine {
    has origin is @byte;

    MboxFromLine(origin is @byte) {
        self.origin = origin;
    }

    plain() is bool {
        self.prefix(0);
    }

    escaped() is bool {
        for (0..origin.size()) -> index {
            if origin[index].int() != 62 {
                return self.prefix(index);
            }
        }
        false;
    }

    hidden prefix(start is int) is bool {
        origin.size() - start >= 5
            && origin[start].int() == 70
            && origin[start + 1].int() == 114
            && origin[start + 2].int() == 111
            && origin[start + 3].int() == 109
            && origin[start + 4].int() == 32;
    }
}

hidden object MboxMimeLine {
    has origin is @byte;
    has start is int;

    MboxMimeLine(origin is @byte, start is int) {
        self.origin = origin;
        self.start = start;
    }

    end() is int {
        for (start..origin.size()) -> index {
            let value = origin[index].int();
            confirm value != 0 && value != 10
                else throw InvalidMbox.located(index, "NUL or bare LF in MIME wire data");
            if value == 13 {
                confirm index + 1 < origin.size() && origin[index + 1].int() == 10
                    else throw InvalidMbox.located(index, "bare CR in MIME wire data");
                return index;
            }
        }
        throw InvalidMbox.located(origin.size(), "MIME wire data requires terminal CRLF");
    }
}

hidden object MboxLine {
    has origin is @byte;
    has start is int;

    MboxLine(origin is @byte, start is int) {
        self.origin = origin;
        self.start = start;
    }

    end() is int {
        for (start..origin.size()) -> index {
            let value = origin[index].int();
            confirm value != 0 && value != 13
                else throw InvalidMbox.located(index, "NUL or CR in LF-only mbox");
            if value == 10 {
                return index;
            }
        }
        throw InvalidMbox.located(origin.size(), "mbox line requires terminal LF");
    }
}

hidden object MboxSeparatorBytes {
    has origin is @byte;
    has start, stop is int;

    MboxSeparatorBytes(origin is @byte, start is int, stop is int) {
        self.origin = origin;
        self.start = start;
        self.stop = stop;
    }

    separator() is MboxSeparator {
        confirm stop - start <= 998
            else throw InvalidMbox.located(start, "separator exceeds 998 bytes");
        for (start..stop) -> index {
            confirm origin[index].int() >= 32 && origin[index].int() <= 126
                else throw InvalidMbox.located(index, "separator must be printable ASCII");
        }
        try {
            MboxSeparator(
                Utf8Decoded(MboxBytes(origin: origin, start: start, stop: stop).bytes()).string()
            );
        }
        catch InvalidMbox.located(offset, reason) {
            throw InvalidMbox.located(start + offset, reason);
        }
    }
}

hidden object MboxRecordStart {
    has start is int;
    has separator is MboxSeparator;

    MboxRecordStart(start is int, separator is MboxSeparator) {
        self.start = start;
        self.separator = separator;
    }

    start() is int {
        start;
    }

    separator() is MboxSeparator {
        separator;
    }

    following(start is int, separator is MboxSeparator) is ^MboxRecordStart {
        ^start = start;
        ^separator = separator;
    }
}

hidden object MboxParsing {
    has origin is @byte;
    has limits is MboxLimits;

    MboxParsing(origin is @byte, limits is MboxLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    records() is @MboxRecord {
        confirm origin.size() <= limits::Limits::wire_bytes
            else throw MboxLimitExceeded.kind("wire_bytes");
        let records is MimeItems<MboxRecord> = MimeItems();
        if origin.size() == 0 {
            return records.entries();
        }
        confirm limits::Limits::messages > 0 else throw MboxLimitExceeded.kind("messages");
        let first = MboxLine(origin: origin, start: 0).end();
        let current = MboxRecordStart(
            start: first + 1,
            separator: MboxSeparatorBytes(origin, 0, first).separator()
        );
        let position = MimePosition(first + 1);
        loop {
            let start = position.index();
            last if start == origin.size();
            let end = MboxLine(origin: origin, start: start).end();
            if MboxFromLine(MboxBytes(origin: origin, start: start, stop: end).bytes()).plain() {
                records = records.following(
                    MboxDecodedRecord(
                        origin: origin,
                        start: current.start(),
                        stop: start,
                        separator: current.separator(),
                        limits: limits.mime()
                    ).record()
                );
                confirm records.size() < limits::Limits::messages
                    else throw MboxLimitExceeded.kind("messages");
                current = current.following(
                    end + 1,
                    MboxSeparatorBytes(origin: origin, start: start, stop: end).separator()
                );
            }
            position = position.following(end + 1);
        }
        records = records.following(
            MboxDecodedRecord(
                origin: origin,
                start: current.start(),
                stop: origin.size(),
                separator: current.separator(),
                limits: limits.mime()
            ).record()
        );
        records.entries();
    }
}

hidden object MboxDecodedRecord {
    has origin is @byte;
    has start, stop is int;
    has separator is MboxSeparator;
    has limits is MimeLimits;

    MboxDecodedRecord(
        origin is @byte,
        start is int,
        stop is int,
        separator is MboxSeparator,
        limits is MimeLimits
    ) {
        self.origin = origin;
        self.start = start;
        self.stop = stop;
        self.separator = separator;
        self.limits = limits;
    }

    record() is MboxRecord {
        confirm stop - start >= 2 && origin[stop - 1].int() == 10 && origin[stop - 2].int() == 10
            else throw InvalidMbox.located(stop, "record requires an extra empty delimiter line");
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let output = MboxOutput(
            buffer: buffer,
            maximum: limits::Limits::body_bytes,
            kind: "message_bytes"
        );
        let position = MimePosition(start);
        loop {
            let beginning = position.index();
            last if beginning == stop - 1;
            let end = MboxLine(origin: origin, start: beginning).end();
            let line = MboxBytes(origin: origin, start: beginning, stop: end).bytes();
            let quoted = line.size() > 0 && line[0].int() == 62 && MboxFromLine(line).escaped();
            if quoted {
                output.write(MboxBytes(origin: origin, start: beginning + 1, stop: end).bytes());
            }
            else {
                output.write(line);
            }
            output.write([13.byte(), 10.byte()]);
            position = position.following(end + 1);
        }
        MboxRecord(
            separator: separator,
            message: ParsedMail(buffer.content().bytes(), limits).message()
        );
    }
}

test "empty mboxrd archive" {
    let empty is @MboxRecord = [];
    test.is(MboxArchive(empty).bytes().size(), 0);
    test.is(ParsedMbox([]).records().size(), 0);
}

test "mboxrd quoting preserves already quoted From lines" {
    let wire = "\r\nFrom sender\r\n>From quoted\r\n";
    let record = MboxRecord(
        separator: MboxSeparator("From sender date"),
        message: ParsedMail(Utf8Encoded(wire).bytes()).message()
    );
    let parsed = ParsedMbox(MboxArchive(record).bytes()).records().item(0);
    test.is(Utf8Decoded(parsed.message().bytes()).string(), wire);
}
