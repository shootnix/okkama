module mail/imap_metadata v1.0.0;

// Values read out of IMAP responses: response codes, LIST entries, flags, UID
// ranges and SEARCH results. ImapSession uses them.

import "mail/imap_response" take ParsedImapResponse;
import "encoding/utf" take Utf8Encoded;

import "mail/imap_data" take ParsedImapData, ImapValue, ImapValueKind, ImapDataTokens,
    ImapDataLexing, ImapDataTree, ImapDataLimits, ImapDataUpper, InvalidImapData;
import "mail/imap_response" take ImapResponse, ImapResponseKind, ImapResponseQuote;
import "mail/imap_name" take ImapMailboxName, ImapUtf7Decoded;
import "mail/imap_uid" take ImapUid, ImapUidValidity, ImapSequence, ImapUidSet, ImapUidSetLimits,
    ImapUidLimitExceeded;
import "mail/imap_command_reading" take ImapTag;
import "mail/mailbox" take MailFlag, MailFlags, SystemFlag, SystemMailFlag, KeywordFlag;
import "numbers/bigint" take BigInt;
import "collections/sequence" take Sequencing;
import "collections/set" take Set, OrderedSet;
import "mime/media_type" take MimeItems, MimePosition;
import "encoding/utf" take Utf8Decoded;
import "error" take InvalidState;

// The response code of a status response, `[UIDVALIDITY 3857529045]`.
object ImapStatusCode {
    has values is @ImapValue;

    // The code of origin.
    ImapStatusCode(origin is ImapResponse) {
        confirm origin.kind() == ImapResponseKind.tagged
            || origin.name() == "OK"
            || origin.name() == "NO"
            || origin.name() == "BAD"
            || origin.name() == "BYE"
            || origin.name() == "PREAUTH"
            else throw InvalidImapData.because("response is not a status");
        let line = Utf8Decoded(origin.parts().item(0).bytes()).string();
        let start = if origin.kind() == ImapResponseKind.tagged {
            origin.tag().length() + origin.name().length() + 2;
        }
        else {
            origin.name().length() + 3;
        };
        if start < line.length() - 2 && line.slice(start, start + 1) == "[" {
            let quote = ImapResponseQuote();
            let end = MimePosition(start + 1);
            loop {
                confirm end.index() < line.length() - 2
                    else throw InvalidImapData.because("unclosed response code");
                let char = line.slice(end.index(), end.index() + 1);
                last if char == "]" && !quote.quoted();
                quote = quote.accepted(char, end.index());
                end = end.following(end.index() + 1);
            }
            let limits = ImapDataLimits();
            let tokens = ImapDataLexing(
                origin: line.slice(start + 1, end.index()),
                initial: ImapDataTokens(limits)
            ).tokens().entries();
            let tree = ImapDataTree(tokens: tokens, limits: limits);
            let result is MimeItems<ImapValue> = MimeItems();
            let position = MimePosition(0);
            loop {
                last if position.index() == tokens.size();
                let parsed = tree.item(position.index(), 0);
                result = result.following(parsed.parsed());
                position = position.following(parsed.after());
            }
            let entries = result.entries();
            confirm entries.size() > 0 && entries[0].kind() == ImapValueKind.atom
                else throw InvalidImapData.because("response code requires a name");
            values = entries;
        }
        else {
            values = [];
        }
    }

    // Whether there is one.
    present() is bool {
        values.size() > 0;
    }

    // Its name, uppercase.
    name() is string {
        confirm self.present() else throw InvalidState.because("response has no code");
        ImapDataUpper(values[0].string()).string();
    }

    // Its arguments.
    arguments() is Sequencing<ImapValue> {
        confirm self.present() else throw InvalidState.because("response has no code");
        let result is @ImapValue = (1..values.size()).map() -> index {
            values[index];
        };
        result;
    }
}

// One LIST or LSUB entry.
object ImapMailbox {
    has name is ImapMailboxName;
    has separator is @string;
    has attributes is Set<string>;

    // Reads origin; InvalidImapData when it is not one.
    ImapMailbox(origin is ImapResponse) {
        confirm origin.name() == "LIST" || origin.name() == "LSUB"
            else throw InvalidImapData.because("expected LIST or LSUB");
        let values = ParsedImapData(origin).entries();
        confirm values.size() == 5
            else throw InvalidImapData.because("unsupported mailbox response shape");
        let flags = values.item(2).entries();
        let names is @string = (0..flags.size()).map() -> index {
            let flag = flags.item(index);
            confirm flag.kind() == ImapValueKind.atom
                else throw InvalidImapData.because("mailbox attribute is not an atom");
            ImapDataUpper(flag.string()).string();
        };
        let delimiter = values.item(3);
        if delimiter.absent() {
            separator = [];
        }
        else {
            confirm delimiter.kind() == ImapValueKind.quoted && delimiter.string().length() == 1
                else throw InvalidImapData.because("delimiter requires one quoted character or NIL");
            separator = [delimiter.string()];
        }
        let mailbox = values.item(4);
        confirm mailbox.kind() != ImapValueKind.list && mailbox.kind() != ImapValueKind.literal8
            else throw InvalidImapData.because("mailbox name requires an astring");
        name = ImapMailboxName(ImapUtf7Decoded(mailbox.string()).string());
        attributes = OrderedSet(names);
    }

    // The mailbox name.
    name() is ImapMailboxName {
        name;
    }

    // Whether names have a hierarchy delimiter.
    hierarchical() is bool {
        separator.size() > 0;
    }

    // The delimiter, such as `/`.
    delimiter() is string {
        confirm self.hierarchical()
            else throw InvalidState.because("flat mailbox namespace has no delimiter");
        separator[0];
    }

    // Its attributes, such as `\HasChildren`.
    attributes() is Set<string> {
        attributes;
    }

    // Whether it can be selected: no `\Noselect`.
    selectable() is bool {
        !attributes.membership("\\NOSELECT");
    }
}

// A 32-bit unsigned number in a response.
object ImapUnsigned {
    has value is int;

    // The digits; nonzero refuses 0.
    ImapUnsigned(origin is string, nonzero is bool) {
        confirm origin.length() > 0 && origin.length() <= 10
            else throw InvalidImapData.because("unsigned number length outside 1..10");
        if nonzero {
            confirm origin.slice(0, 1) != "0"
                else throw InvalidImapData.because("nonzero number starts with zero");
        }
        let count = MimePosition(0);
        for (0..origin.length()) -> index {
            let char = origin.slice(index, index + 1);
            // Explicit decimal scanning avoids accepting signs or whitespace.
            let digit = match char {
                case "0" {
                    0;
                }
                case "1" {
                    1;
                }
                case "2" {
                    2;
                }
                case "3" {
                    3;
                }
                case "4" {
                    4;
                }
                case "5" {
                    5;
                }
                case "6" {
                    6;
                }
                case "7" {
                    7;
                }
                case "8" {
                    8;
                }
                case "9" {
                    9;
                }
                else {
                    throw InvalidImapData.because("unsigned number requires decimal digits");
                }
            };
            confirm count.index().rat() <= (4294967295 - digit) / 10
                else throw InvalidImapData.because("unsigned number exceeds 32 bits");
            count = count.following(count.index() * 10 + digit);
        }
        value = count.index();
    }

    // The number; InvalidImapData when it is not one.
    int() is int {
        value;
    }
}

// A parenthesized flag list.
object ImapFlagsValue {
    has value is MailFlags;

    // Reads origin.
    ImapFlagsValue(origin is ImapValue) {
        let entries = origin.entries();
        confirm entries.size() <= 256 else throw InvalidImapData.because("too many flags");
        let flags is @MailFlag = (0..entries.size()).map() -> index {
            let entry = entries.item(index);
            confirm entry.kind() == ImapValueKind.atom
                else throw InvalidImapData.because("flag is not an atom");
            let raw = entry.string();
            let name = ImapDataUpper(raw).string();
            match name {
                case "\\ANSWERED" {
                    SystemFlag(SystemMailFlag.answered);
                }
                case "\\FLAGGED" {
                    SystemFlag(SystemMailFlag.flagged);
                }
                case "\\DELETED" {
                    SystemFlag(SystemMailFlag.deleted);
                }
                case "\\SEEN" {
                    SystemFlag(SystemMailFlag.seen);
                }
                case "\\DRAFT" {
                    SystemFlag(SystemMailFlag.draft);
                }
                case "\\RECENT" {
                    SystemFlag(SystemMailFlag.recent);
                }
                else {
                    confirm raw.length() > 0 && raw.slice(0, 1) != "\\"
                        else throw InvalidImapData.because("unsupported system flag");
                    KeywordFlag(raw);
                }
            }
        };
        value = MailFlags(flags);
    }

    // The flags.
    flags() is MailFlags {
        value;
    }
}

// A UID set such as `4:6,9` read back.
object ImapUidRanges {
    has value is ImapUidSet;
    has expanded is int;

    // Reads origin within limits.
    ImapUidRanges(origin is string, limits is ImapUidSetLimits) {
        confirm origin.length() > 0 else throw InvalidImapData.because("empty UID range");
        confirm origin.length() <= limits::Limits::wire_bytes
            else throw ImapUidLimitExceeded.kind("wire_bytes");
        let items is MimeItems<ImapUid> = MimeItems();
        let count = MimePosition(0);
        for origin.split(",") -> part {
            let endpoints = part.split(":");
            confirm endpoints.size() >= 1 && endpoints.size() <= 2
                else throw InvalidImapData.because("invalid UID range");
            let first = ImapUnsigned(origin: endpoints[0], nonzero: true).int();
            let final = if endpoints.size() == 2 {
                ImapUnsigned(origin: endpoints[1], nonzero: true).int();
            }
            else {
                first;
            };
            let size = 1 + (if final >= first {
                final - first;
            }
            else {
                first - final;
            });
            confirm size <= limits::Limits::entries - count.index()
                else throw ImapUidLimitExceeded.kind("entries");
            // RFC 4315: 12:10 is the sequence 10,11,12, just like 10:12.
            // This matters for positional COPYUID source/destination mappings.
            let lowest = if final >= first {
                first;
            }
            else {
                final;
            };
            for (0..size) -> offset {
                let number = lowest + offset;
                items = items.following(ImapUid(BigInt(number)));
            }
            count = count.following(count.index() + size);
        }
        value = ImapUidSet(origin: items.entries(), limits: limits);
        expanded = count.index();
    }

    // The UIDs.
    uids() is ImapUidSet {
        value;
    }

    // How many UIDs the ranges hold.
    expanded_count() is int {
        expanded;
    }
}

// The UIDs a UID SEARCH found.
object ImapSearchResult {
    has value is ImapUidSet;

    // The SEARCH response of the command tagged tag, within limits.
    ImapSearchResult(origin is ImapResponse, tag is ImapTag, limits is ImapUidSetLimits) {
        let values = ParsedImapData(origin).entries();
        if origin.name() == "SEARCH" {
            confirm values.size() - 2 <= limits::Limits::entries
                else throw ImapUidLimitExceeded.kind("entries");
            let ids is @ImapUid = (2..values.size()).map() -> index {
                let entry = values.item(index);
                confirm entry.kind() == ImapValueKind.atom
                    else throw InvalidImapData.because("SEARCH UID is not an atom");
                ImapUid(BigInt(ImapUnsigned(origin: entry.string(), nonzero: true).int().string()));
            };
            value = ImapUidSet(origin: ids, limits: limits);
        }
        else {
            confirm origin.name() == "ESEARCH"
                else throw InvalidImapData.because("expected SEARCH or ESEARCH");
            let position = MimePosition(2);
            if position.index() < values.size()
                && values.item(position.index()).kind() == ImapValueKind.list {
                    let correlator = values.item(position.index()).entries();
                    confirm correlator.size() == 2
                        && correlator.item(0).kind() == ImapValueKind.atom
                        && correlator.item(1).kind() == ImapValueKind.quoted
                        && ImapDataUpper(correlator.item(0).string()).string() == "TAG"
                        && correlator.item(1).string() == tag.string()
                        else throw InvalidImapData.because("ESEARCH tag mismatch");
                    position = position.following(position.index() + 1);
                }
            confirm position.index() < values.size()
                && values.item(position.index()).kind() == ImapValueKind.atom
                && ImapDataUpper(values.item(position.index()).string()).string() == "UID"
                else throw InvalidImapData.because("ESEARCH result is not a UID set");
            position = position.following(position.index() + 1);
            let found is MimeItems<ImapUidSet> = MimeItems();
            let count = MimePosition(-1);
            let minimum = MimePosition(-1);
            let maximum = MimePosition(-1);
            loop {
                last if position.index() == values.size();
                confirm values.size() - position.index() >= 2
                    else throw InvalidImapData.because("missing ESEARCH result value");
                confirm values.item(position.index()).kind() == ImapValueKind.atom
                    && values.item(position.index() + 1).kind() == ImapValueKind.atom
                    else throw InvalidImapData.because("ESEARCH items require atoms");
                let name = ImapDataUpper(values.item(position.index()).string()).string();
                let raw = values.item(position.index() + 1).string();
                if name == "ALL" {
                    confirm found.entries().size() == 0
                        else throw InvalidImapData.because("duplicate ESEARCH ALL");
                    found = found.following(ImapUidRanges(origin: raw, limits: limits).uids());
                }
                else {
                    if name == "COUNT" {
                        confirm count.index() == -1
                            else throw InvalidImapData.because("duplicate ESEARCH COUNT");
                        count = count.following(ImapUnsigned(origin: raw, nonzero: false).int());
                    }
                    else {
                        confirm name == "MIN" || name == "MAX"
                            else throw InvalidImapData.because("unsupported ESEARCH result item");
                        let number = ImapUnsigned(origin: raw, nonzero: true).int();
                        if name == "MIN" {
                            confirm minimum.index() == -1
                                else throw InvalidImapData.because("duplicate ESEARCH MIN");
                            minimum = minimum.following(number);
                        }
                        else {
                            confirm maximum.index() == -1
                                else throw InvalidImapData.because("duplicate ESEARCH MAX");
                            maximum = maximum.following(number);
                        }
                    }
                }
                position = position.following(position.index() + 2);
            }
            let sets = found.entries();
            if sets.size() == 0 {
                confirm count.index() <= 0 && minimum.index() == -1 && maximum.index() == -1
                    else throw InvalidImapData.because("ESEARCH result without ALL identifiers");
                value = ImapUidSet();
            }
            else {
                confirm count.index() == -1 || count.index() == sets[0].entries().size()
                    else throw InvalidImapData.because("ESEARCH COUNT differs from ALL");
                let identifiers = sets[0].entries();
                let smallest = MimePosition(4294967295);
                let largest = MimePosition(0);
                for (0..identifiers.size()) -> index {
                    let number = ImapUnsigned(
                        origin: identifiers.item(index).string(),
                        nonzero: true
                    ).int();
                    if number < smallest.index() {
                        smallest = smallest.following(number);
                    }
                    if number > largest.index() {
                        largest = largest.following(number);
                    }
                }
                confirm (minimum.index() == -1 || minimum.index() == smallest.index())
                    && (maximum.index() == -1 || maximum.index() == largest.index())
                    else throw InvalidImapData.because("ESEARCH extrema differ from ALL");
                value = sets[0];
            }
        }
    }

    // The UIDs.
    uids() is ImapUidSet {
        value;
    }
}

test "ESEARCH snapshots validate cardinality and extrema" {
    let response = ParsedImapResponse(
        Utf8Encoded("* ESEARCH UID ALL 9,3:4 COUNT 3 MIN 3 MAX 9\r\n").bytes()
    ).response();
    test.is(
        ImapSearchResult(origin: response, tag: ImapTag("O1"), limits: ImapUidSetLimits()).uids().argument(),
        "9,3,4"
    );
}
