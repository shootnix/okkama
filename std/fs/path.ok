module fs/path v1.0.0;

import "compare" take Comparing, Order;
import "runtime/fs" take path_join, path_parent, path_child, path_absolute;
import "runtime/system" take system_platform;

// Purely lexical paths for native and foreign path grammars.
//
// Path(text) interprets text using the current platform. Pass PathStyle only
// when working with a path belonging to another platform:
//
//     let native = Path("var").child("log").child("app.log");
//     let foreign = Path("C:\\Users\\alice", PathStyle.windows);
//
// Path(parts...) is the portable application-facing join. It asks the runtime
// for the current platform and never makes callers choose a separator:
//
//     let config = Path("etc", "okkama", "config.toml");
//
// A later absolute part replaces everything accumulated before it. Joining,
// parent lookup and absolute detection never consult the filesystem and never
// resolve symlinks or `..`. The paths they make are tidied: a `.` segment and a
// repeated separator go away, so Path("a/./b").child("c") is `a/b/c`.

enum PathStyle = (posix, windows);

object Path does Comparing<Path> {
    has origin is string;
    has path_style is PathStyle;

    Path(origin is string) {
        confirm !origin.empty() else throw InvalidPath.because("path cannot be empty");
        self.origin = origin;
        // The host's grammar is part of the path's value, so `==` sees it.
        path_style = if system_platform() == "windows" {
            PathStyle.windows;
        }
        else {
            PathStyle.posix;
        };
    }

    Path(origin is string, style is PathStyle) {
        confirm !origin.empty() else throw InvalidPath.because("path cannot be empty");
        self.origin = origin;
        path_style = style;
    }

    Path(parts is ...string) {
        let values is @string = parts...;
        confirm values.size() > 0
            else throw InvalidPath.because("path join requires at least one part");
        for values -> part {
            confirm !part.empty()
                else throw InvalidPath.because("path join rejects empty parts");
        }
        let style is PathStyle = if system_platform() == "windows" {
            PathStyle.windows;
        }
        else {
            PathStyle.posix;
        };
        origin = path_join(values, if style == PathStyle.posix {
            0;
        }
        else {
            1;
        });
        path_style = style;
    }

    parent() is Path {
        Path(
            path_parent(origin, PathStyleCode(origin: path_style).code()),
            path_style,
        );
    }

    child(part is string) is Path {
        confirm !part.empty() else throw InvalidPath.because("path part cannot be empty");
        Path(
            path_child(
                origin,
                part,
                PathStyleCode(origin: path_style).code(),
            ),
            path_style,
        );
    }

    // The last part: Path("var/log/app.log").name() is "app.log"; "" for a root.
    name() is string {
        let unified = if path_style == PathStyle.windows {
            origin.replace("\\", "/");
        }
        else {
            origin;
        };
        let parts is @string = unified.split("/").filter() -> part {
            part != "";
        };
        if parts.size() == 0 {
            "";
        }
        else {
            parts.last();
        }
    }

    absolute() is bool {
        path_absolute(origin, PathStyleCode(origin: path_style).code());
    }

    order(other is Path) is Order {
        origin.order(other.string());
    }

    string() is string {
        origin;
    }

    // The lexical grammar, without probing the host filesystem.
    cap Grammar {
        style is PathStyle {
            path_style;
        }
    }
}

object NativePathStyle {
    NativePathStyle();

    style() is PathStyle {
        if system_platform() == "windows" {
            PathStyle.windows;
        }
        else {
            PathStyle.posix;
        }
    }
}

hidden object PathStyleCode {
    has origin is PathStyle;

    PathStyleCode(:origin);

    code() is int {
        if origin == PathStyle.posix {
            0;
        }
        else {
            1;
        }
    }
}

enum InvalidPath is Error = (because(message is string));

test "joining, parents and absolute paths follow the grammar, not the host" {
    let posix = PathStyle.posix;
    let windows = PathStyle.windows;
    test.is(Path("a", posix).child("b").string(), "a/b");
    test.is(Path("a", windows).child("b/c").string(), "a\\b\\c");
    test.is(Path("C:\\x", windows).child("y").string(), "C:\\x\\y");
    test.is(Path("/a/b/c", posix).parent().string(), "/a/b");
    test.is(Path("a/b/", posix).parent().string(), "a");
    test.is(Path("a", posix).parent().string(), ".");
    test.is(Path("/a", posix).parent().string(), "/");
    test.is(Path("C:\\x\\y", windows).parent().string(), "C:\\x");
    test.is(Path("\\\\server\\share\\x", windows).parent().string(), "\\\\server\\share");
    test.ok(Path("/x", posix).absolute());
    test.ok(!Path("x", posix).absolute());
    test.ok(Path("C:\\x", windows).absolute());
    test.ok(Path("\\\\server\\share", windows).absolute());
    test.ok(!Path("C:x", windows).absolute());
}

test "a root is its own parent, also behind a drive" {
    test.is(Path("/", PathStyle.posix).parent().string(), "/");
    test.is(Path("C:\\", PathStyle.windows).parent().string(), "C:\\");
    test.is(Path("C:\\x", PathStyle.windows).parent().parent().string(), "C:\\");
}

test "dots and repeated separators are tidied; .. stays" {
    let posix = PathStyle.posix;
    test.is(Path("a/./b", posix).child("c").string(), "a/b/c");
    test.is(Path("a//b", posix).child("c").string(), "a/b/c");
    test.is(Path("./a", posix).child("b").string(), "a/b");
    test.is(Path("a/../b", posix).child("..").string(), "a/../b/..");
    test.is(Path("a/./b", posix).string(), "a/./b");
}

test "an absolute part replaces what came before it" {
    let posix = PathStyle.posix;
    test.is(Path("a", posix).child("/b").string(), "/b");
    test.is(Path("a", PathStyle.windows).child("C:\\b").string(), "C:\\b");
    if NativePathStyle().style() == posix {
        test.is(Path("a", "b", "c").string(), "a/b/c");
        test.is(Path("a", "/b", "c").string(), "/b/c");
    }
    test.is(Path("a", "b").string(), Path("a").child("b").string());
}

test "the grammar is part of the value; order compares only the text" {
    let posix = PathStyle.posix;
    let windows = PathStyle.windows;
    test.ok(Path("a", posix) != Path("a", windows));
    test.ok(Path("a") == Path("a", NativePathStyle().style()));
    test.ok(Path("a", posix)::Grammar::style == posix);
    test.ok(Path("x", windows)::Grammar::style == windows);
    test.ok(Path("a", posix).order(Path("b", posix)) == Order.less);
    test.ok(Path("b", posix).order(Path("a", windows)) == Order.greater);
    test.ok(Path("a", posix).order(Path("a", windows)) == Order.equal);
    test.ok(Path("a", posix) < Path("b", posix));
}

test "empty paths and parts are refused" {
    test.throws(InvalidPath) {
        Path("");
    };
    test.throws(InvalidPath) {
        Path("", PathStyle.posix);
    };
    test.throws(InvalidPath) {
        Path("a", "");
    };
    test.throws(InvalidPath) {
        Path("a").child("");
    };
}

test "a path names its last part" {
    test.is(Path("var/log/app.log", PathStyle.posix).name(), "app.log");
    test.is(Path("var/log/", PathStyle.posix).name(), "log");
    test.is(Path("/", PathStyle.posix).name(), "");
    test.is(Path("C:\\Users\\alice", PathStyle.windows).name(), "alice");
}
