module fs/lock v1.0.0;

import "fs/error" take FileError;
import "io/stream" take Closing;
import "runtime/fs" take FileLockState, file_lock_closed, file_lock_close;

// Whole-file advisory locks. A file takes them, and a lock that is in the way
// is an ordinary branch, not an error:
//
//     let file = File(path: path, mode: FileMode.reading_and_writing);
//     defer file.close();
//     let lock = file.lock(FileLockMode.exclusive) else throw Busy.now;
//     defer lock.close();
//     file.locked(FileLockMode.shared);    // whether anyone holds it shared now
//
// Locks are advisory and whole-file on every provider: they keep out those
// who lock too, not every writer. Shared locks coexist only with shared
// locks; an exclusive lock conflicts with every other lock. A file holds at
// most one live lock. Closing the lock or its file releases it, both closes
// are idempotent, and the lock keeps its file open while it lives.

// A shared lock lives with other shared locks; an exclusive one with none.
enum FileLockMode = (shared, exclusive);

// A whole-file advisory lock, from File.lock(mode); close it or its file to
// release it.
object FileLock does Closing {
    has state is FileLockState;
    has owner is Closing;

    // Made by File.lock(mode); not constructed directly.
    FileLock(state is FileLockState, owner is Closing) {
        self.state = state;
        self.owner = owner;
    }

    destroy {
        self.close();
    }

    // Whether it is released.
    closed() is bool {
        try {
            file_lock_closed(state);
        }
        catch failure is NativeFailure {
            throw FileError.failed(failure.code(), failure.message());
        }
    }

    // Releases the lock; releasing again does nothing.
    close() is void {
        try {
            file_lock_close(state);
        }
        catch failure is NativeFailure {
            throw FileError.failed(failure.code(), failure.message());
        }
    }
}
