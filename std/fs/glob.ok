module fs/glob v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "fs/directory" take Directory, DirectoryLocating;
import "fs/error" take FileError, FileFailure;
import "fs/file" take File, FileMode;
import "fs/path" take Path;
import "fs/temp" take TemporaryDirectory;
import "runtime/fs" take path_encode, matching_paths;

// MatchingPaths snapshots every path below root that matches a relative glob
// pattern. Results are globally lexicographically sorted before cursor()
// returns. Patterns always use / between segments, including on Windows.
//
// Files immediately inside src:
//
//     let sources is @Path = MatchingPaths(
//         root: project,
//         pattern: "src/*.ok",
//     ).map() -> path { path; };
//
// Recursive test discovery:
//
//     for MatchingPaths(root: project, pattern: "**/*-test.ok") -> path {
//         output.writeln(path.string());
//     }
//
// `*` matches zero or more Unicode characters inside one segment, `?` matches
// exactly one, and classes accept literals, ranges and leading ! negation:
//
//     MatchingPaths(root: logs, pattern: "202[4-6]-[!0]?-*.log");
//
// Matching is case-sensitive on every platform and includes leading dots.
// `**` is recursive only as a complete segment and matches zero or more path
// segments. A matching symlink path is returned, but traversal never enters it.

object MatchingPaths does Iterating<Path> {
    has origin is DirectoryLocating;
    has glob is string;

    MatchingPaths(root is DirectoryLocating, pattern is string) {
        origin = root;
        glob = pattern;
    }

    cursor() is Cursor<Path> {
        let paths is @string = try {
            matching_paths(path_encode(origin.path().string()), glob);
        }
        catch failure is NativeFailure {
            if failure.code() == "invalid_input" {
                throw InvalidGlobPattern.detailed(glob, failure.message());
            }
            else if failure.code() == "not_found" {
                throw FileError.invalid_operation("glob root must be an existing directory");
            }
            else {
                throw FileFailure(failure: failure, path: origin.path().string()).error();
            }
        };
        MatchingPathCursor(paths: paths, position: 0);
    }
}

hidden object MatchingPathCursor does Cursor<Path> {
    has paths is @string;
    has position is int;

    MatchingPathCursor(:paths, :position);

    available() is bool {
        position < paths.size();
    }

    item() is Path {
        confirm self.available() else throw IterationEnded.ended;
        Path(paths[position]);
    }

    successor() is Cursor<Path> {
        confirm self.available() else throw IterationEnded.ended;
        MatchingPathCursor(paths: paths, position: position + 1);
    }
}

enum InvalidGlobPattern is Error = (detailed(pattern is string, message is string));

test "patterns match inside one segment; ** crosses segments; results are sorted" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-glob-test-");
    let root = scratch.path();
    for ["src", "src/net", "logs"] -> name {
        Directory(path: root.child(name)).create();
    }
    for [
        "src/main.ok", "src/util.ok", "src/util-test.ok", "src/net/tcp.ok", "src/net/tcp-test.ok",
        "src/.hidden.ok", "README.md", "logs/2025-01-a.log", "logs/2025-10-b.log", "logs/2027-02-c.log",
    ] -> name {
        File(path: Path(root.string() + "/" + name), mode: FileMode.writing).text().write("");
    }
    let found = (pattern is string) is @string {
        MatchingPaths(root: Directory(path: root), pattern: pattern).map() -> path {
            path.string().slice(root.string().length() + 1, path.string().length());
        };
    };
    test.is(found("src/*.ok"), ["src/.hidden.ok", "src/main.ok", "src/util-test.ok", "src/util.ok"]);
    test.is(found("**/*-test.ok"), ["src/net/tcp-test.ok", "src/util-test.ok"]);
    test.is(found("src/**"), ["src", "src/.hidden.ok", "src/main.ok", "src/net", "src/net/tcp-test.ok", "src/net/tcp.ok", "src/util-test.ok", "src/util.ok"]);
    test.is(found("src/????.ok"), ["src/main.ok", "src/util.ok"]);
    test.is(found("logs/202[4-6]-[!0]?-*.log"), ["logs/2025-10-b.log"]);
    test.is(found("logs/202[4-6]-*.log"), ["logs/2025-01-a.log", "logs/2025-10-b.log"]);
    test.is(found("readme.md"), []);
    test.is(found("README.md"), ["README.md"]);
    test.is(found("src/n*/tcp.ok"), ["src/net/tcp.ok"]);
    scratch.close();
}

test "a bad pattern and a missing root are refused" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-glob-test-");
    test.throws(InvalidGlobPattern) {
        MatchingPaths(root: Directory(path: scratch.path()), pattern: "src/[a-").cursor();
    };
    test.ok(try {
        MatchingPaths(root: Directory(path: scratch.path().child("absent")), pattern: "*").cursor();
        false;
    }
    catch FileError.invalid_operation(message) {
        message == "glob root must be an existing directory";
    });
    scratch.close();
}
