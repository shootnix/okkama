module fs/stat v1.0.0;

import "numbers/bigint" take BigInt;
import "time/clock" take Instant;
import "time/duration" take Duration, DurationUnit;

// Portable metadata values. Native providers normalize their host stat shape
// into integer fields; no host-specific mode or timestamp object crosses the
// runtime boundary. Creation time is optional because many filesystems do not
// expose one. Calling creation() when it is unavailable throws a typed error.

enum FileKind = (other, file, directory, symbolic_link, block_device, character_device, fifo, socket);

object FileStat {
    has file_kind is FileKind;
    has byte_size is int;
    has permission_mode is PermissionMode;
    has file_times is FileTimes;
    has file_identity is FileIdentity;

    FileStat(
        kind is FileKind,
        size is int,
        mode is PermissionMode,
        times is FileTimes,
        identity is FileIdentity,
    ) {
        file_kind = kind;
        byte_size = size;
        permission_mode = mode;
        file_times = times;
        file_identity = identity;
    }

    // What the entry is and how many bytes it holds.
    cap Shape {
        kind is FileKind {
            file_kind;
        }

        size is int {
            byte_size;
        }
    }

    mode() is PermissionMode {
        permission_mode;
    }

    times() is FileTimes {
        file_times;
    }

    identity() is FileIdentity {
        file_identity;
    }
}

object FileTimes {
    has accessed is int;
    has modified is int;
    has changed is int;
    has created is int;

    FileTimes(access is int, modification is int, change is int, creation is int) {
        accessed = access;
        modified = modification;
        changed = change;
        created = creation;
    }

    access() is Instant {
        EpochInstant(seconds: accessed).instant();
    }

    modification() is Instant {
        EpochInstant(seconds: modified).instant();
    }

    change() is Instant {
        EpochInstant(seconds: changed).instant();
    }

    creation() is Instant {
        confirm created >= 0 else throw MissingCreationTime.missing;
        EpochInstant(seconds: created).instant();
    }
}

object FileIdentity {
    has device_number is int;
    has inode_number is BigInt;

    FileIdentity(device is int, inode is BigInt) {
        device_number = device;
        inode_number = inode;
    }

    same(other is FileIdentity) is bool {
        self == other;
    }

    cap Identity {
        device is int {
            device_number;
        }
    }

    inode() is BigInt {
        inode_number;
    }
}

object Permissions {
    has read_bit is bool;
    has write_bit is bool;
    has execute_bit is bool;

    Permissions(readable is bool, writable is bool, executable is bool) {
        read_bit = readable;
        write_bit = writable;
        execute_bit = executable;
    }

    cap Access {
        readable is bool {
            read_bit;
        }

        writable is bool {
            write_bit;
        }

        executable is bool {
            execute_bit;
        }
    }
}

object PermissionMode {
    has bits is int;

    PermissionMode(bits is int) {
        confirm bits >= 0 && bits <= 4095
            else throw InvalidPermissionMode.bits(bits);
        self.bits = bits;
    }

    // These are integer bit fields; division produces a rat in Okkama.
    owner() is Permissions {
        PermissionBits(bits: (bits >> 6) & 7).permissions();
    }

    group() is Permissions {
        PermissionBits(bits: (bits >> 3) & 7).permissions();
    }

    others() is Permissions {
        PermissionBits(bits: bits % 8).permissions();
    }

    special() is int {
        bits >> 9;
    }
}

object FileStatFromMap {
    has origin is %string:int;

    FileStatFromMap(:origin);

    stat() is FileStat {
        FileStat(
            kind: FileKindFromCode(code: origin["kind"]).kind(),
            size: origin["size"],
            mode: PermissionMode(bits: origin["permissions"]),
            times: FileTimes(
                access: origin["accessed_sec"],
                modification: origin["modified_sec"],
                change: origin["changed_sec"],
                creation: origin["created_sec"],
            ),
            identity: FileIdentity(
                device: origin["device"],
                inode: BigInt(origin["inode"]),
            ),
        );
    }
}

hidden object EpochInstant {
    has seconds is int;

    EpochInstant(:seconds);

    instant() is Instant {
        Instant(origin: Duration(
            value: seconds.rat(),
            unit: DurationUnit.second,
        ));
    }
}

hidden object PermissionBits {
    has bits is int;

    PermissionBits(:bits);

    permissions() is Permissions {
        Permissions(
            readable: (bits & 4) != 0,
            writable: (bits & 2) != 0,
            executable: bits % 2 == 1,
        );
    }
}

hidden object FileKindFromCode {
    has code is int;

    FileKindFromCode(:code);

    kind() is FileKind {
        if code == 1 {
            FileKind.file;
        }
        else if code == 2 {
            FileKind.directory;
        }
        else if code == 3 {
            FileKind.symbolic_link;
        }
        else if code == 4 {
            FileKind.block_device;
        }
        else if code == 5 {
            FileKind.character_device;
        }
        else if code == 6 {
            FileKind.fifo;
        }
        else if code == 7 {
            FileKind.socket;
        }
        else {
            FileKind.other;
        }
    }
}

enum MissingCreationTime is Error = (missing);

enum InvalidPermissionMode is Error = (bits(bits is int));

test "permission observations retain integer bit groups" {
    let mode = PermissionMode(416); // 0640
    test.ok(mode.owner()::Access::readable);
    test.ok(mode.owner()::Access::writable);
    test.ok(!mode.owner()::Access::executable);
    test.ok(mode.group()::Access::readable);
    test.ok(!mode.group()::Access::writable);
    test.ok(!mode.others()::Access::readable);
    test.is(mode.special(), 0);
    let all = PermissionMode(4095); // 07777
    test.ok(all.owner()::Access::executable);
    test.ok(all.group()::Access::writable);
    test.ok(all.others()::Access::executable);
    test.is(all.special(), 7);
    test.throws(InvalidPermissionMode) {
        PermissionMode(4096);
    };
}
