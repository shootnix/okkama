module fs/stat v1.0.0;

// What the disk knows about an entry: its kind, size, permissions, times and
// identity.
//
//     let stat = FileEntry(Path("notes.txt")).stat();
//     stat::Shape::kind == FileKind.file;
//     stat::Shape::size;                                // bytes
//     stat.mode().owner()::Access::writable;
//     stat.times().modification();                      // Instant
//     stat.identity().same(other.identity());           // the same file?
//
// Every platform's metadata comes in the same shape. Not every file system
// records a creation time: creation() then throws MissingCreationTime.

import "numbers/bigint" take BigInt;
import "time/clock" take Instant;
import "time/duration" take Duration, DurationUnit;

// What an entry is.
enum FileKind = (other, file, directory, symbolic_link, block_device, character_device, fifo, socket);

// The metadata of one entry.
object FileStat {
    has file_kind is FileKind;
    has byte_size is int;
    has permission_mode is PermissionMode;
    has file_times is FileTimes;
    has file_identity is FileIdentity;

    // Metadata as given; FileEntry.stat() and DirectoryEntry.stat() make it
    // from the disk.
    FileStat(
        kind is FileKind,
        size is int,
        mode is PermissionMode,
        times is FileTimes,
        identity is FileIdentity,
    ) {
        file_kind = kind;
        byte_size = size;
        permission_mode = mode;
        file_times = times;
        file_identity = identity;
    }

    // What the entry is and how many bytes it holds.
    cap Shape {
        kind is FileKind {
            file_kind;
        }

        size is int {
            byte_size;
        }
    }

    // The permission bits.
    mode() is PermissionMode {
        permission_mode;
    }

    // When it was last read, changed and made.
    times() is FileTimes {
        file_times;
    }

    // Which file it is on its device.
    identity() is FileIdentity {
        file_identity;
    }
}

// The times of an entry.
object FileTimes {
    has accessed is int;
    has modified is int;
    has changed is int;
    has created is int;

    // Times as seconds since 1970; a negative creation means none was recorded.
    FileTimes(access is int, modification is int, change is int, creation is int) {
        accessed = access;
        modified = modification;
        changed = change;
        created = creation;
    }

    // When it was last read.
    access() is Instant {
        EpochInstant(seconds: accessed).instant();
    }

    // When its content last changed.
    modification() is Instant {
        EpochInstant(seconds: modified).instant();
    }

    // When its metadata last changed.
    change() is Instant {
        EpochInstant(seconds: changed).instant();
    }

    // When it was made; MissingCreationTime when the file system did not record
    // it.
    creation() is Instant {
        confirm created >= 0 else throw MissingCreationTime.missing;
        EpochInstant(seconds: created).instant();
    }
}

// Which file an entry is: its device and inode.
object FileIdentity {
    has device_number is int;
    has inode_number is BigInt;

    // An identity as given.
    FileIdentity(device is int, inode is BigInt) {
        device_number = device;
        inode_number = inode;
    }

    // Whether both are the same file, as two links to it are.
    same(other is FileIdentity) is bool {
        self == other;
    }

    // The device number.
    cap Identity {
        device is int {
            device_number;
        }
    }

    // The inode number.
    inode() is BigInt {
        inode_number;
    }
}

// Read, write and execute for one class of users.
object Permissions {
    has read_bit is bool;
    has write_bit is bool;
    has execute_bit is bool;

    // The three permissions as given.
    Permissions(readable is bool, writable is bool, executable is bool) {
        read_bit = readable;
        write_bit = writable;
        execute_bit = executable;
    }

    // Whether reading, writing and executing are allowed.
    cap Access {
        readable is bool {
            read_bit;
        }

        writable is bool {
            write_bit;
        }

        executable is bool {
            execute_bit;
        }
    }
}

// Unix permission bits: owner, group and others, and the special bits.
object PermissionMode {
    has bits is int;

    // The bits, 0 to 0o7777; anything else is InvalidPermissionMode.
    PermissionMode(bits is int) {
        confirm bits >= 0 && bits <= 4095
            else throw InvalidPermissionMode.bits(bits);
        self.bits = bits;
    }

    // What the owner may do.
    owner() is Permissions {
        PermissionBits(bits: (bits >> 6) & 7).permissions();
    }

    // What the group may do.
    group() is Permissions {
        PermissionBits(bits: (bits >> 3) & 7).permissions();
    }

    // What everyone else may do.
    others() is Permissions {
        PermissionBits(bits: bits % 8).permissions();
    }

    // The setuid, setgid and sticky bits, as 0 to 7.
    special() is int {
        bits >> 9;
    }
}

// Metadata from the runtime's map of fields; std uses it, programs seldom need
// to.
object FileStatFromMap {
    has origin is %string:int;

    // From the runtime's fields.
    FileStatFromMap(:origin);

    // The metadata.
    stat() is FileStat {
        FileStat(
            kind: FileKindFromCode(code: origin["kind"]).kind(),
            size: origin["size"],
            mode: PermissionMode(bits: origin["permissions"]),
            times: FileTimes(
                access: origin["accessed_sec"],
                modification: origin["modified_sec"],
                change: origin["changed_sec"],
                creation: origin["created_sec"],
            ),
            identity: FileIdentity(
                device: origin["device"],
                inode: BigInt(origin["inode"]),
            ),
        );
    }
}

hidden object EpochInstant {
    has seconds is int;

    EpochInstant(:seconds);

    instant() is Instant {
        Instant(origin: Duration(
            value: seconds.rat(),
            unit: DurationUnit.second,
        ));
    }
}

hidden object PermissionBits {
    has bits is int;

    PermissionBits(:bits);

    permissions() is Permissions {
        Permissions(
            readable: (bits & 4) != 0,
            writable: (bits & 2) != 0,
            executable: bits % 2 == 1,
        );
    }
}

hidden object FileKindFromCode {
    has code is int;

    FileKindFromCode(:code);

    kind() is FileKind {
        if code == 1 {
            FileKind.file;
        }
        else if code == 2 {
            FileKind.directory;
        }
        else if code == 3 {
            FileKind.symbolic_link;
        }
        else if code == 4 {
            FileKind.block_device;
        }
        else if code == 5 {
            FileKind.character_device;
        }
        else if code == 6 {
            FileKind.fifo;
        }
        else if code == 7 {
            FileKind.socket;
        }
        else {
            FileKind.other;
        }
    }
}

// The file system did not record when the file was made.
enum MissingCreationTime is Error = (missing);

// Permission bits outside 0 to 0o7777.
enum InvalidPermissionMode is Error = (bits(bits is int));

test "permission observations retain integer bit groups" {
    let mode = PermissionMode(416); // 0640
    test.ok(mode.owner()::Access::readable);
    test.ok(mode.owner()::Access::writable);
    test.ok(!mode.owner()::Access::executable);
    test.ok(mode.group()::Access::readable);
    test.ok(!mode.group()::Access::writable);
    test.ok(!mode.others()::Access::readable);
    test.is(mode.special(), 0);
    let all = PermissionMode(4095); // 07777
    test.ok(all.owner()::Access::executable);
    test.ok(all.group()::Access::writable);
    test.ok(all.others()::Access::executable);
    test.is(all.special(), 7);
    test.throws(InvalidPermissionMode) {
        PermissionMode(4096);
    };
}
