module fs/link v1.0.0;

import "fs/directory" take Directory;
import "fs/entry" take FileEntry;
import "fs/file" take File, FileMode;
import "fs/error" take FileError, FileFailure;
import "fs/path" take Path;
import "fs/temp" take TemporaryDirectory;
import "runtime/fs" take path_encode, path_decode, lstat, unlink, link, symlink, readlink;

// SymbolicLink is a path command object. Construction never touches the
// filesystem; create() and remove() are explicit commands and return nothing:
//
//     let current = SymbolicLink(path: releases.path().child("current"));
//     current.create(target: Path("v3.2.0"));
//
// target() returns exactly the target stored in the link. A relative target is
// not silently joined to the link's parent. existence() uses lstat, so a broken
// symbolic link still exists. remove() first verifies the entry kind and can
// never delete a regular file or directory accidentally.
//
// Hard links use the same command shape:
//
//     let destination = backup.path().child("state.db");
//     HardLink(source: source, destination: destination).create();
//     let snapshot = FileEntry(path: destination);
//
// Both commands fail when their destination already exists. Symbolic-link
// targets need not exist. HardLink accepts only an existing regular file and
// rejects directories and symbolic-link source entries portably.

// A symbolic link at a path; nothing happens until a command is called.
object SymbolicLink {
    has origin is Path;

    // The link at path.
    SymbolicLink(path is Path) {
        origin = path;
    }

    // Where the link is.
    path() is Path {
        origin;
    }

    // Whether a link is there, even a broken one.
    existence() is bool {
        try {
            lstat(path_encode(origin.string()))["kind"] == 3;
        }
        catch failure is NativeFailure {
            if failure.code() == "not_found" {
                false;
            }
            else {
                throw FileFailure(failure: failure, path: origin.string()).error();
            }
        }
    }

    // The target exactly as stored; a relative target is not joined to
    // anything.
    target() is Path {
        confirm self.existence() else throw FileError.not_symbolic_link(origin.string());
        try {
            Path(path_decode(readlink(path_encode(origin.string()))));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: origin.string()).error();
        }
    }

    // Makes the link pointing at target.
    create(target is Path) is void {
        try {
            symlink(
                path_encode(target.string()),
                path_encode(origin.string()),
            );
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: origin.string()).error();
        }
    }

    // Removes the link; anything that is not a link is refused, never deleted.
    remove() is void {
        confirm self.existence() else throw FileError.not_symbolic_link(origin.string());
        try {
            unlink(path_encode(origin.string()));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: origin.string()).error();
        }
    }
}

// A second name for an existing file.
object HardLink {
    has source is FileEntry;
    has destination is Path;

    // A link at destination to the file at source.
    HardLink(:source, :destination);

    // Makes the link; a source that is not a regular file is
    // FileError.invalid_hard_link_source.
    create() is void {
        let source_path is Path = source.path();
        let kind is int = try {
            lstat(path_encode(source_path.string()))["kind"];
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: source_path.string()).error();
        };
        confirm kind == 1 else throw FileError.invalid_hard_link_source(source_path.string());
        try {
            link(
                path_encode(source_path.string()),
                path_encode(destination.string()),
            );
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: destination.string()).error();
        }
    }
}

test "a symbolic link stores its target as given; a broken one still exists" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-link-test-");
    let root = scratch.path();
    let current = SymbolicLink(path: root.child("current"));
    test.ok(!current.existence());
    current.create(Path("v3.2.0"));
    test.ok(current.existence());
    test.is(current.target(), Path("v3.2.0"));
    test.ok(!FileEntry(path: root.child("v3.2.0")).existence());
    test.ok(try {
        current.create(Path("v4"));
        false;
    }
    catch FileError.already_exists(failed) {
        failed == current.path().string();
    });
    current.remove();
    test.ok(!current.existence());
    test.ok(try {
        current.target();
        false;
    }
    catch FileError.not_symbolic_link(failed) {
        failed == current.path().string();
    });
    scratch.close();
}

test "remove() never deletes what is not a link" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-link-test-");
    let notes = scratch.path().child("notes.txt");
    File(path: notes, mode: FileMode.writing).text().write("kept");
    test.ok(!SymbolicLink(path: notes).existence());
    test.ok(try {
        SymbolicLink(path: notes).remove();
        false;
    }
    catch FileError.not_symbolic_link(failed) {
        failed == notes.string();
    });
    test.is(File(path: notes).text().content(), "kept");
    test.ok(try {
        SymbolicLink(path: scratch.path()).remove();
        false;
    }
    catch FileError.not_symbolic_link(failed) {
        failed == scratch.path().string();
    });
    scratch.close();
}

test "a hard link shares the file; only a regular file can be its source" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-link-test-");
    let root = scratch.path();
    let state = root.child("state.db");
    File(path: state, mode: FileMode.writing).text().write("v1");
    let snapshot = root.child("snapshot.db");
    HardLink(source: FileEntry(path: state), destination: snapshot).create();
    test.is(File(path: snapshot).text().content(), "v1");
    File(path: state, mode: FileMode.appending).text().write("+v2");
    test.is(File(path: snapshot).text().content(), "v1+v2");
    test.ok(try {
        HardLink(source: FileEntry(path: state), destination: snapshot).create();
        false;
    }
    catch FileError.already_exists(failed) {
        failed == snapshot.string();
    });
    Directory(path: root.child("folder")).create();
    test.ok(try {
        HardLink(source: FileEntry(path: root.child("folder")), destination: root.child("x")).create();
        false;
    }
    catch FileError.invalid_hard_link_source(failed) {
        failed == root.child("folder").string();
    });
    SymbolicLink(path: root.child("alias")).create(state);
    test.ok(try {
        HardLink(source: FileEntry(path: root.child("alias")), destination: root.child("y")).create();
        false;
    }
    catch FileError.invalid_hard_link_source(failed) {
        failed == root.child("alias").string();
    });
    test.ok(try {
        HardLink(source: FileEntry(path: root.child("absent")), destination: root.child("z")).create();
        false;
    }
    catch FileError.not_found(failed) {
        failed == root.child("absent").string();
    });
    scratch.close();
}
