module fs/file v1.0.0;

import "fs/path" take Path;
import "fs/error" take FileError, FileFailure;
import "fs/lock" take FileLock, FileLockMode;
import "io/stream" take ByteSource, Reading, ReadingText, Closing, Writing, WritingText,
    IncompleteWrite, InvalidReadLimit;
import "io/stdin" take EndOfInput;
import "collections/iteration" take Batching;
import "runtime/fs" take FileState, file_state_open, file_state_lock, file_state_locked,
    path_encode, file_state_read_line, file_state_read_lines, file_state_read_text,
    file_state_closed, file_state_read, file_state_write, file_state_write_text,
    file_state_rewrite_text, file_state_flush, file_state_close, file_state_position,
    file_state_seek, file_state_truncate;
import "fs/temp" take TemporaryDirectory;
import "fs/directory" take Directory;

// A file is a resource: File opens it lazily, owns the handle and closes it
// once (close() is idempotent; destroy closes too). It is read and written
// through one of two symmetric views, and the first view used picks the mode;
// the other view then throws FileError.invalid_operation.
//
//     let file = File(path: Path("notes.txt"));            // reading, UTF-8 text
//     defer file.close();
//     for file.text() -> line { … }                  // line by line, in batches
//     let lines is @string = file.text().lines();    // the remaining lines
//     let all = file.text().content();               // the remaining text
//
//     let log = File(path: Path("app.log"), mode: FileMode.appending);
//     log.text().writeln("started");
//     log.close();
//
//     let image = File(path: Path("image.png"));
//     for image.binary() -> b { … }                  // byte by byte, in batches
//     let header is @byte = image.binary().bytes(8); // up to 8 bytes; [] at the end
//     let rest is @byte = image.binary().bytes();    // the remaining bytes
//     image.binary().seek(0, SeekOrigin.start);
//
// | | text() | binary() |
// |---|---|---|
// | for … -> | lines | bytes |
// | next unit | line() | byte() |
// | the rest as an array | lines() | bytes() |
// | the whole as one value | content() | (bytes()) |
// | a piece | — | bytes(n) |
// | where | — | offset(), seek(…), truncate(…) |
// | write | write(…), writeln(…), rewrite(…) | write(source), <- |
//
// A line loses its LF and one CR before it; a final unterminated line is a
// line. line() and byte() throw EndOfInput at the end. Text is strict UTF-8
// unless File names another canonical encoding: utf-16-le, utf-16-be,
// utf-32-le, utf-32-be, ascii, latin-1; no byte order is inferred and BOMs are
// kept as text. for walks a view batch by batch (Batching, #465): the runtime
// reads about 64 KiB and cuts it into lines or hands it out as bytes.
//
// lock(mode) takes a whole-file advisory lock without waiting: a lock in the
// way gives Maybe.none. locked(mode) tells whether the file is locked in mode
// now, by this process or another one (fs/lock).
//
//     let file = File(path: Path("counter.txt"), mode: FileMode.reading_and_writing);
//     defer file.close();
//     let lock = file.lock(FileLockMode.exclusive) else throw Busy.now;
//     let count = Number(file.text().content()).int();
//     file.text().rewrite((count + 1).string());
//
//     match guard.lock(FileLockMode.exclusive) {
//         case Maybe.some(lock) { serve(); }
//         case Maybe.none { Stdout().writeln("already running"); }
//     }

enum FileMode = (reading, writing, appending, reading_and_writing, reading_and_appending);

object File does Closing {
    has state is FileState;
    has location is string;

    File(path is Path, mode is FileMode = FileMode.reading, encoding is string = "utf-8") {
        state = FileOpening(mode: mode, path: path, encoding: encoding).state();
        location = path.string();
    }

    destroy {
        self.close();
    }

    text() is FileText {
        FileText(self, state, location);
    }

    binary() is FileBytes {
        FileBytes(self, state, location);
    }

    // A lock on the whole file, or none when another lock is in the way.
    lock(mode is FileLockMode) is Maybe<FileLock> {
        try {
            Maybe.some(FileLock(file_state_lock(state, NativeLockMode(mode).code(), 1), self));
        }
        catch failure is NativeFailure {
            if failure.code() == "would_block" {
                Maybe.none;
            }
            else {
                throw FileFailure(failure, location).error();
            }
        }
    }

    // Whether the file is locked in mode now, by this process or another one.
    locked(mode is FileLockMode) is bool {
        try {
            file_state_locked(state, NativeLockMode(mode).code());
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    closed() is bool {
        file_state_closed(state);
    }

    close() is void {
        try {
            file_state_close(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }
}

// The text view: a file as lines, read in batches, or as one string.
object FileText does ReadingText, WritingText, Batching<string> {
    has owner is File;
    has state is FileState;
    has location is string;

    FileText(owner is File, state is FileState, location is string) {
        self.owner = owner;
        self.state = state;
        self.location = location;
    }

    line() is string {
        try {
            file_state_read_line(state);
        }
        catch failure is NativeFailure {
            if failure.code() == "end_of_input" {
                throw EndOfInput.reached;
            }
            else {
                throw FileFailure(failure, location).error();
            }
        }
    }

    lines() is @string {
        self.map() -> line {
            line;
        };
    }

    content() is string {
        try {
            file_state_read_text(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    // The next batch of whole lines; [] at the end.
    batch() is @string {
        try {
            file_state_read_lines(state, 65536);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    write(values is ...string) is void {
        let text is @string = values...;
        try {
            file_state_write_text(state, text, false);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    writeln(values is ...string) is void {
        let text is @string = values...;
        try {
            file_state_write_text(state, text, true);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    // Empties the file and writes values from its start.
    rewrite(values is ...string) is void {
        let text is @string = values...;
        try {
            file_state_rewrite_text(state, text);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    flush() is void {
        try {
            file_state_flush(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }
}

// The byte view: a file as bytes, read in batches, in pieces or whole, at a
// byte offset.
object FileBytes does Reading, Writing, ByteSource, Batching<byte> {
    has owner is File;
    has state is FileState;
    has location is string;

    FileBytes(owner is File, state is FileState, location is string) {
        self.owner = owner;
        self.state = state;
        self.location = location;
    }

    byte() is byte {
        let one = self.bytes(1);
        confirm one.size() == 1 else throw EndOfInput.reached;
        one[0];
    }

    // Up to limit bytes; [] at the end.
    bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        try {
            file_state_read(state, limit);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    // The remaining bytes.
    bytes() is @byte {
        self.map() -> b {
            b;
        };
    }

    // The next batch of bytes; [] at the end.
    batch() is @byte {
        self.bytes(65536);
    }

    write(source is ByteSource) is void {
        let bytes is @byte = source.bytes();
        try {
            let written is int = file_state_write(state, bytes);
            confirm written == bytes.size() else throw IncompleteWrite.after(written);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    flush() is void {
        try {
            file_state_flush(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    // The byte offset of the next read or write.
    offset() is int {
        try {
            file_state_position(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    seek(offset is int, from is SeekOrigin) is void {
        try {
            file_state_seek(state, offset, NativeSeekOrigin(from).code());
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }

    truncate(size is int) is void {
        try {
            file_state_truncate(state, size);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, location).error();
        }
    }
}

enum SeekOrigin = (start, current, end);

hidden object FileOpening {
    has mode is FileMode;
    has path is Path;
    has encoding is string;

    FileOpening(mode is FileMode, path is Path, encoding is string) {
        self.mode = mode;
        self.path = path;
        self.encoding = encoding;
    }

    state() is FileState {
        confirm FileEncoding(encoding).supported()
            else throw FileError.unsupported_encoding(encoding);
        try {
            file_state_open(path_encode(path.string()), NativeFileMode(mode).code(), encoding);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure, path.string()).error();
        }
    }
}

hidden object FileEncoding {
    has origin is string;

    FileEncoding(origin is string) {
        self.origin = origin;
    }

    supported() is bool {
        origin == "utf-8"
            || origin == "utf-16-le"
            || origin == "utf-16-be"
            || origin == "utf-32-le"
            || origin == "utf-32-be"
            || origin == "ascii"
            || origin == "latin-1";
    }
}

hidden object NativeFileMode {
    has origin is FileMode;

    NativeFileMode(origin is FileMode) {
        self.origin = origin;
    }

    code() is int {
        if origin == FileMode.reading {
            0;
        }
        else if origin == FileMode.writing {
            1;
        }
        else if origin == FileMode.appending {
            2;
        }
        else if origin == FileMode.reading_and_writing {
            3;
        }
        else {
            4;
        }
    }
}

hidden object NativeSeekOrigin {
    has origin is SeekOrigin;

    NativeSeekOrigin(origin is SeekOrigin) {
        self.origin = origin;
    }

    code() is int {
        if origin == SeekOrigin.start {
            0;
        }
        else if origin == SeekOrigin.current {
            1;
        }
        else {
            2;
        }
    }
}

hidden object NativeLockMode {
    has origin is FileLockMode;

    NativeLockMode(origin is FileLockMode) {
        self.origin = origin;
    }

    code() is int {
        if origin == FileLockMode.shared {
            0;
        }
        else {
            1;
        }
    }
}

test "text: write, append, read whole, by line, in batches and rewrite" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("notes.txt");
    let writer = File(path: path, mode: FileMode.writing);
    writer.text().writeln("first");
    writer.text().write("sec", "ond");
    writer.text().writeln();
    writer.close();
    let more = File(path: path, mode: FileMode.appending);
    more.text().writeln("");
    more.text().write("last");
    more.close();
    test.is(File(path: path).text().content(), "first\nsecond\n\nlast");
    test.is(File(path: path).text().lines(), ["first", "second", "", "last"]);
    let reader = File(path: path);
    test.is(reader.text().line(), "first");
    let seen is @string = reader.text().map() -> line {
        "<" + line + ">";
    };
    test.is(seen, ["<second>", "<>", "<last>"]);
    test.ok(try {
        reader.text().line();
        false;
    }
    catch end is EndOfInput {
        true;
    });
    reader.close();
    reader.close();
    test.ok(reader.closed());
    let counter = File(path: path, mode: FileMode.reading_and_writing);
    let old = counter.text().content();
    counter.text().rewrite(old.length().string());
    counter.close();
    test.is(File(path: path).text().content(), "18");
    scratch.close();
}

test "binary: bytes one by one, in pieces and whole, at an offset; the first view picks the mode" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("data.bin");
    let writer = File(path: path, mode: FileMode.writing);
    writer.binary() <- [byte(1), byte(2), byte(3), byte(4), byte(5)];
    writer.close();
    let all is @int = File(path: path).binary().map() -> b {
        b.int();
    };
    test.is(all, [1, 2, 3, 4, 5]);
    let reader = File(path: path);
    test.is(reader.binary().byte().int(), 1);
    test.is(reader.binary().bytes(2), [byte(2), byte(3)]);
    test.is(reader.binary().bytes(), [byte(4), byte(5)]);
    test.is(reader.binary().bytes(9), []);
    test.ok(try {
        reader.text().line();
        false;
    }
    catch FileError.invalid_operation(_) {
        true;
    });
    reader.close();
    let seeking = File(path: path, mode: FileMode.reading_and_writing);
    seeking.binary().seek(3, SeekOrigin.start);
    test.is(seeking.binary().bytes(9), [byte(4), byte(5)]);
    seeking.binary().truncate(2);
    test.is(seeking.binary().offset(), 5);
    seeking.close();
    test.is(File(path: path).binary().bytes(), [byte(1), byte(2)]);
    scratch.close();
}

test "errors name the path; locks are taken without waiting and reported by mode" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let missing = scratch.path().child("missing.txt");
    test.ok(try {
        File(path: missing).text().content();
        false;
    }
    catch FileError.not_found(path) {
        path == missing.string();
    });
    test.ok(try {
        File(path: missing, encoding: "klingon");
        false;
    }
    catch FileError.unsupported_encoding(name) {
        name == "klingon";
    });
    let path = scratch.path().child("locked.txt");
    File(path: path, mode: FileMode.writing).text().write("");
    let file = File(path: path, mode: FileMode.reading_and_writing);
    test.ok(!file.locked(FileLockMode.shared) && !file.locked(FileLockMode.exclusive));
    let lock = file.lock(FileLockMode.exclusive) else panic "a free file locks";
    test.ok(file.locked(FileLockMode.exclusive) && !file.locked(FileLockMode.shared));
    let other = File(path: path, mode: FileMode.reading_and_writing);
    test.ok(other.lock(FileLockMode.shared) ?? .none: true !! _: false);
    lock.close();
    test.ok(!file.locked(FileLockMode.exclusive));
    let shared = other.lock(FileLockMode.shared) else panic "a released file locks";
    test.ok(other.locked(FileLockMode.shared));
    shared.close();
    other.close();
    file.close();
    scratch.close();
}
