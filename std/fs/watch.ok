module fs/watch v1.0.0;

import "fs/directory" take Directory;
import "fs/entry" take FileEntry;
import "fs/error" take FileError, FileFailure;
import "fs/file" take File, FileMode;
import "fs/path" take Path;
import "fs/temp" take TemporaryDirectory;
import "io/stream" take Closing;
import "runtime/fs" take FileWatchState, path_encode, file_watch_create, file_watch_event,
    file_watch_closed, file_watch_close;

// FileWatch observes an existing file or directory without exposing blocking
// operating-system events through Cursor. A directory watch covers the
// directory itself and its immediate children; it is deliberately not
// recursive. Use one FileWatch per directory when a tree must be observed.
//
// Wait for one change:
//
//     let watch = FileWatch(path: workspace.path());
//     defer watch.close();
//     let event is FileEvent = await watch.event();
//     output.writeln(event::Change::kind.string(), ": ", event.path().string());
//
// Consume changes continuously:
//
//     let watch = FileWatch(path: configuration.parent());
//     defer watch.close();
//     loop {
//         let event is FileEvent = await watch.event();
//         if event.path() == configuration {
//             reload(configuration);
//         }
//     }
//
// A rename carries the new path in path() and the old path in
// previous_path():
//
//     let event is FileEvent = await watch.event();
//     if event::Change::kind == FileEventKind.renamed {
//         output.writeln(
//             event.previous_path().string(),
//             " -> ",
//             event.path().string(),
//         );
//     }
//
// previous_path() is intentionally unavailable for created, modified and
// removed events. Only one event() call may be pending on a watch. Providers
// may coalesce repeated identical changes that happen faster than they can be
// observed, but preserve the order of the events they do report.

// What happened to a path.
enum FileEventKind = (created, modified, removed, renamed);

// One change seen by a FileWatch.
object FileEvent {
    has origin is Path;
    has change is FileEventKind;
    has previous is Maybe<Path>;

    // A change to path.
    FileEvent(path is Path, kind is FileEventKind) {
        origin = path;
        change = kind;
        previous = Maybe<Path>.none;
    }

    // A rename from previous_path to path.
    FileEvent(path is Path, kind is FileEventKind, previous_path is Path) {
        origin = path;
        change = kind;
        previous = Maybe.some(previous_path);
    }

    // The path that changed.
    path() is Path {
        origin;
    }

    // What happened to the path.
    cap Change {
        kind is FileEventKind {
            change;
        }
    }

    // The old path of a rename; MissingPreviousPath for other changes.
    previous_path() is Path {
        match previous {
            case Maybe.some(path) {
                path;
            }
            else {
                throw MissingPreviousPath.path(origin.string());
            }
        }
    }
}

// Watches a file, or a directory and its immediate children, for changes.
object FileWatch does Closing {
    has state is FileWatchState;

    // Starts watching an existing path.
    FileWatch(path is Path) {
        state = try {
            file_watch_create(path_encode(path.string()));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: path.string()).error();
        };
    }

    // The next change, once it happens.
    async event() is FileEvent {
        let details is %string:string = try {
            await file_watch_event(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        };
        let name is string = details["kind"];
        let kind is FileEventKind = match name {
            case "created" {
                FileEventKind.created;
            }
            case "modified" {
                FileEventKind.modified;
            }
            case "removed" {
                FileEventKind.removed;
            }
            case "renamed" {
                FileEventKind.renamed;
            }
            else {
                throw FileError.failed(
                    "invalid_data",
                    "runtime returned an unknown file-event kind"
                );
            }
        };
        if kind == FileEventKind.renamed {
            FileEvent(
                path: Path(details["path"]),
                kind: kind,
                previous_path: Path(details["previous"]),
            );
        }
        else {
            FileEvent(path: Path(details["path"]), kind: kind);
        }
    }

    // Whether it is closed.
    closed() is bool {
        try {
            file_watch_closed(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Stops watching.
    close() is void {
        try {
            file_watch_close(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }
}

// Only a rename has a previous path.
enum MissingPreviousPath is Error = (path(path is string));

test "an event carries its path and kind; only a rename has a previous path" {
    let created = FileEvent(path: Path("a.txt"), kind: FileEventKind.created);
    test.is(created.path(), Path("a.txt"));
    test.ok(created::Change::kind == FileEventKind.created);
    test.ok(try {
        created.previous_path();
        false;
    }
    catch MissingPreviousPath.path(failed) {
        failed == "a.txt";
    });
    let renamed = FileEvent(
        path: Path("b.txt"),
        kind: FileEventKind.renamed,
        previous_path: Path("a.txt"),
    );
    test.ok(renamed::Change::kind == FileEventKind.renamed);
    test.is(renamed.previous_path(), Path("a.txt"));
    test.ok(renamed != FileEvent(path: Path("b.txt"), kind: FileEventKind.renamed));
}

async test "a directory watch reports its children created, modified, renamed and removed" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-watch-test-");
    let root = scratch.path();
    let watch = FileWatch(path: root);
    let notes = root.child("notes.txt");
    File(path: notes, mode: FileMode.writing).text().write("one");
    let created is FileEvent = await watch.event();
    test.ok(created::Change::kind == FileEventKind.created);
    test.is(created.path(), notes);
    File(path: notes, mode: FileMode.appending).text().write(", two");
    let modified is FileEvent = await watch.event();
    test.ok(modified::Change::kind == FileEventKind.modified);
    test.is(modified.path(), notes);
    let kept = root.child("kept.txt");
    FileEntry(path: notes).move(kept);
    let renamed is FileEvent = await watch.event();
    test.ok(renamed::Change::kind == FileEventKind.renamed);
    test.is(renamed.path(), kept);
    test.is(renamed.previous_path(), notes);
    FileEntry(path: kept).remove();
    let removed is FileEvent = await watch.event();
    test.ok(removed::Change::kind == FileEventKind.removed);
    test.is(removed.path(), kept);
    test.ok(!watch.closed());
    watch.close();
    watch.close();
    test.ok(watch.closed());
    scratch.close();
}

test "a missing path cannot be watched" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-watch-test-");
    let missing = scratch.path().child("absent");
    test.ok(try {
        FileWatch(path: missing);
        false;
    }
    catch FileError.not_found(failed) {
        failed == missing.string();
    });
    scratch.close();
}
