module fs/temp v1.0.0;

import "fs/directory" take Directory, DirectoryLocating;
import "fs/entry" take FileEntry;
import "fs/error" take FileError, FileFailure;
import "fs/path" take Path;
import "io/stream" take ByteSource, Reading, Writing, WritingText, Closing, IncompleteWrite,
    InvalidReadLimit;
import "encoding/utf" take Utf8Encoded;
import "os/environment" take Environment;
import "runtime/fs" take FileState, TemporaryDirectoryState, path_encode, path_decode,
    file_state_read, file_state_write, file_state_flush, file_state_close, file_state_closed,
    temporary_file_create, temporary_file_path, temporary_file_preserve, temporary_directory_create,
    temporary_directory_path, temporary_directory_closed, temporary_directory_close, symlink;

// Temporary resources are created eagerly with unpredictable names inside an
// explicitly supplied directory. prefix is one filename component, not a path.
// Temporary files are binary read/write streams with owner-only permissions:
//
//     let temporary = TemporaryFile(directory: scratch, prefix: "upload-");
//     defer temporary.close();
//     temporary.write(payload);
//     temporary.flush();
//     let path is Path = temporary.path();
//
// close() is idempotent and deletes an unpreserved temporary file. Preserve a
// completed file under a deliberate destination before the deferred close:
//
//     let preservation = TemporaryFilePreservation(
//         origin: temporary,
//         destination: output,
//     );
//     preservation.preserve();
//     let result = preservation.destination();
//
// Preservation never replaces an existing destination. It keeps the operation
// atomic when both paths share a filesystem and copies in bounded chunks when
// crossing filesystems.
//
// TemporaryDirectory.close() recursively deletes its contents. Symbolic links
// are removed as leaves; their targets are never traversed or deleted.

object TemporaryFile does Reading, Writing, WritingText, Closing {
    has state is FileState;

    TemporaryFile(directory is DirectoryLocating, prefix is string) {
        state = try {
            temporary_file_create(
                path_encode(directory.path().string()),
                prefix,
            );
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: directory.path().string()).error();
        };
    }

    bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        try {
            file_state_read(state, limit);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    write(source is ByteSource) is void {
        self.write(source.bytes());
    }

    write(bytes is @byte) is void {
        let written is int = try {
            file_state_write(state, bytes);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        };
        confirm written == bytes.size() else throw IncompleteWrite.after(written);
    }

    // Text, as UTF-8.
    write(values is ...string) is void {
        let text is @string = values...;
        self.write(Utf8Encoded(text.join("")));
    }

    writeln(values is ...string) is void {
        let text is @string = values...;
        self.write(Utf8Encoded(text.join("") + "\n"));
    }

    flush() is void {
        try {
            file_state_flush(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    destroy {
        self.close();
    }

    closed() is bool {
        try {
            file_state_closed(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    close() is void {
        try {
            file_state_close(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    path() is Path {
        try {
            Path(path_decode(temporary_file_path(state)));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Its size in bytes on disk now.
    size() is int {
        FileEntry(path: self.path()).stat()::Shape::size;
    }

    preserve(destination is Path) is void {
        try {
            temporary_file_preserve(state, path_encode(destination.string()));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: destination.string()).error();
        }
    }
}

object TemporaryFilePreservation {
    has owner is TemporaryFile;
    has destination is Path;

    TemporaryFilePreservation(origin is TemporaryFile, destination is Path) {
        owner = origin;
        self.destination = destination;
    }

    destination() is FileEntry {
        FileEntry(path: destination);
    }

    preserve() is void {
        owner.preserve(destination);
    }
}

object TemporaryDirectory does DirectoryLocating, Closing {
    has state is TemporaryDirectoryState;

    // In the system's directory for temporary files unless a parent is given:
    // TemporaryDirectory(prefix: "build-").
    TemporaryDirectory(
        parent is DirectoryLocating = Environment().temporary(),
        prefix is string = "okkama-"
    ) {
        state = try {
            temporary_directory_create(
                path_encode(parent.path().string()),
                prefix,
            );
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: parent.path().string()).error();
        };
    }

    // A temporary file inside it: scratch.file(prefix: "upload-").
    file(prefix is string = "okkama-") is TemporaryFile {
        TemporaryFile(directory: self, prefix: prefix);
    }

    path() is Path {
        try {
            Path(path_decode(temporary_directory_path(state)));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    destroy {
        self.close();
    }

    closed() is bool {
        try {
            temporary_directory_closed(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    close() is void {
        try {
            temporary_directory_close(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }
}

test "a temporary file is written, named under its directory and gone after close" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let temporary = TemporaryFile(directory: scratch, prefix: "upload-");
    let path = temporary.path();
    test.is(path.parent(), scratch.path());
    test.ok(
        path.string().slice(scratch.path().string().length() + 1, path.string().length()).starts_with(
            "upload-"
        )
    );
    temporary.write([byte(1), byte(2), byte(3)]);
    temporary.flush();
    test.is(FileEntry(path: path).stat()::Shape::size, 3);
    test.ok(!temporary.closed());
    temporary.close();
    temporary.close();
    test.ok(temporary.closed());
    test.ok(!FileEntry(path: path).existence());
    let other = TemporaryFile(directory: scratch, prefix: "upload-");
    test.ok(other.path() != path);
    other.close();
    scratch.close();
}

test "a preserved file stays under its destination and never replaces one" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let output = scratch.path().child("report.bin");
    let temporary = TemporaryFile(directory: scratch, prefix: "report-");
    temporary.write([byte(7), byte(8)]);
    temporary.flush();
    let preservation = TemporaryFilePreservation(origin: temporary, destination: output);
    preservation.preserve();
    temporary.close();
    test.is(preservation.destination().path(), output);
    test.ok(preservation.destination().existence());
    test.is(FileEntry(path: output).stat()::Shape::size, 2);
    let second = TemporaryFile(directory: scratch, prefix: "report-");
    test.ok(try {
        second.preserve(output);
        false;
    }
    catch FileError.already_exists(failed) {
        failed == output.string();
    });
    second.close();
    test.is(FileEntry(path: output).stat()::Shape::size, 2);
    scratch.close();
}

test "a temporary directory removes its whole tree on close, links as leaves" {
    let outside = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let kept = outside.path().child("kept");
    Directory(path: kept).create();
    let scratch = TemporaryDirectory(parent: Directory(path: outside.path()), prefix: "tree-");
    let root = scratch.path();
    test.is(root.parent(), outside.path());
    Directory(path: root.child("a")).create();
    Directory(path: root.child("a").child("b")).create();
    let file = TemporaryFile(directory: Directory(path: root.child("a").child("b")), prefix: "f-");
    file.preserve(root.child("a").child("b").child("data"));
    file.close();
    symlink(path_encode(kept.string()), path_encode(root.child("link").string()));
    test.ok(!scratch.closed());
    scratch.close();
    scratch.close();
    test.ok(scratch.closed());
    test.ok(!Directory(path: root).existence());
    test.ok(Directory(path: kept).existence());
    test.ok(try {
        TemporaryFile(directory: Directory(path: root), prefix: "late-");
        false;
    }
    catch FileError.not_found(failed) {
        failed == root.string();
    });
    outside.close();
}

test "a scratch directory is a place to make scratch files in" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "temp-nest-");
    let inner = TemporaryDirectory(parent: scratch, prefix: "inner-");
    test.is(inner.path().parent() == scratch.path(), true);
    inner.close();
    scratch.close();
}

test "a temporary directory makes its own files and takes text" {
    let scratch = TemporaryDirectory(prefix: "fs-temp-text-");
    test.ok(scratch.path().name().starts_with("fs-temp-text-"));
    let notes = scratch.file(prefix: "notes-");
    test.is(notes.path().parent(), scratch.path());
    notes.write("héllo", " ");
    notes.writeln("world");
    notes.write([byte(33)]);
    notes.flush();
    test.is(notes.size(), 14);
    notes.close();
    scratch.close();
}
