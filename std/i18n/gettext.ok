object InvalidCatalog does Error {
    has position is int;has reason is string;
    InvalidCatalog(offset is int,reason is string){position=offset;self.reason=reason;}
    offset() is int{position;}text() is string{"invalid gettext catalog at "+position.string()+": "+reason;}
}
// Builders use local persistent lists, then materialize in linear traversal.
// Their temporary cells never escape the parsing operation.
object GettextListArray<T> {
    has values is @T;
    GettextListArray(origin is List<T>){
        let cursor is Atomic<Cursor<T>>=Atomic(origin.cursor());defer cursor.close();
        let reversed is @T=(0..origin.size()).map()->index{let current=cursor.value();let value=current.item();cursor.replace(current.successor());value;};
        let values is @T=(0..reversed.size()).map()->index{reversed[reversed.size()-index-1];};self.values=values;
    }
    values() is @T{values;}
}
object GettextAscii {
    has origin is string;GettextAscii(origin is string){self.origin=origin;}
    lower() is string{let bytes is @byte=AsciiEncoded(origin).bytes().map()->value{let code=value.int();if code>=65 && code<=90{(code+32).byte();}else{value;}};AsciiDecoded(bytes).string();}
    trim() is string{
        let start=Atomic(0);let end=Atomic(origin.length());defer start.close();defer end.close();
        loop{let at=start.value();if at>=end.value() || !GettextSpace(origin.slice(at,at+1)).value(){last;}start.replace(at+1);}
        loop{let at=end.value();if at<=start.value() || !GettextSpace(origin.slice(at-1,at)).value(){last;}end.replace(at-1);}
        origin.slice(start.value(),end.value());
    }
}
object GettextSpace {has origin is string;GettextSpace(origin is string){self.origin=origin;}value() is bool{origin==" " || origin=="\t" || origin=="\r" || origin=="\n";}}
object GettextControl {has code is int;GettextControl(code is int){self.code=code;}string() is string{Latin1Decoded([code.byte()]).string();}}
object GettextContains {has origin,part is string;GettextContains(origin is string,part is string){self.origin=origin;self.part=part;}value() is bool{origin.split(part).size()>1;}}
object GettextCharset {
    has name is string;
    GettextCharset(origin is string){
        confirm origin.length()>=1 && origin.length()<=64 else throw InvalidCatalog(0,"charset name length must be 1..64");
        let value=try{GettextAscii(origin).lower();}catch e is Error{throw InvalidCatalog(0,"charset name is not ASCII");};
        name=match value{case "utf-8","utf8"{"UTF-8";}case "iso-8859-1","iso8859-1","latin1","latin-1"{"ISO-8859-1";}case "us-ascii","ascii"{"US-ASCII";}else{throw InvalidCatalog(0,"unsupported charset: "+origin);}};
    }
    name() is string{name;}
    decoded(bytes is @byte,offset is int) is string{
        try{match name{case "UTF-8"{Utf8Decoded(bytes).string();}case "ISO-8859-1"{Latin1Decoded(bytes).string();}else{AsciiDecoded(bytes).string();}}}catch e is Error{throw InvalidCatalog(offset,"malformed "+name+" text");}
    }
    encoded(text is string,offset is int) is @byte{
        try{match name{case "UTF-8"{Utf8Encoded(text).bytes();}case "ISO-8859-1"{Latin1Encoded(text).bytes();}else{AsciiEncoded(text).bytes();}}}catch e is Error{throw InvalidCatalog(offset,"text cannot be represented in "+name);}
    }
