object PoNumericEscape {
    has result is int;
    PoNumericEscape(origin is string,base is int,offset is int){
        confirm origin.length()>0 && origin.length()<=4096 else throw InvalidCatalog(offset,"numeric escape length");let digits=GettextAscii(origin).lower();let alphabet=if base==8{"01234567";}else{"0123456789abcdef";};
        result=(0..digits.length()).reduce(0)->value,index{let character=digits.slice(index,index+1);let parts=alphabet.split(character);confirm parts.size()==2 else throw InvalidCatalog(offset,"numeric escape digit");let raised=value*base+parts[0].length();confirm raised<=255 else throw InvalidCatalog(offset,"numeric PO escape exceeds one byte");raised;};
    }
    value() is int{result;}
