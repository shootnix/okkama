// GNU formulas use unsigned integer operations. This portable profile fixes
// their width at 64 bits instead of inheriting the host's unsigned long width.
role GettextExpression {value(count is BigInt) is BigInt;depth() is int;}
object GettextLiteral does GettextExpression {
    has number is BigInt;has variable is bool;
    GettextLiteral(token is string,offset is int){variable=token=="n";number=if self.variable{BigInt("0");}else{confirm token.length()<=20 else throw InvalidCatalog(offset,"integer literal exceeds unsigned64");let value=BigInt(token);confirm value.order(BigInt("18446744073709551615"))!=Order.greater else throw InvalidCatalog(offset,"integer literal exceeds unsigned64");value;};}
    value(count is BigInt) is BigInt{if variable{count;}else{number;}}
    depth() is int{0;}
}
object GettextNot does GettextExpression {
    has origin is GettextExpression;has height is int;GettextNot(origin is GettextExpression){self.origin=origin;height=origin.depth()+1;confirm self.height<=64 else throw InvalidCatalog(0,"plural evaluation depth exceeds 64");}
    value(count is BigInt) is BigInt{BigInt(if origin.value(count).sign()==0{"1";}else{"0";});}
    depth() is int{height;}
}
object GettextConditional does GettextExpression {
    has condition,yes,no is GettextExpression;has height is int;
    GettextConditional(condition is GettextExpression,yes is GettextExpression,no is GettextExpression){self.condition=condition;self.yes=yes;self.no=no;let parts is @GettextExpression=[condition,yes,no];let maximum=parts.reduce(0)->maximum,part{if part.depth()>maximum{part.depth();}else{maximum;}};height=maximum+1;confirm self.height<=64 else throw InvalidCatalog(0,"plural evaluation depth exceeds 64");}
    value(count is BigInt) is BigInt{if condition.value(count).sign()!=0{yes.value(count);}else{no.value(count);}}
    depth() is int{height;}
}
object GettextBinary does GettextExpression {
    has left,right is GettextExpression;has operation is string;has offset,height is int;
    GettextBinary(left is GettextExpression,operation is string,right is GettextExpression,offset is int){self.left=left;self.right=right;self.operation=operation;self.offset=offset;height=1+(if left.depth()>right.depth(){left.depth();}else{right.depth();});confirm self.height<=64 else throw InvalidCatalog(offset,"plural evaluation depth exceeds 64");}
    depth() is int{height;}
    value(count is BigInt) is BigInt{
        let first=left.value(count);
        if operation=="&&" && first.sign()==0{return BigInt("0");}
        if operation=="||" && first.sign()!=0{return BigInt("1");}
        let second=right.value(count);let comparison=first.order(second);
        if operation=="&&" || operation=="||"{return BigInt(if second.sign()!=0{"1";}else{"0";});}
        let predicate=match operation{case "=="{comparison==Order.equal;}case "!="{comparison!=Order.equal;}case "<"{comparison==Order.less;}case "<="{comparison!=Order.greater;}case ">"{comparison==Order.greater;}case ">="{comparison!=Order.less;}else{false;}};
        if operation=="==" || operation=="!=" || operation=="<" || operation=="<=" || operation==">" || operation==">="{return BigInt(if predicate{"1";}else{"0";});}
        if operation=="/" || operation=="%"{confirm second.sign()!=0 else throw InvalidCatalog(offset,"plural expression divides by zero");}
        let value=match operation{case "+"{BigSum(left:first,right:second).value();}case "-"{BigDifference(left:first,right:second).value();}case "*"{BigProduct(left:first,right:second).value();}case "/"{BigQuotient(left:first,right:second).value();}else{BigRemainder(left:first,right:second).value();}};
        let modulus=BigInt("18446744073709551616");let remainder=BigRemainder(left:value,right:modulus).value();
        if remainder.sign()<0{BigSum(left:remainder,right:modulus).value();}else{remainder;}
    }
}
object GettextToken {
    has text is string;has offset is int;GettextToken(text is string,offset is int){self.text=text;self.offset=offset;}
    text() is string{text;}offset() is int{offset;}
}
object GettextTokens {
    has values is @GettextToken;
    GettextTokens(origin is string){
        confirm origin.length()>0 && origin.length()<=2048 else throw InvalidCatalog(0,"plural expression size must be 1..2048");
        let empty is List<GettextToken>=EmptyList();let items is Atomic<List<GettextToken>>=Atomic(empty);let position=Atomic(0);defer items.close();defer position.close();
        for RegexMatches(origin,Regex("[0-9]+|n|==|!=|<=|>=|&&|\\|\\||[!?:()+*/%<>-]"))->token{
            let at=token.range().start();for (position.value()..at)->index{confirm GettextSpace(origin.slice(index,index+1)).value() else throw InvalidCatalog(index,"invalid plural token");}
