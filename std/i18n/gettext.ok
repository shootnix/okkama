        confirm magic==[byte(222),byte(18),byte(4),byte(149)] || magic==[byte(149),byte(4),byte(18),byte(222)] else throw InvalidCatalog(0,"invalid MO magic");self.origin=origin;little=magic[0]==byte(222);
    }
    word(offset is int) is int{
        confirm offset>=0 && offset<=origin.size()-4 else throw InvalidCatalog(offset,"truncated MO word");let first=origin[offset].int();let second=origin[offset+1].int();let third=origin[offset+2].int();let fourth=origin[offset+3].int();
        if little{first+second*256+third*65536+fourth*16777216;}else{first*16777216+second*65536+third*256+fourth;}
    }
    text(table is int,index is int) is MoText{let at=table+index*8;MoText(origin,self.word(at+4),self.word(at));}
    pairs() is @MoPair{
        confirm self.word(4)==0 else throw InvalidCatalog(4,"MO revision must be 0.0 in this complete static-string profile");let count=self.word(8);let originals=self.word(12);let translated=self.word(16);let hash_count=self.word(20);let hash_offset=self.word(24);
        confirm count<=4097 else throw InvalidCatalog(8,"MO string count exceeds 4097");for [originals,translated]->table{confirm table>=28 && table<=origin.size() && count*8<=origin.size()-table else throw InvalidCatalog(table,"MO descriptor table outside input");}
        confirm hash_count<=16384 else throw InvalidCatalog(20,"MO hash table budget");
        if hash_count>0{confirm hash_offset>=28 && hash_offset<=origin.size() && hash_count*4<=origin.size()-hash_offset else throw InvalidCatalog(hash_offset,"MO hash table outside input");for (0..hash_count)->index{confirm self.word(hash_offset+index*4)<=count else throw InvalidCatalog(hash_offset+index*4,"invalid MO hash string index");}}
        let pairs is @MoPair=(0..count).map()->index{MoPair(self.text(originals,index),self.text(translated,index));};
        let bytes=pairs.reduce(0)->sum,pair{sum+pair.original().size()+pair.translated().size();};confirm bytes<=4194304 else throw InvalidCatalog(0,"MO referenced text exceeds 4194304 bytes");pairs;
    }
}
object ParsedMo {
    has result is PoDocument;
    ParsedMo(origin is @byte){
        let pairs=MoWords(origin).pairs();let headers=pairs.reduce(0)->sum,pair{sum+(if pair.original().size()==0{1;}else{0;});};confirm headers==1 else throw InvalidCatalog(0,"MO requires exactly one metadata entry");
        let header=pairs.reduce("")->chosen,pair{if pair.original().size()==0{Latin1Decoded(pair.translated().bytes()).string();}else{chosen;}};
        let charset=GettextMetadata(header).charset();let nul=GettextControl(0).string();let separator=GettextControl(4).string();let empty is @PoComment=[];let comments=PoComments(empty);
        let entries is @PoEntry=pairs.map()->pair{
            let original=charset.decoded(pair.original().bytes(),pair.original().offset());let translated=charset.decoded(pair.translated().bytes(),pair.translated().offset());
            let forms=original.split(nul);confirm forms.size()<=2 else throw InvalidCatalog(pair.original().offset(),"MO original has multiple plural separators");let keys=forms[0].split(separator);confirm keys.size()<=2 else throw InvalidCatalog(pair.original().offset(),"MO original has multiple context separators");
            let present=keys.size()==2;let context=if present{keys[0];}else{"";};let identity=if present{keys[1];}else{keys[0];};let plural=if forms.size()==2{forms[1];}else{"";};confirm forms.size()==1 || plural!="" else throw InvalidCatalog(pair.original().offset(),"empty MO plural identity");
            PoEntry(context,identity,plural,translated.split(nul),comments,present);
        };
        result=PoDocument(entries);
    }
    value() is PoDocument{result;}
}
object GettextCatalog {
    has locale is Locale;has document is PoDocument;has entries is SortedBy<PoEntry,string>;has rule is GettextPluralRule;
    GettextCatalog(origin is @byte,locale is Locale){
        let document=ParsedMo(origin).value();let source=document.entries();let empty is List<PoEntry>=EmptyList();let selected=(0..source.size()).reduce(empty)->items,index{let entry=source.item(index);if entry.identity()!=""{items.prefix(entry);}else{items;}};
        let values=GettextListArray(selected).values();let plural=values.reduce(false)->found,entry{found || entry.plural()!="";};let metadata=document.metadata();confirm !plural || metadata.membership("plural-forms") else throw InvalidCatalog(0,"plural MO requires Plural-Forms");
        let rule=GettextPluralRule(if metadata.membership("plural-forms"){metadata.text("plural-forms");}else{"nplurals=1; plural=0;";});
        for values->entry{confirm entry.plural()=="" || entry.translations().size()==rule.size() else throw InvalidCatalog(0,"MO plural translation count differs from nplurals");}
        self.locale=locale;self.document=document;self.rule=rule;entries=SortedBy(origin:values,key:(entry is PoEntry) is string{entry.sorting_key();});
    }
    locale() is Locale{locale;}metadata() is GettextMetadata{document.metadata();}
    membership(key is MessageKey) is bool{self.index(self.key(key),0,entries.size())>=0;}
    text(key is MessageKey) is string{let entry=self.entry(key);confirm entry.plural()=="" else throw WrongMessageEntry(false,true);entry.translations()[0];}
    plural(key is MessageKey,count is Decimal) is string{let entry=self.entry(key);confirm entry.plural()!="" else throw WrongMessageEntry(true,false);entry.translations()[rule.index(count)];}
    private:
    key(key is MessageKey) is string{(if key.has_context(){"1";}else{"0";})+key.context()+GettextControl(4).string()+key.identity();}
    entry(key is MessageKey) is PoEntry{let index=self.index(self.key(key),0,entries.size());confirm index>=0 else throw MissingMessage(key);entries.item(index);}
    index(key is string,start is int,stop is int) is int{
        if start>=stop{return -1;}let middle=start+((stop-start)/2).int();let comparison=key.order(entries.item(middle).sorting_key());if comparison==Order.equal{return middle;}
        if comparison==Order.less{self.index(key,start,middle);}else{self.index(key,middle+1,stop);}
    }
}
object GettextTranslation does Translating {
    has origin is GettextCatalog;GettextTranslation(origin is GettextCatalog){self.origin=origin;}
    membership(key is MessageKey) is bool{origin.membership(key);}text(key is MessageKey) is string{origin.text(key);}
    plural(key is MessageKey,count is PluralNumber) is string{origin.plural(key,count.number());}
}

test "GNU plural formula short circuits unused division" {test.is(GettextPluralRule("nplurals=2; plural=n==0 ? 0 : 1/n;").index(Decimal("0")),0);}
test "PO projection preserves explicit empty context" {let document=ParsedPo("msgctxt \"\"\nmsgid \"Open\"\nmsgstr \"opened\"\n").value();test.ok(ParsedPo(PoString(document).string()).value().entries().item(0).has_context());}
