        let amount=entries.reduce(0)->total,entry{let comments=entry.comments().records();let translations=entry.translations().reduce(0)->sum,text{sum+text.length();};let notes=(0..comments.size()).reduce(0)->sum,index{sum+comments.item(index).text().length();};total+entry.context().length()+entry.identity().length()+entry.plural().length()+translations+notes;};
