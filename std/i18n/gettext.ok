        "\""+GettextListArray(pieces.value()).values().join("")+"\"";
    }
}
object PoString {
    has result is string;PoString(origin is PoDocument){result=PoPrinting(origin).string();}
    string() is string{result;}
}
object PoPrinting {
    has origin is PoDocument;PoPrinting(origin is PoDocument){self.origin=origin;}
    string() is string{
        let entries=origin.entries();let texts is @string=(0..entries.size()).map()->index{
            let entry=entries.item(index);let records=entry.comments().records();let comments is @string=(0..records.size()).map()->at{
                let item=records.item(at);let prefix=match item.kind(){case PoCommentKind.translator{"# ";}case PoCommentKind.extracted{"#. ";}case PoCommentKind.reference{"#: ";}case PoCommentKind.flag{"#, ";}else{"#| ";}};prefix+item.text()+"\n";
            };
            let context=if entry.has_context(){"msgctxt "+PoEscaped(entry.context()).string()+"\n";}else{"";};let identity="msgid "+PoEscaped(entry.identity()).string()+"\n";
            let plural=if entry.plural()!=""{"msgid_plural "+PoEscaped(entry.plural()).string()+"\n";}else{"";};let values=entry.translations();
            let translated is @string=(0..values.size()).map()->at{"msgstr"+(if entry.plural()==""{"";}else{"["+at.string()+"]";})+" "+PoEscaped(values[at]).string()+"\n";};
            comments.join("")+context+identity+plural+translated.join("");
        };
        let trailing=origin.trailing_comments().records();let comments is @string=(0..trailing.size()).map()->at{let item=trailing.item(at);let prefix=match item.kind(){case PoCommentKind.translator{"# ";}case PoCommentKind.extracted{"#. ";}case PoCommentKind.reference{"#: ";}case PoCommentKind.flag{"#, ";}else{"#| ";}};prefix+item.text()+"\n";};
        let result=texts.join("\n")+(if comments.size()>0 && texts.size()>0{"\n";}else{"";})+comments.join("");confirm result.length()<=4194304 else throw InvalidCatalog(0,"PO output exceeds 4194304 scalars");result;
    }
}

object PoLineStrings {
    has octets is string;
    PoLineStrings(origin is string,offset is int,charset is GettextCharset){
        let empty is List<string>=EmptyList();let pieces is Atomic<List<string>>=Atomic(empty);let position=Atomic(0);defer pieces.close();defer position.close();
        for RegexMatches(origin,Regex("\"(?:[^\\\\\"\\r\\n]|\\\\.)*\""))->part{
            for (position.value()..part.range().start())->index{confirm GettextSpace(origin.slice(index,index+1)).value() else throw InvalidCatalog(offset+index,"text between quoted strings");}
            confirm pieces.value().size()<8192 else throw InvalidCatalog(offset,"quoted-fragment count");pieces.replace(pieces.value().prefix(Latin1Decoded(PoQuoted(part.text(),offset+part.range().start(),charset).bytes()).string()));position.replace(part.range().end());
        }
        confirm pieces.value().size()>0 else throw InvalidCatalog(offset,"expected PO quoted string");
        for (position.value()..origin.length())->index{confirm GettextSpace(origin.slice(index,index+1)).value() else throw InvalidCatalog(offset+index,"trailing PO field text");}
        octets=GettextListArray(pieces.value()).values().join("");confirm self.octets.length()<=262144 else throw InvalidCatalog(offset,"PO line byte budget");
    }
    octets() is string{octets;}
}
object PoField {
    has name is string;has index,offset,amount is int;has pieces is List<string>;
    PoField(name is string,index is int,offset is int,pieces is List<string>,amount is int){self.name=name;self.index=index;self.offset=offset;self.pieces=pieces;self.amount=amount;}
    name() is string{name;}index() is int{index;}offset() is int{offset;}
    following(octets is string) is PoField{confirm amount+octets.length()<=262144 && pieces.size()<8192 else throw InvalidCatalog(offset,"PO field byte/fragment budget");PoField(name,index,offset,pieces.prefix(octets),amount+octets.length());}
    string(charset is GettextCharset) is string{let text=charset.decoded(Latin1Encoded(GettextListArray(pieces).values().join("")).bytes(),offset);confirm text.length()<=65536 else throw InvalidCatalog(offset,"PO field exceeds 65536 scalars");text;}
}
object PoEntryFields {
    has fields is @PoField;has charset is GettextCharset;has comments is PoComments;
    PoEntryFields(fields is List<PoField>,charset is GettextCharset,comments is PoComments){self.fields=GettextListArray(fields).values();self.charset=charset;self.comments=comments;}
    value() is PoEntry{
        confirm self.seen("msgid") && self.seen("msgstr") else throw InvalidCatalog(0,"PO entry requires msgid and msgstr");
        let context=self.text("msgctxt");let identity=self.text("msgid");let plural=self.text("msgid_plural");let indexed=self.seen("msgid_plural");confirm !indexed || plural!="" else throw InvalidCatalog(0,"empty msgid_plural");
        let empty is List<PoField>=EmptyList();let translated=fields.reduce(empty)->chosen,field{if field.name()=="msgstr"{chosen.prefix(field);}else{chosen;}};let translations=GettextListArray(translated).values();
        let sorted is SortedBy<PoField,int>=SortedBy(origin:translations,key:(field is PoField) is int{field.index();});
        let values is @string=(0..sorted.size()).map()->index{let field=sorted.item(index);confirm field.index()==(if indexed{index;}else{-1;}) else throw InvalidCatalog(field.offset(),"duplicate, missing or wrong plural translation index");field.string(charset);};
        PoEntry(context,identity,plural,values,comments,self.seen("msgctxt"));
    }
    private:
    seen(name is string) is bool{fields.reduce(false)->found,field{found || field.name()==name;};}
    text(name is string) is string{let found=fields.reduce("")->text,field{if field.name()==name{field.string(charset);}else{text;}};found;}
}
object ParsedPo {
    has result is PoDocument;
    ParsedPo(origin is string){result=PoParsing(origin,GettextCharset("UTF-8")).value();}
    ParsedPo(origin is string,charset is string){result=PoParsing(origin,GettextCharset(charset)).value();}
    value() is PoDocument{result;}
}
object PoParsing {
    has origin is string;has charset is GettextCharset;
    has entries is Atomic<List<PoEntry>>;has fields is Atomic<List<PoField>>;has comments is Atomic<List<PoComment>>;has pending is Atomic<List<PoComment>>;
    PoParsing(origin is string,charset is GettextCharset){
        confirm origin.length()<=4194304 else throw InvalidCatalog(0,"PO input exceeds 4194304 scalars");self.origin=origin;self.charset=charset;
        let empty_entries is List<PoEntry>=EmptyList();let empty_fields is List<PoField>=EmptyList();let empty_comments is List<PoComment>=EmptyList();
        entries=Atomic(empty_entries);fields=Atomic(empty_fields);comments=Atomic(empty_comments);pending=Atomic(empty_comments);
    }
    value() is PoDocument{
        defer entries.close();defer fields.close();defer comments.close();defer pending.close();
        let lines=origin.split("\n");confirm lines.size()<=65536 else throw InvalidCatalog(0,"PO line count");let offset=Atomic(0);defer offset.close();
        for lines->line{self.line(line,offset.value());offset.replace(offset.value()+line.length()+1);}
        if fields.value().size()>0{self.finish();}
        let tail=pending.value();for CursorItems(GettextListArray(tail).values().cursor())->item{comments.replace(comments.value().prefix(item));}
        PoDocument(GettextListArray(entries.value()).values(),PoComments(GettextListArray(comments.value()).values()));
    }
    private:
    seen(name is string) is bool{for CursorItems(fields.value().cursor())->field{if field.name()==name{return true;}}false;}
    finish() is void{
        confirm entries.value().size()<4097 else throw InvalidCatalog(0,"PO entry count");let entry=PoEntryFields(fields.value(),charset,PoComments(GettextListArray(comments.value()).values())).value();entries.replace(entries.value().prefix(entry));
        let empty is List<PoField>=EmptyList();fields.replace(empty);comments.replace(pending.value());let empty_comments is List<PoComment>=EmptyList();pending.replace(empty_comments);
    }
    comment(kind is PoCommentKind,text is string,offset is int) is void{
        let target=if self.seen("msgstr"){pending;}else{comments;};confirm target.value().size()<4096 else throw InvalidCatalog(offset,"PO comment count");target.replace(target.value().prefix(PoComment(kind,text)));
    }
    line(raw is string,offset is int) is void{
        confirm raw.length()<=1048576 else throw InvalidCatalog(offset,"PO line length");let start=Atomic(0);defer start.close();
        loop{let index=start.value();if index>=raw.length() || (raw.slice(index,index+1)!=" " && raw.slice(index,index+1)!="\t"){last;}start.replace(index+1);}
        let end=raw.length()-(if raw.length()>0 && raw.slice(raw.length()-1,raw.length())=="\r"{1;}else{0;});if start.value()>=end{return;}let text=raw.slice(start.value(),end);let at=offset+start.value();
        if text.slice(0,1)=="#"{
            confirm text.length()<2 || text.slice(1,2)!="~" else throw InvalidCatalog(at,"obsolete PO entries belong to translation tooling");
            let marker=if text.length()>1{text.slice(1,2);}else{"";};let from=if marker=="." || marker==":" || marker=="," || marker=="=" || marker=="|"{2;}else{1;};let gap=from<text.length() && text.slice(from,from+1)==" ";let content=text.slice(from+(if gap{1;}else{0;}),text.length());
            if marker=="," || marker=="="{for content.split(",")->flag{let value=GettextAscii(flag).trim();confirm value!="" else throw InvalidCatalog(at,"empty PO flag");self.comment(PoCommentKind.flag,value,at);}}else{
                let kind=match marker{case "."{PoCommentKind.extracted;}case ":"{PoCommentKind.reference;}case "|"{PoCommentKind.previous;}else{PoCommentKind.translator;}};self.comment(kind,content,at);
            }return;
        }
        if text.slice(0,1)=="\""{
            confirm fields.value().size()>0 else throw InvalidCatalog(at,"orphan PO continuation");let current=fields.value();fields.replace(current.tail().prefix(current.first().following(PoLineStrings(text,at,charset).octets())));return;
        }
        let expression=Regex("^(msgctxt|msgid_plural|msgid|msgstr)(?:\\[([0-9]{1,2})\\])?[ \\t]+(.*)$");confirm RegexMatches(text,expression).found() else throw InvalidCatalog(at,"unknown PO directive");let directive=EntireRegexMatch(text,expression);let name=directive.capture(1).text();
        let indexed=directive.capture(2).matched();confirm !indexed || name=="msgstr" else throw InvalidCatalog(at,"index on nontranslation directive");let index=if indexed{ParsedInt(directive.capture(2).text()).value();}else{-1;};confirm index<16 else throw InvalidCatalog(at,"plural index exceeds 15");
        if (name=="msgctxt" || name=="msgid") && self.seen("msgid"){confirm self.seen("msgstr") else throw InvalidCatalog(at,"previous PO entry has no translation");self.finish();}
        if name=="msgctxt"{confirm fields.value().size()==0 else throw InvalidCatalog(at,"msgctxt must precede msgid");}
        if name=="msgid"{confirm !self.seen("msgid") && !self.seen("msgstr") else throw InvalidCatalog(at,"duplicate msgid");}
        if name=="msgid_plural"{confirm self.seen("msgid") && !self.seen("msgid_plural") && !self.seen("msgstr") else throw InvalidCatalog(at,"misplaced msgid_plural");}
        if name=="msgstr"{confirm self.seen("msgid") && (indexed==self.seen("msgid_plural")) else throw InvalidCatalog(at,"wrong singular/plural msgstr");}
        confirm fields.value().size()<19 else throw InvalidCatalog(at,"PO field count");let empty is List<string>=EmptyList();let field=PoField(name,index,at,empty,0).following(PoLineStrings(directive.capture(3).text(),at+directive.capture(3).range().start(),charset).octets());fields.replace(fields.value().prefix(field));
    }
}

object MoText {
    has origin is @byte;has offset,amount is int;
    MoText(origin is @byte,offset is int,amount is int){
        confirm amount>=0 && amount<=1048576 && offset>=0 && offset<origin.size() && amount<origin.size()-offset else throw InvalidCatalog(offset,"MO string range/budget");
        confirm origin[offset+amount]==byte(0) else throw InvalidCatalog(offset+amount,"MO string lacks terminating NUL");self.origin=origin;self.offset=offset;self.amount=amount;
    }
    bytes() is @byte{origin.slice(offset,offset+amount);}size() is int{amount;}offset() is int{offset;}
}
object MoPair {
    has original,translated is MoText;MoPair(original is MoText,translated is MoText){self.original=original;self.translated=translated;}
    original() is MoText{original;}translated() is MoText{translated;}
}
object MoWords {
    has origin is @byte;has little is bool;
    MoWords(origin is @byte){
