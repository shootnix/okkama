        for RegexMatches(origin,Regex("[^\\\\\"\\x{0}-\\x{1f}\\x{7f}]+|[\\\\\"\\x{0}-\\x{1f}\\x{7f}]"))->part{
            let scalar=part.text();let escaped=if scalar.length()>1{scalar;}else{
                if scalar=="\\"{"\\\\";}else{if scalar=="\""{"\\\"";}else{if scalar=="\n"{"\\n";}else{if scalar=="\r"{"\\r";}else{if scalar=="\t"{"\\t";}else{
                    let bytes=Utf8Encoded(scalar).bytes();if bytes.size()==1 && (bytes[0].int()<32 || bytes[0].int()==127){let value=bytes[0].int();"\\"+((value/64).int()).string()+(((value/8).int())%8).string()+(value%8).string();}else{scalar;}
                }}}}}
