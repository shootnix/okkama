module i18n/operands v1.0.0;

// The operands CLDR plural rules ask about a number (n, i, v, w, f, t, e).
// PluralNumber provides them; generated locale data reads them.

// Internal exact CLDR rule boundary. Compiled data consumes only this role.
role PluralOperands {
    relation(name is string, modulus is int, minimum is int, maximum is int) is bool;
}
