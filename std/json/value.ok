module json/value v1.0.0;

import "collections/sequence" take Sequencing;
import "runtime/json" take json_repeated_name;
import "math/decimal" take Decimal;
import "numbers/bigint" take BigInt, BigProduct, BigPower, BigPowerLimitExceeded;
import "runtime/number_text" take int_parse;
import "compare" take Order;

// Immutable JSON values with explicit nominal payloads.
//
// Arrays and objects defensively materialize their constructor sequences.
// JsonObject therefore preserves member insertion order without depending on
// builtin map iteration. It rejects duplicate names instead of choosing a
// surprising first-wins or last-wins policy.
//
// Members of scalar values need no wrapper:
//
//     JsonObject([JsonMember("id", 42), JsonMember("name", "Ada"), JsonMember("vip", true)]);
//
// Broad JsonValue references are processed without casts through print():
//
//     for document.values() -> item {
//         item.print(handler);
//     }


enum JsonKind = (
    null_value,
    boolean_value,
    number_value,
    string_value,
    array_value,
    object_value
);

role JsonWriting {
    null_value() is void;
    boolean(value is bool) is void;
    number(value is Decimal) is void;
    text(value is string) is void;
    elements(values is Sequencing<JsonValue>) is void;
    members(members is Sequencing<JsonMember>) is void;
}

role JsonValue {
    kind() is JsonKind;
    print(to is JsonWriting) is void;
}

// How json/read.JsonView reaches a value, without casts: json/read reads any
// JsonValue through print(), json/parse reads its parsed nodes directly.
// Readings know no position in the document. Reading another kind than the
// value's is JsonKindMismatch, a missing member is MissingJsonMember, and a
// number that is not the integer asked for is JsonNumberMismatch; JsonView
// reports them as its own errors at its pointer. size, items, item, members,
// names and membership are asked only of arrays or objects, item only within
// bounds.
role JsonReading {
    kind() is JsonKind;
    value() is JsonValue;
    text() is string;
    number() is Decimal;
    int() is int;
    boolean() is bool;
    size() is int;
    items() is @JsonReading;
    item(index is int) is JsonReading;
    members() is @JsonMember;
    names() is @string;
    membership(name is string) is bool;
    member(name is string) is JsonReading;
    optional(name is string) is @JsonReading;
    // member(name).text() and so on, which a reading may answer without a
    // reading of the member; same results and failures.
    member_text(name is string) is string;
    member_number(name is string) is Decimal;
    member_int(name is string) is int;
    member_boolean(name is string) is bool;
}

object JsonMember {
    has member_name is string;
    has member_value is JsonValue;

    JsonMember(name is string, value is JsonValue) {
        member_name = name;
        member_value = value;
    }

    // Scalar members by the value's declared type: JsonMember("id", 42) is
    // JsonMember("id", JsonNumber(42)), and likewise text, bool and Decimal.
    JsonMember(name is string, value is string) {
        member_name = name;
        member_value = JsonText(value);
    }

    JsonMember(name is string, value is int) {
        member_name = name;
        member_value = JsonNumber(value);
    }

    JsonMember(name is string, value is bool) {
        member_name = name;
        member_value = JsonBoolean(value);
    }

    JsonMember(name is string, value is Decimal) {
        member_name = name;
        member_value = JsonNumber(value);
    }

    name() is string { member_name; }

    value() is JsonValue { member_value; }
}

object JsonNull does JsonValue {
    JsonNull();

    kind() is JsonKind { JsonKind.null_value; }

    print(to is JsonWriting) is void { to.null_value(); }
}

object JsonBoolean does JsonValue {
    has origin is bool;

    JsonBoolean(value is bool) { origin = value; }

    kind() is JsonKind { JsonKind.boolean_value; }

    print(to is JsonWriting) is void { to.boolean(origin); }
}

object JsonNumber does JsonValue {
    has origin is Decimal;

    JsonNumber(value is Decimal) { origin = value; }

    JsonNumber(value is int) { origin = Decimal(value.string()); }

    kind() is JsonKind { JsonKind.number_value; }

    print(to is JsonWriting) is void { to.number(origin); }
}

object JsonText does JsonValue {
    has origin is string;

    JsonText(value is string) { origin = value; }

    kind() is JsonKind { JsonKind.string_value; }

    print(to is JsonWriting) is void { to.text(origin); }
}

object JsonArray does JsonValue {
    has origin is @JsonValue;

    JsonArray(values is Sequencing<JsonValue>) {
        let snapshot is @JsonValue = (0..values.size()).map() -> index {
            let value is JsonValue = values.item(index);
            value;
        };
        origin = snapshot;
    }

    kind() is JsonKind { JsonKind.array_value; }

    values() is Sequencing<JsonValue> { origin; }

    print(to is JsonWriting) is void { to.elements(self.values()); }
}

object JsonObject does JsonValue {
    has origin is @JsonMember;

    JsonObject(members is Sequencing<JsonMember>) {
        let snapshot is @JsonMember = members.map() -> member { member; };
        origin = JsonDistinctMembers(snapshot).value();
    }

    // Builtin arrays are immutable already and are kept as they are.
    JsonObject(members is @JsonMember) { origin = JsonDistinctMembers(members).value(); }

    kind() is JsonKind { JsonKind.object_value; }

    membership(name is string) is bool {
        JsonMemberIndex(members: origin, name: name).value() >= 0;
    }

    value(name is string) is JsonValue {
        let index = JsonMemberIndex(members: origin, name: name).value();
        confirm index >= 0 else throw MissingJsonMember(name);
        origin[index].value();
    }

    members() is Sequencing<JsonMember> { origin; }

    print(to is JsonWriting) is void { to.members(self.members()); }
}

// Members with distinct names, or DuplicateJsonMember for the earliest
// repeated input index. Each immutable name is captured once.
object JsonDistinctMembers {
    has origin is @JsonMember;

    JsonDistinctMembers(origin is @JsonMember) { self.origin = origin; }

    value() is @JsonMember {
        let names is @string = origin.map() -> member { member.name(); };
        let duplicate = json_repeated_name(names);
        confirm duplicate == origin.size() else throw DuplicateJsonMember(origin[duplicate].name());
        origin;
    }
}

object JsonMemberIndex {
    has origin is @JsonMember;
    has sought is string;

    JsonMemberIndex(members is @JsonMember, name is string) {
        origin = members;
        sought = name;
    }

    value() is int {
        if origin.size() == 0 {
            -1;
        }
        else {
            for (0..origin.size()) -> index {
                last index if origin[index].name() == sought;
                -1;
            }
        }
    }
}

// A value of one kind read as another, before its position is known.
object JsonKindMismatch does Error {
    has wanted is JsonKind;
    has found is JsonKind;

    JsonKindMismatch(expected is JsonKind, actual is JsonKind) {
        wanted = expected;
        found = actual;
    }

    expected() is JsonKind { wanted; }
    actual() is JsonKind { found; }
    text() is string { "JSON value of another kind"; }
}

// A JSON number that is not the integer asked for, before its position is known.
object JsonNumberMismatch does Error {
    has spelling is string;
    has reason is string;

    JsonNumberMismatch(number is string, reason is string) {
        spelling = number;
        self.reason = reason;
    }

    number() is string { spelling; }
    reason() is string { reason; }
    text() is string { "JSON number " + spelling + ": " + reason; }
}

// The exact integer value of a JSON number of any size; fractions and
// exponents beyond 4096 bits are JsonNumberMismatch.
object JsonExactInteger {
    has exact is Decimal;
    JsonExactInteger(exact is Decimal) { self.exact = exact; }

    value() is BigInt {
        confirm exact.exponent() >= 0 else throw JsonNumberMismatch(exact.string(), "integer required");
        if exact.exponent() == 0 {
            exact.coefficient();
        }
        else {
            let scale = try {
                BigPower(BigInt("10"), exact.exponent(), 4096).value();
            }
            catch failure is BigPowerLimitExceeded {
                throw JsonNumberMismatch(exact.string(), "integer exceeds 4096 bits");
            };
            BigProduct(left: exact.coefficient(), right: scale).value();
        }
    }
}

// A JSON number as builtin int: an integer in the signed 64-bit range.
object JsonExactInt {
    has exact is Decimal;
    JsonExactInt(exact is Decimal) { self.exact = exact; }

    value() is int {
        let integer = JsonExactInteger(exact).value();
        confirm integer.order(BigInt("9223372036854775807")) != Order.greater && integer.order(BigInt("-9223372036854775808")) != Order.less
            else throw JsonNumberMismatch(integer.string(), "integer outside int range");
        int_parse(integer.string(), 10);
    }
}

object MissingJsonMember does Error {
    has origin is string;

    MissingJsonMember(name is string) { origin = name; }

    name() is string { origin; }

    text() is string { "missing JSON member \"" + origin + "\""; }
}

object MissingJsonLocation does Error {
    has origin is string;

    MissingJsonLocation(name is string) { origin = name; }

    name() is string { origin; }

    text() is string { "JSON member \"" + origin + "\" has no source location"; }
}

object DuplicateJsonMember does Error {
    has origin is string;
    has source_offset is int;
    has source_line is int;
    has source_column is int;
    has source_located is bool;

    DuplicateJsonMember(name is string) {
        origin = name;
        source_offset = 0;
        source_line = 1;
        source_column = 1;
        source_located = false;
    }

    DuplicateJsonMember(name is string, offset is int, line is int, column is int) {
        confirm offset >= 0;
        confirm line > 0;
        confirm column > 0;
        source_located = true;
        origin = name;
        source_offset = offset;
        source_line = line;
        source_column = column;
    }

    name() is string { origin; }

    located() is bool { source_located; }

    offset() is int {
        if source_located { source_offset; }
        else { throw MissingJsonLocation(origin); }
    }

    line() is int {
        if source_located { source_line; }
        else { throw MissingJsonLocation(origin); }
    }

    column() is int {
        if source_located { source_column; }
        else { throw MissingJsonLocation(origin); }
    }

    text() is string { "duplicate JSON member \"" + origin + "\""; }
}

test "duplicate names report the earliest repeated input index" {
    for [3, 8, 9, 20] -> width {
        let distinct is @JsonMember = (0..width).map() -> index { JsonMember("m" + index.string(), JsonNull()); };
        test.is(JsonObject(distinct).members().size(), width);
        let repeated is @JsonMember = (0..width).map() -> index {
            JsonMember(if index == width - 1 { "m1"; } else { "m" + index.string(); }, JsonNull());
        };
        test.is(try { JsonObject(repeated); ""; } catch failure is DuplicateJsonMember { failure.name(); }, "m1");
    }
}

test "scalar members wrap their value by declared type" {
    let value = JsonObject([JsonMember("i", 42), JsonMember("s", "x"), JsonMember("b", false),
        JsonMember("d", Decimal("1.5")), JsonMember("v", JsonNull())]);
    let kinds is @JsonKind = value.members().map() -> member { member.value().kind(); };
    test.is(kinds, [JsonKind.number_value, JsonKind.string_value, JsonKind.boolean_value,
        JsonKind.number_value, JsonKind.null_value]);
    test.is(JsonNumber(-7).kind(), JsonKind.number_value);
}
