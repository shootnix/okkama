module regex/search v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "regex/pattern" take Regex, RegexQuery, RegexMatchObservation, RegexRangeOutsideInput,
    NoRegexMatch;
import "regex/range" take RegexRange;
import "regex/match" take RegexCapture, RegexMatch, RegexMatching, UnmatchedRegexCapture,
    MissingRegexGroup;

// Mandatory searches are matches themselves: read them directly.
// Work is lazy and memoized by an opaque query state on the first observation.
//
//     let first = FirstRegexMatch(origin: "one 22 three", regex: Regex("\\d+"));
//     first.text(); // "22"
//
//     let prefix = PrefixRegexMatch(origin: "22 three", regex: Regex("\\d+"));
//     let entire = EntireRegexMatch(origin: "22", regex: Regex("\\d+"));
//
// Ordinary absence is checked without an exception or a value wrapper:
//
//     if RegexMatches(origin: document, regex: pattern).found() { ... }
//
// Traverse every non-overlapping match lazily:
//
//     for RegexMatches(origin: "a1 b22", regex: Regex("\\d+")) -> found {
//         Stdout().writeln(found.text());
//     }
//
// A selected range uses absolute Unicode-scalar offsets:
//
//     FirstRegexMatch(origin: text, regex: pattern, range: RegexRange(start: 10, end: 40));

object FirstRegexMatch does RegexMatching {
    has observation is RegexMatchObservation;

    FirstRegexMatch(origin is string, regex is Regex) {
        observation = RegexMatchObservation(
            origin: origin,
            regex: regex,
            range: RegexRange(0, origin.length()),
            mode: RegexQuery.first,
        );
    }

    FirstRegexMatch(origin is string, regex is Regex, range is RegexRange) {
        observation = RegexMatchObservation(
            origin: origin,
            regex: regex,
            range: range,
            mode: RegexQuery.first
        );
    }

    text() is string {
        observation.match().text();
    }

    range() is RegexRange {
        observation.match().range();
    }

    capture(index is int) is RegexCapture {
        observation.match().capture(index);
    }

    group(name is string) is RegexCapture {
        observation.match().group(name);
    }

    captures() is @RegexCapture {
        observation.match().captures();
    }
}

object PrefixRegexMatch does RegexMatching {
    has observation is RegexMatchObservation;

    PrefixRegexMatch(origin is string, regex is Regex) {
        observation = RegexMatchObservation(
            origin: origin,
            regex: regex,
            range: RegexRange(0, origin.length()),
            mode: RegexQuery.prefix,
        );
    }

    PrefixRegexMatch(origin is string, regex is Regex, range is RegexRange) {
        observation = RegexMatchObservation(
            origin: origin,
            regex: regex,
            range: range,
            mode: RegexQuery.prefix
        );
    }

    text() is string {
        observation.match().text();
    }

    range() is RegexRange {
        observation.match().range();
    }

    capture(index is int) is RegexCapture {
        observation.match().capture(index);
    }

    group(name is string) is RegexCapture {
        observation.match().group(name);
    }

    captures() is @RegexCapture {
        observation.match().captures();
    }
}

object EntireRegexMatch does RegexMatching {
    has observation is RegexMatchObservation;

    EntireRegexMatch(origin is string, regex is Regex) {
        observation = RegexMatchObservation(
            origin: origin,
            regex: regex,
            range: RegexRange(0, origin.length()),
            mode: RegexQuery.entire,
        );
    }

    EntireRegexMatch(origin is string, regex is Regex, range is RegexRange) {
        observation = RegexMatchObservation(
            origin: origin,
            regex: regex,
            range: range,
            mode: RegexQuery.entire
        );
    }

    text() is string {
        observation.match().text();
    }

    range() is RegexRange {
        observation.match().range();
    }

    capture(index is int) is RegexCapture {
        observation.match().capture(index);
    }

    group(name is string) is RegexCapture {
        observation.match().group(name);
    }

    captures() is @RegexCapture {
        observation.match().captures();
    }
}

object RegexMatches does Iterating<RegexMatching> {
    has source is string;
    has pattern is Regex;
    has selected is RegexRange;

    RegexMatches(origin is string, regex is Regex) {
        source = origin;
        pattern = regex;
        selected = RegexRange(start: 0, end: origin.length());
    }

    RegexMatches(origin is string, regex is Regex, range is RegexRange) {
        source = origin;
        pattern = regex;
        selected = range;
    }

    cursor() is Cursor<RegexMatching> {
        confirm selected::Bounds::end <= source.length()
            else throw RegexRangeOutsideInput.range(
                selected::Bounds::start,
                selected::Bounds::end,
                source.length()
            );
        RegexMatchCursor(
            origin: source,
            regex: pattern,
            position: selected::Bounds::start,
            end: selected::Bounds::end,
            exhausted: false,
        );
    }

    found() is bool {
        self.cursor().available();
    }
}

hidden object RegexMatchCursor does Cursor<RegexMatching> {
    has source is string;
    has pattern is Regex;
    has position is int;
    has limit is int;
    has exhausted is bool;
    has observation is RegexMatchObservation;

    RegexMatchCursor(
        origin is string,
        regex is Regex,
        position is int,
        end is int,
        exhausted is bool,
    ) {
        source = origin;
        pattern = regex;
        self.position = position;
        limit = end;
        self.exhausted = exhausted;
        observation = RegexMatchObservation(
            origin: origin,
            regex: regex,
            range: RegexRange(position, end),
            mode: RegexQuery.first,
        );
    }

    available() is bool {
        !exhausted && observation.found();
    }

    item() is RegexMatching {
        confirm self.available() else throw IterationEnded.ended;
        observation.match();
    }

    successor() is Cursor<RegexMatching> {
        confirm self.available() else throw IterationEnded.ended;
        let range = observation.match().range();
        let empty = range::Bounds::start == range::Bounds::end;
        RegexMatchCursor(
            origin: source,
            regex: pattern,
            position: if empty {
                if range::Bounds::end == limit {
                    limit;
                }
                else {
                    range::Bounds::end + 1;
                }
            }
            else {
                range::Bounds::end;
            },
            end: limit,
            exhausted: empty && range::Bounds::end == limit,
        );
    }
}

test "first, prefix and entire searches" {
    let digits = Regex("\\d+");
    let first = FirstRegexMatch(origin: "one 22 three", regex: digits);
    test.is(first.text(), "22");
    test.is(first.range()::Bounds::start, 4);
    test.is(first.range()::Bounds::end, 6);
    test.is(PrefixRegexMatch(origin: "22 three", regex: digits).text(), "22");
    test.is(EntireRegexMatch(origin: "22", regex: digits).text(), "22");
    test.ok(!RegexMatches(origin: "22x", regex: Regex("^\\d+$")).found());
    test.is(
        try {
            EntireRegexMatch(origin: "22x", regex: digits).text();
        }
        catch error is NoRegexMatch {
            "none";
        },
        "none"
    );
    // Offsets count Unicode scalars: the digit after "a😀я" is at 3.
    test.is(
        FirstRegexMatch(origin: "a😀я1", regex: Regex("\\d"), range: RegexRange(1, 4)).range()::Bounds::start,
        3
    );
}

test "captures and named groups" {
    let pair = Regex("(?<key>\\w+)=(\\d+)?");
    let found = FirstRegexMatch(origin: "x key= y", regex: pair);
    test.is(found.text(), "key=");
    test.is(found.group("key").text(), "key");
    test.is(found.capture(0).text(), "key=");
    test.is(found.captures().size(), 2);
    test.ok(!found.capture(2).matched());
    test.is(
        try {
            found.capture(2).text();
        }
        catch UnmatchedRegexCapture.index(index) {
            "unmatched " + index.string();
        },
        "unmatched 2"
    );
    test.is(
        try {
            found.group("nope").text();
        }
        catch MissingRegexGroup.name(name) {
            "missing " + name;
        },
        "missing nope"
    );
}

test "matches walk every non-overlapping match" {
    test.is(
        RegexMatches(origin: "a1 b22 c", regex: Regex("\\d+")).map() -> found {
            found.text() + "@" + found.range()::Bounds::start.string();
        }.join(","),
        "1@1,22@4"
    );
    // An empty match advances by one scalar.
    test.is(
        RegexMatches(origin: "abc", regex: Regex("x*")).map() -> found {
            found.range()::Bounds::start.string();
        }.join(","),
        "0,1,2,3"
    );
    test.ok(RegexMatches(origin: "abc", regex: Regex("b")).found());
    test.is(
        RegexMatches(origin: "abc", regex: Regex("\\d")).map() -> found {
            found.text();
        }.join(","),
        ""
    );
}
