module regex/replace v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "collections/views" take Accumulated, Taken;
import "regex/match" take RegexMatching;
import "regex/pattern" take Regex;
import "regex/search" take RegexMatches;
import "strings/parse" take Number;
import "runtime/regex" take RegexReplacementState, regex_replacement_state,
    regex_replacement_prepare, regex_replacement_tokens, RegexSubstitutionState,
    regex_substitution_state, regex_substitution_ready, regex_substitution_store,
    regex_substitution_string, regex_substitution_amount;

role ReplacingRegexMatch {
    replacement(found is RegexMatching) is string;
}

// Literal replacement never interprets dollars:
//
//     RegexSubstitution(
//         origin: "a1 b22",
//         regex: Regex("\\d+"),
//         replacing: LiteralRegexReplacement("N"),
//     ).string(); // "aN bN"
//
// Expanded replacement supports $0, $1, ${name} and $$:
//
//     let changed = RegexSubstitution(
//         origin: "Ada Lovelace",
//         regex: Regex("(?<first>\\w+) (?<last>\\w+)"),
//         replacing: ExpandedRegexReplacement("${last}, ${first}"),
//     );
//     changed.string(); // "Lovelace, Ada"
//     changed.amount(); // 1
//
// Custom policy is an ordinary ReplacingRegexMatch object. Its replacement()
// receives the same RegexMatching interface as search results.

object LiteralRegexReplacement does ReplacingRegexMatch {
    has origin is string;

    LiteralRegexReplacement(value is string) {
        origin = value;
    }

    replacement(found is RegexMatching) is string {
        origin;
    }
}

object ExpandedRegexReplacement does ReplacingRegexMatch {
    has source is string;
    has state is RegexReplacementState;

    ExpandedRegexReplacement(template is string) {
        source = template;
        state = regex_replacement_state(template);
    }

    replacement(found is RegexMatching) is string {
        let status = regex_replacement_prepare(state);
        confirm status["status"] == 0
            else throw InvalidRegexReplacement.located(
                status["offset"],
                "invalid regex replacement"
            );
        let tokens is @string = regex_replacement_tokens(state);
        for Accumulated(
            origin: ReplacementTokens(tokens),
            initial: "",
            action: (rendered is string, token is ReplacementToken) is string {
                rendered + self.expansion(
                    kind: token.kind(),
                    value: token.text(),
                    found: found,
                );
            },
        ) -> rendered {
            rendered;
        }
    }

    hidden expansion(
        kind is string,
        value is string,
        found is RegexMatching,
    ) is string {
        if kind == "literal" {
            value;
        }
        else if kind == "index" {
            let capture = found.capture(Number(value).int());
            if capture.matched() {
                capture.text();
            }
            else {
                "";
            }
        }
        else {
            let capture = found.group(value);
            if capture.matched() {
                capture.text();
            }
            else {
                "";
            }
        }
    }
}

hidden object ReplacementToken {
    has classification is string;
    has origin is string;

    ReplacementToken(kind is string, text is string) {
        classification = kind;
        origin = text;
    }

    kind() is string {
        classification;
    }

    text() is string {
        origin;
    }
}

hidden object ReplacementTokens does Iterating<ReplacementToken> {
    has origin is @string;

    ReplacementTokens(tokens is @string) {
        origin = tokens;
    }

    cursor() is Cursor<ReplacementToken> {
        ReplacementTokenCursor(tokens: origin, position: 0);
    }
}

hidden object ReplacementTokenCursor does Cursor<ReplacementToken> {
    has origin is @string;
    has position is int;

    ReplacementTokenCursor(tokens is @string, position is int) {
        origin = tokens;
        self.position = position;
    }

    available() is bool {
        position < origin.size();
    }

    item() is ReplacementToken {
        confirm self.available() else throw IterationEnded.ended;
        ReplacementToken(kind: origin[position], text: origin[position + 1]);
    }

    successor() is Cursor<ReplacementToken> {
        confirm self.available() else throw IterationEnded.ended;
        ReplacementTokenCursor(tokens: origin, position: position + 2);
    }
}

// RegexSubstitution is the observable result, not a builder followed by
// value(). Both facts are derived from exactly the same traversal semantics.
object RegexSubstitution {
    has source is string;
    has pattern is Regex;
    has replacing is ReplacingRegexMatch;
    has maximum is int;
    has state is RegexSubstitutionState;

    RegexSubstitution(
        origin is string,
        regex is Regex,
        replacing is ReplacingRegexMatch,
    ) {
        source = origin;
        pattern = regex;
        self.replacing = replacing;
        maximum = -1;
        state = regex_substitution_state();
    }

    RegexSubstitution(
        origin is string,
        regex is Regex,
        replacing is ReplacingRegexMatch,
        limit is int,
    ) {
        confirm limit > 0 else throw InvalidRegexReplacementLimit.limit(limit);
        source = origin;
        pattern = regex;
        self.replacing = replacing;
        maximum = limit;
        state = regex_substitution_state();
    }

    string() is string {
        self.substitution().string();
    }

    amount() is int {
        self.substitution().amount();
    }

    hidden matches() is Iterating<RegexMatching> {
        let found = RegexMatches(origin: source, regex: pattern);
        if maximum < 0 {
            found;
        }
        else {
            Taken(origin: found, count: maximum);
        }
    }

    hidden substitution() is RegexSubstitutionResult {
        if regex_substitution_ready(state) {
            RegexSubstitutionResult(
                string: regex_substitution_string(state),
                amount: regex_substitution_amount(state),
            );
        }
        else {
            self.computed();
        }
    }

    hidden computed() is RegexSubstitutionResult {
        for Accumulated(
            origin: self.matches(),
            initial: RegexSubstitutionProgress(
                origin: source,
                rendered: "",
                offset: 0,
                amount: 0,
            ),
            action: (current is RegexSubstitutionProgress, found is RegexMatching) is RegexSubstitutionProgress {
                current.successor(found, replacing);
            },
        ) -> current {
            let result = current.substitution();
            regex_substitution_store(
                state,
                result.string(),
                result.amount(),
            );
            result;
        }
    }
}

hidden object RegexSubstitutionProgress {
    has source is string;
    has rendered is string;
    has offset is int;
    has quantity is int;

    RegexSubstitutionProgress(
        origin is string,
        rendered is string,
        offset is int,
        amount is int,
    ) {
        source = origin;
        self.rendered = rendered;
        self.offset = offset;
        quantity = amount;
    }

    successor(
        found is RegexMatching,
        replacing is ReplacingRegexMatch,
    ) is RegexSubstitutionProgress {
        let range = found.range();
        RegexSubstitutionProgress(
            origin: source,
            rendered: rendered +
                source.slice(offset, range::Bounds::start) +
                replacing.replacement(found),
                offset: range::Bounds::end,
                amount: quantity + 1,
        );
    }

    substitution() is RegexSubstitutionResult {
        RegexSubstitutionResult(
            string: rendered + source.slice(offset, source.length()),
            amount: quantity,
        );
    }
}

hidden object RegexSubstitutionResult {
    has rendered is string;
    has quantity is int;

    RegexSubstitutionResult(string is string, amount is int) {
        rendered = string;
        quantity = amount;
    }

    string() is string {
        rendered;
    }

    amount() is int {
        quantity;
    }
}

enum InvalidRegexReplacement is Error = (located(offset is int, message is string));

enum InvalidRegexReplacementLimit is Error = (limit(limit is int));

test "literal replacement never expands dollars" {
    let changed = RegexSubstitution(
        origin: "a1 b22 c",
        regex: Regex("\\d+"),
        replacing: LiteralRegexReplacement("$0"),
    );
    test.is(changed.string(), "a$0 b$0 c");
    test.is(changed.amount(), 2);
    let untouched = RegexSubstitution(
        origin: "abc",
        regex: Regex("\\d"),
        replacing: LiteralRegexReplacement("N"),
    );
    test.is(untouched.string(), "abc");
    test.is(untouched.amount(), 0);
}

test "expanded replacement reads groups by number and name" {
    let changed = RegexSubstitution(
        origin: "Ada Lovelace",
        regex: Regex("(?<first>\\w+) (?<last>\\w+)"),
        replacing: ExpandedRegexReplacement("${last}, ${first} ($0) $$1"),
    );
    test.is(changed.string(), "Lovelace, Ada (Ada Lovelace) $1");
    test.is(changed.amount(), 1);
    test.is(
        RegexSubstitution(
            origin: "2026-11-11",
            regex: Regex("(\\d+)-(\\d+)-(\\d+)"),
            replacing: ExpandedRegexReplacement("$3.$2.$1"),
        ).string(),
        "11.11.2026"
    );
}

test "a limit stops after that many replacements" {
    let limited = RegexSubstitution(
        origin: "x x x x",
        regex: Regex("x"),
        replacing: LiteralRegexReplacement("y"),
        limit: 2,
    );
    test.is(limited.string(), "y y x x");
    test.is(limited.amount(), 2);
    test.is(
        try {
            RegexSubstitution(
                origin: "x",
                regex: Regex("x"),
                replacing: LiteralRegexReplacement("y"),
                limit: 0,
            ).string();
        }
        catch InvalidRegexReplacementLimit.limit(limit) {
            limit.string();
        },
        "0"
    );
}

test "a broken template is refused with its offset" {
    test.is(
        try {
            RegexSubstitution(
                origin: "ab",
                regex: Regex("(a)"),
                replacing: ExpandedRegexReplacement("${first"),
            ).string();
        }
        catch InvalidRegexReplacement.located(offset, message) {
            "offset " + offset.string();
        },
        "offset 0"
    );
}
