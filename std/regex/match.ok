module regex/match v1.0.0;

import "regex/range" take RegexRange;
import "strings/parse" take Number, InvalidInteger;
import "runtime/regex" take RegexMatchState, regex_match_capture_count, regex_match_capture_name,
    regex_match_capture_index, regex_match_capture_span;

// RegexMatching is the observable surface shared by mandatory search results
// and matches yielded by RegexMatches. Implementations are immutable:
//
//     let found = FirstRegexMatch("id=42", Regex("id=(?<id>\\d+)"));
//     found.text();             // "id=42"
//     found.capture(0).text();  // "id=42", the complete match
//     found.group("id").text(); // "42"
//     found.captures().size();  // 1; capture zero is not duplicated
//
// An optional group still has a RegexCapture. matched() is false when that
// group did not participate; text() and range() then throw
// UnmatchedRegexCapture instead of inventing empty text or a fake range.
//
// Named groups also read like json values (#217):
//
//     let date = FirstRegexMatch("due 2026-11", Regex("(?<year>\\d{4})-(?<month>\\d{2})(-(?<day>\\d{2}))?"));
//     date.int("year");                     // 2026
//     date.text("month");                   // "11"
//     date.maybe("day").text() else "";     // "": the group took no part
role RegexMatching {
    text() is string;
    range() is RegexRange;
    capture(index is int) is RegexCapture;
    group(name is string) is RegexCapture;
    captures() is @RegexCapture;
    text(name is string) is string;
    int(name is string) is int;
    maybe(name is string) is RegexMaybeValue;
}

// The constructor requires an opaque RegexMatchState. Application code cannot
// manufacture that state; regex/search is its only public producer.
object RegexMatch does RegexMatching {
    has source is string;
    has state is RegexMatchState;

    RegexMatch(origin is string, state is RegexMatchState) {
        source = origin;
        self.state = state;
    }

    text() is string {
        self.capture(0).text();
    }

    range() is RegexRange {
        self.capture(0).range();
    }

    capture(index is int) is RegexCapture {
        let count = regex_match_capture_count(state);
        confirm index >= 0 && index <= count
            else throw MissingRegexCapture.index(index);
        RegexCapture(
            origin: source,
            state: state,
            index: index,
            name: regex_match_capture_name(state, index),
        );
    }

    group(name is string) is RegexCapture {
        let index = regex_match_capture_index(state, name);
        confirm index >= 0 else throw MissingRegexGroup.name(name);
        RegexCapture(origin: source, state: state, index: index, name: name);
    }

    captures() is @RegexCapture {
        let count = regex_match_capture_count(state);
        let values is @RegexCapture = (1..count + 1).map() -> index {
            self.capture(index);
        };
        values;
    }

    // The text of a named group: found.text("month"). A name the pattern does
    // not have is MissingRegexGroup; a group that took no part in the match is
    // UnmatchedRegexCapture.
    text(name is string) is string {
        self.group(name).text();
    }

    // A named group as an integer: found.int("year"). Text that is not one is
    // InvalidRegexGroupValue, naming the group and the text.
    int(name is string) is int {
        let capture = self.group(name);
        match self.maybe(name).int() {
            case Maybe.some(found) {
                found;
            }
            else {
                throw UnmatchedRegexCapture.index(capture::Group::index);
            }
        }
    }

    // A named group that may have taken no part in the match:
    // found.maybe("day").text() else "".
    maybe(name is string) is RegexMaybeValue {
        let capture = self.group(name);
        RegexMaybeValue(
            name: name,
            value: if capture.matched() {
                Maybe.some(capture.text());
            }
            else {
                Maybe<string>.none;
            },
        );
    }
}

// A group that may have taken no part in a match: its readers answer Maybe.
// Text that is there but is not what the reader expects is still
// InvalidRegexGroupValue.
object RegexMaybeValue {
    has name is string;
    has value is Maybe<string>;

    RegexMaybeValue(name is string, value is Maybe<string>) {
        self.name = name;
        self.value = value;
    }

    text() is Maybe<string> {
        value;
    }

    int() is Maybe<int> {
        match value {
            case Maybe.some(text) {
                Maybe.some(try {
                    Number(text).int();
                }
                catch failure is InvalidInteger {
                    throw InvalidRegexGroupValue.named(name, text, "an integer");
                });
            }
            else {
                Maybe<int>.none;
            }
        }
    }
}

// Like RegexMatch, RegexCapture is constructible only with an opaque state.
object RegexCapture {
    has source is string;
    has state is RegexMatchState;
    has position is int;
    has label is string;

    RegexCapture(
        origin is string,
        state is RegexMatchState,
        index is int,
        name is string,
    ) {
        source = origin;
        self.state = state;
        position = index;
        label = name;
    }

    cap Group {
        index is int {
            position;
        }

        name is string {
            label;
        }
    }

    matched() is bool {
        self.span()["start"] >= 0;
    }

    text() is string {
        confirm self.matched() else throw UnmatchedRegexCapture.index(position);
        let span = self.span();
        source.slice(span["start"], span["end"]);
    }

    range() is RegexRange {
        confirm self.matched() else throw UnmatchedRegexCapture.index(position);
        let span = self.span();
        RegexRange(start: span["start"], end: span["end"]);
    }

    hidden span() is %string:int {
        regex_match_capture_span(state, position);
    }
}

enum MissingRegexCapture is Error = (index(index is int));

enum MissingRegexGroup is Error = (name(name is string));

enum UnmatchedRegexCapture is Error = (index(index is int));

// A named group whose text is not what its reader expects.
enum InvalidRegexGroupValue is Error = (named(name is string, value is string, expected is string));
