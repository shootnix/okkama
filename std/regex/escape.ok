module regex/escape v1.0.0;

// EscapedRegex converts arbitrary text into one literal Dialect 1 expression.
// The result remains literal even when RegexFlag.verbose is selected.
//
//     let literal = "price: $5.00";
//     let pattern = Regex(EscapedRegex(literal).string());
//     EntireRegexMatch(literal, pattern).text(); // "price: $5.00"

import "runtime/regex" take regex_escape;

object EscapedRegex {
    has source is string;

    EscapedRegex(origin is string) {
        source = origin;
    }

    string() is string {
        regex_escape(source);
    }
}

test "every metacharacter is escaped, letters are not" {
    test.is(EscapedRegex("price: $5.00 (a|b)*").string(), "price:\\ \\$5\\.00\\ \\(a\\|b\\)\\*");
    test.is(EscapedRegex("plain").string(), "plain");
    test.is(EscapedRegex("").string(), "");
}
