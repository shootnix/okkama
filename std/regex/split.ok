module regex/split v1.0.0;

// RegexParts is the collection itself. It does not wrap an array behind
// values(), and it does not materialize the complete split before traversal.
//
//     let fields = RegexParts(origin: "one, two;three", regex: Regex("[,;]\\s*"));
//     for fields -> field {
//         Stdout().writeln(field);
//     }
//
// An explicit limit counts separators, so a limit of 1 yields at most two
// fields. Empty leading, adjacent and trailing fields are retained.

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "regex/match" take RegexMatching;
import "regex/pattern" take Regex;
import "regex/search" take RegexMatches;

object RegexParts does Iterating<string> {
    has source is string;
    has pattern is Regex;
    has maximum is int;

    RegexParts(origin is string, regex is Regex) {
        source = origin;
        pattern = regex;
        maximum = -1;
    }

    RegexParts(origin is string, regex is Regex, limit is int) {
        confirm limit > 0 else throw InvalidRegexSplitLimit.limit(limit);
        source = origin;
        pattern = regex;
        maximum = limit;
    }

    cursor() is Cursor<string> {
        RegexPartsCursor(
            origin: source,
            separators: RegexMatches(origin: source, regex: pattern).cursor(),
            offset: 0,
            remaining: maximum,
            final: false,
        );
    }
}

hidden object RegexPartsCursor does Cursor<string> {
    has source is string;
    has separators is Cursor<RegexMatching>;
    has offset is int;
    has remaining is int;
    has final is bool;

    RegexPartsCursor(
        origin is string,
        separators is Cursor<RegexMatching>,
        offset is int,
        remaining is int,
        final is bool,
    ) {
        source = origin;
        self.separators = separators;
        self.offset = offset;
        self.remaining = remaining;
        self.final = final;
    }

    available() is bool {
        !final;
    }

    item() is string {
        confirm self.available() else throw IterationEnded.ended;
        if self.separated() {
            source.slice(offset, separators.item().range()::Bounds::start);
        }
        else {
            source.slice(offset, source.length());
        }
    }

    successor() is Cursor<string> {
        confirm self.available() else throw IterationEnded.ended;
        if self.separated() {
            RegexPartsCursor(
                origin: source,
                separators: separators.successor(),
                offset: separators.item().range()::Bounds::end,
                remaining: if remaining < 0 {
                    -1;
                }
                else {
                    remaining - 1;
                },
                final: false,
            );
        }
        else {
            RegexPartsCursor(
                origin: source,
                separators: separators,
                offset: offset,
                remaining: remaining,
                final: true,
            );
        }
    }

    hidden separated() is bool {
        remaining != 0 && separators.available();
    }
}

enum InvalidRegexSplitLimit is Error = (limit(limit is int));

test "parts keep empty fields and honour a limit" {
    let text = (parts is Iterating<string>) is string {
        parts.map() -> part {
            "[" + part + "]";
        }.join("");
    };
    test.is(text(RegexParts(origin: ",a,,b,", regex: Regex(","))), "[][a][][b][]");
    test.is(
        text(RegexParts(origin: "one, two;three", regex: Regex("[,;]\\s*"))),
        "[one][two][three]"
    );
    test.is(text(RegexParts(origin: "a,b,c", regex: Regex(","), limit: 1)), "[a][b,c]");
    test.is(text(RegexParts(origin: "abc", regex: Regex(","))), "[abc]");
    test.is(text(RegexParts(origin: "", regex: Regex(","))), "[]");
    test.is(
        try {
            text(RegexParts(origin: "a,b", regex: Regex(","), limit: 0));
        }
        catch InvalidRegexSplitLimit.limit(limit) {
            "limit " + limit.string();
        },
        "limit 0"
    );
}

test "a regex splits the way RegexParts does" {
    for [
        [",", ",a,,b,"],
        ["[,;]\\s*", "one, two;three"],
        [",", "abc"],
        [",", ""],
        ["x*", "abc"],
        ["\\s*", "a b"],
        ["😀", "a😀😀b"],
    ] -> pair {
        let regex = Regex(pair[0]);
        let eager = regex.parts(pair[1]).map() -> part {
            "[" + part + "]";
        }.join("");
        let lazy = RegexParts(origin: pair[1], regex: regex).map() -> part {
            "[" + part + "]";
        }.join("");
        test.is(eager, lazy);
    }
}
