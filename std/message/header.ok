module message/header v1.0.0;

// Header fields of Internet messages (RFC 5322): mail and MIME parts use them.
//
//     let fields = MessageHeaders(
//         MessageHeader(name: MessageHeaderName("Subject"), value: "Hello"),
//         MessageHeader(name: MessageHeaderName("To"), value: "grace@example.test"),
//     );
//     fields.first("subject");                        // "Hello": names ignore case
//     RenderedMessageHeaders(fields).bytes();         // "Subject: Hello\r\n…"
//
// Names are printable ASCII without `:` and match without regard to case;
// values keep their spelling. By default 1024 fields and 1 MiB rendered.

import "compare" take Comparing, Order;
import "collections/sequence" take Sequencing;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "io/buffer" take ByteBuffer;
import "error" take InvalidArgument;

// A field name, matched without regard to case.
object MessageHeaderName does Comparing<MessageHeaderName> {
    has spelling is string;

    // Checks origin; InvalidMessageHeader when it is empty or not a field name.
    MessageHeaderName(origin is string) {
        confirm origin.length() > 0 else throw InvalidMessageHeader.located(0, "empty field name");
        let bytes = Utf8Encoded(origin).bytes();
        for (0..bytes.size()) -> index {
            let value = bytes[index].int();
            confirm value >= 33 && value <= 126 && value != 58
                else throw InvalidMessageHeader.located(index, "invalid field name");
        }
        spelling = origin;
    }

    // The name as spelled.
    string() is string {
        spelling;
    }

    // Names compare without regard to ASCII case.
    order(other is MessageHeaderName) is Order {
        self.key().order(MessageHeaderKey(origin: other.string()).string());
    }

    hidden key() is string {
        once let folded = MessageHeaderKey(origin: spelling).string();
        folded;
    }
}

// A field name with ASCII letters folded to lowercase.
hidden object MessageHeaderKey {
    has origin is string;

    MessageHeaderKey(:origin);

    string() is string {
        let folded is @byte = Utf8Encoded(origin).bytes().map() -> octet {
            let value = octet.int();
            if value >= 65 && value <= 90 {
                (value + 32).byte();
            }
            else {
                octet;
            }
        };
        Utf8Decoded(folded).string();
    }
}

// One field: a name and a value.
object MessageHeader {
    has label is MessageHeaderName;
    has text is string;

    // name with value, its folded lines joined; InvalidMessageHeader for a line
    // break that is not folding.
    MessageHeader(name is MessageHeaderName, value is string) {
        label = name;
        text = UnfoldedMessageHeader(value).string();
    }

    // The name.
    name() is MessageHeaderName {
        label;
    }

    // The value.
    value() is string {
        text;
    }
}

// The fields of a message, in order.
object MessageHeaders {
    has origin is @MessageHeader;
    has maximum is int;

    // The fields, at most 1024.
    MessageHeaders(entries is Sequencing<MessageHeader>) {
        maximum = 1024;
        origin = MessageHeaderSnapshot(origin: entries, maximum: 1024).entries();
    }

    // The same, one argument per part: MessageHeaders(a, b).
    MessageHeaders(entries is ...MessageHeader) {
        let listed is @MessageHeader = entries...;
        maximum = 1024;
        origin = MessageHeaderSnapshot(origin: listed, maximum: 1024).entries();
    }

    // The fields, at most maximum_entries.
    MessageHeaders(entries is Sequencing<MessageHeader>, maximum_entries is int) {
        maximum = maximum_entries;
        origin = MessageHeaderSnapshot(origin: entries, maximum: maximum_entries).entries();
    }

    // Every field.
    entries() is Sequencing<MessageHeader> {
        origin;
    }

    // Whether a field has the name.
    membership(name is MessageHeaderName) is bool {
        origin.reduce(false) -> found, entry {
            found || entry.name().order(name) == Order.equal;
        };
    }

    // The value of the first field of the name; MissingMessageHeader when none.
    first(name is MessageHeaderName) is string {
        for origin -> entry {
            if entry.name().order(name) == Order.equal {
                return entry.value();
            }
        }
        throw MissingMessageHeader.name(name.string());
    }

    // The values of every field of the name.
    values(name is MessageHeaderName) is Sequencing<string> {
        let matching is @MessageHeader = origin.filter() -> entry {
            entry.name().order(name) == Order.equal;
        };
        let values is @string = matching.map() -> entry {
            entry.value();
        };
        values;
    }

    // These fields and entry.
    addition(entry is MessageHeader) is MessageHeaders {
        confirm origin.size() < maximum else throw MessageHeaderLimitExceeded.kind("entries");
        let entries is @MessageHeader = origin + [entry];
        MessageHeaders(entries: entries, maximum_entries: maximum);
    }

    // By name as text: headers.first("Subject").
    membership(name is string) is bool {
        self.membership(MessageHeaderName(name));
    }

    // The same by name text.
    first(name is string) is string {
        self.first(MessageHeaderName(name));
    }

    // The same by name text.
    values(name is string) is Sequencing<string> {
        self.values(MessageHeaderName(name));
    }
}

// Fields as the bytes of a header section.
object RenderedMessageHeaders {
    has origin is MessageHeaders;
    has maximum is int;

    // origin, at most 1 MiB.
    RenderedMessageHeaders(origin is MessageHeaders) {
        self.origin = origin;
        maximum = 1048576;
    }

    // origin, at most maximum_bytes.
    RenderedMessageHeaders(origin is MessageHeaders, maximum_bytes is int) {
        confirm maximum_bytes >= 0
            else throw InvalidArgument.because("header output limit must be nonnegative");
        self.origin = origin;
        maximum = maximum_bytes;
    }

    // Each field as `Name: value` and CRLF.
    bytes() is @byte {
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let output = MessageHeaderOutput(buffer: buffer, maximum: maximum);
        let entries = origin.entries();
        for (0..entries.size()) -> index {
            FoldedMessageHeader(entries.item(index)).print(output);
        }
        buffer.content().bytes();
    }
}

// A field that is not valid; offset and reason say where and why.
enum InvalidMessageHeader is Error = (located(offset is int, reason is string));

// No field has that name.
enum MissingMessageHeader is Error = (name(name is string));

// Fields over a limit; kind says which.
enum MessageHeaderLimitExceeded is Error = (kind(kind is string));

// Importable implementation collaborators; no HTTP grammar or field-specific
// mail address/date/MIME parsing is implied by this generic layer.
hidden object UnfoldedMessageHeader {
    has origin is string;

    UnfoldedMessageHeader(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let writer = buffer.writing();
        let consumed = (0..origin.length()).reduce(0) -> after, index {
            if index < after {
                after;
            }
            else {
                let scalar = origin.slice(index, index + 1);
                if scalar == "\r" {
                    confirm origin.length() - index >= 3
                        && origin.slice(index + 1, index + 2) == "\n"
                        && (origin.slice(index + 2, index + 3) == " "
                        || origin.slice(index + 2, index + 3) == "\t")
                        else throw InvalidMessageHeader.located(index, "invalid folded line break");
                    index + 2;
                }
                else {
                    let bytes = Utf8Encoded(scalar).bytes();
                    let value = bytes[0].int();
                    confirm bytes.size() == 1 && (value == 9 || (value >= 32 && value <= 126))
                        else throw InvalidMessageHeader.located(
                            index,
                            "invalid field value character"
                        );
                    writer.write(bytes);
                    index + 1;
                }
            }
        };
        Utf8Decoded(buffer.content().bytes()).string();
    }
}

hidden object MessageHeaderSnapshot {
    has origin is Sequencing<MessageHeader>;
    has maximum is int;

    MessageHeaderSnapshot(origin is Sequencing<MessageHeader>, maximum is int) {
        confirm maximum >= 0
            else throw InvalidArgument.because("header entry limit must be nonnegative");
        self.origin = origin;
        self.maximum = maximum;
    }

    entries() is @MessageHeader {
        let size = origin.size();
        confirm size >= 0
            else throw InvalidArgument.because("header source size must be nonnegative");
        confirm size <= maximum else throw MessageHeaderLimitExceeded.kind("entries");
        let entries is @MessageHeader = (0..size).map() -> index {
            origin.item(index);
        };
        entries;
    }
}

hidden object MessageHeaderOutput {
    has buffer is ByteBuffer;
    has maximum is int;

    MessageHeaderOutput(buffer is ByteBuffer, maximum is int) {
        self.buffer = buffer;
        self.maximum = maximum;
    }

    line(text is string) is void {
        confirm text.length() <= 998
            else throw InvalidMessageHeader.located(0, "physical line exceeds 998 octets");
        let bytes = Utf8Encoded(text + "\r\n").bytes();
        confirm bytes.size() <= maximum - buffer.content().size()
            else throw MessageHeaderLimitExceeded.kind("bytes");
        buffer.writing().write(bytes);
    }
}

hidden object MessageHeaderLine {
    has start, boundary is int;

    MessageHeaderLine() {
        start = 0;
        boundary = 0;
    }

    start() is int {
        start;
    }

    boundary() is int {
        boundary;
    }

    following(start is int, boundary is int) is ^MessageHeaderLine {
        ^start = start;
        ^boundary = boundary;
    }
}

hidden object FoldedMessageHeader {
    has origin is MessageHeader;

    FoldedMessageHeader(origin is MessageHeader) {
        self.origin = origin;
    }

    print(output is MessageHeaderOutput) is void {
        let text = origin.name().string() + ": " + origin.value();
        let boundaries = (0..text.length() + 1).filter() -> index {
            index == text.length()
                || (index > 0
                && self.whitespace(text.slice(index, index + 1))
                && !self.whitespace(text.slice(index - 1, index))
                && text.slice(index - 1, index) != "\\");
        };
        let line = MessageHeaderLine();
        for boundaries -> end {
            if end - line.start() > 78 && line.boundary() > line.start() {
                output.line(text.slice(line.start(), line.boundary()));
                line = line.following(line.boundary(), end);
            }
            else {
                line = line.following(line.start(), end);
            }
            confirm end - line.start() <= 998
                else throw InvalidMessageHeader.located(
                    line.start(),
                    "unfoldable field exceeds 998 octets"
                );
        }
        output.line(text.slice(line.start(), text.length()));
    }

    hidden whitespace(text is string) is bool {
        text == " " || text == "\t";
    }
}

test "field lookup ignores case without losing spelling" {
    let headers = MessageHeaders(MessageHeader(name: MessageHeaderName("Subject"), value: "hello"));
    test.is(headers.first(MessageHeaderName("SUBJECT")), "hello");
    test.is(headers.entries().item(0).name().string(), "Subject");
}

test "headers are read by name as text, case-insensitively" {
    let fields = MessageHeaders(
        MessageHeader(name: MessageHeaderName("Subject"), value: "Lunch?"),
        MessageHeader(name: MessageHeaderName("Received"), value: "a"),
        MessageHeader(name: MessageHeaderName("Received"), value: "b"),
    );
    test.is(fields.first("subject"), "Lunch?");
    test.is(fields.values("Received").size(), 2);
    test.is(fields.membership("Cc"), false);
}
