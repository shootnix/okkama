module compression/zstd v1.0.0;

import "compression/internal/codec" take NativeCompressor, NativeDecompressor, NativeCompressed,
    NativeDecompressed;
import "compression/state" take Compressing, Decompressing, CompressionLimitExceeded,
    InvalidCompressedData, UnsupportedCompression;
import "compression/read" take CompressedReading, DecompressedReading;
import "io/stream" take Reading;
import "io/buffer" take ByteBuffer;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "async/atomic" take Atomic;
import "error" take InvalidArgument;

// zstd (RFC 8878): fast compression with ratios near gzip's best, or better,
// as in .zst files and Content-Encoding: zstd (#184). One frame per stream,
// with a content checksum.
//
//     let packed = ZstdCompressed(data).bytes();
//     let data = ZstdDecompressed(origin: packed, limit: 10485760).bytes();
//
// A stream goes through the Compressing and Decompressing roles, for example
// with compression/read:
//
//     let packed = CompressedReading(origin: input, compressor: ZstdCompressor());
//
// Decompression is bounded: limit is the most bytes it may produce, past which
// it throws CompressionLimitExceeded; damaged data is InvalidCompressedData.

// Bytes compressed whole; level 1 (fastest) to 22 (smallest), 3 unless told.
object ZstdCompressed {
    has origin is @byte;
    has level is int;

    // Compresses origin whole as zstd, at level 1 to 22 (3 unless told).
    ZstdCompressed(origin is @byte, level is int = 3) {
        self.origin = origin;
        self.level = level;
    }

    // The compressed bytes.
    bytes() is @byte {
        NativeCompressed(origin: origin, format: "zstd", level: level).bytes();
    }
}

// Compressed bytes decompressed whole, at most limit bytes of them: one frame,
// whose window may be at most 128 MiB. Bytes after the end of the frame are
// InvalidCompressedData.
object ZstdDecompressed {
    has origin is @byte;
    has limit is int;

    // Decompresses origin whole, producing at most limit bytes.
    ZstdDecompressed(origin is @byte, limit is int) {
        self.origin = origin;
        self.limit = limit;
    }

    // The decompressed bytes; more than limit is CompressionLimitExceeded,
    // damaged data InvalidCompressedData.
    bytes() is @byte {
        NativeDecompressed(origin: origin, format: "zstd", limit: limit).bytes();
    }
}

// A stream compressor: write, then finish; output() takes what is ready.
object ZstdCompressor does Compressing {
    has codec is NativeCompressor;

    // A zstd stream compressor at level 1 to 22 (3 unless told).
    ZstdCompressor(level is int = 3) {
        codec = NativeCompressor(format: "zstd", level: level);
    }

    // Feeds origin to the codec; output may come now or later.
    write(origin is @byte) is void {
        codec.write(origin);
    }

    // The output ready so far, taken out of the codec.
    output() is Reading {
        codec.output();
    }

    // Ends the input; the rest of the output becomes ready.
    finish() is void {
        codec.finish();
    }

    // Whether finish() was called.
    finished() is bool {
        codec.finished();
    }

    // Drops the codec and any output not taken.
    close() is void {
        codec.close();
    }

    // Whether it is closed.
    closed() is bool {
        codec.closed();
    }
}

// A stream decompressor of at most limit bytes; remainder() gives the bytes
// after the end of the stream.
object ZstdDecompressor does Decompressing {
    has codec is NativeDecompressor;

    // A zstd stream decompressor producing at most limit bytes in all.
    ZstdDecompressor(limit is int) {
        codec = NativeDecompressor(format: "zstd", limit: limit);
    }

    // Feeds origin to the codec; output may come now or later.
    write(origin is @byte) is void {
        codec.write(origin);
    }

    // The output ready so far, taken out of the codec.
    output() is Reading {
        codec.output();
    }

    // Ends the input; the rest of the output becomes ready.
    finish() is void {
        codec.finish();
    }

    // Whether finish() was called.
    finished() is bool {
        codec.finished();
    }

    // Drops the codec and any output not taken.
    close() is void {
        codec.close();
    }

    // Whether it is closed.
    closed() is bool {
        codec.closed();
    }

    // The bytes that came after the end of the compressed stream.
    remainder() is @byte {
        codec.remainder();
    }
}

// Whether this engine has a zstd codec, for the tests below.
hidden object ZstdTestEngine {
    ZstdTestEngine() {}

    codec() is bool {
        try {
            ZstdCompressor();
            true;
        }
        catch failure is UnsupportedCompression {
            false;
        };
    }
}

test "zstd round-trips text whole and by pieces" {
    let text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. ".repeat(200);
    let data = Utf8Encoded(text).bytes();
    if ZstdTestEngine().codec() {
        let packed = ZstdCompressed(data).bytes();
        test.ok(packed.size() * 4 < data.size());
        test.is(
            Utf8Decoded(ZstdDecompressed(origin: packed, limit: data.size()).bytes()).string(),
            text
        );
        test.is(ZstdDecompressed(origin: ZstdCompressed([]).bytes(), limit: 1).bytes().size(), 0);
        let codec = ZstdDecompressor(limit: data.size());
        let half = (packed.size() / 2).int();
        codec.write(packed.slice(0, half));
        codec.write(packed.slice(half, packed.size()) + Utf8Encoded("after").bytes());
        codec.finish();
        test.is(Utf8Decoded(codec.output().bytes(data.size() + 1)).string(), text);
        test.is(Utf8Decoded(codec.remainder()).string(), "after");
        codec.close();
        let stream = DecompressedReading(
            origin: CompressedReading(
                origin: ByteBuffer(data).reading(),
                compressor: ZstdCompressor(level: 22)
            ),
            decompressor: ZstdDecompressor(limit: data.size())
        );
        let empty is @byte = [];
        let unpacked = Atomic(empty);
        loop {
            let chunk = stream.bytes(4096);
            if chunk.size() == 0 {
                last;
            }
            unpacked.replace(unpacked.value() + chunk);
        }
        test.is(Utf8Decoded(unpacked.value()).string(), text);
    }
    else {
        test.throws(UnsupportedCompression) {
            ZstdCompressed(data).bytes();
        };
        test.throws(UnsupportedCompression) {
            ZstdDecompressor(limit: 10);
        };
    }
}

test "zstd refuses damaged data, output past its limit and a level out of range" {
    test.throws(InvalidArgument) {
        ZstdCompressed(origin: [], level: 23).bytes();
    };
    if ZstdTestEngine().codec() {
        let data = Utf8Encoded("tea ".repeat(1000)).bytes();
        let packed = ZstdCompressed(data).bytes();
        test.throws(CompressionLimitExceeded) {
            ZstdDecompressed(origin: packed, limit: 100).bytes();
        };
        test.throws(InvalidCompressedData) {
            ZstdDecompressed(origin: packed.slice(0, packed.size() - 3), limit: data.size()).bytes();
        };
        test.throws(InvalidCompressedData) {
            ZstdDecompressed(origin: packed + [0.byte()], limit: data.size()).bytes();
        };
        test.throws(InvalidCompressedData) {
            ZstdDecompressed(origin: Utf8Encoded("not zstd at all").bytes(), limit: 100).bytes();
        };
    }
}

test "zstd reads what the reference tool wrote" {
    if ZstdTestEngine().codec() {
        // `printf 'hello, world' | zstd` (zstd 1.5.7).
        let packed is @byte = [
            40.byte(),
            181.byte(),
            47.byte(),
            253.byte(),
            4.byte(),
            88.byte(),
            97.byte(),
            0.byte(),
            0.byte(),
            104.byte(),
            101.byte(),
            108.byte(),
            108.byte(),
            111.byte(),
            44.byte(),
            32.byte(),
            119.byte(),
            111.byte(),
            114.byte(),
            108.byte(),
            100.byte(),
            66.byte(),
            18.byte(),
            27.byte(),
            109.byte()
        ];
        test.is(
            Utf8Decoded(ZstdDecompressed(origin: packed, limit: 64).bytes()).string(),
            "hello, world"
        );
    }
}
