module compression/state v1.0.0;

// Stateful streaming codecs: writes may produce no output until a later write
// or finish(). finish() flushes pending output and marks successful completion.
// Writing (including empty input) or finishing after completion is InvalidState.
// close() is idempotent, discards unclaimed output and never implies finish().
// Only close()/closed() remain valid after close. Concrete owners need destroy.
// A data/codec failure permits only closing; invalid arguments do not consume.
//
// output() TRANSFERS currently available bytes as an independent finite Reading.
// Its EOF is permanent: it is a batch, not the live codec output queue. Empty
// batches before finished() do not mean the codec reached EOF. Drain/retain each
// batch before dropping it; subsequent output() calls transfer only new bytes.
// A transferred batch survives closing its codec and owns its own lifetime.
//
//     codec.write([byte(1), byte(2)]);
//     codec.finish();
//     let batch = codec.output();
//     batch.bytes(1); // drain the remainder before dropping this batch
//     codec.close();
//
// The role fakes echo bytes; they are not codecs. The compressor delays output
// until finish. The decompressor emits immediately with an eight-byte cumulative
// limit and empty remainder after finish. Each fake has its own typed state.

import "async/atomic" take Atomic;
import "io/stream" take Reading, Closing, InvalidReadLimit;
import "io/buffer" take ByteBuffer;
import "error" take InvalidArgument, InvalidState;

// A stream compressor: write pieces, take output, finish.
role Compressing {
    // Feeds origin to the codec; output may come now or later.
    write(origin is @byte) is void;
    // The output ready so far, taken out of the codec.
    output() is Reading;
    // Ends the input; the rest of the output becomes ready.
    finish() is void;
    // Whether finish() was called.
    finished() is bool;
    // Drops the codec and any output not taken.
    close() is void;
    // Whether it is closed.
    closed() is bool;

    fake {
        has stored_pending is Atomic<@byte> = Atomic(@byte());
        has stored_ready is Atomic<@byte> = Atomic(@byte());
        has stored_done is Atomic<bool> = Atomic(false);
        has stored_closed is Atomic<bool> = Atomic(false);

        write(origin is @byte) is void {
            confirm !self.closed() && !stored_done.value()
                else throw InvalidState.because("codec is not writable");
            let before is @byte = stored_pending.value();
            let joined is @byte = before + origin;
            stored_pending.replace(joined);
        }

        output() is Reading {
            confirm !self.closed()
                else throw InvalidState.because("codec output is unavailable");
            let ready is @byte = stored_ready.value();
            let empty is @byte = [];
            stored_ready.replace(empty);
            CompressionOutput(ready);
        }

        finish() is void {
            confirm !self.closed() && !stored_done.value()
                else throw InvalidState.because("codec cannot finish");
            let pending is @byte = stored_pending.value();
            stored_ready.replace(pending);
            stored_pending.replace(@byte());
            stored_done.replace(true);
        }

        finished() is bool {
            confirm !self.closed()
                else throw InvalidState.because("codec completion is unavailable");
            stored_done.value();
        }

        close() is void {
            stored_pending.replace(@byte());
            stored_ready.replace(@byte());
            stored_done.replace(false);
            stored_closed.replace(true);
        }

        closed() is bool {
            stored_closed.value();
        }
    }
}

// A stream decompressor: write pieces, take output, finish.
role Decompressing {
    // Feeds origin to the codec; output may come now or later.
    write(origin is @byte) is void;
    // The output ready so far, taken out of the codec.
    output() is Reading;
    // Ends the input; the rest of the output becomes ready.
    finish() is void;
    // Whether finish() was called.
    finished() is bool;
    // Drops the codec and any output not taken.
    close() is void;
    // Whether it is closed.
    closed() is bool;
    // The bytes that came after the end of the compressed stream.
    remainder() is @byte;

    fake {
        has stored_budget is Atomic<DecompressionBudget> = Atomic(DecompressionBudget(8));
        has stored_ready is Atomic<@byte> = Atomic(@byte());
        has stored_failed is Atomic<bool> = Atomic(false);
        has stored_done is Atomic<bool> = Atomic(false);
        has stored_closed is Atomic<bool> = Atomic(false);

        write(origin is @byte) is void {
            confirm !self.closed() && !stored_failed.value() && !stored_done.value()
                else throw InvalidState.because("codec is not writable");
            let budget is DecompressionBudget = stored_budget.value();
            let spent = try {
                let updated = budget.spent(origin.size());
                updated;
            }
            catch error is CompressionLimitExceeded {
                stored_failed.replace(true);
                throw error;
            };
            stored_budget.replace(spent);
            let before is @byte = stored_ready.value();
            let joined is @byte = before + origin;
            stored_ready.replace(joined);
        }

        output() is Reading {
            confirm !self.closed() && !stored_failed.value()
                else throw InvalidState.because("codec output is unavailable");
            let ready is @byte = stored_ready.value();
            let empty is @byte = [];
            stored_ready.replace(empty);
            CompressionOutput(ready);
        }

        finish() is void {
            confirm !self.closed() && !stored_failed.value() && !stored_done.value()
                else throw InvalidState.because("codec cannot finish");
            stored_done.replace(true);
        }

        finished() is bool {
            confirm !self.closed() && !stored_failed.value()
                else throw InvalidState.because("codec completion is unavailable");
            stored_done.value();
        }

        close() is void {
            stored_budget.replace(DecompressionBudget(8));
            stored_ready.replace(@byte());
            stored_failed.replace(false);
            stored_done.replace(false);
            stored_closed.replace(true);
        }

        closed() is bool {
            stored_closed.value();
        }

        remainder() is @byte {
            confirm self.finished() else throw InvalidState.because("codec has not finished");
            [];
        }
    }
}

// Finite owned output batch. Reading requires limit > 0, is consuming, and
// stays at EOF once empty. Invalid limits do not consume bytes. close()/destroy
// release the private buffer; close is idempotent and reads after close fail.
// Input and returned byte arrays are independent of this resource's lifetime.
object CompressionOutput does Reading, Closing {
    has buffer is ByteBuffer;

    // A batch of output bytes.
    CompressionOutput(origin is @byte) {
        buffer = ByteBuffer(origin);
    }

    // At most limit of the batch, consumed; [] at its end.
    bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        confirm !self.closed() else throw InvalidState.because("compression output is closed");
        buffer.reading().bytes(limit);
    }

    // Whether it is closed.
    closed() is bool {
        buffer.closing().closed();
    }

    // Drops the batch.
    close() is void {
        buffer.closing().close();
    }

    destroy {
        self.close();
    }
}

// Immutable cumulative output allowance. The codec retains each spent() result;
// reading output must never reset it. Maximum is positive, amount nonnegative.
// Spending checks remaining capacity before subtraction (no overflowing sum).
// Zero spending succeeds; excess/negative spending leaves the receiver intact.
// Example: DecompressionBudget(8).spent(3).remaining() == 5. No owned resources.
object DecompressionBudget {
    has maximum is int;
    has available is int;

    // maximum bytes to produce; it must be positive.
    DecompressionBudget(maximum is int) {
        confirm maximum > 0 else throw InvalidCompressionLimit.maximum(maximum);
        self.maximum = maximum;
        available = maximum;
    }

    // The bytes still allowed.
    remaining() is int {
        available;
    }

    // The budget after amount more bytes; CompressionLimitExceeded past it.
    spent(amount is int) is ^DecompressionBudget {
        confirm amount >= 0
            else throw InvalidArgument.because("decompression output size must not be negative");
        confirm amount <= available else throw CompressionLimitExceeded.maximum(maximum);
        ^available = available - amount;
    }
}

// Stable diagnostics; retain the configured maximum without leaking host text.
enum CompressionLimitExceeded is Error = (maximum(maximum is int));

// Compressed data a decompressor cannot read: not of its format, damaged, a
// checksum that does not match, or a stream cut short.
enum InvalidCompressedData is Error = (because(reason is string));

// A limit below one.
enum InvalidCompressionLimit is Error = (maximum(maximum is int));

// A format the engine has no codec for (#184).
enum UnsupportedCompression is Error = (format(name is string));

test "compression output is finite consuming and independently closable" {
    let output = CompressionOutput([byte(0), byte(255)]);
    let first = output.bytes(1);
    test.is(first, [byte(0)]);
    test.is(output.bytes(8), [byte(255)]);
    test.is(output.bytes(1).size(), 0);
    test.is(output.bytes(1).size(), 0);
    output.close();
    output.close();
    test.ok(output.closed());
    test.is(first, [byte(0)]);
    test.ok(try {
        output.bytes(1);
        false;
    }
    catch e is Error {
        true;
    });
}

test "decompression budget is cumulative checked and immutable" {
    let initial = DecompressionBudget(8);
    let first = initial.spent(3);
    let exhausted = first.spent(5);
    test.is(initial.remaining(), 8);
    test.is(first.remaining(), 5);
    test.is(exhausted.remaining(), 0);
    test.is(exhausted.spent(0).remaining(), 0);
    test.is(
        try {
            let rejected = exhausted.spent(1);
            [rejected];
            -1;
        }
        catch CompressionLimitExceeded.maximum(maximum) {
            maximum;
        },
        8
    );
    test.ok(try {
        DecompressionBudget(0);
        false;
    }
    catch e is InvalidCompressionLimit {
        true;
    });
}

test "compression fake delays output without confusing batch EOF" {
    let codec = Compressing.fake();
    codec.write([byte(1)]);
    let early = codec.output();
    codec.write([byte(2)]);
    codec.finish();
    let final = codec.output();
    test.ok(codec.finished());
    test.is(early.bytes(8).size(), 0);
    test.is(final.bytes(1), [byte(1)]);
    codec.close();
    test.is(final.bytes(8), [byte(2)]);
    test.ok(try {
        codec.finish();
        false;
    }
    catch e is Error {
        true;
    });
}

test "decompression fake output does not replenish cumulative budget" {
    let codec = Decompressing.fake();
    codec.write([byte(1), byte(2), byte(3), byte(4)]);
    let first = codec.output();
    codec.write([byte(5), byte(6), byte(7), byte(8)]);
    let second = codec.output();
    test.is(
        try {
            codec.write([byte(9)]);
            -1;
        }
        catch CompressionLimitExceeded.maximum(maximum) {
            maximum;
        },
        8
    );
    test.ok(try {
        codec.output();
        false;
    }
    catch e is Error {
        true;
    });
    codec.close();
    codec.close();
    test.ok(codec.closed());
    test.is(first.bytes(8).size(), 4);
    test.is(second.bytes(8).size(), 4);
}

test "codec fakes finish empty input and remain isolated" {
    let a = Compressing.fake();
    let b = Compressing.fake();
    a.finish();
    test.ok(a.finished());
    test.ok(!b.finished());
    test.is(a.output().bytes(1).size(), 0);
    let d = Decompressing.fake();
    test.ok(try {
        d.remainder();
        false;
    }
    catch e is Error {
        true;
    });
    d.write([]);
    d.finish();
    test.is(d.remainder().size(), 0);
    test.ok(try {
        d.write([]);
        false;
    }
    catch e is Error {
        true;
    });
    a.close();
    b.close();
    d.close();
}
