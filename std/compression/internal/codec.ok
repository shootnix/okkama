module compression/internal/codec v1.0.0;

import "runtime/compression" take CodecState, codec_open, codec_write, codec_finish, codec_ended,
    codec_remainder;
import "compression/state" take Compressing, Decompressing, CompressionOutput,
    CompressionLimitExceeded, InvalidCompressionLimit, InvalidCompressedData,
    UnsupportedCompression;
import "io/stream" take Reading;
import "async/atomic" take Atomic;
import "error" take InvalidArgument, InvalidState;

// The codecs behind compression/gzip, compression/deflate, compression/zlib,
// compression/zstd and compression/brotli: the runtime's streaming codec of a
// format ("deflate", "zlib", "gzip", "zstd" or "brotli"), one object per
// stream. Output waits in the codec until output() takes it. An engine without
// a codec for the format throws UnsupportedCompression when one is made.

// The runtime compressor of one format; the format modules wrap it.
object NativeCompressor does Compressing {
    has state is CodecState;
    has pending is Atomic<@byte>;
    has done, shut is Atomic<bool>;

    // A compressor of format at level; UnsupportedCompression where the engine
    // lacks it.
    NativeCompressor(format is string, level is int) {
        CodecLevel(format: format, level: level).check();
        state = CodecOpening(format: format, compressing: true, level: level, limit: 1).state();
        let empty is @byte = [];
        pending = Atomic(empty);
        done = Atomic(false);
        shut = Atomic(false);
    }

    // Feeds origin to the codec; output may come now or later.
    write(origin is @byte) is void {
        confirm !shut.value() && !done.value()
            else throw InvalidState.because("codec is not writable");
        pending.replace(pending.value() + codec_write(state, origin));
    }

    // The output ready so far, taken out of the codec.
    output() is Reading {
        confirm !shut.value() else throw InvalidState.because("codec output is unavailable");
        let ready = pending.value();
        let empty is @byte = [];
        pending.replace(empty);
        CompressionOutput(ready);
    }

    // Ends the input; the rest of the output becomes ready.
    finish() is void {
        confirm !shut.value() && !done.value()
            else throw InvalidState.because("codec cannot finish");
        pending.replace(pending.value() + codec_finish(state));
        done.replace(true);
    }

    // Whether finish() was called.
    finished() is bool {
        confirm !shut.value() else throw InvalidState.because("codec completion is unavailable");
        done.value();
    }

    // Drops the codec and any output not taken.
    close() is void {
        shut.replace(true);
        let empty is @byte = [];
        pending.replace(empty);
    }

    // Whether it is closed.
    closed() is bool {
        shut.value();
    }
}

// The runtime decompressor of one format.
object NativeDecompressor does Decompressing {
    has state is CodecState;
    has limit is int;
    has pending is Atomic<@byte>;
    has done, shut, failed is Atomic<bool>;

    // A decompressor of format producing at most limit bytes.
    NativeDecompressor(format is string, limit is int) {
        confirm limit > 0 else throw InvalidCompressionLimit.maximum(limit);
        state = CodecOpening(format: format, compressing: false, level: 0, limit: limit).state();
        self.limit = limit;
        let empty is @byte = [];
        pending = Atomic(empty);
        done = Atomic(false);
        shut = Atomic(false);
        failed = Atomic(false);
    }

    // Feeds origin to the codec; output may come now or later.
    write(origin is @byte) is void {
        confirm !shut.value() && !done.value() && !failed.value()
            else throw InvalidState.because("codec is not writable");
        let produced = try {
            codec_write(state, origin);
        }
        catch failure is NativeFailure {
            failed.replace(true);
            throw CodecFailure(failure: failure, limit: limit).error();
        };
        pending.replace(pending.value() + produced);
    }

    // The output ready so far, taken out of the codec.
    output() is Reading {
        confirm !shut.value() && !failed.value()
            else throw InvalidState.because("codec output is unavailable");
        let ready = pending.value();
        let empty is @byte = [];
        pending.replace(empty);
        CompressionOutput(ready);
    }

    // Ends the input; the rest of the output becomes ready.
    finish() is void {
        confirm !shut.value() && !done.value() && !failed.value()
            else throw InvalidState.because("codec cannot finish");
        try {
            codec_finish(state);
        }
        catch failure is NativeFailure {
            failed.replace(true);
            throw CodecFailure(failure: failure, limit: limit).error();
        };
        done.replace(true);
    }

    // Whether finish() was called.
    finished() is bool {
        confirm !shut.value() && !failed.value()
            else throw InvalidState.because("codec completion is unavailable");
        done.value();
    }

    // Drops the codec and any output not taken.
    close() is void {
        shut.replace(true);
        let empty is @byte = [];
        pending.replace(empty);
    }

    // Whether it is closed.
    closed() is bool {
        shut.value();
    }

    // The bytes after the end of the compressed stream, once it has ended.
    remainder() is @byte {
        codec_remainder(state);
    }

    // Whether the end of the compressed stream has come.
    ended() is bool {
        codec_ended(state);
    }
}

// The levels a format takes: 0..9 for DEFLATE and its framings, 1..22 for
// zstd, 0..11 for Brotli.
hidden object CodecLevel {
    has format is string;
    has level is int;

    CodecLevel(format is string, level is int) {
        self.format = format;
        self.level = level;
    }

    check() is void {
        let low = if format == "zstd" {
            1;
        }
        else {
            0;
        };
        let high = if format == "zstd" {
            22;
        }
        else {
            if format == "brotli" {
                11;
            }
            else {
                9;
            };
        };
        confirm level >= low && level <= high
            else throw InvalidArgument.because(
                "compression level must be " + low.string() + ".." + high.string()
            );
    }
}

// The runtime codec for a format; UnsupportedCompression where the engine has
// none.
hidden object CodecOpening {
    has format is string;
    has compressing is bool;
    has level, limit is int;

    CodecOpening(format is string, compressing is bool, level is int, limit is int) {
        self.format = format;
        self.compressing = compressing;
        self.level = level;
        self.limit = limit;
    }

    state() is CodecState {
        try {
            codec_open(format, compressing, level, limit);
        }
        catch failure is NativeFailure {
            confirm failure.code() != "unsupported"
                else throw UnsupportedCompression.format(format);
            throw InvalidArgument.because(failure.text());
        };
    }
}

// The domain error of a failure of the runtime codec.
object CodecFailure {
    has failure is NativeFailure;
    has limit is int;

    // A runtime failure of a codec with its limit.
    CodecFailure(failure is NativeFailure, limit is int) {
        self.failure = failure;
        self.limit = limit;
    }

    // CompressionLimitExceeded or InvalidCompressedData.
    error() is Error {
        if failure.code() == "resource_exhausted" {
            return CompressionLimitExceeded.maximum(limit);
        }
        InvalidCompressedData.because(failure.text());
    }
}

// A whole value compressed in one go.
object NativeCompressed {
    has origin is @byte;
    has format is string;
    has level is int;

    // origin compressed whole as format at level.
    NativeCompressed(origin is @byte, format is string, level is int) {
        self.origin = origin;
        self.format = format;
        self.level = level;
    }

    // The compressed bytes.
    bytes() is @byte {
        CodecLevel(format: format, level: level).check();
        let state = CodecOpening(format: format, compressing: true, level: level, limit: 1).state();
        codec_write(state, origin) + codec_finish(state);
    }
}

// A whole compressed value decompressed in one go: the stream must end with the
// value, with nothing after it.
object NativeDecompressed {
    has origin is @byte;
    has format is string;
    has limit is int;

    // origin decompressed whole as format, at most limit bytes.
    NativeDecompressed(origin is @byte, format is string, limit is int) {
        self.origin = origin;
        self.format = format;
        self.limit = limit;
    }

    // The decompressed bytes; bytes after the stream are InvalidCompressedData.
    bytes() is @byte {
        let codec = NativeDecompressor(format: format, limit: limit);
        codec.write(origin);
        codec.finish();
        confirm codec.remainder().size() == 0
            else throw InvalidCompressedData.because(
                "bytes follow the end of the compressed stream"
            );
        let output = codec.output();
        let whole = output.bytes(limit + 1);
        whole;
    }
}
