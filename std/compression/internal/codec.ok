module compression/internal/codec v1.0.0;

import "runtime/compression" take CodecState, codec_open, codec_write, codec_finish, codec_ended,
    codec_remainder;
import "compression/state" take Compressing, Decompressing, CompressionOutput,
    CompressionLimitExceeded, InvalidCompressionLimit, InvalidCompressedData;
import "io/stream" take Reading;
import "async/atomic" take Atomic;
import "error" take InvalidArgument, InvalidState;

// The codecs behind compression/gzip, compression/deflate and
// compression/zlib: the runtime's streaming DEFLATE in one of its framings
// (format "deflate", "zlib" or "gzip"), one object per stream. Output waits in
// the codec until output() takes it.

object NativeCompressor does Compressing {
    has state is CodecState;
    has pending is Atomic<@byte>;
    has done, shut is Atomic<bool>;

    NativeCompressor(format is string, level is int) {
        confirm level >= 0 && level <= 9
            else throw InvalidArgument.because("compression level must be 0..9");
        state = codec_open(format, true, level, 1);
        let empty is @byte = [];
        pending = Atomic(empty);
        done = Atomic(false);
        shut = Atomic(false);
    }

    write(origin is @byte) is void {
        confirm !shut.value() && !done.value()
            else throw InvalidState.because("codec is not writable");
        pending.replace(pending.value() + codec_write(state, origin));
    }

    output() is Reading {
        confirm !shut.value() else throw InvalidState.because("codec output is unavailable");
        let ready = pending.value();
        let empty is @byte = [];
        pending.replace(empty);
        CompressionOutput(ready);
    }

    finish() is void {
        confirm !shut.value() && !done.value()
            else throw InvalidState.because("codec cannot finish");
        pending.replace(pending.value() + codec_finish(state));
        done.replace(true);
    }

    finished() is bool {
        confirm !shut.value() else throw InvalidState.because("codec completion is unavailable");
        done.value();
    }

    close() is void {
        shut.replace(true);
        let empty is @byte = [];
        pending.replace(empty);
    }

    closed() is bool {
        shut.value();
    }
}

object NativeDecompressor does Decompressing {
    has state is CodecState;
    has limit is int;
    has pending is Atomic<@byte>;
    has done, shut, failed is Atomic<bool>;

    NativeDecompressor(format is string, limit is int) {
        confirm limit > 0 else throw InvalidCompressionLimit.maximum(limit);
        state = codec_open(format, false, 0, limit);
        self.limit = limit;
        let empty is @byte = [];
        pending = Atomic(empty);
        done = Atomic(false);
        shut = Atomic(false);
        failed = Atomic(false);
    }

    write(origin is @byte) is void {
        confirm !shut.value() && !done.value() && !failed.value()
            else throw InvalidState.because("codec is not writable");
        let produced = try {
            codec_write(state, origin);
        }
        catch failure is NativeFailure {
            failed.replace(true);
            throw CodecFailure(failure: failure, limit: limit).error();
        };
        pending.replace(pending.value() + produced);
    }

    output() is Reading {
        confirm !shut.value() && !failed.value()
            else throw InvalidState.because("codec output is unavailable");
        let ready = pending.value();
        let empty is @byte = [];
        pending.replace(empty);
        CompressionOutput(ready);
    }

    finish() is void {
        confirm !shut.value() && !done.value() && !failed.value()
            else throw InvalidState.because("codec cannot finish");
        try {
            codec_finish(state);
        }
        catch failure is NativeFailure {
            failed.replace(true);
            throw CodecFailure(failure: failure, limit: limit).error();
        };
        done.replace(true);
    }

    finished() is bool {
        confirm !shut.value() && !failed.value()
            else throw InvalidState.because("codec completion is unavailable");
        done.value();
    }

    close() is void {
        shut.replace(true);
        let empty is @byte = [];
        pending.replace(empty);
    }

    closed() is bool {
        shut.value();
    }

    // The bytes after the end of the compressed stream, once it has ended.
    remainder() is @byte {
        codec_remainder(state);
    }

    // Whether the end of the compressed stream has come.
    ended() is bool {
        codec_ended(state);
    }
}

// The domain error of a failure of the runtime codec.
object CodecFailure {
    has failure is NativeFailure;
    has limit is int;

    CodecFailure(failure is NativeFailure, limit is int) {
        self.failure = failure;
        self.limit = limit;
    }

    error() is Error {
        if failure.code() == "resource_exhausted" {
            return CompressionLimitExceeded.maximum(limit);
        }
        InvalidCompressedData.because(failure.text());
    }
}

// A whole value compressed in one go.
object NativeCompressed {
    has origin is @byte;
    has format is string;
    has level is int;

    NativeCompressed(origin is @byte, format is string, level is int) {
        self.origin = origin;
        self.format = format;
        self.level = level;
    }

    bytes() is @byte {
        confirm level >= 0 && level <= 9
            else throw InvalidArgument.because("compression level must be 0..9");
        let state = codec_open(format, true, level, 1);
        codec_write(state, origin) + codec_finish(state);
    }
}

// A whole compressed value decompressed in one go: the stream must end with the
// value, with nothing after it.
object NativeDecompressed {
    has origin is @byte;
    has format is string;
    has limit is int;

    NativeDecompressed(origin is @byte, format is string, limit is int) {
        self.origin = origin;
        self.format = format;
        self.limit = limit;
    }

    bytes() is @byte {
        let codec = NativeDecompressor(format: format, limit: limit);
        codec.write(origin);
        codec.finish();
        confirm codec.remainder().size() == 0
            else throw InvalidCompressedData.because(
                "bytes follow the end of the compressed stream"
            );
        let output = codec.output();
        let whole = output.bytes(limit + 1);
        whole;
    }
}
