module locale/list v1.0.0;
import "locale/tag" take Locale;
import "locale/data" take LocaleFallbacks;
import "locale/internal/lists" take CldrLists;
import "collections/sequence" take Sequencing;
enum ListKind=(conjunction,disjunction,unit);
enum ListStyle=(long,short,narrow);
object LocalizedList {
    has values,patterns is @string;
    LocalizedList(values is Sequencing<string>,locale is Locale,kind is ListKind,style is ListStyle) {
        let count=values.size();confirm count>=0 && count<=4096 else throw InvalidLocalizedList("item count must be 0..4096");
        let items is @string=(0..count).map()->index{
            let text=values.item(index);confirm text.length()<=65536 else throw InvalidLocalizedList("item length exceeds 65536 scalars");text;
        };
        let length=items.reduce(0)->total,text{total+text.length();};
        confirm length<=1048576 else throw InvalidLocalizedList("aggregate input exceeds 1048576 scalars");
        self.values=items;
        let base=match kind{case ListKind.conjunction{0;}case ListKind.disjunction{3;}else{6;}};
        let selected=base+match style{case ListStyle.long{0;}case ListStyle.short{1;}else{2;}};
        patterns=if count<2{[];}else{LocalizedListPattern(locale,selected).values();};
    }
    string() is string {
        let count=values.size();if count==0{return "";}if count==1{return values[0];}
        let pattern=patterns;
        if count==2{return pattern[0]+values[0]+pattern[1]+values[1]+pattern[2];}
        // Expanding the nested CLDR composition into fragments avoids copying
        // the complete accumulated list for each item. Placeholder text in an
        // item is never reinterpreted as a pattern.
        let prefixes is @string=(0..count-3).map()->index{pattern[6];};
        let parts is @string=(0..count).map()->index{
            if index==0{pattern[9]+prefixes.join("")+pattern[3]+values[0];}else{
                if index==1{pattern[4]+values[1]+pattern[5];}else{
                    if index==count-1{pattern[10]+values[index]+pattern[11];}else{pattern[7]+values[index]+pattern[8];}
                }
            }
        };
        parts.join("");
    }
}
object LocalizedListPattern {
    has locale is Locale;has style is int;
    LocalizedListPattern(locale is Locale,style is int){self.locale=locale;self.style=style;}
    values() is @string {
        confirm style>=0 && style<9 else throw InvalidLocalizedList("pattern style");
        let table=CldrLists();let chain=LocaleFallbacks(locale);
        for (0..chain.size())->index{
            let found=table.lookup(chain.item(index).string(),style);if found.size()!=0{return found;}
        }
        throw InvalidLocalizedList("missing pinned root data");
    }
}
object InvalidLocalizedList does Error {
    has reason is string;InvalidLocalizedList(reason is string){self.reason=reason;}text() is string{"invalid localized list: "+reason;}
}

test "list item placeholders remain literal" {test.is(LocalizedList(["{1}","{0}"],Locale("en"),ListKind.conjunction,ListStyle.long).string(),"{1} and {0}");}
