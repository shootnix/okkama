module locale/system v1.0.0;
import "locale/tag" take Locale,LocaleFromLanguageTag,InvalidLocale;
import "collections/sequence" take Sequencing;
import "collections/iteration" take Cursor;
import "os/environment" take Environment;
import "runtime/system" take system_platform;
import "runtime/locale" take preferred_language_tags;
import "encoding/utf" take Utf8Encoded;
role PreferredLanguageReading {platform_owned() is bool;tags() is Sequencing<string>;}
object FixedLanguagePreferences does PreferredLanguageReading {
    has values is @string;has owned is bool;
    FixedLanguagePreferences(origin is Sequencing<string>,platform_owned is bool){
        let size=origin.size();confirm size>=0 && size<=64 else throw InvalidPreferredLocales("tag count");
        let snapshot is @string=(0..size).map()->index{let text=origin.item(index);confirm text.length()<=255 else throw InvalidPreferredLocales("tag length");text;};
        values=snapshot;owned=platform_owned;
    }
    platform_owned() is bool{owned;}tags() is Sequencing<string>{values;}
}
object SystemLanguagePreferences does PreferredLanguageReading {
    has origin is FixedLanguagePreferences;
    SystemLanguagePreferences(){
        let platform=try{system_platform();}catch error is NativeFailure{throw PreferredLocaleUnavailable(error.message());};let owned=platform=="macos" || platform=="windows";
        let tags is @string=if owned{try{preferred_language_tags();}catch error is NativeFailure{throw PreferredLocaleUnavailable(error.message());}}else{[];};
        origin=FixedLanguagePreferences(tags,owned);
    }
    platform_owned() is bool{origin.platform_owned();}tags() is Sequencing<string>{origin.tags();}
}
object PreferredLocales does Sequencing<Locale> {
    has origin is @Locale;
    PreferredLocales(origin is Environment){self.origin=PreferredLocalePolicy(origin,SystemLanguagePreferences()).values();}
    PreferredLocales(origin is Environment,preferences is PreferredLanguageReading){self.origin=PreferredLocalePolicy(origin,preferences).values();}
    size() is int{origin.size();}item(index is int) is Locale{origin.item(index);}
    first() is Locale{origin.first();}last() is Locale{origin.last();}cursor() is Cursor<Locale>{origin.cursor();}
}
object PreferredLocalePolicy {
    has environment is Environment;has preferences is PreferredLanguageReading;
    PreferredLocalePolicy(environment is Environment,preferences is PreferredLanguageReading){self.environment=environment;self.preferences=preferences;}
    values() is @Locale{
        if preferences.platform_owned(){return self.parsed(FixedLanguagePreferences(preferences.tags(),true).tags(),false);}
        if environment.membership("LANGUAGE"){
            let text=environment.variable("LANGUAGE");confirm text.length()<=4096 else throw InvalidPreferredLocales("LANGUAGE length");
            let fields=text.split(":");confirm fields.size()<=64 else throw InvalidPreferredLocales("LANGUAGE count");
            let values=self.parse(fields,true);if values.size()>0{return values;}
        }
        for ["LC_ALL","LC_MESSAGES","LANG"]->name {
            if environment.membership(name){let values=self.parse([environment.variable(name)],true);if values.size()>0{return values;}}
        }
        [Locale("und")];
    }
    private:
    parsed(source is Sequencing<string>,posix is bool) is @Locale{let values=self.parse(source,posix);if values.size()==0{[Locale("und")];}else{values;}}
    parse(source is Sequencing<string>,posix is bool) is @Locale{
        let size=source.size();confirm size>=0 && size<=64 else throw InvalidPreferredLocales("preference count");
        let entries is @string=(0..size).map()->index{let text=source.item(index);confirm text.length()<=255 else throw InvalidPreferredLocales("preference length");text;};
        let spellings is @string=entries.map()->text{
            try{let tag=if posix{PosixLanguageTag(text).string();}else{text;};LocaleFromLanguageTag(tag).value().string();}catch error is InvalidLocale{"";}
        };
        let positions is @int=(0..spellings.size()).filter()->index{let duplicate=(0..index).reduce(false)->seen,prior{seen || spellings[prior]==spellings[index];};spellings[index]!="" && !duplicate;};
        let values is @Locale=positions.map()->index{LocaleFromLanguageTag(spellings[index]).value();};values;
    }
}
object PosixLanguageTag {
    has origin is string;PosixLanguageTag(origin is string){self.origin=origin;}
    string() is string{
        let modifier=origin.split("@");confirm modifier.size()<=2 else throw InvalidLocale(0,"invalid POSIX modifier");
        if modifier.size()==2{confirm PosixLocaleSuffix(modifier[1]).valid() else throw InvalidLocale(0,"invalid POSIX modifier");}
        let charset=modifier[0].split(".");confirm charset.size()<=2 else throw InvalidLocale(0,"invalid POSIX charset");
        if charset.size()==2{confirm PosixLocaleSuffix(charset[1]).valid() else throw InvalidLocale(0,"invalid POSIX charset");}
        let base=charset[0];if base=="C" || base=="POSIX"{"und";}else{base.split("_").join("-");}
    }
}
object PosixLocaleSuffix {
    has origin is string;PosixLocaleSuffix(origin is string){self.origin=origin;}
    valid() is bool{
        let valid=Utf8Encoded(origin).bytes().reduce(true)->previous,byte{let code=byte.int();previous && ((code>=65 && code<=90) || (code>=97 && code<=122) || (code>=48 && code<=57) || code==45 || code==95);};
        origin.length()>0 && valid;
    }
}
object InvalidPreferredLocales does Error {
    has reason is string;InvalidPreferredLocales(reason is string){self.reason=reason;}text() is string{"invalid preferred locales: "+reason;}
}
object PreferredLocaleUnavailable does Error {
    has reason is string;PreferredLocaleUnavailable(reason is string){self.reason=reason;}text() is string{"platform language snapshot unavailable: "+reason;}
}

test "POSIX language preferences normalize without changing environment" {let env=Environment(["LANG":"en_US.UTF-8"]);test.is(PreferredLocales(env,FixedLanguagePreferences([],false)).first().string(),"en-US");test.is(env.variable("LANG"),"en_US.UTF-8");}
