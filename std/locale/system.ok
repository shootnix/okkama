module locale/system v1.0.0;

// The locales a user prefers, from the operating system and the environment.
//
//     let preferred = PreferredLocales(Environment());
//     LookedUpLocale(requested: …, available: supported, fallback: Locale("en"));
//
// LANGUAGE, then LC_ALL, LC_MESSAGES and LANG are read; on platforms with a
// language setting (macOS, Windows) that comes first.

import "locale/tag" take Locale, LocaleFromLanguageTag, InvalidLocale;
import "collections/sequence" take Sequencing;
import "collections/iteration" take Cursor;
import "os/environment" take Environment;
import "runtime/system" take system_platform;
import "runtime/locale" take preferred_language_tags;
import "encoding/utf" take Utf8Encoded;

// Where the user's language list comes from.
role PreferredLanguageReading {
    // Whether the list comes from the operating system's settings.
    platform_owned() is bool;
    // The language tags, most preferred first.
    tags() is Sequencing<string>;
}

// A language list given by the program.
object FixedLanguagePreferences does PreferredLanguageReading {
    has values is @string;
    has owned is bool;

    // The tags, as the platform's or not.
    FixedLanguagePreferences(origin is Sequencing<string>, platform_owned is bool) {
        let size = origin.size();
        confirm size >= 0 && size <= 64 else throw InvalidPreferredLocales.because("tag count");
        let snapshot is @string = (0..size).map() -> index {
            let text = origin.item(index);
            confirm text.length() <= 255 else throw InvalidPreferredLocales.because("tag length");
            text;
        };
        values = snapshot;
        owned = platform_owned;
    }

    // Whether the list comes from the operating system's settings.
    platform_owned() is bool {
        owned;
    }

    // The language tags, most preferred first.
    tags() is Sequencing<string> {
        values;
    }
}

// The operating system's language list.
object SystemLanguagePreferences does PreferredLanguageReading {
    has origin is FixedLanguagePreferences;

    // The list.
    SystemLanguagePreferences() {
        let platform = try {
            system_platform();
        }
        catch error is NativeFailure {
            throw PreferredLocaleUnavailable.because(error.message());
        };
        let owned = platform == "macos" || platform == "windows";
        let tags is @string = if owned {
            try {
                preferred_language_tags();
            }
            catch error is NativeFailure {
                throw PreferredLocaleUnavailable.because(error.message());
            }
        }
        else {
            [];
        };
        origin = FixedLanguagePreferences(origin: tags, platform_owned: owned);
    }

    // Whether the list comes from the operating system's settings.
    platform_owned() is bool {
        origin.platform_owned();
    }

    // The language tags, most preferred first.
    tags() is Sequencing<string> {
        origin.tags();
    }
}

// The user's locales, most preferred first.
object PreferredLocales does Sequencing<Locale> {
    has origin is @Locale;

    // From the system's list and origin.
    PreferredLocales(origin is Environment) {
        self.origin = PreferredLocalePolicy(
            environment: origin,
            preferences: SystemLanguagePreferences()
        ).values();
    }

    // From preferences and origin.
    PreferredLocales(origin is Environment, preferences is PreferredLanguageReading) {
        self.origin = PreferredLocalePolicy(environment: origin, preferences: preferences).values();
    }

    // How many.
    size() is int {
        origin.size();
    }

    // The locale at index.
    item(index is int) is Locale {
        origin.item(index);
    }

    // The first locale.
    first() is Locale {
        origin.first();
    }

    // The last locale.
    last() is Locale {
        origin.last();
    }

    // Walks them.
    cursor() is Cursor<Locale> {
        origin.cursor();
    }
}

// How the list is made from settings and variables.
object PreferredLocalePolicy {
    has environment is Environment;
    has preferences is PreferredLanguageReading;

    // From environment and preferences.
    PreferredLocalePolicy(environment is Environment, preferences is PreferredLanguageReading) {
        self.environment = environment;
        self.preferences = preferences;
    }

    // The locales; PreferredLocaleUnavailable when none can be found.
    values() is @Locale {
        if preferences.platform_owned() {
            return self.parsed(
                FixedLanguagePreferences(origin: preferences.tags(), platform_owned: true).tags(),
                false
            );
        }
        if environment.membership("LANGUAGE") {
            let text = environment.text("LANGUAGE");
            confirm text.length() <= 4096
                else throw InvalidPreferredLocales.because("LANGUAGE length");
            let fields = text.split(":");
            confirm fields.size() <= 64
                else throw InvalidPreferredLocales.because("LANGUAGE count");
            let values = self.parse(fields, true);
            if values.size() > 0 {
                return values;
            }
        }
        for ["LC_ALL", "LC_MESSAGES", "LANG"] -> name {
            if environment.membership(name) {
                let values = self.parse([environment.text(name)], true);
                if values.size() > 0 {
                    return values;
                }
            }
        }
        [Locale("und")];
    }

    hidden parsed(source is Sequencing<string>, posix is bool) is @Locale {
        let values = self.parse(source, posix);
        if values.size() == 0 {
            [Locale("und")];
        }
        else {
            values;
        }
    }

    hidden parse(source is Sequencing<string>, posix is bool) is @Locale {
        let size = source.size();
        confirm size >= 0 && size <= 64
            else throw InvalidPreferredLocales.because("preference count");
        let entries is @string = (0..size).map() -> index {
            let text = source.item(index);
            confirm text.length() <= 255
                else throw InvalidPreferredLocales.because("preference length");
            text;
        };
        let spellings is @string = entries.map() -> text {
            try {
                let tag = if posix {
                    PosixLanguageTag(text).string();
                }
                else {
                    text;
                };
                LocaleFromLanguageTag(tag).locale().string();
            }
            catch error is InvalidLocale {
                "";
            }
        };
        let positions is @int = (0..spellings.size()).filter() -> index {
            let duplicate = (0..index).reduce(false) -> seen, prior {
                seen || spellings[prior] == spellings[index];
            };
            spellings[index] != "" && !duplicate;
        };
        let values is @Locale = positions.map() -> index {
            LocaleFromLanguageTag(spellings[index]).locale();
        };
        values;
    }
}

hidden object PosixLanguageTag {
    has origin is string;

    PosixLanguageTag(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let modifier = origin.split("@");
        confirm modifier.size() <= 2 else throw InvalidLocale.located(0, "invalid POSIX modifier");
        if modifier.size() == 2 {
            confirm PosixLocaleSuffix(modifier[1]).valid()
                else throw InvalidLocale.located(0, "invalid POSIX modifier");
        }
        let charset = modifier[0].split(".");
        confirm charset.size() <= 2 else throw InvalidLocale.located(0, "invalid POSIX charset");
        if charset.size() == 2 {
            confirm PosixLocaleSuffix(charset[1]).valid()
                else throw InvalidLocale.located(0, "invalid POSIX charset");
        }
        let base = charset[0];
        if base == "C" || base == "POSIX" {
            "und";
        }
        else {
            base.split("_").join("-");
        }
    }
}

hidden object PosixLocaleSuffix {
    has origin is string;

    PosixLocaleSuffix(origin is string) {
        self.origin = origin;
    }

    valid() is bool {
        let valid = Utf8Encoded(origin).bytes().reduce(true) -> previous, byte {
            let code = byte.int();
            previous
                && ((code >= 65 && code <= 90)
                || (code >= 97 && code <= 122)
                || (code >= 48 && code <= 57)
                || code == 45
                || code == 95);
        };
        origin.length() > 0 && valid;
    }
}

// A setting that cannot be read; reason says why.
enum InvalidPreferredLocales is Error = (because(reason is string));

// No preferred locale could be found; reason says why.
enum PreferredLocaleUnavailable is Error = (because(reason is string));

test "POSIX language preferences normalize without changing environment" {
    let env = Environment(["LANG": "en_US.UTF-8"]);
    test.is(
        PreferredLocales(
            origin: env,
            preferences: FixedLanguagePreferences(origin: [], platform_owned: false)
        ).first().string(),
        "en-US"
    );
    test.is(env.text("LANG"), "en_US.UTF-8");
}
