if tag=="ta"{return CurrencyTranslationRows("AED|ஐக்கிய அரபு எமிரேட்ஸ் திர்ஹாம்||ஐக்கிய அரபு எமிரேட்ஸ் திர்ஹாம்||||ஐக்கிய அரபு எமிரேட்ஸ் திர்ஹாம்கள்|||AFN|ஆஃப்கான் ஆஃப்கானி||ஆஃப்கான் ஆஃப்கானி||||ஆஃப்கான் ஆஃப்கானிகள்|||ALL|அல்பேனியன் லெக்||அல்பேனியன் லெக்||||அல்பேனியன் லெகே|||AMD|ஆர்மேனியன் ட்ராம்||ஆர்மேனியன் ட்ராம்||||ஆர்மேனியன் ட்ராம்கள்|||AOA|அங்கோலன் க்வான்ஸா||அங்கோலன் க்வான்ஸா||||அங்கோலன் க்வான்ஸாக்கள்|||ARS|அர்ஜென்டைன் பெசோ||அர்ஜென்டைன் பெசோ||||அர்ஜென்டைன் பெசோக்கள்|||AUD|ஆஸ்திரேலிய டாலர்||ஆஸ்திரேலிய டாலர்||||ஆஸ்திரேலிய டாலர்கள்|||AWG|அருபன் ஃப்ளோரின்|||||||||AZN|அசர்பைஜானி மனத்||அஜர்பைசானி மனத்||||அசர்பைஜானி மனத்கள்|||BAM|போஸ்னியா-ஹெர்ஸேகோவினா கன்வெர்டிபில் மார்க்||போஸ்னியா-ஹெர்ஸேகோவினா கன்வெர்டிபில் மார்க்||||போஸ்னியா-ஹெர்ஸேகோவினா கன்வெர்டிபில் மார்க்குகள்|||BBD|பார்பேடியன் டாலர்||பார்பேடியன் டாலர்||||பார்பேடியன் டாலர்கள்|||BDT|பங்களாதேஷி டாகா||பங்களாதேஷி டாகா||||பங்களாதேஷி டாகாக்கள்|||BHD|பஹ்ரைனி தினார்||பஹ்ரைனி தினார்||||பஹ்ரைனி தினார்கள்|||BIF|புருண்டியன் ஃப்ராங்க்||புருண்டியன் ஃப்ராங்க்||||புருண்டியன் ஃப்ராங்க்குகள்|||BMD|பெர்முடன் டாலர்||பெர்முடன் டாலர்||||பெர்முடன் டாலர்கள்|||BND|புரூனே டாலர்||புரூனே டாலர்||||புரூனே டாலர்கள்|||BOB|பொலிவியன் பொலிவியானோ||பொலிவியன் பொலிவியானோ||||பொலிவியன் பொலிவியானோக்கள்|||BRL|பிரேசிலியன் ரியால்||பிரேசிலியன் ரியால்||||பிரேசிலியன் ரியால்கள்|||BSD|பஹாமியன் டாலர்||பஹாமியன் டாலர்||||பஹாமியன் டாலர்கள்|||BTN|பூட்டானீஸ் குல்ட்ரம்||பூட்டானீஸ் குல்ட்ரம்||||பூட்டானீஸ் குல்ட்ரம்கள்|||BWP|போட்ஸ்வானன் புலா||போட்ஸ்வானன் புலா||||போட்ஸ்வானன் புலாக்கள்|||BYN|பெலருசியன் ரூபிள்||பெலருசியன் ரூபிள்||||பெலருசியன் ரூபிள்கள்||р.|BZD|பெலீஸ் டாலர்||பெலீஸ் டாலர்||||பெலீஸ் டாலர்கள்|||CAD|கனடியன் டாலர்||கனடியன் டாலர்||||கனடியன் டாலர்கள்|||CDF|காங்கோலீஸ் ஃப்ராங்க்||காங்கோலீஸ் ஃப்ராங்க்||||காங்கோலீஸ் ஃப்ராங்க்குகள்|||CHF|சுவிஸ் ஃப்ராங்க்||சுவிஸ் ஃப்ராங்க்||||சுவிஸ் ஃப்ராங்குகள்|||CLP|சிலியன் பெசோ||சிலியன் பெசோ||||சிலியன் பெசோக்கள்|||CNY|சீன யுவான்|||||||||COP|கொலம்பியன் பெசோ||கொலம்பியன் பெசோ||||கொலம்பியன் பெசோக்கள்|||CRC|கோஸ்டா ரிகன் கொலோன்||கோஸ்டா ரிகன