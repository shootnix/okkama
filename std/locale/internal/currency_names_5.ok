if tag=="dz"{return CurrencyTranslationRows("AED|ཡུ་ནཱའི་ཊེཌ་ ཨ་རབ་ ཨེ་མེ་རེཊས་ཀྱི་དངུལ་ ཌིར་ཧཱམ|||||||||AFN|ཨཕ་གཱན་གྱི་དངུལ་ ཨཕ་ག་ནི|||||||||AUD|ཨཱོས་ཊྲེ་ལི་ཡ་གི་དངུལ་ ཌོ་ལར|||||||AU$||BDT|བྷང་ལ་དེཤ་གི་དངུལ་ ཏ་ཀ|||||||||BMD|བར་མུ་ཌ་གི་དངུལ་ ཌོ་ལར|||||||||BRL|བྲ་ཛིལ་གྱི་དངུལ་ རེ་ཡལ|||||||||BTN|དངུལ་ཀྲམ|||||||Nu.||CAD|ཀེ་ན་ཌ་གི་དངུལ་ ཌོ་ལར|||||||||CHF|སུ་ཡིས་ཀྱི་དངུལ་ ཕྲངཀ|||||||||CLP|ཅི་ལི་གི་དངུལ་ པེ་སོ|||||||||CNY|རྒྱ་ནག་གི་དངུལ་ ཡུ་ཝཱན|||||||||COP|ཀོ་ལོམ་བྷི་ཡ་གི་དངུལ་ པེ་སོ|||||||||CUP|ཀིའུ་བྷ་གི་དངུལ་ པེ་སོ|||||||||DKK|ཌེན་མཱཀ་གི་དངུལ་ ཀྲོན|||||||||DZD|ཨཱལ་ཇི་རི་ཡ་གི་དངུལ་ ཌའི་ནར|||||||||EGP|ཨི་ཇིབཊ་གི་དངུལ་ པ་འུནཌ|||||||||EUR|ཡུ་རོ༌དངུལ་|||||||||GBP|བྲི་ཊིཤ་ པ་འུནཌ་ ཨིས་ཊར་ལིང|||||||||HKD|ཧོང་ཀོང་གི་དངུལ་ ཌོ་ལར|||||||||IDR|ཨིན་ཌོ་ནེ་ཤི་ཡ་གི་དངུལ་ རུ་པི་ཡ|||||||||ILS|ཨིས་རེལ་གྱི་དངུལ་གསརཔ་ ཤེ་ཀེལ|||||||ILS||INR|རྒྱ་གར་གྱི་དངུལ་ རུ་པི|||||||||IQD|ཨི་རཱཀ་གི་དངུལ་ ཌི་ན|||||||||IRR|ཨི་རཱན་གྱི་དངུལ་ རི་ཨཱལ|||||||||ISK|ཨཱཡིས་ལེནཌ་གི་དངུལ་ ཀྲོ་ན|||||||||JMD|ཇཱ་མཻ་ཀ་གི་དངུལ་ ཌོ་ལར|||||||||JOD|ཇོར་ཌན་གྱི་དངུལ་ ཌི་ན|||||||||JPY|ཇཱ་པཱན་གྱི་དངུལ་ ཡེན|||||||||KES|ཀེན་ཡ་གི་དངུལ་ ཤི་ལིང|||||||||KHR|ཀེམ་བྷོ་ཌི་ཡ་གི་དངུལ་ རི་ཨཱལ|||||||||KPW|ནོརཐ་ ཀོ་རི་ཡ་གི་དངུལ་ ཝོན|||||||||KRW|སཱའུཐ་ ཀོ་རི་ཡ་གི་དངུལ་ ཝོན|||||||KR₩||KWD|ཀུ་ཝེཊ་གི་དངུལ་ ཌི་ན|||||||||KZT|ཀ་ཛགས་ཏཱན་གྱི་དངུལ་ ཏེང་གེ|||||||||LAK|ལཱ་ཝོས་ཀྱི་དངུལ་ ཀིཔ|||||||||LBP|ལེ་བ་ནོན་གྱི་དངུལ་ པ་འུནཌ|||||||||LKR|ཤྲི་ ལང་ཀ་གི་དངུལ་ རུ་པི|||||||||LRD|ལཱའི་བེ་རི་ཡ་གི་དངུལ་ ཌོ་ལར|||||||||LYD|ལི་བི་ཡ་གི་དངུལ་ ཌི་ན|||||||||MAD|མོ་རོ་ཀོ་གི་དངུལ་ ཌིར་ཧཱམ|||||||||MMK|མི་ཡཱན་མར་གྱི་དངུལ་ ཅཱཏ|||||||||MNT|སོག་པོའི་དངུལ་ ཏུ་གྲིཀ|||||||||MVR|མཱལ་དིབས་ཀྱི་དངུལ་ རུ་ཕི་ཡ|||||||||MXN|མེཀ་སི་ཀོ་གི་དངུལ་ པེ་སོ|||||||||MYR|མ་ལེ་ཤི་ཡ་གི་དངུལ་ རིང་གིཊ|||||||||NOK|ནོར་ཝེ་གི་དངུལ་ ཀྲོ་ན|||||||||NPR|བལ་པོའི་དངུལ་ རུ་པི|||||||||NZD|ནིའུ་ཛི་ལེནཌ་གི་དངུལ་ ཌོ་ལར|||||||||OMR|ཨོ་མཱན་གྱི་དངུལ་ རི་ཨཱལ|||||||||PAB|པ་ན་མ་གི་དངུལ་ བཱལ་བོ་ཝ|||||||||PEN|པ་རུ་གི་དངུལ་ ནུ་བོ་ སཱོལ|||||||||PHP|ཕི་ལི་པིནས་གྱི་དངུལ་ པེ་སོ|||||||||PKR|པ་ཀིས་ཏཱན་གྱི་དངུལ་ རུ་པི|||||||||PLN|