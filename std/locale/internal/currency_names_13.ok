if tag=="kn"{return CurrencyTranslationRows("AED|ಸಂಯುಕ್ತ ಅರಬ್‌ ಎಮಿರೇಟ್‌‌ಗಳ ದಿರಾಮ್‌‌||ಯುಎಇ ದಿರಾಮ್||||ಯುಎಇ ದಿರಾಮ್‌ಗಳು|||AFN|ಅಫ್‌ಘನ್ ಅಫಘಾನಿ||ಅಫ್‌ಘನ್ ಅಫಘಾನಿ||||ಅಫ್‌ಘನ್ ಅಫಘಾನಿಗಳು|||ALL|ಅಲ್‌ಬೇನಿಯನ್ ಲೆಕ್|||||||||AMD|ಅರ್ಮೆನಿಯನ್ ಡ್ರಾಮ್||ಅರ್ಮೆನಿಯನ್ ಡ್ರಾಮ್||||ಅರ್ಮೆನಿಯನ್ ಡ್ರಾಮ್‌ಗಳು|||AOA|ಅಂಗೋಲಾದ ಕ್ವಾನ್ಝಾ||ಅಂಗೋಲಾದ ಕ್ವಾನ್ಝಾ||||ಅಂಗೋಲಾದ ಕ್ವಾನ್ಝಾಗಳು|||ARS|ಅರ್ಜೆಂಟಿನಾ ಪೆಸೊ||ಅರ್ಜೆಂಟಿನಾ ಪೆಸೊ||||ಅರ್ಜೆಂಟಿನಾ ಪೆಸೊಗಳು|||AUD|ಆಸ್ಟ್ರೇಲಿಯನ್ ಡಾಲರ್‌||ಆಸ್ಟ್ರೇಲಿಯನ್ ಡಾಲರ್‌||||ಆಸ್ಟ್ರೇಲಿಯನ್ ಡಾಲರ್‌‌ಗಳು|||AWG|ಅರುಬನ್ ಫ್ಲೊರೀನ್‌‌|||||||||AZN|ಅಝರ್‌ಬೈಜಾನಿ ಮನಾತ್||ಅಝರ್‌ಬೈಜಾನಿ ಮನಾತ್||||ಅಝರ್‌ಬೈಜಾನಿ ಮನಾತ್‌ಗಳು|||BAM|ಬೋಸ್ನಿಯಾ-ಹರ್ಜ್‌ಗೋವಿನ ಪರಿವರ್ತನೀಯ ಗುರುತು||ಬೋಸ್ನಿಯಾ-ಹರ್ಜ್‌ಗೋವಿನ ಪರಿವರ್ತನೀಯ ಗುರುತು||||ಬೋಸ್ನಿಯಾ-ಹರ್ಜ್‌ಗೋವಿನ ಪರಿವರ್ತನೀಯ ಗುರುತುಗಳು|||BBD|ಬರ್ಬಾಡಿಯನ್ ಡಾಲರ್||ಬರ್ಬಾಡಿಯನ್ ಡಾಲರ್||||ಬರ್ಬಾಡಿಯನ್ ಡಾಲರ್‌ಗಳು|||BDT|ಬಾಂಗ್ಲಾದೇಶದ ಟಾಕಾ||ಬಾಂಗ್ಲಾದೇಶದ ಟಾಕಾ||||ಬಾಂಗ್ಲಾದೇಶದ ಟಾಕಾಗಳು|||BHD|ಬಹ್‌‌ರೈನಿ ದಿನಾರ್||ಬಹ್‌‌ರೈನಿ ದಿನಾರ್||||ಬಹ್‌‌ರೈನಿ ದಿನಾರ್‌ಗಳು|||BIF|ಬುರುಂದಿಯನ್ ಫ್ರಾಂಕ್||ಬುರುಂದಿಯನ್ ಫ್ರಾಂಕ್||||ಬುರುಂದಿಯನ್ ಫ್ರಾಂಕ್‍ಗಳು|||BMD|ಬರ್ಮುಡನ್ ಡಾಲರ್||ಬರ್ಮುಡನ್ ಡಾಲರ್||||ಬರ್ಮುಡನ್ ಡಾಲರ್‌ಗಳು|||BND|ಬ್ರೂನಿ ಡಾಲರ್||ಬ್ರೂನಿ ಡಾಲರ್||||ಬ್ರೂನಿ ಡಾಲರ್‌ಗಳು|||BOB|ಬೊಲಿವಿಯಾದ ಬೊಲಿವಿಯಾನೊ||ಬೊಲಿವಿಯಾದ ಬೊಲಿವಿಯಾನೊ||||ಬೊಲಿವಿಯಾದ ಬೊಲಿವಿಯಾನೊಗಳು|||BRL|ಬ್ರೆಜಿಲಿಯನ್‌ ರಿಯಲ್||ಬ್ರೆಜಿಲಿಯನ್‌ ರಿಯಲ್||||ಬ್ರೆಜಿಲಿಯನ್ ರಿಯಲ್‍ಗಳು|||BSD|ಬಹಾಮಿಯನ್ ಡಾಲರ್||ಬಹಾಮಿಯನ್ ಡಾಲರ್||||ಬಹಾಮಿಯನ್ ಡಾಲರ್‌ಗಳು|||BTN|ಭೂತಾನೀಸ್ ನುಲ್ತರಮ್||ಭೂತಾನೀಸ್ ನುಲ್ತರಮ್||||ಭೂತಾನೀಸ್ ನುಲ್ತರಮ್‌ಗಳು|||BWP|ಬೋಟ್ಸ್‌ವಾನನ್ ಪುಲಾ||ಬೋಟ್ಸ್‌ವಾನನ್ ಪುಲಾ||||ಬೋಟ್ಸ್‌ವಾನನ್ ಪುಲಾಗಳು|||BYN|ಬೆಲಾರುಸಿಯನ್ ರೂಬಲ್||ಬೆಲಾರುಸಿಯನ್ ರೂಬಲ್||||ಬೆಲಾರುಸಿಯನ್ ರೂಬಲ್‍ಗಳು||р.|BZD|ಬೆಲೀಜ್ ಡಾಲರ್||ಬೆಲೀಜ್ ಡಾಲರ್||||ಬೆಲೀಜ್ ಡಾಲರ್‌‍ಗಳು|||CAD|ಕೆನಡಾದ ಡಾಲರ್||ಕೆನಡಾದ ಡಾಲರ್||||ಕೆನಡಾದ ಡಾಲರ್‌ಗಳು|||CDF|ಕಾಂಗೋಲೀಸ್ ಫ್ರಾಂಕ್||ಕಾಂಗೋಲೀಸ್ ಫ್ರಾಂಕ್||||ಕಾಂಗೋಲೀಸ್ ಫ್ರಾಂಕ್‍‌ಗಳು|||CHF|ಸ್ವಿಸ್ ಫ್ರಾಂಕ್||ಸ್ವಿಸ್ ಫ್ರಾಂಕ್||||ಸ್ವಿಸ್ ಫ್ರಾಂಕ್‍ಗಳು|||CLP|ಚಿಲಿಯ ಪೆಸೊ||ಚಿಲಿಯ ಪೆಸೊ||||ಚಿಲಿಯ ಪೆಸೊಗಳು|||CNY|ಚೈನೀಸ್ ಯುವಾನ್|||||||||COP|ಕೊಲೊಂಬಿಯೋದ ಪೆಸೊ||ಕೊಲೊಂಬಿಯೋದ ಪೆಸೊ||||ಕೊಲೊಂಬಿಯೋದ ಪೆಸೊಗಳು|||CRC|ಕೋಸ್ಟ ರಿಕನ್ ಕೊಲನ್||ಕೋಸ್ಟಾ ರಿಕಾದ ಕೊಲೊನ್‌||||ಕೋಸ್ಟಾ ರಿಕಾದ ಕೊಲೊನ್‌ಗಳು|||CUP|ಕ್ಯೂಬಾದ ಪೆಸೊ||ಕ್ಯೂಬಾದ ಪೆಸೊ||||ಕ್ಯೂಬಾದ ಪೆಸೊಗಳು|||CVE|ಕೇಪ್ ವರ್ಡಿನ್ ಎಸ್‌ಕೂಡೊ||ಕೇಪ್ ವರ್ಡಿನ್ ಎಸ್‌ಕೂಡೊ||||ಕೇಪ್ ವರ್ಡಿನ್ ಎಸ್‌ಕೂಡೊಗಳು|||CZK|ಝೆಕ್ ಗಣರಾಜ್ಯ ಕೊರೂನ||ಝೆಕ್ ಗಣರಾಜ್ಯ ಕೊರೂನ||||ಝೆಕ್ ಗಣರಾಜ್ಯ ಕೊರೂನಗಳು|||DJF|ಜಿಬೊಟಿಯನ್ ಫ್ರಾಂಕ್||ಜಿಬೊಟಿಯನ್ ಫ್ರಾಂಕ್||||ಜಿಬೊಟಿಯನ್ ಫ್ರಾಂಕ್‍ಗಳು|||DKK|ಡ್ಯಾನಿಶ್ ಕ್ರೋನ್||ಡ್ಯಾನಿಶ್ ಕ್ರೋನ್||||ಡ್ಯಾನಿಶ್ ಕ್ರೋನರ್|||DOP|ಡೊಮಿನಿಕನ್ ಪೆಸೊ||ಡೊಮಿನಿಕನ್ ಪೆಸೊ||||ಡೊಮಿನಿಕನ್ ಪೆಸೊಗಳು|||DZD|ಅಲ್ಜೀರಿಯನ್ ದಿನಾರ್||ಅಲ್ಜೀರಿಯನ್ ದಿನಾರ್||||ಅಲ್ಜೀರಿಯನ್ ದಿನಾರ್‌ಗಳು|||EGP|ಈಜಿಪ್ಷಿಯನ್ ಪೌಂಡ್‍||ಈಜಿಪ್ಷಿಯನ್ ಪೌಂಡ್‍||||ಈಜಿಪ್ಷಿಯನ್ ಪೌಂಡ್‍ಗಳು|||ERN|ಎರಿತ್ರಿಯನ್ ನಕ್ಫಾ||ಎರಿತ್ರಿಯನ್ ನಕ್ಫಾ||||ಎರಿತ್ರಿಯನ್ ನಕ್ಫಾಗಳು|||ETB|ಇಥಿಯೋಪಿಯನ್ ಬಿರ್||ಇಥಿಯೋಪಿಯನ್ ಬಿರ್||||ಇಥಿಯೋಪಿಯನ್ ಬಿರ್‌ಗಳು|||EUR|ಯೂರೊ||ಯೂರೊ||||ಯೂರೊಗಳು|||FJD|ಫಿಜಿಯನ್ ಡಾಲರ್||ಫಿಜಿಯನ್ ಡಾಲರ್||||ಫಿಜಿಯನ್ ಡಾಲರ್‌ಗಳು|||FKP|ಫಾಕ್‌ಲ್ಯಾಂಡ್ ದ್ವೀಪಗಳ ಪೌಂಡ್||ಫಾಕ್‌ಲ್ಯಾಂಡ್ ದ್ವೀಪಗಳ ಪೌಂಡ್||||ಫಾಕ್‌ಲ್ಯಾಂಡ್ ದ್ವೀಪಗಳ ಪೌಂಡ್‍ಗಳು|||GBP|ಬ್ರಿಟಿಷ್ ಪೌಂಡ್||ಬ್ರಿಟಿಷ್ ಪೌಂಡ್||||ಬ್ರಿಟಿಷ್ ಪೌಂಡ್‍ಗಳು|||GEL|ಜಾರ್ಜಿಯಾದ ಲಾರಿ||ಜಾರ್ಜಿಯಾದ ಲಾರಿ||||ಜಾರ್ಜಿಯಾದ ಲಾರಿಗಳು|||GHS|ಘಾನಾದ ಸೆದಿ||ಘಾನಾದ ಸೆದಿ||||ಘಾನಾದ ಸೆದಿಗಳು|||GIP|ಗಿಬ್ರಾಲ್ಟರ್ ಪೌಂಡ್||ಗಿಬ್ರಾಲ್ಟರ್ ಪೌಂಡ್||||ಗಿಬ್ರಾಲ್ಟರ್ ಪೌಂಡ್‍ಗಳು|||GMD|ಗ್ಯಾಂಬಿಯಾದ ದಲಾಸಿ||ಗ್ಯಾಂಬಿಯಾದ ದಲಾಸಿ||||ಗ್ಯಾಂಬಿಯಾದ ದಲಾಸಿಗಳು|||GNF|ಗಿನಿಯನ್ ಫ್ರಾಂಕ್||ಗಿನಿಯನ್ ಫ್ರಾಂಕ್||||ಗಿನಿಯನ್ ಫ್ರಾಂಕ್‌ಗಳು|||GTQ|ಗ್ವಾಟೆಮಾಲಾದ ಕುಯಿಟ್ಸಲ್‌‌||ಗ್ವಾಟೆಮಾಲಾದ ಕುಯಿಟ್ಸಲ್‌‌||||ಗ್ವಾಟೆಮಾಲಾದ ಕುಯಿಟ್ಸಲ್‌‌‍ಗಳು|||GYD|ಗುಯಾನೀಸ್‌ ಡಾಲರ್‌||ಗುಯಾನೀಸ್‌ ಡಾಲರ್‌||||ಗುಯಾನೀಸ್‌ ಡಾಲರ್‌‌ಗಳು|||HKD|ಹಾಂಗ್ ಕಾಂಗ್ ಡಾಲರ್||ಹಾಂಗ್ ಕಾಂಗ್ ಡಾಲರ್||||ಹಾಂಗ್ ಕಾಂಗ್ ಡಾಲರ್‌ಗಳು|||HNL|ಹೊಂಡುರಾನ್‌ ಲೆಂಪಿರಾ||ಹೊಂಡುರಾನ್‌ ಲೆಂಪಿರಾ||||ಹೊಂಡುರಾನ್‌ ಲೆಂಪಿರಾಗಳು|||HTG|ಹೈಟಿಯ ಗೋರ್ದೆ||ಹೈಟಿಯ ಗೋರ್ದೆ||||ಹೈಟಿಯ ಗೋರ್ದೆಗಳು|||HUF|ಹಂಗೇರಿಯನ್ ಫೋರಿಂಟ್||ಹಂಗೇರಿಯನ್ ಫೋರಿಂಟ್||||ಹಂಗೇರಿಯನ್ ಫೋರಿಂಟ್‍ಗಳು|||IDR|ಇಂಡೊನೇಷ್ಯಾ ರುಪೈ|||||||||ILS|ಇಸ್ರೇಲಿ ನ್ಯೂ ಶೇಖಲ್||ಇಸ್ರೇಲಿ ನ್ಯೂ ಶೇಖಲ್||||ಇಸ್ರೇಲಿ ನ್ಯೂ ಶೇಖಲ್‍ಗಳು|||INR|ಭಾರತೀಯ ರೂಪಾಯಿ||ಭಾರತೀಯ ರೂಪಾಯಿ||||ಭಾರತೀಯ ರೂಪಾಯಿಗಳು|||IQD|ಇರಾಕಿ ದಿನಾರ್||ಇರಾಕಿ ದಿನಾರ್||||ಇರಾಕಿ ದಿನಾರ್‌ಗಳು|||IRR|ಇರಾನಿಯನ್ ರಿಯಲ್||ಇರಾನಿಯನ್ ರಿಯಲ್||||ಇರಾನಿಯನ್ ರಿಯಲ್‌ಗಳು|||ISK|ಐಸ್‌ಲ್ಯಾಂಡಿಕ್ ಕ್ರೋನಾ|||||||||JMD|ಜಮೈಕನ್ ಡಾಲರ್||ಜಮೈಕನ್ ಡಾಲರ್||||ಜಮೈಕನ್ ಡಾಲರ್‌ಗಳು|||JOD|ಜೋರ್ಡಾನಿಯನ್ ದಿನಾರ್||ಜೋರ್ಡಾನಿಯನ್ ದಿನಾರ್||||ಜೋರ್ಡಾನಿಯನ್ ದಿನಾರ್‌ಗಳು|||JPY|ಜಪಾನೀಸ್ ಯೆನ್|||||||||KES|ಕೀನ್ಯಾದ ಶಿಲ್ಲಿಂಗ್‌||ಕೀನ್ಯಾದ ಶಿಲ್ಲಿಂಗ್‌||||ಕೀನ್ಯಾದ ಶಿಲ್ಲಿಂಗ್‌ಗಳು|||KGS|ಕಿರ್ಗಿಸ್ತಾನಿ ಸೋಮ್|||||||||KHR|ಕಾಂಬೋಡಿಯನ್ ರಿಯಲ್||ಕಾಂಬೋಡಿಯನ್ ರಿಯಲ್||||ಕಾಂಬೋಡಿಯನ್ ರಿಯಲ್‍ಗಳು|||KMF|ಕೊಮೊರಿಯನ್ ಫ್ರಾಂಕ್||ಕೊಮೊರಿಯನ್ ಫ್ರಾಂಕ್||||ಕೊಮೊರಿಯನ್ ಫ್ರಾಂಕ್‍ಗಳು|||KPW|ಉತ್ತರ ಕೊರಿಯನ್ ವೋನ್|||||||||KRW|ದಕ್ಷಿಣ ಕೊರಿಯನ್ ವೊನ್|||||||||KWD|ಕುವೈತೀ ದಿನಾರ್||ಕುವೈತೀ ದಿನಾರ್||||ಕುವೈತೀ ದಿನಾರ್‌ಗಳು|||KYD|ಕೆಮ್ಯಾನ್‌ ಐಲ್ಯಾಂಡ್‌ನ ಡಾಲರ್‌||ಕೆಮ್ಯಾನ್‌ ಐಲ್ಯಾಂಡ್‌ನ ಡಾಲರ್‌||||ಕೆಮ್ಯಾನ್‌ ಐಲ್ಯಾಂಡ್‌ನ ಡಾಲರ್‌‌ಗಳು|||KZT|ಕಜಾಕಿಸ್ತಾನಿ ತೆಂಗೆ||ಕಜಾಕಿಸ್ತಾನಿ ತೆಂಗೆ||||ಕಜಾಕಿಸ್ತಾನಿ ತೆಂಗೆಗಳು|||LAK|ಲೋಟಿಯನ್ ಕಿಪ್||ಲೋಟಿಯನ್ ಕಿಪ್||||ಲೋಟಿಯನ್ ಕಿಪ್‍ಗಳು|||LBP|ಲೆಬೆನೀಸ್ ಪೌಂಡ್||ಲೆಬೆನೀಸ್ ಪೌಂಡ್||||ಲೆಬೆನೀಸ್ ಪೌಂಡ್‍ಗಳು|||LKR|ಶ್ರೀಲಂಕಾದ ರುಪೀ||ಶ್ರೀಲಂಕಾದ ರುಪೀ||||ಶ್ರೀಲಂಕಾದ ರುಪೀಗಳು|||LRD|ಲಿಬೇರಿಯನ್ ಡಾಲರ್||ಲಿಬೇರಿಯನ್ ಡಾಲರ್||||ಲಿಬೇರಿಯನ್ ಡಾಲರ್‌ಗಳು|||LSL|ಲೆಸೊತೊ ಲೊತಿ||ಲೆಸೊತೊ ಲೊತಿ||||ಲೆಸೊತೊ ಲೊತಿಗಳು|||LYD|ಲಿಬಿಯಾದ ದಿನಾರ್‌||ಲಿಬಿಯಾದ ದಿನಾರ್‌||||ಲಿಬಿಯಾದ ದಿನಾರ್‌‍ಗಳು|||MAD|ಮೊರೊಕನ್ ದಿರ್‌ಹಮ್||ಮೊರೊಕನ್ ದಿರ್‌ಹಮ್||||ಮೊರೊಕನ್ ದಿರ್‌ಹಮ್‌ಗಳು|||MDL|ಮಲ್ದೋವಾದ ಲೆವೂ||ಮಲ್ದೋವಾದ ಲೆವೂ||||ಮಲ್ದೋವಾದ ಲೆಯ್|||MGA|ಮಲಗಾಸಿ ಅರಿಯಾರಿ||ಮಲಗಾಸಿ ಅರಿಯಾರಿ||||ಮಲಗಾಸಿ ಅರಿಯಾರಿಗಳು|||MKD|ಮೆಸಡೋನಿಯನ್ ದಿನಾರ್||ಮೆಸಡೋನಿಯನ್ ದಿನಾರ್||||ಮೆಸಡೋನಿಯನ್ ದಿನಾರಿ|||MMK|ಮ್ಯಾನ್ಮಾರ್ ಕ್ಯಾಟ್||ಮ್ಯಾನ್ಮಾರ್ ಕ್ಯಾಟ್||||ಮ್ಯಾನ್ಮಾರ್ ಕ್ಯಾಟ್‍ಗಳು|||MNT|ಮಂಗೋಲಿಯಾದ ತುಗ್ರಿಕ್‌‌||ಮಂಗೋಲಿಯಾದ ತುಗ್ರಿಕ್‌‌||||ಮಂಗೋಲಿಯಾದ ತುಗ್ರಿಕ್‌‌‌ಗಳು|||MOP|ಮಕಾನಿಸ್ ಪಟಾಕಾ||ಮಕಾನಿಸ್ ಪಟಾಕಾ||||ಮಕಾನಿಸ್ ಪಟಾಕಾಗಳು|||MRU|ಮೌರೀಶಿಯನಿಯನ್ ಒಗಿಯ||ಮೌರೀಶಿಯನಿಯನ್ ಒಗಿಯ||||ಮೌರೀಶಿಯನಿಯನ್ ಒಗಿಯಗಳು|||MUR|ಮಾರಿಷಿಯನ್ ರುಪಿ||ಮಾರಿಷಿಯನ್ ರುಪಿ||||ಮಾರಿಷಿಯನ್ ರುಪಿಗಳು|||MVR|ಮಾಲ್ಡೀವಿಯನ್ ರುಫಿಯಾ||ಮಾಲ್ಡೀವಿಯನ್ ರುಫಿಯಾ||||ಮಾಲ್ಡೀವಿಯನ್ ರುಫಿಯಾಗಳು|||MWK|ಮಲಾವಿಯ ಕ್ವಾಚ||ಮಲಾವಿಯ ಕ್ವಾಚ||||ಮಲಾವಿಯ ಕ್ವಾಚಗಳು|||MXN|ಮೆಕ್ಸಿಕೊದ ಪೆಸೊ||ಮೆಕ್ಸಿಕೊದ ಪೆಸೊ||||ಮೆಕ್ಸಿಕೊದ ಪೆಸೊಗಳು|||MYR|ಮಲೇಶಿಯನ್ ರಿಂಗಿಟ್||ಮಲೇಶಿಯನ್ ರಿಂಗಿಟ್||||ಮಲೇಶಿಯನ್ ರಿಂಗಿಟ್‌ಗಳು|||MZN|ಮೊಝಾಂಬಿಕನ್ ಮೆಟಿಕಲ್||ಮೊಝಾಂಬಿಕನ್ ಮೆಟಿಕಲ್||||ಮೊಝಾಂಬಿಕನ್ ಮೆಟಿಕಲ್‍ಗಳು|||NAD|ನಮೀಬಿಯನ್ ಡಾಲರ್||ನಮೀಬಿಯನ್ ಡಾಲರ್||||ನಮೀಬಿಯನ್ ಡಾಲರ್‌‍ಗಳು|||NGN|ನೈಜೀರಿಯಾದ ನೇರಾ||ನೈಜೀರಿಯಾದ ನೇರಾ||||ನೈಜೀರಿಯಾದ ನೇರಾಗಳು|||NIO|ನಿಕಾರಗ್ವಾದ ಕರ್ದೊಬಾ||ನಿಕಾರಗ್ವಾದ ಕರ್ದೊಬಾ||||ನಿಕಾರಗ್ವಾದ ಕರ್ದೊಬಾಗಳು|||NOK|ನಾರ್ವೇಯ ಕ್ರೋನ್||ನಾರ್ವೇಯ ಕ್ರೋನ್||||ನಾರ್ವೇಯ ಕ್ರೋನರ್|||NPR|ನೇಪಾಳದ ರುಪೀ||ನೇಪಾಳದ ರುಪೀ||||ನೇಪಾಳದ ರುಪೀಗಳು||