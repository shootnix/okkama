// Bind one selected numeric system and the closest CLDR pattern profile.
// Symbols can fall back separately when the local pattern uses another system.
role NumberCompactData {keys() is @string;has(key is string) is bool;value(key is string) is string;}
object NumberCompacts does NumberCompactData {
    has origin is %string:string;NumberCompacts(origin is %string:string){self.origin=origin;}
    keys() is @string{origin.keys();}has(key is string) is bool{origin.has(key);}value(key is string) is string{origin[key];}
}
role NumberRenderingData {
