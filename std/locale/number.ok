module locale/number v1.0.0;

// Numbers as a locale writes them, and read back (CLDR 46.1).
//
//     let format = NumberFormat(notation: NumberNotation.standard, grouping: NumberGrouping.automatic,
//         sign: NumberSign.automatic,
//         precision: NumberPrecision(minimum_integer: 1, minimum_fraction: 2, maximum_fraction: 2, rounding: Rounding.half_even));
//     LocalizedDecimal(origin: Decimal("1234567.891"), locale: Locale("de"), format: format).string();   // "1.234.567,89"
//     LocalizedPercent(origin: Decimal("0.25"), locale: Locale("fr"), format: format, scale: PercentScale.percent).string();
//     LocalizedDecimalFromString(origin: "1.234.567,89", locale: Locale("de"), format: format).decimal();
//
// Notations: standard, scientific, engineering and compact ("1.2K"). Digits
// come from the locale's numbering system (Arabic-Indic for ar, and so on).

import "locale/tag" take Locale, LocaleExtensions;
import "locale/data" take LocaleFallbacks;
import "locale/internal/numbers" take CldrNumbers;
import "math/decimal" take Decimal, InvalidDecimal;
import "math/rounding" take Rounding;
import "numbers/bigint" take BigInt;
import "numbers/float" take ShortestFloat;
import "strings/parse" take Number;
import "compare" take Order;
import "i18n/plural" take PluralNumber, PluralCategoryOf, PluralKind, PluralCategory;

// Standard, scientific, engineering, or compact short or long.
enum NumberNotation = (standard, scientific, engineering, compact_short, compact_long);

// Whether digits are grouped: never, as the locale does, always, or from two
// groups up.
enum NumberGrouping = (never, automatic, always, minimum_two);

// When a sign is shown.
enum NumberSign = (automatic, always, except_zero, negative_only, never);

// Percent (×100) or per mille (×1000).
enum PercentScale = (percent, per_mille);

// NaN and the infinities.
enum NumberSpecial = (not_a_number, positive_infinity, negative_infinity);

// Precision is a policy, not a rounded value. All seven Rounding modes apply.
object NumberPrecision {
    has minimum_integer, minimum_fraction, maximum_fraction is int;
    has rounding is Rounding;

    // Integer and fraction digits and how to round; InvalidNumberFormat for
    // minimum_integer outside 1..1024 or minimum_fraction above
    // maximum_fraction.
    NumberPrecision(
        minimum_integer is int,
        minimum_fraction is int,
        maximum_fraction is int,
        rounding is Rounding
    ) {
        confirm minimum_integer >= 1
            && minimum_integer <= 1024
            && minimum_fraction >= 0
            && minimum_fraction <= maximum_fraction
            && maximum_fraction <= 1024
            else throw InvalidNumberFormat.because(
                "integer 1..1024, fraction 0..1024 and minimum <= maximum required"
            );
        self.minimum_integer = minimum_integer;
        self.minimum_fraction = minimum_fraction;
        self.maximum_fraction = maximum_fraction;
        self.rounding = rounding;
    }

    // The minimum integer digits, the fraction range and the rounding.
    cap Digits {
        minimum_integer is int {
            minimum_integer;
        }

        minimum_fraction is int {
            minimum_fraction;
        }

        maximum_fraction is int {
            maximum_fraction;
        }

        rounding is Rounding {
            rounding;
        }
    }
}

// How a number is written.
object NumberFormat {
    has notation is NumberNotation;
    has grouping is NumberGrouping;
    has sign is NumberSign;
    has precision is NumberPrecision;

    // notation, grouping, sign and precision.
    NumberFormat(
        notation is NumberNotation,
        grouping is NumberGrouping,
        sign is NumberSign,
        precision is NumberPrecision
    ) {
        self.notation = notation;
        self.grouping = grouping;
        self.sign = sign;
        self.precision = precision;
    }

    // The precision.
    precision() is NumberPrecision {
        precision;
    }

    // The notation, grouping and sign.
    cap Style {
        notation is NumberNotation {
            notation;
        }

        grouping is NumberGrouping {
            grouping;
        }

        sign is NumberSign {
            sign;
        }
    }
}

// A format that cannot be used; reason says why.
enum InvalidNumberFormat is Error = (because(reason is string));

// Text that is not a number in the locale; reason says why.
enum InvalidLocalizedNumber is Error = (because(reason is string));

hidden object NumberDataRow {
    has values, names, ids is @string;

    NumberDataRow(values is @string) {
        self.values = values;
        names = if values.size() == 7 {
            values[5].split(",");
        }
        else {
            [];
        };
        ids = if values.size() == 7 {
            values[6].split(",");
        }
        else {
            [];
        };
    }

    available() is bool {
        values.size() == 7;
    }

    default_system() is string {
        values[0];
    }

    special_system(name is string) is string {
        let index = match name {
            case "native" {
                1;
            }
            case "traditio" {
                2;
            }
            case "finance" {
                3;
            }
            else {
                0;
            }
        };
        if values[index] == "" {
            values[0];
        }
        else {
            values[index];
        }
    }

    minimum_grouping() is int {
        Number(values[4]).int();
    }

    id(system is string) is int {
        for (0..names.size()) -> index {
            if names[index] == system {
                return Number(ids[index]).int();
            }
        }
        -1;
    }
}

// A CLDR number pattern, taken apart.
object NumberPattern {
    has values is @string;

    // The pattern's positive and negative forms.
    NumberPattern(values is @string) {
        confirm values.size() == 8
            else throw InvalidLocalizedNumber.because("number pattern shape");
        self.values = values;
    }

    // The text before the number.
    prefix(negative is bool) is string {
        values[if negative {
            2;
        }
        else {
            0;
        }];
    }

    // The text after the number.
    suffix(negative is bool) is string {
        values[if negative {
            3;
        }
        else {
            1;
        }];
    }

    // The primary group size.
    primary() is int {
        Number(values[4]).int();
    }

    // The secondary group size.
    secondary() is int {
        Number(values[5]).int();
    }

    // The minimum exponent digits.
    exponent_digits() is int {
        Number(values[6]).int();
    }

    // The zeros of a compact pattern.
    zeros() is int {
        Number(values[7]).int();
    }
}

// Bind one selected numeric system and the closest CLDR pattern profile.
// Symbols can fall back separately when the local pattern uses another system.
role NumberCompactData {
    // The magnitudes it has forms for.
    keys() is @string;
    // Whether it has a form for key.
    has(key is string) is bool;
    // The form for key.
    value(key is string) is string;
}

hidden object NumberCompacts does NumberCompactData {
    has origin is %string:string;

    NumberCompacts(origin is %string:string) {
        self.origin = origin;
    }

    keys() is @string {
        origin.keys();
    }

    has(key is string) is bool {
        origin.has(key);
    }

    value(key is string) is string {
        origin[key];
    }
}

// The number data a locale renders with.
role NumberRenderingData {
    // The number symbol of index: decimal separator, group separator, minus and
    // so on.
    symbol(index is int) is string;
    // The ten digits of the numbering system.
    digits() is string;
    // How many integer digits it takes before grouping starts.
    minimum_grouping() is int;
    // The pattern of a kind: decimal, percent, currency, accounting or
    // scientific.
    pattern(kind is int) is NumberPattern;
    // The compact forms, long or short.
    compact(long is bool) is NumberCompactData;
    // origin fitted into the percent or per-mille pattern, positive or
    // negative.
    template(origin is string, positive is bool, per_mille is bool) is string;
    // ASCII digits and symbols in origin replaced by the locale's.
    localized(origin is string) is string;
}

// The number data of a locale.
object NumberLocaleData does NumberRenderingData {
    has table is CldrNumbers;
    has symbols, patterns is @string;
    has digits is string;
    has profile, minimum_grouping is int;
    has system is string;

    // The data of locale.
    NumberLocaleData(locale is Locale) {
        let table = CldrNumbers();
        let chain = LocaleFallbacks(locale);
        let candidates is @NumberDataRow = (0..chain.size()).map() -> index {
            NumberDataRow(table.row(chain.item(index).string()));
        };
        let rows is @NumberDataRow = candidates.filter() -> row {
            row.available();
        };
        confirm rows.size() > 0
            else throw InvalidLocalizedNumber.because("missing pinned root data");
        let first = rows[0];
        let preferences = LocaleExtensions(locale).unicode();
        let requested = (0..preferences.size()).reduce(first.default_system()) -> system, index {
            let keyword = preferences.item(index);
            if keyword.key() == "nu" {
                let values = keyword.values();
                confirm values.size() == 1
                    else throw InvalidLocalizedNumber.because("nu requires one numbering system");
                let selected = values.item(0);
                if selected == "native" || selected == "traditio" || selected == "finance" {
                    first.special_system(selected);
                }
                else {
                    selected;
                }
            }
            else {
                system;
            }
        };
        let digits = table.digits(requested);
        confirm digits.length() == 10
            else throw InvalidLocalizedNumber.because(
                "unsupported numeric numbering system: " + requested
            );
        let id = (0..rows.size()).reduce(-1) -> chosen, index {
            if chosen >= 0 {
                chosen;
            }
            else {
                rows[index].id(requested);
            }
        };
        confirm id >= 0
            else throw InvalidLocalizedNumber.because("missing numbering-system symbols");
        let local = first.id(requested);
        let profile = if local >= 0 {
            local;
        }
        else {
            first.id(first.default_system());
        };
        self.table = table;
        self.symbols = table.profile(id);
        self.patterns = table.profile(profile);
        self.profile = profile;
        self.digits = digits;
        self.system = requested;
        minimum_grouping = first.minimum_grouping();
    }

    // The numbering system, such as `latn` or `arab`.
    system() is string {
        system;
    }

    // The number symbol of index: decimal separator, group separator, minus and
    // so on.
    symbol(index is int) is string {
        symbols[index];
    }

    // The ten digits of the numbering system.
    digits() is string {
        digits;
    }

    // How many integer digits it takes before grouping starts.
    minimum_grouping() is int {
        minimum_grouping;
    }

    // The pattern of a kind: decimal, percent, currency, accounting or
    // scientific.
    pattern(kind is int) is NumberPattern {
        let start = 9 + kind * 8;
        let values is @string = (start..start + 8).map() -> index {
            patterns[index];
        };
        NumberPattern(values);
    }

    // The compact forms, long or short.
    compact(long is bool) is NumberCompactData {
        NumberCompacts(table.compact(profile, long));
    }

    // origin fitted into the percent or per-mille pattern, positive or
    // negative.
    template(origin is string, positive is bool, per_mille is bool) is string {
        let source = if positive {
            origin.replace("{minus}", "{plus}");
        }
        else {
            origin;
        };
        source.replace("{minus}", symbols[3]).replace("{plus}", symbols[2]).replace(
            "{percent}",
            if per_mille {
                symbols[5];
            }
            else {
                symbols[4];
            }
        ).replace("{permille}", symbols[5]);
    }

    // ASCII digits in this locale's numbering system, other characters as
    // they are; Latin digits leave the text unchanged (#176).
    localized(origin is string) is string {
        if digits == "0123456789" {
            return origin;
        }
        let local = digits.characters();
        let fragments is @string = origin.characters().map() -> character {
            let code = character.code();
            if code >= 48 && code <= 57 {
                local[code - 48].string();
            }
            else {
                character.string();
            }
        };
        fragments.join("");
    }
}

// An exact number: coefficient × 10^exponent, with a sign.
object NumberMagnitude {
    has coefficient is BigInt;
    has exponent is rat;
    has negative is bool;

    // As given.
    NumberMagnitude(coefficient is BigInt, exponent is rat, negative is bool) {
        confirm coefficient.sign() >= 0
            && coefficient.string().length() <= 1024
            && exponent.denominator() == "1"
            else throw InvalidLocalizedNumber.because(
                "nonnegative coefficient up to 1024 digits and integral exponent required"
            );
        self.coefficient = coefficient;
        self.exponent = exponent;
        self.negative = negative;
    }

    // The coefficient.
    coefficient() is BigInt {
        coefficient;
    }

    // The exponent.
    exponent() is rat {
        exponent;
    }

    // Whether it is negative (−0 too).
    negative() is bool {
        negative;
    }

    // Its value.
    magnitude() is rat {
        if coefficient.sign() == 0 {
            0.rat();
        }
        else {
            exponent + (coefficient.string().length() - 1).rat();
        }
    }

    // It times 10^power.
    scaled(power is rat) is NumberMagnitude {
        NumberMagnitude(coefficient: coefficient, exponent: exponent - power, negative: negative);
    }
}

// A Decimal as a magnitude.
object DecimalNumberMagnitude {
    has value is NumberMagnitude;

    // origin times 10^shift; negative_zero keeps −0.
    DecimalNumberMagnitude(origin is Decimal, shift is int, negative_zero is bool) {
        let coefficient = origin.coefficient();
        let absolute = if coefficient.sign() < 0 {
            (BigInt(0) - coefficient);
        }
        else {
            coefficient;
        };
        value = NumberMagnitude(
            coefficient: absolute,
            exponent: origin.exponent().rat() + shift.rat(),
            negative: coefficient.sign() < 0 || negative_zero
        );
    }

    // The magnitude.
    magnitude() is NumberMagnitude {
        value;
    }
}

// Scaled integer arithmetic avoids float intermediates and huge-exponent powers.
// Very small magnitudes can be directed to zero/one without allocating 10^N.
object NumberQuantized {
    has coefficient is BigInt;
    has scale is int;
    has negative is bool;

    // origin rounded to precision.
    NumberQuantized(origin is NumberMagnitude, precision is NumberPrecision) {
        let absolute = origin.coefficient();
        let shift = origin.exponent() + precision::Digits::maximum_fraction.rat();
        let coefficient = if absolute.sign() == 0 {
            BigInt(0);
        }
        else {
            if shift >= 0.rat() {
                confirm shift <= 2048.rat()
                    && absolute.string().length().rat() + shift <= 2048.rat()
                    else throw InvalidLocalizedNumber.because("integer/output digit budget");
                (absolute * BigInt(10).power(shift.int(), 8192));
            }
            else {
                if shift < (-1025).rat() {
                    let direction = precision::Digits::rounding;
                    let up = direction == Rounding.away_from_zero
                        || (direction == Rounding.floor && origin.negative())
                        || (direction == Rounding.ceiling && !origin.negative());
                    if up {
                        BigInt(1);
                    }
                    else {
                        BigInt(0);
                    }
                }
                else {
                    let divisor = BigInt(10).power((-shift).int(), 8192);
                    let quotient = (absolute / divisor);
                    let remainder = (absolute % divisor);
                    let increment = NumberRounding(
                        quotient: quotient,
                        remainder: remainder,
                        divisor: divisor,
                        negative: origin.negative(),
                        direction: precision::Digits::rounding
                    ).increment();
                    if increment {
                        (quotient + BigInt(1));
                    }
                    else {
                        quotient;
                    }
                }
            }
        };
        confirm coefficient.string().length() - precision::Digits::maximum_fraction <= 1024
            else throw InvalidLocalizedNumber.because("integer exceeds 1024 digits");
        self.coefficient = coefficient;
        scale = precision::Digits::maximum_fraction;
        negative = origin.negative();
    }

    // The rounded coefficient.
    coefficient() is BigInt {
        coefficient;
    }

    // Whether it is negative.
    negative() is bool {
        negative;
    }

    // Whether it rounded to zero.
    zero() is bool {
        coefficient.sign() == 0;
    }

    // The integer digits.
    whole() is string {
        let text = coefficient.string();
        if text.length() <= scale {
            "0";
        }
        else {
            text.slice(0, text.length() - scale);
        }
    }

    // The fraction digits, at least minimum.
    fraction(minimum is int) is string {
        let text = coefficient.string();
        let fraction = if text.length() <= scale {
            NumberZeroes(scale - text.length()).string() + text;
        }
        else {
            text.slice(text.length() - scale, text.length());
        };
        let figures = fraction.characters();
        let end = (minimum..figures.size()).reduce(minimum) -> position, index {
            if figures[index].code() != 48 {
                index + 1;
            }
            else {
                position;
            }
        };
        fraction.slice(0, end);
    }

    // The number in ASCII, at least minimum fraction digits.
    ascii(minimum is int) is string {
        let fraction = self.fraction(minimum);
        self.whole() + (if fraction == "" {
            "";
        }
        else {
            "." + fraction;
        });
    }

    // The rounded magnitude.
    magnitude() is NumberMagnitude {
        DecimalNumberMagnitude(
            origin: Decimal(coefficient.string() + "e" + (-scale).string()),
            shift: 0,
            negative_zero: negative
        ).magnitude();
    }
}

// A run of zeros.
object NumberZeroes {
    has count is int;

    // count zeros.
    NumberZeroes(count is int) {
        confirm count >= 0 && count <= 2048
            else throw InvalidLocalizedNumber.because("zero padding budget");
        self.count = count;
    }

    // The zeros.
    string() is string {
        let zeros is @string = (0..count).map() -> index {
            "0";
        };
        zeros.join("");
    }
}

hidden object NumberRounding {
    has quotient, remainder, divisor is BigInt;
    has negative is bool;
    has direction is Rounding;

    NumberRounding(
        quotient is BigInt,
        remainder is BigInt,
        divisor is BigInt,
        negative is bool,
        direction is Rounding
    ) {
        self.quotient = quotient;
        self.remainder = remainder;
        self.divisor = divisor;
        self.negative = negative;
        self.direction = direction;
    }

    increment() is bool {
        if remainder.sign() == 0 {
            return false;
        }
        match direction {
            case Rounding.toward_zero {
                false;
            }
            case Rounding.away_from_zero {
                true;
            }
            case Rounding.floor {
                negative;
            }
            case Rounding.ceiling {
                !negative;
            }
            else {
                let twice = (remainder * BigInt(2)).order(divisor);
                if twice == Order.greater {
                    true;
                }
                else {
                    if twice == Order.less {
                        false;
                    }
                    else {
                        if direction == Rounding.half_up {
                            true;
                        }
                        else {
                            if direction == Rounding.half_down {
                                false;
                            }
                            else {
                                (quotient % BigInt(2)).sign() != 0;
                            }
                        }
                    }
                }
            }
        }
    }
}

hidden object NumberMantissa {
    has origin is NumberQuantized;
    has data is NumberRenderingData;
    has format is NumberFormat;
    has pattern is NumberPattern;
    has grouped is bool;

    NumberMantissa(
        origin is NumberQuantized,
        data is NumberRenderingData,
        format is NumberFormat,
        pattern is NumberPattern,
        grouped is bool
    ) {
        self.origin = origin;
        self.data = data;
        self.format = format;
        self.pattern = pattern;
        self.grouped = grouped;
    }

    string() is string {
        let raw = origin.whole();
        let minimum = format.precision()::Digits::minimum_integer;
        let whole = (if raw.length() < minimum {
            NumberZeroes(minimum - raw.length()).string();
        }
        else {
            "";
        }) + raw;
        let grouping = format::Style::grouping;
        let primary = pattern.primary();
        let secondary = pattern.secondary();
        let threshold = if grouping == NumberGrouping.minimum_two {
            2;
        }
        else {
            if grouping == NumberGrouping.always {
                1;
            }
            else {
                data.minimum_grouping();
            }
        };
        let active = grouped
            && grouping != NumberGrouping.never
            && primary > 0
            && secondary > 0
            && whole.length() - primary >= threshold;
        // The grouped ASCII digits are localized once: a group separator is
        // never an ASCII digit (#176).
        let figures = whole.characters();
        let parts is @string = (0..figures.size()).map() -> index {
            let right = figures.size() - index;
            (if active && index > 0 && right >= primary && (right - primary) % secondary == 0 {
                data.symbol(1);
            }
            else {
                "";
            }) + figures[index].string();
        };
        let fraction = origin.fraction(format.precision()::Digits::minimum_fraction);
        data.localized(parts.join("")) + (if fraction == "" {
            "";
        }
        else {
            data.symbol(0) + data.localized(fraction);
        });
    }
}

// A number written out, with the pattern it used.
object NumberRendered {
    has text is string;
    has number is NumberQuantized;
    has frames is @NumberPattern;

    // text for number.
    NumberRendered(text is string, number is NumberQuantized) {
        self.text = text;
        self.number = number;
        let frames is @NumberPattern = [];
        self.frames = frames;
    }

    // The same, with its pattern.
    NumberRendered(text is string, number is NumberQuantized, frame is NumberPattern) {
        self.text = text;
        self.number = number;
        frames = [frame];
    }

    // The text.
    text() is string {
        text;
    }

    // The number.
    number() is NumberQuantized {
        number;
    }

    // Its pattern, or fallback.
    frame(fallback is NumberPattern) is NumberPattern {
        if frames.size() == 0 {
            fallback;
        }
        else {
            frames[0];
        }
    }
}

hidden object NumberExponent {
    has origin is rat;
    has data is NumberRenderingData;
    has minimum is int;

    NumberExponent(origin is rat, data is NumberRenderingData, minimum is int) {
        self.origin = origin;
        self.data = data;
        self.minimum = minimum;
    }

    string() is string {
        let negative = origin < 0.rat();
        let digits = (if negative {
            -origin;
        }
        else {
            origin;
        }).numerator();
        let padded = (if digits.length() < minimum {
            NumberZeroes(minimum - digits.length()).string();
        }
        else {
            "";
        }) + digits;
        data.symbol(6) + (if negative {
            data.symbol(3);
        }
        else {
            "";
        }) + data.localized(padded);
    }
}

// Writes a magnitude in a locale.
object NumberPrinting {
    has origin is NumberMagnitude;
    has locale is Locale;
    has format is NumberFormat;
    has data is NumberRenderingData;
    has percent, per_mille is bool;

    // origin in locale with format, as a percent or per mille or not.
    NumberPrinting(
        origin is NumberMagnitude,
        locale is Locale,
        format is NumberFormat,
        percent is bool,
        per_mille is bool
    ) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
        self.percent = percent;
        self.per_mille = per_mille;
        data = NumberLocaleData(locale);
    }

    // The same with explicit data.
    NumberPrinting(
        origin is NumberMagnitude,
        locale is Locale,
        format is NumberFormat,
        percent is bool,
        per_mille is bool,
        data is NumberRenderingData
    ) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
        self.percent = percent;
        self.per_mille = per_mille;
        self.data = data;
    }

    // The text.
    string() is string {
        self.rendering().text();
    }

    // The text with its number and pattern.
    rendering() is NumberRendered {
        let notation = format::Style::notation;
        let scientific = notation == NumberNotation.scientific
            || notation == NumberNotation.engineering;
        let fallback = data.pattern(if percent {
            2;
        }
        else {
            if scientific {
                1;
            }
            else {
                0;
            }
        });
        let rendered = match notation {
            case NumberNotation.standard {
                self.standard(origin, fallback);
            }
            case NumberNotation.scientific {
                self.exponential(false);
            }
            case NumberNotation.engineering {
                self.exponential(true);
            }
            else {
                self.compacted(notation == NumberNotation.compact_long);
            }
        };
        let pattern = rendered.frame(fallback);
        let value = rendered.number();
        let sign = format::Style::sign;
        let nonzero = !value.zero();
        let minus = value.negative()
            && sign != NumberSign.never
            && (sign != NumberSign.except_zero || nonzero)
            && (sign != NumberSign.negative_only || nonzero);
        let plus = !value.negative()
            && (sign == NumberSign.always || (sign == NumberSign.except_zero && nonzero));
        // Accounting negatives may have parentheses and no minus placeholder.
        // An explicit positive sign uses the positive frame in that case.
        let signed_frame = pattern.prefix(true).split("{minus}").size() > 1
            || pattern.suffix(true).split("{minus}").size() > 1;
        let negative_frame = minus || (plus && signed_frame);
        let text = (if plus && !signed_frame {
            data.symbol(2);
        }
        else {
            "";
        }) + data.template(pattern.prefix(negative_frame), plus, per_mille) + rendered.text() + data.template(
            pattern.suffix(negative_frame),
            plus,
            per_mille
        );
        confirm text.length() <= 8192
            else throw InvalidLocalizedNumber.because("output exceeds 8192 scalars");
        NumberRendered(text: text, number: value);
    }

    hidden standard(value is NumberMagnitude, pattern is NumberPattern) is NumberRendered {
        let rounded = NumberQuantized(origin: value, precision: format.precision());
        NumberRendered(
            text: NumberMantissa(
                origin: rounded,
                data: data,
                format: format,
                pattern: pattern,
                grouped: true
            ).string(),
            number: rounded
        );
    }

    hidden exponential(engineering is bool) is NumberRendered {
        let magnitude = origin.magnitude();
        let remainder = if engineering {
            let rest = Number((BigInt(magnitude.numerator()) % BigInt(3)).string()).int();
            if rest < 0 {
                rest + 3;
            }
            else {
                rest;
            }
        }
        else {
            0;
        };
        let power = magnitude - remainder.rat();
        let rounded = NumberQuantized(origin: origin.scaled(power), precision: format.precision());
        let limit = if engineering {
            3;
        }
        else {
            1;
        };
        let carried = rounded.whole().length() > limit;
        let exponent = power + (if carried {
            limit.rat();
        }
        else {
            0.rat();
        });
        let number = if carried {
            NumberQuantized(origin: origin.scaled(exponent), precision: format.precision());
        }
        else {
            rounded;
        };
        let pattern = data.pattern(1);
        let minimum = if pattern.exponent_digits() > 0 {
            pattern.exponent_digits();
        }
        else {
            1;
        };
        let body = NumberMantissa(
            origin: number,
            data: data,
            format: format,
            pattern: pattern,
            grouped: false
        ).string() + NumberExponent(
            origin: exponent,
            data: data,
            minimum: minimum
        ).string();
        let text = if percent {
            data.template(pattern.prefix(false), false, per_mille) + body + data.template(
                pattern.suffix(false),
                false,
                per_mille
            );
        }
        else {
            body;
        };
        NumberRendered(text: text, number: number);
    }

    hidden compacted(long is bool) is NumberRendered {
        let entries = data.compact(long);
        let initial = self.bucket(entries, origin.magnitude());
        // Ordinary rounding may cross the first compact threshold, or a CLDR
        // bucket whose literal "0" means ordinary notation (e.g. Chinese 1000).
        let selected = if initial < 0 || entries.value(initial.string() + ":other") == "" {
            let ordinary = NumberQuantized(origin: origin, precision: format.precision());
            let raised = self.bucket(entries, ordinary.magnitude().magnitude());
            if raised > initial {
                raised;
            }
            else {
                initial;
            }
        }
        else {
            initial;
        };
        if selected < 0 {
            return self.standard(origin, data.pattern(0));
        }
        let key = selected.string() + ":other";
        let encoded = entries.value(key);
        if encoded == "" {
            return self.standard(origin, data.pattern(0));
        }
        let pattern = NumberPattern(encoded.split("|"));
        let scale = selected - pattern.zeros() + 1;
        let rounded = NumberQuantized(
            origin: origin.scaled(scale.rat()),
            precision: format.precision()
        );
        let raised = self.bucket(entries, rounded.magnitude().magnitude() + scale.rat());
        let bucket = if raised > selected {
            raised;
        }
        else {
            selected;
        };
        let base_text = entries.value(bucket.string() + ":other");
        if base_text == "" {
            return self.standard(origin, data.pattern(0));
        }
        let base = NumberPattern(base_text.split("|"));
        let power = bucket - base.zeros() + 1;
        let number = NumberQuantized(
            origin: origin.scaled(power.rat()),
            precision: format.precision()
        );
        let spelling = number.ascii(format.precision()::Digits::minimum_fraction);
        confirm spelling.length() <= 1024
            else throw InvalidLocalizedNumber.because("compact plural operand exceeds 1024 scalars");
        let exact = number.magnitude();
        let category = if exact.coefficient().string() == "1"
            && exact.exponent() == 0.rat()
            && entries.has(bucket.string() + ":1") {
                "1";
            }
            else {
                match PluralCategoryOf(
                    origin: PluralNumber(spelling),
                    locale: locale,
                    kind: PluralKind.cardinal
                ).category() {
                    case PluralCategory.zero {
                        "zero";
                    }
                    case PluralCategory.one {
                        "one";
                    }
                    case PluralCategory.two {
                        "two";
                    }
                    case PluralCategory.few {
                        "few";
                    }
                    case PluralCategory.many {
                        "many";
                    }
                    else {
                        "other";
                    }
                }
            };
        let chosen = bucket.string() + ":" + category;
        let final = if entries.has(chosen) {
            entries.value(chosen);
        }
        else {
            entries.value(bucket.string() + ":other");
        };
        if final == "" {
            return self.standard(origin, data.pattern(0));
        }
        let selected_pattern = NumberPattern(final.split("|"));
        let numeric = if selected_pattern.zeros() == 0 {
            "";
        }
        else {
            NumberMantissa(
                origin: number,
                data: data,
                format: format,
                pattern: data.pattern(0),
                grouped: true
            ).string();
        };
        if percent {
            NumberRendered(
                text: data.template(selected_pattern.prefix(false), false, per_mille) + numeric + data.template(
                    selected_pattern.suffix(false),
                    false,
                    per_mille
                ),
                number: number
            );
        }
        else {
            NumberRendered(text: numeric, number: number, frame: selected_pattern);
        }
    }

    hidden bucket(entries is NumberCompactData, magnitude is rat) is int {
        entries.keys().reduce(-1) -> chosen, key {
            let parts = key.split(":");
            let power = Number(parts[0]).int();
            if parts[1] == "other" && power > chosen && power.rat() <= magnitude {
                power;
            }
            else {
                chosen;
            }
        };
    }
}

// A Decimal in a locale.
object LocalizedDecimal {
    has origin is Decimal;
    has locale is Locale;
    has format is NumberFormat;

    // origin as locale writes it with format.
    LocalizedDecimal(origin is Decimal, locale is Locale, format is NumberFormat) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
    }

    // The text.
    string() is string {
        NumberPrinting(
            origin: DecimalNumberMagnitude(origin: origin, shift: 0, negative_zero: false).magnitude(),
            locale: locale,
            format: format,
            percent: false,
            per_mille: false
        ).string();
    }
}

// An int in a locale.
object LocalizedInteger {
    has origin is int;
    has locale is Locale;
    has format is NumberFormat;

    // origin as locale writes it with format.
    LocalizedInteger(origin is int, locale is Locale, format is NumberFormat) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
    }

    // The text.
    string() is string {
        LocalizedDecimal(origin: Decimal(origin.string()), locale: locale, format: format).string();
    }
}

// A BigInt in a locale.
object LocalizedBigInteger {
    has origin is BigInt;
    has locale is Locale;
    has format is NumberFormat;

    // origin as locale writes it with format.
    LocalizedBigInteger(origin is BigInt, locale is Locale, format is NumberFormat) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
    }

    // The text.
    string() is string {
        confirm origin.string().length() <= 1025
            else throw InvalidLocalizedNumber.because("integer input limit");
        LocalizedDecimal(origin: Decimal(origin.string()), locale: locale, format: format).string();
    }
}

// A float in a locale.
object LocalizedFloat {
    has origin is float;
    has locale is Locale;
    has format is NumberFormat;

    // origin as locale writes it with format; NaN and infinities as the locale
    // names them.
    LocalizedFloat(origin is float, locale is Locale, format is NumberFormat) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
    }

    // The text.
    string() is string {
        let source = ShortestFloat(origin);
        NumberPrinting(
            origin: DecimalNumberMagnitude(
                origin: source.decimal(),
                shift: 0,
                negative_zero: source.negative() && origin == 0.0
            ).magnitude(),
            locale: locale,
            format: format,
            percent: false,
            per_mille: false
        ).string();
    }
}

// A percentage in a locale.
object LocalizedPercent {
    has origin is Decimal;
    has locale is Locale;
    has format is NumberFormat;
    has scale is PercentScale;

    // origin (0.25 for 25 %) as locale writes a percent or per mille.
    LocalizedPercent(
        origin is Decimal,
        locale is Locale,
        format is NumberFormat,
        scale is PercentScale
    ) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
        self.scale = scale;
    }

    // The text.
    string() is string {
        let per_mille = scale == PercentScale.per_mille;
        NumberPrinting(
            origin: DecimalNumberMagnitude(
                origin: origin,
                shift: if per_mille {
                    3;
                }
                else {
                    2;
                },
                negative_zero: false
            ).magnitude(),
            locale: locale,
            format: format,
            percent: true,
            per_mille: per_mille
        ).string();
    }
}

// NaN or an infinity in a locale.
object LocalizedSpecialNumber {
    has origin is NumberSpecial;
    has locale is Locale;
    has sign is NumberSign;

    // origin with sign as locale writes it.
    LocalizedSpecialNumber(origin is NumberSpecial, locale is Locale, sign is NumberSign) {
        self.origin = origin;
        self.locale = locale;
        self.sign = sign;
    }

    // The text.
    string() is string {
        let data = NumberLocaleData(locale);
        if origin == NumberSpecial.not_a_number {
            return data.symbol(7);
        }
        (if origin == NumberSpecial.negative_infinity && sign != NumberSign.never {
            data.symbol(3);
        }
        else {
            if origin == NumberSpecial.positive_infinity
                && (sign == NumberSign.always || sign == NumberSign.except_zero) {
                    data.symbol(2);
                }
                else {
                    "";
                }
        }) + data.symbol(8);
    }
}

hidden object NumberSignedText {
    has text is string;
    has negative is bool;

    NumberSignedText(text is string, negative is bool) {
        self.text = text;
        self.negative = negative;
    }

    text() is string {
        text;
    }

    negative() is bool {
        negative;
    }
}

hidden object NumberAffixReading {
    has origin is string;
    has data is NumberRenderingData;
    has pattern is NumberPattern;
    has sign is NumberSign;

    NumberAffixReading(
        origin is string,
        data is NumberRenderingData,
        pattern is NumberPattern,
        sign is NumberSign
    ) {
        self.origin = origin;
        self.data = data;
        self.pattern = pattern;
        self.sign = sign;
    }

    text() is NumberSignedText {
        if sign != NumberSign.never {
            let negative = self.middle(
                data.template(pattern.prefix(true), false, false),
                data.template(pattern.suffix(true), false, false)
            );
            if negative.size() != 0 {
                return NumberSignedText(text: negative[0], negative: true);
            }
            if sign != NumberSign.negative_only {
                let positive = self.middle(
                    data.template(pattern.prefix(true), true, false),
                    data.template(pattern.suffix(true), true, false)
                );
                if positive.size() != 0 {
                    return NumberSignedText(text: positive[0], negative: false);
                }
            }
        }
        let ordinary = self.middle(
            data.template(pattern.prefix(false), false, false),
            data.template(pattern.suffix(false), false, false)
        );
        confirm ordinary.size() != 0
            else throw InvalidLocalizedNumber.because("number affixes/sign do not match locale");
        NumberSignedText(text: ordinary[0], negative: false);
    }

    hidden middle(prefix is string, suffix is string) is @string {
        if origin.length() < prefix.length() + suffix.length() {
            let empty is @string = [];
            return empty;
        }
        if origin.slice(0, prefix.length()) != prefix
            || origin.slice(origin.length() - suffix.length(), origin.length()) != suffix {
                let empty is @string = [];
                return empty;
            }
        [origin.slice(prefix.length(), origin.length() - suffix.length())];
    }
}

hidden object NumberDigitReading {
    has origin is string;
    has data is NumberRenderingData;

    NumberDigitReading(origin is string, data is NumberRenderingData) {
        self.origin = origin;
        self.data = data;
    }

    string() is string {
        confirm origin.length() > 0 && origin.length() <= 1024
            else throw InvalidLocalizedNumber.because("digit sequence must be 1..1024 scalars");
        let local = data.digits().characters();
        let pieces is @string = origin.characters().map() -> character {
            let code = character.code();
            let position = (0..local.size()).reduce(-1) -> found, at {
                if found < 0 && local[at].code() == code {
                    at;
                }
                else {
                    found;
                }
            };
            confirm position >= 0
                else throw InvalidLocalizedNumber.because("mixed or invalid digit system");
            position.string();
        };
        pieces.join("");
    }
}

hidden object NumberIntegerReading {
    has origin is string;
    has data is NumberRenderingData;
    has grouping is NumberGrouping;

    NumberIntegerReading(origin is string, data is NumberRenderingData, grouping is NumberGrouping) {
        self.origin = origin;
        self.data = data;
        self.grouping = grouping;
    }

    string() is string {
        let parts = origin.split(data.symbol(1));
        confirm parts.size() <= 1024 else throw InvalidLocalizedNumber.because("group count");
        let groups is @string = parts.map() -> part {
            NumberDigitReading(origin: part, data: data).string();
        };
        let count = groups.reduce(0) -> count, part {
            count + part.length();
        };
        confirm count <= 1024 else throw InvalidLocalizedNumber.because("integer digit count");
        if groups.size() > 1 {
            let pattern = data.pattern(0);
            let primary = pattern.primary();
            let secondary = pattern.secondary();
            confirm grouping != NumberGrouping.never && primary > 0 && secondary > 0
                else throw InvalidLocalizedNumber.because("grouping is disabled");
            confirm groups.last().length() == primary && groups[0].length() <= secondary
                else throw InvalidLocalizedNumber.because("misplaced grouping separator");
            for (1..groups.size() - 1) -> index {
                confirm groups[index].length() == secondary
                    else throw InvalidLocalizedNumber.because("misplaced grouping separator");
            }
            let minimum = if grouping == NumberGrouping.minimum_two {
                2;
            }
            else {
                if grouping == NumberGrouping.always {
                    1;
                }
                else {
                    data.minimum_grouping();
                }
            };
            confirm count - primary >= minimum
                else throw InvalidLocalizedNumber.because("grouping below locale threshold");
        }
        groups.join("");
    }
}

// Strict, bounded grammar: no trimming, mixed digits or compact inverse.
// Grouping is optional; when present its widths and minimum threshold must match.
hidden object NumberReading {
    has origin is string;
    has locale is Locale;
    has format is NumberFormat;

    NumberReading(origin is string, locale is Locale, format is NumberFormat) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
    }

    decimal() is Decimal {
        confirm origin.length() > 0 && origin.length() <= 4096
            else throw InvalidLocalizedNumber.because("input must be 1..4096 scalars");
        let notation = format::Style::notation;
        confirm notation != NumberNotation.compact_short && notation != NumberNotation.compact_long
            else throw InvalidLocalizedNumber.because("compact notation has no unambiguous inverse");
        let data = NumberLocaleData(locale);
        let scientific = notation == NumberNotation.scientific
            || notation == NumberNotation.engineering;
        let signed = NumberAffixReading(
            origin: origin,
            data: data,
            pattern: data.pattern(if scientific {
                1;
            }
            else {
                0;
            }),
            sign: format::Style::sign
        ).text();
        let source = signed.text();
        let exponent_parts = if scientific {
            source.split(data.symbol(6));
        }
        else {
            [source];
        };
        confirm exponent_parts.size() == (if scientific {
            2;
        }
        else {
            1;
        })
            else throw InvalidLocalizedNumber.because("exponent separator");
        let decimal_parts = exponent_parts[0].split(data.symbol(0));
        confirm decimal_parts.size() <= 2
            else throw InvalidLocalizedNumber.because("duplicate decimal separator");
        let whole = NumberIntegerReading(
            origin: decimal_parts[0],
            data: data,
            grouping: if scientific {
                NumberGrouping.never;
            }
            else {
                format::Style::grouping;
            }
        ).string();
        let fraction = if decimal_parts.size() == 2 {
            NumberDigitReading(origin: decimal_parts[1], data: data).string();
        }
        else {
            "";
        };
        let precision = format.precision();
        confirm whole.length() >= precision::Digits::minimum_integer
            && fraction.length() >= precision::Digits::minimum_fraction
            && fraction.length() <= precision::Digits::maximum_fraction
            else throw InvalidLocalizedNumber.because("input precision does not match format");
        let exponent = if scientific {
            let frame = NumberAffixReading(
                origin: exponent_parts[1],
                data: data,
                pattern: NumberPattern(["", "", "{minus}", "", "0", "0", "0", "0"]),
                sign: NumberSign.automatic
            ).text();
            let digits = NumberDigitReading(origin: frame.text(), data: data).string();
            let exponent = BigInt((if frame.negative() {
                "-";
            }
            else {
                "";
            }) + digits);
            if notation == NumberNotation.engineering {
                confirm (exponent % BigInt(3)).sign() == 0
                    else throw InvalidLocalizedNumber.because(
                        "engineering exponent must be a multiple of three"
                    );
            }
            "e" + exponent.string();
        }
        else {
            "";
        };
        let text = (if signed.negative() {
            "-";
        }
        else {
            "";
        }) + whole + (if fraction == "" {
            "";
        }
        else {
            "." + fraction;
        }) + exponent;
        try {
            Decimal(text);
        }
        catch error is InvalidDecimal {
            throw InvalidLocalizedNumber.because("decimal exponent outside supported range");
        }
    }
}

// A Decimal read from a locale's text.
object LocalizedDecimalFromString {
    has origin is string;
    has locale is Locale;
    has format is NumberFormat;

    // origin written by locale with format.
    LocalizedDecimalFromString(origin is string, locale is Locale, format is NumberFormat) {
        self.origin = origin;
        self.locale = locale;
        self.format = format;
    }

    // The number; InvalidLocalizedNumber for text that is not one.
    decimal() is Decimal {
        NumberReading(origin: origin, locale: locale, format: format).decimal();
    }
}

// An integer read from a locale's text.
object LocalizedIntegerFromString {
    has origin is string;
    has locale is Locale;
    has grouping is NumberGrouping;

    // origin written by locale with grouping.
    LocalizedIntegerFromString(origin is string, locale is Locale, grouping is NumberGrouping) {
        self.origin = origin;
        self.locale = locale;
        self.grouping = grouping;
    }

    // The integer; InvalidLocalizedNumber for text that is not one.
    integer() is BigInt {
        let format = NumberFormat(
            notation: NumberNotation.standard,
            grouping: grouping,
            sign: NumberSign.automatic,
            precision: NumberPrecision(
                minimum_integer: 1,
                minimum_fraction: 0,
                maximum_fraction: 0,
                rounding: Rounding.toward_zero
            )
        );
        let value = NumberReading(origin: origin, locale: locale, format: format).decimal();
        (value.coefficient() * BigInt(10).power(value.exponent(), 8192));
    }
}

test "exact decimal number rounds before its text is localized" {
    test.is(
        LocalizedDecimal(
            origin: Decimal("1234.567"),
            locale: Locale("en"),
            format: NumberFormat(
                notation: NumberNotation.standard,
                grouping: NumberGrouping.automatic,
                sign: NumberSign.automatic,
                precision: NumberPrecision(1, 2, 2, Rounding.half_even)
            )
        ).string(),
        "1,234.57"
    );
}

test "digits follow the locale's numbering system both ways" {
    let format = NumberFormat(
        notation: NumberNotation.standard,
        grouping: NumberGrouping.automatic,
        sign: NumberSign.automatic,
        precision: NumberPrecision(1, 2, 2, Rounding.half_even)
    );
    let arabic = LocalizedDecimal(
        origin: Decimal("1234567.5"),
        locale: Locale("ar-EG"),
        format: format
    ).string();
    let devanagari = LocalizedDecimal(
        origin: Decimal("1234567.5"),
        locale: Locale("hi-IN-u-nu-deva"),
        format: format
    ).string();
    let german = LocalizedDecimal(
        origin: Decimal("1234567.5"),
        locale: Locale("de"),
        format: format
    ).string();
    test.is(german, "1.234.567,50");
    test.is(arabic, "١٬٢٣٤٬٥٦٧٫٥٠");
    test.is(devanagari, "१२,३४,५६७.५०");
    test.is(
        LocalizedDecimalFromString(origin: arabic, locale: Locale("ar-EG"), format: format).decimal().string(),
        "1.2345675e6"
    );
    test.is(
        LocalizedIntegerFromString(
            origin: "١٢٣",
            locale: Locale("ar-EG"),
            grouping: NumberGrouping.automatic
        ).integer().string(),
        "123"
    );
}
