        let digits=data.digits();let pieces is @string=(0..origin.length()).map()->index{
            let character=origin.slice(index,index+1);let found=digits.split(character);
            confirm found.size()==2 else throw InvalidLocalizedNumber("mixed or invalid digit system");"0123456789".slice(found[0].length(),found[0].length()+1);
        };pieces.join("");
    }
}
object NumberIntegerReading {
    has origin is string;has data is NumberRenderingData;has grouping is NumberGrouping;
    NumberIntegerReading(origin is string,data is NumberRenderingData,grouping is NumberGrouping){self.origin=origin;self.data=data;self.grouping=grouping;}
    string() is string {
        let parts=origin.split(data.symbol(1));confirm parts.size()<=1024 else throw InvalidLocalizedNumber("group count");
        let groups is @string=parts.map()->part{NumberDigitReading(part,data).string();};
        let count=groups.reduce(0)->count,part{count+part.length();};confirm count<=1024 else throw InvalidLocalizedNumber("integer digit count");
        if groups.size()>1{
            let pattern=data.pattern(0);let primary=pattern.primary();let secondary=pattern.secondary();
            confirm grouping!=NumberGrouping.never && primary>0 && secondary>0 else throw InvalidLocalizedNumber("grouping is disabled");
            confirm groups.last().length()==primary && groups[0].length()<=secondary else throw InvalidLocalizedNumber("misplaced grouping separator");
            for (1..groups.size()-1)->index{confirm groups[index].length()==secondary else throw InvalidLocalizedNumber("misplaced grouping separator");}
            let minimum=if grouping==NumberGrouping.minimum_two{2;}else{if grouping==NumberGrouping.always{1;}else{data.minimum_grouping();}};
            confirm count-primary>=minimum else throw InvalidLocalizedNumber("grouping below locale threshold");
        }
        groups.join("");
    }
}
// Strict, bounded grammar: no trimming, mixed digits or compact inverse.
// Grouping is optional; when present its widths and minimum threshold must match.
object NumberReading {
    has origin is string;has locale is Locale;has format is NumberFormat;
    NumberReading(origin is string,locale is Locale,format is NumberFormat){self.origin=origin;self.locale=locale;self.format=format;}
    value() is Decimal {
        confirm origin.length()>0 && origin.length()<=4096 else throw InvalidLocalizedNumber("input must be 1..4096 scalars");
        let notation=format.notation();confirm notation!=NumberNotation.compact_short && notation!=NumberNotation.compact_long else throw InvalidLocalizedNumber("compact notation has no unambiguous inverse");
        let data=NumberLocaleData(locale);let scientific=notation==NumberNotation.scientific || notation==NumberNotation.engineering;
        let signed=NumberAffixReading(origin,data,data.pattern(if scientific{1;}else{0;}),format.sign()).value();
        let source=signed.text();let exponent_parts=if scientific{source.split(data.symbol(6));}else{[source];};
        confirm exponent_parts.size()==(if scientific{2;}else{1;}) else throw InvalidLocalizedNumber("exponent separator");
        let decimal_parts=exponent_parts[0].split(data.symbol(0));confirm decimal_parts.size()<=2 else throw InvalidLocalizedNumber("duplicate decimal separator");
        let whole=NumberIntegerReading(decimal_parts[0],data,if scientific{NumberGrouping.never;}else{format.grouping();}).string();
        let fraction=if decimal_parts.size()==2{NumberDigitReading(decimal_parts[1],data).string();}else{"";};
        let precision=format.precision();confirm whole.length()>=precision.minimum_integer() && fraction.length()>=precision.minimum_fraction() && fraction.length()<=precision.maximum_fraction() else throw InvalidLocalizedNumber("input precision does not match format");
        let exponent=if scientific{
            let frame=NumberAffixReading(exponent_parts[1],data,NumberPattern(["","","{minus}","","0","0","0","0"]),NumberSign.automatic).value();
            let digits=NumberDigitReading(frame.text(),data).string();let exponent=BigInt((if frame.negative(){"-";}else{"";})+digits);
            if notation==NumberNotation.engineering{confirm BigRemainder(left:exponent,right:BigInt("3")).value().sign()==0 else throw InvalidLocalizedNumber("engineering exponent must be a multiple of three");}
            "e"+exponent.string();
        }else{"";};
        let text=(if signed.negative(){"-";}else{"";})+whole+(if fraction==""{"";}else{"."+fraction;})+exponent;
        try{Decimal(text);}catch error is InvalidDecimal{throw InvalidLocalizedNumber("decimal exponent outside supported range");}
    }
}
object LocalizedDecimalFromString {
    has origin is string;has locale is Locale;has format is NumberFormat;
    LocalizedDecimalFromString(origin is string,locale is Locale,format is NumberFormat){self.origin=origin;self.locale=locale;self.format=format;}
    #projected
    value() is Decimal{NumberReading(origin,locale,format).value();}
}
object LocalizedIntegerFromString {
    has origin is string;has locale is Locale;has grouping is NumberGrouping;
    LocalizedIntegerFromString(origin is string,locale is Locale,grouping is NumberGrouping){self.origin=origin;self.locale=locale;self.grouping=grouping;}
    #projected
    value() is BigInt {
        let format=NumberFormat(NumberNotation.standard,grouping,NumberSign.automatic,NumberPrecision(1,0,0,Rounding.toward_zero));
        let value=NumberReading(origin,locale,format).value();
        BigProduct(left:value.coefficient(),right:BigPower(base:BigInt("10"),exponent:value.exponent(),maximum_bits:8192).value()).value();
    }
}

test "exact decimal number rounds before its text is localized" {test.is(LocalizedDecimal(Decimal("1234.567"),Locale("en"),NumberFormat(NumberNotation.standard,NumberGrouping.automatic,NumberSign.automatic,NumberPrecision(1,2,2,Rounding.half_even))).string(),"1,234.57");}
