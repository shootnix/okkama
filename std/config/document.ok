module config/document v1.0.0;

import "collections/sequence" take Sequencing;
import "async/atomic" take Atomic;
import "config/key" take SettingKey;
import "config/source" take SettingReading, SettingEntry, SettingSource, SettingSourceKind,
    Settings, DuplicateSetting, SettingLimitExceeded;
import "compare" take Order;
import "json" take Json, JsonKind, ParsedJson;
import "toml/value" take TomlTable, TomlValue, TomlVisitor, TomlMember, TomlLocalDate,
    TomlLocalTime, TomlLocalDateTime, TomlOffsetDateTime;
import "config/ini" take IniDocument;

// Strings keep decoded text. Other scalars use canonical source-format text.
// Native file access and decoding are explicitly outside these adapters.
hidden object SettingDocumentEntries {
    has origin is Atomic<@SettingEntry>;

    SettingDocumentEntries() {
        let empty is @SettingEntry = [];
        origin = Atomic(empty);
    }

    append(entry is SettingEntry) is void {
        let old = origin.value();
        confirm old.size() < 4096 else throw SettingLimitExceeded.exceeded;
        for old -> previous {
            confirm previous.key().order(entry.key()) != Order.equal
                else throw DuplicateSetting.key(entry.key().string());
        }
        let revised is @SettingEntry = (0..old.size() + 1).map() -> index {
            if index < old.size() {
                old[index];
            }
            else {
                entry;
            }
        };
        origin.replace(revised);
    }

    settings() is Settings {
        Settings(origin.value());
    }
}

// A JSON object as settings: nested members extend the key path, an array
// of scalars is one multi-value entry, other scalars are single entries.
object JsonSettings does SettingReading {
    has origin is Settings;

    JsonSettings(document is Json, source is SettingSource) {
        confirm document.kind() == JsonKind.object_value
            else throw InvalidSettingDocument.because("settings document must be a JSON object");
        let entries = SettingDocumentEntries();
        JsonSettingTree(path: [], source: source, entries: entries, depth: 64).add(document);
        origin = entries.settings();
    }

    membership(key is SettingKey) is bool {
        origin.membership(key);
    }

    entry(key is SettingKey) is SettingEntry {
        origin.entry(key);
    }

    keys() is Sequencing<SettingKey> {
        origin.keys();
    }
}

hidden object JsonSettingTree {
    has path is @string;
    has source is SettingSource;
    has entries is SettingDocumentEntries;
    has depth is int;

    JsonSettingTree(
        path is @string,
        source is SettingSource,
        entries is SettingDocumentEntries,
        depth is int
    ) {
        confirm depth > 0 else throw InvalidSettingDocument.because("document nesting exceeds 64");
        self.path = path;
        self.source = source;
        self.entries = entries;
        self.depth = depth;
    }

    add(value is Json) is void {
        match value.kind() {
            case JsonKind.object_value {
                confirm value.size() <= 4096 else throw SettingLimitExceeded.exceeded;
                for value.names() -> name {
                    let child is @string = path + [name];
                    JsonSettingTree(path: child, source: source, entries: entries, depth: depth - 1).add(value.get(name));
                }
            }
            case JsonKind.array_value {
                let items = value.items();
                confirm items.size() <= 1024 else throw SettingLimitExceeded.exceeded;
                let texts is @string = items.map() -> item {
                    JsonSettingText(item).text();
                };
                entries.append(SettingEntry(key: SettingKey(path), values: texts, source: source));
            }
            else {
                entries.append(
                    SettingEntry(key: SettingKey(path), values: [JsonSettingText(value).text()], source: source)
                );
            }
        }
    }
}

// Canonical text of a scalar setting; arrays and objects inside arrays are not settings.
hidden object JsonSettingText {
    has origin is Json;

    JsonSettingText(origin is Json) {
        self.origin = origin;
    }

    text() is string {
        match origin.kind() {
            case JsonKind.null_value {
                "null";
            }
            case JsonKind.boolean_value {
                if origin.boolean() {
                    "true";
                }
                else {
                    "false";
                }
            }
            case JsonKind.number_value {
                origin.string();
            }
            case JsonKind.string_value {
                origin.text();
            }
            case JsonKind.array_value {
                throw InvalidSettingDocument.because("nested arrays are not settings");
            }
            else {
                throw InvalidSettingDocument.because("object-valued arrays are not settings");
            }
        }
    }
}

object TomlSettings does SettingReading {
    has origin is Settings;

    TomlSettings(document is TomlTable, source is SettingSource) {
        let entries = SettingDocumentEntries();
        let visitor = TomlSettingVisitor(path: [], source: source, entries: entries, depth: 64);
        document.accept(visitor);
        visitor.valid();
        origin = entries.settings();
    }

    membership(key is SettingKey) is bool {
        origin.membership(key);
    }

    entry(key is SettingKey) is SettingEntry {
        origin.entry(key);
    }

    keys() is Sequencing<SettingKey> {
        origin.keys();
    }
}

hidden object TomlSettingVisitor does TomlVisitor {
    has path is @string;
    has source is SettingSource;
    has entries is SettingDocumentEntries;
    has depth is int;
    has emission is SettingEmission;

    TomlSettingVisitor(
        path is @string,
        source is SettingSource,
        entries is SettingDocumentEntries,
        depth is int
    ) {
        confirm depth > 0 else throw InvalidSettingDocument.because("document nesting exceeds 64");
        self.path = path;
        self.source = source;
        self.entries = entries;
        self.depth = depth;
        emission = SettingEmission();
    }

    text(value is string) is void {
        self.scalar(value);
    }

    integer(value is int) is void {
        self.scalar(value.string());
    }

    real(value is float) is void {
        self.scalar(value.string());
    }

    infinity(negative is bool) is void {
        self.scalar(if negative {
            "-inf";
        }
        else {
            "inf";
        });
    }

    not_a_number() is void {
        self.scalar("nan");
    }

    boolean(value is bool) is void {
        self.scalar(if value {
            "true";
        }
        else {
            "false";
        });
    }

    local_date(value is TomlLocalDate) is void {
        self.scalar(value.string());
    }

    local_time(value is TomlLocalTime) is void {
        self.scalar(value.string());
    }

    local_datetime(value is TomlLocalDateTime) is void {
        self.scalar(value.string());
    }

    offset_datetime(value is TomlOffsetDateTime) is void {
        self.scalar(value.string());
    }

    elements(values is Sequencing<TomlValue>) is void {
        self.once();
        try {
            let size = values.size();
            confirm size >= 0 && size <= 1024 else throw SettingLimitExceeded.exceeded;
            let texts is @string = (0..size).map() -> index {
                let scalar = TomlSettingScalar();
                values.item(index).accept(scalar);
                scalar.text();
            };
            entries.append(SettingEntry(key: SettingKey(path), values: texts, source: source));
        }
        catch e is Error {
            emission.poison();
            throw e;
        }
    }

    members(members is Sequencing<TomlMember>) is void {
        self.once();
        try {
            let size = members.size();
            confirm size >= 0 && size <= 4096 else throw SettingLimitExceeded.exceeded;
            for (0..size) -> index {
                let member = members.item(index);
                let child is @string = (0..path.size() + 1).map() -> at {
                    if at < path.size() {
                        path[at];
                    }
                    else {
                        member.name();
                    }
                };
                let visitor = TomlSettingVisitor(path: child, source: source, entries: entries, depth: depth - 1);
                member.value().accept(visitor);
                visitor.valid();
            }
        }
        catch e is Error {
            emission.poison();
            throw e;
        }
    }

    valid() is void {
        emission.valid();
    }

    hidden once() is void {
        emission.start();
    }

    hidden scalar(text is string) is void {
        self.once();
        try {
            entries.append(SettingEntry(key: SettingKey(path), values: [text], source: source));
        }
        catch e is Error {
            emission.poison();
            throw e;
        }
    }
}

hidden object TomlSettingScalar does TomlVisitor {
    has origin is Atomic<string>;
    has emission is SettingEmission;

    TomlSettingScalar() {
        origin = Atomic("");
        emission = SettingEmission();
    }

    text() is string {
        emission.valid();
        origin.value();
    }

    text(value is string) is void {
        self.scalar(value);
    }

    integer(value is int) is void {
        self.scalar(value.string());
    }

    real(value is float) is void {
        self.scalar(value.string());
    }

    infinity(negative is bool) is void {
        self.scalar(if negative {
            "-inf";
        }
        else {
            "inf";
        });
    }

    not_a_number() is void {
        self.scalar("nan");
    }

    boolean(value is bool) is void {
        self.scalar(if value {
            "true";
        }
        else {
            "false";
        });
    }

    local_date(value is TomlLocalDate) is void {
        self.scalar(value.string());
    }

    local_time(value is TomlLocalTime) is void {
        self.scalar(value.string());
    }

    local_datetime(value is TomlLocalDateTime) is void {
        self.scalar(value.string());
    }

    offset_datetime(value is TomlOffsetDateTime) is void {
        self.scalar(value.string());
    }

    elements(values is Sequencing<TomlValue>) is void {
        emission.poison();
        throw InvalidSettingDocument.because("nested arrays are not settings");
    }

    members(members is Sequencing<TomlMember>) is void {
        emission.poison();
        throw InvalidSettingDocument.because("object-valued arrays are not settings");
    }

    hidden scalar(text is string) is void {
        emission.start();
        origin.replace(text);
    }
}

object IniSettings does SettingReading {
    has origin is Settings;

    IniSettings(document is IniDocument, source is SettingSource) {
        let entries = SettingDocumentEntries();
        for document.sections() -> section {
            for section.entries() -> entry {
                entries.append(
                    SettingEntry(
                        key: SettingKey(section.name(), entry.name()),
                        values: [entry.value()],
                        source: source
                    )
                );
            }
        }
        origin = entries.settings();
    }

    membership(key is SettingKey) is bool {
        origin.membership(key);
    }

    entry(key is SettingKey) is SettingEntry {
        origin.entry(key);
    }

    keys() is Sequencing<SettingKey> {
        origin.keys();
    }
}

enum InvalidSettingDocument is Error = (because(reason is string));

// Seals a nominal printer observation, including errors the producer catches.
// Returned Settings never remain writable through a retained visitor alias.
hidden object SettingEmission {
    has called, failed, sealed is Atomic<bool>;

    SettingEmission() {
        called = Atomic(false);
        failed = Atomic(false);
        sealed = Atomic(false);
    }

    start() is void {
        if called.value() || sealed.value() {
            failed.replace(true);
            throw InvalidSettingDocument.because("multiple or late value emissions");
        }
        called.replace(true);
    }

    poison() is void {
        failed.replace(true);
    }

    valid() is void {
        confirm called.value() && !failed.value()
            else throw InvalidSettingDocument.because("invalid or missing document emission");
        sealed.replace(true);
    }
}

test "a JSON document becomes settings: nested members extend the key, arrays are values" {
    let settings = JsonSettings(
        document: ParsedJson("{\"db\":{\"host\":\"h\",\"port\":5432},\"tags\":[\"a\",\"b\"],\"on\":true}").root(),
        source: SettingSource(kind: SettingSourceKind.document, name: "test.json")
    );
    test.is(settings.entry(SettingKey("db", "host")).values().item(0), "h");
    test.is(settings.entry(SettingKey("db", "port")).values().item(0), "5432");
    test.is(settings.entry(SettingKey("tags")).values().size(), 2);
    test.is(settings.entry(SettingKey("tags")).values().item(1), "b");
    test.is(settings.membership(SettingKey("on")), true);
    test.is(settings.membership(SettingKey("db")), false);
}
