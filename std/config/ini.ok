module config/ini v1.0.0;

import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "compare" take Comparing, Order;
import "async/atomic" take Atomic;
import "cell" take Cell;

// Immutable INI bindings, sections and documents with a bounded text codec.
// The model never infers grammar from a name/value.
//
//     let settings = IniSection("settings", [IniEntry("name", "Ada")]);
//     let document = IniDocument(settings);
//     document.section("settings").value("name"); // "Ada"
//     document.print(observer); // explicit nominal protocol, no hidden I/O
//
// Names/values are exact Unicode strings. Empty names, dots, whitespace,
// case distinctions and normalization variants remain distinct. DEFAULT is an
// ordinary section, never an ambient parent. Duplicate names are typed errors.
// Entries replace the old map-shaped API with ordered nominal binding objects.
//
// Section/document constructors snapshot size() once, then item(0..size-1) once
// in order. Bounds are checked before reading items. Defaults: 1024 entries or
// 128 sections; an explicit final argument replaces the nonnegative bound.
// InvalidIniLimit precedes source observation, InvalidIniSize rejects negative
// size, IniLimitExceeded rejects cardinality above the bound; zero admits empty.
// Sources are borrowed and never closed. Immutable children remain reachable
// through the snapshot, while the original sequence is not revisited. Failures
// from size/item and observers propagate unchanged. No owned resource/destroy.
//
// Duplicate checking sorts the names (O(n log n)); only a document that has a
// duplicate is scanned again to name the first one. Lookup is O(n). Strings
// are retained coordinates; container budgets do not limit string length.
// Parsing and rendering have independent text budgets (docs/std/ini-guide.md).
// The codec is written in Okkama (#13): no native state, nothing to release.
//
// print() emits each section header followed by entries in order. Empty sections
// still emit section(name); an empty document emits nothing. Every call repeats
// the same protocol. Observer errors stop emission. No JSON, reflection or casts.

role IniContent {
    print(to is IniWriting) is void;
}

role IniWriting {
    section(name is string) is void;
    entry(name is string, value is string) is void;

    fake {
        section(name is string) is void {
            test.is(name, "settings");
        }

        entry(name is string, value is string) is void {
            if name == "name" {
                test.is(value, "Ada");
            }
            else {
                test.is(name, "enabled");
                test.is(value, "true");
            }
        }
    }
}

object IniEntry {
    has key is string;
    has origin is string;

    IniEntry(name is string, value is string) {
        key = name;
        origin = value;
    }

    name() is string {
        key;
    }

    value() is string {
        origin;
    }

    print(to is IniWriting) is void {
        to.entry(key, origin);
    }
}

object IniSection does IniContent {
    has label is string;
    has origin is @IniEntry;

    IniSection(name is string, entries is Sequencing<IniEntry>) {
        label = name;
        let size = entries.size();
        confirm size >= 0 else throw InvalidIniSize.invalid;
        confirm size <= 1024 else throw IniLimitExceeded.exceeded;
        let snapshot is @IniEntry = (0..size).map() -> index {
            entries.item(index);
        };
        origin = snapshot;
        let names is @string = snapshot.map() -> entry {
            entry.name();
        };
        let repeated = IniRepeated(names).first();
        confirm repeated < 0 else throw DuplicateIniEntry.detailed(name, names[repeated]);
    }

    IniSection(name is string, entries is Sequencing<IniEntry>, maximum_entries is int) {
        confirm maximum_entries >= 0 else throw InvalidIniLimit.invalid;
        label = name;
        let size = entries.size();
        confirm size >= 0 else throw InvalidIniSize.invalid;
        confirm size <= maximum_entries else throw IniLimitExceeded.exceeded;
        let snapshot is @IniEntry = (0..size).map() -> index {
            entries.item(index);
        };
        origin = snapshot;
        let names is @string = snapshot.map() -> entry {
            entry.name();
        };
        let repeated = IniRepeated(names).first();
        confirm repeated < 0 else throw DuplicateIniEntry.detailed(name, names[repeated]);
    }

    name() is string {
        label;
    }

    entries() is Sequencing<IniEntry> {
        origin;
    }

    membership(name is string) is bool {
        self.index(name) >= 0;
    }

    value(name is string) is string {
        let at = self.index(name);
        confirm at >= 0 else throw MissingIniEntry.detailed(label, name);
        origin[at].value();
    }

    print(to is IniWriting) is void {
        to.section(label);
        for origin -> entry {
            entry.print(to);
        }
    }

    hidden index(name is string) is int {
        (0..origin.size()).reduce(-1) -> found, index {
            if origin[index].name() == name {
                index;
            }
            else {
                found;
            }
        };
    }
}

object IniDocument does IniContent {
    has origin is @IniSection;

    IniDocument(sections is Sequencing<IniSection>) {
        let size = sections.size();
        confirm size >= 0 else throw InvalidIniSize.invalid;
        confirm size <= 128 else throw IniLimitExceeded.exceeded;
        let snapshot is @IniSection = (0..size).map() -> index {
            sections.item(index);
        };
        origin = snapshot;
        let names is @string = snapshot.map() -> section {
            section.name();
        };
        let repeated = IniRepeated(names).first();
        confirm repeated < 0 else throw DuplicateIniSection.name(names[repeated]);
    }

    // The same, one argument per part: IniDocument(a, b).
    IniDocument(sections is ...IniSection) {
        let listed is @IniSection = sections...;
        let size = listed.size();
        confirm size >= 0 else throw InvalidIniSize.invalid;
        confirm size <= 128 else throw IniLimitExceeded.exceeded;
        let snapshot is @IniSection = (0..size).map() -> index {
            listed.item(index);
        };
        origin = snapshot;
        let names is @string = snapshot.map() -> section {
            section.name();
        };
        let repeated = IniRepeated(names).first();
        confirm repeated < 0 else throw DuplicateIniSection.name(names[repeated]);
    }

    IniDocument(sections is Sequencing<IniSection>, maximum_sections is int) {
        confirm maximum_sections >= 0 else throw InvalidIniLimit.invalid;
        let size = sections.size();
        confirm size >= 0 else throw InvalidIniSize.invalid;
        confirm size <= maximum_sections else throw IniLimitExceeded.exceeded;
        let snapshot is @IniSection = (0..size).map() -> index {
            sections.item(index);
        };
        origin = snapshot;
        let names is @string = snapshot.map() -> section {
            section.name();
        };
        let repeated = IniRepeated(names).first();
        confirm repeated < 0 else throw DuplicateIniSection.name(names[repeated]);
    }

    sections() is Sequencing<IniSection> {
        origin;
    }

    section(name is string) is IniSection {
        let at = (0..origin.size()).reduce(-1) -> found, index {
            if origin[index].name() == name {
                index;
            }
            else {
                found;
            }
        };
        confirm at >= 0 else throw MissingIniSection.name(name);
        origin[at];
    }

    print(to is IniWriting) is void {
        for origin -> section {
            section.print(to);
        }
    }
}

// Lazy bounded parser. Defaults: 1 Mi Unicode scalars, 128 sections, 10000 total
// entries; each section <=1024 entries. Negative configuration fails immediately.
// LF/CRLF, blank lines, whole-line #/; comments, explicit [section], name=value.
// Bare tokens trim ASCII space/tab. Double quotes support backslash/quote,
// b/t/n/f/r, uXXXX/UXXXXXXXX scalar escapes. No multiline or inline comments.
// Raw controls except tab, duplicate decoded names and trailing material fail.
// Failures carry the one-based line and column, in Unicode scalars, of the
// first problem in the document. Each value() parses the text again; the
// result is the same document or the same failure. No file I/O.
object ParsedIni does IniContent {
    has origin is string;
    has maximum_input, maximum_sections, maximum_entries is int;

    ParsedIni(origin is string) {
        self.origin = origin;
        maximum_input = 1048576;
        maximum_sections = 128;
        maximum_entries = 10000;
    }

    ParsedIni(
        origin is string,
        maximum_input is int,
        maximum_sections is int,
        maximum_entries is int
    ) {
        confirm maximum_input >= 0 && maximum_sections >= 0 && maximum_entries >= 0
            else throw InvalidIniLimit.invalid;
        self.origin = origin;
        self.maximum_input = maximum_input;
        self.maximum_sections = maximum_sections;
        self.maximum_entries = maximum_entries;
    }

    document() is IniDocument {
        IniParse(
            origin: origin,
            maximum_input: maximum_input,
            maximum_sections: maximum_sections,
            maximum_entries: maximum_entries
        ).document();
    }

    print(to is IniWriting) is void {
        self.document().print(to);
    }
}

// Lazy canonical text through the nominal print protocol. Each string() starts
// a new emission; the origin is borrowed, never closed. Every coordinate is
// double-quoted; ASCII controls are escaped, ordinary Unicode remains literal.
// Headers/bindings end LF; empty document gives "". Default output bound is
// 1048576 Unicode scalars; zero permits only empty output. No partial result.
// A custom emitter must start a section before entries and cannot emit duplicate
// names. Even if it catches an observer exception, string() repeats that failure.
object IniString {
    has origin is IniContent;
    has maximum is int;

    IniString(origin is IniContent) {
        self.origin = origin;
        maximum = 1048576;
    }

    IniString(origin is IniContent, maximum_output is int) {
        confirm maximum_output >= 0 else throw InvalidIniLimit.invalid;
        self.origin = origin;
        maximum = maximum_output;
    }

    string() is string {
        let emission = IniTextEmission(maximum);
        origin.print(emission);
        emission.string();
    }
}

// The emission of one string(): text pieces in reverse order, their length in
// Unicode scalars, the names seen so far, and the first failure, which is
// sticky. Status: 0 valid, 1 entry before section, 2 duplicate section,
// 3 duplicate entry, 4 output limit.
hidden object IniTextEmission does IniWriting {
    has maximum is int;
    has pieces is Atomic<List<string>>;
    has length, status, entries is Atomic<int>;
    has failed, parent is Atomic<string>;
    has sections, names is Atomic<IniNames>;

    IniTextEmission(maximum is int) {
        self.maximum = maximum;
        let empty is List<string> = EmptyList();
        pieces = Atomic(empty);
        length = Atomic(0);
        status = Atomic(0);
        entries = Atomic(-1);
        failed = Atomic("");
        parent = Atomic("");
        sections = Atomic(IniNames());
        names = Atomic(IniNames());
    }

    section(name is string) is void {
        if status.value() == 0 {
            let quoted = IniQuoted(name).string();
            if sections.value().has(quoted) {
                self.fail(2, name);
            }
            else {
                self.append("[" + quoted + "]\n");
                if status.value() == 0 {
                    sections.replace(sections.value().added(quoted));
                    parent.replace(name);
                    names.replace(IniNames());
                    entries.replace(0);
                }
            }
        }
        self.valid();
    }

    entry(name is string, value is string) is void {
        if status.value() == 0 {
            if entries.value() < 0 {
                self.fail(1, "");
            }
            else if names.value().has(IniQuoted(name).string()) {
                self.fail(3, name);
            }
            else {
                let quoted = IniQuoted(name).string();
                self.append(quoted + "=" + IniQuoted(value).string() + "\n");
                if status.value() == 0 {
                    names.replace(names.value().added(quoted));
                    entries.replace(entries.value() + 1);
                }
            }
        }
        self.valid();
    }

    string() is string {
        self.valid();
        let reversed is @string = pieces.value().map() -> piece {
            piece;
        };
        reversed.reversed().join("");
    }

    hidden append(text is string) is void {
        let size = text.length();
        if size > maximum - length.value() {
            self.fail(4, "");
        }
        else {
            pieces.replace(pieces.value().prefix(text));
            length.replace(length.value() + size);
        }
    }

    hidden fail(code is int, name is string) is void {
        status.replace(code);
        failed.replace(name);
        let empty is List<string> = EmptyList();
        pieces.replace(empty);
        length.replace(0);
    }

    hidden valid() is void {
        match status.value() {
            case 0 {}
            case 2 {
                throw DuplicateIniSection.name(failed.value());
            }
            case 3 {
                throw DuplicateIniEntry.detailed(parent.value(), failed.value());
            }
            case 4 {
                throw IniOutputLimitExceeded.exceeded;
            }
            else {
                throw InvalidIniEmission.invalid;
            }
        }
    }
}

enum InvalidIni is Error = (located(line is int, column is int, message is string));

enum InvalidIniEmission is Error = (invalid);

enum IniOutputLimitExceeded is Error = (exceeded);

enum MissingIniSection is Error = (name(name is string));

enum DuplicateIniSection is Error = (name(name is string));

enum MissingIniEntry is Error = (detailed(section is string, name is string));

enum DuplicateIniEntry is Error = (detailed(section is string, name is string));

enum InvalidIniLimit is Error = (invalid);

enum InvalidIniSize is Error = (invalid);

enum IniLimitExceeded is Error = (exceeded);

// ---- the codec ----

// The quoted names a writer has emitted, as text: each one follows a NUL. A
// quoted name has no raw control, so a NUL-delimited search is exact, and a
// native contains() replaces a loop. New names go to a short second text
// that joins the first every 16 additions.
hidden object IniNames {
    has settled is string;
    has recent is string;
    has count is int;

    IniNames() {
        settled = char(0).string();
        recent = char(0).string();
        count = 0;
    }

    IniNames(settled is string, recent is string, count is int) {
        self.settled = settled;
        self.recent = recent;
        self.count = count;
    }

    has(quoted is string) is bool {
        let token = char(0).string() + quoted + char(0).string();
        recent.contains(token) || settled.contains(token);
    }

    added(quoted is string) is IniNames {
        let joined = recent + quoted + char(0).string();
        if count < 15 {
            IniNames(settled: settled, recent: joined, count: count + 1);
        }
        else {
            IniNames(
                settled: settled + joined.slice(1, joined.length()),
                recent: char(0).string(),
                count: 0
            );
        }
    }
}

// A double-quoted coordinate: backslash, quote and ASCII controls escaped
// (b/t/n/f/r by name, the rest as \u00XX), everything else literal.
hidden object IniQuoted {
    has origin is string;

    IniQuoted(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let points = origin.characters();
        let plain = points.size() == 0
            || (points.ordering()[0].code() >= 32
            && !points.contains('"')
            && !points.contains('\\')
            && !points.contains(char(127)));
        if plain {
            "\"" + origin + "\"";
        }
        else {
            "\"" + self.escaped() + "\"";
        }
    }

    hidden escaped() is string {
        let pieces is @string = origin.characters().map() -> point {
            let code = point.code();
            if point == '"' {
                "\\\"";
            }
            else if point == '\\' {
                "\\\\";
            }
            else if code == 8 {
                "\\b";
            }
            else if code == 9 {
                "\\t";
            }
            else if code == 10 {
                "\\n";
            }
            else if code == 12 {
                "\\f";
            }
            else if code == 13 {
                "\\r";
            }
            else if code < 32 || code == 127 {
                "\\u00" + IniHex(code).string();
            }
            else {
                point.string();
            }
        };
        pieces.join("");
    }
}

// Two lower-case hexadecimal digits of a byte value.
hidden object IniHex {
    has value is int;

    IniHex(value is int) {
        self.value = value;
    }

    string() is string {
        let digits = "0123456789abcdef";
        let high = (value / 16).int();
        digits.slice(high, high + 1) + digits.slice(value - high * 16, value - high * 16 + 1);
    }
}

// The first ASCII control of a line (tab is allowed raw).
hidden object IniControls {
    has origin is string;

    IniControls(origin is string) {
        self.origin = origin;
    }

    // The scalar index of the first control, tab included when `tab` is true.
    first(tab is bool) is int {
        let points = origin.characters();
        let found = (0..points.size()).filter() -> at {
            let code = points[at].code();
            (code < 32 && (tab || code != 9)) || code == 127;
        };
        if found.size() > 0 {
            found[0];
        }
        else {
            -1;
        }
    }
}

// The index of the first name that repeats an earlier one, or -1. A sort
// finds out whether any name repeats; only then are the names scanned.
hidden object IniRepeated {
    has names is @string;

    IniRepeated(names is @string) {
        self.names = names;
    }

    first() is int {
        if names.size() < 2 {
            return -1;
        }
        let sorted = names.ordering();
        let any = (1..sorted.size()).filter() -> at {
            sorted[at] == sorted[at - 1];
        }.size() > 0;
        if !any {
            -1;
        }
        else {
            self.scan();
        }
    }

    hidden scan() is int {
        let found = Cell(-1);
        for 0..names.size() -> index {
            if found.value() < 0 {
                for 0..index -> previous {
                    if found.value() < 0 && names[previous] == names[index] {
                        found.replace(index);
                    }
                }
            }
        }
        found.value();
    }
}

// One line, classified on its own (the first pass of IniParse). Columns are
// one-based scalar positions; `start` is where the line's content begins.
hidden enum IniLine = (blank, control(column is int), header(name is string, column is int), broken_header(
    column is int,
    message is string
), binding(name is string, value is string, column is int), broken_binding(
    start is int,
    column is int,
    message is string
));

// A syntax failure inside a line: the zero-based scalar position and the text.
hidden enum IniFault is Error = (at(position is int, message is string));

// A decoded token and the position just after it.
hidden object IniToken {
    has text is string;
    has end is int;

    IniToken(:text, :end);

    text() is string {
        text;
    }

    end() is int {
        end;
    }
}

hidden object IniLineScan {
    has line is string;
    has points is @char;

    IniLineScan(line is string) {
        self.line = line;
        points = line.characters();
    }

    outcome() is IniLine {
        let control = IniControls(line).first(false);
        let position = self.space(0);
        if control >= 0 {
            IniLine.control(control + 1);
        }
        else if position == points.size() || points[position] == '#' || points[position] == ';' {
            IniLine.blank;
        }
        else if points[position] == '[' {
            try {
                self.header(position);
            }
            catch IniFault.at(at, message) {
                IniLine.broken_header(at + 1, message);
            }
        }
        else {
            try {
                self.binding(position);
            }
            catch IniFault.at(at, message) {
                IniLine.broken_binding(position + 1, at + 1, message);
            }
        }
    }

    hidden header(position is int) is IniLine {
        let name = self.name(position + 1, ']');
        let end = name.end();
        confirm end < points.size() && points[end] == ']'
            else throw IniFault.at(end, "expected closing bracket");
        confirm self.space(end + 1) == points.size()
            else throw IniFault.at(end + 1, "trailing section material");
        IniLine.header(name.text(), position + 1);
    }

    hidden binding(position is int) is IniLine {
        let name = self.name(position, '=');
        let end = name.end();
        confirm end < points.size() && points[end] == '='
            else throw IniFault.at(end, "expected equals");
        let start = self.space(end + 1);
        let value = if start < points.size() && points[start] == '"' {
            let quoted = self.quoted(start);
            confirm self.space(quoted.end()) == points.size()
                else throw IniFault.at(quoted.end(), "trailing value material");
            quoted.text();
        }
        else {
            self.trimmed(start, points.size());
        };
        IniLine.binding(name.text(), value, position + 1);
    }

    hidden name(from is int, delimiter is char) is IniToken {
        let position = self.space(from);
        if position < points.size() && points[position] == '"' {
            let quoted = self.quoted(position);
            IniToken(text: quoted.text(), end: self.space(quoted.end()));
        }
        else {
            let end = self.find(position, delimiter);
            confirm end >= 0 else throw IniFault.at(points.size(), "missing " + delimiter.string());
            let name = self.trimmed(position, end);
            confirm name != "" else throw IniFault.at(position, "empty bare name");
            IniToken(text: name, end: end);
        }
    }

    // A quoted string starting at `start` (the opening quote).
    hidden quoted(start is int) is IniToken {
        let at = Cell(start + 1);
        let run = Cell(start + 1);
        let empty is List<string> = EmptyList();
        let parts = Cell(empty);
        let closed = Cell(-1);
        loop {
            last if closed.value() >= 0;
            confirm at.value() < points.size()
                else throw IniFault.at(at.value(), "unterminated quoted string");
            let point = points[at.value()];
            if point == '"' {
                parts.replace(parts.value().prefix(line.slice(run.value(), at.value())));
                closed.replace(at.value() + 1);
            }
            else if point != '\\' {
                at.replace(at.value() + 1);
            }
            else {
                parts.replace(parts.value().prefix(line.slice(run.value(), at.value())));
                let escape = at.value() + 1;
                confirm escape < points.size() else throw IniFault.at(escape, "unfinished escape");
                let decoded = self.escape(escape);
                parts.replace(parts.value().prefix(decoded.text()));
                at.replace(decoded.end());
                run.replace(decoded.end());
            }
        }
        let reversed is @string = parts.value().map() -> part {
            part;
        };
        IniToken(text: reversed.reversed().join(""), end: closed.value());
    }

    // The escape whose letter is at `at`; the token ends after it.
    hidden escape(at is int) is IniToken {
        let letter = points[at];
        let named = if letter == '"' {
            "\"";
        }
        else if letter == '\\' {
            "\\";
        }
        else if letter == 'b' {
            char(8).string();
        }
        else if letter == 't' {
            char(9).string();
        }
        else if letter == 'n' {
            char(10).string();
        }
        else if letter == 'f' {
            char(12).string();
        }
        else if letter == 'r' {
            char(13).string();
        }
        else {
            "";
        };
        if named != "" {
            IniToken(text: named, end: at + 1);
        }
        else {
            confirm letter == 'u' || letter == 'U' else throw IniFault.at(at, "unknown escape");
            let width = if letter == 'u' {
                4;
            }
            else {
                8;
            };
            let first = at + 1;
            confirm first + width <= points.size()
                && (first..first + width).filter() -> index {
                    IniDigit(points[index]).digit() < 0;
                }.size() == 0
                else throw IniFault.at(first, "invalid Unicode escape");
            let code = (first..first + width).reduce(0) -> sum, index {
                sum * 16 + IniDigit(points[index]).digit();
            };
            confirm code <= 1114111 && (code < 55296 || code > 57343)
                else throw IniFault.at(first, "escape is not a Unicode scalar");
            IniToken(text: char(code).string(), end: first + width);
        }
    }

    hidden space(from is int) is int {
        let at = Cell(from);
        loop {
            last if at.value() >= points.size();
            let point = points[at.value()];
            last if point != ' ' && point != '\t';
            at.replace(at.value() + 1);
        }
        at.value();
    }

    hidden find(from is int, delimiter is char) is int {
        let at = Cell(from);
        loop {
            last if at.value() >= points.size() || points[at.value()] == delimiter;
            at.replace(at.value() + 1);
        }
        if at.value() < points.size() {
            at.value();
        }
        else {
            -1;
        }
    }

    // line[from, to) without trailing spaces and tabs.
    hidden trimmed(from is int, to is int) is string {
        let end = Cell(to);
        loop {
            last if end.value() <= from;
            let point = points[end.value() - 1];
            last if point != ' ' && point != '\t';
            end.replace(end.value() - 1);
        }
        line.slice(from, end.value());
    }
}

// A hexadecimal digit's value, or -1.
hidden object IniDigit {
    has point is char;

    IniDigit(point is char) {
        self.point = point;
    }

    digit() is int {
        let code = point.code();
        if code >= 48 && code <= 57 {
            code - 48;
        }
        else if code >= 97 && code <= 102 {
            code - 87;
        }
        else if code >= 65 && code <= 70 {
            code - 55;
        }
        else {
            -1;
        }
    }
}

// The two passes: every line classified on its own, then the document rules
// in line order (an entry needs a section, names are unique, the budgets). The
// first failing line wins, with the rule the native order checks first.
hidden object IniParse {
    has origin is string;
    has maximum_input, maximum_sections, maximum_entries is int;

    IniParse(
        origin is string,
        maximum_input is int,
        maximum_sections is int,
        maximum_entries is int
    ) {
        self.origin = origin;
        self.maximum_input = maximum_input;
        self.maximum_sections = maximum_sections;
        self.maximum_entries = maximum_entries;
    }

    document() is IniDocument {
        confirm origin.length() <= maximum_input
            else throw InvalidIni.located(1, 1, "maximum INI input exceeded");
        let texts = self.lines();
        let lines is @IniLine = texts.map() -> text {
            IniLineScan(text).outcome();
        };
        let headers is @int = (0..lines.size()).filter() -> at {
            self.is_header(lines[at]);
        };
        let bounds is @int = headers + [lines.size()];
        let repeated_section = self.first_repeated(
            headers.map() -> at {
                self.name(lines[at]);
            },
            headers
        );
        let repeated_entry = (0..headers.size()).reduce(lines.size()) -> earliest, section {
            let members is @int = ((bounds[section] + 1)..bounds[section + 1]).filter() -> at {
                self.is_binding(lines[at]);
            };
            let found = self.first_repeated(
                members.map() -> at {
                    self.name(lines[at]);
                },
                members
            );
            if found < earliest {
                found;
            }
            else {
                earliest;
            }
        };
        self.check(lines, repeated_section, repeated_entry);
        let sections is @IniSection = (0..headers.size()).map() -> section {
            let entries is @IniEntry = ((bounds[section] + 1)..bounds[section + 1]).filter() -> at {
                self.is_binding(lines[at]);
            }.map() -> at {
                match lines[at] {
                    case IniLine.binding(name, value, column) {
                        IniEntry(name: name, value: value);
                    }
                    else {
                        IniEntry(name: "", value: "");
                    }
                }
            };
            IniSection(name: self.name(lines[headers[section]]), entries: entries);
        };
        IniDocument(sections: sections, maximum_sections: sections.size());
    }

    // LF-separated lines; CRLF loses its CR; no line after a final LF.
    hidden lines() is @string {
        let pieces = origin.split("\n");
        let count = if origin == "" || origin.ends_with("\n") {
            pieces.size() - 1;
        }
        else {
            pieces.size();
        };
        (0..count).map() -> index {
            let piece = pieces[index];
            if index < pieces.size() - 1 && piece.ends_with("\r") {
                piece.slice(0, piece.length() - 1);
            }
            else {
                piece;
            }
        };
    }

    // The line of the first name that repeats an earlier one, or the end.
    hidden first_repeated(names is @string, at is @int) is int {
        let index = IniRepeated(names).first();
        if index < 0 {
            2147483647;
        }
        else {
            at[index];
        }
    }

    // The document rules, line by line, up to the first failure.
    hidden check(lines is @IniLine, repeated_section is int, repeated_entry is int) is void {
        let sections = Cell(0);
        let entries = Cell(0);
        let in_section = Cell(0);
        for 0..lines.size() -> at {
            let line = at + 1;
            match lines[at] {
                case IniLine.blank {}
                case IniLine.control(column) {
                    throw InvalidIni.located(
                        line,
                        column,
                        "invalid scalar or raw control character"
                    );
                }
                case IniLine.broken_header(column, message) {
                    throw InvalidIni.located(line, column, message);
                }
                case IniLine.header(name, column) {
                    confirm at != repeated_section
                        else throw InvalidIni.located(line, column, "duplicate INI section");
                    confirm sections.value() < maximum_sections
                        else throw InvalidIni.located(line, column, "maximum INI sections exceeded");
                    sections.replace(sections.value() + 1);
                    in_section.replace(0);
                }
                case IniLine.broken_binding(start, column, message) {
                    confirm sections.value() > 0
                        else throw InvalidIni.located(line, start, "entry requires a section");
                    throw InvalidIni.located(line, column, message);
                }
                case IniLine.binding(name, value, column) {
                    confirm sections.value() > 0
                        else throw InvalidIni.located(line, column, "entry requires a section");
                    confirm at != repeated_entry
                        else throw InvalidIni.located(line, column, "duplicate INI entry");
                    confirm entries.value() < maximum_entries && in_section.value() < 1024
                        else throw InvalidIni.located(line, column, "maximum INI entries exceeded");
                    entries.replace(entries.value() + 1);
                    in_section.replace(in_section.value() + 1);
                }
            }
        }
    }

    hidden is_header(line is IniLine) is bool {
        match line {
            case IniLine.header(name, column) {
                true;
            }
            else {
                false;
            }
        }
    }

    hidden is_binding(line is IniLine) is bool {
        match line {
            case IniLine.binding(name, value, column) {
                true;
            }
            else {
                false;
            }
        }
    }

    hidden name(line is IniLine) is string {
        match line {
            case IniLine.header(name, column) {
                name;
            }
            case IniLine.binding(name, value, column) {
                name;
            }
            else {
                "";
            }
        }
    }
}

test "a document reads back in order" {
    let document = ParsedIni("[s]\nx=y\n[t]\n  \"a b\" = \"c\\td\"  \n").document();
    test.is(document.section("s").value("x"), "y");
    test.is(document.section("t").value("a b"), "c\td");
    test.is(IniString(document).string(), "[\"s\"]\n\"x\"=\"y\"\n[\"t\"]\n\"a b\"=\"c\\td\"\n");
}

test "a failure names the first problem" {
    let unterminated = test.throws(InvalidIni) {
        ParsedIni("[s]\r\nx=\"").document();
    };
    test.is(unterminated, InvalidIni.located(2, 4, "unterminated quoted string"));
    let orphan = test.throws(InvalidIni) {
        ParsedIni("x=y").document();
    };
    test.is(orphan, InvalidIni.located(1, 1, "entry requires a section"));
    let repeated = test.throws(InvalidIni) {
        ParsedIni("[s]\n[t]\n[s]").document();
    };
    test.is(repeated, InvalidIni.located(3, 1, "duplicate INI section"));
    let twice = test.throws(InvalidIni) {
        ParsedIni("[s]\na=1\n b = 2\nb=3").document();
    };
    test.is(twice, InvalidIni.located(4, 1, "duplicate INI entry"));
}

test "the writer enforces order, duplicates and its budget" {
    let emission = IniTextEmission(14);
    emission.section("é");
    emission.entry("a", "😀");
    test.is(emission.string(), "[\"é\"]\n\"a\"=\"😀\"\n");
    let duplicate = test.throws(DuplicateIniSection) {
        emission.section("é");
    };
    test.is(duplicate, DuplicateIniSection.name("é"));
    test.throws(DuplicateIniSection) {
        emission.section("other");
    };
    test.throws(InvalidIniEmission) {
        IniTextEmission(100).entry("x", "y");
    };
    test.throws(IniOutputLimitExceeded) {
        IniTextEmission(1).section("s");
    };
}
