module config/source v1.0.0;

// Settings from several sources, later ones winning.
//
//     let settings = LayeredSettings(
//         TomlSettings(document: config, source: file),
//         EnvironmentSettings(environment: Environment(), names: bindings, source: env),
//         command_line,
//     );
//     settings.int("server.port") else 8080;
//     settings.bool("server.debug") else false;
//     settings.texts("cors.origins");
//     settings.source("server.port");             // which layer gave it
//
// Each entry remembers its source, so errors and diagnostics can say where a
// value came from.

import "collections/sequence" take Sequencing;
import "compare" take Comparing, Order;
import "collections/ordering" take LowerBound;
import "config/key" take SettingKey, InvalidSettingKey;
import "strings/parse" take Number, Truth, InvalidInteger, InvalidFloat, InvalidBoolean;

// What kind of place a setting came from.
enum SettingSourceKind = (defaults, document, environment, command_line);

// Where settings came from: a kind and a name such as a file path.
object SettingSource {
    has category is SettingSourceKind;
    has label is string;

    // A source of kind called name.
    SettingSource(kind is SettingSourceKind, name is string) {
        category = kind;
        label = name;
    }

    // Its kind and name.
    cap Source {
        kind is SettingSourceKind {
            category;
        }

        name is string {
            label;
        }
    }
}

// One setting: its key, its values and its source.
object SettingEntry {
    has identity is SettingKey;
    has origin is @string;
    has provenance is SettingSource;

    // key with values (at most 1024) from source.
    SettingEntry(key is SettingKey, values is Sequencing<string>, source is SettingSource) {
        let size = values.size();
        confirm size >= 0 && size <= 1024 else throw SettingLimitExceeded.exceeded;
        let snapshot is @string = (0..size).map() -> index {
            values.item(index);
        };
        let length = snapshot.reduce(0) -> used, text {
            used + text.length();
        };
        confirm length <= 1048576 else throw SettingLimitExceeded.exceeded;
        identity = key;
        origin = snapshot;
        provenance = source;
    }

    // The key.
    key() is SettingKey {
        identity;
    }

    // The values.
    values() is Sequencing<string> {
        origin;
    }

    // Where it came from.
    source() is SettingSource {
        provenance;
    }
}

// Something settings can be read from.
role SettingReading {
    // Whether it has the key.
    membership(key is SettingKey) is bool;
    // The entry of key; MissingSetting when there is none.
    entry(key is SettingKey) is SettingEntry;
    // Every key, in order.
    keys() is Sequencing<SettingKey>;
}

// Settings given as entries.
object Settings does SettingReading {
    has origin is @SettingEntry;
    has lookup is SettingKeyIndex;

    // The entries; a repeated key is DuplicateSetting.
    Settings(entries is Sequencing<SettingEntry>) {
        let size = entries.size();
        confirm size >= 0 && size <= 4096 else throw SettingLimitExceeded.exceeded;
        let snapshot is @SettingEntry = (0..size).map() -> index {
            entries.item(index);
        };
        let keys is @SettingKey = snapshot.map() -> entry {
            entry.key();
        };
        let checked = SettingKeyIndex(keys);
        checked.valid();
        origin = snapshot;
        lookup = checked;
    }

    // The same, one argument per part: Settings(a, b).
    Settings(entries is ...SettingEntry) {
        let listed is @SettingEntry = entries...;
        let size = listed.size();
        confirm size >= 0 && size <= 4096 else throw SettingLimitExceeded.exceeded;
        let snapshot is @SettingEntry = (0..size).map() -> index {
            listed.item(index);
        };
        let keys is @SettingKey = snapshot.map() -> entry {
            entry.key();
        };
        let checked = SettingKeyIndex(keys);
        checked.valid();
        origin = snapshot;
        lookup = checked;
    }

    // Whether it has the key.
    membership(key is SettingKey) is bool {
        self.index(key) >= 0;
    }

    // The entry of key; MissingSetting when there is none.
    entry(key is SettingKey) is SettingEntry {
        let at = self.index(key);
        confirm at >= 0 else throw MissingSetting.key(key.string());
        origin[at];
    }

    // Every key, in order.
    keys() is Sequencing<SettingKey> {
        lookup.keys();
    }

    hidden index(key is SettingKey) is int {
        lookup.position(key);
    }

    // Read by a dotted name, as cli's Invocation reads its options:
    // settings.int("server.port") else 8080. Absent is Maybe.none; a value
    // that is there but malformed throws MalformedSetting naming the key.
    text(name is string) is Maybe<string> {
        SettingByName(origin: self, name: name).text();
    }

    // The setting named `section.key` as an int, or none; MalformedSetting when
    // it is not one.
    int(name is string) is Maybe<int> {
        SettingByName(origin: self, name: name).int();
    }

    // The setting as a float, or none.
    float(name is string) is Maybe<float> {
        SettingByName(origin: self, name: name).float();
    }

    // The setting as true or false, or none.
    bool(name is string) is Maybe<bool> {
        SettingByName(origin: self, name: name).bool();
    }

    // Every value of the setting; [] when absent.
    texts(name is string) is @string {
        SettingByName(origin: self, name: name).texts();
    }

    // Where the setting came from, or none.
    source(name is string) is Maybe<SettingSource> {
        SettingByName(origin: self, name: name).source();
    }
}

// The diagnostic key string is not identity: ["a.b"] and ["a","b"]
// remain distinct. Stable ordering retains original positions inside each group.
hidden object SettingIndexSlot does Comparing<SettingIndexSlot> {
    has identity is SettingKey;
    has position is int;

    SettingIndexSlot(identity is SettingKey, position is int) {
        self.identity = identity;
        self.position = position;
    }

    identity() is SettingKey {
        identity;
    }

    position() is int {
        position;
    }

    order(other is SettingIndexSlot) is Order {
        identity.order(other.identity());
    }
}

// Keys in a sorted index, for lookup; Settings uses it.
object SettingKeyIndex {
    has original, ordered is @SettingKey;
    has positions is @int;

    // Indexes keys.
    SettingKeyIndex(keys is @SettingKey) {
        confirm keys.size() <= 4096 else throw SettingLimitExceeded.exceeded;
        let slots is @SettingIndexSlot = (0..keys.size()).map() -> index {
            SettingIndexSlot(identity: keys[index], position: index);
        };
        let sorted = slots.ordering();
        let values is @SettingKey = sorted.map() -> slot {
            slot.identity();
        };
        let indices is @int = sorted.map() -> slot {
            slot.position();
        };
        original = keys;
        ordered = values;
        positions = indices;
    }

    // The keys.
    keys() is Sequencing<SettingKey> {
        original;
    }

    // Throws DuplicateSetting for a repeated key.
    valid() is void {
        let duplicate = (0..ordered.size()).reduce(original.size()) -> earliest, index {
            if index > 0
                && ordered[index - 1].order(ordered[index]) == Order.equal
                && positions[index] < earliest {
                    positions[index];
                }
                else {
                    earliest;
                }
        };
        confirm duplicate == original.size()
            else throw DuplicateSetting.key((original[duplicate]).string());
    }

    // The position of key, or -1.
    position(key is SettingKey) is int {
        let at = LowerBound(origin: ordered, item: key).index();
        if at < ordered.size() && ordered[at].order(key) == Order.equal {
            positions[at];
        }
        else {
            -1;
        }
    }
}

// Settings from several layers, the last one that has a key winning.
object LayeredSettings does SettingReading {
    has origin is Settings;

    // The layers, earliest first.
    LayeredSettings(layers is Sequencing<SettingReading>) {
        let size = layers.size();
        confirm size >= 0 && size <= 128 else throw SettingLimitExceeded.exceeded;
        let merged = (0..size).reduce(SettingOverlay()) -> old, index {
            let layer = layers.item(index);
            let keys = layer.keys();
            confirm keys.size() >= 0 && keys.size() <= 4096
                else throw SettingLimitExceeded.exceeded;
            keys.reduce(old) -> state, key {
                state.replaced(layer.entry(key));
            };
        };
        origin = Settings(merged.entries());
    }

    // The same, one argument per part: LayeredSettings(a, b).
    LayeredSettings(layers is ...SettingReading) {
        let listed is @SettingReading = layers...;
        let size = listed.size();
        confirm size >= 0 && size <= 128 else throw SettingLimitExceeded.exceeded;
        let merged = (0..size).reduce(SettingOverlay()) -> old, index {
            let layer = listed.item(index);
            let keys = layer.keys();
            confirm keys.size() >= 0 && keys.size() <= 4096
                else throw SettingLimitExceeded.exceeded;
            keys.reduce(old) -> state, key {
                state.replaced(layer.entry(key));
            };
        };
        origin = Settings(merged.entries());
    }

    // Whether any layer has the key.
    membership(key is SettingKey) is bool {
        origin.membership(key);
    }

    // The entry of key; MissingSetting when there is none.
    entry(key is SettingKey) is SettingEntry {
        origin.entry(key);
    }

    // Every key, in order.
    keys() is Sequencing<SettingKey> {
        origin.keys();
    }

    // Read by a dotted name, as cli's Invocation reads its options:
    // settings.int("server.port") else 8080. Absent is Maybe.none; a value
    // that is there but malformed throws MalformedSetting naming the key.
    text(name is string) is Maybe<string> {
        SettingByName(origin: self, name: name).text();
    }

    // The setting named `section.key` as an int, or none; MalformedSetting when
    // it is not one.
    int(name is string) is Maybe<int> {
        SettingByName(origin: self, name: name).int();
    }

    // The setting as a float, or none.
    float(name is string) is Maybe<float> {
        SettingByName(origin: self, name: name).float();
    }

    // The setting as true or false, or none.
    bool(name is string) is Maybe<bool> {
        SettingByName(origin: self, name: name).bool();
    }

    // Every value of the setting; [] when absent.
    texts(name is string) is @string {
        SettingByName(origin: self, name: name).texts();
    }

    // Where the setting came from, or none.
    source(name is string) is Maybe<SettingSource> {
        SettingByName(origin: self, name: name).source();
    }
}

// Persistent AVL construction state. Entries keep their first insertion slot;
// replacing copies one balanced path, and publication materializes one array.
object SettingOverlay does SettingReading {
    has root is @SettingOverlayNode;
    has count is int;

    // No entries yet.
    SettingOverlay() {
        root = [];
        count = 0;
    }

    // The entries.
    entries() is @SettingEntry {
        if count == 0 {
            let empty is @SettingEntry = [];
            return empty;
        }
        let ordered = root[0].items().ordering();
        let values is @SettingEntry = ordered.map() -> slot {
            slot.entry();
        };
        values;
    }

    // Their keys.
    keys() is Sequencing<SettingKey> {
        let keys is @SettingKey = self.entries().map() -> entry {
            entry.key();
        };
        keys;
    }

    // Whether key is there.
    membership(key is SettingKey) is bool {
        root.size() > 0 && root[0].position(key) >= 0;
    }

    // The entry of key.
    entry(key is SettingKey) is SettingEntry {
        confirm root.size() > 0 else throw MissingSetting.key(key.string());
        root[0].entry(key);
    }

    // This overlay with entry in place of any entry of its key.
    replaced(entry is SettingEntry) is ^SettingOverlay {
        let key = entry.key();
        let slot = SettingOverlaySlot(entry: entry, identity: key, position: count);
        let update = if root.size() == 0 {
            confirm count < 4096 else throw SettingLimitExceeded.exceeded;
            SettingOverlayUpdate(
                root: SettingOverlayNode(slot: slot, left: [], right: []),
                inserted: true
            );
        }
        else {
            root[0].updated(slot, count < 4096);
        };
        ^root = [update.node()];
        ^count = count + if update.added() {
            1;
        }
        else {
            0;
        };
    }
}

hidden object SettingOverlaySlot does Comparing<SettingOverlaySlot> {
    has entry is SettingEntry;
    has identity is SettingKey;
    has position is int;

    SettingOverlaySlot(entry is SettingEntry, identity is SettingKey, position is int) {
        self.entry = entry;
        self.identity = identity;
        self.position = position;
    }

    entry() is SettingEntry {
        entry;
    }

    identity() is SettingKey {
        identity;
    }

    position() is int {
        position;
    }

    order(other is SettingOverlaySlot) is Order {
        position.order(other.position());
    }
}

hidden object SettingOverlayNode {
    has slot is SettingOverlaySlot;
    has left, right is @SettingOverlayNode;
    has height is int;

    SettingOverlayNode(
        slot is SettingOverlaySlot,
        left is @SettingOverlayNode,
        right is @SettingOverlayNode
    ) {
        self.slot = slot;
        self.left = left;
        self.right = right;
        let a = if left.size() == 0 {
            0;
        }
        else {
            left[0].height();
        };
        let b = if right.size() == 0 {
            0;
        }
        else {
            right[0].height();
        };
        height = 1 + if a > b {
            a;
        }
        else {
            b;
        };
    }

    slot() is SettingOverlaySlot {
        slot;
    }

    left() is @SettingOverlayNode {
        left;
    }

    right() is @SettingOverlayNode {
        right;
    }

    height() is int {
        height;
    }

    position(key is SettingKey) is int {
        let order = key.order(slot.identity());
        if order == Order.equal {
            return slot.position();
        }
        let following = if order == Order.less {
            left;
        }
        else {
            right;
        };
        if following.size() == 0 {
            -1;
        }
        else {
            following[0].position(key);
        }
    }

    entry(key is SettingKey) is SettingEntry {
        let order = key.order(slot.identity());
        if order == Order.equal {
            return slot.entry();
        }
        let following = if order == Order.less {
            left;
        }
        else {
            right;
        };
        confirm following.size() > 0 else throw MissingSetting.key(key.string());
        following[0].entry(key);
    }

    replaced(value is SettingOverlaySlot) is SettingOverlayNode {
        let order = value.identity().order(slot.identity());
        if order == Order.equal {
            return SettingOverlayNode(slot: value, left: left, right: right);
        }
        if order == Order.less {
            let following = if left.size() == 0 {
                SettingOverlayNode(slot: value, left: [], right: []);
            }
            else {
                left[0].replaced(value);
            };
            return SettingOverlayBalance(slot: slot, left: [following], right: right).node();
        }
        let following = if right.size() == 0 {
            SettingOverlayNode(slot: value, left: [], right: []);
        }
        else {
            right[0].replaced(value);
        };
        SettingOverlayBalance(slot: slot, left: left, right: [following]).node();
    }

    // Preserve the existing replaced(slot) helper contract. Overlay updates
    // carry the insertion result up the same balanced path instead of looking
    // up the old position first. Capacity is checked only at a missing leaf.
    updated(value is SettingOverlaySlot, can_add is bool) is SettingOverlayUpdate {
        let order = value.identity().order(slot.identity());
        if order == Order.equal {
            let retained = SettingOverlaySlot(
                entry: value.entry(),
                identity: value.identity(),
                position: slot.position()
            );
            return SettingOverlayUpdate(
                root: SettingOverlayNode(slot: retained, left: left, right: right),
                inserted: false
            );
        }
        if order == Order.less {
            let update = if left.size() == 0 {
                confirm can_add else throw SettingLimitExceeded.exceeded;
                SettingOverlayUpdate(
                    root: SettingOverlayNode(slot: value, left: [], right: []),
                    inserted: true
                );
            }
            else {
                left[0].updated(value, can_add);
            };
            SettingOverlayUpdate(
                root: SettingOverlayBalance(slot: slot, left: [update.node()], right: right).node(),
                inserted: update.added()
            );
        }
        else {
            let update = if right.size() == 0 {
                confirm can_add else throw SettingLimitExceeded.exceeded;
                SettingOverlayUpdate(
                    root: SettingOverlayNode(slot: value, left: [], right: []),
                    inserted: true
                );
            }
            else {
                right[0].updated(value, can_add);
            };
            SettingOverlayUpdate(
                root: SettingOverlayBalance(slot: slot, left: left, right: [update.node()]).node(),
                inserted: update.added()
            );
        }
    }

    items() is @SettingOverlaySlot {
        let before is @SettingOverlaySlot = if left.size() == 0 {
            [];
        }
        else {
            left[0].items();
        };
        let after is @SettingOverlaySlot = if right.size() == 0 {
            [];
        }
        else {
            right[0].items();
        };
        let values is @SettingOverlaySlot = (0..before.size() + 1 + after.size()).map() -> index {
            if index < before.size() {
                before[index];
            }
            else {
                if index == before.size() {
                    slot;
                }
                else {
                    after[index - before.size() - 1];
                }
            }
        };
        values;
    }
}

hidden object SettingOverlayUpdate {
    has root is SettingOverlayNode;
    has inserted is bool;

    SettingOverlayUpdate(root is SettingOverlayNode, inserted is bool) {
        self.root = root;
        self.inserted = inserted;
    }

    node() is SettingOverlayNode {
        root;
    }

    added() is bool {
        inserted;
    }
}

hidden object SettingOverlayBalance {
    has slot is SettingOverlaySlot;
    has left, right is @SettingOverlayNode;

    SettingOverlayBalance(
        slot is SettingOverlaySlot,
        left is @SettingOverlayNode,
        right is @SettingOverlayNode
    ) {
        self.slot = slot;
        self.left = left;
        self.right = right;
    }

    node() is SettingOverlayNode {
        let difference = self.height(left) - self.height(right);
        if difference > 1 {
            let pivot = left[0];
            if self.height(pivot.left()) >= self.height(pivot.right()) {
                return SettingOverlayNode(
                    slot: pivot.slot(),
                    left: pivot.left(),
                    right: [SettingOverlayNode(slot: slot, left: pivot.right(), right: right)]
                );
            }
            let middle = pivot.right()[0];
            SettingOverlayNode(
                slot: middle.slot(),
                left: [
                    SettingOverlayNode(slot: pivot.slot(), left: pivot.left(), right: middle.left())
                ],
                right: [SettingOverlayNode(slot: slot, left: middle.right(), right: right)]
            );
        }
        else {
            if difference < (-1) {
                let pivot = right[0];
                if self.height(pivot.right()) >= self.height(pivot.left()) {
                    return SettingOverlayNode(
                        slot: pivot.slot(),
                        left: [SettingOverlayNode(slot: slot, left: left, right: pivot.left())],
                        right: pivot.right()
                    );
                }
                let middle = pivot.left()[0];
                SettingOverlayNode(
                    slot: middle.slot(),
                    left: [SettingOverlayNode(slot: slot, left: left, right: middle.left())],
                    right: [
                        SettingOverlayNode(
                            slot: pivot.slot(),
                            left: middle.right(),
                            right: pivot.right()
                        )
                    ]
                );
            }
            else {
                SettingOverlayNode(slot: slot, left: left, right: right);
            }
        }
    }

    hidden height(nodes is @SettingOverlayNode) is int {
        if nodes.size() == 0 {
            0;
        }
        else {
            nodes[0].height();
        }
    }
}

// No setting has that key.
enum MissingSetting is Error = (key(key is string));

// Two entries with one key.
enum DuplicateSetting is Error = (key(key is string));

// Too many entries or values.
enum SettingLimitExceeded is Error = (exceeded);

test "layers replace complete values and preserve the winning source" {
    let key = SettingKey("name");
    let defaults = SettingSource(kind: SettingSourceKind.defaults, name: "defaults");
    let cli = SettingSource(kind: SettingSourceKind.command_line, name: "argv");
    let result = LayeredSettings(
        Settings(SettingEntry(key: key, values: ["world"], source: defaults)),
        Settings(SettingEntry(key: key, values: [""], source: cli))
    );
    test.is(result.entry(key).values().first(), "");
    test.is(result.entry(key).source()::Source::name, "argv");
}

hidden object SettingByName {
    has origin is SettingReading;
    has key is SettingKey;

    SettingByName(origin is SettingReading, name is string) {
        self.origin = origin;
        key = SettingKey(name.split("."));
    }

    text() is Maybe<string> {
        if !origin.membership(key) {
            return Maybe<string>.none;
        }
        let values = origin.entry(key).values();
        confirm values.size() == 1
            else throw MalformedSetting.detailed(
                key.string(),
                "one value",
                values.size().string() + " values"
            );
        Maybe<string>.some(values.first());
    }

    int() is Maybe<int> {
        match self.text() {
            case Maybe.none {
                Maybe<int>.none;
            }
            case Maybe.some(text) {
                try {
                    Maybe<int>.some(Number(text).int());
                }
                catch e is InvalidInteger {
                    throw MalformedSetting.detailed(key.string(), "an integer", text);
                }
            }
        }
    }

    float() is Maybe<float> {
        match self.text() {
            case Maybe.none {
                Maybe<float>.none;
            }
            case Maybe.some(text) {
                try {
                    Maybe<float>.some(Number(text).float());
                }
                catch e is InvalidFloat {
                    throw MalformedSetting.detailed(key.string(), "a number", text);
                }
            }
        }
    }

    bool() is Maybe<bool> {
        match self.text() {
            case Maybe.none {
                Maybe<bool>.none;
            }
            case Maybe.some(text) {
                try {
                    Maybe<bool>.some(Truth(text).bool());
                }
                catch e is InvalidBoolean {
                    throw MalformedSetting.detailed(key.string(), "true or false", text);
                }
            }
        }
    }

    texts() is @string {
        if !origin.membership(key) {
            let none_given is @string = [];
            return none_given;
        }
        let values is @string = origin.entry(key).values().map() -> value {
            value;
        };
        values;
    }

    source() is Maybe<SettingSource> {
        if origin.membership(key) {
            Maybe<SettingSource>.some(origin.entry(key).source());
        }
        else {
            Maybe<SettingSource>.none;
        }
    }
}

// A value of another kind than asked for; key, expected and value say which.
enum MalformedSetting is Error = (detailed(key is string, expected is string, value is string));

test "settings read a value by its dotted name" {
    let file = SettingSource(kind: SettingSourceKind.document, name: "app.ini");
    let line = SettingSource(kind: SettingSourceKind.command_line, name: "argv");
    let settings = LayeredSettings(
        Settings(
            SettingEntry(key: SettingKey("server", "port"), values: ["8080"], source: file),
            SettingEntry(key: SettingKey("server", "debug"), values: ["true"], source: file),
            SettingEntry(key: SettingKey("server", "ratio"), values: ["0.5"], source: file),
            SettingEntry(key: SettingKey("cors", "origins"), values: ["a", "b"], source: file),
        ),
        Settings(SettingEntry(key: SettingKey("server", "port"), values: ["9090"], source: line)),
    );
    test.is(settings.int("server.port") else 0, 9090);
    test.is((settings.source("server.port") else file)::Source::name, "argv");
    test.is(settings.bool("server.debug") else false, true);
    test.is(settings.float("server.ratio") else 0.0, 0.5);
    test.is(settings.text("server.host") == Maybe<string>.none, true);
    test.is(settings.int("server.workers") else 4, 4);
    test.is(settings.texts("cors.origins"), ["a", "b"]);
    test.is(settings.texts("cors.headers").size(), 0);
    test.throws(MalformedSetting) {
        settings.text("cors.origins");
    };
    test.throws(MalformedSetting) {
        settings.int("server.debug");
    };
    test.throws(InvalidSettingKey) {
        settings.text("server..port");
    };
}
