module async/timeout v1.0.0;

import "error" take InvalidArgument;
import "time/duration" take Duration, DurationUnit;
import "time/clock" take Timing, MonotonicInstant, SystemClock;
import "async/event" take Event;

// Structured monotonic deadlines for futures.
//
// `Within<T>` limits one future by an exact non-negative duration:
//
//     let request is Within<Response> = Within(
//         origin: client.request(),
//         limit: Duration(seconds: 5),
//         clock: SystemClock(),
//     );
//     let response = await request.outcome();
//
// `Before<T>` uses an already computed `MonotonicInstant`. This is useful when
// several operations must share one deadline without each receiving a fresh
// relative timeout:
//
//     let deadline = clock.monotonic_instant().plus(budget);
//     let bounded is Before<Response> = Before(
//         origin: client.request(),
//         deadline: deadline,
//         clock: clock,
//     );
//     let response = await bounded.outcome();
//
// An origin which is already settled wins without starting a clock wait. When
// time wins, the origin is cancelled and its cleanup is awaited before
// `TimedOut` is thrown. Origin values and failures retain their identity when
// they win. Repeated `outcome()` calls return the same future.
//
// Deadlines are monotonic runtime-local readings. Civil `Instant` values are
// deliberately not accepted and cannot be converted into timeout deadlines.

// A future with a time limit: TimedOut, and the future cancelled, if it takes
// longer.
object Within<T> {
    has origin is Future<T>;
    has limit is Duration;
    has clock is Timing;

    // origin limited to limit on clock; limit must not be negative.
    Within(origin is Future<T>, limit is Duration, clock is Timing) {
        confirm limit::Span::seconds >= 0.rat()
            else throw InvalidArgument.because("timeout duration cannot be negative");
        self.origin = origin;
        self.limit = limit;
        self.clock = clock;
    }

    // origin's result, or TimedOut.
    async outcome() is T {
        throw TimedOut.elapsed;
    }
}

// A future with a deadline: TimedOut, and the future cancelled, if the deadline
// passes.
object Before<T> {
    has origin is Future<T>;
    has deadline is MonotonicInstant;
    has clock is Timing;

    // origin with a monotonic deadline on clock.
    Before(:origin, :deadline, :clock);

    // origin's result, or TimedOut.
    async outcome() is T {
        throw TimedOut.elapsed;
    }
}

// Time ran out first.
enum TimedOut is Error = (elapsed);

async test "time wins over a future that never settles" {
    let clock = SystemClock();
    let short = Duration(milliseconds: 20);
    let within is Within<Event> = Within(origin: Event().wait(), limit: short, clock: clock);
    test.is(
        try {
            await within.outcome();
            "settled";
        }
        catch error is TimedOut {
            "timed out";
        },
        "timed out"
    );
    let before is Before<Event> = Before(origin: Event().wait(), deadline: clock.monotonic_instant() + short, clock: clock);
    test.is(
        try {
            await before.outcome();
            "settled";
        }
        catch error is TimedOut {
            "timed out";
        },
        "timed out"
    );
}

async test "a settled future wins and a negative limit is refused" {
    let clock = SystemClock();
    let long = Duration(seconds: 30);
    test.ok((await Within(origin: Event(ready: true).wait(), limit: long, clock: clock).outcome()).ready());
    test.is(
        try {
            let refused is Within<Event> = Within(origin: Event(ready: true).wait(),
                limit: Duration(seconds: -1), clock: clock);
            "accepted";
        }
        catch error is InvalidArgument {
            "refused";
        },
        "refused"
    );
}
