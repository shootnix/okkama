module async/channel v1.0.0;

import "async/atomic" take Atomic;

// Bounded typed channels for cooperative async work.
//
// `Channel<T>` owns one FIFO communication state. `sending()` returns a
// write-only `Sending<T>` capability and `receiving()` returns a read-only
// `Receiving<T>` capability. Keep the channel owner where lifecycle decisions
// belong and pass only the narrower capability to collaborators.
//
// A positive capacity buffers at most that many values. Capacity zero creates an
// unbuffered rendezvous: `send()` and `item()` finish only after meeting each
// other. Negative capacities throw `InvalidChannelCapacity`.
//
// Buffered channel.
//
//     let channel is Channel<string> = Channel(capacity: 16);
//     let producer = spawn Producer(output: channel.sending()).run();
//
//     for 0..16 -> ignored {
//         consume(await channel.receiving().item());
//     }
//     await producer;
//
// Unbuffered rendezvous.
//
//     object Producer {
//         has output is Sending<int>;
//         Producer(:output);
//
//         async run() is int {
//             await output.send(42);
//             return 0;
//         }
//     }
//
//     async main() is int {
//         let channel is Channel<int> = Channel(capacity: 0);
//         let producer = spawn Producer(output: channel.sending()).run();
//         let value = await channel.receiving().item();
//         await producer;
//         confirm value == 42;
//         return 0;
//     }
//
// Closing.
//
// Either endpoint may close the complete channel. Closing is idempotent. New and
// blocked sends throw `ChannelClosed`. Already buffered values remain available;
// after they are drained, `item()` throws `ChannelClosed` and `next()`
// answers none, which ends a `for await` over the receiver.
//
//     let sending = channel.sending();
//     defer sending.close();
//     await sending.send(value);
//
// Dropping endpoint objects does not close a channel. Failure of an unrelated
// task does not close it either. Close ownership must remain explicit.
//
// Fairness and cancellation.
//
// Waiting senders and receivers are selected FIFO. Once an operation enters a
// waiter queue, a later operation of the same kind cannot bypass it. Scheduling
// of runnable continuations belongs to the async runtime rather than the channel.
//
// Cancelling a blocked operation removes that waiter exactly once. Cancellation
// after a direct handoff cannot undo or duplicate the delivered value. The API
// deliberately has no polling `try_send()`, `try_receive()` or `closed()`
// observation.

// A queue between tasks, at most capacity values long; 0 makes sender and
// receiver meet.
object Channel<T> {
    // A channel holding at most capacity values; a negative capacity is
    // InvalidChannelCapacity.
    Channel(capacity is int) {}

    // The side that sends.
    sending() is Sending<T> {
        Sending();
    }

    // The side that receives.
    receiving() is Receiving<T> {
        Receiving();
    }
}

// The sending side of a channel.
object Sending<T> {
    // Made by Channel.sending(); not constructed directly.
    Sending() {}

    // Sends value, waiting while the channel is full; ChannelClosed after
    // close.
    async send(value is T) is Sending<T> {
        panic "Sending.send is a VM intrinsic";
        self;
    }

    // Ends the stream: the receiver gets what is queued, then none.
    close() is void {
        panic "Sending.close is a VM intrinsic";
    }
}

// The receiving side of a channel: `for await channel.receiving() -> value`.
object Receiving<T> {
    // Made by Channel.receiving(); not constructed directly.
    Receiving() {}

    // The next value, waiting for it; ChannelClosed when closed and empty.
    async item() is T {
        panic "Receiving.item is a VM intrinsic";
    }

    // The next value, or none once the channel is closed and drained, so a
    // receiver is walked with for await (#199):
    //
    //     for await jobs.receiving() -> job {
    //         await job.run();
    //     }
    async next() is Maybe<T> {
        try {
            Maybe.some(await self.item());
        }
        catch closed is ChannelClosed {
            Maybe<T>.none;
        }
    }

    // Stops receiving; senders then get ChannelClosed.
    close() is void {
        panic "Receiving.close is a VM intrinsic";
    }
}

// The channel was closed.
enum ChannelClosed is Error = (closed);

// A negative capacity.
enum InvalidChannelCapacity is Error = (capacity(capacity is int));

async test "a channel hands values over in order until closed" {
    let channel is Channel<int> = Channel(capacity: 2);
    let sending = channel.sending();
    await sending.send(1);
    await sending.send(2);
    let receiving = channel.receiving();
    test.is(await receiving.item(), 1);
    test.is(await receiving.item(), 2);
    sending.close();
    test.is(
        try {
            await receiving.item();
        }
        catch error is ChannelClosed {
            -1;
        },
        -1
    );
    test.is(
        try {
            let refused is Channel<int> = Channel(capacity: -1);
            refused.sending();
            "made";
        }
        catch InvalidChannelCapacity.capacity(capacity) {
            capacity.string();
        },
        "-1"
    );
}

hidden object ChannelProducer {
    has output is Sending<int>;

    ChannelProducer(output is Sending<int>) {
        self.output = output;
    }

    async run(count is int) is int {
        for (0..count) -> index {
            await output.send(index * 10);
        }
        output.close();
        count;
    }
}

async test "a receiver is walked with for await until closed and drained" {
    let channel is Channel<int> = Channel(capacity: 2);
    let producer = spawn ChannelProducer(channel.sending()).run(5);
    let received = Atomic(0);
    let seen = Atomic("");
    for await channel.receiving() -> value {
        received.replace(received.value() + value);
        seen.replace(seen.value() + value.string() + ",");
    }
    test.is(await producer, 5);
    test.is(received.value(), 100);
    test.is(seen.value(), "0,10,20,30,40,");
    // A drained, closed receiver answers none at once, and keeps answering it.
    let after = match await channel.receiving().next() {
        case Maybe.some(value) {
            value;
        }
        else {
            -1;
        }
    };
    test.is(after, -1);
    let empty is Channel<string> = Channel(capacity: 0);
    empty.sending().close();
    let walked = Atomic(0);
    for await empty.receiving() -> _text {
        walked.replace(walked.value() + 1);
    }
    test.is(walked.value(), 0);
}
