module async/event v1.0.0;

// One-way cooperative readiness signalling.
//
// Synopsis.
//
//     let started is Event = Event();
//     let workers = start_workers(signal: started);
//
//     prepare_shared_state();
//     started.set();
//     await workers.results();
//
// `Event` is a level-triggered one-way latch. `wait()` suspends while the event
// is not ready. The first `set()` makes it ready permanently, releases every
// current waiter, and lets every future waiter pass immediately. Repeated
// `set()` calls are harmless.
//
// Construct `Event(ready: true)` when the initial state is already ready:
//
//     let available is Event = Event(ready: true);
//     await available.wait();
//
// Cancelling one pending `wait()` removes only that waiter. It neither signals
// the event nor affects other waiters.
//
// An event does not count calls to `set()` and deliberately has no `reset()`.
// Create a fresh event for a fresh readiness cycle. Use `Channel` when each
// individual signal is a message which must be consumed exactly once.

object Event {
    has initial is bool;

    Event() {
        initial = false;
    }

    Event(ready is bool) {
        initial = ready;
    }

    async wait() is Event {
        panic "Event.wait is a VM intrinsic";
        self;
    }

    set() is void {
        panic "Event.set is a VM intrinsic";
    }

    ready() is bool {
        panic "Event.ready is a VM intrinsic";
    }
}

async test "an event releases its waiters once set" {
    let event = Event();
    test.ok(!event.ready());
    let waiting = event.wait();
    event.set();
    event.set();
    test.ok((await waiting).ready());
    test.ok((await Event(ready: true).wait()).ready());
}
