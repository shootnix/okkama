module async/atomic v1.0.0;

// One value that tasks share and replace whole.
//
//     let hits = Atomic(0);
//     hits.replace(hits.value() + 1);
//     if hits.compare_and_replace(expected: 3, revised: 0) { … }
//
// Every operation is synchronous and has no suspension point, so it is whole
// with respect to other tasks. compare_and_replace publishes only when the
// value equals expected; equality is structural. For a value only synchronous
// code touches, cell's Cell is enough.

import "io/stream" take Closing;

// One value shared between tasks, replaced whole.
object Atomic<T> does Closing {
    // An atomic holding value.
    Atomic(value is T) {}

    // The value now; AtomicClosed after close.
    value() is T {
        panic "Atomic.value is a VM intrinsic";
    }

    // Puts value in.
    replace(value is T) is void {
        panic "Atomic.replace is a VM intrinsic";
    }

    // Puts revised in only when the value equals expected; whether it did.
    compare_and_replace(expected is T, revised is T) is bool {
        panic "Atomic.compare_and_replace is a VM intrinsic";
    }

    // Whether it is closed.
    closed() is bool {
        panic "Atomic.closed is a VM intrinsic";
    }

    // Closes it; closing again does nothing.
    close() is void {
        panic "Atomic.close is a VM intrinsic";
    }
}

// The atomic was closed.
enum AtomicClosed is Error = (closed);

test "an atomic replaces, compares and closes" {
    let cell = Atomic(1);
    test.is(cell.value(), 1);
    cell.replace(2);
    test.ok(cell.compare_and_replace(2, 3));
    test.ok(!cell.compare_and_replace(2, 4));
    test.is(cell.value(), 3);
    test.ok(!cell.closed());
    cell.close();
    cell.close();
    test.ok(cell.closed());
    test.is(
        try {
            cell.value();
        }
        catch error is AtomicClosed {
            -1;
        },
        -1
    );
}
