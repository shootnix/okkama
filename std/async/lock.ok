module async/lock v1.0.0;

import "io/stream" take Closing;

// Cancellation-safe cooperative mutual exclusion.
//
// Synopsis.
//
//     let lock is Lock = Lock();
//
//     async update() {
//         let guard is LockGuard = await lock.guard();
//         defer guard.close();
//
//         await repository.replace(next_value);
//     }
//
// `guard()` suspends until it owns the lock and returns the ownership capability.
// The guard has no public constructor: only a successful acquisition can produce
// one. Keep its lifetime lexical with `defer guard.close()`.
//
// Acquirers are granted ownership in FIFO order. Cancelling a waiting `guard()`
// future removes that request without consuming the next ownership grant.
// `LockGuard.close()` is idempotent.
//
// `locked()` is an observation for diagnostics and tests, not a safe precondition
// for another operation: ownership may change immediately after it returns. A lock
// is not reentrant; attempting to acquire it again while retaining its guard waits
// like any other acquisition.
//
// Prefer a task which owns mutable state and receives commands through a channel
// when that shape expresses the domain. Use `Lock` for genuinely shared resource
// boundaries which cannot naturally have one state-owning task.

// Mutual exclusion between tasks: one guard at a time.
object Lock {
    // A lock nobody holds.
    Lock() {}

    // Waits for the lock; close the guard to let it go: `let guard = await
    // lock.guard(); defer guard.close();`.
    async guard() is LockGuard {
        panic "Lock.guard is a VM intrinsic";
    }

    // Whether someone holds it.
    locked() is bool {
        panic "Lock.locked is a VM intrinsic";
    }
}

// The held lock.
object LockGuard does Closing {
    // Whether the lock is closed.
    closed() is bool {
        panic "LockGuard.closed is a VM intrinsic";
    }

    // Closes the lock; closing again does nothing.
    close() is void {
        panic "LockGuard.close is a VM intrinsic";
    }
}

async test "a lock admits one guard at a time" {
    let lock = Lock();
    test.ok(!lock.locked());
    let guard = await lock.guard();
    test.ok(lock.locked());
    let queued = lock.guard();
    guard.close();
    guard.close();
    test.ok(guard.closed());
    let second = await queued;
    test.ok(lock.locked());
    second.close();
    test.ok(!lock.locked());
}
