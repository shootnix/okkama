module async/semaphore v1.0.0;

import "io/stream" take Closing;

// Bounded cooperative access to a shared resource.
//
// Synopsis.
//
//     let connections is Semaphore = Semaphore(permits: 8);
//
//     async request() is Response {
//         let permit is Permit = await connections.permit();
//         defer permit.close();
//         await client.request();
//     }
//
// `Semaphore` limits the number of simultaneous owners. `permit()` suspends
// when every permit is held and grants waiting acquirers in FIFO order.
// `permits()` reports the number currently available, not the configured total.
// It is a diagnostic observation and must not be used as a synchronization
// precondition.
//
// Each successful acquisition creates one `Permit`. A permit has no public
// constructor, returns its capacity exactly once, and supports lexical cleanup
// with `defer permit.close()`. Cancelling a waiting acquisition removes it from
// the queue without consuming capacity.
//
// The initial count must be positive. Use an unbuffered `Channel` for a
// rendezvous rather than treating a zero-permit semaphore as another primitive.

// At most permits tasks at once.
object Semaphore {
    has amount is int;

    // A semaphore of permits, at least one.
    Semaphore(permits is int) {
        confirm permits > 0 else throw InvalidPermitCount.permits(permits);
        amount = permits;
    }

    // Waits for a permit; close it to give it back.
    async permit() is Permit {
        panic "Semaphore.permit is a VM intrinsic";
    }

    // How many permits are free now.
    permits() is int {
        panic "Semaphore.permits is a VM intrinsic";
    }
}

// One taken permit.
object Permit does Closing {
    // Whether the permit is closed.
    closed() is bool {
        panic "Permit.closed is a VM intrinsic";
    }

    // Closes the permit; closing again does nothing.
    close() is void {
        panic "Permit.close is a VM intrinsic";
    }
}

// Fewer than one permit.
enum InvalidPermitCount is Error = (permits(permits is int));

async test "permits are counted and given back" {
    let semaphore = Semaphore(permits: 2);
    let first = await semaphore.permit();
    let second = await semaphore.permit();
    test.is(semaphore.permits(), 0);
    first.close();
    first.close();
    test.ok(first.closed());
    test.is(semaphore.permits(), 1);
    second.close();
    test.is(semaphore.permits(), 2);
    test.is(
        try {
            Semaphore(permits: -1).permits();
        }
        catch InvalidPermitCount.permits(permits) {
            permits;
        },
        -1
    );
}
