module async/cancellation v1.0.0;

// Explicit cooperative cancellation capabilities.
//
// `Cancellation` owns one runtime-local cancellation request. Its
// `cancelling()` action returns a restricted `Cancelling` capability which can
// observe the request but cannot issue it.
//
// Explicit cancellation is independent from `Future.cancel()`. Requesting a
// `Cancellation` does not cancel any future automatically: cooperating code
// must call `check()` or await `wait()`.
//
// Cpu-bound cooperation.
//
// Pass the restricted capability to work which should remain cancellable:
//
//     let cancellation = Cancellation();
//     let token = cancellation.cancelling();
//
//     for records -> record {
//         token.check();
//         process(record);
//     }
//
//     cancellation.cancel();
//
// `check()` is cheap before a request and throws the builtin `Cancelled`
// afterwards.
//
// Waiting for a request.
//
// `wait()` is useful when cancellation itself is an asynchronous event:
//
//     async monitor(cancelling is Cancelling) {
//         await cancelling.wait();
//         audit.writeln("cancellation requested");
//     }
//
//     let cancellation = Cancellation();
//     let monitoring = spawn Monitor(
//         cancelling: cancellation.cancelling(),
//     ).run();
//     cancellation.cancel();
//     await monitoring;
//
// Every waiter resumes exactly once. A wait started after the request completes
// immediately. Cancelling the future returned by `wait()` only abandons that
// wait; it does not request cancellation and does not affect other waiters.
//
// Ownership.
//
// Keep `Cancellation` with the owner of an operation and pass only
// `Cancelling` to collaborators. Constructing `CancellationToken` directly is
// rejected by the runtime; tokens can only come from `cancelling()`.

role Cancelling {
    requested() is bool;
    check() is void;
    async wait() is Cancelling;
}

object Cancellation {
    Cancellation() {}

    cancelling() is Cancelling {
        CancellationToken();
    }

    cancel() is void {
        panic "Cancellation.cancel is a VM intrinsic";
    }
}

object CancellationToken does Cancelling {
    CancellationToken() {}

    requested() is bool {
        panic "CancellationToken.requested is a VM intrinsic";
    }

    check() is void {
        panic "CancellationToken.check is a VM intrinsic";
    }

    async wait() is Cancelling {
        panic "CancellationToken.wait is a VM intrinsic";
        self;
    }
}

async test "a request is seen by every token, once" {
    let cancellation = Cancellation();
    let token = cancellation.cancelling();
    test.ok(!token.requested());
    token.check();
    let waiting = token.wait();
    cancellation.cancel();
    cancellation.cancel();
    test.ok(token.requested());
    test.ok((await waiting).requested());
    test.ok((await cancellation.cancelling().wait()).requested());
    test.is(
        try {
            token.check();
            "continued";
        }
        catch error is Cancelled {
            "cancelled";
        },
        "cancelled"
    );
}
