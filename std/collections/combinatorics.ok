module collections/combinatorics v1.0.0;

import "collections/ordering" take Sorted;
import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "collections/sequence" take Sequencing;
import "error" take InvalidArgument;

// Lazy combinatorial iterators over finite indexed sources.
//
// Every item is materialized only when cursor.item() is requested. The module
// never precomputes all results and every successor cursor is immutable.
// Retaining an earlier cursor therefore retains its original result.
//
// Combinations chooses distinct positions in source order:
//
//     let pairs = Combinations(origin: values, size: 2);
//     // [a,b], [a,c], [b,c]
//
// CombinationsWithReplacement permits a position to occur repeatedly:
//
//     let pairs = CombinationsWithReplacement(origin: values, size: 2);
//     // [a,a], [a,b], [a,c], [b,b], [b,c], [c,c]
//
// Permutations emits ordered selections. Omitting size selects every source
// position; supplying size emits partial permutations:
//
//     let arrangements = Permutations(origin: values, size: 2);
//     // [a,b], [a,c], [b,a], [b,c], [c,a], [c,b]
//
// CartesianProduct treats the outer sequence as dimensions. The rightmost
// dimension advances fastest.
//
// Negative sizes throw InvalidArgument. Choosing more distinct positions than
// a source contains produces no results. Choosing zero positions produces one
// empty result. A product of zero dimensions likewise contains one empty
// result; a product with any empty dimension contains no results.
//
// Laziness limits memory use, not result count. Counts grow explosively:
// combinations as n!/(r!(n-r)!), replacement combinations as
// (n+r-1)!/(r!(n-1)!), permutations as n!/(n-r)!, and products as the
// multiplication of all dimension sizes. Consumers should normally stop
// early or combine these iterators with Taken.

object Combinations<T> does Iterating<@T> {
    has origin is Sequencing<T>;
    has amount is int;

    Combinations(origin is Sequencing<T>, size is int) {
        confirm size >= 0
            else throw InvalidArgument.because("combination size cannot be negative");
        self.origin = origin;
        amount = size;
    }

    cursor() is Cursor<@T> {
        let positions is @int = (0..amount).map() -> index {
            index;
        };
        CombinationCursor(
            origin: origin,
            positions: positions,
            size: amount,
            active: amount <= origin.size(),
        );
    }
}

hidden object CombinationCursor<T> does Cursor<@T> {
    has origin is Sequencing<T>;
    has positions is @int;
    has amount is int;
    has active is bool;

    CombinationCursor(
        origin is Sequencing<T>,
        positions is @int,
        size is int,
        active is bool,
    ) {
        confirm size >= 0 && positions.size() == size
            else throw InvalidArgument.because("combination cursor shape is invalid");
        confirm !active
            || CombinationPositions(
                positions: positions,
                origin_size: origin.size(),
            ).valid()
            else throw InvalidArgument.because("combination cursor positions are invalid");
        self.origin = origin;
        self.positions = positions;
        amount = size;
        self.active = active;
    }

    available() is bool {
        active;
    }

    item() is @T {
        confirm self.available() else throw IterationEnded.ended;
        let result is @T = (0..amount).map() -> index {
            origin.item(positions[index]);
        };
        result;
    }

    successor() is Cursor<@T> {
        confirm self.available() else throw IterationEnded.ended;
        if amount == 0 {
            CombinationCursor(
                origin: origin,
                positions: positions,
                size: amount,
                active: false,
            );
        }
        else {
            let pivot = CombinationPositions(
                positions: positions,
                origin_size: origin.size(),
            ).pivot();
            if pivot < 0 {
                CombinationCursor(
                    origin: origin,
                    positions: positions,
                    size: amount,
                    active: false,
                );
            }
            else {
                let following is @int = (0..amount).map() -> index {
                    if index < pivot {
                        positions[index];
                    }
                    else {
                        positions[pivot] + index - pivot + 1;
                    }
                };
                CombinationCursor(
                    origin: origin,
                    positions: following,
                    size: amount,
                    active: true,
                );
            }
        }
    }
}

object CombinationsWithReplacement<T> does Iterating<@T> {
    has origin is Sequencing<T>;
    has amount is int;

    CombinationsWithReplacement(origin is Sequencing<T>, size is int) {
        confirm size >= 0
            else throw InvalidArgument.because("combination size cannot be negative");
        self.origin = origin;
        amount = size;
    }

    cursor() is Cursor<@T> {
        let positions is @int = (0..amount).map() -> index {
            0;
        };
        ReplacementCombinationCursor(
            origin: origin,
            positions: positions,
            size: amount,
            active: amount == 0 || origin.size() > 0,
        );
    }
}

hidden object ReplacementCombinationCursor<T> does Cursor<@T> {
    has origin is Sequencing<T>;
    has positions is @int;
    has amount is int;
    has active is bool;

    ReplacementCombinationCursor(
        origin is Sequencing<T>,
        positions is @int,
        size is int,
        active is bool,
    ) {
        confirm size >= 0 && positions.size() == size
            else throw InvalidArgument.because("replacement combination cursor shape is invalid");
        confirm !active
            || ReplacementPositions(
                positions: positions,
                origin_size: origin.size(),
            ).valid()
            else throw InvalidArgument.because("replacement combination positions are invalid");
        self.origin = origin;
        self.positions = positions;
        amount = size;
        self.active = active;
    }

    available() is bool {
        active;
    }

    item() is @T {
        confirm self.available() else throw IterationEnded.ended;
        let result is @T = (0..amount).map() -> index {
            origin.item(positions[index]);
        };
        result;
    }

    successor() is Cursor<@T> {
        confirm self.available() else throw IterationEnded.ended;
        if amount == 0 {
            ReplacementCombinationCursor(
                origin: origin,
                positions: positions,
                size: amount,
                active: false,
            );
        }
        else {
            let pivot = ReplacementPositions(
                positions: positions,
                origin_size: origin.size(),
            ).pivot();
            if pivot < 0 {
                ReplacementCombinationCursor(
                    origin: origin,
                    positions: positions,
                    size: amount,
                    active: false,
                );
            }
            else {
                let following is @int = (0..amount).map() -> index {
                    if index < pivot {
                        positions[index];
                    }
                    else {
                        positions[pivot] + 1;
                    }
                };
                ReplacementCombinationCursor(
                    origin: origin,
                    positions: following,
                    size: amount,
                    active: true,
                );
            }
        }
    }
}

object Permutations<T> does Iterating<@T> {
    has origin is Sequencing<T>;
    has amount is int;

    Permutations(origin is Sequencing<T>) {
        self.origin = origin;
        amount = -1;
    }

    Permutations(origin is Sequencing<T>, size is int) {
        confirm size >= 0
            else throw InvalidArgument.because("permutation size cannot be negative");
        self.origin = origin;
        amount = size;
    }

    cursor() is Cursor<@T> {
        // Without a size, a permutation takes every item.
        let count is int = if amount < 0 {
            origin.size();
        }
        else {
            amount;
        };
        let positions is @int = (0..count).map() -> index {
            index;
        };
        PermutationCursor(
            origin: origin,
            positions: positions,
            size: count,
            active: count <= origin.size(),
        );
    }
}

hidden object PermutationCursor<T> does Cursor<@T> {
    has origin is Sequencing<T>;
    has positions is @int;
    has amount is int;
    has active is bool;

    PermutationCursor(
        origin is Sequencing<T>,
        positions is @int,
        size is int,
        active is bool,
    ) {
        confirm size >= 0 && positions.size() == size
            else throw InvalidArgument.because("permutation cursor shape is invalid");
        confirm !active
            || PermutationPositions(
                positions: positions,
                origin_size: origin.size(),
            ).valid()
            else throw InvalidArgument.because("permutation cursor positions are invalid");
        self.origin = origin;
        self.positions = positions;
        amount = size;
        self.active = active;
    }

    available() is bool {
        active;
    }

    item() is @T {
        confirm self.available() else throw IterationEnded.ended;
        let result is @T = (0..amount).map() -> index {
            origin.item(positions[index]);
        };
        result;
    }

    successor() is Cursor<@T> {
        confirm self.available() else throw IterationEnded.ended;
        if amount == 0 {
            PermutationCursor(
                origin: origin,
                positions: positions,
                size: amount,
                active: false,
            );
        }
        else {
            let arrangement = PermutationPositions(
                positions: positions,
                origin_size: origin.size(),
            );
            let pivot = arrangement.pivot();
            if pivot < 0 {
                PermutationCursor(
                    origin: origin,
                    positions: positions,
                    size: amount,
                    active: false,
                );
            }
            else {
                let candidate = arrangement.candidate(pivot, positions[pivot] + 1);
                let following is @int = (0..amount).map() -> index {
                    if index < pivot {
                        positions[index];
                    }
                    else {
                        if index == pivot {
                            candidate;
                        }
                        else {
                            arrangement.available(pivot, candidate, index - pivot - 1);
                        }
                    }
                };
                PermutationCursor(
                    origin: origin,
                    positions: following,
                    size: amount,
                    active: true,
                );
            }
        }
    }
}

object CartesianProduct<T> does Iterating<@T> {
    has origins is Sequencing<Sequencing<T>>;

    CartesianProduct(:origins);

    cursor() is Cursor<@T> {
        let positions is @int = (0..origins.size()).map() -> index {
            0;
        };
        CartesianCursor(
            origins: origins,
            positions: positions,
            active: self.filled(),
        );
    }

    // Every source has an item, so the product has one.
    hidden filled() is bool {
        for (0..origins.size()) -> index {
            if origins.item(index).size() == 0 {
                return false;
            }
        }
        true;
    }
}

hidden object CartesianCursor<T> does Cursor<@T> {
    has origins is Sequencing<Sequencing<T>>;
    has positions is @int;
    has active is bool;

    CartesianCursor(
        origins is Sequencing<Sequencing<T>>,
        positions is @int,
        active is bool,
    ) {
        confirm positions.size() == origins.size()
            else throw InvalidArgument.because("cartesian cursor shape is invalid");
        confirm !active
            || CartesianPositions(
                origins: origins,
                positions: positions,
            ).valid()
            else throw InvalidArgument.because("cartesian cursor positions are invalid");
        self.origins = origins;
        self.positions = positions;
        self.active = active;
    }

    available() is bool {
        active;
    }

    item() is @T {
        confirm self.available() else throw IterationEnded.ended;
        let result is @T = (0..origins.size()).map() -> index {
            origins.item(index).item(positions[index]);
        };
        result;
    }

    successor() is Cursor<@T> {
        confirm self.available() else throw IterationEnded.ended;
        if origins.size() == 0 {
            CartesianCursor(
                origins: origins,
                positions: positions,
                active: false,
            );
        }
        else {
            let pivot = CartesianPositions(
                origins: origins,
                positions: positions,
            ).pivot();
            if pivot < 0 {
                CartesianCursor(
                    origins: origins,
                    positions: positions,
                    active: false,
                );
            }
            else {
                let following is @int = (0..origins.size()).map() -> index {
                    if index < pivot {
                        positions[index];
                    }
                    else {
                        if index == pivot {
                            positions[index] + 1;
                        }
                        else {
                            0;
                        }
                    }
                };
                CartesianCursor(
                    origins: origins,
                    positions: following,
                    active: true,
                );
            }
        }
    }
}

// Positions of a combination: valid, and the index to advance next (-1: last).
hidden object CombinationPositions {
    has origin is @int;
    has source_size is int;

    CombinationPositions(positions is @int, origin_size is int) {
        origin = positions;
        source_size = origin_size;
    }

    valid() is bool {
        for (0..origin.size()) -> index {
            if origin[index] < 0 || origin[index] >= source_size {
                return false;
            }
            if index > 0 && origin[index - 1] >= origin[index] {
                return false;
            }
        }
        true;
    }

    pivot() is int {
        for (0..origin.size()) -> offset {
            let index = origin.size() - offset - 1;
            if origin[index] < source_size - origin.size() + index {
                return index;
            }
        }
        -1;
    }
}

// Positions of a combination with replacement.
hidden object ReplacementPositions {
    has origin is @int;
    has source_size is int;

    ReplacementPositions(positions is @int, origin_size is int) {
        origin = positions;
        source_size = origin_size;
    }

    valid() is bool {
        for (0..origin.size()) -> index {
            if origin[index] < 0 || origin[index] >= source_size {
                return false;
            }
            if index > 0 && origin[index - 1] > origin[index] {
                return false;
            }
        }
        true;
    }

    pivot() is int {
        for (0..origin.size()) -> offset {
            let index = origin.size() - offset - 1;
            if origin[index] < source_size - 1 {
                return index;
            }
        }
        -1;
    }
}

// Positions of a permutation: valid, the index to advance next (-1: last), the
// next unused candidate from `start`, and the unused value of a given rank.
hidden object PermutationPositions {
    has origin is @int;
    has source_size is int;

    PermutationPositions(positions is @int, origin_size is int) {
        origin = positions;
        source_size = origin_size;
    }

    valid() is bool {
        for (0..origin.size()) -> index {
            if origin[index] < 0 || origin[index] >= source_size {
                return false;
            }
            if self.taken(index, origin[index]) {
                return false;
            }
        }
        true;
    }

    pivot() is int {
        for (0..origin.size()) -> offset {
            let index = origin.size() - offset - 1;
            if self.candidate(index, origin[index] + 1) >= 0 {
                return index;
            }
        }
        -1;
    }

    candidate(prefix is int, start is int) is int {
        for (start..source_size) -> candidate {
            if !self.taken(prefix, candidate) {
                return candidate;
            }
        }
        -1;
    }

    available(prefix is int, selected is int, offset is int) is int {
        for (0..source_size) -> candidate {
            let rank = candidate - self.before(prefix, candidate) - if selected < candidate {
                1;
            }
            else {
                0;
            };
            if !self.taken(prefix, candidate)
                && candidate != selected
                && rank == offset {
                    return candidate;
                }
        }
        -1
    }

    // `value` is among the first `stop` positions.
    hidden taken(stop is int, value is int) is bool {
        confirm stop >= 0 && stop <= origin.size()
            else throw InvalidArgument.because("permutation prefix is invalid");
        for (0..stop) -> index {
            if origin[index] == value {
                return true;
            }
        }
        false;
    }

    // How many of the first `stop` positions are below `value`.
    hidden before(stop is int, value is int) is int {
        (0..stop).reduce(0) -> total, index {
            total + if origin[index] < value {
                1;
            }
            else {
                0;
            };
        };
    }
}

// Positions in a cartesian product.
hidden object CartesianPositions<T> {
    has origins is Sequencing<Sequencing<T>>;
    has positions is @int;

    CartesianPositions(
        origins is Sequencing<Sequencing<T>>,
        positions is @int,
    ) {
        self.origins = origins;
        self.positions = positions;
    }

    valid() is bool {
        for (0..origins.size()) -> index {
            if positions[index] < 0 || positions[index] >= origins.item(index).size() {
                return false;
            }
        }
        true;
    }

    pivot() is int {
        for (0..origins.size()) -> offset {
            let index = origins.size() - offset - 1;
            if positions[index] + 1 < origins.item(index).size() {
                return index;
            }
        }
        -1;
    }
}

test "combinations, with replacement, permutations and products in order" {
    let letters = ["a", "b", "c"];
    let joined = (rows is Iterating<@string>) is string {
        rows.map() -> row {
            row.join("");
        }.join(",");
    };
    test.is(joined(Combinations(origin: letters, size: 2)), "ab,ac,bc");
    test.is(joined(CombinationsWithReplacement(origin: letters, size: 2)), "aa,ab,ac,bb,bc,cc");
    test.is(joined(Permutations(origin: letters, size: 2)), "ab,ac,ba,bc,ca,cb");
    test.is(joined(Permutations(origin: letters)), "abc,acb,bac,bca,cab,cba");
    // Dimensions are Sequencing objects: an array of arrays cannot cross into
    // a role of roles yet (#488).
    let dimensions is @Sequencing<string> = [Sorted(["b", "a"]), Sorted(["y", "x"])];
    test.is(joined(CartesianProduct(origins: dimensions)), "ax,ay,bx,by");
}

test "empty and oversized selections" {
    let letters = ["a", "b", "c"];
    let count = (rows is Iterating<@string>) is int {
        rows.reduce(0) -> total, row {
            total + 1;
        };
    };
    test.is(count(Combinations(origin: letters, size: 0)), 1);
    test.is(count(Combinations(origin: letters, size: 4)), 0);
    test.is(count(Permutations(origin: letters, size: 4)), 0);
    let nothing is @Sequencing<string> = [];
    test.is(count(CartesianProduct(origins: nothing)), 1);
    let none_left is @string = [];
    let gap is @Sequencing<string> = [Sorted(["a"]), Sorted(none_left)];
    test.is(count(CartesianProduct(origins: gap)), 0);
    test.is(count(Permutations(origin: ["a", "b", "c", "d"])), 24);
    test.is(count(Combinations(origin: ["a", "b", "c", "d", "e"], size: 3)), 10);
}
