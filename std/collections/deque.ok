module collections/deque v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "collections/list" take List, EmptyList;
import "collections/views" take Dropped, Taken;
import "error" take InvalidArgument, OutOfRange;
import "size" take Sizing;

// An immutable persistent double-ended queue.
//
//     let queue = Deque(values: jobs);
//     let urgent = queue.prefix(high_priority);
//     let ordinary = urgent.suffix(low_priority);
//     let next = ordinary.first();
//     let remaining = ordinary.tail();
//
// first() and last() read the ends; prefix(x) and suffix(x) add at the front
// and the back; tail() drops the first item and body() the last. Each returns
// a new deque: earlier deques stay unchanged and may share immutable list
// nodes with their successors. The ends of an empty deque throw
// EmptyDequeAccess. item(index) gives Python-style indexing with strict
// zero-based bounds (OutOfRange); middle indexing is O(n).
//
// Internally the logical order is a forward list followed by the reverse of a
// backward list. End additions are O(1). When one half grows beyond roughly
// twice the other, construction of the returned deque rebalances both halves
// in O(n); along a linear chain of returned deques, end operations are
// amortized O(1). Traversal preserves insertion order.

// A double-ended queue that never changes: adding or removing at either end
// gives a new one.
object Deque<T> does Iterating<T>, Sizing {
    has values is Iterating<T>;
    has beginning is List<T>;
    has ending is List<T>;
    has amount is int;
    has built is bool;

    // A deque of values, in order.
    Deque(values is Iterating<T>) {
        self.values = values;
        let empty is List<T> = EmptyList();
        beginning = empty;
        ending = empty;
        amount = 0;
        built = false;
    }

    // The two ends as they are; the actions that make a deque pass them
    // already balanced.
    Deque(front is List<T>, back is List<T>, size is int) {
        let nothing is @T = [];
        values = nothing;
        beginning = front;
        ending = back;
        amount = size;
        built = true;
    }

    // Walks the items from the front.
    cursor() is Cursor<T> {
        let parts = self.parts();
        DequeItems(front: parts.front(), back: parts.back()).cursor();
    }

    // How many items.
    size() is int {
        self.parts().size();
    }

    // The item at index from the front.
    item(index is int) is T {
        let parts = self.parts();
        confirm index >= 0 && index < parts.size()
            else throw OutOfRange.because("deque index is outside the sequence");
        if index < parts.front().size() {
            Dropped(origin: parts.front(), count: index).cursor().item();
        }
        else {
            Dropped(
                origin: parts.back(),
                count: parts.size() - index - 1,
            ).cursor().item();
        }
    }

    // The front item; EmptyDequeAccess when empty.
    first() is T {
        let parts = self.parts();
        confirm parts.size() > 0 else throw EmptyDequeAccess.operation("first");
        if parts.front().size() > 0 {
            parts.front().first();
        }
        else {
            parts.back().first();
        }
    }

    // The back item; EmptyDequeAccess when empty.
    last() is T {
        let parts = self.parts();
        confirm parts.size() > 0 else throw EmptyDequeAccess.operation("last");
        if parts.back().size() > 0 {
            parts.back().first();
        }
        else {
            parts.front().first();
        }
    }

    // This deque with value in front.
    prefix(value is T) is Deque<T> {
        let parts = self.parts();
        self.balanced(parts.front().prefix(value), parts.back(), parts.size() + 1);
    }

    // This deque with value at the back.
    suffix(value is T) is Deque<T> {
        let parts = self.parts();
        self.balanced(parts.front(), parts.back().prefix(value), parts.size() + 1);
    }

    // This deque without its front item.
    tail() is Deque<T> {
        let parts = self.parts();
        confirm parts.size() > 0 else throw EmptyDequeAccess.operation("tail");
        if parts.front().size() > 0 {
            self.balanced(parts.front().tail(), parts.back(), parts.size() - 1);
        }
        else {
            self.balanced(parts.front(), parts.back().tail(), parts.size() - 1);
        }
    }

    // This deque without its back item.
    body() is Deque<T> {
        let parts = self.parts();
        confirm parts.size() > 0 else throw EmptyDequeAccess.operation("body");
        if parts.back().size() > 0 {
            self.balanced(parts.front(), parts.back().tail(), parts.size() - 1);
        }
        else {
            self.balanced(parts.front().tail(), parts.back(), parts.size() - 1);
        }
    }

    // A deque of these ends, rebalanced when one of them ran out.
    hidden balanced(front is List<T>, back is List<T>, size is int) is Deque<T> {
        let parts = NormalizedDeque(front: front, back: back, size: size).parts();
        Deque(front: parts.front(), back: parts.back(), size: parts.size());
    }

    // The ends: given, or split from the values on the first question.
    hidden parts() is DequeParts<T> {
        if built {
            DequeParts(front: beginning, back: ending, size: amount);
        }
        else {
            self.split();
        }
    }

    // The values split into two balanced ends, once (#491).
    hidden split() is DequeParts<T> {
        once let parts = BalancedDeque(values: values).parts();
        parts;
    }
}

hidden object DequeItems<T> does Iterating<T> {
    has beginning is List<T>;
    has ending is List<T>;

    DequeItems(front is List<T>, back is List<T>) {
        beginning = front;
        ending = back;
    }

    cursor() is Cursor<T> {
        ConcatenatedDequeCursor(
            front: beginning.cursor(),
            back: ReversedList(values: ending).list().cursor(),
        );
    }
}

hidden object ConcatenatedDequeCursor<T> does Cursor<T> {
    has beginning is Cursor<T>;
    has ending is Cursor<T>;

    ConcatenatedDequeCursor(front is Cursor<T>, back is Cursor<T>) {
        beginning = front;
        ending = back;
    }

    available() is bool {
        beginning.available() || ending.available();
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        if beginning.available() {
            beginning.item();
        }
        else {
            ending.item();
        }
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        if beginning.available() {
            ConcatenatedDequeCursor(front: beginning.successor(), back: ending);
        }
        else {
            ConcatenatedDequeCursor(front: beginning, back: ending.successor());
        }
    }
}

hidden object ArrayItems<T> does Iterating<T> {
    has origin is @T;
    has witness is Iterating<T>;

    ArrayItems(values is @T, witness is Iterating<T>) {
        origin = values;
        self.witness = witness;
    }

    cursor() is Cursor<T> {
        ArrayCursor(values: origin, position: 0, witness: witness);
    }
}

hidden object ArrayCursor<T> does Cursor<T> {
    has origin is @T;
    has position is int;
    has witness is Iterating<T>;

    ArrayCursor(values is @T, position is int, witness is Iterating<T>) {
        confirm position >= 0 && position <= values.size()
            else throw InvalidArgument.because("array cursor position is invalid");
        origin = values;
        self.position = position;
        self.witness = witness;
    }

    available() is bool {
        position < origin.size();
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        origin[position];
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        ArrayCursor(values: origin, position: position + 1, witness: witness);
    }
}

hidden object ForwardList<T> {
    has origin is Iterating<T>;

    ForwardList(values is Iterating<T>) {
        origin = values;
    }

    list() is List<T> {
        let reversed is List<T> = origin.reduce(EmptyList()) -> items, item {
            items.prefix(item);
        };
        let result is List<T> = reversed.reduce(EmptyList()) -> items, item {
            items.prefix(item);
        };
        result;
    }
}

hidden object ReversedList<T> {
    has origin is Iterating<T>;

    ReversedList(values is Iterating<T>) {
        origin = values;
    }

    list() is List<T> {
        let result is List<T> = origin.reduce(EmptyList()) -> items, item {
            items.prefix(item);
        };
        result;
    }
}

hidden object DequeParts<T> {
    has beginning is List<T>;
    has ending is List<T>;
    has amount is int;

    DequeParts(front is List<T>, back is List<T>, size is int) {
        confirm size >= 0 && size == front.size() + back.size()
            else throw InvalidArgument.because("deque parts are inconsistent");
        beginning = front;
        ending = back;
        amount = size;
    }

    front() is List<T> {
        beginning;
    }

    back() is List<T> {
        ending;
    }

    size() is int {
        amount;
    }
}

hidden object BalancedDeque<T> {
    has origin is @T;
    has witness is Iterating<T>;

    BalancedDeque(values is Iterating<T>) {
        let materialized is @T = values.map() -> item {
            item;
        };
        origin = materialized;
        witness = values;
    }

    parts() is DequeParts<T> {
        let items = ArrayItems(values: origin, witness: witness);
        let front_size = ((origin.size() + 1) / 2).int();
        DequeParts(
            front: ForwardList(
                values: Taken(origin: items, count: front_size),
            ).list(),
            back: ReversedList(
                values: Dropped(origin: items, count: front_size),
            ).list(),
            size: origin.size(),
        );
    }
}

hidden object NormalizedDeque<T> {
    has beginning is List<T>;
    has ending is List<T>;
    has amount is int;

    NormalizedDeque(front is List<T>, back is List<T>, size is int) {
        confirm size >= 0 && size == front.size() + back.size()
            else throw InvalidArgument.because("deque state is inconsistent");
        beginning = front;
        ending = back;
        amount = size;
    }

    parts() is DequeParts<T> {
        if self.unbalanced() {
            BalancedDeque(values: DequeItems(front: beginning, back: ending)).parts();
        }
        else {
            DequeParts(front: beginning, back: ending, size: amount);
        }
    }

    hidden unbalanced() is bool {
        if beginning.size() > ending.size() {
            beginning.size() - ending.size() > ending.size() + 1;
        }
        else {
            ending.size() - beginning.size() > beginning.size() + 1;
        }
    }
}

// An empty deque has no front or back item; operation names the call.
enum EmptyDequeAccess is Error = (operation(operation is string));

test "a deque reads, adds and drops at both ends" {
    let deque = Deque(values: [1, 2, 3]);
    test.is(deque.first(), 1);
    test.is(deque.last(), 3);
    test.is(deque.prefix(0).first(), 0);
    test.is(deque.suffix(4).last(), 4);
    test.is(deque.tail().first(), 2);
    test.is(deque.body().last(), 2);
    test.is(deque.first(), 1);
    let drained = deque.tail().tail().tail();
    test.is(drained.size(), 0);
    test.is(
        try {
            drained.first();
            "no error";
        }
        catch EmptyDequeAccess.operation(name) {
            name;
        },
        "first"
    );
    test.is(
        try {
            drained.body();
            "no error";
        }
        catch EmptyDequeAccess.operation(name) {
            name;
        },
        "body"
    );
    let grown = (0..50).reduce(Deque(values: [0])) -> items, n {
        items.suffix(n + 1);
    };
    test.is(grown.item(25), 25);
    test.is(grown.body().last(), 49);
}
