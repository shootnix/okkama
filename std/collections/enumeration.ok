module collections/enumeration v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;

// Adds a stable integer index to every item of an Iterating object.
//
// Enumerated does not consume or change the origin. Its cursor is immutable:
// successor() returns another cursor while the previous cursor keeps pointing
// at the same indexed item.
//
// Number values from zero:
//
//     let cursor = Enumerated(origin: names).cursor();
//     let first = cursor.item();
//     // first.index() == 0
//     // first.item() is the first name
//
// Number values from a chosen index, for example human-friendly line numbers:
//
//     let lines = Enumerated(origin: document.lines(), start: 1);
//     let output = Stdout();
//     for lines -> line {
//         output.writeln(line.index().string(), ": ", line.item());
//     }
//
// Each line received by the loop is an Indexed<string>. Its index() is the
// line number and its item() is the original line.
//
// Advance without mutation:
//
//     let first = Enumerated(origin: names).cursor();
//     let second = first.successor();
//     // first.item().index() == 0
//     // second.item().index() == 1
//
// Check available() before item() or successor(). Calling either method on an
// exhausted cursor throws IterationEnded. If another item would require an
// index larger than int.max, successor() throws EnumerationOverflow.

// An item with its position.
object Indexed<T> {
    has offset is int;
    has origin is T;

    // item at index.
    Indexed(index is int, item is T) {
        offset = index;
        origin = item;
    }

    // Its position.
    index() is int {
        offset;
    }

    // The item.
    item() is T {
        origin;
    }
}

// The items of origin with their positions: `for Enumerated(origin: names) ->
// entry { entry.index(); }`.
object Enumerated<T> does Iterating<Indexed<T>> {
    has origin is Iterating<T>;
    has start is int = 0;

    // Positions counted from 0.
    Enumerated(:origin);

    // Positions counted from start.
    Enumerated(:origin, :start);

    // Walks the items.
    cursor() is Cursor<Indexed<T>> {
        EnumerationCursor(
            origin: origin.cursor(),
            position: start,
        );
    }
}

hidden object EnumerationCursor<T> does Cursor<Indexed<T>> {
    has origin is Cursor<T>;
    has position is int;

    EnumerationCursor(:origin, :position);

    available() is bool {
        origin.available();
    }

    item() is Indexed<T> {
        confirm self.available() else throw IterationEnded.ended;
        Indexed(index: position, item: origin.item());
    }

    successor() is Cursor<Indexed<T>> {
        confirm self.available() else throw IterationEnded.ended;

        let following = origin.successor();
        EnumerationCursor(
            origin: following,
            position: if following.available() {
                confirm position < 9223372036854775807
                    else throw EnumerationOverflow.index(position);
                position + 1;
            }
            else {
                position;
            },
        );
    }
}

// A position past the largest int.
enum EnumerationOverflow is Error = (index(index is int));

test "enumerated numbers items from zero or a chosen start" {
    test.is(Enumerated(origin: ["a", "b", "c"]).map() -> indexed {
        indexed.index().string() + indexed.item();
    }.join(","), "0a,1b,2c");
    test.is(Enumerated(origin: ["x", "y"], start: 1).map() -> line {
        line.index().string() + ":" + line.item();
    }.join(" "), "1:x 2:y");
    let first = Enumerated(origin: ["a", "b"]).cursor();
    let second = first.successor();
    test.is(first.item().index(), 0);
    test.is(second.item().index(), 1);
    test.ok(!second.successor().available());
    test.is(
        try {
            second.successor().item().index();
        }
        catch error is IterationEnded {
            -1;
        },
        -1
    );
    test.is(Indexed(index: 7, item: "z").item(), "z");
}
