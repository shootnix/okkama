module collections/set v1.0.0;

import "collections/iteration" take Cursor, CursorItems, Iterating, IterationEnded;
import "collections/list" take List, EmptyList;
import "collections/views" take Filtered;
import "size" take Sizing;

// Immutable sets with deterministic traversal order.
//
// OrderedSet keeps the first occurrence of every value:
//
//     let empty is List<string> = EmptyList();
//     let input = empty
//         .prefix("third")
//         .prefix("first")
//         .prefix("second")
//         .prefix("first");
//     let names = OrderedSet(values: input);
//     // traversal: "first", "second", "third"
//
// addition() and difference() are nouns: each denotes another immutable set.
// Existing sets remain unchanged and may share their origins:
//
//     let extended = names.addition("fourth");
//     let shortened = extended.difference("second");
//
// Binary set objects preserve deterministic order:
//
//     let either = Union(left: preferred, right: fallback);
//     let common = Intersection(left: preferred, right: fallback);
//     let only_preferred = Difference(left: preferred, right: fallback);
//     let changed = SymmetricDifference(left: preferred, right: fallback);
//
// Union traverses the left set first and then unseen right values.
// Intersection and Difference retain left order. SymmetricDifference emits
// left-only values followed by right-only values.
//
// OrderedSet takes any T with runtime equality, arrays included, so it uses
// strict runtime equality and linear membership instead of pretending to be a
// HashSet. When the values are map keys — scalars, enums or value objects
// (#212) — KeyedSet keeps them in a map, in key order, with logarithmic
// membership; the compiler checks that its T is a key type (#242). Native
// opaque handles have no equality.
//
// Set is conceptually the conjunction of Iterating<T> and Sizing. Until role
// composition exists, concrete sets explicitly implement all three roles.

// Distinct values with a fixed walking order; adding or removing gives a new
// set.
role Set<T> {
    // Walks the values in the set's order.
    cursor() is Cursor<T>;
    // How many values.
    size() is int;
    // Whether value is in the set.
    membership(value is T) is bool;
    // This set with value added.
    addition(value is T) is Set<T>;
    // This set without value.
    difference(value is T) is Set<T>;
}

// A set of map keys in key order (#242): membership is O(log n), and
// building one from n values is O(n log n).
//
//     let seen = KeyedSet(values: ["b", "a", "b"]);   // traversal: "a", "b"
//     seen.membership("a");                             // true
object KeyedSet<T> does Set<T>, Iterating<T>, Sizing {
    has entries is %T:bool;

    // The distinct values, kept as map keys in key order.
    KeyedSet(values is Iterating<T>) {
        let empty is %T:bool = [:];
        entries = values.reduce(empty) -> found, value {
            found + [value: true];
        };
    }

    // A set over a map of entries; KeyedSet(values) makes it.
    KeyedSet(:entries);

    // Walks the values in key order.
    cursor() is Cursor<T> {
        entries.keys().cursor();
    }

    // How many values.
    size() is int {
        entries.size();
    }

    // Whether value is in the set, in O(log n).
    membership(value is T) is bool {
        entries.has(value);
    }

    // This set with value added.
    addition(value is T) is Set<T> {
        KeyedSet(entries: entries + [value: true]);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        KeyedSet(entries: entries - [value: true]);
    }

    test "keeps map keys in key order with logarithmic membership" {
        let seen = KeyedSet(values: ["b", "a", "b"]);
        test.is(seen.size(), 2);
        test.ok(seen.membership("a"));
        test.ok(!seen.membership("c"));
        let grown = seen.addition("c").difference("a");
        test.is(grown.size(), 2);
        test.ok(grown.membership("c") && !grown.membership("a"));
    }
}

// The distinct values in first-appearance order, for any value with equality.
object OrderedSet<T> does Set<T>, Iterating<T>, Sizing {
    has origin is Iterating<T>;

    // The distinct values of values.
    OrderedSet(values is Iterating<T>) {
        origin = values;
    }

    // Walks in first-appearance order.
    cursor() is Cursor<T> {
        self.distinct().cursor();
    }

    // How many values.
    size() is int {
        self.distinct().size();
    }

    // Whether value is in the set.
    membership(value is T) is bool {
        for self.distinct() -> item {
            if item == value {
                return true;
            }
        }
        false;
    }

    // The values without repeats, in first-occurrence order (#491).
    hidden distinct() is List<T> {
        once let kept = DistinctList(values: origin).list();
        kept;
    }

    // This set with value added at the end.
    addition(value is T) is Set<T> {
        SetWith(origin: self, value: value);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        SetWithout(origin: self, value: value);
    }
}

// The values of either set: left's first, then right's that left lacks.
object Union<T> does Set<T>, Iterating<T>, Sizing {
    has left is Set<T>;
    has right is Set<T>;

    // left or right.
    Union(:left, :right);

    // Walks left's values, then right's new ones.
    cursor() is Cursor<T> {
        ConcatenatedSetCursor(
            left: left.cursor(),
            right: Filtered(
                origin: right,
                condition: AbsentFrom(origin: left).membership,
            ).cursor(),
        );
    }

    // How many values.
    size() is int {
        self.reduce(0) -> amount, item {
            amount + 1;
        };
    }

    // Whether either set has value.
    membership(value is T) is bool {
        left.membership(value) || right.membership(value);
    }

    // This set with value added.
    addition(value is T) is Set<T> {
        SetWith(origin: self, value: value);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        SetWithout(origin: self, value: value);
    }
}

// The values both sets have, in left's order.
object Intersection<T> does Set<T>, Iterating<T>, Sizing {
    has left is Set<T>;
    has right is Set<T>;

    // left and right.
    Intersection(:left, :right);

    // Walks in left's order.
    cursor() is Cursor<T> {
        Filtered(
            origin: left,
            condition: right.membership,
        ).cursor();
    }

    // How many values.
    size() is int {
        self.reduce(0) -> amount, item {
            amount + 1;
        };
    }

    // Whether both sets have value.
    membership(value is T) is bool {
        left.membership(value) && right.membership(value);
    }

    // This set with value added.
    addition(value is T) is Set<T> {
        SetWith(origin: self, value: value);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        SetWithout(origin: self, value: value);
    }
}

// The values of left that right lacks, in left's order.
object Difference<T> does Set<T>, Iterating<T>, Sizing {
    has left is Set<T>;
    has right is Set<T>;

    // left without right.
    Difference(:left, :right);

    // Walks in left's order.
    cursor() is Cursor<T> {
        Filtered(
            origin: left,
            condition: AbsentFrom(origin: right).membership,
        ).cursor();
    }

    // How many values.
    size() is int {
        self.reduce(0) -> amount, item {
            amount + 1;
        };
    }

    // Whether left has value and right does not.
    membership(value is T) is bool {
        left.membership(value) && !right.membership(value);
    }

    // This set with value added.
    addition(value is T) is Set<T> {
        SetWith(origin: self, value: value);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        SetWithout(origin: self, value: value);
    }
}

// The values exactly one of the sets has: left's, then right's.
object SymmetricDifference<T> does Set<T>, Iterating<T>, Sizing {
    has left is Set<T>;
    has right is Set<T>;

    // left or right but not both.
    SymmetricDifference(:left, :right);

    // Walks left's values, then right's.
    cursor() is Cursor<T> {
        ConcatenatedSetCursor(
            left: Filtered(
                origin: left,
                condition: AbsentFrom(origin: right).membership,
            ).cursor(),
            right: Filtered(
                origin: right,
                condition: AbsentFrom(origin: left).membership,
            ).cursor(),
        );
    }

    // How many values.
    size() is int {
        self.reduce(0) -> amount, item {
            amount + 1;
        };
    }

    // Whether exactly one set has value.
    membership(value is T) is bool {
        left.membership(value) != right.membership(value);
    }

    // This set with value added.
    addition(value is T) is Set<T> {
        SetWith(origin: self, value: value);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        SetWithout(origin: self, value: value);
    }
}

// A set with one more value, as Set.addition() gives it.
object SetWith<T> does Set<T>, Iterating<T>, Sizing {
    has origin is Set<T>;
    has value is T;

    // origin with value.
    SetWith(origin is Set<T>, value is T) {
        self.origin = origin;
        self.value = value;
    }

    // Walks origin, then value when it is new.
    cursor() is Cursor<T> {
        if origin.membership(value) {
            origin.cursor();
        }
        else {
            SetWithCursor(origin: origin.cursor(), value: value, emitted: false);
        }
    }

    // How many values.
    size() is int {
        origin.size() + if origin.membership(value) {
            0;
        }
        else {
            1;
        };
    }

    // Whether value is value or in origin.
    membership(value is T) is bool {
        self.value == value || origin.membership(value);
    }

    // This set with value added.
    addition(value is T) is Set<T> {
        SetWith(origin: self, value: value);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        SetWithout(origin: self, value: value);
    }
}

// A set with one value less, as Set.difference() gives it.
object SetWithout<T> does Set<T>, Iterating<T>, Sizing {
    has origin is Set<T>;
    has value is T;

    // origin without value.
    SetWithout(origin is Set<T>, value is T) {
        self.origin = origin;
        self.value = value;
    }

    // Walks origin, skipping value.
    cursor() is Cursor<T> {
        Filtered(
            origin: origin,
            condition: DifferentFrom(origin: value).comparison,
        ).cursor();
    }

    // How many values.
    size() is int {
        origin.size() - if origin.membership(value) {
            1;
        }
        else {
            0;
        };
    }

    // Whether origin has value and it is not the one removed.
    membership(value is T) is bool {
        self.value != value && origin.membership(value);
    }

    // This set with value added.
    addition(value is T) is Set<T> {
        SetWith(origin: self, value: value);
    }

    // This set without value.
    difference(value is T) is Set<T> {
        SetWithout(origin: self, value: value);
    }
}

hidden object SetWithCursor<T> does Cursor<T> {
    has origin is Cursor<T>;
    has value is T;
    has emitted is bool;

    SetWithCursor(:origin, :value, :emitted);

    available() is bool {
        origin.available() || !emitted;
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        if origin.available() {
            origin.item();
        }
        else {
            value;
        }
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        if origin.available() {
            SetWithCursor(origin: origin.successor(), value: value, emitted: emitted);
        }
        else {
            SetWithCursor(origin: origin, value: value, emitted: true);
        }
    }
}

hidden object ConcatenatedSetCursor<T> does Cursor<T> {
    has left is Cursor<T>;
    has right is Cursor<T>;

    ConcatenatedSetCursor(:left, :right);

    available() is bool {
        left.available() || right.available();
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        if left.available() {
            left.item();
        }
        else {
            right.item();
        }
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        if left.available() {
            ConcatenatedSetCursor(left: left.successor(), right: right);
        }
        else {
            ConcatenatedSetCursor(left: left, right: right.successor());
        }
    }
}

// A condition true for values a set does not have, for Filtered.
object AbsentFrom<T> {
    has origin is Set<T>;

    // Values absent from origin.
    AbsentFrom(:origin);

    // Whether origin lacks value.
    membership(value is T) is bool {
        !origin.membership(value);
    }
}

// A condition true for values other than one, for Filtered.
object DifferentFrom<T> {
    has origin is T;

    // Values other than origin.
    DifferentFrom(:origin);

    // Whether value differs from origin.
    comparison(value is T) is bool {
        origin != value;
    }
}

// The distinct values as a List, in first-appearance order.
object DistinctList<T> {
    has origin is Iterating<T>;

    // The distinct values of values.
    DistinctList(values is Iterating<T>) {
        origin = values;
    }

    // The list.
    list() is List<T> {
        let reversed is List<T> = origin.reduce(EmptyList()) -> items, item {
            if self.contains(items, item) {
                items;
            }
            else {
                items.prefix(item);
            }
        };
        let result is List<T> = reversed.reduce(EmptyList()) -> items, item {
            items.prefix(item);
        };
        result;
    }

    hidden contains(items is List<T>, value is T) is bool {
        for items -> item {
            if item == value {
                return true;
            }
        }
        false;
    }
}
