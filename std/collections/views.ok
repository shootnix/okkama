module collections/views v1.0.0;

import "collections/iteration" take Cursor, CursorItems, Iterating, IterationEnded;
import "collections/enumeration" take Enumerated;
import "collections/sequence" take Sequencing, EmptySequence;
import "collections/combining" take Chained, Pair;
import "error" take InvalidArgument, OutOfRange;
import "size" take Sizing;

// Lazy views transform cursor traversal without changing their origins.
// Views may be freely composed; no intermediate collection is materialized
// except the @T value intentionally emitted by Chunked.
//
//     let visible = Taken(
//         origin: Filtered(origin: users, condition: (user is User) is bool { user.active(); }),
//         count: 10,
//     );
//
// Mapped, Filtered, Taken, Dropped and their while variants are lazy.
// Flattened removes exactly one Iterating layer. Pairwise emits adjacent pairs.
// Accumulated emits its explicit initial value before consuming the origin.
// Reduced projects the final accumulated value.
//
// A typed action makes both sides of Mapped explicit:
//
//     let label is (User) is string = (user is User) is string { user.name(); };
//     let names = Mapped(origin: users, mapping: label);
//
// Chunked materializes one bounded array at a time, including a shorter final
// array. Flattened can later join an Iterating of chunks or pages by one level:
//
//     let batches = Chunked(origin: rows, size: 100);
//     let rows_again = Flattened(origin: batches);
//
// Accumulated is a running fold and includes the initial value. Reduced gives
// only the final fold result:
//
//     let totals = Accumulated(
//         origin: prices,
//         initial: 0,
//         action: (total is int, price is int) is int { total + price; },
//     );
//     let total is int = Reduced(
//         origin: prices,
//         initial: 0,
//         action: (sum is int, price is int) is int { sum + price; },
//     ).total();
//
// Sliced follows itertools.islice semantics: start and stop are non-negative,
// stop is exclusive, and step is positive. Reverse traversal belongs to
// Reversed and therefore requires a Sequencing origin:
//
//     let sample = Sliced(origin: events, start: 10, stop: 100, step: 5);
//     let newest_first = Reversed(origin: stored_events);

hidden object CursorStep<T> {
    has origin is Cursor<T>;
    has rest is Cursor<T>;

    CursorStep(current is Cursor<T>, following is Cursor<T>) {
        origin = current;
        rest = following;
    }

    current() is Cursor<T> {
        origin;
    }

    following() is Cursor<T> {
        rest;
    }

    item() is T {
        origin.item();
    }
}

hidden object CursorSteps<T> does Iterating<CursorStep<T>> {
    has origin is Cursor<T>;

    CursorSteps(cursor is Cursor<T>) {
        origin = cursor;
    }

    cursor() is Cursor<CursorStep<T>> {
        CursorStepCursor(origin: origin);
    }
}

hidden object CursorStepCursor<T> does Cursor<CursorStep<T>> {
    has origin is Cursor<T>;

    CursorStepCursor(:origin);

    available() is bool {
        origin.available();
    }

    item() is CursorStep<T> {
        confirm self.available() else throw IterationEnded.ended;
        CursorStep(current: origin, following: origin.successor());
    }

    successor() is Cursor<CursorStep<T>> {
        confirm self.available() else throw IterationEnded.ended;
        CursorStepCursor(origin: origin.successor());
    }
}

// Each item of origin through mapping, as the walk goes.
object Mapped<A, B> does Iterating<B> {
    has origin is Iterating<A>;
    has mapping is (A) is B;

    // origin mapped by mapping.
    Mapped(:origin, :mapping);

    // Walks the items.
    cursor() is Cursor<B> {
        MappedCursorSearch(origin: origin.cursor(), mapping: mapping).cursor();
    }
}

hidden object MappedCursorSearch<A, B> {
    has origin is Cursor<A>;
    has mapping is (A) is B;

    MappedCursorSearch(:origin, :mapping);

    cursor() is Cursor<B> {
        if origin.available() {
            MappedCursor(
                value: mapping(origin.item()),
                remaining: origin.successor(),
                mapping: mapping,
            );
        }
        else {
            EmptyMappedCursor(origin: origin, mapping: mapping);
        }
    }
}

hidden object MappedCursor<A, B> does Cursor<B> {
    has origin is B;
    has remaining is Cursor<A>;
    has mapping is (A) is B;

    MappedCursor(value is B, remaining is Cursor<A>, mapping is (A) is B) {
        origin = value;
        self.remaining = remaining;
        self.mapping = mapping;
    }

    available() is bool {
        true;
    }

    item() is B {
        origin;
    }

    successor() is Cursor<B> {
        MappedCursorSearch(origin: remaining, mapping: mapping).cursor();
    }
}

hidden object EmptyMappedCursor<A, B> does Cursor<B> {
    has origin is Cursor<A>;
    has mapping is (A) is B;

    EmptyMappedCursor(:origin, :mapping);

    available() is bool {
        false;
    }

    item() is B {
        throw IterationEnded.ended;
    }

    successor() is Cursor<B> {
        throw IterationEnded.ended;
    }
}

// The items of origin for which condition holds.
object Filtered<T> does Iterating<T> {
    has origin is Iterating<T>;
    has condition is (T) is bool;

    // origin filtered by condition.
    Filtered(:origin, :condition);

    // Walks the items.
    cursor() is Cursor<T> {
        FilteredCursorSearch(origin: origin.cursor(), condition: condition).cursor();
    }
}

hidden object FilteredCursorSearch<T> {
    has origin is Cursor<T>;
    has condition is (T) is bool;

    FilteredCursorSearch(:origin, :condition);

    cursor() is Cursor<T> {
        if !origin.available() {
            EmptyFilteredCursor(origin: origin, condition: condition);
        }
        else {
            for CursorSteps(cursor: origin) -> step {
                last FilteredCursor(
                    origin: step.current(),
                    condition: condition,
                ) if condition(step.item());
                EmptyFilteredCursor(origin: step.following(), condition: condition);
            }
        }
    }
}

hidden object FilteredCursor<T> does Cursor<T> {
    has origin is Cursor<T>;
    has condition is (T) is bool;

    FilteredCursor(:origin, :condition);

    available() is bool {
        true;
    }

    item() is T {
        origin.item();
    }

    successor() is Cursor<T> {
        FilteredCursorSearch(origin: origin.successor(), condition: condition).cursor();
    }
}

hidden object EmptyFilteredCursor<T> does Cursor<T> {
    has origin is Cursor<T>;
    has condition is (T) is bool;

    EmptyFilteredCursor(:origin, :condition);

    available() is bool {
        false;
    }

    item() is T {
        throw IterationEnded.ended;
    }

    successor() is Cursor<T> {
        throw IterationEnded.ended;
    }
}

// The first count items of origin.
object Taken<T> does Iterating<T> {
    has origin is Iterating<T>;
    has amount is int;

    // At most count items; count must not be negative.
    Taken(origin is Iterating<T>, count is int) {
        confirm count >= 0 else throw InvalidArgument.because("take count cannot be negative");
        self.origin = origin;
        amount = count;
    }

    // Walks the items.
    cursor() is Cursor<T> {
        TakenCursor(origin: origin.cursor(), remaining: amount);
    }
}

hidden object TakenCursor<T> does Cursor<T> {
    has origin is Cursor<T>;
    has remaining is int;

    TakenCursor(origin is Cursor<T>, remaining is int) {
        confirm remaining >= 0
            else throw InvalidArgument.because("remaining take count cannot be negative");
        self.origin = origin;
        self.remaining = remaining;
    }

    available() is bool {
        remaining > 0 && origin.available();
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        origin.item();
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        TakenCursor(origin: origin.successor(), remaining: remaining - 1);
    }
}

// The items of origin after the first count.
object Dropped<T> does Iterating<T> {
    has origin is Iterating<T>;
    has amount is int;

    // origin without its first count items.
    Dropped(origin is Iterating<T>, count is int) {
        confirm count >= 0 else throw InvalidArgument.because("drop count cannot be negative");
        self.origin = origin;
        amount = count;
    }

    // Walks the items.
    cursor() is Cursor<T> {
        DroppedCursorSearch(origin: origin.cursor(), count: amount).cursor();
    }
}

hidden object DroppedCursorSearch<T> {
    has origin is Cursor<T>;
    has amount is int;

    DroppedCursorSearch(origin is Cursor<T>, count is int) {
        confirm count >= 0 else throw InvalidArgument.because("drop count cannot be negative");
        self.origin = origin;
        amount = count;
    }

    cursor() is Cursor<T> {
        if amount == 0 || !origin.available() {
            origin;
        }
        else {
            for Enumerated(origin: CursorSteps(cursor: origin)) -> indexed {
                let step = indexed.item();
                last step.following() if indexed.index() == amount - 1;
                step.following();
            }
        }
    }
}

// The items of origin up to the first one for which condition fails.
object TakenWhile<T> does Iterating<T> {
    has origin is Iterating<T>;
    has condition is (T) is bool;

    // origin while condition holds.
    TakenWhile(:origin, :condition);

    // Walks the items.
    cursor() is Cursor<T> {
        TakenWhileCursorSearch(origin: origin.cursor(), condition: condition).cursor();
    }
}

hidden object TakenWhileCursorSearch<T> {
    has origin is Cursor<T>;
    has condition is (T) is bool;

    TakenWhileCursorSearch(:origin, :condition);

    cursor() is Cursor<T> {
        if origin.available() && condition(origin.item()) {
            TakenWhileCursor(origin: origin, condition: condition);
        }
        else {
            EmptyTakenWhileCursor(origin: origin, condition: condition);
        }
    }
}

hidden object TakenWhileCursor<T> does Cursor<T> {
    has origin is Cursor<T>;
    has condition is (T) is bool;

    TakenWhileCursor(:origin, :condition);

    available() is bool {
        true;
    }

    item() is T {
        origin.item();
    }

    successor() is Cursor<T> {
        TakenWhileCursorSearch(origin: origin.successor(), condition: condition).cursor();
    }
}

hidden object EmptyTakenWhileCursor<T> does Cursor<T> {
    has origin is Cursor<T>;
    has condition is (T) is bool;

    EmptyTakenWhileCursor(:origin, :condition);

    available() is bool {
        false;
    }

    item() is T {
        throw IterationEnded.ended;
    }

    successor() is Cursor<T> {
        throw IterationEnded.ended;
    }
}

// The items of origin from the first one for which condition fails.
object DroppedWhile<T> does Iterating<T> {
    has origin is Iterating<T>;
    has condition is (T) is bool;

    // origin after condition stops holding.
    DroppedWhile(:origin, :condition);

    // Walks the items.
    cursor() is Cursor<T> {
        DroppedWhileCursorSearch(origin: origin.cursor(), condition: condition).cursor();
    }
}

hidden object DroppedWhileCursorSearch<T> {
    has origin is Cursor<T>;
    has condition is (T) is bool;

    DroppedWhileCursorSearch(:origin, :condition);

    cursor() is Cursor<T> {
        if !origin.available() {
            origin;
        }
        else {
            for CursorSteps(cursor: origin) -> step {
                last step.current() if !condition(step.item());
                step.following();
            }
        }
    }
}

// The items of origin in arrays of size, the last one maybe shorter.
object Chunked<T> does Iterating<@T> {
    has origin is Iterating<T>;
    has amount is int;

    // origin in chunks of size; size must be positive.
    Chunked(origin is Iterating<T>, size is int) {
        confirm size > 0 else throw InvalidArgument.because("chunk size must be positive");
        self.origin = origin;
        amount = size;
    }

    // Walks the items.
    cursor() is Cursor<@T> {
        ChunkedCursor(origin: origin.cursor(), size: amount);
    }
}

hidden object ChunkedCursor<T> does Cursor<@T> {
    has origin is Cursor<T>;
    has amount is int;

    ChunkedCursor(origin is Cursor<T>, size is int) {
        confirm size > 0 else throw InvalidArgument.because("chunk size must be positive");
        self.origin = origin;
        amount = size;
    }

    available() is bool {
        origin.available();
    }

    item() is @T {
        confirm self.available() else throw IterationEnded.ended;
        Taken(origin: CursorItems(cursor: origin), count: amount).map() -> value {
            value;
        };
    }

    successor() is Cursor<@T> {
        confirm self.available() else throw IterationEnded.ended;
        ChunkedCursor(
            origin: Dropped(
                origin: CursorItems(cursor: origin),
                count: amount,
            ).cursor(),
            size: amount,
        );
    }
}

// The items of each inner collection of origin, one level down.
object Flattened<T> does Iterating<T> {
    has origin is Iterating<Iterating<T>>;

    // origin flattened by one level.
    Flattened(:origin);

    // Walks the items.
    cursor() is Cursor<T> {
        Chained(origins: origin).cursor();
    }
}

// Each item of origin with the next: (a, b), (b, c), …
object Pairwise<T> does Iterating<Pair<T, T>> {
    has origin is Iterating<T>;

    // Adjacent pairs of origin.
    Pairwise(:origin);

    // Walks the items.
    cursor() is Cursor<Pair<T, T>> {
        PairwiseCursor(origin: origin.cursor());
    }
}

hidden object PairwiseCursor<T> does Cursor<Pair<T, T>> {
    has origin is Cursor<T>;

    PairwiseCursor(:origin);

    available() is bool {
        origin.available() && origin.successor().available();
    }

    item() is Pair<T, T> {
        confirm self.available() else throw IterationEnded.ended;
        let following = origin.successor();
        Pair(first: origin.item(), second: following.item());
    }

    successor() is Cursor<Pair<T, T>> {
        confirm self.available() else throw IterationEnded.ended;
        PairwiseCursor(origin: origin.successor());
    }
}

// Running results: initial, then action applied to each item and the result so
// far.
object Accumulated<T, R> does Iterating<R> {
    has origin is Iterating<T>;
    has initial is R;
    has action is (R, T) is R;

    // Running results of action over origin, starting with initial.
    Accumulated(:origin, :initial, :action);

    // Walks the items.
    cursor() is Cursor<R> {
        AccumulatedCursor(
            origin: origin.cursor(),
            current: initial,
            action: action,
        );
    }
}

hidden object AccumulatedCursor<T, R> does Cursor<R> {
    has origin is Cursor<T>;
    has current is R;
    has action is (R, T) is R;

    AccumulatedCursor(:origin, :current, :action);

    available() is bool {
        true;
    }

    item() is R {
        current;
    }

    successor() is Cursor<R> {
        if origin.available() {
            AccumulatedCursor(
                origin: origin.successor(),
                current: action(current, origin.item()),
                action: action,
            );
        }
        else {
            ExhaustedAccumulatedCursor(value: current);
        }
    }
}

hidden object ExhaustedAccumulatedCursor<R> does Cursor<R> {
    has origin is R;

    ExhaustedAccumulatedCursor(value is R) {
        origin = value;
    }

    available() is bool {
        false;
    }

    item() is R {
        throw IterationEnded.ended;
    }

    successor() is Cursor<R> {
        throw IterationEnded.ended;
    }
}

// The final result of action over every item of origin.
object Reduced<T, R> {
    has origin is Iterating<T>;
    has initial is R;
    has action is (R, T) is R;

    // action over origin, starting with initial.
    Reduced(:origin, :initial, :action);

    // The result after the last item.
    total() is R {
        origin.reduce(initial) -> total, item {
            action(total, item);
        };
    }
}

// The items of a sequence from last to first.
object Reversed<T> does Sequencing<T>, Iterating<T>, Sizing {
    has origin is Sequencing<T>;

    // origin reversed.
    Reversed(:origin);

    // Walks the items.
    cursor() is Cursor<T> {
        ReversedCursor(origin: origin, position: origin.size() - 1);
    }

    // How many items.
    size() is int {
        origin.size();
    }

    // The item at index from the end.
    item(index is int) is T {
        confirm index >= 0 && index < self.size()
            else throw OutOfRange.because("reverse index is outside the sequence");
        origin.item(self.size() - 1 - index);
    }

    // origin's last item.
    first() is T {
        confirm self.size() > 0 else throw EmptySequence.empty;
        origin.last();
    }

    // origin's first item.
    last() is T {
        confirm self.size() > 0 else throw EmptySequence.empty;
        origin.first();
    }
}

hidden object ReversedCursor<T> does Cursor<T> {
    has origin is Sequencing<T>;
    has position is int;

    ReversedCursor(origin is Sequencing<T>, position is int) {
        confirm position >= -1 && position < origin.size()
            else throw InvalidArgument.because("reverse cursor position is invalid");
        self.origin = origin;
        self.position = position;
    }

    available() is bool {
        position >= 0;
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        origin.item(position);
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        ReversedCursor(origin: origin, position: position - 1);
    }
}

// Every step-th item of origin from start up to, not including, stop.
object Sliced<T> does Iterating<T> {
    has origin is Iterating<T>;
    has start is int;
    has stop is int;
    has step is int;

    // Items start, start + step, … before stop; step must be positive.
    Sliced(origin is Iterating<T>, start is int, stop is int, step is int) {
        confirm start >= 0 else throw InvalidArgument.because("slice start cannot be negative");
        confirm stop >= 0 else throw InvalidArgument.because("slice stop cannot be negative");
        confirm step > 0 else throw InvalidArgument.because("slice step must be positive");
        self.origin = origin;
        self.start = start;
        self.stop = stop;
        self.step = step;
    }

    // Walks the items.
    cursor() is Cursor<T> {
        SlicedCursor(
            origin: Dropped(origin: origin, count: start).cursor(),
            position: start,
            stop: stop,
            step: step,
        );
    }
}

hidden object SlicedCursor<T> does Cursor<T> {
    has origin is Cursor<T>;
    has position is int;
    has stop is int;
    has step is int;

    SlicedCursor(origin is Cursor<T>, position is int, stop is int, step is int) {
        confirm position >= 0
            else throw InvalidArgument.because("slice cursor position cannot be negative");
        confirm stop >= 0 else throw InvalidArgument.because("slice stop cannot be negative");
        confirm step > 0 else throw InvalidArgument.because("slice step must be positive");
        self.origin = origin;
        self.position = position;
        self.stop = stop;
        self.step = step;
    }

    available() is bool {
        position < stop && origin.available();
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        origin.item();
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        let distance = stop - position;
        SlicedCursor(
            origin: Dropped(
                origin: CursorItems(cursor: origin),
                count: step,
            ).cursor(),
            position: if step >= distance {
                stop;
            }
            else {
                position + step;
            },
            stop: stop,
            step: step,
        );
    }
}

test "lazy views map, filter, take and drop" {
    let numbers = [1, 2, 3, 4, 5, 6];
    let text = (items is Iterating<int>) is string {
        items.map() -> item {
            item.string();
        }.join(",");
    };
    let square is (int) is int = (value is int) is int { value * value; };
    let even is (int) is bool = (value is int) is bool { value % 2 == 0; };
    let small is (int) is bool = (value is int) is bool { value < 3; };
    test.is(text(Mapped(origin: numbers, mapping: square)), "1,4,9,16,25,36");
    test.is(text(Filtered(origin: numbers, condition: even)), "2,4,6");
    test.is(text(Taken(origin: numbers, count: 2)), "1,2");
    test.is(text(Taken(origin: numbers, count: 0)), "");
    test.is(text(Dropped(origin: numbers, count: 4)), "5,6");
    test.is(text(Dropped(origin: numbers, count: 9)), "");
    test.is(text(TakenWhile(origin: numbers, condition: small)), "1,2");
    test.is(text(DroppedWhile(origin: numbers, condition: small)), "3,4,5,6");
    test.is(text(Taken(origin: Filtered(origin: numbers, condition: even), count: 2)), "2,4");
    test.is(text(Filtered(origin: numbers, condition: (value is int) is bool { value > 9; })), "");
}

test "chunks, pairs, running and final folds" {
    let numbers = [1, 2, 3, 4, 5];
    test.is(Chunked(origin: numbers, size: 2).map() -> chunk {
        chunk.map() -> item {
            item.string();
        }.join("");
    }.join(","), "12,34,5");
    test.is(Pairwise(origin: numbers).map() -> pair {
        (pair.first() * 10 + pair.second()).string();
    }.join(","), "12,23,34,45");
    let plus is (int, int) is int = (total is int, item is int) is int { total + item; };
    test.is(Accumulated(origin: numbers, initial: 0, action: plus).map() -> total {
        total.string();
    }.join(","), "0,1,3,6,10,15");
    test.is(Reduced(origin: numbers, initial: 0, action: plus).total(), 15);
    let nothing is @int = [];
    test.is(Reduced(origin: nothing, initial: 7, action: plus).total(), 7);
}

test "reversed, sliced and flattened views" {
    let letters = ["a", "b", "c", "d", "e", "f", "g"];
    let backwards = Reversed(origin: letters);
    test.is(backwards.size(), 7);
    test.is(backwards.first(), "g");
    test.is(backwards.last(), "a");
    test.is(backwards.item(1), "f");
    test.is(backwards.map() -> letter {
        letter;
    }.join(""), "gfedcba");
    test.is(Sliced(origin: letters, start: 1, stop: 6, step: 2).map() -> letter {
        letter;
    }.join(""), "bdf");
    test.is(Sliced(origin: letters, start: 5, stop: 100, step: 1).map() -> letter {
        letter;
    }.join(""), "fg");
    test.is(
        try {
            Sliced(origin: letters, start: 0, stop: 3, step: 0);
            "accepted";
        }
        catch error is InvalidArgument {
            "refused";
        },
        "refused"
    );
    let parts is @Iterating<string> = [Reversed(origin: ["b", "a"]), Reversed(origin: ["c"])];
    test.is(Flattened(origin: parts).map() -> letter {
        letter;
    }.join(""), "abc");
}

test "cursor steps expose each position and the one after it" {
    let steps = CursorSteps(cursor: ["x", "y"].cursor());
    test.is(steps.map() -> step {
        step.item() + if step.following().available() {
            step.following().item();
        }
        else {
            ".";
        };
    }.join(","), "xy,y.");
}
