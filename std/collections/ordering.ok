module collections/ordering v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "collections/sequence" take Sequencing, EmptySequence;
import "compare" take Comparing, Order;
import "error" take InvalidArgument, OutOfRange;
import "runtime/ordering" take BulkOrdering;
import "size" take Sizing;

// Stable ordered sequences and binary-search projections.
//
// Sorted materializes an Iterating source and orders it by the value's own
// Comparing<T> implementation:
//
//     let empty is List<int> = EmptyList();
//     let numbers = Sorted(origin: empty.prefix(2).prefix(1).prefix(3));
//     numbers.first();               // 1
//     numbers.last();                // 3
//     numbers.item(1);               // 2
//
// SortedBy applies a key once per input value, decorates the value with
// Ranked, and routes the complete decorated array through the same host bulk
// sort. Equal keys retain their input order:
//
//     let by_priority = SortedBy(
//         origin: jobs,
//         key: (job is Job) is int { job.priority(); },
//     );
//
// The anonymous action's declared result (`is int`) supplies K (#214); a
// named bound action with an exact (T) is K type does the same.
//
// Ranked is also useful directly when a domain ordering must differ from a
// value's intrinsic ordering. Its order() delegates only to key.order().
//
// LowerBound and UpperBound return insertion positions in O(log n).
// PositionOf returns the first matching position and throws MissingItem when
// the value is absent:
//
//     let first_two = LowerBound(origin: numbers, item: 2).index();
//     let after_twos = UpperBound(origin: numbers, item: 2).index();
//     let exact = PositionOf(origin: numbers, item: 2).index();
//
// Binary-search objects require an ascending Sequencing value produced under
// the same Comparing policy. They deliberately do not spend O(n) validating
// that precondition on every O(log n) query.

object Sorted<T: Comparing<T>> does Sequencing<T>, Iterating<T>, Sizing {
    has origin is @T;

    Sorted(origin is Iterating<T>) {
        let materialized is @T = origin.map() -> value {
            value;
        };
        let ordered is BulkOrdering<T> = BulkOrdering(values: materialized);
        self.origin = ordered.items();
    }

    cursor() is Cursor<T> {
        OrderedCursor(values: origin, position: 0);
    }

    size() is int {
        origin.size();
    }

    item(index is int) is T {
        confirm index >= 0 && index < self.size()
            else throw OutOfRange.because("ordered index is outside the sequence");
        origin[index];
    }

    first() is T {
        confirm self.size() > 0 else throw EmptySequence.empty;
        origin[0];
    }

    last() is T {
        confirm self.size() > 0 else throw EmptySequence.empty;
        origin[self.size() - 1];
    }
}

object SortedBy<T, K: Comparing<K>> does Sequencing<T>, Iterating<T>, Sizing {
    has origin is @Ranked<T, K>;

    SortedBy(origin is Iterating<T>, key is (T) is K) {
        let ranked is @Ranked<T, K> = origin.map() -> value {
            Ranked(item: value, key: key(value));
        };
        let ordered is BulkOrdering<Ranked<T, K>> = BulkOrdering(values: ranked);
        self.origin = ordered.items();
    }

    cursor() is Cursor<T> {
        RankedCursor(values: origin, position: 0);
    }

    size() is int {
        origin.size();
    }

    item(index is int) is T {
        confirm index >= 0 && index < self.size()
            else throw OutOfRange.because("ordered index is outside the sequence");
        origin[index].item();
    }

    first() is T {
        confirm self.size() > 0 else throw EmptySequence.empty;
        origin[0].item();
    }

    last() is T {
        confirm self.size() > 0 else throw EmptySequence.empty;
        origin[self.size() - 1].item();
    }
}

object Ranked<T, K: Comparing<K>> does Comparing<Ranked<T, K>> {
    has origin is T;
    has ranking is K;

    Ranked(item is T, key is K) {
        origin = item;
        ranking = key;
    }

    item() is T {
        origin;
    }

    key() is K {
        ranking;
    }

    order(other is Ranked<T, K>) is Order {
        ranking.order(other.key());
    }
}

// The index of an item in a sorted sequence; MissingItem when it is absent.
object PositionOf<T: Comparing<T>> {
    has origin is Sequencing<T>;
    has sought is T;

    PositionOf(origin is Sequencing<T>, item is T) {
        self.origin = origin;
        sought = item;
    }

    index() is int {
        let position = LowerBound(origin: origin, item: sought).index();
        confirm position < origin.size()
            && origin.item(position).order(sought) == Order.equal
            else throw MissingItem.missing;
        position;
    }
}

// The first index in a sorted sequence whose item is not less than `item`.
object LowerBound<T: Comparing<T>> {
    has origin is Sequencing<T>;
    has sought is T;

    LowerBound(origin is Sequencing<T>, item is T) {
        self.origin = origin;
        sought = item;
    }

    index() is int {
        self.search(0, origin.size());
    }

    hidden search(start is int, stop is int) is int {
        if start >= stop {
            start;
        }
        else {
            let middle = start + ((stop - start) / 2).int();
            if origin.item(middle).order(sought) == Order.less {
                self.search(middle + 1, stop);
            }
            else {
                self.search(start, middle);
            }
        }
    }
}

// The first index in a sorted sequence whose item is greater than `item`.
object UpperBound<T: Comparing<T>> {
    has origin is Sequencing<T>;
    has sought is T;

    UpperBound(origin is Sequencing<T>, item is T) {
        self.origin = origin;
        sought = item;
    }

    index() is int {
        self.search(0, origin.size());
    }

    hidden search(start is int, stop is int) is int {
        if start >= stop {
            start;
        }
        else {
            let middle = start + ((stop - start) / 2).int();
            if origin.item(middle).order(sought) == Order.greater {
                self.search(start, middle);
            }
            else {
                self.search(middle + 1, stop);
            }
        }
    }
}

object OrderedCursor<T> does Cursor<T> {
    has origin is @T;
    has position is int;

    OrderedCursor(values is @T, position is int) {
        confirm position >= 0 && position <= values.size()
            else throw InvalidArgument.because("ordered cursor position is invalid");
        origin = values;
        self.position = position;
    }

    available() is bool {
        position < origin.size();
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        origin[position];
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        OrderedCursor(values: origin, position: position + 1);
    }
}

object RankedCursor<T, K: Comparing<K>> does Cursor<T> {
    has origin is @Ranked<T, K>;
    has position is int;

    RankedCursor(values is @Ranked<T, K>, position is int) {
        confirm position >= 0 && position <= values.size()
            else throw InvalidArgument.because("ranked cursor position is invalid");
        origin = values;
        self.position = position;
    }

    available() is bool {
        position < origin.size();
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        origin[position].item();
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        RankedCursor(values: origin, position: position + 1);
    }
}

enum MissingItem is Error = (missing);
