module collections/list v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "size" take Sizing;

// An immutable persistent linked list.
//
// Build a list by prefixing values onto an explicitly typed empty list:
//
//     let empty is List<string> = EmptyList();
//     let names = empty
//         .prefix("Lovelace")
//         .prefix("Hopper");
//
//     // names.first() == "Hopper"
//     // names.tail().first() == "Lovelace"
//     // empty.size() == 0
//
// prefix() never changes the receiver. The new list shares its immutable tail
// with the old list, so retaining earlier versions is cheap and safe:
//
//     let one = empty.prefix("one");
//     let two = one.prefix("two");
//     // one still contains only "one"
//     // two contains "two", then "one"
//
// Lists participate in ordinary iteration:
//
//     for names -> name {
//         Stdout().writeln(name);
//     }
//
// A list is deliberately not a Sequencing object and has no item(index)
// action. Finding the nth linked node requires traversal; use cursor(), for,
// or a genuinely indexed collection instead of disguising that cost.
//
// first() and tail() on EmptyList throw EmptyListAccess. Calling item() or
// successor() on an exhausted cursor throws IterationEnded. List cursors are
// immutable: successor() returns a cursor for the shared tail and leaves the
// previous cursor unchanged.

// List is conceptually the conjunction of Iterating<T> and Sizing. Until the
// language supports role composition, the shared signatures are stated here
// and concrete lists explicitly implement all three roles.
role List<T> {
    // Walks from the first item.
    cursor() is Cursor<T>;
    // How many items; counting walks the list.
    size() is int;
    // The first item; EmptyListAccess when empty.
    first() is T;
    // The list after its first item; EmptyListAccess when empty.
    tail() is List<T>;
    // This list with value in front; the old list is shared, not copied.
    prefix(value is T) is List<T>;
}

// The list with no items; type it to start one: `let empty is List<string> =
// EmptyList();`.
object EmptyList<T> does List<T>, Iterating<T>, Sizing {
    // An empty list.
    EmptyList();

    // A cursor at the end.
    cursor() is Cursor<T> {
        EmptyListCursor(origin: self);
    }

    // 0.
    size() is int {
        0;
    }

    // EmptyListAccess: an empty list has no first item.
    first() is T {
        throw EmptyListAccess.operation("first");
    }

    // EmptyListAccess: an empty list has no tail.
    tail() is List<T> {
        throw EmptyListAccess.operation("tail");
    }

    // The list of value alone.
    prefix(value is T) is List<T> {
        LinkedList(value: value, following: self, size: 1);
    }
}

hidden object LinkedList<T> does List<T>, Iterating<T>, Sizing {
    has origin is T;
    has following is List<T>;
    has amount is int;

    LinkedList(value is T, following is List<T>, size is int) {
        origin = value;
        self.following = following;
        amount = size;
    }

    cursor() is Cursor<T> {
        LinkedListCursor(value: origin, following: following);
    }

    size() is int {
        amount;
    }

    first() is T {
        origin;
    }

    tail() is List<T> {
        following;
    }

    prefix(value is T) is List<T> {
        LinkedList(value: value, following: self, size: amount + 1);
    }
}

hidden object EmptyListCursor<T> does Cursor<T> {
    has origin is List<T>;

    EmptyListCursor(:origin);

    available() is bool {
        false;
    }

    item() is T {
        throw IterationEnded.ended;
    }

    successor() is Cursor<T> {
        throw IterationEnded.ended;
    }
}

hidden object LinkedListCursor<T> does Cursor<T> {
    has origin is T;
    has following is List<T>;

    LinkedListCursor(value is T, following is List<T>) {
        origin = value;
        self.following = following;
    }

    available() is bool {
        true;
    }

    item() is T {
        origin;
    }

    successor() is Cursor<T> {
        following.cursor();
    }
}

// first() or tail() on an empty list; operation names the call.
enum EmptyListAccess is Error = (operation(operation is string));

test "a list is built by prefixing and shares its tail" {
    let empty is List<string> = EmptyList();
    let one = empty.prefix("one");
    let two = one.prefix("two");
    test.is(empty.size(), 0);
    test.is(one.size(), 1);
    test.is(two.size(), 2);
    test.is(two.first(), "two");
    test.is(two.tail().first(), "one");
    test.is(one.first(), "one");
    test.is(two.map() -> name {
        name;
    }.join(","), "two,one");
    test.is(LinkedList(value: "x", following: empty, size: 1).first(), "x");
    test.is(
        try {
            empty.first();
        }
        catch EmptyListAccess.operation(operation) {
            operation;
        },
        "first"
    );
    test.is(
        try {
            empty.tail().size().string();
        }
        catch EmptyListAccess.operation(operation) {
            operation;
        },
        "tail"
    );
}
