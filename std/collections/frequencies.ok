module collections/frequencies v1.0.0;

import "collections/iteration" take Cursor, CursorItems, Iterating;
import "collections/list" take List, EmptyList;
import "error" take InvalidArgument;
import "size" take Sizing;

// Immutable frequency counts in first-occurrence order.
//
// Frequencies consumes any Iterating value once and stores one Frequency for
// every distinct item:
//
//     let empty is List<string> = EmptyList();
//     let words = empty
//         .prefix("blue")
//         .prefix("red")
//         .prefix("blue");
//     let counts = Frequencies(values: words);
//
//     counts.size();                 // 2 distinct strings
//     counts.total();                // 3 input strings
//     counts.amount("blue");        // 2
//     counts.amount("missing");     // 0
//
// Traversal emits Frequency objects in the order in which their items first
// appeared. In the example it emits blue:2, then red:1:
//
//     for counts -> frequency {
//         Stdout().writeln(
//             frequency.item() + ":" + frequency.amount().string()
//         );
//     }
//
// Frequency is a value: its positive amount is calculated during Frequencies
// construction and does not rescan the original input.
//
// Frequencies takes any T with runtime equality, arrays included, so it uses
// strict runtime equality and linear lookup, just like OrderedSet, instead of
// pretending to be a hash table. Construction reads the input once and makes
// O(n*d) equality comparisons, where d is the number of distinct values,
// without rebuilding intermediate lists; amount(value) is O(d). For map keys —
// scalars, enums, value objects (#212) — KeyedFrequencies counts in a map in
// O(n log d) and traverses in key order; the compiler checks that its T is a
// key type (#242). Native opaque handles have no equality.

// How many times one item occurred.
object Frequency<T> {
    has origin is T;
    has quantity is int;

    // item counted amount times.
    Frequency(item is T, amount is int) {
        confirm amount > 0
            else throw InvalidArgument.because("frequency amount must be positive");
        origin = item;
        quantity = amount;
    }

    // The item.
    item() is T {
        origin;
    }

    // How many times it occurred, at least once.
    amount() is int {
        quantity;
    }
}

// How often each distinct item occurs, in the order items first appear.
object Frequencies<T> does Iterating<Frequency<T>>, Sizing {
    has values is Iterating<T>;

    // Counts values once, now.
    Frequencies(values is Iterating<T>) {
        self.values = values;
    }

    // Walks the counts.
    cursor() is Cursor<Frequency<T>> {
        self.counted().cursor();
    }

    // How many distinct items.
    size() is int {
        self.counted().size();
    }

    // How many times value occurred; 0 when never.
    amount(value is T) is int {
        let cursor = self.counted().cursor();
        if !cursor.available() {
            0;
        }
        else {
            for CursorItems(cursor: cursor) -> frequency {
                last frequency.amount() if frequency.item() == value;
                0;
            }
        }
    }

    // How many items were counted.
    total() is int {
        once let quantity = FrequencyTally(values: values).total();
        quantity;
    }

    // One Frequency per distinct value, counted on the first question (#491).
    hidden counted() is List<Frequency<T>> {
        once let kept = FrequencyTally(values: values).frequencies();
        kept;
    }
}

// Frequency counts of map keys in key order (#242): construction is
// O(n log d) and amount(value) is O(log d).
//
//     let counts = KeyedFrequencies(values: ["red", "blue", "red"]);
//     counts.amount("red");          // 2; traversal: blue:1, red:2
object KeyedFrequencies<T> does Iterating<Frequency<T>>, Sizing {
    has values is Iterating<T>;

    // Counts values once, now, by map key.
    KeyedFrequencies(values is Iterating<T>) {
        self.values = values;
    }

    // Walks the counts.
    cursor() is Cursor<Frequency<T>> {
        let counts = self.counts();
        let frequencies = counts.keys().map() -> key {
            Frequency(item: key, amount: counts[key]);
        };
        frequencies.cursor();
    }

    // How many distinct items.
    size() is int {
        self.counts().size();
    }

    // How many times value occurred; 0 when never.
    amount(value is T) is int {
        self.counts()[value] else 0;
    }

    // How many items were counted.
    total() is int {
        once let quantity = values.map() -> value {
            value;
        }.size();
        quantity;
    }

    // Each distinct value with its count, in key order (#491).
    hidden counts() is %T:int {
        once let kept is %T:int = values.reduce([:]) -> found, value {
            let seen = found[value] else 0;
            found + [value: seen + 1];
        };
        kept;
    }
}

// One pass over the input: distinct values in first-occurrence order, then
// one counting scan per distinct value. No intermediate list is rebuilt.
hidden object FrequencyTally<T> {
    has items is @T;

    FrequencyTally(values is Iterating<T>) {
        items = values.map() -> value {
            value;
        };
    }

    frequencies() is List<Frequency<T>> {
        let unseen is @T = [];
        let distinct is @T = items.reduce(unseen) -> found, value {
            if self.listed(found, value) {
                found;
            }
            else {
                found + [value];
            }
        };
        let empty is List<Frequency<T>> = EmptyList();
        // Prefixing in reverse keeps the first occurrence first.
        (0..distinct.size()).reduce(empty) -> frequencies, offset {
            let item is T = distinct[distinct.size() - 1 - offset];
            let amount is int = items.reduce(0) -> count, value {
                if value == item {
                    count + 1;
                }
                else {
                    count;
                }
            };
            frequencies.prefix(Frequency(item: item, amount: amount));
        };
    }

    total() is int {
        items.size();
    }

    hidden listed(found is @T, value is T) is bool {
        // `for` over an empty array produces no value.
        if found.size() == 0 {
            false;
        }
        else {
            for found -> known {
                last true if known == value;
                false;
            }
        }
    }
}

hidden object FrequencyBuilding<T> {
    has origin is List<Frequency<T>>;
    has quantity is int;

    FrequencyBuilding(frequencies is List<Frequency<T>>, total is int) {
        confirm total >= 0
            else throw InvalidArgument.because("frequency total cannot be negative");
        origin = frequencies;
        quantity = total;
    }

    frequencies() is List<Frequency<T>> {
        origin;
    }

    total() is int {
        quantity;
    }

    addition(value is T) is FrequencyBuilding<T> {
        let empty is List<Frequency<T>> = EmptyList();
        let revised = origin.reduce(FrequencyRevision(
            frequencies: empty,
            value: value,
            present: false,
        )) -> revision, frequency {
            revision.addition(frequency);
        };
        let reversed is List<Frequency<T>> = if revised.membership() {
            revised.frequencies();
        }
        else {
            revised.frequencies().prefix(Frequency(item: value, amount: 1));
        };
        let ordered is List<Frequency<T>> = reversed.reduce(EmptyList()) -> frequencies, frequency {
            frequencies.prefix(frequency);
        };
        FrequencyBuilding(frequencies: ordered, total: quantity + 1);
    }
}

hidden object FrequencyRevision<T> {
    has origin is List<Frequency<T>>;
    has sought is T;
    has present is bool;

    FrequencyRevision(
        frequencies is List<Frequency<T>>,
        value is T,
        present is bool,
    ) {
        origin = frequencies;
        sought = value;
        self.present = present;
    }

    frequencies() is List<Frequency<T>> {
        origin;
    }

    membership() is bool {
        present;
    }

    addition(frequency is Frequency<T>) is FrequencyRevision<T> {
        if frequency.item() == sought {
            FrequencyRevision(
                frequencies: origin.prefix(Frequency(
                    item: frequency.item(),
                    amount: frequency.amount() + 1,
                )),
                value: sought,
                present: true,
            );
        }
        else {
            FrequencyRevision(
                frequencies: origin.prefix(frequency),
                value: sought,
                present: present,
            );
        }
    }
}

test "counts in first-occurrence order" {
    let counts = Frequencies(values: ["blue", "red", "blue", "green", "blue", "red"]);
    test.is(counts.size(), 3);
    test.is(counts.total(), 6);
    test.is(counts.amount("blue"), 3);
    test.is(counts.amount("red"), 2);
    test.is(counts.amount("green"), 1);
    test.is(counts.amount("missing"), 0);
    let order = counts.map() -> frequency {
        frequency.item() + ":" + frequency.amount().string();
    };
    test.is(order, ["blue:3", "red:2", "green:1"]);
}

test "empty input" {
    let nothing is @int = [];
    let counts = Frequencies(values: nothing);
    test.is(counts.size(), 0);
    test.is(counts.total(), 0);
    test.is(counts.amount(7), 0);
}

test "keyed counts in key order" {
    let counts = KeyedFrequencies(values: ["blue", "red", "blue", "green", "blue", "red"]);
    test.is(counts.size(), 3);
    test.is(counts.total(), 6);
    test.is(counts.amount("blue"), 3);
    test.is(counts.amount("red"), 2);
    test.is(counts.amount("missing"), 0);
    let order = counts.map() -> frequency {
        frequency.item() + ":" + frequency.amount().string();
    };
    test.is(order, ["blue:3", "green:1", "red:2"]);
    let nothing is @int = [];
    test.is(KeyedFrequencies(values: nothing).size(), 0);
}
