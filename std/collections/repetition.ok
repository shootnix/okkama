module collections/repetition v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "collections/sequence" take Sequencing, EmptySequence;
import "error" take InvalidArgument, OutOfRange;
import "size" take Sizing;

// Repeats values lazily or as a finite sequence.
//
// Repeating is infinite. Its cursor is always available, so consumers must
// impose their own stopping condition:
//
//     for Repeating(value: "tick") -> value {
//         output.writeln(value);
//         last if clock.expired();
//     }
//
// Repeated is finite, indexed and sized:
//
//     let padding = Repeated(value: " ", count: 4);
//     // padding.size() == 4
//     // padding.item(2) == " "
//
// A negative count throws InvalidArgument. item() uses strict zero-based
// bounds and throws OutOfRange. first() and last() throw EmptySequence when
// count is zero.
//
// Cycled repeatedly traverses a finite Sequencing value:
//
//     let turns = Cycled(origin: players);
//     for turns -> player {
//         player.move();
//         last if game.finished();
//     }
//
// Cycling an empty sequence is finite and immediately exhausted. Cycling a
// non-empty sequence is infinite. Every cursor is immutable.

// One value over and over, without end; take some with Taken.
object Repeating<T> does Iterating<T> {
    has origin is T;

    // Repeats value forever.
    Repeating(value is T) {
        origin = value;
    }

    // Walks the items.
    cursor() is Cursor<T> {
        RepeatingCursor(value: origin);
    }
}

hidden object RepeatingCursor<T> does Cursor<T> {
    has origin is T;

    RepeatingCursor(value is T) {
        origin = value;
    }

    available() is bool {
        true;
    }

    item() is T {
        origin;
    }

    successor() is Cursor<T> {
        self;
    }
}

// One value count times.
object Repeated<T> does Sequencing<T>, Iterating<T>, Sizing {
    has origin is T;
    has amount is int;

    // value count times; count must not be negative.
    Repeated(value is T, count is int) {
        confirm count >= 0
            else throw InvalidArgument.because("repeat count cannot be negative");
        origin = value;
        amount = count;
    }

    // Walks the items.
    cursor() is Cursor<T> {
        RepeatedCursor(value: origin, position: 0, count: amount);
    }

    // count.
    size() is int {
        amount;
    }

    // The value, for any index below count.
    item(index is int) is T {
        confirm index >= 0 && index < amount
            else throw OutOfRange.because("repeat index is outside the sequence");
        origin;
    }

    // The value; EmptySequence when count is 0.
    first() is T {
        confirm amount > 0 else throw EmptySequence.empty;
        origin;
    }

    // The value; EmptySequence when count is 0.
    last() is T {
        confirm amount > 0 else throw EmptySequence.empty;
        origin;
    }
}

hidden object RepeatedCursor<T> does Cursor<T> {
    has origin is T;
    has position is int;
    has amount is int;

    RepeatedCursor(value is T, position is int, count is int) {
        confirm count >= 0
            else throw InvalidArgument.because("repeat count cannot be negative");
        confirm position >= 0 && position <= count
            else throw InvalidArgument.because("repeat cursor position is invalid");
        origin = value;
        self.position = position;
        amount = count;
    }

    available() is bool {
        position < amount;
    }

    item() is T {
        confirm self.available() else throw IterationEnded.ended;
        origin;
    }

    successor() is Cursor<T> {
        confirm self.available() else throw IterationEnded.ended;
        RepeatedCursor(
            value: origin,
            position: position + 1,
            count: amount,
        );
    }
}

// The items of origin over and over, without end.
object Cycled<T> does Iterating<T> {
    has origin is Sequencing<T>;

    // Cycles origin.
    Cycled(:origin);

    // Walks the items.
    cursor() is Cursor<T> {
        if origin.size() == 0 {
            EmptyCycleCursor(origin: origin);
        }
        else {
            CycledCursor(origin: origin, position: 0);
        }
    }
}

hidden object CycledCursor<T> does Cursor<T> {
    has origin is Sequencing<T>;
    has position is int;

    CycledCursor(origin is Sequencing<T>, position is int) {
        confirm origin.size() > 0
            else throw InvalidArgument.because("cannot create an active cursor for an empty cycle");
        confirm position >= 0 && position < origin.size()
            else throw InvalidArgument.because("cycle cursor position is invalid");
        self.origin = origin;
        self.position = position;
    }

    available() is bool {
        true;
    }

    item() is T {
        origin.item(position);
    }

    successor() is Cursor<T> {
        CycledCursor(
            origin: origin,
            position: if position + 1 < origin.size() {
                position + 1;
            }
            else {
                0;
            },
        );
    }
}

hidden object EmptyCycleCursor<T> does Cursor<T> {
    has origin is Sequencing<T>;

    EmptyCycleCursor(origin is Sequencing<T>) {
        confirm origin.size() == 0
            else throw InvalidArgument.because(
                "cannot create an empty cursor for a non-empty cycle"
            );
        self.origin = origin;
    }

    available() is bool {
        false;
    }

    item() is T {
        throw IterationEnded.ended;
    }

    successor() is Cursor<T> {
        throw IterationEnded.ended;
    }
}

test "repeating is endless, repeated is finite, cycled goes round" {
    let step = (cursor is Cursor<string>, count is int) is Cursor<string> {
        (0..count).reduce(cursor) -> current, index {
            current.successor();
        };
    };
    test.is(step(Repeating(value: "tick").cursor(), 1000).item(), "tick");
    let padding = Repeated(value: " ", count: 4);
    test.is(padding.size(), 4);
    test.is(padding.item(2), " ");
    test.is(padding.map() -> value {
        "[" + value + "]";
    }.join(""), "[ ][ ][ ][ ]");
    test.is(
        try {
            Repeated(value: 1, count: 0).first();
        }
        catch error is EmptySequence {
            -1;
        },
        -1
    );
    test.is(
        try {
            Repeated(value: 1, count: -1).size();
        }
        catch error is InvalidArgument {
            -1;
        },
        -1
    );
    test.is(
        try {
            Repeated(value: 1, count: 2).item(2);
        }
        catch error is OutOfRange {
            -1;
        },
        -1
    );
    let turns = Cycled(origin: ["a", "b"]).cursor();
    test.is(step(turns, 4).item(), "a");
    test.is(step(turns, 5).item(), "b");
    let nothing is @string = [];
    test.ok(!Cycled(origin: nothing).cursor().available());
}
