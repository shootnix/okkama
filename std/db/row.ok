module db/row v1.0.0;

// Rows and columns, read by column name.
//
//     let note = await db.query("SELECT id, title, body, pinned FROM notes WHERE id = ?", DbInteger(7)).one();
//     note.int("id");
//     note.text("title");
//     note.maybe("body").text() else "(empty)";      // NULL is none
//     note.flag("pinned");                           // integer 0 or 1
//     note.presence("extra").text();                 // tells NULL from a missing column
//
// A reader throws RowValueFailure for a value of another kind or NULL,
// MissingColumn for an unknown name and AmbiguousColumn when two columns share
// it.

import "runtime/db" as native_db;
import "async/atomic" take Atomic;
import "db/value" take DbValue, DbValueKind, ObservedDbValue, DbNativeValue, DbNull, DbInteger,
    DbText, DbBytes, DbBoolean;
import "db/statement" take DbLimits, DbBoundaryLimit;
import "collections/sequence" take Sequencing;
import "encoding/utf" take Utf8Encoded;
import "db/read" take RowValues, DbColumnReader, DbMaybeReader, DbPresenceReader, DbPage;
import "numbers/bigint" take BigInt;
import "math/decimal" take Decimal;
import "db/read" take RowValueFailure;

// A column of a result: position, name and declared type.
object Column {
    has index is int;
    has name, declaration is string;

    // The column; InvalidRow for a negative index.
    Column(index is int, name is string, declaration is string) {
        confirm index >= 0
            && index < 1024
            && Utf8Encoded(name).bytes().size() <= 4096
            && Utf8Encoded(declaration).bytes().size() <= 4096
            else throw InvalidRow.invalid;
        self.index = index;
        self.name = name;
        self.declaration = declaration;
    }

    // Its index, name and declaration.
    cap Parts {
        index is int {
            index;
        }

        name is string {
            name;
        }

        declaration is string {
            declaration;
        }
    }
}

// Column is immutable and validates its own bounds; snapshot only the sequence.
object DbColumns {
    has origin is @Column;

    // values within limits.
    DbColumns(values is Sequencing<Column>, limits is DbLimits) {
        let count = values.size();
        confirm count >= 0 && count <= limits::Limits::values
            else throw DbBoundaryLimit.kind("column count");
        let columns is @Column = (0..count).map() -> index {
            let column = values.item(index);
            confirm column::Parts::index == index else throw InvalidRow.invalid;
            column;
        };
        origin = columns;
    }

    // The columns.
    values() is @Column {
        origin;
    }
}

// One validated immutable description shared by all rows of a result set.
object DbRowSchema {
    has columns is @Column;
    has state is native_db.DbSchemaState;

    // columns within limits.
    DbRowSchema(columns is Sequencing<Column>, limits is DbLimits) {
        self.columns = DbColumns(values: columns, limits: limits).values();
        let names is @string = self.columns.map() -> column {
            column::Parts::name;
        };
        state = native_db.db_schema(names);
    }

    // The columns.
    columns() is @Column {
        columns;
    }

    // How many.
    size() is int {
        columns.size();
    }

    // The index of name; -1 when none has it, -2 when several do.
    position(name is string) is int {
        native_db.db_position(state, name);
    }
}

hidden object DbRowCells {
    has values is @native_db.DbCellState;

    DbRowCells(origin is Sequencing<DbValue>, limits is DbLimits) {
        let count = origin.size();
        confirm count >= 0 && count <= limits::Limits::values
            else throw DbBoundaryLimit.kind("value count");
        let used = Atomic(0);
        let values is @native_db.DbCellState = (0..count).map() -> index {
            let value = ObservedDbValue(origin.item(index));
            let width = value.width();
            confirm width <= limits::Limits::bytes - used.value()
                else throw DbBoundaryLimit.kind("value bytes");
            used.replace(used.value() + width);
            value.state();
        };
        self.values = values;
    }

    values() is @native_db.DbCellState {
        values;
    }
}

// Validated native storage passed by built-in drivers: owned cells, or one row
// of a page whose width and byte limits the driver validated for the page.
object DbRowData {
    has schema is DbRowSchema;
    has cells is @native_db.DbCellState;
    has page is DbPage;
    has base is int;

    // A row of these cells.
    DbRowData(schema is DbRowSchema, cells is @native_db.DbCellState) {
        confirm schema.size() == cells.size() else throw InvalidRow.invalid;
        confirm native_db.db_cells_bytes(cells) <= DbLimits()::Limits::bytes
            else throw DbBoundaryLimit.kind("value bytes");
        self.schema = schema;
        self.cells = cells;
        page = DbPage();
        base = 0;
    }

    // Row row of page.
    DbRowData(schema is DbRowSchema, page is DbPage, row is int) {
        confirm schema.size() == page.width() && page.width() > 0 else throw InvalidRow.invalid;
        self.schema = schema;
        let empty is @native_db.DbCellState = [];
        cells = empty;
        self.page = page;
        base = row * page.width();
    }

    // The schema.
    schema() is DbRowSchema {
        schema;
    }

    // The cells.
    cells() is @native_db.DbCellState {
        cells;
    }

    // The page it lies in.
    page() is DbPage {
        page;
    }

    // Where it starts in the page.
    base() is int {
        base;
    }
}

// One row of a result.
object Row does RowValues {
    has schema is DbRowSchema;
    // Owned cells, or (width > 0) the row at `base` of a driver page.
    has values is @native_db.DbCellState;
    has page is DbPage;
    has base is int;

    // A row of values under columns.
    Row(columns is Sequencing<Column>, values is Sequencing<DbValue>) {
        confirm columns.size() == values.size() else throw InvalidRow.invalid;
        let limits = DbLimits();
        schema = DbRowSchema(columns: columns, limits: limits);
        self.values = DbRowCells(origin: values, limits: limits).values();
        page = DbPage();
        base = 0;
    }

    // The same within limits.
    Row(columns is Sequencing<Column>, values is Sequencing<DbValue>, limits is DbLimits) {
        confirm columns.size() == values.size() else throw InvalidRow.invalid;
        schema = DbRowSchema(columns: columns, limits: limits);
        self.values = DbRowCells(origin: values, limits: limits).values();
        page = DbPage();
        base = 0;
    }

    // The row data holds.
    Row(data is DbRowData) {
        schema = data.schema();
        values = data.cells();
        page = data.page();
        base = data.base();
    }

    // How many columns.
    size() is int {
        if page.width() > 0 {
            page.width();
        }
        else {
            values.size();
        }
    }

    // The columns.
    columns() is Sequencing<Column> {
        schema.columns();
    }

    // The value at index; InvalidRowIndex outside the row.
    item(index is int) is DbValue {
        confirm index >= 0 && index < self.size() else throw InvalidRowIndex.index(index);
        DbNativeValue(self.cell(index));
    }

    // The value of a column.
    value(name is string) is DbValue {
        DbNativeValue(self.cell(self.index(name)));
    }

    // An integer column as int.
    int(name is string) is int {
        let at = self.index(name);
        if page.width() > 0 {
            let i = base + at;
            if page.kind(i) == 2 {
                page.integer(i);
            }
            else {
                DbColumnReader(name: name, page: page, at: i).int();
            }
        }
        else {
            let cell = values[at];
            // Native validation checks both the integer kind and its range.
            if native_db.db_int_valid(cell) {
                native_db.db_int_value(cell);
            }
            else {
                DbColumnReader(name: name, state: cell).int();
            }
        }
    }

    // An integer column as BigInt.
    integer(name is string) is BigInt {
        self.reader(name).integer();
    }

    // A decimal column.
    decimal(name is string) is Decimal {
        self.reader(name).decimal();
    }

    // A float column.
    floating(name is string) is float {
        self.reader(name).floating();
    }

    // A boolean column.
    boolean(name is string) is bool {
        self.reader(name).boolean();
    }

    // An integer column of 0 or 1 as a bool.
    flag(name is string) is bool {
        self.reader(name).flag();
    }

    // A text column.
    text(name is string) is string {
        let at = self.index(name);
        if page.width() > 0 {
            let i = base + at;
            if page.kind(i) == 5 {
                page.text(i);
            }
            else {
                DbColumnReader(name: name, page: page, at: i).text();
            }
        }
        else {
            let cell = values[at];
            if native_db.db_kind(cell) == 5 {
                native_db.db_text_value(cell);
            }
            else {
                DbColumnReader(name: name, state: cell).text();
            }
        }
    }

    // A bytes column.
    bytes(name is string) is @byte {
        self.reader(name).bytes();
    }

    // A column that may be NULL: its readers give none for NULL.
    maybe(name is string) is DbMaybeReader {
        DbMaybeReader(self.selected(name, self.index(name)));
    }

    // A column that may be NULL or missing: its readers give Presence.
    presence(name is string) is DbPresenceReader {
        let at = schema.position(name);
        confirm at != -2 else throw AmbiguousColumn.name(name);
        if at == -1 {
            DbPresenceReader(Presence<DbColumnReader>.missing);
        }
        else {
            self.selected(name, at);
        }
    }

    hidden index(name is string) is int {
        let at = schema.position(name);
        confirm at != -1 else throw MissingColumn.name(name);
        confirm at != -2 else throw AmbiguousColumn.name(name);
        at;
    }

    hidden cell(at is int) is native_db.DbCellState {
        if page.width() > 0 {
            page.cell(base + at);
        }
        else {
            values[at];
        }
    }

    hidden reader(name is string) is DbColumnReader {
        let at = self.index(name);
        if page.width() > 0 {
            DbColumnReader(name: name, page: page, at: base + at);
        }
        else {
            DbColumnReader(name: name, state: values[at]);
        }
    }

    hidden selected(name is string, at is int) is DbPresenceReader {
        let found is Presence<DbColumnReader> = if page.width() > 0 {
            if page.kind(base + at) == 0 {
                Presence.none;
            }
            else {
                Presence.some(DbColumnReader(name: name, page: page, at: base + at));
            }
        }
        else {
            if native_db.db_kind(values[at]) == 0 {
                Presence.none;
            }
            else {
                Presence.some(DbColumnReader(name: name, state: values[at]));
            }
        };
        DbPresenceReader(found);
    }
}

// The answer of connection.query(sql, values): exactly one row, at most one
// row, or a bounded list. db/query's Query does it.
role DbQuery {
    // Exactly one row; NoRows or TooManyRows otherwise.
    async one() is Row;
    // At most one row.
    async maybe() is Maybe<Row>;
    // Every row, at most max_rows.
    async all(max_rows is int) is @Row;
}

// Rows read one at a time.
role RowReading {
    // The next row; RowsEnded at the end.
    async row() is Row;
    // The columns.
    columns() is Sequencing<Column>;
    // Whether it was closed.
    closed() is bool;
    // Stops reading.
    close() is void;
}

// No more rows.
enum RowsEnded is Error = (ended);

// No column has that name.
enum MissingColumn is Error = (name(name is string));

// Several columns have that name.
enum AmbiguousColumn is Error = (name(name is string));

// A row that cannot be built.
enum InvalidRow is Error = (invalid);

// A column index outside the row.
enum InvalidRowIndex is Error = (index(index is int));

test "a row reads its cells by name: strict, Maybe and Presence" {
    let columns = [
        Column(index: 0, name: "id", declaration: "INTEGER"),
        Column(index: 1, name: "name", declaration: "TEXT"),
        Column(index: 2, name: "nick", declaration: "TEXT"),
        Column(index: 3, name: "data", declaration: "BLOB"),
        Column(index: 4, name: "on", declaration: "BOOLEAN"),
    ];
    let row = Row(
        columns: columns,
        values: [DbInteger(7), DbText("Ada"), DbNull(), DbBytes([1.byte()]), DbBoolean(true)]
    );
    test.is(row.size(), 5);
    test.is(row.int("id"), 7);
    test.is(row.integer("id").string(), "7");
    test.is(row.text("name"), "Ada");
    test.is(row.bytes("data"), [1.byte()]);
    test.is(row.boolean("on"), true);
    test.throws(RowValueFailure) {
        row.flag("on");
    };
    test.throws(RowValueFailure) {
        row.flag("id");
    };
    test.is(
        Row(columns: [Column(index: 0, name: "f", declaration: "")], values: [DbInteger(1)]).flag(
            "f"
        ),
        true
    );
    test.is(row.item(1).kind() == DbValueKind.text, true);
    test.is(row.columns().first()::Parts::name, "id");
    test.is(row.columns().last()::Parts::declaration, "BOOLEAN");
    test.is(row.maybe("nick").text() == Maybe<string>.none, true);
    test.is(row.maybe("name").text() else "", "Ada");
    let absent = match row.presence("alias").text() {
        case Presence.missing {
            true;
        }
        else {
            false;
        }
    };
    test.is(absent, true);
    let empty = match row.presence("nick").text() {
        case Presence.none {
            true;
        }
        else {
            false;
        }
    };
    test.is(empty, true);
    test.throws(MissingColumn) {
        row.int("alias");
    };
    test.throws(RowValueFailure) {
        row.int("name");
    };
    test.throws(InvalidRowIndex) {
        row.item(9);
    };
}

test "a row refuses ambiguous names and mismatched widths" {
    let twice = Row(
        columns: [
            Column(index: 0, name: "id", declaration: ""),
            Column(index: 1, name: "id", declaration: "")
        ],
        values: [DbInteger(1), DbInteger(2)],
    );
    test.is(twice.item(1).kind() == DbValueKind.integer, true);
    test.throws(AmbiguousColumn) {
        twice.int("id");
    };
    test.throws(InvalidRow) {
        Row(
            columns: [Column(index: 0, name: "id", declaration: "")],
            values: [DbInteger(1), DbInteger(2)]
        );
    };
    let schema = DbRowSchema(
        columns: [
            Column(index: 0, name: "a", declaration: ""),
            Column(index: 1, name: "b", declaration: "")
        ],
        limits: DbLimits()
    );
    test.is(schema.size(), 2);
    test.is(schema.position("b"), 1);
    test.is(schema.position("c"), -1);
}
