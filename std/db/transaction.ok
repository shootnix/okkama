module db/transaction v1.0.0;

import "db/statement" take Statement, Execution;
import "db/row" take RowReading, DbQuery;
import "db/value" take DbValue;
import "collections/sequence" take Sequencing;

enum Isolation = (default_level, read_uncommitted, read_committed, repeatable_read, serializable);

object TransactionOptions {
    has isolation is Isolation;
    has read_only, deferrable is bool;

    TransactionOptions() {
        isolation = Isolation.default_level;
        read_only = false;
        deferrable = false;
    }

    TransactionOptions(isolation is Isolation, read_only is bool, deferrable is bool) {
        self.isolation = isolation;
        self.read_only = read_only;
        self.deferrable = deferrable;
    }

    cap Mode {
        isolation is Isolation {
            isolation;
        }

        read_only is bool {
            read_only;
        }

        deferrable is bool {
            deferrable;
        }
    }
}

role Transaction {
    async execution(origin is Statement) is Execution;
    async rows(origin is Statement) is RowReading;
    async execution(sql is string, values is Sequencing<DbValue>) is Execution;
    async execution(sql is string, values is ...DbValue) is Execution;
    query(sql is string, values is Sequencing<DbValue>) is DbQuery;
    query(sql is string, values is ...DbValue) is DbQuery;
    async commit() is Transaction;
    async rollback() is Transaction;
    active() is bool;
}

test "transaction options default to the server's isolation, read-write" {
    let plain = TransactionOptions();
    test.is(plain::Mode::isolation == Isolation.default_level, true);
    test.is(plain::Mode::read_only, false);
    test.is(plain::Mode::deferrable, false);
    let report = TransactionOptions(isolation: Isolation.serializable, read_only: true, deferrable: true);
    test.is(report::Mode::isolation == Isolation.serializable, true);
    test.is(report::Mode::read_only && report::Mode::deferrable, true);
}
