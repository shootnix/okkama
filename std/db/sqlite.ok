object SqliteFailureKind{has origin is string;SqliteFailureKind(origin is string){self.origin=origin;}value() is DbFailureKind{match origin{case "connection"{DbFailureKind.connection;}case "constraint"{DbFailureKind.constraint;}case "syntax"{DbFailureKind.syntax;}case "data"{DbFailureKind.data;}case "permission"{DbFailureKind.permission;}case "busy"{DbFailureKind.busy;}case "cancelled"{DbFailureKind.cancelled;}case "resource"{DbFailureKind.resource;}case "unsupported"{DbFailureKind.unsupported;}else{DbFailureKind.unexpected;}}}}
object SqliteNativeError{has origin is NativeFailure;has operation is DbOperation;SqliteNativeError(origin is NativeFailure,operation is DbOperation){self.origin=origin;self.operation=operation;}value() is DbFailure{let kind=match origin.code(){case "unsupported"{DbFailureKind.unsupported;}case "invalid_input"{DbFailureKind.data;}case "resource_exhausted"{DbFailureKind.resource;}case "timed_out"{DbFailureKind.timeout;}else{DbFailureKind.connection;}};DbFailure(kind,operation,origin.code(),"SQLite worker failed");}}
object InvalidSqliteOptions does Error{InvalidSqliteOptions();text() is string{"invalid SQLite options";}}

enum SqliteTransactionMode=(deferred,immediate,exclusive);
object SqliteOrigin {
    has origin is SqliteConnection;SqliteOrigin(connection is SqliteConnection){origin=connection;}
    async transaction(options is TransactionOptions,mode is SqliteTransactionMode) is SqliteTransaction{await origin.transaction(options,mode);}
}
object SqliteTransactions {
    has origin is SqliteOrigin;has mode is SqliteTransactionMode;
    SqliteTransactions(origin is SqliteConnection,mode is SqliteTransactionMode){self.origin=SqliteOrigin(origin);self.mode=mode;}
    async transaction(options is TransactionOptions) is SqliteTransaction{await origin.transaction(options,mode);}
}
object SqliteBeginCleanup{has owner is SqliteSession;has token is Atomic<int>;has published is Event;SqliteBeginCleanup(owner is SqliteSession,token is Atomic<int>,published is Event){self.owner=owner;self.token=token;self.published=published;}close() is void{if !published.ready(){owner.abandon(token.value());}}}
object SqliteTransaction does Transaction,DbExecuting,DbPreparing,SqliteBlobOpening,SqliteScripting {
    has owner is SqliteSession;has token is int;has outcome is Atomic<int>;
    SqliteTransaction(owner is SqliteSession,token is int){self.owner=owner;self.token=token;outcome=Atomic(0);}
    active() is bool{outcome.value()==0 && owner.active(token);}
    async execution(origin is Statement) is Execution{confirm self.active() else throw TransactionEnded();await owner.execution_for(origin,token);}
    async rows(origin is Statement) is RowReading{confirm self.active() else throw TransactionEnded();await owner.rows_for(origin,token);}
    async opened_blob(database is string,table is string,column is string,row is BigInt,writable is bool) is SqliteBlob{confirm self.active() else throw TransactionEnded();await owner.open_blob(database,table,column,row,writable,token);}
    async script(source is string) is Sequencing<Execution>{confirm self.active() else throw TransactionEnded();await owner.script(source,token);}
    async prepared(text is string) is PreparedStatement{confirm self.active() else throw TransactionEnded();await owner.prepare_for(text,token);}
    async commit() is Transaction{
        if outcome.value()==3{throw IndeterminateCommit();}if outcome.value()==1{return self;}confirm self.active() else throw TransactionEnded();
        await owner.finish(token,true,outcome);
        outcome.replace(1);self;
    }
    async rollback() is Transaction{if outcome.value()==2{return self;}confirm self.active() else throw TransactionEnded();await owner.finish(token,false,outcome);outcome.replace(2);self;}
    destroy{if outcome.value()==0{owner.abandon(token);}}
}

object SqlitePrepared does PreparedStatement,Closing {
    has owner is SqliteSession;has id,token is int;has stopped is Event;
    SqlitePrepared(owner is SqliteSession,id is int,token is int){self.owner=owner;self.id=id;self.token=token;stopped=Event();}
    closed() is bool{stopped.ready() || owner.prepared_closed(token);}
    close() is void{if !stopped.ready(){stopped.set();owner.unprepare(id);}}
    async execution(values is Sequencing<DbValue>) is Execution{confirm !self.closed() else throw DbClosed();await owner.prepared_execution(id,values,token);}
    async rows(values is Sequencing<DbValue>) is RowReading{confirm !self.closed() else throw DbClosed();await owner.prepared_rows(id,values,stopped,token);}
    destroy{self.close();}
}

object SqliteBlobHandle does SqliteBlob,Closing{
    has owner is SqliteSession;has id,size,token is int;has writable is bool;has stopped is Event;
    SqliteBlobHandle(owner is SqliteSession,id is int,size is int,writable is bool,token is int){self.owner=owner;self.id=id;self.size=size;self.writable=writable;self.token=token;stopped=Event();}
    size() is int{size;}closed() is bool{stopped.ready() || !owner.blob_active(id,token);}
    close() is void{if !stopped.ready(){stopped.set();owner.blob_close(id);}}
    bounds(offset is BigInt,limit is int) is void{confirm offset.order(BigInt("0"))!=Order.less && offset.order(BigInt(size.string()))!=Order.greater && limit>=0 && limit<=65536 && BigSum(left:offset,right:BigInt(limit.string())).value().order(BigInt(size.string()))!=Order.greater else throw InvalidSqliteBlob();}
    async bytes(offset is BigInt,limit is int) is @byte{confirm !self.closed() else throw DbClosed();confirm limit>0 else throw InvalidSqliteBlob();self.bounds(offset,limit);await owner.blob_bytes(id,offset,limit,token);}
    async write(offset is BigInt,source is @byte) is SqliteBlob{confirm !self.closed() else throw DbClosed();confirm writable else throw DbFailure(DbFailureKind.permission,DbOperation.writing_blob,"SQLITE_BLOB_READ_ONLY","SQLite blob is read-only");self.bounds(offset,source.size());await owner.blob_write(id,offset,source,token);self;}
    destroy{self.close();}
}
object SqliteBackupCleanup{has owner is SqliteSession;has id is int;SqliteBackupCleanup(owner is SqliteSession,id is int){self.owner=owner;self.id=id;}close() is void{owner.backup_close(id);}}

object SqliteFinishCleanup{
    has owner is SqliteSession;has token is int;has commit is bool;has outcome is Atomic<int>;has confirmed is Event;
    SqliteFinishCleanup(owner is SqliteSession,token is int,commit is bool,outcome is Atomic<int>,confirmed is Event){self.owner=owner;self.token=token;self.commit=commit;self.outcome=outcome;self.confirmed=confirmed;}
    close() is void{if !confirmed.ready(){if commit{outcome.replace(3);owner.close();}else{owner.abandon(token);}}}
}

test "SQLite defaults are explicit and foreign keys remain enabled"{
    let options=SqliteOptions();
    test.ok(!options.read_only() && options.creation() && options.foreign_keys());
    test.ok(options.busy_timeout().seconds()==0.rat());
}

test "SQLite rejects contradictory flags and sub-millisecond busy timeouts"{
    test.ok(try{SqliteOptions(true,true,true,Duration(0.rat(),DurationUnit.second),SqliteJournal.default_mode);false;}catch e is InvalidSqliteOptions{true;});
    test.ok(try{SqliteOptions(false,true,true,Duration(1.rat()/2000.rat(),DurationUnit.second),SqliteJournal.default_mode);false;}catch e is InvalidSqliteOptions{true;});
}
