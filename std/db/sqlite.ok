    async execution(origin is Statement) is Execution{await self.origin.execution(origin);}
    async rows(origin is Statement) is RowReading{await self.origin.rows(origin);}
    async transaction(options is TransactionOptions) is Transaction{await origin.begin(options,SqliteTransactionMode.deferred);}
    async prepared(text is string) is PreparedStatement{await origin.prepare(text);}
    async prepared_transaction(options is TransactionOptions) is DbPreparedTransaction{let transaction=await origin.begin(options,SqliteTransactionMode.deferred);DbPreparedTransaction(transaction,transaction);}
    async opened_blob(database is string,table is string,column is string,row is BigInt,writable is bool) is SqliteBlob{await origin.open_blob(database,table,column,row,writable,0);}
    async script(source is string) is Sequencing<Execution>{await origin.script(source,0);}
    async backup(target is Path,pages is int,clock is Timing,timeout is Duration) is BackupReport{await origin.backup(target,pages,clock,timeout);}
    closed() is bool{origin.closed();}close() is void{origin.close();}async settled() is bool{await origin.settled();}
    destroy{origin.close();}

