module db/sqlite v1.0.0;

// SQLite databases, in a file or in memory.
//
//     let db = await SqliteDatabase(path: Path("app.db"), options: SqliteOptions()).connection();
//     let scratch = await SqliteMemory().connection();
//     defer db.close();
//     await db.execution("CREATE TABLE IF NOT EXISTS notes(id INTEGER PRIMARY KEY, title TEXT)");
//     await db.execution("INSERT INTO notes(title) VALUES (?)", DbText("hello"));
//     let change = await db.transaction(options: TransactionOptions(), mode: SqliteTransactionMode.immediate);
//
// By default a file is created when missing, foreign keys are on, there is no
// busy timeout and the journal mode is SQLite's own. A connection is also a
// DbConnection, so portable code and pools (through SqliteConnector or
// SqliteAcquiring) take it. The work runs on a native worker; calls never block
// the event loop. BLOB streaming, scripts and backups are in the submodules.

import "runtime/database" as sqlite;
import "runtime/db" as native_db;
import "runtime/fs" take path_encode;
import "fs/path" take Path;
import "db/connection" take DbConnection, DbExecuting, DbConnecting;
import "db/prepared" take DbPreparing, PreparedStatement, DbPreparedOpening, DbPreparedTransaction;
import "db/acquisition" take DbAcquiring, DbAcquisition;
import "db/sqlite/blob" take SqliteBlobOpening, SqliteBlob, InvalidSqliteBlob;
import "db/sqlite/script" take SqliteScripting;
import "db/sqlite/backup" take SqliteBackupMaking, BackupReport;
import "time/clock" take Timing;
import "async/timeout" take Before, TimedOut;
import "compare" take Order;
import "db/transaction" take Transaction, TransactionOptions, Isolation;
import "db/statement" take Statement, Execution, DbLimits, DbBoundaryLimit;
import "db/row" take Row, Column, RowReading, RowsEnded, DbRowSchema, DbRowData, DbQuery;
import "db/read" take DbPage;
import "db/value" take DbValue, DbValueKind, ObservedDbValue, DbNativeValue, DbNull, DbInteger,
    DbFloating, DbText, DbBytes;
import "db/error" take DbFailure, DbFailureKind, DbOperation, DbClosed, DbBusy, TransactionEnded,
    IndeterminateCommit;
import "collections/sequence" take Sequencing;
import "encoding/utf" take Utf8Encoded;
import "numbers/bigint" take BigInt;
import "strings/parse" take Number;
import "time/duration" take Duration, DurationUnit;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/lock" take Lock;
import "async/scope" take FutureGroup;
import "io/stream" take Closing;
import "db/query" take Query, NoRows, TooManyRows, QueryLimitExceeded, InvalidQueryLimit;
import "db/acquisition" take PortableDbAcquiring;
import "db/sqlite/blob" take OpenedSqliteBlob;
import "db/sqlite/script" take SqliteScript;
import "db/sqlite/backup" take SqliteBackup;
import "fs/temp" take TemporaryDirectory;
import "fs/directory" take Directory;
import "time/clock" take SystemClock;

// The journal mode; default_mode leaves SQLite's.
enum SqliteJournal = (default_mode, delete_mode, wal, memory);

// How a SQLite database is opened.
object SqliteOptions {
    has read_only, create, foreign_keys is bool;
    has busy is Duration;
    has journal is SqliteJournal;

    // Read-write, created when missing, foreign keys on, no busy timeout,
    // default journal.
    SqliteOptions() {
        read_only = false;
        create = true;
        foreign_keys = true;
        busy = Duration(seconds: 0);
        journal = SqliteJournal.default_mode;
    }

    // The options as given; InvalidSqliteOptions for read_only with create, or
    // a busy timeout outside 0-60 s in whole milliseconds.
    SqliteOptions(
        read_only is bool,
        create is bool,
        foreign_keys is bool,
        busy_timeout is Duration,
        journal is SqliteJournal
    ) {
        confirm !(read_only && create)
            && busy_timeout::Span::seconds >= 0.rat()
            && busy_timeout::Span::seconds <= 60.rat()
            && (busy_timeout::Span::seconds * 1000.rat()).denominator() == "1"
            else throw InvalidSqliteOptions.invalid;
        self.read_only = read_only;
        self.create = create;
        self.foreign_keys = foreign_keys;
        busy = busy_timeout;
        self.journal = journal;
    }

    // How long to wait for a lock held by another connection.
    busy_timeout() is Duration {
        busy;
    }

    // Read-only, creation, foreign keys and the journal mode.
    cap Settings {
        read_only is bool {
            read_only;
        }

        creation is bool {
            create;
        }

        foreign_keys is bool {
            foreign_keys;
        }

        journal is SqliteJournal {
            journal;
        }
    }
}

// A SQLite database file.
object SqliteDatabase {
    has path is Path;
    has options is SqliteOptions;

    // The database at path, opened with options.
    SqliteDatabase(path is Path, options is SqliteOptions) {
        self.path = path;
        self.options = options;
    }

    // Its path.
    path() is Path {
        path;
    }

    // Its options.
    options() is SqliteOptions {
        options;
    }

    // A new connection; DbFailure when it cannot be opened.
    async connection() is SqliteConnection {
        await SqliteOpening(path: path_encode(path.string()), memory: false, options: options).connection();
    }
}

// A private in-memory database; it is gone when its connection closes.
object SqliteMemory {
    has options is SqliteOptions;

    // With options.
    SqliteMemory(options is SqliteOptions) {
        self.options = options;
    }

    // With the default options.
    SqliteMemory() {
        options = SqliteOptions();
    }

    // Its options.
    options() is SqliteOptions {
        options;
    }

    // A new connection to a new empty database.
    async connection() is SqliteConnection {
        await SqliteOpening(path: [], memory: true, options: options).connection();
    }
}

// Explicit adapter preserves concrete SQLite acquisition for backend-specific
// collaborators while giving a pool only the portable connection capability.
object SqliteConnector does DbConnecting {
    has origin is SqliteDatabase;

    // Connects to origin.
    SqliteConnector(origin is SqliteDatabase) {
        self.origin = origin;
    }

    // A new connection.
    async connection() is DbConnection {
        await origin.connection();
    }
}

// A SQLite database as a DbAcquiring, for prepared pools.
object SqliteAcquiring does DbAcquiring {
    has origin is SqliteDatabase;

    // Connects to origin.
    SqliteAcquiring(origin is SqliteDatabase) {
        self.origin = origin;
    }

    // A new connection with its preparation.
    async acquisition() is DbAcquisition {
        let connection = await origin.connection();
        DbAcquisition(connection: connection, preparation: connection, transactions: connection);
    }
}

// One opening of a connection.
object SqliteOpening {
    has path is @byte;
    has memory is bool;
    has options is SqliteOptions;

    // Opens path (in memory when memory) with options.
    SqliteOpening(path is @byte, memory is bool, options is SqliteOptions) {
        self.path = path;
        self.memory = memory;
        self.options = options;
    }

    // The connection.
    async connection() is SqliteConnection {
        confirm !(memory && options::Settings::read_only) else throw InvalidSqliteOptions.invalid;
        let journal = match options::Settings::journal {
            case SqliteJournal.default_mode {
                if memory {
                    "memory";
                }
                else {
                    "delete";
                }
            }
            case SqliteJournal.delete_mode {
                "delete";
            }
            case SqliteJournal.wal {
                "wal";
            }
            case SqliteJournal.memory {
                "memory";
            }
            else {
                throw InvalidSqliteOptions.invalid;
            }
        };
        let state = try {
            sqlite.sqlite_create(
                path,
                options::Settings::read_only,
                options::Settings::creation,
                options::Settings::foreign_keys,
                (options.busy_timeout()::Span::seconds * 1000.rat()).int(),
                journal,
                memory
            );
        }
        catch e is NativeFailure {
            throw SqliteNativeError(origin: e, operation: DbOperation.connecting).failure();
        };
        let published = Event();
        let anchor = SqliteUnpublished(state: state, published: published);
        defer await anchor.close();
        let group is FutureGroup<sqlite.SqliteReplyState> = FutureGroup();
        let cleanup = SqliteTaskCleanup(group: group, state: state);
        defer await cleanup.close();
        let waiting = sqlite.sqlite_connect(state);
        group.start(waiting);
        let reply = try {
            await waiting;
        }
        catch e is NativeFailure {
            throw SqliteNativeError(origin: e, operation: DbOperation.connecting).failure();
        };
        let frame = SqliteFrame(state: reply, operation: DbOperation.connecting);
        defer frame.close();
        let connection = SqliteConnection(
            SqliteSession(state: state, read_only: options::Settings::read_only)
        );
        published.set();
        connection;
    }
}

hidden object SqliteUnpublished {
    has state is sqlite.SqliteState;
    has published is Event;

    SqliteUnpublished(state is sqlite.SqliteState, published is Event) {
        self.state = state;
        self.published = published;
    }

    async close() is void {
        if !published.ready() {
            sqlite.sqlite_close(state);
            await sqlite.sqlite_settled(state);
        }
    }
}

hidden object SqliteTaskCleanup<T> {
    has group is FutureGroup<T>;
    has state is sqlite.SqliteState;
    has completed is Event;

    SqliteTaskCleanup(group is FutureGroup<T>, state is sqlite.SqliteState) {
        self.group = group;
        self.state = state;
        completed = Event();
    }

    SqliteTaskCleanup(group is FutureGroup<T>, state is sqlite.SqliteState, completed is Event) {
        self.group = group;
        self.state = state;
        self.completed = completed;
    }

    async close() is void {
        if group.active() > 0 {
            group.cancel();
            await group.wait();
        }
        // A delivered reply acknowledges the worker operation. Cancellation can
        // settle its Future earlier, so that path still needs the worker barrier.
        if !completed.ready() {
            try {
                await sqlite.sqlite_settled(state);
            }
            catch e is NativeFailure {
                throw SqliteNativeError(origin: e, operation: DbOperation.closing).failure();
            }
        }
    }
}

// A connection to a SQLite database.
object SqliteConnection does DbConnection, DbExecuting, DbPreparing, DbPreparedOpening, SqliteBlobOpening, SqliteScripting, SqliteBackupMaking, Closing {
    has origin is SqliteSession;

    // The connection over origin.
    SqliteConnection(origin is SqliteSession) {
        self.origin = origin;
    }

    // Runs statement.
    async execution(origin is Statement) is Execution {
        await self.origin.execution(origin);
    }

    // Runs statement and reads its rows.
    async rows(origin is Statement) is RowReading {
        await self.origin.rows(origin);
    }

    // Begins a deferred transaction.
    async transaction(options is TransactionOptions) is Transaction {
        await origin.begin(options, SqliteTransactionMode.deferred);
    }

    // Prepares text.
    async prepared(text is string) is PreparedStatement {
        await origin.prepare(text);
    }

    // Begins a transaction that can prepare statements.
    async prepared_transaction(options is TransactionOptions) is DbPreparedTransaction {
        let transaction = await origin.begin(options, SqliteTransactionMode.deferred);
        DbPreparedTransaction(origin: transaction, preparation: transaction);
    }

    // Opens the BLOB in column of row in table of database, for writing when
    // writable.
    async opened_blob(
        database is string,
        table is string,
        column is string,
        row is BigInt,
        writable is bool
    ) is SqliteBlob {
        await origin.open_blob(database, table, column, row, writable, 0);
    }

    // Runs every statement of source; one Execution each.
    async script(source is string) is Sequencing<Execution> {
        await origin.script(source, 0);
    }

    // Copies the database to target, pages at a time, within timeout.
    async backup(target is Path, pages is int, clock is Timing, timeout is Duration) is BackupReport {
        await origin.backup(target, pages, clock, timeout);
    }

    // Whether it was closed.
    closed() is bool {
        origin.closed();
    }

    // Closes it.
    close() is void {
        origin.close();
    }

    // Waits until its worker has finished.
    async settled() is bool {
        await origin.settled();
    }

    destroy {
        origin.close();
    }

    // Begins a transaction in mode.
    async transaction(options is TransactionOptions, mode is SqliteTransactionMode) is SqliteTransaction {
        await origin.begin(options, mode);
    }

    // db.execution(sql, values) and db.query(sql, values).one(): the values
    // are always bound, never pasted into the SQL.
    async execution(sql is string, values is Sequencing<DbValue>) is Execution {
        await self.execution(Statement(text: sql, values: values));
    }

    // The values one by one: db.execution("… = ?", DbInteger(7)).
    async execution(sql is string, values is ...DbValue) is Execution {
        let listed is @DbValue = values...;
        await self.execution(sql, listed);
    }

    // A query of sql with values bound.
    query(sql is string, values is Sequencing<DbValue>) is DbQuery {
        Query(origin: self, statement: Statement(text: sql, values: values));
    }

    // The values one by one: db.query("… = ?", DbInteger(7)).
    query(sql is string, values is ...DbValue) is DbQuery {
        let listed is @DbValue = values...;
        self.query(sql, listed);
    }
}

// The worker side of a connection; used inside db/sqlite.
object SqliteSession does Closing {
    has state is sqlite.SqliteState;
    has lock is Lock;
    has reader, reader_prepared, transaction, serial, blob is Atomic<int>;
    has read_only is bool;
    has transaction_prepared is Atomic<@int>;
    has fetches is Atomic<@Future<sqlite.SqliteReplyState>>;
    has fetch_id is Atomic<int>;
    has shape is Atomic<@SqliteShape>;

    // The native connection state.
    SqliteSession(state is sqlite.SqliteState, read_only is bool) {
        let no_shape is @SqliteShape = [];
        shape = Atomic(no_shape);
        self.state = state;
        self.read_only = read_only;
        lock = Lock();
        reader = Atomic(0);
        reader_prepared = Atomic(0);
        transaction = Atomic(0);
        serial = Atomic(0);
        blob = Atomic(0);
        let no_prepared is @int = [];
        transaction_prepared = Atomic(no_prepared);
        let no_fetches is @Future<sqlite.SqliteReplyState> = [];
        fetches = Atomic(no_fetches);
        fetch_id = Atomic(0);
    }

    // Whether it was closed.
    closed() is bool {
        sqlite.sqlite_closed(state);
    }

    // Closes it.
    close() is void {
        sqlite.sqlite_close(state);
    }

    // Waits until its worker has finished.
    async settled() is bool {
        try {
            await sqlite.sqlite_settled(state);
        }
        catch e is NativeFailure {
            throw SqliteNativeError(origin: e, operation: DbOperation.closing).failure();
        }
    }

    // Runs statement outside a transaction.
    async execution(statement is Statement) is Execution {
        await self.execution_for(statement, 0);
    }

    // Runs statement for the transaction token.
    async execution_for(statement is Statement, token is int) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw DbClosed.closed;
        self.permit(token);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let frame = await self.reply(
            sqlite.sqlite_execution_cells(state, statement.text(), statement.cells()),
            DbOperation.executing
        );
        defer frame.close();
        frame.execution();
    }

    // Opens the rows of statement.
    async rows(statement is Statement) is RowReading {
        await self.rows_for(statement, 0);
    }

    // Opens the rows of statement for token.
    async rows_for(statement is Statement, token is int) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw DbClosed.closed;
        self.permit(token);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let frame = await self.reply(
            sqlite.sqlite_rows_cells(state, statement.text(), statement.cells()),
            DbOperation.preparing
        );
        defer frame.close();
        let id = frame.identifier();
        let shape = self.shaped(frame);
        reader.replace(id);
        let rows = SqliteRows(owner: self, id: id, shape: shape, token: token);
        rows.primed(frame);
        rows;
    }

    // Prepares text.
    async prepare(text is string) is PreparedStatement {
        await self.prepare_for(text, 0);
    }

    // Prepares text for token.
    async prepare_for(text is string, token is int) is PreparedStatement {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        self.permit(token);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let frame = await self.reply(
            sqlite.sqlite_prepare(state, Utf8Encoded(Statement(text).text()).bytes()),
            DbOperation.preparing
        );
        defer frame.close();
        let id = frame.identifier();
        if token > 0 {
            let old = transaction_prepared.value();
            let all is @int = old + [id];
            transaction_prepared.replace(all);
        }
        SqlitePrepared(owner: self, id: id, token: token);
    }

    // Runs prepared statement id with values.
    async prepared_execution(id is int, values is Sequencing<DbValue>, token is int) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        self.permit(token);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let bindings = SqliteBindings(values);
        let frame = await self.reply(
            sqlite.sqlite_prepared_execution_cells(state, id, bindings.cells()),
            DbOperation.executing
        );
        defer frame.close();
        frame.execution();
    }

    // Opens the rows of prepared statement id with values.
    async prepared_rows(
        id is int,
        values is Sequencing<DbValue>,
        source_closed is Event,
        token is int
    ) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        self.permit(token);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let bindings = SqliteBindings(values);
        let frame = await self.reply(
            sqlite.sqlite_prepared_rows_cells(state, id, bindings.cells()),
            DbOperation.preparing
        );
        defer frame.close();
        let cursor = frame.identifier();
        reader.replace(cursor);
        reader_prepared.replace(id);
        let rows = SqliteRows(
            owner: self,
            id: cursor,
            shape: self.shaped(frame),
            source_closed: source_closed,
            token: token
        );
        rows.primed(frame);
        rows;
    }

    // Columns and row schema of a result, reused while a session repeats the
    // same result shape (names and declared types).
    shaped(frame is SqliteFrame) is SqliteShape {
        let names = frame.names();
        let declarations = frame.declarations();
        let cached = shape.value();
        if cached.size() == 1 && cached[0].matches(names, declarations) {
            cached[0];
        }
        else {
            let columns is @Column = (0..names.size()).map() -> index {
                Column(index: index, name: names[index], declaration: declarations[index]);
            };
            let made = SqliteShape(
                names: names,
                declarations: declarations,
                columns: columns,
                schema: DbRowSchema(columns: columns, limits: DbLimits())
            );
            shape.replace([made]);
            made;
        }
    }

    // Finalizes prepared statement id.
    unprepare(id is int) is void {
        let kept is @int = transaction_prepared.value().filter() -> entry {
            entry != id;
        };
        transaction_prepared.replace(kept);
        if reader_prepared.value() == id && reader.value() > 0 {
            self.release(reader.value());
        }
        if !self.closed() {
            sqlite.sqlite_unprepare(state, id);
        }
    }

    // Finalizes every prepared statement.
    end_prepared() is void {
        let ids = transaction_prepared.value();
        transaction_prepared.replace([]);
        for ids -> id {
            self.unprepare(id);
        }
    }

    // Whether the statements of token are closed.
    prepared_closed(token is int) is bool {
        self.closed() || (token > 0 && !self.active(token));
    }

    // A cancelled or failed request has settled (a cancellation reaches the
    // native request, which withdraws it) before the worker barrier runs.
    async reply(waiting is Future<sqlite.SqliteReplyState>, operation is DbOperation) is SqliteFrame {
        let reply = try {
            await waiting;
        }
        catch e is NativeFailure {
            await self.barrier();
            throw SqliteNativeError(origin: e, operation: operation).failure();
        }
        catch e is Cancelled {
            await self.barrier();
            throw;
        };
        SqliteFrame(state: reply, operation: operation);
    }

    // Waits until the worker is idle.
    async barrier() is void {
        try {
            await sqlite.sqlite_settled(state);
        }
        catch e is NativeFailure {
            throw SqliteNativeError(origin: e, operation: DbOperation.closing).failure();
        }
    }

    // Opens a BLOB for token.
    async open_blob(
        database is string,
        table is string,
        column is string,
        row is BigInt,
        writable is bool,
        token is int
    ) is SqliteBlob {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        self.permit(token);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let frame = await self.reply(
            sqlite.sqlite_blob_open(state, database, table, column, row.string(), writable),
            DbOperation.opening_blob
        );
        defer frame.close();
        let id = frame.identifier();
        blob.replace(id);
        SqliteBlobHandle(owner: self, id: id, size: frame.size(), writable: writable, token: token);
    }

    // Whether BLOB id is open for token.
    blob_active(id is int, token is int) is bool {
        !self.closed()
            && blob.value() == id
            && (if token == 0 {
                transaction.value() == 0;
            }
            else {
                self.active(token);
            });
    }

    // Closes BLOB id.
    blob_close(id is int) is void {
        if blob.value() == id {
            blob.replace(0);
            if !self.closed() {
                sqlite.sqlite_blob_close(state, id);
            }
        }
    }

    // Reads from BLOB id.
    async blob_bytes(id is int, offset is BigInt, limit is int, token is int) is @byte {
        let guard = await lock.guard();
        defer guard.close();
        confirm self.blob_active(id, token) else throw DbClosed.closed;
        let frame = await self.reply(
            sqlite.sqlite_blob_read(state, id, offset.string(), limit),
            DbOperation.reading_blob
        );
        defer frame.close();
        frame.bytes();
    }

    // Writes to BLOB id.
    async blob_write(id is int, offset is BigInt, source is @byte, token is int) is bool {
        let guard = await lock.guard();
        defer guard.close();
        confirm self.blob_active(id, token) else throw DbClosed.closed;
        let frame = await self.reply(
            sqlite.sqlite_blob_write(state, id, offset.string(), source),
            DbOperation.writing_blob
        );
        defer frame.close();
        true;
    }

    // Runs a script for token.
    async script(source is string, token is int) is Sequencing<Execution> {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        self.permit(token);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let frame = await self.reply(
            sqlite.sqlite_script(state, Utf8Encoded(source).bytes()),
            DbOperation.script
        );
        defer frame.close();
        frame.executions();
    }

    // Backs up to target; DbBusy while rows or a BLOB are open.
    async backup(target is Path, pages is int, clock is Timing, timeout is Duration) is BackupReport {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        self.permit(0);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let deadline = clock.monotonic_instant().plus(timeout);
        let opening is Before<sqlite.SqliteReplyState> = Before(
            origin: sqlite.sqlite_backup_open(state, path_encode(target.string())),
            deadline: deadline,
            clock: clock
        );
        let opened = await self.reply(opening.outcome(), DbOperation.backing_up);
        defer opened.close();
        let id = opened.identifier();
        let cleanup = SqliteBackupCleanup(owner: self, id: id);
        defer cleanup.close();
        loop {
            confirm clock.monotonic_instant().order(deadline) == Order.less
                else throw TimedOut.elapsed;
            let request is Before<sqlite.SqliteReplyState> = Before(
                origin: sqlite.sqlite_backup_step(state, id, pages),
                deadline: deadline,
                clock: clock
            );
            let frame = await self.reply(request.outcome(), DbOperation.backing_up);
            defer frame.close();
            if frame.done() {
                return BackupReport(copies: frame.copies(), total: frame.total());
            }
            await clock.wait(Duration(
                value: if frame.busy() {
                    5.rat();
                }
                else {
                    0.rat();
                },
                unit: DurationUnit.millisecond
            ));
        }
    }

    // Ends backup id.
    backup_close(id is int) is void {
        if !self.closed() {
            sqlite.sqlite_backup_close(state, id);
        }
    }

    // Throws unless token may act now.
    permit(token is int) is void {
        confirm !self.closed() else throw DbClosed.closed;
        if transaction.value() > 0 && sqlite.sqlite_autocommit(state) {
            transaction.replace(0);
        }
        if token > 0 && transaction.value() != token {
            throw TransactionEnded.ended;
        }
        confirm transaction.value() == token else throw DbBusy.busy;
    }

    // Whether transaction token is open.
    active(token is int) is bool {
        !self.closed() && transaction.value() == token && !sqlite.sqlite_autocommit(state);
    }

    // Begins a transaction.
    async begin(options is TransactionOptions, mode is SqliteTransactionMode) is SqliteTransaction {
        confirm !self.closed() else throw DbClosed.closed;
        confirm (options::Mode::isolation == Isolation.default_level
            || options::Mode::isolation == Isolation.serializable)
            && !options::Mode::deferrable
            && (!options::Mode::read_only || read_only)
            else throw DbFailure.detailed(
                DbFailureKind.unsupported,
                DbOperation.executing,
                "SQLITE_TRANSACTION_OPTIONS",
                "SQLite cannot enforce requested transaction options"
            );
        let guard = await lock.guard();
        defer guard.close();
        self.permit(0);
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let published = Event();
        let token = Atomic(0);
        let rollback = SqliteBeginCleanup(owner: self, token: token, published: published);
        defer rollback.close();
        let name = match mode {
            case SqliteTransactionMode.deferred {
                "DEFERRED";
            }
            case SqliteTransactionMode.immediate {
                "IMMEDIATE";
            }
            case SqliteTransactionMode.exclusive {
                "EXCLUSIVE";
            }
            else {
                throw InvalidSqliteOptions.invalid;
            }
        };
        await self.control("BEGIN " + name, DbOperation.executing);
        let id = serial.value() + 1;
        serial.replace(id);
        transaction.replace(id);
        token.replace(id);
        published.set();
        SqliteTransaction(owner: self, token: id);
    }

    // Runs a transaction control statement.
    async control(sql is string, operation is DbOperation) is bool {
        let frame = await self.reply(
            sqlite.sqlite_control(state, Utf8Encoded(sql).bytes()),
            operation
        );
        defer frame.close();
        true;
    }

    // Commits or rolls back token.
    async finish(token is int, commit is bool, outcome is Atomic<int>) is bool {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        self.permit(token);
        if !commit {
            if reader.value() > 0 {
                self.release(reader.value());
            }
            if blob.value() > 0 {
                self.blob_close(blob.value());
            }
        }
        confirm reader.value() == 0 && blob.value() == 0 else throw DbBusy.busy;
        let confirmed = Event();
        let cleanup = SqliteFinishCleanup(
            owner: self,
            token: token,
            commit: commit,
            outcome: outcome,
            confirmed: confirmed
        );
        defer cleanup.close();
        if !commit {
            await self.settled();
        }
        try {
            if commit || !sqlite.sqlite_autocommit(state) {
                await self.control(
                    if commit {
                        "COMMIT";
                    }
                    else {
                        "ROLLBACK";
                    },
                    if commit {
                        DbOperation.committing;
                    }
                    else {
                        DbOperation.rolling_back;
                    }
                );
            }
        }
        catch DbFailure.detailed(kind, _, _, _) {
            if commit
                && (kind == DbFailureKind.connection
                || kind == DbFailureKind.timeout
                || kind == DbFailureKind.cancelled) {
                    throw IndeterminateCommit.indeterminate;
                }
            confirmed.set();
            throw;
        }
        confirmed.set();
        transaction.replace(0);
        self.end_prepared();
        true;
    }

    // Rolls back token without waiting.
    abandon(token is int) is void {
        if transaction.value() == token || token == 0 {
            transaction.replace(0);
            self.end_prepared();
            if blob.value() > 0 {
                self.blob_close(blob.value());
            }
            if reader.value() > 0 {
                self.release(reader.value());
            }
            if !self.closed() {
                sqlite.sqlite_rollback(state);
            }
        }
    }

    // Releases cursor id.
    release(id is int) is void {
        if reader.value() == id {
            reader.replace(0);
            reader_prepared.replace(0);
            if fetch_id.value() == id {
                for fetches.value() -> pending {
                    pending.cancel();
                }
            }
            if !self.closed() {
                sqlite.sqlite_release(state, id);
            }
        }
    }

    // Drops the pending page of cursor id.
    clear_fetch(id is int) is void {
        if fetch_id.value() == id {
            fetches.replace([]);
            fetch_id.replace(0);
        }
    }

    // The next page of cursor id, at most maximum rows.
    async batch(id is int, maximum is int) is SqliteFrame {
        confirm !self.closed() && reader.value() == id else throw DbClosed.closed;
        let waiting = sqlite.sqlite_fetch(state, id, maximum);
        fetch_id.replace(id);
        fetches.replace([waiting]);
        defer self.clear_fetch(id);
        await self.reply(waiting, DbOperation.fetching);
    }
}

// The columns of a result shape, reused while it repeats.
object SqliteShape {
    has names, declarations is @string;
    has columns is @Column;
    has schema is DbRowSchema;

    // As given.
    SqliteShape(
        names is @string,
        declarations is @string,
        columns is @Column,
        schema is DbRowSchema
    ) {
        self.names = names;
        self.declarations = declarations;
        self.columns = columns;
        self.schema = schema;
    }

    // The columns.
    columns() is @Column {
        columns;
    }

    // The row schema.
    schema() is DbRowSchema {
        schema;
    }

    // Whether names and declarations are this shape's.
    matches(names is @string, declarations is @string) is bool {
        self.names == names && self.declarations == declarations;
    }
}

hidden object SqliteRows does RowReading, Closing {
    has schema is DbRowSchema;
    has owner is SqliteSession;
    has id, token is int;
    has columns is @Column;
    has batch is Atomic<@Row>;
    has position is Atomic<int>;
    has eof, stopped, source_closed is Event;
    has busy is Atomic<bool>;
    has failure is Atomic<@string>;

    SqliteRows(owner is SqliteSession, id is int, shape is SqliteShape) {
        self.owner = owner;
        self.id = id;
        token = 0;
        self.columns = shape.columns();
        schema = shape.schema();
        let empty is @Row = [];
        batch = Atomic(empty);
        position = Atomic(0);
        eof = Event();
        stopped = Event();
        source_closed = Event();
        busy = Atomic(false);
        let clean is @string = [];
        failure = Atomic(clean);
    }

    SqliteRows(owner is SqliteSession, id is int, shape is SqliteShape, token is int) {
        self.owner = owner;
        self.id = id;
        self.token = token;
        self.columns = shape.columns();
        schema = shape.schema();
        source_closed = Event();
        let empty is @Row = [];
        batch = Atomic(empty);
        position = Atomic(0);
        eof = Event();
        stopped = Event();
        busy = Atomic(false);
        let clean is @string = [];
        failure = Atomic(clean);
    }

    SqliteRows(
        owner is SqliteSession,
        id is int,
        shape is SqliteShape,
        source_closed is Event,
        token is int
    ) {
        self.owner = owner;
        self.id = id;
        self.token = token;
        self.columns = shape.columns();
        schema = shape.schema();
        self.source_closed = source_closed;
        let empty is @Row = [];
        batch = Atomic(empty);
        position = Atomic(0);
        eof = Event();
        stopped = Event();
        busy = Atomic(false);
        let clean is @string = [];
        failure = Atomic(clean);
    }

    columns() is Sequencing<Column> {
        columns;
    }

    closed() is bool {
        stopped.ready() || source_closed.ready() || owner.prepared_closed(token);
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            batch.replace([]);
            owner.release(id);
        }
    }

    // The first page and EOF arrive with the cursor (one worker round trip).
    primed(frame is SqliteFrame) is void {
        let deferred = frame.deferred();
        if deferred.size() > 0 {
            failure.replace(deferred);
        }
        else {
            let rows = frame.rows(schema);
            batch.replace(rows);
            position.replace(0);
            if frame.ended() {
                eof.set();
            }
        }
    }

    async row() is Row {
        confirm !self.closed() else throw DbClosed.closed;
        confirm busy.compare_and_replace(false, true) else throw DbBusy.busy;
        defer busy.replace(false);
        let deferred = failure.value();
        if deferred.size() > 0 {
            let clean is @string = [];
            failure.replace(clean);
            self.close();
            throw DbFailure.detailed(
                SqliteFailureKind(deferred[0]).kind(),
                DbOperation.fetching,
                deferred[1],
                "SQLite operation rejected"
            );
        }
        if position.value() == batch.value().size() {
            if eof.ready() {
                throw RowsEnded.ended;
            }
            let complete = Event();
            let cleanup = SqliteRowsCleanup(owner: self, complete: complete);
            defer cleanup.close();
            let frame = await owner.batch(id, if position.value() == 0 {
                8;
            }
            else {
                64;
            });
            defer frame.close();
            confirm !self.closed() else throw DbClosed.closed;
            let rows = frame.rows(schema);
            batch.replace(rows);
            position.replace(0);
            if frame.ended() {
                eof.set();
            }
            complete.set();
            if rows.size() == 0 {
                throw RowsEnded.ended;
            }
        }
        let row = batch.value()[position.value()];
        position.replace(position.value() + 1);
        if eof.ready() && position.value() == batch.value().size() {
            owner.release(id);
        }
        row;
    }

    destroy {
        self.close();
    }
}

hidden object SqliteRowsCleanup {
    has owner is SqliteRows;
    has complete is Event;

    SqliteRowsCleanup(owner is SqliteRows, complete is Event) {
        self.owner = owner;
        self.complete = complete;
    }

    close() is void {
        if !complete.ready() {
            owner.close();
        }
    }
}

hidden object SqliteBindings {
    has cells is @native_db.DbCellState;

    SqliteBindings(values is Sequencing<DbValue>) {
        let limits = DbLimits();
        let count = values.size();
        confirm count >= 0 && count <= limits::Limits::values
            else throw DbBoundaryLimit.kind("value count");
        let used = Atomic(0);
        let cells is @native_db.DbCellState = (0..count).map() -> index {
            let value = ObservedDbValue(values.item(index));
            let width = value.width();
            confirm width <= limits::Limits::bytes - used.value()
                else throw DbBoundaryLimit.kind("value bytes");
            used.replace(used.value() + width);
            value.state();
        };
        self.cells = cells;
    }

    cells() is @native_db.DbCellState {
        cells;
    }

    kinds() is @int {
        let values is @int = cells.map() -> cell {
            native_db.db_kind(cell);
        };
        values;
    }

    values() is @@byte {
        let values is @@byte = cells.map() -> cell {
            SqliteBoundValue(ObservedDbValue(DbNativeValue(cell))).bytes();
        };
        values;
    }
}

hidden object SqliteBoundValue {
    has kind is int;
    has bytes is @byte;

    SqliteBoundValue(value is ObservedDbValue) {
        kind = match value.kind() {
            case DbValueKind.null_value {
                0;
            }
            case DbValueKind.boolean {
                1;
            }
            case DbValueKind.integer {
                2;
            }
            case DbValueKind.floating {
                3;
            }
            case DbValueKind.decimal {
                4;
            }
            case DbValueKind.text {
                5;
            }
            case DbValueKind.bytes {
                6;
            }
            else {
                throw InvalidSqliteOptions.invalid;
            }
        };
        bytes = match value.kind() {
            case DbValueKind.null_value {
                [];
            }
            case DbValueKind.boolean {
                Utf8Encoded(if value.boolean() {
                    "1";
                }
                else {
                    "0";
                }).bytes();
            }
            case DbValueKind.integer {
                Utf8Encoded(value.integer().string()).bytes();
            }
            case DbValueKind.floating {
                Utf8Encoded(value.floating().string()).bytes();
            }
            case DbValueKind.decimal {
                Utf8Encoded(value.decimal().string()).bytes();
            }
            case DbValueKind.text {
                Utf8Encoded(value.text()).bytes();
            }
            case DbValueKind.bytes {
                value.bytes();
            }
            else {
                throw InvalidSqliteOptions.invalid;
            }
        };
    }

    kind() is int {
        kind;
    }

    bytes() is @byte {
        bytes;
    }
}

// One reply of the worker; used inside db/sqlite.
object SqliteFrame {
    has state is sqlite.SqliteReplyState;
    has stopped is Event;

    // The reply state of operation; DbFailure when it reports one.
    SqliteFrame(state is sqlite.SqliteReplyState, operation is DbOperation) {
        self.state = state;
        stopped = Event();
        if !sqlite.sqlite_reply_ok(state) {
            let fields = sqlite.sqlite_reply_info(state);
            sqlite.sqlite_reply_close(state);
            self.stopped.set();
            throw DbFailure.detailed(
                SqliteFailureKind(fields["kind"]).kind(),
                operation,
                fields["code"],
                "SQLite operation rejected"
            );
        }
    }

    // Frees it.
    close() is void {
        if !stopped.ready() {
            stopped.set();
            sqlite.sqlite_reply_close(state);
        }
    }

    destroy {
        self.close();
    }

    // How many values.
    size() is int {
        Number(sqlite.sqlite_reply_info(state)["size"]).int();
    }

    // The bytes of a BLOB read.
    bytes() is @byte {
        sqlite.sqlite_reply_blob_bytes(state);
    }

    // Whether a backup finished.
    done() is bool {
        sqlite.sqlite_reply_info(state)["done"] == "1";
    }

    // Whether the database was busy.
    busy() is bool {
        sqlite.sqlite_reply_info(state)["busy"] == "1";
    }

    // Pages copied by a backup.
    copies() is BigInt {
        BigInt(sqlite.sqlite_reply_info(state)["copies"]);
    }

    // Pages in all.
    total() is BigInt {
        BigInt(sqlite.sqlite_reply_info(state)["total"]);
    }

    // The executions of a script.
    executions() is @Execution {
        let values is @Execution = sqlite.sqlite_reply_executions(state).map() -> value {
            if value == "unknown" {
                Execution();
            }
            else {
                Execution(BigInt(value));
            }
        };
        values;
    }

    // The id of what was opened.
    identifier() is int {
        sqlite.sqlite_reply_id(state);
    }

    // Whether a cursor reached its end.
    ended() is bool {
        sqlite.sqlite_reply_eof(state);
    }

    // A failure of the first page fetched with the cursor: [kind, code], or empty.
    deferred() is @string {
        sqlite.sqlite_reply_deferred(state);
    }

    // The execution.
    execution() is Execution {
        if sqlite.sqlite_reply_affected_known(state) {
            Execution(BigInt(sqlite.sqlite_reply_affected(state)));
        }
        else {
            Execution();
        }
    }

    // The column names.
    names() is @string {
        sqlite.sqlite_reply_names(state);
    }

    // The declared column types.
    declarations() is @string {
        sqlite.sqlite_reply_declarations(state);
    }

    // The columns.
    columns() is @Column {
        let names = sqlite.sqlite_reply_names(state);
        let declarations = sqlite.sqlite_reply_declarations(state);
        let columns is @Column = (0..names.size()).map() -> index {
            Column(index: index, name: names[index], declaration: declarations[index]);
        };
        columns;
    }

    // One page per reply: flat columns, no native cell per value.
    rows(schema is DbRowSchema) is @Row {
        let count = sqlite.sqlite_reply_count(state);
        if count == 0 {
            let empty is @Row = [];
            empty;
        }
        else {
            confirm sqlite.sqlite_reply_row_bytes(state) <= DbLimits()::Limits::bytes
                else throw DbBoundaryLimit.kind("value bytes");
            let page = DbPage(
                width: schema.size(),
                kinds: sqlite.sqlite_reply_kinds(state),
                values: sqlite.sqlite_reply_values(state),
                floats: sqlite.sqlite_reply_floats(state),
                texts: sqlite.sqlite_reply_texts(state),
                blobs: sqlite.sqlite_reply_blobs(state)
            );
            let rows is @Row = (0..count).map() -> index {
                Row(DbRowData(schema: schema, page: page, row: index));
            };
            rows;
        }
    }
}

hidden object SqliteFailureKind {
    has origin is string;

    SqliteFailureKind(origin is string) {
        self.origin = origin;
    }

    kind() is DbFailureKind {
        match origin {
            case "connection" {
                DbFailureKind.connection;
            }
            case "constraint" {
                DbFailureKind.constraint;
            }
            case "syntax" {
                DbFailureKind.syntax;
            }
            case "data" {
                DbFailureKind.data;
            }
            case "permission" {
                DbFailureKind.permission;
            }
            case "busy" {
                DbFailureKind.busy;
            }
            case "cancelled" {
                DbFailureKind.cancelled;
            }
            case "resource" {
                DbFailureKind.resource;
            }
            case "unsupported" {
                DbFailureKind.unsupported;
            }
            else {
                DbFailureKind.unexpected;
            }
        }
    }
}

hidden object SqliteNativeError {
    has origin is NativeFailure;
    has operation is DbOperation;

    SqliteNativeError(origin is NativeFailure, operation is DbOperation) {
        self.origin = origin;
        self.operation = operation;
    }

    failure() is DbFailure {
        let kind = match origin.code() {
            case "unsupported" {
                DbFailureKind.unsupported;
            }
            case "invalid_input" {
                DbFailureKind.data;
            }
            case "resource_exhausted" {
                DbFailureKind.resource;
            }
            case "timed_out" {
                DbFailureKind.timeout;
            }
            else {
                DbFailureKind.connection;
            }
        };
        DbFailure.detailed(kind, operation, origin.code(), "SQLite worker failed");
    }
}

// Options that cannot be used together.
enum InvalidSqliteOptions is Error = (invalid);

// BEGIN DEFERRED, IMMEDIATE or EXCLUSIVE.
enum SqliteTransactionMode = (deferred, immediate, exclusive);

hidden object SqliteOrigin {
    has origin is SqliteConnection;

    SqliteOrigin(connection is SqliteConnection) {
        origin = connection;
    }

    async transaction(options is TransactionOptions, mode is SqliteTransactionMode) is SqliteTransaction {
        await origin.transaction(options, mode);
    }
}

// Transactions of one mode on a connection.
object SqliteTransactions {
    has origin is SqliteOrigin;
    has mode is SqliteTransactionMode;

    // On origin in mode.
    SqliteTransactions(origin is SqliteConnection, mode is SqliteTransactionMode) {
        self.origin = SqliteOrigin(origin);
        self.mode = mode;
    }

    // Begins one with options.
    async transaction(options is TransactionOptions) is SqliteTransaction {
        await origin.transaction(options, mode);
    }
}

hidden object SqliteBeginCleanup {
    has owner is SqliteSession;
    has token is Atomic<int>;
    has published is Event;

    SqliteBeginCleanup(owner is SqliteSession, token is Atomic<int>, published is Event) {
        self.owner = owner;
        self.token = token;
        self.published = published;
    }

    close() is void {
        if !published.ready() {
            owner.abandon(token.value());
        }
    }
}

// An open SQLite transaction.
object SqliteTransaction does Transaction, DbExecuting, DbPreparing, SqliteBlobOpening, SqliteScripting {
    has owner is SqliteSession;
    has token is int;
    has outcome is Atomic<int>;

    // Transaction token of owner.
    SqliteTransaction(owner is SqliteSession, token is int) {
        self.owner = owner;
        self.token = token;
        outcome = Atomic(0);
    }

    // Whether it is still open.
    active() is bool {
        outcome.value() == 0 && owner.active(token);
    }

    // Runs statement.
    async execution(origin is Statement) is Execution {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.execution_for(origin, token);
    }

    // Runs statement and reads its rows.
    async rows(origin is Statement) is RowReading {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.rows_for(origin, token);
    }

    // Opens the BLOB in column of row in table of database, for writing when
    // writable.
    async opened_blob(
        database is string,
        table is string,
        column is string,
        row is BigInt,
        writable is bool
    ) is SqliteBlob {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.open_blob(database, table, column, row, writable, token);
    }

    // Runs every statement of source; one Execution each.
    async script(source is string) is Sequencing<Execution> {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.script(source, token);
    }

    // Prepares text.
    async prepared(text is string) is PreparedStatement {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.prepare_for(text, token);
    }

    // Commits.
    async commit() is Transaction {
        if outcome.value() == 3 {
            throw IndeterminateCommit.indeterminate;
        }
        if outcome.value() == 1 {
            return self;
        }
        confirm self.active() else throw TransactionEnded.ended;
        await owner.finish(token, true, outcome);
        outcome.replace(1);
        self;
    }

    // Rolls back.
    async rollback() is Transaction {
        if outcome.value() == 2 {
            return self;
        }
        confirm self.active() else throw TransactionEnded.ended;
        await owner.finish(token, false, outcome);
        outcome.replace(2);
        self;
    }

    destroy {
        if outcome.value() == 0 {
            owner.abandon(token);
        }
    }

    // db.execution(sql, values) and db.query(sql, values).one(): the values
    // are always bound, never pasted into the SQL.
    async execution(sql is string, values is Sequencing<DbValue>) is Execution {
        await self.execution(Statement(text: sql, values: values));
    }

    // The values one by one: db.execution("… = ?", DbInteger(7)).
    async execution(sql is string, values is ...DbValue) is Execution {
        let listed is @DbValue = values...;
        await self.execution(sql, listed);
    }

    // A query of sql with values bound.
    query(sql is string, values is Sequencing<DbValue>) is DbQuery {
        Query(origin: self, statement: Statement(text: sql, values: values));
    }

    // The values one by one: db.query("… = ?", DbInteger(7)).
    query(sql is string, values is ...DbValue) is DbQuery {
        let listed is @DbValue = values...;
        self.query(sql, listed);
    }
}

hidden object SqlitePrepared does PreparedStatement, Closing {
    has owner is SqliteSession;
    has id, token is int;
    has stopped is Event;

    SqlitePrepared(owner is SqliteSession, id is int, token is int) {
        self.owner = owner;
        self.id = id;
        self.token = token;
        stopped = Event();
    }

    closed() is bool {
        stopped.ready() || owner.prepared_closed(token);
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            owner.unprepare(id);
        }
    }

    async execution(values is Sequencing<DbValue>) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        await owner.prepared_execution(id, values, token);
    }

    // The values one by one: statement.execution(DbInteger(7)).
    async execution(values is ...DbValue) is Execution {
        let listed is @DbValue = values...;
        await self.execution(listed);
    }

    async rows(values is Sequencing<DbValue>) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        await owner.prepared_rows(id, values, stopped, token);
    }

    // The values one by one: statement.rows(DbInteger(7)).
    async rows(values is ...DbValue) is RowReading {
        let listed is @DbValue = values...;
        await self.rows(listed);
    }

    destroy {
        self.close();
    }
}

hidden object SqliteBlobHandle does SqliteBlob, Closing {
    has owner is SqliteSession;
    has id, size, token is int;
    has writable is bool;
    has stopped is Event;

    SqliteBlobHandle(owner is SqliteSession, id is int, size is int, writable is bool, token is int) {
        self.owner = owner;
        self.id = id;
        self.size = size;
        self.writable = writable;
        self.token = token;
        stopped = Event();
    }

    size() is int {
        size;
    }

    closed() is bool {
        stopped.ready() || !owner.blob_active(id, token);
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            owner.blob_close(id);
        }
    }

    bounds(offset is BigInt, limit is int) is void {
        confirm offset.order(BigInt(0)) != Order.less
            && offset.order(BigInt(size)) != Order.greater
            && limit >= 0
            && limit <= 65536
            && (offset + BigInt(limit)).order(BigInt(size)) != Order.greater
            else throw InvalidSqliteBlob.invalid;
    }

    async bytes(offset is BigInt, limit is int) is @byte {
        confirm !self.closed() else throw DbClosed.closed;
        confirm limit > 0 else throw InvalidSqliteBlob.invalid;
        self.bounds(offset, limit);
        await owner.blob_bytes(id, offset, limit, token);
    }

    async write(offset is BigInt, source is @byte) is SqliteBlob {
        confirm !self.closed() else throw DbClosed.closed;
        confirm writable
            else throw DbFailure.detailed(
                DbFailureKind.permission,
                DbOperation.writing_blob,
                "SQLITE_BLOB_READ_ONLY",
                "SQLite blob is read-only"
            );
        self.bounds(offset, source.size());
        await owner.blob_write(id, offset, source, token);
        self;
    }

    destroy {
        self.close();
    }
}

hidden object SqliteBackupCleanup {
    has owner is SqliteSession;
    has id is int;

    SqliteBackupCleanup(owner is SqliteSession, id is int) {
        self.owner = owner;
        self.id = id;
    }

    close() is void {
        owner.backup_close(id);
    }
}

hidden object SqliteFinishCleanup {
    has owner is SqliteSession;
    has token is int;
    has commit is bool;
    has outcome is Atomic<int>;
    has confirmed is Event;

    SqliteFinishCleanup(
        owner is SqliteSession,
        token is int,
        commit is bool,
        outcome is Atomic<int>,
        confirmed is Event
    ) {
        self.owner = owner;
        self.token = token;
        self.commit = commit;
        self.outcome = outcome;
        self.confirmed = confirmed;
    }

    close() is void {
        if !confirmed.ready() {
            if commit {
                outcome.replace(3);
                owner.close();
            }
            else {
                owner.abandon(token);
            }
        }
    }
}

test "SQLite defaults are explicit and foreign keys remain enabled" {
    let options = SqliteOptions();
    test.ok(
        !options::Settings::read_only
            && options::Settings::creation
            && options::Settings::foreign_keys
    );
    test.ok(options.busy_timeout()::Span::seconds == 0.rat());
}

test "SQLite rejects contradictory flags and sub-millisecond busy timeouts" {
    test.ok(try {
        SqliteOptions(
            read_only: true,
            create: true,
            foreign_keys: true,
            busy_timeout: Duration(seconds: 0),
            journal: SqliteJournal.default_mode
        );
        false;
    }
    catch e is InvalidSqliteOptions {
        true;
    });
    test.ok(try {
        SqliteOptions(
            read_only: false,
            create: true,
            foreign_keys: true,
            busy_timeout: Duration(microseconds: 500),
            journal: SqliteJournal.default_mode
        );
        false;
    }
    catch e is InvalidSqliteOptions {
        true;
    });
}

async test "queries read one row, maybe a row, a bounded list and a stream" {
    let connection = await SqliteMemory().connection();
    defer await connection.settled();
    defer connection.close();
    await connection.execution(Statement("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT)"));
    let inserted = await connection.execution(
        Statement(
            text: "INSERT INTO t(name) VALUES (?), (?), (?)",
            values: [DbText("a"), DbText("b"), DbText("c")]
        )
    );
    test.is(inserted.affected_rows().string(), "3");
    let all = await Query(
        origin: connection,
        statement: Statement("SELECT name FROM t ORDER BY id")
    ).all(10);
    let names is @string = all.map() -> row {
        row.text("name");
    };
    test.is(names, ["a", "b", "c"]);
    test.throws(QueryLimitExceeded) {
        await Query(origin: connection, statement: Statement("SELECT name FROM t")).all(2);
    };
    test.throws(InvalidQueryLimit) {
        await Query(origin: connection, statement: Statement("SELECT name FROM t")).all(-1);
    };
    let one = await Query(
        origin: connection,
        statement: Statement(text: "SELECT id FROM t WHERE name = ?", values: [DbText("b")])
    ).one();
    test.is(one.int("id"), 2);
    test.throws(TooManyRows) {
        await Query(origin: connection, statement: Statement("SELECT id FROM t")).one();
    };
    test.throws(NoRows) {
        await Query(origin: connection, statement: Statement("SELECT id FROM t WHERE id > 9")).one();
    };
    let missing = await Query(
        origin: connection,
        statement: Statement("SELECT id FROM t WHERE id > 9")
    ).maybe();
    test.is(missing == Maybe<Row>.none, true);
    let rows = await Query(
        origin: connection,
        statement: Statement("SELECT id FROM t ORDER BY id DESC")
    ).rows();
    test.is(rows.columns().first()::Parts::name, "id");
    let first = (await rows.next()) else panic "no first row";
    test.is(first.int("id"), 3);
    rows.close();
    test.is(rows.closed(), true);
}

async test "prepared statements, transactions and acquisitions" {
    let connection = await SqliteMemory().connection();
    defer await connection.settled();
    defer connection.close();
    await connection.execution(Statement("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT)"));
    let insert = await connection.prepared("INSERT INTO t(name) VALUES (?)");
    await insert.execution(DbText("a"));
    await insert.execution(DbText("b"));
    insert.close();
    test.is(insert.closed(), true);
    let lookup = await connection.prepared("SELECT name FROM t WHERE id = ?");
    test.is((await Query(prepared: lookup, values: [DbInteger(2)]).one()).text("name"), "b");
    lookup.close();

    let undone = await connection.transaction(TransactionOptions());
    await undone.execution(Statement(text: "INSERT INTO t(name) VALUES (?)", values: [DbText("x")]));
    await undone.rollback();
    test.is(undone.active(), false);
    test.throws(TransactionEnded) {
        await undone.execution(Statement("DELETE FROM t"));
    };
    let kept = await connection.transaction(TransactionOptions());
    await kept.execution(Statement(text: "INSERT INTO t(name) VALUES (?)", values: [DbText("c")]));
    await kept.commit();
    test.is(
        (await Query(origin: connection, statement: Statement("SELECT count(*) AS n FROM t")).one()).int(
            "n"
        ),
        3
    );

    let full = DbAcquisition(
        connection: connection,
        preparation: connection,
        transactions: connection
    );
    let prepared = await full.preparing().prepared("SELECT 1 AS one");
    test.is((await Query(prepared: prepared, values: []).one()).int("one"), 1);
    prepared.close();
}

async test "scripts, blobs and an online backup" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "db-sqlite-test-");
    let connection = await SqliteMemory().connection();
    defer await connection.settled();
    defer connection.close();
    let executions = await SqliteScript(
        origin: connection,
        source: "CREATE TABLE b(id INTEGER PRIMARY KEY, data BLOB); INSERT INTO b(data) VALUES (zeroblob(4));"
    ).executions();
    test.is(executions.size(), 2);
    let blob = await OpenedSqliteBlob(
        origin: connection,
        database: "main",
        table: "b",
        column: "data",
        row: BigInt(1),
        writable: true
    ).blob();
    test.is(blob.size(), 4);
    await blob.write(BigInt(1), [7.byte(), 8.byte()]);
    test.is(await blob.bytes(BigInt(0), 4), [0.byte(), 7.byte(), 8.byte(), 0.byte()]);
    blob.close();
    test.is(blob.closed(), true);
    let target = scratch.path().child("copy.db");
    let report = await SqliteBackup(
        origin: connection,
        target: target,
        pages: 8,
        clock: SystemClock(),
        timeout: Duration(seconds: 5)
    ).report();
    test.is(report.copies().string() == report.total().string(), true);
    let copy = await SqliteDatabase(path: target, options: SqliteOptions()).connection();
    test.is(
        (await Query(origin: copy, statement: Statement("SELECT hex(data) AS h FROM b")).one()).text(
            "h"
        ),
        "00070800"
    );
    copy.close();
    await copy.settled();
    let acquired = await PortableDbAcquiring(
        SqliteConnector(SqliteDatabase(path: target, options: SqliteOptions()))
    ).acquisition();
    test.throws(DbFailure) {
        acquired.preparing();
    };
    let found = await Query(
        origin: acquired.connection(),
        statement: Statement("SELECT count(*) AS n FROM b")
    ).one();
    test.is(found.int("n"), 1);
    acquired.connection().close();
    await acquired.connection().settled();
    scratch.close();
}

async test "a connection runs SQL with bound values and answers a query" {
    let db = await SqliteMemory().connection();
    defer await db.settled();
    defer db.close();
    await db.execution("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT)");
    let added = await db.execution(
        "INSERT INTO t(name) VALUES (?), (?)",
        DbText("a"),
        DbText("b; DROP TABLE t")
    );
    test.is(added.affected_rows().string(), "2");
    test.is(
        (await db.query("SELECT name FROM t WHERE id = ?", DbInteger(2)).one()).text("name"),
        "b; DROP TABLE t"
    );
    test.is(
        (await db.query("SELECT id FROM t WHERE id > ?", DbInteger(9)).maybe()) == Maybe<Row>.none,
        true
    );
    test.is((await db.query("SELECT id FROM t ORDER BY id").all(10)).size(), 2);
    let change = await db.transaction(TransactionOptions());
    await change.execution("DELETE FROM t WHERE id = ?", DbInteger(1));
    test.is((await change.query("SELECT count(*) AS n FROM t").one()).int("n"), 1);
    await change.rollback();
    test.is((await db.query("SELECT count(*) AS n FROM t").one()).int("n"), 2);
}
