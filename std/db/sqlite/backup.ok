module db/sqlite/backup v1.0.0;

// Online backups of a SQLite database to a file.
//
//     let report = await SqliteBackup(origin: db, target: Path("backup.db"), pages: 100,
//         clock: SystemClock(), timeout: Duration(seconds: 30)).report();
//     report.copies();                 // pages copied
//
// The copy runs pages at a time, so other work goes on between steps.

import "fs/path" take Path;
import "numbers/bigint" take BigInt;
import "time/clock" take Timing;
import "time/duration" take Duration;
import "compare" take Order;
import "time/clock" take SystemClock;
import "time/duration" take DurationUnit;

// Something that can back itself up.
role SqliteBackupMaking {
    // Copies to target, pages at a time, within timeout.
    async backup(target is Path, pages is int, clock is Timing, timeout is Duration) is BackupReport;
}

// A backup to run.
object SqliteBackup {
    has origin is SqliteBackupMaking;
    has target is Path;
    has pages is int;
    has clock is Timing;
    has timeout is Duration;

    // Backs origin up to target, pages per step (1-256), within timeout;
    // InvalidSqliteBackup otherwise.
    SqliteBackup(
        origin is SqliteBackupMaking,
        target is Path,
        pages is int,
        clock is Timing,
        timeout is Duration
    ) {
        confirm pages >= 1 && pages <= 256 && timeout::Span::seconds > 0.rat()
            else throw InvalidSqliteBackup.invalid;
        self.origin = origin;
        self.target = target;
        self.pages = pages;
        self.clock = clock;
        self.timeout = timeout;
    }

    // Runs it and says how much was copied.
    async report() is BackupReport {
        await origin.backup(target, pages, clock, timeout);
    }
}

// How much a backup copied.
object BackupReport {
    has copies, total is BigInt;

    // copies of total pages.
    BackupReport(copies is BigInt, total is BigInt) {
        confirm copies.order(BigInt(0)) != Order.less && total.order(copies) != Order.less
            else throw InvalidSqliteBackup.invalid;
        self.copies = copies;
        self.total = total;
    }

    // Pages copied.
    copies() is BigInt {
        copies;
    }

    // Pages in the database.
    total() is BigInt {
        total;
    }
}

// A backup that cannot be run as asked.
enum InvalidSqliteBackup is Error = (invalid);

hidden object CountingBackup does SqliteBackupMaking {
    CountingBackup();

    async backup(target is Path, pages is int, clock is Timing, timeout is Duration) is BackupReport {
        BackupReport(copies: BigInt(pages), total: BigInt(16));
    }
}

test "a backup report counts copied pages within the total" {
    let report = BackupReport(copies: BigInt(4), total: BigInt(16));
    test.is(report.copies().string(), "4");
    test.is(report.total().string(), "16");
    test.throws(InvalidSqliteBackup) {
        BackupReport(copies: BigInt(17), total: BigInt(16));
    };
    test.throws(InvalidSqliteBackup) {
        BackupReport(copies: BigInt(-1), total: BigInt(16));
    };
}

async test "a backup checks its step and timeout, then asks its source" {
    let second = Duration(seconds: 1);
    let report = await SqliteBackup(
        origin: CountingBackup(),
        target: Path("copy.db"),
        pages: 8,
        clock: SystemClock(),
        timeout: second
    ).report();
    test.is(report.copies().string(), "8");
    test.throws(InvalidSqliteBackup) {
        SqliteBackup(
            origin: CountingBackup(),
            target: Path("copy.db"),
            pages: 0,
            clock: SystemClock(),
            timeout: second
        );
    };
    test.throws(InvalidSqliteBackup) {
        SqliteBackup(
            origin: CountingBackup(),
            target: Path("copy.db"),
            pages: 257,
            clock: SystemClock(),
            timeout: second
        );
    };
    test.throws(InvalidSqliteBackup) {
        SqliteBackup(
            origin: CountingBackup(),
            target: Path("copy.db"),
            pages: 1,
            clock: SystemClock(),
            timeout: Duration(seconds: 0)
        );
    };
}
