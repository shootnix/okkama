module db/statement v1.0.0;

// Statements: SQL text with bound values, and what running one did.
//
//     let done = await db.execution(Statement(text: "DELETE FROM sessions WHERE expires < ?", values: [DbInteger(now)]));
//     done.affected() else BigInt(0);
//
// Statements are bounded by DbLimits: 1024 values, 8 MiB of values and 1 MiB of
// SQL by default. Most code passes SQL and values to execution() and query()
// directly.

import "db/value" take DbValue, ObservedDbValue;
import "runtime/db" as native_db;
import "db/error" take AffectedRowsUnknown;
import "collections/sequence" take Sequencing;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "numbers/bigint" take BigInt;
import "async/atomic" take Atomic;

// How large a statement may be.
object DbLimits {
    has values, bytes, sql_bytes is int;

    // 1024 values, 8 MiB of values, 1 MiB of SQL.
    DbLimits() {
        values = 1024;
        bytes = 8388608;
        sql_bytes = 1048576;
    }

    // The limits as given.
    DbLimits(values is int, bytes is int, sql_bytes is int) {
        confirm values >= 0
            && values <= 1024
            && bytes >= 0
            && bytes <= 8388608
            && sql_bytes >= 0
            && sql_bytes <= 1048576
            else throw DbBoundaryLimit.kind("invalid limits");
        self.values = values;
        self.bytes = bytes;
        self.sql_bytes = sql_bytes;
    }

    // Values, bytes of values and bytes of SQL.
    cap Limits {
        values is int {
            values;
        }

        bytes is int {
            bytes;
        }

        sql_bytes is int {
            sql_bytes;
        }
    }
}

// Values checked against the limits once.
object DbValueSnapshot {
    has origin is @DbValue;
    has cells is @native_db.DbCellState;

    // values within limits; DbBoundaryLimit beyond them.
    DbValueSnapshot(values is Sequencing<DbValue>, limits is DbLimits) {
        let count = values.size();
        confirm count >= 0 && count <= limits::Limits::values
            else throw DbBoundaryLimit.kind("value count");
        let used = Atomic(0);
        let snapshot is @ObservedDbValue = (0..count).map() -> index {
            let value = ObservedDbValue(values.item(index));
            let width = value.width();
            confirm width <= limits::Limits::bytes - used.value()
                else throw DbBoundaryLimit.kind("value bytes");
            used.replace(used.value() + width);
            value;
        };
        origin = snapshot.map() -> value {
            value.cell();
        };
        cells = snapshot.map() -> value {
            value.state();
        };
    }

    // The values.
    values() is @DbValue {
        origin;
    }

    // Their native cells.
    cells() is @native_db.DbCellState {
        cells;
    }
}

// SQL text and the values bound to its placeholders.
object Statement {
    has text is string;
    has values is @DbValue;
    has cells is @native_db.DbCellState;

    // SQL without values.
    Statement(text is string) {
        self.text = DbSqlText(origin: text, limits: DbLimits()).string();
        values = [];
        cells = [];
    }

    // SQL with values, within the default limits.
    Statement(text is string, values is Sequencing<DbValue>) {
        let limits = DbLimits();
        self.text = DbSqlText(origin: text, limits: limits).string();
        let snapshot = DbValueSnapshot(values: values, limits: limits);
        self.values = snapshot.values();
        cells = snapshot.cells();
    }

    // The same within limits.
    Statement(text is string, values is Sequencing<DbValue>, limits is DbLimits) {
        self.text = DbSqlText(origin: text, limits: limits).string();
        let snapshot = DbValueSnapshot(values: values, limits: limits);
        self.values = snapshot.values();
        cells = snapshot.cells();
    }

    // The SQL.
    text() is string {
        text;
    }

    // The values.
    values() is Sequencing<DbValue> {
        values;
    }

    // Their native cells.
    cells() is @native_db.DbCellState {
        cells;
    }
}

hidden object DbSqlText {
    has origin is string;

    DbSqlText(origin is string, limits is DbLimits) {
        confirm origin.length() <= limits::Limits::sql_bytes
            && Utf8Encoded(origin).bytes().size() <= limits::Limits::sql_bytes
            else throw DbBoundaryLimit.kind("SQL bytes");
        let stripped = origin.replace(" ", "").replace("\t", "").replace("\r", "").replace("\n", "");
        confirm stripped != "" && origin.split(Utf8Decoded([0.byte()]).string()).size() == 1
            else throw InvalidStatement.invalid;
        self.origin = origin;
    }

    string() is string {
        origin;
    }
}

// What a statement did.
object Execution {
    has count is Maybe<BigInt>;

    // Rows affected unknown.
    Execution() {
        count = Maybe.none;
    }

    // affected rows.
    Execution(affected is BigInt) {
        confirm affected.sign() >= 0 else throw InvalidExecution.invalid;
        count = Maybe.some(affected);
    }

    // The rows affected, or none when the database does not say.
    affected() is Maybe<BigInt> {
        count;
    }

    // Compatibility observations; new callers can use affected() with else/match.
    affected_known() is bool {
        count ?? .some(_): true !! .none: false;
    }

    // The count; AffectedRowsUnknown when it is not known.
    affected_rows() is BigInt {
        count else throw AffectedRowsUnknown.unknown;
    }
}

// A statement over a limit; kind says which.
enum DbBoundaryLimit is Error = (kind(kind is string));

// A statement that cannot be built.
enum InvalidStatement is Error = (invalid);

// An affected-row count that is not valid.
enum InvalidExecution is Error = (invalid);

test "statement parameters remain distinct from SQL text" {
    test.is(Statement("SELECT ?").text(), "SELECT ?");
    test.ok(!Execution().affected_known());
}
