module db/postgres/wire v1.0.0;

import "net/stream" take AsyncReading, AsyncWriting;
import "io/decorators" take ByteSnapshot;
import "io/buffer" take ByteBuffer;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "async/atomic" take Atomic;

// PostgreSQL frontend/backend protocol 3.0 framing, written in Okkama.
//
// Frontend messages are a type byte, a big-endian Int32 length that counts
// itself, and a body (the startup family omits the type byte). PgInput reads
// whole backend messages from a borrowed AsyncReading through one buffer and
// an offset, so each message costs its own size; a message longer than
// 1 GiB or a closed stream is PgWireFailure. Nothing here interprets message
// semantics: db/postgres owns the conversation.
object PgInt32 {
    has value is int;
    PgInt32(value is int) { self.value = value; }
    bytes() is @byte {
        [((value >> 24) & 255).byte(), ((value >> 16) & 255).byte(), ((value >> 8) & 255).byte(), (value & 255).byte()];
    }
}

object PgInt16 {
    has value is int;
    PgInt16(value is int) { self.value = value; }
    bytes() is @byte { [((value >> 8) & 255).byte(), (value & 255).byte()]; }
}

object PgCString {
    has text is string;
    PgCString(text is string) { self.text = text; }
    bytes() is @byte { @byte(Utf8Encoded(text).bytes()..., 0.byte()); }
}

// One frontend message with a type byte.
object PgFrame {
    has kind is byte;
    has body is @byte;
    PgFrame(kind is string, body is @byte) {
        self.kind = Utf8Encoded(kind).bytes()[0];
        self.body = body;
    }
    bytes() is @byte { @byte(kind, PgInt32(body.size() + 4).bytes()..., body...); }
}

// Startup-family message without a type byte (StartupMessage, SSLRequest).
object PgUntypedFrame {
    has body is @byte;
    PgUntypedFrame(body is @byte) { self.body = body; }
    bytes() is @byte { @byte(PgInt32(body.size() + 4).bytes()..., body...); }
}

// One backend message: type character and body.
object PgMessage {
    has kind is string;
    has body is @byte;
    PgMessage(kind is string, body is @byte) {
        self.kind = kind;
        self.body = body;
    }
    kind() is string { kind; }
    body() is @byte { body; }
    fields() is PgFields { PgFields(body); }
}

// Sequential reader of one message body.
object PgFields {
    has body is @byte;
    has position is Atomic<int>;
    PgFields(body is @byte) {
        self.body = body;
        position = Atomic(0);
    }
    remaining() is int { body.size() - position.value(); }
    take(count is int) is @byte {
        let start = position.value();
        confirm count >= 0 && start + count <= body.size() else throw PgWireFailure("message body is truncated");
        position.replace(start + count);
        body.slice(start, start + count);
    }
    byte() is int { self.take(1)[0].int(); }
    int16() is int {
        let raw = self.take(2);
        let value = (raw[0].int() << 8) | raw[1].int();
        if value >= 32768 { value - 65536; } else { value; }
    }
    int32() is int {
        let raw = self.take(4);
        let value = (raw[0].int() << 24) | (raw[1].int() << 16) | (raw[2].int() << 8) | raw[3].int();
        if value >= 2147483648 { value - 4294967296; } else { value; }
    }
    cstring() is string {
        let start = position.value();
        let end = PgZero(body, start).index();
        position.replace(end + 1);
        Utf8Decoded(body.slice(start, end)).string();
    }
    rest() is @byte { self.take(self.remaining()); }
}

// Internal: index of the NUL terminator at or after `start`.
object PgZero {
    has body is @byte;
    has start is int;
    PgZero(body is @byte, start is int) { self.body = body; self.start = start; }
    index() is int {
        let found = Atomic(-1);
        let position = Atomic(start);
        loop {
            let at = position.value();
            if at >= body.size() { last; }
            if body[at] == 0.byte() { found.replace(at); last; }
            position.replace(at + 1);
        }
        confirm found.value() >= 0 else throw PgWireFailure("unterminated string in message");
        found.value();
    }
}

// Buffered backend message reader over a borrowed stream.
object PgInput {
    has source is AsyncReading;
    has buffer is Atomic<@byte>;
    has position is Atomic<int>;
    PgInput(source is AsyncReading) {
        self.source = source;
        let empty is @byte = [];
        buffer = Atomic(empty);
        position = Atomic(0);
    }

    available() is int { buffer.value().size() - position.value(); }

    // Unread bytes plus every chunk needed for `count` are joined once, so a
    // large message costs its size rather than its size times its chunks.
    async ensure(count is int) is void {
        if self.available() >= count { return; }
        let current = buffer.value();
        let gathered = ByteBuffer(current.slice(position.value(), current.size()));
        defer gathered.closing().close();
        let output = gathered.writing();
        let size = Atomic(current.size() - position.value());
        loop {
            if size.value() >= count { last; }
            let chunk = await source.bytes(65536);
            confirm chunk.size() > 0 else throw PgWireFailure("server closed the connection");
            output.write(ByteSnapshot(chunk));
            size.replace(size.value() + chunk.size());
        }
        buffer.replace(gathered.content().bytes());
        position.replace(0);
    }

    take(count is int) is @byte {
        let start = position.value();
        position.replace(start + count);
        buffer.value().slice(start, start + count);
    }

    // One byte, without framing (SSLRequest answer).
    async single() is int {
        await self.ensure(1);
        self.take(1)[0].int();
    }

    // A whole message already in the buffer, without awaiting: empty when
    // more bytes are needed. Hot loops try this before message().
    buffered() is @PgMessage {
        let start = position.value();
        let data = buffer.value();
        if data.size() - start < 5 { return []; }
        let length = (data[start + 1].int() << 24) | (data[start + 2].int() << 16) | (data[start + 3].int() << 8) | data[start + 4].int();
        confirm length >= 4 && length <= 1073741824 else throw PgWireFailure("invalid message length");
        if data.size() - start < length + 1 { return []; }
        position.replace(start + length + 1);
        [PgMessage(Utf8Decoded([data[start]]).string(), data.slice(start + 5, start + length + 1))];
    }

    async message() is PgMessage {
        let ready = self.buffered();
        if ready.size() == 1 { return ready[0]; }
        await self.ensure(5);
        let header = self.take(5);
        let length = (header[1].int() << 24) | (header[2].int() << 16) | (header[3].int() << 8) | header[4].int();
        confirm length >= 4 && length <= 1073741824 else throw PgWireFailure("invalid message length");
        await self.ensure(length - 4);
        PgMessage(Utf8Decoded([header[0]]).string(), self.take(length - 4));
    }
}

// Concatenation of byte runs through one native buffer.
object PgJoined {
    has parts is @@byte;
    PgJoined(parts is @@byte) { self.parts = parts; }
    bytes() is @byte {
        let joined = ByteBuffer();
        defer joined.closing().close();
        let output = joined.writing();
        for parts -> part { output.write(ByteSnapshot(part)); }
        joined.content().bytes();
    }
}

object PgOutput {
    has sink is AsyncWriting;
    PgOutput(sink is AsyncWriting) { self.sink = sink; }
    async send(bytes is @byte) is void { await sink.write(ByteSnapshot(bytes)); }
}

object PgWireFailure does Error {
    has reason is string;
    PgWireFailure(reason is string) { self.reason = reason; }
    reason() is string { reason; }
    text() is string { "PostgreSQL protocol failure: " + reason; }
}

test "frames carry big-endian self-inclusive lengths" {
    test.is(PgFrame("Q", PgCString("SELECT 1").bytes()).bytes().slice(0, 5), [81.byte(), 0.byte(), 0.byte(), 0.byte(), 13.byte()]);
    test.is(PgUntypedFrame(PgInt32(80877103).bytes()).bytes(), [0.byte(), 0.byte(), 0.byte(), 8.byte(), 4.byte(), 210.byte(), 22.byte(), 47.byte()]);
    test.is(PgInt16(-1).bytes(), [255.byte(), 255.byte()]);
}

test "joined runs keep order and boundaries" {
    test.is(PgJoined([[1.byte()], [], [2.byte(), 3.byte()]]).bytes(), [1.byte(), 2.byte(), 3.byte()]);
    let empty is @@byte = [];
    test.is(PgJoined(empty).bytes().size(), 0);
}

test "fields decode integers and strings" {
    let fields = PgFields(@byte(PgInt32(-2).bytes()..., PgCString("ok").bytes()..., PgInt16(7).bytes()...));
    test.is(fields.int32(), -2);
    test.is(fields.cstring(), "ok");
    test.is(fields.int16(), 7);
    test.is(fields.remaining(), 0);
    test.ok(try { fields.byte(); false; } catch e is PgWireFailure { true; });
}
