module db/postgres v1.0.0;

import "db/statement" take DbLimits;

import "db/postgres/wire" take PgInt32, PgInt16, PgCString, PgFrame, PgUntypedFrame, PgMessage,
    PgFields, PgInput, PgOutput, PgJoined, PgDataRows, PgWireFailure;
import "db/postgres/auth" take ScramExchange, Md5Password, ScramFailure;
import "db/connection" take DbConnection, DbExecuting, DbConnecting;
import "db/prepared" take DbPreparing, PreparedStatement, DbPreparedOpening, DbPreparedTransaction;
import "db/acquisition" take DbAcquiring, DbAcquisition;
import "db/transaction" take Transaction, TransactionOptions, Isolation;
import "db/statement" take Statement, Execution;
import "db/row" take DbRowSchema, DbRowData, Row, Column, RowReading, RowsEnded;
import "db/value" take DbValue, DbValueKind, ObservedDbValue, DbNull, DbBoolean, DbInteger,
    DbFloating, DbDecimal, DbText, DbBytes;
import "db/error" take DbFailure, DbFailureKind, DbOperation, DbClosed, DbBusy, TransactionEnded,
    IndeterminateCommit;
import "net/tcp" take TcpConnecting, TcpOptions;
import "net/tls" take TlsClientHandshake, TlsClientPolicy;
import "net/endpoint" take IpEndpoint;
import "crypto/x509/trust" take CertificateIdentity;
import "crypto/secret" take SecretBytes;
import "crypto/nonce" take Entropy, RandomNonce;
import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "encoding/base64" take Base64Encoded;
import "io/stream" take AsyncReading, AsyncWriting, Closing;
import "numbers/bigint" take BigInt;
import "math/decimal" take Decimal;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/lock" take Lock;
import "runtime/db" as native_db;
import "runtime/postgres" as native_pg;
import "db/read" take DbPage;
import "cell" take Cell;

// PostgreSQL driver over the frontend/backend protocol 3.0, written in
// Okkama: framing (db/postgres/wire), SCRAM-SHA-256 and MD5 (db/postgres/auth)
// and the conversation below. The host supplies only TCP, TLS and crypto.
//
//     let database = PostgresDatabase(
//         PostgresTcp(IpEndpoint(IpAddress("127.0.0.1"), 5432)),
//         PostgresCredentials("app", SecretBytes(Utf8Encoded("secret").bytes())),
//         PostgresOptions("app"),
//         SystemEntropy());
//     let connection = await database.connection();
//     let rows = await connection.rows(Statement("SELECT id, name FROM users WHERE id = $1", [DbInteger(BigInt("7"))]));
//
// Every statement goes through the extended query protocol, so parameters
// never become SQL text and one Statement is one SQL command. Placeholders are
// PostgreSQL's own $1..$n. Parameters are sent untyped (OID 0): the server
// infers each type from its context, and a context-free parameter needs an
// explicit cast ($1::int8). Text, integer, floating and decimal values travel
// as text literals, booleans as true/false, bytes in binary format.
//
// Results come back in text format and decode by column type: bool as
// DbBoolean, int2/int4/int8/oid as DbInteger, float4/float8 as DbFloating,
// numeric as DbDecimal, bytea as DbBytes; NaN and infinities are a data
// failure, every other type (dates, json, uuid, arrays...) is DbText.
// Column.declaration() is the type name (int4, text...) or "oid:<n>".
//
// A query is one round trip: Bind, Execute without a row limit and Sync go
// out together, and the server streams the whole answer through
// ReadyForQuery. The reader decodes it `batch` rows at a time as it is read
// from the socket, so TCP flow control bounds what is buffered. While a row
// reader is open the connection is busy; closing it early discards the rest
// of the answer on the next operation (the server has computed it anyway).
// Only one operation runs at a time per connection.
//
// Authentication accepts trust and SCRAM-SHA-256 (no channel binding); MD5
// and cleartext passwords are refused unless PostgresOptions enables them.
// SCRAM requires the server's final signature before AuthenticationOk.
// PostgresTls sends SSLRequest and verifies the server certificate; PostgresTcp
// is plaintext. Server diagnostics surface as DbFailure with the SQLSTATE as
// code and a driver-written message (server text may echo bindings).
object PostgresCredentials {
    has user is string;
    has password is @SecretBytes;

    PostgresCredentials(user is string) {
        confirm user != "" && user.split(Utf8Decoded([0.byte()]).string()).size() == 1
            else throw InvalidPostgresOptions.because("user must be nonempty without NUL");
        self.user = user;
        password = [];
    }

    PostgresCredentials(user is string, password is SecretBytes) {
        confirm user != "" && user.split(Utf8Decoded([0.byte()]).string()).size() == 1
            else throw InvalidPostgresOptions.because("user must be nonempty without NUL");
        self.user = user;
        self.password = [password];
    }

    has_password() is bool {
        password.size() == 1;
    }

    password() is SecretBytes {
        confirm password.size() == 1
            else throw DbFailure.detailed(
                DbFailureKind.permission,
                DbOperation.connecting,
                "PG_PASSWORD_REQUIRED",
                "server requested a password but none was supplied"
            );
        password[0];
    }

    cap Credentials {
        user is string {
            user;
        }
    }
}

object PostgresOptions {
    has database, application is string;
    has md5, cleartext is bool;
    has batch is int;

    PostgresOptions(database is string) {
        confirm database != ""
            else throw InvalidPostgresOptions.because("database must be nonempty");
        self.database = database;
        application = "okkama";
        md5 = false;
        cleartext = false;
        batch = 256;
    }

    PostgresOptions(
        database is string,
        application is string,
        md5 is bool,
        cleartext is bool,
        batch is int
    ) {
        confirm database != ""
            else throw InvalidPostgresOptions.because("database must be nonempty");
        confirm batch >= 1 && batch <= 65536
            else throw InvalidPostgresOptions.because("batch must be 1..65536 rows");
        self.database = database;
        self.application = application;
        self.md5 = md5;
        self.cleartext = cleartext;
        self.batch = batch;
    }

    cap Settings {
        database is string {
            database;
        }

        application is string {
            application;
        }

        md5 is bool {
            md5;
        }

        cleartext is bool {
            cleartext;
        }

        batch is int {
            batch;
        }
    }
}

// Byte transport of one connection: the startup conversation and everything
// after it run over input/output; close() ends the connection. A transport
// with a cancel route lets the session stop a long answer whose reader
// closed early (#240); without one, the rest of that answer is read through.
object PgTransport does Closing {
    has input is AsyncReading;
    has output is AsyncWriting;
    has origin is Closing;
    has cancel is PgCancelRoute;

    PgTransport(input is AsyncReading, output is AsyncWriting, origin is Closing) {
        self.input = input;
        self.output = output;
        self.origin = origin;
        cancel = PgNoCancelRoute();
    }

    PgTransport(
        input is AsyncReading,
        output is AsyncWriting,
        origin is Closing,
        cancel is PgCancelRoute
    ) {
        self.input = input;
        self.output = output;
        self.origin = origin;
        self.cancel = cancel;
    }

    input() is AsyncReading {
        input;
    }

    output() is AsyncWriting {
        output;
    }

    cancel_route() is PgCancelRoute {
        cancel;
    }

    closed() is bool {
        origin.closed();
    }

    close() is void {
        origin.close();
    }
}

// Where a CancelRequest for this connection's backend goes: a separate
// connection to the same server (protocol "Canceling Requests in Progress").
// cancel() returns once the server has taken the request, so a later
// statement on the connection can no longer be hit by it.
role PgCancelRoute {
    routed() is bool;
    async cancel(process is int, secret is @byte) is void;
}

hidden object PgNoCancelRoute does PgCancelRoute {
    PgNoCancelRoute();

    routed() is bool {
        false;
    }

    async cancel(process is int, secret is @byte) is void {}
}

// A plain TCP connection to the server's endpoint; the server reads a cancel
// packet before TLS and authentication, as libpq relies on.
hidden object PgCancelTcp does PgCancelRoute {
    has endpoint is IpEndpoint;

    PgCancelTcp(endpoint is IpEndpoint) {
        self.endpoint = endpoint;
    }

    routed() is bool {
        true;
    }

    async cancel(process is int, secret is @byte) is void {
        let tcp = await TcpConnecting(remote: endpoint, options: TcpOptions(true, true)).connection();
        defer tcp.close();
        await PgOutput(tcp.output()).send(
            PgUntypedFrame(
                @byte(PgInt32(80877102).bytes()..., PgInt32(process).bytes()..., secret...)
            ).bytes()
        );
        // The server answers nothing and closes the connection once the
        // backend has been signalled.
        loop {
            last if (await tcp.input().bytes(64)).size() == 0;
        }
    }
}

role PostgresTransporting {
    async transport() is PgTransport;
}

object PostgresTcp does PostgresTransporting {
    has endpoint is IpEndpoint;

    PostgresTcp(endpoint is IpEndpoint) {
        self.endpoint = endpoint;
    }

    async transport() is PgTransport {
        let tcp = await TcpConnecting(remote: endpoint, options: TcpOptions(true, true)).connection();
        PgTransport(input: tcp.input(), output: tcp.output(), origin: tcp, cancel: PgCancelTcp(endpoint));
    }
}

// SSLRequest, then a verified TLS handshake. A server that answers 'N' is a
// connection failure: there is no silent plaintext fallback.
object PostgresTls does PostgresTransporting {
    has endpoint is IpEndpoint;
    has server is CertificateIdentity;
    has policy is TlsClientPolicy;

    PostgresTls(endpoint is IpEndpoint, server is CertificateIdentity, policy is TlsClientPolicy) {
        self.endpoint = endpoint;
        self.server = server;
        self.policy = policy;
    }

    async transport() is PgTransport {
        let tcp = await TcpConnecting(remote: endpoint, options: TcpOptions(true, true)).connection();
        let published = Event();
        let anchor = PgTransportUnpublished(origin: tcp, published: published);
        defer anchor.close();
        await PgOutput(tcp.output()).send(PgUntypedFrame(PgInt32(80877103).bytes()).bytes());
        let answer = await tcp.input().bytes(1);
        confirm answer.size() == 1 && answer[0] == 83.byte()
            else throw DbFailure.detailed(
                DbFailureKind.connection,
                DbOperation.connecting,
                "PG_TLS_REFUSED",
                "PostgreSQL server refused TLS"
            );
        let tls = await TlsClientHandshake(origin: tcp, server: server, policy: policy).connection();
        published.set();
        PgTransport(input: tls.input(), output: tls.output(), origin: tls, cancel: PgCancelTcp(endpoint));
    }
}

hidden object PgTransportUnpublished {
    has origin is Closing;
    has published is Event;

    PgTransportUnpublished(origin is Closing, published is Event) {
        self.origin = origin;
        self.published = published;
    }

    close() is void {
        if !published.ready() {
            origin.close();
        }
    }
}

object PostgresDatabase {
    has transport is PostgresTransporting;
    has credentials is PostgresCredentials;
    has options is PostgresOptions;
    has entropy is Entropy;

    PostgresDatabase(
        transport is PostgresTransporting,
        credentials is PostgresCredentials,
        options is PostgresOptions,
        entropy is Entropy
    ) {
        self.transport = transport;
        self.credentials = credentials;
        self.options = options;
        self.entropy = entropy;
    }

    options() is PostgresOptions {
        options;
    }

    async connection() is PostgresConnection {
        let channel = await transport.transport();
        let published = Event();
        let anchor = PgTransportUnpublished(origin: channel, published: published);
        defer anchor.close();
        let input = PgInput(channel.input());
        let output = PgOutput(channel.output());
        await output.send(PgStartupMessage(user: credentials::Credentials::user, options: options).bytes());
        await PgAuthentication(input: input, output: output, credentials: credentials, options: options, entropy: entropy).completed();
        let version = Atomic("");
        let status = Atomic("");
        let process = Atomic(0);
        let secret is Atomic<@byte> = Atomic(@byte());
        loop {
            let message = await input.message();
            let kind = message.kind();
            if kind == "Z" {
                status.replace(Utf8Decoded(message.body()).string());
                last;
            }
            if kind == "E" {
                throw PgError(message: message, operation: DbOperation.connecting).failure();
            }
            if kind == "S" {
                let fields = message.fields();
                let name = fields.cstring();
                let value = fields.cstring();
                if name == "server_version" {
                    version.replace(value);
                }
            }
            if kind == "K" {
                // BackendKeyData: the process id and the secret key a
                // CancelRequest must quote (#240).
                let fields = message.fields();
                process.replace(fields.int32());
                secret.replace(fields.take(fields.remaining()));
            }
            confirm kind == "Z" || kind == "S" || kind == "K" || kind == "N"
                else throw PgWireFailure.because("unexpected message after authentication");
        }
        let connection = PostgresConnection(
            PgSession(
                transport: channel,
                input: input,
                output: output,
                batch: options::Settings::batch,
                version: version.value(),
                status: status.value(),
                process: process.value(),
                secret: secret.value()
            )
        );
        published.set();
        connection;
    }
}

// Explicit adapters: a pool sees only the portable capabilities.
object PostgresConnector does DbConnecting {
    has origin is PostgresDatabase;

    PostgresConnector(origin is PostgresDatabase) {
        self.origin = origin;
    }

    async connection() is DbConnection {
        await origin.connection();
    }
}

object PostgresAcquiring does DbAcquiring {
    has origin is PostgresDatabase;

    PostgresAcquiring(origin is PostgresDatabase) {
        self.origin = origin;
    }

    async acquisition() is DbAcquisition {
        let connection = await origin.connection();
        DbAcquisition(connection: connection, preparation: connection, transactions: connection);
    }
}

hidden object PgStartupMessage {
    has user is string;
    has options is PostgresOptions;

    PgStartupMessage(user is string, options is PostgresOptions) {
        self.user = user;
        self.options = options;
    }

    bytes() is @byte {
        let pairs is @string = [
            "user",
            user,
            "database",
            options::Settings::database,
            "application_name",
            options::Settings::application,
            "client_encoding",
            "UTF8",
            "DateStyle",
            "ISO",
            "bytea_output",
            "hex",
            "extra_float_digits",
            "3"
        ];
        let encoded is @@byte = pairs.map() -> part {
            PgCString(part).bytes();
        };
        PgUntypedFrame(@byte(PgInt32(196608).bytes()..., PgJoined(encoded).bytes()..., 0.byte())).bytes();
    }
}

hidden object PgAuthentication {
    has input is PgInput;
    has output is PgOutput;
    has credentials is PostgresCredentials;
    has options is PostgresOptions;
    has entropy is Entropy;

    PgAuthentication(
        input is PgInput,
        output is PgOutput,
        credentials is PostgresCredentials,
        options is PostgresOptions,
        entropy is Entropy
    ) {
        self.input = input;
        self.output = output;
        self.credentials = credentials;
        self.options = options;
        self.entropy = entropy;
    }

    async completed() is void {
        let scram = Atomic(false);
        loop {
            let fields = await self.request();
            let code = fields.int32();
            if code == 0 {
                last;
            }
            confirm !scram.value()
                else throw PgWireFailure.because("authentication continued after SCRAM completed");
            if code == 3 {
                confirm options::Settings::cleartext
                    else throw PgDisabledMethod("cleartext password").failure();
                await output.send(
                    PgFrame(kind: "p", body: @byte(credentials.password().export_bytes()..., 0.byte())).bytes()
                );
            }
            if code == 5 {
                confirm options::Settings::md5 else throw PgDisabledMethod("MD5 password").failure();
                let salt = fields.take(4);
                let response = Md5Password(user: credentials::Credentials::user, password: credentials.password(), salt: salt).string();
                await output.send(PgFrame(kind: "p", body: PgCString(response).bytes()).bytes());
            }
            if code == 10 {
                await self.scram(fields);
                scram.replace(true);
            }
            confirm code == 3 || code == 5 || code == 10
                else throw DbFailure.detailed(
                    DbFailureKind.unsupported,
                    DbOperation.connecting,
                    "PG_AUTH_METHOD",
                    "unsupported PostgreSQL authentication request " + code.string()
                );
        }
    }

    // Next authentication request; ErrorResponse is the server's refusal.
    async request() is PgFields {
        let message = await input.message();
        if message.kind() == "E" {
            throw PgError(message: message, operation: DbOperation.connecting).failure();
        }
        confirm message.kind() == "R"
            else throw PgWireFailure.because("expected an authentication request");
        message.fields();
    }

    async scram(offer is PgFields) is void {
        let mechanisms is @string = PgMechanisms(offer).names();
        let offered is @string = mechanisms.filter() -> name {
            name == "SCRAM-SHA-256";
        };
        confirm offered.size() == 1
            else throw DbFailure.detailed(
                DbFailureKind.unsupported,
                DbOperation.connecting,
                "PG_AUTH_METHOD",
                "server offers no SCRAM-SHA-256"
            );
        let nonce = Base64Encoded(RandomNonce(entropy: entropy, size: 18).bytes()).string();
        let exchange = try {
            ScramExchange(user: "", password: credentials.password(), nonce: nonce);
        }
        catch e is ScramFailure {
            throw PgScramRefused(e).failure();
        };
        let first = Utf8Encoded(exchange.client_first()).bytes();
        await output.send(
            PgFrame(
                kind: "p",
                body: @byte(
                    PgCString("SCRAM-SHA-256").bytes()...,
                    PgInt32(first.size()).bytes()...,
                    first...
                )
            ).bytes()
        );
        let challenge = await self.request();
        confirm challenge.int32() == 11 else throw PgWireFailure.because("expected SASLContinue");
        let server_first = Utf8Decoded(challenge.rest()).string();
        let proof = try {
            exchange.client_final(server_first);
        }
        catch e is ScramFailure {
            throw PgScramRefused(e).failure();
        };
        await output.send(PgFrame(kind: "p", body: Utf8Encoded(proof).bytes()).bytes());
        let outcome = await self.request();
        confirm outcome.int32() == 12 else throw PgWireFailure.because("expected SASLFinal");
        let verified = try {
            exchange.server_verified(server_first, Utf8Decoded(outcome.rest()).string());
        }
        catch e is ScramFailure {
            throw PgScramRefused(e).failure();
        };
        confirm verified
            else throw DbFailure.detailed(
                DbFailureKind.permission,
                DbOperation.connecting,
                "PG_SCRAM_SERVER",
                "PostgreSQL server signature is invalid"
            );
    }
}

hidden object PgMechanisms {
    has origin is PgFields;

    PgMechanisms(origin is PgFields) {
        self.origin = origin;
    }

    names() is @string {
        let names = Cell(@string());
        loop {
            let name = origin.cstring();
            if name == "" {
                last;
            }
            names.replace(@string(names.value()..., name));
        }
        names.value();
    }
}

hidden object PgDisabledMethod {
    has method is string;

    PgDisabledMethod(method is string) {
        self.method = method;
    }

    failure() is DbFailure {
        DbFailure.detailed(
            DbFailureKind.permission,
            DbOperation.connecting,
            "PG_AUTH_DISABLED",
            "server requested " + method + " authentication, which PostgresOptions does not enable"
        );
    }
}

hidden object PgScramRefused {
    has origin is ScramFailure;

    PgScramRefused(origin is ScramFailure) {
        self.origin = origin;
    }

    failure() is DbFailure {
        DbFailure.detailed(
            DbFailureKind.permission,
            DbOperation.connecting,
            "PG_SCRAM",
            origin.text()
        );
    }
}

object PostgresConnection does DbConnection, DbExecuting, DbPreparing, DbPreparedOpening, Closing {
    has origin is PgSession;

    PostgresConnection(origin is PgSession) {
        self.origin = origin;
    }

    async execution(statement is Statement) is Execution {
        await origin.execution(statement, 0);
    }

    async rows(statement is Statement) is RowReading {
        await origin.rows(statement, 0);
    }

    async transaction(options is TransactionOptions) is Transaction {
        await origin.begin(options);
    }

    async prepared(text is string) is PreparedStatement {
        await origin.prepare(text, 0);
    }

    async prepared_transaction(options is TransactionOptions) is DbPreparedTransaction {
        let transaction = await origin.begin(options);
        DbPreparedTransaction(origin: transaction, preparation: transaction);
    }

    server_version() is string {
        origin.server_version();
    }

    closed() is bool {
        origin.closed();
    }

    close() is void {
        origin.close();
    }

    async settled() is bool {
        true;
    }

    destroy {
        origin.close();
    }
}

// One protocol conversation. Every operation holds the lock, first resolves
// work left by closed readers, statements and abandoned transactions, and
// reads the server's answer through ReadyForQuery before releasing it. An
// operation interrupted mid-conversation (cancellation, transport failure)
// closes the connection, since the protocol position is then unknown.
object PgSession does Closing {
    has transport is PgTransport;
    has input is PgInput;
    has output is PgOutput;
    has batch is int;
    has version is string;
    has lock is Lock;
    has stopped is Event;
    has status is Atomic<string>;
    has serial, reader, transaction is Atomic<int>;
    has reader_statement is Atomic<string>;
    has streaming, rollback is Atomic<bool>;
    has closing, transaction_prepared is Atomic<@string>;
    // BackendKeyData of the server process; 0 and empty when the server sent none.
    has process is int = 0;
    has secret is @byte = @byte();

    PgSession(
        transport is PgTransport,
        input is PgInput,
        output is PgOutput,
        batch is int,
        version is string,
        status is string,
        process is int,
        secret is @byte
    ) {
        self.transport = transport;
        self.input = input;
        self.output = output;
        self.batch = batch;
        self.version = version;
        self.process = process;
        self.secret = secret;
        lock = Lock();
        stopped = Event();
        self.status = Atomic(status);
        serial = Atomic(0);
        reader = Atomic(0);
        transaction = Atomic(0);
        reader_statement = Atomic("");
        streaming = Atomic(false);
        rollback = Atomic(false);
        closing = Atomic(@string());
        transaction_prepared = Atomic(@string());
    }

    PgSession(
        transport is PgTransport,
        input is PgInput,
        output is PgOutput,
        batch is int,
        version is string,
        status is string
    ) {
        self.transport = transport;
        self.input = input;
        self.output = output;
        self.batch = batch;
        self.version = version;
        lock = Lock();
        stopped = Event();
        self.status = Atomic(status);
        serial = Atomic(0);
        reader = Atomic(0);
        transaction = Atomic(0);
        reader_statement = Atomic("");
        streaming = Atomic(false);
        rollback = Atomic(false);
        closing = Atomic(@string());
        transaction_prepared = Atomic(@string());
    }

    server_version() is string {
        version;
    }

    closed() is bool {
        stopped.ready() || transport.closed();
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            try {
                transport.close();
            }
            catch e is Error {}
        }
    }

    async send(bytes is @byte, operation is DbOperation) is void {
        try {
            await output.send(bytes);
        }
        catch e is Cancelled {
            self.close();
            throw;
        }
        catch e is Error {
            self.close();
            throw PgLost(operation).failure();
        }
    }

    // A message already buffered, without a task switch; empty when the
    // next one must be awaited. Row streaming lives on this path.
    buffered(operation is DbOperation) is @PgMessage {
        try {
            input.buffered();
        }
        catch e is Error {
            self.close();
            throw PgLost(operation).failure();
        }
    }

    // DataRow messages already buffered, raw (see PgInput.data_rows).
    data_rows(operation is DbOperation, limit is int) is PgDataRows {
        try {
            input.data_rows(limit);
        }
        catch e is Error {
            self.close();
            throw PgLost(operation).failure();
        }
    }

    async message(operation is DbOperation) is PgMessage {
        try {
            await input.message();
        }
        catch e is Cancelled {
            self.close();
            throw;
        }
        catch e is Error {
            self.close();
            throw PgLost(operation).failure();
        }
    }

    next_id() is int {
        let id = serial.value() + 1;
        serial.replace(id);
        id;
    }

    // Messages through ReadyForQuery after a Sync or simple Query.
    async ready(operation is DbOperation) is PgOutcome {
        await self.through_ready(PgOutcome(operation));
    }

    async through_ready(outcome is PgOutcome) is PgOutcome {
        loop {
            let ready = self.buffered(outcome.operation());
            let message = if ready.size() == 1 {
                ready[0];
            }
            else {
                await self.message(outcome.operation());
            };
            if message.kind() == "Z" {
                status.replace(Utf8Decoded(message.body()).string());
                last;
            }
            if self.observe(message, outcome) {
                await self.refuse_copy(outcome.operation());
            }
        }
        outcome;
    }

    // The next `batch` rows of a streaming answer, or the rest of it up to
    // its end; an ended answer is read through ReadyForQuery (its request
    // carried Sync). Otherwise the rest stays on the wire for the next
    // portion, or for settle to discard when the reader closes early.
    async portion(operation is DbOperation, outcome is PgOutcome) is PgOutcome {
        loop {
            outcome.data_rows(self.data_rows(operation, batch - outcome.rows()));
            last if outcome.rows() >= batch;
            let ready = self.buffered(operation);
            let message = if ready.size() == 1 {
                ready[0];
            }
            else {
                await self.message(operation);
            };
            let kind = message.kind();
            if self.observe(message, outcome) {
                await self.refuse_copy(operation);
            }
            if kind == "C" || kind == "I" || kind == "E" {
                outcome.end();
                last;
            }
        }
        streaming.replace(!outcome.ended());
        if outcome.ended() {
            await self.through_ready(outcome);
        }
        outcome;
    }

    // The rest of an answer whose reader closed early, discarded through
    // ReadyForQuery. Its failures belong to nobody; fatal ones still close
    // the connection. Past 8192 rows or 1 MiB of discarded rows, a transport
    // with a cancel route asks the server to stop the statement (#240): the
    // short remainder then ends with SQLSTATE 57014, which is dropped like any
    // other failure here.
    async drain(operation is DbOperation) is void {
        let outcome = PgOutcome(operation);
        let rows = Atomic(0);
        let bytes = Atomic(0);
        let asked = Atomic(false);
        defer rows.close();
        defer bytes.close();
        defer asked.close();
        loop {
            let run = self.data_rows(operation, 1073741824);
            rows.replace(rows.value() + run.count());
            bytes.replace(bytes.value() + run.bytes().size());
            if !asked.value()
                && (rows.value() > 8192 || bytes.value() > 1048576)
                && process != 0
                && transport.cancel_route().routed() {
                    asked.replace(true);
                    // A failed cancel only means the rest is read through.
                    try {
                        await transport.cancel_route().cancel(process, secret);
                    }
                    catch e is Cancelled {
                        throw;
                    }
                    catch e is Error {}
                }
            let ready = self.buffered(operation);
            let message = if ready.size() == 1 {
                ready[0];
            }
            else {
                await self.message(operation);
            };
            let kind = message.kind();
            if kind == "Z" {
                status.replace(Utf8Decoded(message.body()).string());
                last;
            }
            if kind != "D" {
                self.observe(message, outcome);
            }
        }
        streaming.replace(false);
    }

    // Records one message; true when the server awaits COPY data, which the
    // caller refuses with CopyFail.
    observe(message is PgMessage, outcome is PgOutcome) is bool {
        let kind = message.kind();
        match kind {
            case "C" {
                outcome.tag(message.fields().cstring());
            }
            case "D" {
                outcome.row(message.body());
            }
            case "T" {
                outcome.describe(PgDescription(message.fields()));
            }
            case "t" {
                outcome.parameters(message.fields().int16());
            }
            case "E" {
                let failure = PgError(message: message, operation: outcome.operation());
                if failure.fatal() {
                    self.close();
                    throw failure.failure();
                }
                outcome.fail(failure.failure());
            }
            case "G" {
                outcome.copied();
            }
            case "H" {
                outcome.copied();
            }
            else {
                let ignored is @string = ["1", "2", "3", "n", "I", "N", "S", "A", "d", "c", "K"];
                let known is @string = ignored.filter() -> entry {
                    entry == kind;
                };
                if known.size() == 0 {
                    self.close();
                    throw PgLost(outcome.operation()).failure();
                }
            }
        }
        kind == "G";
    }

    // The server ignores a Sync that arrives in copy-in mode, and the
    // request's own Sync already has; after CopyFail it waits for another.
    async refuse_copy(operation is DbOperation) is void {
        await self.send(
            @byte(
                PgFrame("f", PgCString("COPY is not supported by db/postgres").bytes()).bytes()...,
                PgFrame(kind: "S", body: @byte()).bytes()...
            ),
            operation
        );
    }

    // Deferred cleanup of closed readers, statements and abandoned
    // transactions; runs under the lock before any new request. An open
    // reader owns the rest of its answer, so nothing is settled until it
    // closes.
    async settle(operation is DbOperation) is void {
        if reader.value() > 0 {
            return;
        }
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        if streaming.value() {
            await self.drain(operation);
        }
        let names = closing.value();
        if names.size() > 0 {
            closing.replace(@string());
            let frames is @@byte = names.map() -> name {
                PgFrame(kind: "C", body: @byte(83.byte(), PgCString(name).bytes()...)).bytes();
            };
            await self.send(
                @byte(PgJoined(frames).bytes()..., PgFrame(kind: "S", body: @byte()).bytes()...),
                operation
            );
            await self.ready(operation);
        }
        if rollback.value() {
            rollback.replace(false);
            await self.send(PgFrame(kind: "Q", body: PgCString("ROLLBACK").bytes()).bytes(), operation);
            await self.ready(operation);
        }
        complete.set();
    }

    permit(token is int) is void {
        confirm !self.closed() else throw DbClosed.closed;
        if transaction.value() > 0 && status.value() == "I" {
            transaction.replace(0);
            self.end_prepared();
        }
        if token > 0 && transaction.value() != token {
            throw TransactionEnded.ended;
        }
        confirm transaction.value() == token else throw DbBusy.busy;
        confirm reader.value() == 0 else throw DbBusy.busy;
    }

    active(token is int) is bool {
        !self.closed() && transaction.value() == token && status.value() != "I";
    }

    prepared_closed(token is int) is bool {
        self.closed() || (token > 0 && !self.active(token));
    }

    async execution(statement is Statement, token is int) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        await self.settle(DbOperation.executing);
        self.permit(token);
        let request = PgRequest(text: statement.text(), values: statement.values());
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        await self.send(
            @byte(
                request.parse("")...,
                request.bind("", "")...,
                PgExecute(0).bytes()...,
                PgFrame(kind: "S", body: @byte()).bytes()...
            ),
            DbOperation.executing
        );
        let outcome = await self.ready(DbOperation.executing);
        complete.set();
        outcome.execution();
    }

    async rows(statement is Statement, token is int) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        await self.settle(DbOperation.executing);
        self.permit(token);
        let request = PgRequest(text: statement.text(), values: statement.values());
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        let describe = PgFrame(kind: "D", body: @byte(80.byte(), 0.byte())).bytes();
        await self.send(
            @byte(
                request.parse("")...,
                request.bind("", "")...,
                describe...,
                PgExecute(0).bytes()...,
                PgFrame(kind: "S", body: @byte()).bytes()...
            ),
            DbOperation.executing
        );
        let outcome = await self.portion(DbOperation.executing, PgOutcome(DbOperation.executing));
        complete.set();
        outcome.check();
        self.reading(outcome, outcome.description(), "", Event(), token);
    }

    async prepare(text is string, token is int) is PreparedStatement {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        await self.settle(DbOperation.preparing);
        self.permit(token);
        let no_values is @DbValue = [];
        let request = PgRequest(text: Statement(text).text(), values: no_values);
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        let name = "okkama_" + self.next_id().string();
        let describe = PgFrame(kind: "D", body: @byte(83.byte(), PgCString(name).bytes()...)).bytes();
        await self.send(
            @byte(request.parse(name)..., describe..., PgFrame(kind: "S", body: @byte()).bytes()...),
            DbOperation.preparing
        );
        let outcome = await self.ready(DbOperation.preparing);
        complete.set();
        outcome.check();
        if token > 0 {
            transaction_prepared.replace(@string(transaction_prepared.value()..., name));
        }
        PgPrepared(owner: self, name: name, parameters: outcome.parameter_count(), description: outcome.description(), token: token);
    }

    async prepared_execution(
        name is string,
        parameters is int,
        values is Sequencing<DbValue>,
        token is int
    ) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        await self.settle(DbOperation.executing);
        self.permit(token);
        let request = PgRequest(text: "SELECT 1", values: values);
        request.require(parameters);
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        await self.send(
            @byte(
                request.bind("", name)...,
                PgExecute(0).bytes()...,
                PgFrame(kind: "S", body: @byte()).bytes()...
            ),
            DbOperation.executing
        );
        let outcome = await self.ready(DbOperation.executing);
        complete.set();
        outcome.execution();
    }

    async prepared_rows(
        name is string,
        parameters is int,
        description is PgDescription,
        values is Sequencing<DbValue>,
        source_closed is Event,
        token is int
    ) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        await self.settle(DbOperation.executing);
        self.permit(token);
        let request = PgRequest(text: "SELECT 1", values: values);
        request.require(parameters);
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        await self.send(
            @byte(
                request.bind("", name)...,
                PgExecute(0).bytes()...,
                PgFrame(kind: "S", body: @byte()).bytes()...
            ),
            DbOperation.executing
        );
        let outcome = await self.portion(DbOperation.executing, PgOutcome(DbOperation.executing));
        complete.set();
        outcome.check();
        self.reading(outcome, description, name, source_closed, token);
    }

    reading(
        outcome is PgOutcome,
        description is PgDescription,
        statement is string,
        source_closed is Event,
        token is int
    ) is PgRows {
        let id = self.next_id();
        if !outcome.ended() {
            reader.replace(id);
            reader_statement.replace(statement);
        }
        PgRows(
            owner: self,
            id: id,
            description: description,
            first: outcome.page(description),
            ended: outcome.ended(),
            source_closed: source_closed,
            token: token
        );
    }

    async fetch(id is int) is PgOutcome {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() && reader.value() == id else throw DbClosed.closed;
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        let outcome = await self.portion(DbOperation.fetching, PgOutcome(DbOperation.fetching));
        complete.set();
        if outcome.ended() {
            self.release(id);
        }
        outcome.check();
        outcome;
    }

    // The rest of the answer stays on the wire until the next operation
    // settles it.
    release(id is int) is void {
        if reader.value() == id {
            reader.replace(0);
            reader_statement.replace("");
        }
    }

    unprepare(name is string) is void {
        let kept is @string = transaction_prepared.value().filter() -> entry {
            entry != name;
        };
        transaction_prepared.replace(kept);
        if reader.value() > 0 && reader_statement.value() == name {
            self.release(reader.value());
        }
        if !self.closed() {
            closing.replace(@string(closing.value()..., name));
        }
    }

    end_prepared() is void {
        let names = transaction_prepared.value();
        transaction_prepared.replace(@string());
        for names -> name {
            self.unprepare(name);
        }
    }

    async begin(options is TransactionOptions) is PgTransaction {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        await self.settle(DbOperation.executing);
        self.permit(0);
        confirm status.value() == "I" else throw DbBusy.busy;
        let complete = Event();
        let cleanup = PgInterrupted(owner: self, complete: complete);
        defer cleanup.close();
        await self.send(
            PgFrame(kind: "Q", body: PgCString(PgBegin(options).sql()).bytes()).bytes(),
            DbOperation.executing
        );
        let outcome = await self.ready(DbOperation.executing);
        complete.set();
        outcome.check();
        let id = self.next_id();
        transaction.replace(id);
        PgTransaction(owner: self, token: id);
    }

    async finish(token is int, commit is bool, state is Atomic<int>) is bool {
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        if !commit && reader.value() > 0 {
            self.release(reader.value());
        }
        let operation = if commit {
            DbOperation.committing;
        }
        else {
            DbOperation.rolling_back;
        };
        await self.settle(operation);
        self.permit(token);
        let complete = Event();
        let cleanup = PgFinishInterrupted(owner: self, commit: commit, state: state, complete: complete);
        defer cleanup.close();
        await self.send(
            PgFrame(kind: "Q", body: PgCString(if commit {
                "COMMIT";
            }
            else {
                "ROLLBACK";
            }).bytes()).bytes(),
            operation
        );
        let outcome = await self.ready(operation);
        complete.set();
        transaction.replace(0);
        self.end_prepared();
        outcome.check();
        confirm !commit || outcome.last_tag() == "COMMIT"
            else throw DbFailure.detailed(
                PgFailureKind("25P02").kind(),
                DbOperation.committing,
                "25P02",
                "PostgreSQL rolled back the failed transaction instead of committing it"
            );
        true;
    }

    // Transaction dropped without commit or rollback: ROLLBACK on next use.
    abandon(token is int) is void {
        if transaction.value() == token {
            transaction.replace(0);
            if reader.value() > 0 {
                self.release(reader.value());
            }
            self.end_prepared();
            rollback.replace(true);
        }
    }
}

hidden object PgInterrupted {
    has owner is PgSession;
    has complete is Event;

    PgInterrupted(owner is PgSession, complete is Event) {
        self.owner = owner;
        self.complete = complete;
    }

    close() is void {
        if !complete.ready() {
            owner.close();
        }
    }
}

hidden object PgFinishInterrupted {
    has owner is PgSession;
    has commit is bool;
    has state is Atomic<int>;
    has complete is Event;

    PgFinishInterrupted(owner is PgSession, commit is bool, state is Atomic<int>, complete is Event) {
        self.owner = owner;
        self.commit = commit;
        self.state = state;
        self.complete = complete;
    }

    close() is void {
        if !complete.ready() {
            if commit {
                state.replace(3);
            }
            owner.close();
        }
    }
}

hidden object PgLost {
    has operation is DbOperation;

    PgLost(operation is DbOperation) {
        self.operation = operation;
    }

    failure() is DbFailure {
        DbFailure.detailed(
            DbFailureKind.connection,
            operation,
            "PG_CONNECTION_LOST",
            "PostgreSQL connection failed"
        );
    }
}

hidden object PgBegin {
    has options is TransactionOptions;

    PgBegin(options is TransactionOptions) {
        self.options = options;
    }

    sql() is string {
        let level = match options::Mode::isolation {
            case Isolation.read_uncommitted {
                " ISOLATION LEVEL READ UNCOMMITTED";
            }
            case Isolation.read_committed {
                " ISOLATION LEVEL READ COMMITTED";
            }
            case Isolation.repeatable_read {
                " ISOLATION LEVEL REPEATABLE READ";
            }
            case Isolation.serializable {
                " ISOLATION LEVEL SERIALIZABLE";
            }
            else {
                "";
            }
        };
        "BEGIN" + level + if options::Mode::read_only {
            " READ ONLY";
        }
        else {
            " READ WRITE";
        } + if options::Mode::deferrable {
            " DEFERRABLE";
        }
        else {
            "";
        };
    }
}

// Accumulated answer of one request.
object PgOutcome {
    has operation is DbOperation;
    has tags is Atomic<@string>;
    // Raw DataRow messages, newest run first (see PgInput.data_rows), and
    // the number of runs (a list's size walks it).
    has data is Atomic<List<@byte>>;
    has runs, rows is Atomic<int>;
    has columns is Atomic<@PgDescription>;
    has failures is Atomic<@DbFailure>;
    has count is Atomic<int>;
    has finished, copy is Atomic<bool>;

    PgOutcome(operation is DbOperation) {
        self.operation = operation;
        tags = Atomic(@string());
        let empty is List<@byte> = EmptyList();
        data = Atomic(empty);
        runs = Atomic(0);
        rows = Atomic(0);
        let described is @PgDescription = [];
        columns = Atomic(described);
        let failed is @DbFailure = [];
        failures = Atomic(failed);
        count = Atomic(0);
        finished = Atomic(false);
        copy = Atomic(false);
    }

    operation() is DbOperation {
        operation;
    }

    tag(value is string) is void {
        tags.replace(@string(tags.value()..., value));
    }

    row(body is @byte) is void {
        self.data_rows(
            PgDataRows(bytes: @byte(68.byte(), PgInt32(body.size() + 4).bytes()..., body...), count: 1)
        );
    }

    data_rows(run is PgDataRows) is void {
        if run.count() > 0 {
            data.replace(data.value().prefix(run.bytes()));
            runs.replace(runs.value() + 1);
            rows.replace(rows.value() + run.count());
        }
    }

    rows() is int {
        rows.value();
    }

    describe(value is PgDescription) is void {
        columns.replace([value]);
    }

    parameters(value is int) is void {
        count.replace(value);
    }

    fail(value is DbFailure) is void {
        if failures.value().size() == 0 {
            failures.replace([value]);
        }
    }

    copied() is void {
        copy.replace(true);
    }

    end() is void {
        finished.replace(true);
    }

    ended() is bool {
        finished.value();
    }

    // The data rows read so far as one result page of `description`.
    page(description is PgDescription) is DbPage {
        let count = runs.value();
        let rest = Cell(data.value());
        let newest is @@byte = (0..count).map() -> index {
            let list = rest.value();
            rest.replace(list.tail());
            list.first();
        };
        let ordered is @@byte = (0..count).map() -> index {
            newest[count - 1 - index];
        };
        let width = description.columns().size();
        let state = native_pg.pg_page(PgJoined(ordered).bytes(), width, description.types());
        let failure = native_pg.pg_page_failure(state);
        if failure == "nonfinite" {
            throw PgNonFinite().failure();
        }
        confirm failure == "" else throw PgWireFailure.because("invalid data row: " + failure);
        DbPage(
            width: width,
            kinds: native_pg.pg_page_kinds(state),
            values: native_pg.pg_page_values(state),
            floats: native_pg.pg_page_floats(state),
            texts: native_pg.pg_page_texts(state),
            blobs: native_pg.pg_page_blobs(state)
        );
    }

    parameter_count() is int {
        count.value();
    }

    description() is PgDescription {
        if columns.value().size() == 1 {
            columns.value()[0];
        }
        else {
            PgDescription();
        }
    }

    last_tag() is string {
        let all = tags.value();
        if all.size() == 0 {
            "";
        }
        else {
            all[all.size() - 1];
        }
    }

    check() is void {
        confirm !copy.value()
            else throw DbFailure.detailed(
                DbFailureKind.unsupported,
                operation,
                "PG_COPY",
                "COPY is not supported by db/postgres"
            );
        if failures.value().size() == 1 {
            throw failures.value()[0];
        }
    }

    execution() is Execution {
        self.check();
        PgCommandTag(self.last_tag()).execution();
    }
}

hidden object PgCommandTag {
    has origin is string;

    PgCommandTag(origin is string) {
        self.origin = origin;
    }

    execution() is Execution {
        let words = origin.split(" ");
        let command = words[0];
        if words.size() >= 2
            && (command == "INSERT"
            || command == "UPDATE"
            || command == "DELETE"
            || command == "MERGE"
            || command == "COPY") {
                return Execution(BigInt(words[words.size() - 1]));
            }
        Execution();
    }
}

// Columns of a RowDescription with their type OIDs.
object PgDescription {
    has schema is DbRowSchema;
    has columns is @Column;
    has types is @int;

    PgDescription() {
        columns = [];
        schema = DbRowSchema(columns: self.columns, limits: DbLimits());
        types = [];
    }

    PgDescription(fields is PgFields) {
        let count = fields.int16();
        let names = Cell(@string());
        let oids = Cell(@int());
        for 0..count -> index {
            names.replace(@string(names.value()..., fields.cstring()));
            fields.int32();
            fields.int16();
            oids.replace(@int(oids.value()..., fields.int32()));
            fields.int16();
            fields.int32();
            fields.int16();
        }
        let all = names.value();
        let found = oids.value();
        let described is @Column = (0..count).map() -> index {
            Column(index: index, name: all[index], declaration: PgTypeName(found[index]).string());
        };
        columns = described;
        schema = DbRowSchema(columns: self.columns, limits: DbLimits());
        types = found;
    }

    columns() is @Column {
        columns;
    }

    types() is @int {
        types;
    }

    schema() is DbRowSchema {
        schema;
    }
}

hidden object PgTypeName {
    has oid is int;

    PgTypeName(oid is int) {
        self.oid = oid;
    }

    string() is string {
        match oid {
            case 16 {
                "bool";
            }
            case 17 {
                "bytea";
            }
            case 18 {
                "char";
            }
            case 19 {
                "name";
            }
            case 20 {
                "int8";
            }
            case 21 {
                "int2";
            }
            case 23 {
                "int4";
            }
            case 25 {
                "text";
            }
            case 26 {
                "oid";
            }
            case 114 {
                "json";
            }
            case 700 {
                "float4";
            }
            case 701 {
                "float8";
            }
            case 1042 {
                "bpchar";
            }
            case 1043 {
                "varchar";
            }
            case 1082 {
                "date";
            }
            case 1083 {
                "time";
            }
            case 1114 {
                "timestamp";
            }
            case 1184 {
                "timestamptz";
            }
            case 1186 {
                "interval";
            }
            case 1266 {
                "timetz";
            }
            case 1700 {
                "numeric";
            }
            case 2950 {
                "uuid";
            }
            case 3802 {
                "jsonb";
            }
            else {
                "oid:" + oid.string();
            }
        }
    }
}

hidden object PgNonFinite {
    PgNonFinite();

    failure() is DbFailure {
        DbFailure.detailed(
            DbFailureKind.data,
            DbOperation.fetching,
            "PG_NONFINITE",
            "NaN or infinite numeric values have no portable database value"
        );
    }
}

// Parse and Bind for one SQL text and its values.
hidden object PgRequest {
    has text is string;
    has values is @PgParameter;

    PgRequest(text is string, values is Sequencing<DbValue>) {
        self.text = text;
        let bound is @PgParameter = (0..values.size()).map() -> index {
            PgParameter(ObservedDbValue(values.item(index)));
        };
        self.values = bound;
    }

    require(count is int) is void {
        confirm values.size() == count
            else throw DbFailure.detailed(
                DbFailureKind.data,
                DbOperation.executing,
                "PG_PARAMETER_COUNT",
                "prepared statement expects " + count.string() + " parameters, got " + values.size().string()
            );
    }

    parse(name is string) is @byte {
        PgFrame(
            kind: "P",
            body: @byte(PgCString(name).bytes()..., PgCString(text).bytes()..., PgInt16(0).bytes()...)
        ).bytes();
    }

    bind(portal is string, statement is string) is @byte {
        let formats is @@byte = values.map() -> value {
            PgInt16(value.format()).bytes();
        };
        let payloads is @@byte = values.map() -> value {
            value.bytes();
        };
        PgFrame(kind: "B", body: @byte(
            PgCString(portal).bytes()...,
            PgCString(statement).bytes()...,
            PgInt16(values.size()).bytes()...,
            PgJoined(formats).bytes()...,
            PgInt16(values.size()).bytes()...,
            PgJoined(payloads).bytes()...,
            PgInt16(1).bytes()...,
            PgInt16(0).bytes()...
        )).bytes();
    }
}

hidden object PgExecute {
    has limit is int;

    PgExecute(limit is int) {
        self.limit = limit;
    }

    bytes() is @byte {
        PgFrame(kind: "E", body: @byte(0.byte(), PgInt32(limit).bytes()...)).bytes();
    }
}

// One parameter: format code and length-prefixed payload (-1 is NULL).
hidden object PgParameter {
    has format is int;
    has payload is @byte;
    has missing is bool;

    PgParameter(value is ObservedDbValue) {
        format = if value.kind() == DbValueKind.bytes {
            1;
        }
        else {
            0;
        };
        missing = value.kind() == DbValueKind.null_value;
        payload = match value.kind() {
            case DbValueKind.null_value {
                @byte();
            }
            case DbValueKind.boolean {
                Utf8Encoded(if value.boolean() {
                    "true";
                }
                else {
                    "false";
                }).bytes();
            }
            case DbValueKind.integer {
                Utf8Encoded(value.integer().string()).bytes();
            }
            case DbValueKind.floating {
                Utf8Encoded(value.floating().string()).bytes();
            }
            case DbValueKind.decimal {
                Utf8Encoded(value.decimal().string()).bytes();
            }
            case DbValueKind.text {
                Utf8Encoded(value.text()).bytes();
            }
            case DbValueKind.bytes {
                value.bytes();
            }
            else {
                throw InvalidPostgresOptions.because("unknown value kind");
            }
        };
    }

    format() is int {
        format;
    }

    bytes() is @byte {
        if missing {
            PgInt32(-1).bytes();
        }
        else {
            @byte(PgInt32(payload.size()).bytes()..., payload...);
        }
    }
}

// ErrorResponse as DbFailure: SQLSTATE class decides the kind; the message
// names only schema objects (constraint, table, column) the server reported.
hidden object PgError {
    has severity, state, constraint, table, column is string;
    has operation is DbOperation;

    PgError(message is PgMessage, operation is DbOperation) {
        self.operation = operation;
        let fields = message.fields();
        let found = Cell(@string());
        loop {
            let code = fields.byte();
            if code == 0 {
                last;
            }
            found.replace(
                @string(found.value()..., Utf8Decoded([code.byte()]).string(), fields.cstring())
            );
        }
        let pairs = found.value();
        severity = PgErrorField(pairs: pairs, name: "V").text();
        state = PgErrorField(pairs: pairs, name: "C").text();
        constraint = PgErrorField(pairs: pairs, name: "n").text();
        table = PgErrorField(pairs: pairs, name: "t").text();
        column = PgErrorField(pairs: pairs, name: "c").text();
    }

    fatal() is bool {
        severity == "FATAL" || severity == "PANIC";
    }

    failure() is DbFailure {
        let code = if state.length() == 5 {
            state;
        }
        else {
            "PG_UNKNOWN";
        };
        let subject = if constraint != "" {
            " (constraint " + constraint + ")";
        }
        else {
            if table != "" {
                " (table " + table + if column != "" {
                    "." + column;
                }
                else {
                    "";
                } + ")";
            }
            else {
                "";
            }
        };
        DbFailure.detailed(
            PgFailureKind(code).kind(),
            operation,
            code,
            "PostgreSQL rejected the operation" + subject
        );
    }
}

hidden object PgErrorField {
    has pairs is @string;
    has name is string;

    PgErrorField(pairs is @string, name is string) {
        self.pairs = pairs;
        self.name = name;
    }

    text() is string {
        let indexes is @int = (0..pairs.size()).filter() -> index {
            index % 2 == 0 && pairs[index] == name;
        };
        if indexes.size() == 0 {
            "";
        }
        else {
            pairs[indexes[0] + 1];
        }
    }
}

hidden object PgFailureKind {
    has code is string;

    PgFailureKind(code is string) {
        self.code = code;
    }

    kind() is DbFailureKind {
        let class = code.slice(0, 2);
        if code == "40001" {
            return DbFailureKind.serialization;
        }
        if code == "40P01" {
            return DbFailureKind.deadlock;
        }
        if code == "42501" || code == "25006" {
            return DbFailureKind.permission;
        }
        if code == "55P03" {
            return DbFailureKind.busy;
        }
        if code == "57014" {
            return DbFailureKind.cancelled;
        }
        if code == "08P01" {
            return DbFailureKind.unexpected;
        }
        match class {
            case "08" {
                DbFailureKind.connection;
            }
            case "57" {
                DbFailureKind.connection;
            }
            case "23" {
                DbFailureKind.constraint;
            }
            case "42" {
                DbFailureKind.syntax;
            }
            case "22" {
                DbFailureKind.data;
            }
            case "28" {
                DbFailureKind.permission;
            }
            case "40" {
                DbFailureKind.serialization;
            }
            case "53" {
                DbFailureKind.resource;
            }
            case "54" {
                DbFailureKind.resource;
            }
            case "0A" {
                DbFailureKind.unsupported;
            }
            else {
                DbFailureKind.unexpected;
            }
        }
    }
}

object PgRows does RowReading, Closing {
    has owner is PgSession;
    has id, token is int;
    has description is PgDescription;
    // The fetched page and the next row of it to read.
    has buffered is Atomic<DbPage>;
    has next_row is Atomic<int>;
    has eof, stopped, source_closed is Event;
    has busy is Atomic<bool>;

    PgRows(
        owner is PgSession,
        id is int,
        description is PgDescription,
        first is DbPage,
        ended is bool,
        source_closed is Event,
        token is int
    ) {
        self.owner = owner;
        self.id = id;
        self.token = token;
        self.description = description;
        buffered = Atomic(first);
        next_row = Atomic(0);
        let finished = Event();
        if ended {
            finished.set();
        }
        eof = finished;
        stopped = Event();
        self.source_closed = source_closed;
        busy = Atomic(false);
    }

    columns() is Sequencing<Column> {
        description.columns();
    }

    closed() is bool {
        stopped.ready()
            || source_closed.ready()
            || owner.closed()
            || (token > 0 && !owner.active(token));
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            buffered.replace(DbPage());
            next_row.replace(0);
            owner.release(id);
        }
    }

    async row() is Row {
        confirm !self.closed() else throw DbClosed.closed;
        confirm busy.compare_and_replace(false, true) else throw DbBusy.busy;
        defer busy.replace(false);
        if next_row.value() >= self.buffered_rows() {
            if eof.ready() {
                throw RowsEnded.ended;
            }
            let outcome = await owner.fetch(id);
            confirm !self.closed() else throw DbClosed.closed;
            buffered.replace(outcome.page(description));
            next_row.replace(0);
            if outcome.ended() {
                eof.set();
            }
            if self.buffered_rows() == 0 {
                throw RowsEnded.ended;
            }
        }
        let index = next_row.value();
        next_row.replace(index + 1);
        Row(DbRowData(schema: description.schema(), page: buffered.value(), row: index));
    }

    destroy {
        self.close();
    }

    hidden buffered_rows() is int {
        let page = buffered.value();
        if page.width() == 0 {
            0;
        }
        else {
            (page.size() / page.width()).int();
        }
    }
}

object PgTransaction does Transaction, DbExecuting, DbPreparing {
    has owner is PgSession;
    has token is int;
    has outcome is Atomic<int>;

    PgTransaction(owner is PgSession, token is int) {
        self.owner = owner;
        self.token = token;
        outcome = Atomic(0);
    }

    active() is bool {
        outcome.value() == 0 && owner.active(token);
    }

    async execution(statement is Statement) is Execution {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.execution(statement, token);
    }

    async rows(statement is Statement) is RowReading {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.rows(statement, token);
    }

    async prepared(text is string) is PreparedStatement {
        confirm self.active() else throw TransactionEnded.ended;
        await owner.prepare(text, token);
    }

    async commit() is Transaction {
        if outcome.value() == 3 {
            throw IndeterminateCommit.indeterminate;
        }
        if outcome.value() == 1 {
            return self;
        }
        confirm self.active() else throw TransactionEnded.ended;
        try {
            await owner.finish(token, true, outcome);
        }
        catch DbFailure.detailed(kind, _, _, _) {
            if outcome.value() == 3 || kind == DbFailureKind.connection {
                outcome.replace(3);
                throw IndeterminateCommit.indeterminate;
            }
            throw;
        }
        outcome.replace(1);
        self;
    }

    async rollback() is Transaction {
        if outcome.value() == 2 {
            return self;
        }
        confirm self.active() else throw TransactionEnded.ended;
        await owner.finish(token, false, outcome);
        outcome.replace(2);
        self;
    }

    destroy {
        if outcome.value() == 0 {
            owner.abandon(token);
        }
    }
}

hidden object PgPrepared does PreparedStatement, Closing {
    has owner is PgSession;
    has name is string;
    has parameters, token is int;
    has description is PgDescription;
    has stopped is Event;

    PgPrepared(
        owner is PgSession,
        name is string,
        parameters is int,
        description is PgDescription,
        token is int
    ) {
        self.owner = owner;
        self.name = name;
        self.parameters = parameters;
        self.description = description;
        self.token = token;
        stopped = Event();
    }

    closed() is bool {
        stopped.ready() || owner.prepared_closed(token);
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            owner.unprepare(name);
        }
    }

    async execution(values is Sequencing<DbValue>) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        await owner.prepared_execution(name, parameters, values, token);
    }

    async rows(values is Sequencing<DbValue>) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        await owner.prepared_rows(name, parameters, description, values, stopped, token);
    }

    destroy {
        self.close();
    }
}

enum InvalidPostgresOptions is Error = (because(reason is string));

test "startup message carries protocol 3.0 and UTF-8 session settings" {
    let bytes = PgStartupMessage(user: "app", options: PostgresOptions("shop")).bytes();
    test.is(bytes.slice(4, 8), [0.byte(), 3.byte(), 0.byte(), 0.byte()]);
    test.is(bytes[bytes.size() - 1], 0.byte());
    test.is(bytes.size(), PgFields(bytes).int32());
}

test "bind frames carry formats, NULL and binary bytes" {
    let request = PgRequest(text: "SELECT $1, $2, $3", values: [DbNull(), DbBytes([7.byte()]), DbBoolean(true)]);
    let fields = PgMessage(kind: "B", body: request.bind("", "s1").slice(5, request.bind("", "s1").size())).fields();
    test.is(fields.cstring(), "");
    test.is(fields.cstring(), "s1");
    test.is(fields.int16(), 3);
    test.is([fields.int16(), fields.int16(), fields.int16()], [0, 1, 0]);
    test.is(fields.int16(), 3);
    test.is(fields.int32(), -1);
    test.is(fields.int32(), 1);
    test.is(fields.take(1), [7.byte()]);
    test.is(fields.int32(), 4);
    test.is(Utf8Decoded(fields.take(4)).string(), "true");
    test.is([fields.int16(), fields.int16()], [1, 0]);
}

test "text results decode by column type" {
    // One RowDescription column of type `oid` and one DataRow holding `text`.
    let cell = (text is string, oid is int) is native_db.DbCellState {
        let described = @byte(
            PgInt16(1).bytes()...,
            PgCString("c").bytes()...,
            PgInt32(0).bytes()...,
            PgInt16(0).bytes()...,
            PgInt32(oid).bytes()...,
            PgInt16(-1).bytes()...,
            PgInt32(-1).bytes()...,
            PgInt16(0).bytes()...
        );
        let value = Utf8Encoded(text).bytes();
        let outcome = PgOutcome(DbOperation.fetching);
        outcome.row(@byte(PgInt16(1).bytes()..., PgInt32(value.size()).bytes()..., value...));
        outcome.page(PgDescription(PgFields(described))).cell(0);
    };
    test.ok(native_db.db_boolean_value(cell("t", 16)));
    test.is(native_db.db_integer_value(cell("-42", 20)), "-42");
    test.is(native_db.db_bytes_value(cell("\\x0aff", 17)), [10.byte(), 255.byte()]);
    test.is(
        Decimal(native_db.db_decimal_value(cell("12.50", 1700))).string(),
        Decimal("12.5").string()
    );
    test.is(native_db.db_text_value(cell("2026-10-23", 1082)), "2026-10-23");
    test.ok(try {
        cell("NaN", 701);
        false;
    }
    catch DbFailure.detailed(kind, _, _, _) {
        kind == DbFailureKind.data;
    });
}

test "command tags report affected rows only for data changes" {
    test.is(PgCommandTag("INSERT 0 3").execution().affected_rows().string(), "3");
    test.is(PgCommandTag("UPDATE 0").execution().affected_rows().string(), "0");
    test.ok(!PgCommandTag("CREATE TABLE").execution().affected_known());
    test.ok(!PgCommandTag("SELECT 5").execution().affected_known());
}

test "SQLSTATE classes map to portable failure kinds" {
    test.ok(PgFailureKind("23505").kind() == DbFailureKind.constraint);
    test.ok(PgFailureKind("42601").kind() == DbFailureKind.syntax);
    test.ok(PgFailureKind("42501").kind() == DbFailureKind.permission);
    test.ok(PgFailureKind("40001").kind() == DbFailureKind.serialization);
    test.ok(PgFailureKind("40P01").kind() == DbFailureKind.deadlock);
    test.ok(PgFailureKind("22P02").kind() == DbFailureKind.data);
    test.ok(PgFailureKind("XX000").kind() == DbFailureKind.unexpected);
}

test "transaction options become one BEGIN" {
    test.is(PgBegin(TransactionOptions()).sql(), "BEGIN READ WRITE");
    test.is(
        PgBegin(TransactionOptions(isolation: Isolation.serializable, read_only: true, deferrable: true)).sql(),
        "BEGIN ISOLATION LEVEL SERIALIZABLE READ ONLY DEFERRABLE"
    );
}
