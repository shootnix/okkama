module db/pool v1.0.0;

// A pool of database connections.
//
//     let pool = DbPool(
//         origin: PostgresConnecting(…),
//         options: PoolOptions(minimum: 2, maximum: 16, idle_timeout: Duration(minutes: 5),
//             lifetime: Duration(minutes: 30), acquisition_timeout: Duration(seconds: 5)),
//         clock: SystemClock(),
//     );
//     let db = await pool.connection();
//     defer db.close();                       // returns it to the pool
//     await db.query("SELECT 1 AS one").one();
//
// A lease is a DbConnection. Closing it rolls back an open transaction, closes
// its cursors and statements, and returns the connection; a broken one is
// dropped. Connections idle longer than idle_timeout or older than lifetime are
// replaced (0 turns either off). A pool holds at most 64 connections.
// DbPreparedPool also hands out prepared statements and transactions.

import "db/connection" take DbConnecting, DbConnection, DbExecuting;
import "db/acquisition" take DbAcquiring, DbAcquisition, PortableDbAcquiring;
import "db/prepared" take DbPreparing, PreparedStatement, DbPreparedOpening;
import "db/statement" take Statement, Execution;
import "db/value" take DbValue;
import "db/query" take Query;
import "db/row" take RowReading, Row, Column, DbQuery;
import "db/transaction" take Transaction, TransactionOptions;
import "db/error" take DbClosed, TransactionEnded, DbFailure, DbFailureKind, DbOperation;
import "collections/sequence" take Sequencing;
import "time/clock" take Timing, MonotonicInstant;
import "time/duration" take Duration, DurationUnit;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/lock" take Lock;
import "async/semaphore" take Semaphore, Permit;
import "async/collect" take Raced;
import "async/timeout" take Before;
import "async/scope" take FutureGroup;
import "io/stream" take Closing;

// How large a pool is and how long connections live.
object PoolOptions {
    has minimum, maximum is int;
    has idle, lifetime, acquisition is Duration;

    // At least minimum and at most maximum (1..64) connections;
    // InvalidPoolOptions otherwise.
    PoolOptions(
        minimum is int,
        maximum is int,
        idle_timeout is Duration,
        lifetime is Duration,
        acquisition_timeout is Duration
    ) {
        confirm minimum >= 0
            && maximum > 0
            && maximum <= 64
            && minimum <= maximum
            && idle_timeout::Span::seconds >= 0.rat()
            && lifetime::Span::seconds >= 0.rat()
            && acquisition_timeout::Span::seconds > 0.rat()
            else throw InvalidPoolOptions.invalid;
        self.minimum = minimum;
        self.maximum = maximum;
        idle = idle_timeout;
        self.lifetime = lifetime;
        acquisition = acquisition_timeout;
    }

    // How long a connection may sit idle; 0 for ever.
    idle_timeout() is Duration {
        idle;
    }

    // How long a connection may live; 0 for ever.
    lifetime() is Duration {
        lifetime;
    }

    // How long connection() waits.
    acquisition_timeout() is Duration {
        acquisition;
    }

    // The minimum and maximum.
    cap Size {
        minimum is int {
            minimum;
        }

        maximum is int {
            maximum;
        }
    }
}

// A pool's counts at one moment.
object PoolSnapshot {
    has acquisitions, idle, waiting, capacity is int;

    // As given.
    PoolSnapshot(acquisitions is int, idle is int, waiting is int, capacity is int) {
        self.acquisitions = acquisitions;
        self.idle = idle;
        self.waiting = waiting;
        self.capacity = capacity;
    }

    // Leased connections, idle ones, waiting requests and capacity.
    cap Counts {
        acquisitions is int {
            acquisitions;
        }

        idle_connections is int {
            idle;
        }

        waiting_requests is int {
            waiting;
        }

        capacity is int {
            capacity;
        }
    }
}

// How a pool checks a connection before lending it.
role DbChecking {
    // Whether origin can be lent.
    async healthy(origin is DbConnection) is bool;
}

hidden object UncheckedDbConnections does DbChecking {
    UncheckedDbConnections();

    async healthy(origin is DbConnection) is bool {
        !origin.closed();
    }
}

// A pool of plain connections.
object DbPool does Closing {
    has owner is DbPoolState;

    // A pool connecting with origin.
    DbPool(origin is DbConnecting, options is PoolOptions, clock is Timing) {
        owner = DbPoolState(
            origin: PortableDbAcquiring(origin),
            options: options,
            clock: clock,
            health: UncheckedDbConnections()
        );
    }

    // The same, checking connections with health.
    DbPool(origin is DbConnecting, options is PoolOptions, clock is Timing, health is DbChecking) {
        owner = DbPoolState(
            origin: PortableDbAcquiring(origin),
            options: options,
            clock: clock,
            health: health
        );
    }

    // A connection from the pool; TimedOut after the acquisition timeout,
    // DbClosed once closed.
    async connection() is PooledConnection {
        await owner.connection();
    }

    // Its counts now.
    snapshot() is PoolSnapshot {
        owner.snapshot();
    }

    // Whether it was closed.
    closed() is bool {
        owner.closed();
    }

    // Closes it: idle connections close and every lease is revoked.
    close() is void {
        owner.close();
    }

    // Waits until every connection has closed.
    async settled() is bool {
        await owner.settled();
    }

    destroy {
        owner.close();
    }
}

// A pool whose leases can also prepare statements.
object DbPreparedPool does Closing {
    has owner is DbPoolState;

    // A pool acquiring from origin.
    DbPreparedPool(origin is DbAcquiring, options is PoolOptions, clock is Timing) {
        owner = DbPoolState(
            origin: origin,
            options: options,
            clock: clock,
            health: UncheckedDbConnections()
        );
    }

    // The same, checking connections with health.
    DbPreparedPool(
        origin is DbAcquiring,
        options is PoolOptions,
        clock is Timing,
        health is DbChecking
    ) {
        owner = DbPoolState(origin: origin, options: options, clock: clock, health: health);
    }

    // A connection from the pool; TimedOut after the acquisition timeout,
    // DbClosed once closed.
    async connection() is PooledConnection {
        await owner.connection();
    }

    // Its counts now.
    snapshot() is PoolSnapshot {
        owner.snapshot();
    }

    // Whether it was closed.
    closed() is bool {
        owner.closed();
    }

    // Closes it: idle connections close and every lease is revoked.
    close() is void {
        owner.close();
    }

    // Waits until every connection has closed.
    async settled() is bool {
        await owner.settled();
    }

    destroy {
        owner.close();
    }
}

// One physical connection of a pool.
object DbPhysical {
    has pending is Future<DbAcquisition>;
    has born is MonotonicInstant;
    has serial is int;

    // The connection pending acquires, born at born.
    DbPhysical(pending is Future<DbAcquisition>, born is MonotonicInstant, serial is int) {
        self.pending = pending;
        self.born = born;
        self.serial = serial;
    }

    // The connection.
    async connection() is DbConnection {
        let acquired = await pending;
        acquired.connection();
    }

    // Its preparation.
    async preparing() is DbPreparing {
        let acquired = await pending;
        acquired.preparing();
    }

    // Its preparing transactions.
    async transactions() is DbPreparedOpening {
        let acquired = await pending;
        acquired.transactions();
    }

    // When it was opened.
    born() is MonotonicInstant {
        born;
    }

    // Its number in the pool.
    serial() is int {
        serial;
    }
}

hidden object DbIdle {
    has physical is DbPhysical;
    has since is MonotonicInstant;

    DbIdle(physical is DbPhysical, since is MonotonicInstant) {
        self.physical = physical;
        self.since = since;
    }

    physical() is DbPhysical {
        physical;
    }

    since() is MonotonicInstant {
        since;
    }
}

// The shared state of a pool; used inside db/pool.
object DbPoolState {
    has origin is DbAcquiring;
    has options is PoolOptions;
    has clock is Timing;
    has health is DbChecking;
    has capacity is Semaphore;
    has stopped is Event;
    has acquisition_lock is Lock;
    has failure is Atomic<@Error>;
    has waiting, serial is Atomic<int>;
    has idle is Atomic<@DbIdle>;
    has records is Atomic<@DbPhysical>;
    has leases is Atomic<@PooledConnection>;
    has retiring is Atomic<@DbRetirement>;

    // The state of a pool of origin.
    DbPoolState(
        origin is DbAcquiring,
        options is PoolOptions,
        clock is Timing,
        health is DbChecking
    ) {
        self.origin = origin;
        self.options = options;
        self.clock = clock;
        self.health = health;
        capacity = Semaphore(options::Size::maximum);
        stopped = Event();
        acquisition_lock = Lock();
        let no_failure is @Error = [];
        failure = Atomic(no_failure);
        waiting = Atomic(0);
        serial = Atomic(0);
        let no_idle is @DbIdle = [];
        idle = Atomic(no_idle);
        let no_records is @DbPhysical = [];
        records = Atomic(no_records);
        let no_leases is @PooledConnection = [];
        leases = Atomic(no_leases);
        let no_retiring is @DbRetirement = [];
        retiring = Atomic(no_retiring);
    }

    // Whether it is closed.
    closed() is bool {
        stopped.ready();
    }

    // Its counts.
    snapshot() is PoolSnapshot {
        PoolSnapshot(
            acquisitions: leases.value().size(),
            idle: idle.value().size(),
            waiting: waiting.value(),
            capacity: options::Size::maximum
        );
    }

    // Fails with DbClosed once the pool closes.
    async stopping() is PooledConnection {
        await stopped.wait();
        throw DbClosed.closed;
    }

    // A lease within the acquisition timeout.
    async connection() is PooledConnection {
        confirm !self.closed() else throw DbClosed.closed;
        waiting.replace(waiting.value() + 1);
        defer waiting.replace(waiting.value() - 1);
        let group is FutureGroup<PooledConnection> = FutureGroup();
        let taken = Event();
        let pending = self.acquire();
        let cleanup = DbUnclaimedLease(group: group, pending: pending, taken: taken);
        defer await cleanup.close();
        group.start(pending);
        let race is Raced<PooledConnection> = Raced(origins: [pending, self.stopping()]);
        let deadline = clock.monotonic_instant().plus(options.acquisition_timeout());
        let bounded is Before<PooledConnection> = Before(
            origin: race.winner(),
            deadline: deadline,
            clock: clock
        );
        let result = await bounded.outcome();
        taken.set();
        result;
    }

    // A lease: an idle connection or a new one.
    async acquire() is PooledConnection {
        let permit = await capacity.permit();
        let published = Event();
        let cleanup = DbUnusedPermit(permit: permit, published: published);
        defer cleanup.close();
        confirm !self.closed() else throw DbClosed.closed;
        let guard = await acquisition_lock.guard();
        defer guard.close();
        loop {
            let previous = idle.value();
            let candidates is @DbPhysical = if previous.size() > 0 {
                let rest is @DbIdle = (1..previous.size()).map() -> index {
                    previous[index];
                };
                idle.replace(rest);
                [previous[0].physical()];
            }
            else {
                let empty is @DbPhysical = [];
                empty;
            };
            let physical = if candidates.size() > 0 {
                candidates[0];
            }
            else {
                let id = serial.value() + 1;
                serial.replace(id);
                let record = DbPhysical(
                    pending: origin.acquisition(),
                    born: clock.monotonic_instant(),
                    serial: id
                );
                let old = records.value();
                let all is @DbPhysical = old + [record];
                records.replace(all);
                record;
            };
            let connection = try {
                await physical.connection();
            }
            catch e is Cancelled {
                self.forget(physical.serial());
                throw;
            }
            catch e is Error {
                self.forget(physical.serial());
                throw;
            }
            catch e is NativeFailure {
                self.forget(physical.serial());
                throw;
            };
            let owned = Event();
            let anchor = DbUnpublishedPhysical(
                owner: self,
                physical: physical,
                connection: connection,
                owned: owned
            );
            defer await anchor.close();
            let expired = (options.lifetime()::Span::seconds > 0.rat()
                && clock.monotonic_instant().minus(physical.born())::Span::seconds >= options.lifetime()::Span::seconds)
                || (candidates.size() > 0
                && options.idle_timeout()::Span::seconds > 0.rat()
                && clock.monotonic_instant().minus(previous[0].since())::Span::seconds >= options.idle_timeout()::Span::seconds);
            if expired || connection.closed() || !(await health.healthy(connection)) {
                self.discard(physical, connection);
                await connection.settled();
                owned.set();
                next;
            }
            confirm !self.closed() else throw DbClosed.closed;
            await self.warm();
            let lease = PooledConnection(
                owner: self,
                physical: physical,
                origin: connection,
                permit: permit
            );
            let old = leases.value();
            let all is @PooledConnection = old + [lease];
            leases.replace(all);
            owned.set();
            published.set();
            return lease;
        }
    }

    // Opens connections up to the minimum.
    async warm() is bool {
        loop {
            if records.value().size() >= options::Size::minimum {
                last;
            }
            let id = serial.value() + 1;
            serial.replace(id);
            let physical = DbPhysical(
                pending: origin.acquisition(),
                born: clock.monotonic_instant(),
                serial: id
            );
            let old = records.value();
            let all is @DbPhysical = old + [physical];
            records.replace(all);
            let connection = try {
                await physical.connection();
            }
            catch e is Cancelled {
                self.forget(id);
                throw;
            }
            catch e is Error {
                self.forget(id);
                throw;
            }
            catch e is NativeFailure {
                self.forget(id);
                throw;
            };
            self.recycle(physical, connection);
        }
        true;
    }

    // Forgets connection id.
    forget(id is int) is void {
        let kept is @DbPhysical = records.value().filter() -> record {
            record.serial() != id;
        };
        records.replace(kept);
    }

    // Drops a broken connection.
    discard(physical is DbPhysical, connection is DbConnection) is void {
        connection.close();
        self.forget(physical.serial());
        let pending = self.join(connection);
        self.retire(pending);
    }

    // Waits for connection to settle; true when it is reusable.
    async join(connection is DbConnection) is bool {
        await connection.settled();
    }

    // Records a failure.
    failed(error is Error) is void {
        if failure.value().size() == 0 {
            failure.replace([error]);
        }
    }

    // Tracks a closing in progress.
    retire(pending is Future<bool>) is void {
        let old is @DbRetirement = retiring.value().filter() -> record {
            !record.complete();
        };
        let record = DbRetirement(owner: self, pending: pending);
        let all is @DbRetirement = old + [record];
        retiring.replace(all);
        record.start();
    }

    // Takes back lease.
    release(lease is PooledConnection) is void {
        let kept is @PooledConnection = leases.value().filter() -> entry {
            entry.identifier() != lease.identifier();
        };
        leases.replace(kept);
        self.retire(lease.reset());
    }

    // Puts a connection back as idle.
    recycle(physical is DbPhysical, connection is DbConnection) is void {
        let expired = options.lifetime()::Span::seconds > 0.rat()
            && clock.monotonic_instant().minus(physical.born())::Span::seconds >= options.lifetime()::Span::seconds;
        if self.closed() || connection.closed() || expired {
            self.discard(physical, connection);
        }
        else {
            let old = idle.value();
            let entry = DbIdle(physical: physical, since: clock.monotonic_instant());
            let all is @DbIdle = old + [entry];
            idle.replace(all);
        }
    }

    // Closes the pool.
    close() is void {
        if !self.closed() {
            stopped.set();
            let active = leases.value();
            for active -> lease {
                lease.revoke();
            }
            let unused = idle.value();
            idle.replace([]);
            for unused -> entry {
                let pending = self.close_physical(entry.physical());
                self.retire(pending);
            }
        }
    }

    // Closes one connection.
    async close_physical(physical is DbPhysical) is bool {
        let connection = await physical.connection();
        self.discard(physical, connection);
        true;
    }

    // Waits until every connection has closed.
    async settled() is bool {
        let pending = retiring.value();
        for pending -> record {
            await record.settled();
        }
        let kept is @DbRetirement = retiring.value().filter() -> record {
            !record.complete();
        };
        retiring.replace(kept);
        if kept.size() > 0 {
            await self.settled();
        }
        else {
            if failure.value().size() > 0 {
                throw failure.value()[0];
            }
            true;
        }
    }
}

// A connection leased from a pool.
object PooledConnection does DbConnection, DbExecuting, DbPreparing, Closing {
    has owner is DbPoolState;
    has physical is DbPhysical;
    has origin is DbConnection;
    has permit is Permit;
    has stopped is Event;
    has readers is Atomic<@RowReading>;
    has transactions is Atomic<@Transaction>;
    has preparation is Atomic<@PreparedStatement>;

    // A lease of origin from owner.
    PooledConnection(
        owner is DbPoolState,
        physical is DbPhysical,
        origin is DbConnection,
        permit is Permit
    ) {
        self.owner = owner;
        self.physical = physical;
        self.origin = origin;
        self.permit = permit;
        stopped = Event();
        let no_rows is @RowReading = [];
        readers = Atomic(no_rows);
        let no_transactions is @Transaction = [];
        transactions = Atomic(no_transactions);
        let no_preparation is @PreparedStatement = [];
        preparation = Atomic(no_preparation);
    }

    // The physical connection's number.
    identifier() is int {
        physical.serial();
    }

    // Whether it was returned.
    closed() is bool {
        stopped.ready() || owner.closed() || origin.closed();
    }

    // Runs statement.
    async execution(statement is Statement) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        await origin.execution(statement);
    }

    // Runs statement and reads its rows.
    async rows(statement is Statement) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        let rows = await origin.rows(statement);
        readers.replace([rows]);
        PooledRows(origin: rows, lease_closed: stopped);
    }

    // Prepares text on this connection.
    async prepared(text is string) is PreparedStatement {
        confirm !self.closed() else throw DbClosed.closed;
        let preparing = await physical.preparing();
        let raw = await preparing.prepared(text);
        let published = Event();
        let cleanup = DbUnpublishedPrepared(origin: raw, published: published);
        defer cleanup.close();
        confirm !self.closed() else throw DbClosed.closed;
        let old is @PreparedStatement = preparation.value().filter() -> statement {
            !statement.closed();
        };
        let all is @PreparedStatement = old + [raw];
        preparation.replace(all);
        published.set();
        PooledPrepared(origin: raw, lease_closed: stopped, readers: readers);
    }

    // Begins a transaction.
    async transaction(options is TransactionOptions) is Transaction {
        confirm !self.closed() else throw DbClosed.closed;
        let transaction = await origin.transaction(options);
        transactions.replace([transaction]);
        PooledTransaction(origin: transaction, lease_closed: stopped, readers: readers);
    }

    // Begins a transaction that can prepare statements.
    async prepared_transaction(options is TransactionOptions) is PooledTransaction {
        confirm !self.closed() else throw DbClosed.closed;
        let opening = await physical.transactions();
        let transaction = await opening.prepared_transaction(options);
        transactions.replace([transaction]);
        PooledTransaction(
            origin: transaction,
            lease_closed: stopped,
            readers: readers,
            preparation: transaction
        );
    }

    // Returns it: its cursors and statements close and the pool takes it back.
    close() is void {
        if !stopped.ready() {
            stopped.set();
            for readers.value() -> rows {
                rows.close();
            }
            for preparation.value() -> statement {
                statement.close();
            }
            owner.release(self);
        }
    }

    // Ends the lease at once, dropping the connection.
    revoke() is void {
        origin.close();
        self.close();
    }

    // Rolls back open transactions and waits; true when the connection is
    // reusable.
    async reset() is bool {
        defer permit.close();
        let healthy = try {
            for transactions.value() -> transaction {
                if transaction.active() {
                    await transaction.rollback();
                }
            }
            await origin.settled();
            !origin.closed();
        }
        catch e is Error {
            false;
        }
        catch e is NativeFailure {
            false;
        };
        readers.replace([]);
        transactions.replace([]);
        preparation.replace([]);
        if healthy {
            owner.recycle(physical, origin);
        }
        else {
            owner.discard(physical, origin);
            await origin.settled();
        }
        true;
    }

    // Waits until everything on it has finished.
    async settled() is bool {
        await owner.settled();
    }

    destroy {
        self.close();
    }

    // db.execution(sql, values) and db.query(sql, values).one(): the values
    // are always bound, never pasted into the SQL.
    async execution(sql is string, values is Sequencing<DbValue>) is Execution {
        await self.execution(Statement(text: sql, values: values));
    }

    // The values one by one: db.execution("… = ?", DbInteger(7)).
    async execution(sql is string, values is ...DbValue) is Execution {
        let listed is @DbValue = values...;
        await self.execution(sql, listed);
    }

    // A query of sql with values bound.
    query(sql is string, values is Sequencing<DbValue>) is DbQuery {
        Query(origin: self, statement: Statement(text: sql, values: values));
    }

    // The values one by one: db.query("… = ?", DbInteger(7)).
    query(sql is string, values is ...DbValue) is DbQuery {
        let listed is @DbValue = values...;
        self.query(sql, listed);
    }
}

hidden object PooledRows does RowReading, Closing {
    has origin is RowReading;
    has lease_closed is Event;

    PooledRows(origin is RowReading, lease_closed is Event) {
        self.origin = origin;
        self.lease_closed = lease_closed;
    }

    columns() is Sequencing<Column> {
        origin.columns();
    }

    closed() is bool {
        lease_closed.ready() || origin.closed();
    }

    close() is void {
        origin.close();
    }

    async row() is Row {
        confirm !self.closed() else throw DbClosed.closed;
        await origin.row();
    }

    destroy {
        origin.close();
    }
}

// A transaction on a leased connection.
object PooledTransaction does Transaction, DbExecuting, DbPreparing {
    has origin is Transaction;
    has lease_closed is Event;
    has readers is Atomic<@RowReading>;
    has preparation is @DbPreparing;

    // origin, ending when the lease does.
    PooledTransaction(origin is Transaction, lease_closed is Event, readers is Atomic<@RowReading>) {
        self.origin = origin;
        self.lease_closed = lease_closed;
        self.readers = readers;
        preparation = [];
    }

    // The same, preparing with preparation.
    PooledTransaction(
        origin is Transaction,
        lease_closed is Event,
        readers is Atomic<@RowReading>,
        preparation is DbPreparing
    ) {
        self.origin = origin;
        self.lease_closed = lease_closed;
        self.readers = readers;
        self.preparation = [preparation];
    }

    // Whether it is still open.
    active() is bool {
        !lease_closed.ready() && origin.active();
    }

    // Runs statement.
    async execution(statement is Statement) is Execution {
        confirm self.active() else throw TransactionEnded.ended;
        await origin.execution(statement);
    }

    // Runs statement and reads its rows.
    async rows(statement is Statement) is RowReading {
        confirm self.active() else throw TransactionEnded.ended;
        let rows = await origin.rows(statement);
        readers.replace([rows]);
        PooledRows(origin: rows, lease_closed: lease_closed);
    }

    // Prepares text on this connection.
    async prepared(text is string) is PreparedStatement {
        confirm self.active() else throw TransactionEnded.ended;
        confirm preparation.size() == 1
            else throw DbFailure.detailed(
                DbFailureKind.unsupported,
                DbOperation.preparing,
                "DB_TRANSACTION_PREPARATION_UNAVAILABLE",
                "transaction has no preparation capability"
            );
        let statement = await preparation[0].prepared(text);
        PooledPrepared(origin: statement, lease_closed: lease_closed, readers: readers);
    }

    // Commits.
    async commit() is Transaction {
        confirm !lease_closed.ready() else throw TransactionEnded.ended;
        await origin.commit();
        self;
    }

    // Rolls back.
    async rollback() is Transaction {
        confirm !lease_closed.ready() else throw TransactionEnded.ended;
        await origin.rollback();
        self;
    }

    // db.execution(sql, values) and db.query(sql, values).one(): the values
    // are always bound, never pasted into the SQL.
    async execution(sql is string, values is Sequencing<DbValue>) is Execution {
        await self.execution(Statement(text: sql, values: values));
    }

    // The values one by one: db.execution("… = ?", DbInteger(7)).
    async execution(sql is string, values is ...DbValue) is Execution {
        let listed is @DbValue = values...;
        await self.execution(sql, listed);
    }

    // A query of sql with values bound.
    query(sql is string, values is Sequencing<DbValue>) is DbQuery {
        Query(origin: self, statement: Statement(text: sql, values: values));
    }

    // The values one by one: db.query("… = ?", DbInteger(7)).
    query(sql is string, values is ...DbValue) is DbQuery {
        let listed is @DbValue = values...;
        self.query(sql, listed);
    }
}

hidden object DbUnusedPermit {
    has permit is Permit;
    has published is Event;

    DbUnusedPermit(permit is Permit, published is Event) {
        self.permit = permit;
        self.published = published;
    }

    close() is void {
        if !published.ready() {
            permit.close();
        }
    }
}

hidden object DbUnpublishedPhysical {
    has owner is DbPoolState;
    has physical is DbPhysical;
    has connection is DbConnection;
    has owned is Event;

    DbUnpublishedPhysical(
        owner is DbPoolState,
        physical is DbPhysical,
        connection is DbConnection,
        owned is Event
    ) {
        self.owner = owner;
        self.physical = physical;
        self.connection = connection;
        self.owned = owned;
    }

    async close() is void {
        if !owned.ready() {
            owner.discard(physical, connection);
            await connection.settled();
        }
    }
}

hidden object DbUnclaimedLease {
    has group is FutureGroup<PooledConnection>;
    has pending is Future<PooledConnection>;
    has taken is Event;

    DbUnclaimedLease(
        group is FutureGroup<PooledConnection>,
        pending is Future<PooledConnection>,
        taken is Event
    ) {
        self.group = group;
        self.pending = pending;
        self.taken = taken;
    }

    async close() is void {
        if group.active() > 0 {
            group.cancel();
            await group.wait();
        }
        if !taken.ready() {
            let result is @PooledConnection = try {
                [await pending];
            }
            catch e is Cancelled {
                let empty is @PooledConnection = [];
                empty;
            }
            catch e is Error {
                let empty is @PooledConnection = [];
                empty;
            };
            for result -> lease {
                lease.close();
            }
        }
    }
}

// Pool options out of range.
enum InvalidPoolOptions is Error = (invalid);

hidden object DbRetirement {
    has owner is DbPoolState;
    has pending is Future<bool>;
    has group is FutureGroup<bool>;
    has finished is Event;

    DbRetirement(owner is DbPoolState, pending is Future<bool>) {
        self.owner = owner;
        self.pending = pending;
        group = FutureGroup();
        finished = Event();
    }

    start() is void {
        group.start(self.run());
    }

    complete() is bool {
        finished.ready();
    }

    async run() is bool {
        defer finished.set();
        try {
            await pending;
        }
        catch e is Error {
            owner.failed(e);
            false;
        }
        catch e is NativeFailure {
            owner.failed(
                DbFailure.detailed(
                    DbFailureKind.connection,
                    DbOperation.closing,
                    e.code(),
                    "database pool cleanup failed"
                )
            );
            false;
        }
    }

    async settled() is bool {
        await group.wait();
        true;
    }
}

test "pool bounds precede physical acquisition" {
    let zero = Duration(seconds: 0);
    let one = Duration(seconds: 1);
    test.ok(try {
        PoolOptions(
            minimum: 2,
            maximum: 1,
            idle_timeout: zero,
            lifetime: zero,
            acquisition_timeout: one
        );
        false;
    }
    catch e is InvalidPoolOptions {
        true;
    });
    test.ok(try {
        PoolOptions(
            minimum: 0,
            maximum: 1,
            idle_timeout: zero,
            lifetime: zero,
            acquisition_timeout: zero
        );
        false;
    }
    catch e is InvalidPoolOptions {
        true;
    });
}

hidden object PooledPrepared does PreparedStatement, Closing {
    has origin is PreparedStatement;
    has lease_closed is Event;
    has readers is Atomic<@RowReading>;

    PooledPrepared(
        origin is PreparedStatement,
        lease_closed is Event,
        readers is Atomic<@RowReading>
    ) {
        self.origin = origin;
        self.lease_closed = lease_closed;
        self.readers = readers;
    }

    closed() is bool {
        lease_closed.ready() || origin.closed();
    }

    close() is void {
        origin.close();
    }

    async execution(values is Sequencing<DbValue>) is Execution {
        confirm !self.closed() else throw DbClosed.closed;
        await origin.execution(values);
    }

    // The values one by one: statement.execution(DbInteger(7)).
    async execution(values is ...DbValue) is Execution {
        let listed is @DbValue = values...;
        await self.execution(listed);
    }

    async rows(values is Sequencing<DbValue>) is RowReading {
        confirm !self.closed() else throw DbClosed.closed;
        let rows = await origin.rows(values);
        readers.replace([rows]);
        PooledRows(origin: rows, lease_closed: lease_closed);
    }

    // The values one by one: statement.rows(DbInteger(7)).
    async rows(values is ...DbValue) is RowReading {
        let listed is @DbValue = values...;
        await self.rows(listed);
    }

    destroy {
        origin.close();
    }
}

hidden object DbUnpublishedPrepared {
    has origin is PreparedStatement;
    has published is Event;

    DbUnpublishedPrepared(origin is PreparedStatement, published is Event) {
        self.origin = origin;
        self.published = published;
    }

    close() is void {
        if !published.ready() {
            origin.close();
        }
    }
}

// Opens transactions on a lease.
object PooledTransactions {
    has origin is PooledConnection;

    // On origin.
    PooledTransactions(origin is PooledConnection) {
        self.origin = origin;
    }

    // Begins a transaction with options.
    async transaction(options is TransactionOptions) is PooledTransaction {
        await origin.prepared_transaction(options);
    }
}
