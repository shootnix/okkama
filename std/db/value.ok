module db/value v1.0.0;

import "runtime/db" as native_db;
import "numbers/bigint" take BigInt;
import "math/decimal" take Decimal;
import "encoding/utf" take Utf8Encoded;
import "async/atomic" take Atomic;

enum DbValueKind = (null_value, boolean, integer, floating, decimal, text, bytes);

// A role-confined consumer sees one typed printing protocol, never concrete
// getters obtained by downcasting or reflection.
role DbValue {
    kind() is DbValueKind;
    print(output is DbValueWriting) is void;
}

role DbValueWriting {
    null_value() is void;
    boolean(value is bool) is void;
    integer(value is BigInt) is void;
    floating(value is float) is void;
    decimal(value is Decimal) is void;
    text(value is string) is void;
    bytes(value is @byte) is void;
}

// The typed values bound to a statement (#188): DbInteger(7), DbText("Ada"),
// DbBoolean(true), DbFloating(1.5), DbDecimal(Decimal("9.50")),
// DbBytes(data) and DbNull(). Each also takes a Maybe, whose none binds SQL
// NULL: DbText(user.nickname).
object DbNull does DbValue {
    DbNull();

    kind() is DbValueKind {
        DbValueKind.null_value;
    }

    print(output is DbValueWriting) is void {
        output.null_value();
    }
}

object DbBoolean does DbValue {
    has origin is bool;
    has present is bool;

    DbBoolean(value is bool) {
        origin = value;
        present = true;
    }

    DbBoolean(value is Maybe<bool>) {
        origin = value else false;
        present = DbPresence(value != Maybe<bool>.none).present();
    }

    kind() is DbValueKind {
        if present {
            DbValueKind.boolean;
        }
        else {
            DbValueKind.null_value;
        }
    }

    bool() is bool {
        confirm present else throw InvalidDbValue.because("NULL has no boolean");
        origin;
    }

    print(output is DbValueWriting) is void {
        if present {
            output.boolean(origin);
        }
        else {
            output.null_value();
        }
    }
}

// An integer of at most 4096 digits; it keeps the int (#188).
object DbInteger does DbValue {
    has origin is int;
    has present is bool;

    DbInteger(value is int) {
        DbIntegerDigits(value).check();
        origin = value;
        present = true;
    }

    DbInteger(value is BigInt) {
        let number = value.int();
        DbIntegerDigits(number).check();
        origin = number;
        present = true;
    }

    DbInteger(value is Maybe<int>) {
        let number = value else 0;
        DbIntegerDigits(number).check();
        origin = number;
        present = DbPresence(value != Maybe<int>.none).present();
    }

    DbInteger(value is Maybe<BigInt>) {
        let number = match value {
            case Maybe.some(given) {
                given.int();
            }
            else {
                0;
            }
        };
        DbIntegerDigits(number).check();
        origin = number;
        present = DbPresence(value != Maybe<BigInt>.none).present();
    }

    kind() is DbValueKind {
        if present {
            DbValueKind.integer;
        }
        else {
            DbValueKind.null_value;
        }
    }

    integer() is BigInt {
        confirm present else throw InvalidDbValue.because("NULL has no integer");
        BigInt(origin);
    }

    int() is int {
        confirm present else throw InvalidDbValue.because("NULL has no integer");
        origin;
    }

    print(output is DbValueWriting) is void {
        if present {
            output.integer(BigInt(origin));
        }
        else {
            output.null_value();
        }
    }
}

object DbFloating does DbValue {
    has origin is float;
    has present is bool;

    DbFloating(value is float) {
        origin = DbFinite(value).float();
        present = true;
    }

    DbFloating(value is Maybe<float>) {
        origin = DbFinite(value else 0.0).float();
        present = DbPresence(value != Maybe<float>.none).present();
    }

    kind() is DbValueKind {
        if present {
            DbValueKind.floating;
        }
        else {
            DbValueKind.null_value;
        }
    }

    float() is float {
        confirm present else throw InvalidDbValue.because("NULL has no float");
        origin;
    }

    print(output is DbValueWriting) is void {
        if present {
            output.floating(origin);
        }
        else {
            output.null_value();
        }
    }
}

object DbDecimal does DbValue {
    has origin is Decimal;
    has present is bool;

    DbDecimal(value is Decimal) {
        confirm value.string().length() <= 4096 else throw DbValueLimit.because("decimal digits");
        origin = value;
        present = true;
    }

    DbDecimal(value is Maybe<Decimal>) {
        let number = value else Decimal(0);
        confirm number.string().length() <= 4096 else throw DbValueLimit.because("decimal digits");
        origin = number;
        present = DbPresence(value != Maybe<Decimal>.none).present();
    }

    kind() is DbValueKind {
        if present {
            DbValueKind.decimal;
        }
        else {
            DbValueKind.null_value;
        }
    }

    decimal() is Decimal {
        confirm present else throw InvalidDbValue.because("NULL has no decimal");
        origin;
    }

    print(output is DbValueWriting) is void {
        if present {
            output.decimal(origin);
        }
        else {
            output.null_value();
        }
    }
}

object DbText does DbValue {
    has origin is string;
    has width is int;
    has present is bool;

    DbText(value is string) {
        width = DbTextWidth(value).bytes();
        origin = value;
        present = true;
    }

    DbText(value is Maybe<string>) {
        let text = value else "";
        width = DbTextWidth(text).bytes();
        origin = text;
        present = DbPresence(value != Maybe<string>.none).present();
    }

    width() is int {
        width;
    }

    kind() is DbValueKind {
        if present {
            DbValueKind.text;
        }
        else {
            DbValueKind.null_value;
        }
    }

    string() is string {
        confirm present else throw InvalidDbValue.because("NULL has no text");
        origin;
    }

    print(output is DbValueWriting) is void {
        if present {
            output.text(origin);
        }
        else {
            output.null_value();
        }
    }
}

object DbBytes does DbValue {
    has origin is @byte;
    has present is bool;

    DbBytes(value is @byte) {
        confirm value.size() <= 8388608 else throw DbValueLimit.because("binary bytes");
        origin = value;
        present = true;
    }

    DbBytes(value is Maybe<@byte>) {
        let empty is @byte = [];
        let data = value else empty;
        confirm data.size() <= 8388608 else throw DbValueLimit.because("binary bytes");
        origin = data;
        present = DbPresence(value != Maybe<@byte>.none).present();
    }

    kind() is DbValueKind {
        if present {
            DbValueKind.bytes;
        }
        else {
            DbValueKind.null_value;
        }
    }

    bytes() is @byte {
        confirm present else throw InvalidDbValue.because("NULL has no bytes");
        origin;
    }

    print(output is DbValueWriting) is void {
        if present {
            output.bytes(origin);
        }
        else {
            output.null_value();
        }
    }
}

// Whether a Maybe held a value, so a constructor can say it in one line.
hidden object DbPresence {
    has given is bool;

    DbPresence(given is bool) {
        self.given = given;
    }

    present() is bool {
        given;
    }
}

// At most 4096 digits; an int of 64 bits never has more than 19.
hidden object DbIntegerDigits {
    has value is int;

    DbIntegerDigits(value is int) {
        self.value = value;
    }

    check() is void {
        if value >= -9223372036854775808 && value <= 9223372036854775807 {
            return;
        }
        confirm value.abs().string().length() <= 4096
            else throw DbValueLimit.because("integer digits");
    }
}

// A finite float.
hidden object DbFinite {
    has value is float;

    DbFinite(value is float) {
        self.value = value;
    }

    float() is float {
        let text = value.string();
        confirm text != "NaN"
            && text != "Inf"
            && text != "-Inf"
            && text != "nan"
            && text != "inf"
            && text != "-inf"
            else throw InvalidDbValue.because("finite floating value required");
        value;
    }
}

// The UTF-8 size of a text of at most 8 MiB.
hidden object DbTextWidth {
    has value is string;

    DbTextWidth(value is string) {
        self.value = value;
    }

    bytes() is int {
        confirm value.length() <= 8388608 else throw DbValueLimit.because("text bytes");
        let size = Utf8Encoded(value).bytes().size();
        confirm size <= 8388608 else throw DbValueLimit.because("text bytes");
        size;
    }
}

// Print once, validate the event protocol, retain a canonical immutable value.
// Later observations never invoke the caller's printer again.
object ObservedDbValue {
    has captured is DbValueCapture;
    has origin is DbValue;
    has kind is DbValueKind;
    has state is native_db.DbCellState;

    ObservedDbValue(origin is DbValue) {
        let expected = origin.kind();
        kind = expected;
        let capture = DbValueCapture(expected);
        origin.print(capture);
        capture.finish();
        captured = capture;
        let cell = capture.state();
        state = cell;
        self.origin = DbNativeValue(cell);
    }

    kind() is DbValueKind {
        kind;
    }

    cell() is DbValue {
        origin;
    }

    boolean() is bool {
        captured.boolean_value();
    }

    integer() is BigInt {
        captured.integer_value();
    }

    floating() is float {
        captured.floating_value();
    }

    decimal() is Decimal {
        captured.decimal_value();
    }

    text() is string {
        captured.text_value();
    }

    bytes() is @byte {
        captured.bytes_value();
    }

    width() is int {
        captured.width();
    }

    state() is native_db.DbCellState {
        state;
    }
}

// The print protocol: exactly one event of the declared kind, its value, then
// the capture is sealed. Flags: 1 started, 2 faulted, 4 poisoned, 8 sealed.
object DbValueCapture does DbValueWriting {
    has kind is DbValueKind;
    has flags is Atomic<int>;
    has cell is Atomic<@native_db.DbCellState>;

    DbValueCapture(kind is DbValueKind) {
        self.kind = kind;
        flags = Atomic(0);
        let empty is @native_db.DbCellState = [];
        cell = Atomic(empty);
    }

    emit(kind is DbValueKind) is void {
        let current = flags.value();
        confirm current & 8 == 0 else throw InvalidDbValue.because("printer is sealed");
        if current & 3 != 0 || kind != self.kind {
            flags.replace(current | 6);
            throw InvalidDbValue.because("print must emit exactly one event of its declared kind");
        }
        flags.replace(current | 3);
    }

    // Writers publish a cell of the kind they emitted, so an accepted cell has
    // the declared kind.
    published(value is native_db.DbCellState) is void {
        let current = flags.value();
        let valid = current & 13 == 1 && cell.value().size() == 0;
        if valid {
            cell.replace([value]);
            flags.replace(current & 13);
        }
        else {
            if current & 8 == 0 {
                flags.replace(current | 2);
            }
        }
        confirm valid else throw InvalidDbValue.because("print omitted or invalidated its value");
    }

    complete() is void {
        confirm self.completed()
            else throw InvalidDbValue.because("print omitted or invalidated its value");
    }

    finish() is void {
        confirm self.completed()
            else throw InvalidDbValue.because("print omitted or invalidated its value");
        flags.replace(flags.value() | 8);
    }

    require(kind is DbValueKind) is void {
        confirm self.kind == kind else throw WrongDbValue.detailed(kind, self.kind);
        self.complete();
    }

    state() is native_db.DbCellState {
        self.complete();
        cell.value()[0];
    }

    completed() is bool {
        flags.value() & 3 == 1 && cell.value().size() == 1;
    }

    null_value() is void {
        self.emit(DbValueKind.null_value);
        self.published(native_db.db_null());
    }

    boolean(value is bool) is void {
        self.emit(DbValueKind.boolean);
        self.published(native_db.db_boolean(DbBoolean(value).bool()));
    }

    boolean_value() is bool {
        self.require(DbValueKind.boolean);
        native_db.db_boolean_value(self.state());
    }

    integer(value is BigInt) is void {
        self.emit(DbValueKind.integer);
        self.published(native_db.db_integer(DbInteger(value).int().string()));
    }

    integer_value() is BigInt {
        self.require(DbValueKind.integer);
        BigInt(native_db.db_integer_value(self.state()));
    }

    floating(value is float) is void {
        self.emit(DbValueKind.floating);
        self.published(native_db.db_floating(DbFloating(value).float()));
    }

    floating_value() is float {
        self.require(DbValueKind.floating);
        native_db.db_floating_value(self.state());
    }

    decimal(value is Decimal) is void {
        self.emit(DbValueKind.decimal);
        self.published(native_db.db_decimal(DbDecimal(value).decimal().string()));
    }

    decimal_value() is Decimal {
        self.require(DbValueKind.decimal);
        Decimal(native_db.db_decimal_value(self.state()));
    }

    text(value is string) is void {
        self.emit(DbValueKind.text);
        self.published(native_db.db_text(DbText(value).string()));
    }

    text_value() is string {
        self.require(DbValueKind.text);
        native_db.db_text_value(self.state());
    }

    bytes(value is @byte) is void {
        self.emit(DbValueKind.bytes);
        self.published(native_db.db_bytes(DbBytes(value).bytes()));
    }

    bytes_value() is @byte {
        self.require(DbValueKind.bytes);
        native_db.db_bytes_value(self.state());
    }

    cell() is DbValue {
        DbNativeValue(self.state());
    }

    width() is int {
        native_db.db_cells_bytes([self.state()]);
    }
}

hidden object DbKindCode {
    has kind is DbValueKind;

    DbKindCode(kind is DbValueKind) {
        self.kind = kind;
    }

    code() is int {
        match kind {
            case DbValueKind.null_value {
                0;
            }
            case DbValueKind.boolean {
                1;
            }
            case DbValueKind.integer {
                2;
            }
            case DbValueKind.floating {
                3;
            }
            case DbValueKind.decimal {
                4;
            }
            case DbValueKind.text {
                5;
            }
            case DbValueKind.bytes {
                6;
            }
        }
    }
}

enum WrongDbValue is Error = (detailed(expected_kind is DbValueKind, actual_kind is DbValueKind));

enum InvalidDbValue is Error = (because(reason is string));

enum DbValueLimit is Error = (because(reason is string));

test "database NULL remains separate from empty text" {
    test.ok(ObservedDbValue(DbNull()).kind() == DbValueKind.null_value);
    test.is(ObservedDbValue(DbText("")).text(), "");
}

// Compatibility view of an owned immutable native cell. No cursor ownership.
object DbNativeValue does DbValue {
    has state is native_db.DbCellState;

    DbNativeValue(state is native_db.DbCellState) {
        self.state = state;
    }

    kind() is DbValueKind {
        DbNativeKind(native_db.db_kind(state)).kind();
    }

    print(output is DbValueWriting) is void {
        match self.kind() {
            case DbValueKind.null_value {
                output.null_value();
            }
            case DbValueKind.boolean {
                output.boolean(native_db.db_boolean_value(state));
            }
            case DbValueKind.integer {
                output.integer(BigInt(native_db.db_integer_value(state)));
            }
            case DbValueKind.floating {
                output.floating(native_db.db_floating_value(state));
            }
            case DbValueKind.decimal {
                output.decimal(Decimal(native_db.db_decimal_value(state)));
            }
            case DbValueKind.text {
                output.text(native_db.db_text_value(state));
            }
            case DbValueKind.bytes {
                output.bytes(native_db.db_bytes_value(state));
            }
        }
    }
}

object DbNativeKind {
    has code is int;

    DbNativeKind(code is int) {
        self.code = code;
    }

    kind() is DbValueKind {
        match code {
            case 0 {
                DbValueKind.null_value;
            }
            case 1 {
                DbValueKind.boolean;
            }
            case 2 {
                DbValueKind.integer;
            }
            case 3 {
                DbValueKind.floating;
            }
            case 4 {
                DbValueKind.decimal;
            }
            case 5 {
                DbValueKind.text;
            }
            case 6 {
                DbValueKind.bytes;
            }
            else {
                throw InvalidDbValue.because("unknown native kind");
            }
        }
    }
}
