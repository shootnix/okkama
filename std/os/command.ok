module os/command v1.0.0;

import "fs/directory" take DirectoryLocating;
import "fs/path" take Path;
import "os/directory" take WorkingDirectory;
import "os/environment" take Environment;

// Commanding is the immutable description accepted by process consumers. It
// never invokes a shell: every argument remains one exact string.
//
// Command retains a completely explicit execution context. A Path containing
// a directory component selects that executable directly. A bare Path such as
// Path("git") asks the runtime to search PATH from this command's Environment:
//
//     let status is Commanding = Command(
//         program: Path("/usr/bin/git"),
//         arguments: ["status", "--short"],
//         environment: environment,
//         directory: repository,
//     );
//
// InheritedCommand deliberately observes the process environment and working
// directory through its corresponding actions. Its constructor only retains
// the program and arguments:
//
//     let version is Commanding = InheritedCommand(
//         program: Path("/usr/bin/git"),
//         arguments: ["--version"],
//     );
//
// Use Path("git") to search PATH from the command's own Environment. The
// runtime performs direct process lookup; no shell parses the name or args.
//
// string() is diagnostic and never shell-round-trippable. It omits the
// environment, but arguments themselves can still contain secrets.

// A program to run, its arguments, environment and directory; never a shell
// line.
role Commanding {
    // The program: a path with a directory runs that file, a bare name is
    // looked up in PATH.
    program() is Path;
    // The arguments, each one exact string.
    arguments() is @string;
    // The environment the program gets.
    environment() is Environment;
    // The directory it runs in.
    directory() is DirectoryLocating;
    // A line for logs and errors, not for a shell; it leaves out the
    // environment.
    string() is string;
}

// A command with everything given: program, arguments, environment and
// directory.
object Command does Commanding {
    has command_program is Path;
    has command_arguments is @string;
    has command_environment is Environment;
    has command_directory is DirectoryLocating;

    // Runs program with arguments in directory, with exactly environment.
    Command(
        program is Path,
        environment is Environment,
        directory is DirectoryLocating,
        arguments is @string = [],
    ) {
        command_program = program;
        command_arguments = arguments;
        command_environment = environment;
        command_directory = directory;
    }

    // The program.
    program() is Path {
        command_program;
    }

    // The arguments.
    arguments() is @string {
        command_arguments;
    }

    // The environment given.
    environment() is Environment {
        command_environment;
    }

    // The directory given.
    directory() is DirectoryLocating {
        command_directory;
    }

    // The program and arguments, for logs.
    string() is string {
        "Command(program: " +
            self.quoted(command_program.string()) +
            ", arguments: [" +
            self.rendered_arguments() +
            "], directory: " +
            self.quoted(command_directory.path().string()) +
            ")";
    }

    hidden rendered_arguments() is string {
        self.rendered_arguments_from(0);
    }

    hidden rendered_arguments_from(index is int) is string {
        if index >= command_arguments.size() {
            "";
        }
        else {
            self.quoted(command_arguments[index]) +
                if index + 1 < command_arguments.size() {
                    ", " + self.rendered_arguments_from(index + 1);
                }
                else {
                    "";
                };
        }
    }

    hidden quoted(origin is string) is string {
        "\"" +
            origin
            .replace("\\", "\\\\")
            .replace("\"", "\\\"")
            .replace("\n", "\\n")
            .replace("\r", "\\r")
            .replace("\t", "\\t") +
            "\"";
    }
}

// A command that takes the process's environment and working directory.
object InheritedCommand does Commanding {
    has command_program is Path;
    has command_arguments is @string;

    // Runs program with arguments, inheriting the rest.
    InheritedCommand(
        program is Path,
        arguments is @string = [],
    ) {
        command_program = program;
        command_arguments = arguments;
    }

    // The program.
    program() is Path {
        command_program;
    }

    // The arguments.
    arguments() is @string {
        command_arguments;
    }

    // The process environment, read when asked.
    environment() is Environment {
        Environment();
    }

    // The working directory of the process.
    directory() is DirectoryLocating {
        WorkingDirectory();
    }

    // The program and arguments, for logs.
    string() is string {
        "Command(program: " +
            self.quoted(command_program.string()) +
            ", arguments: [" +
            self.rendered_arguments() +
            "], directory: " +
            self.quoted(self.directory().path().string()) +
            ")";
    }

    hidden rendered_arguments() is string {
        self.rendered_arguments_from(0);
    }

    hidden rendered_arguments_from(index is int) is string {
        if index >= command_arguments.size() {
            "";
        }
        else {
            self.quoted(command_arguments[index]) +
                if index + 1 < command_arguments.size() {
                    ", " + self.rendered_arguments_from(index + 1);
                }
                else {
                    "";
                };
        }
    }

    hidden quoted(origin is string) is string {
        "\"" +
            origin
            .replace("\\", "\\\\")
            .replace("\"", "\\\"")
            .replace("\n", "\\n")
            .replace("\r", "\\r")
            .replace("\t", "\\t") +
            "\"";
    }
}

test "a command keeps its context exactly; string() quotes every argument" {
    let env = Environment(values: ["LANG": "C"]);
    let here = WorkingDirectory();
    let command = Command(
        program: Path("/usr/bin/git"),
        arguments: ["log", "--format=%h \"%s\"", "a\tb"],
        environment: env,
        directory: here,
    );
    test.is(command.program(), Path("/usr/bin/git"));
    test.is(command.arguments(), ["log", "--format=%h \"%s\"", "a\tb"]);
    test.ok(command.environment() == env);
    test.is(command.directory().path(), here.path());
    test.is(
        command.string(),
        "Command(program: \"/usr/bin/git\", arguments: [\"log\", \"--format=%h \\\"%s\\\"\", \"a\\tb\"], directory: \""
            + here.path().string() + "\")",
    );
    let bare = Command(program: Path("git"), arguments: [], environment: env, directory: here);
    test.is(bare.string(), "Command(program: \"git\", arguments: [], directory: \"" + here.path().string() + "\")");
}

test "an inherited command observes the process environment and directory" {
    let command = InheritedCommand(program: Path("printf"), arguments: ["x"]);
    test.ok(command.environment() == Environment());
    test.is(command.directory().path(), WorkingDirectory().path());
    test.is(command.arguments(), ["x"]);
}
