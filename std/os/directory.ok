module os/directory v1.0.0;

import "fs/directory" take DirectoryLocating;
import "fs/error" take FileError, FileFailure;
import "fs/path" take Path;
import "runtime/fs" take cwd, path_decode;

// WorkingDirectory denotes the process working directory without changing it.
// Its constructor performs no runtime work; path() observes the directory at
// the moment it is called:
//
//     let working = WorkingDirectory();
//     output.writeln(working.path().string());
//
// It can be passed directly to APIs that need a directory location:
//
//     for DirectoryEntries(origin: working) -> entry {
//         output.writeln(entry.path().string());
//     }
//
// This module deliberately exposes no process-global chdir operation. Supply
// a DirectoryLocating object explicitly to commands and filesystem objects.

object WorkingDirectory does DirectoryLocating {
    WorkingDirectory();

    path() is Path {
        try {
            Path(path_decode(cwd()));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }
}

test "the working directory is an absolute path" {
    let here = WorkingDirectory().path();
    test.ok(here.absolute());
    test.is(WorkingDirectory().path(), here);
}
