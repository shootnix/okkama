module os/process v1.0.0;

import "io/stream" take ByteSource, Writing, WritingText, Reading, Closing, IncompleteWrite, InvalidReadLimit;
import "encoding/utf" take Utf8Decoded, Utf8Encoded;
import "fs/path" take Path;
import "io/decorators" take ByteSnapshot;
import "io/buffer" take ByteBuffer;
import "async/atomic" take Atomic;
import "os/command" take Command, Commanding, InheritedCommand;
import "os/directory" take WorkingDirectory;
import "os/environment" take Environment;
import "runtime/process" take ProcessState, process_state_create, process_state_start,
    process_state_started, process_state_id, process_state_running, process_state_exit,
    process_state_signal, process_state_close, process_state_input_write, process_state_input_flush,
    process_state_input_closed, process_state_input_close, process_state_output_read,
    process_state_errors_read;

// Process owns one shared lazy runtime state. Constructing Process and its
// stream views does not spawn. id(), running(), exit(), signal() and every
// stream operation start the command exactly once. close() is the exception:
// closing an unstarted Process never launches it.
//
// Close stdin to deliver EOF without terminating the child:
//
//     let process = Process(command: command);
//     let input = ProcessInput(origin: process);
//     input.write(payload);
//     input.close();
//     let exit = await process.exit();
//
// Direct users must drain stdout and stderr concurrently with waiting when a
// child can produce substantial output. CommandCapture provides that higher-
// level orchestration. Process.close() is idempotent; it forcefully stops and
// reaps a running child and discards unread pipe data.

enum Signal = (interrupt, terminate, kill);

enum ExitKind = (exited, interrupted, terminated, killed, other);

object Exit {
    has classification is ExitKind;
    has exit_code is int;

    Exit(kind is ExitKind, code is int) {
        classification = kind;
        exit_code = code;
    }

    // How the process ended.
    cap Status {
        kind is ExitKind {
            classification;
        }
    }

    code() is int {
        confirm classification == ExitKind.exited else throw MissingExitCode.missing;
        exit_code;
    }

    success() is bool {
        classification == ExitKind.exited && exit_code == 0;
    }
}

object Process {
    has origin is Commanding;
    has state is ProcessState;

    Process(command is Commanding) {
        origin = command;
        state = process_state_create();
    }

    // Its stdin, stdout and stderr: process.input().write("text\n").
    input() is ProcessInput {
        ProcessInput(origin: self);
    }

    output() is ProcessOutput {
        ProcessOutput(origin: self);
    }

    errors() is ProcessErrors {
        ProcessErrors(origin: self);
    }

    id() is int {
        self.start();
        try {
            process_state_id(state);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }

    running() is bool {
        self.start();
        try {
            process_state_running(state);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }

    async exit() is Exit {
        self.start();
        let status is %string:int = try {
            await process_state_exit(state);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        };
        let kind is ExitKind = if status["state"] == 1 {
            ExitKind.exited;
        }
        else {
            match status["code"] {
                case 1 {
                    ExitKind.terminated;
                }
                case 2 {
                    ExitKind.killed;
                }
                case 3 {
                    ExitKind.interrupted;
                }
                else {
                    ExitKind.other;
                }
            }
        };
        Exit(kind: kind, code: status["code"]);
    }

    signal(value is Signal) is void {
        self.start();
        let code is int = if value == Signal.interrupt {
            0;
        }
        else {
            if value == Signal.terminate {
                1;
            }
            else {
                2;
            }
        };
        try {
            process_state_signal(state, code);
        }
        catch failure is NativeFailure {
            if failure.code() == "unsupported" {
                throw UnsupportedSignal.signal(value);
            }
            else {
                throw ProcessFailure.detailed(failure.code(), failure.message());
            }
        }
    }

    close() is void {
        try {
            process_state_close(state);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }

    input_write(source is ByteSource) is void {
        self.start();
        let content is @byte = source.bytes();
        let written is int = try {
            process_state_input_write(state, content);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        };
        confirm written == content.size() else throw IncompleteWrite.after(written);
    }

    input_flush() is void {
        self.start();
        try {
            process_state_input_flush(state);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }

    input_closed() is bool {
        try {
            process_state_input_closed(state);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }

    input_close() is void {
        if !self.input_closed() {
            self.start();
            try {
                process_state_input_close(state);
            }
            catch failure is NativeFailure {
                throw ProcessFailure.detailed(failure.code(), failure.message());
            }
        }
    }

    output_bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        self.start();
        try {
            process_state_output_read(state, limit);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }

    error_bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        self.start();
        try {
            process_state_errors_read(state, limit);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }

    hidden start() is void {
        if !self.started() {
            try {
                process_state_start(
                    state,
                    origin.program().string(),
                    origin.arguments(),
                    origin.directory().path().string(),
                    origin.environment().variables(),
                );
            }
            catch failure is NativeFailure {
                throw ProcessFailure.detailed(failure.code(), failure.message());
            }
        }
    }

    hidden started() is bool {
        try {
            process_state_started(state);
        }
        catch failure is NativeFailure {
            throw ProcessFailure.detailed(failure.code(), failure.message());
        }
    }
}

object ProcessInput does Writing, WritingText, Closing {
    has owner is Process;

    ProcessInput(origin is Process) {
        owner = origin;
    }

    write(source is ByteSource) is void {
        owner.input_write(source);
    }

    // Text, as UTF-8.
    write(values is ...string) is void {
        let text is @string = values...;
        owner.input_write(ByteSnapshot(Utf8Encoded(text.join("")).bytes()));
    }

    writeln(values is ...string) is void {
        let text is @string = values...;
        owner.input_write(ByteSnapshot(Utf8Encoded(text.join("") + "\n").bytes()));
    }

    flush() is void {
        owner.input_flush();
    }

    closed() is bool {
        owner.input_closed();
    }

    close() is void {
        owner.input_close();
    }
}

object ProcessOutput does Reading {
    has owner is Process;

    ProcessOutput(origin is Process) {
        owner = origin;
    }

    bytes(limit is int) is @byte {
        owner.output_bytes(limit);
    }

    // Everything up to the end of the stream as UTF-8 text, at most limit
    // bytes; more throws OutputLimitExceeded.
    text(limit is int) is string {
        Utf8Decoded(ProcessStreamDrain(owner: owner, errors: false, limit: limit).bytes()).string();
    }
}

object ProcessErrors does Reading {
    has owner is Process;

    ProcessErrors(origin is Process) {
        owner = origin;
    }

    bytes(limit is int) is @byte {
        owner.error_bytes(limit);
    }

    // Everything up to the end of the stream as UTF-8 text, at most limit bytes.
    text(limit is int) is string {
        Utf8Decoded(ProcessStreamDrain(owner: owner, errors: true, limit: limit).bytes()).string();
    }
}

// One output stream of a process read to its end, within a limit.
hidden object ProcessStreamDrain {
    has owner is Process;
    has errors is bool;
    has limit is int;

    ProcessStreamDrain(owner is Process, errors is bool, limit is int) {
        confirm limit >= 0 else throw InvalidReadLimit.limit(limit);
        self.owner = owner;
        self.errors = errors;
        self.limit = limit;
    }

    bytes() is @byte {
        let joined = ByteBuffer();
        defer joined.closing().close();
        let output = joined.writing();
        let taken = Atomic(0);
        loop {
            let chunk = if errors {
                owner.error_bytes(65536);
            }
            else {
                owner.output_bytes(65536);
            };
            last if chunk.size() == 0;
            taken.replace(taken.value() + chunk.size());
            confirm taken.value() <= limit else throw OutputLimitExceeded.limit(limit);
            output.write(ByteSnapshot(chunk));
        }
        joined.content().bytes();
    }
}

enum OutputLimitExceeded is Error = (limit(limit is int));

enum MissingExitCode is Error = (missing);

enum UnsupportedSignal is Error = (signal(signal is Signal));

enum ProcessFailure is Error = (detailed(code is string, message is string));

test "an exit tells how the process ended; only an exited one has a code" {
    let ok = Exit(kind: ExitKind.exited, code: 0);
    test.ok(ok.success());
    test.ok(ok::Status::kind == ExitKind.exited);
    test.is(ok.code(), 0);
    let failed = Exit(kind: ExitKind.exited, code: 2);
    test.ok(!failed.success());
    test.is(failed.code(), 2);
    let killed = Exit(kind: ExitKind.killed, code: 9);
    test.ok(!killed.success());
    test.throws(MissingExitCode) {
        killed.code();
    };
}

async test "a process is fed through its input and read through its output" {
    let process = Process(command: Command(
        program: Path("cat"),
        arguments: [],
        environment: Environment(),
        directory: WorkingDirectory(),
    ));
    let input = ProcessInput(origin: process);
    input.write(ByteSnapshot([byte(111), byte(107)]));
    input.flush();
    test.ok(!input.closed());
    input.close();
    test.ok(input.closed());
    test.ok(process.id() > 0);
    let output = ProcessOutput(origin: process);
    let first is @byte = output.bytes(1);
    let rest is @byte = output.bytes(16);
    test.is(Utf8Decoded(origin: first + rest).string(), "ok");
    test.is(output.bytes(16), []);
    test.is(ProcessErrors(origin: process).bytes(16), []);
    let exit = await process.exit();
    test.ok(exit.success());
    test.ok(!process.running());
    process.close();
    process.close();
}

async test "a process takes text and answers text" {
    let process = Process(command: InheritedCommand(program: Path("cat")));
    let input = process.input();
    input.write("héllo", " ");
    input.writeln("world");
    input.close();
    test.is(process.output().text(limit: 64), "héllo world\n");
    test.is(process.errors().text(limit: 64), "");
    test.ok((await process.exit()).success());
    process.close();

    let noisy = Process(command: InheritedCommand(program: Path("printf"), arguments: ["0123456789"]));
    test.throws(OutputLimitExceeded) {
        noisy.output().text(limit: 4);
    };
    await noisy.exit();
    noisy.close();
}

async test "a signal ends a running process" {
    let process = Process(command: Command(
        program: Path("sleep"),
        arguments: ["30"],
        environment: Environment(),
        directory: WorkingDirectory(),
    ));
    test.ok(process.running());
    process.signal(Signal.terminate);
    let exit = await process.exit();
    test.ok(exit::Status::kind == ExitKind.terminated);
    test.ok(!exit.success());
    process.close();
}

test "closing a process that never started does not start it" {
    let process = Process(command: Command(
        program: Path("okkama-no-such-program-7f3a"),
        arguments: [],
        environment: Environment(),
        directory: WorkingDirectory(),
    ));
    process.close();
    test.throws(InvalidReadLimit) {
        process.output_bytes(0);
    };
}
