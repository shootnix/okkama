module os/platform v1.0.0;

import "encoding/utf" take ByteOrder;
import "runtime/system" take system_platform, system_architecture, system_byte_order,
    system_host_name, system_cpu_count;

// Platform answers the portable runtime identity when asked. Consumers
// branch only on the deliberately small OperatingSystem enum; less common
// systems remain usable through OperatingSystem.other and architecture().
//
//     let platform = Platform();
//     match platform.operating_system() {
//         case OperatingSystem.windows { configure_windows(); }
//         case OperatingSystem.macos { configure_macos(); }
//         case OperatingSystem.linux { configure_linux(); }
//         else { configure_portable(); }
//     }
//
// Byte order describes the running machine. Serialized formats must still
// choose their byte order explicitly instead of inheriting this value:
//
//     output.writeln(platform.architecture());
//     if platform.byte_order() == ByteOrder.little {
//         output.writeln("little-endian host");
//     }

// The few operating systems code usually branches on; others are other.
enum OperatingSystem = (linux, macos, windows, freebsd, other);

// The system and machine the program runs on.
object Platform {
    // The running platform.
    Platform();

    // Which operating system.
    operating_system() is OperatingSystem {
        let platform is string = try {
            system_platform();
        }
        catch failure is NativeFailure {
            panic "System provider could not identify the operating system";
        };
        match platform {
            case "linux" {
                OperatingSystem.linux;
            }
            case "macos" {
                OperatingSystem.macos;
            }
            case "windows" {
                OperatingSystem.windows;
            }
            case "freebsd" {
                OperatingSystem.freebsd;
            }
            else {
                OperatingSystem.other;
            }
        }
    }

    // The machine architecture, such as `x86_64` or `aarch64`.
    architecture() is string {
        try {
            system_architecture();
        }
        catch failure is NativeFailure {
            panic "System provider could not identify the architecture";
        }
    }

    // The machine's byte order; formats still name their own.
    byte_order() is ByteOrder {
        let byte_order is string = try {
            system_byte_order();
        }
        catch failure is NativeFailure {
            panic "System provider could not identify native byte order";
        };
        match byte_order {
            case "big" {
                ByteOrder.big;
            }
            case "little" {
                ByteOrder.little;
            }
            else {
                panic "System provider returned an invalid native byte order";
            }
        }
    }
}

// Host reads runtime-local machine capacity separately from Platform, at
// the moment it is asked:
//
//     let host = Host();
//     output.writeln(host.name());
//     output.writeln("available CPUs: ", host.cpu_count().string());
//
// cpu_count() is always positive and means processors currently available to
// the runtime, not a promise about physical sockets or permanently available
// parallelism.

// The computer the program runs on.
object Host {
    // This host.
    Host();

    // Its host name.
    name() is string {
        try {
            system_host_name();
        }
        catch failure is NativeFailure {
            throw UnavailableHostInformation.because("host name is unavailable");
        }
    }

    // How many processors the program may use.
    cpu_count() is int {
        let processors is int = try {
            system_cpu_count();
        }
        catch failure is NativeFailure {
            throw UnavailableHostInformation.because("CPU count is unavailable");
        };
        confirm processors > 0 else panic "System provider returned no CPUs";
        processors;
    }
}

// The system could not answer; message says why.
enum UnavailableHostInformation is Error = (because(message is string));

test "the platform names a known system, an architecture and a byte order" {
    let platform = Platform();
    let system = platform.operating_system();
    test.ok(system == OperatingSystem.linux || system == OperatingSystem.macos
        || system == OperatingSystem.windows || system == OperatingSystem.freebsd
        || system == OperatingSystem.other);
    test.ok(!platform.architecture().empty());
    let order = platform.byte_order();
    test.ok(order == ByteOrder.little || order == ByteOrder.big);
    test.ok(Platform() == platform);
}

test "the host has a name and at least one processor" {
    let host = Host();
    test.ok(!host.name().empty());
    test.ok(host.cpu_count() > 0);
}
