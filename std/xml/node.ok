module xml/node v1.0.0;

import "xml/name" take XmlName, XmlNCName, InvalidXml;
import "xml/write" take EscapedXml, XmlCharacters;
import "collections/sequence" take Sequencing;

role XmlNode {
    xml() is string;
    depth() is int;
}

object XmlText does XmlNode {
    has origin is string;

    XmlText(value is string) {
        XmlCharacters(value);
        origin = value;
    }

    text() is string {
        origin;
    }

    xml() is string {
        memo let escaped = EscapedXml(origin: origin, attribute: false).string();
        escaped;
    }

    depth() is int {
        0;
    }
}

object XmlComment does XmlNode {
    has origin is string;

    XmlComment(value is string) {
        XmlCharacters(value);
        confirm value.length() <= 65536
            && value.split("--").size() == 1
            && (value == "" || value.slice(value.length() - 1, value.length()) != "-")
            else throw InvalidXml.located(0, "invalid XML comment");
        origin = value;
    }

    text() is string {
        origin;
    }

    xml() is string {
        "<!--" + origin + "-->";
    }

    depth() is int {
        0;
    }
}

object XmlProcessingInstruction does XmlNode {
    has target, data is string;

    XmlProcessingInstruction(target is string, data is string) {
        XmlNCName(target);
        XmlCharacters(data);
        confirm target.replace("X", "x").replace("M", "m").replace("L", "l") != "xml"
            && data.length() <= 65536
            && data.split("?>").size() == 1
            else throw InvalidXml.located(0, "invalid processing instruction");
        self.target = target;
        self.data = data;
    }

    target() is string {
        target;
    }

    data() is string {
        data;
    }

    xml() is string {
        "<?" + target + (if data == "" {
            "";
        }
        else {
            " " + data;
        }) + "?>";
    }

    depth() is int {
        0;
    }
}

object XmlAttribute {
    has name is XmlName;
    has value is string;

    XmlAttribute(name is XmlName, value is string) {
        confirm (name.namespace() == "" || name.prefix() != "")
            && !(name.namespace() == "" && name.local_name() == "xmlns")
            else throw InvalidXml.located(0, "attribute namespace requires an explicit prefix");
        XmlCharacters(value);
        self.name = name;
        self.value = value;
    }

    name() is XmlName {
        name;
    }

    value() is string {
        value;
    }

    xml() is string {
        memo let pair = name.lexical() + "=\"" + EscapedXml(origin: value, attribute: true).string() + "\"";
        pair;
    }
}

// An element keeps its attributes and children as given, checked for limits
// and name conflicts when made. Its text and depth are computed on the first
// question, and a tree that is too deep or too large is refused then.
object XmlElement does XmlNode {
    has name is XmlName;
    has attributes is @XmlAttribute;
    has children is @XmlNode;

    XmlElement(name is XmlName, children is Sequencing<XmlNode>) {
        self.name = name;
        self.attributes = [];
        self.children = XmlChildren(source: children).values();
    }

    XmlElement(
        name is XmlName,
        attributes is Sequencing<XmlAttribute>,
        children is Sequencing<XmlNode>
    ) {
        self.name = name;
        self.attributes = XmlAttributes(element: name, source: attributes).values();
        self.children = XmlChildren(source: children).values();
    }

    name() is XmlName {
        name;
    }

    attributes() is Sequencing<XmlAttribute> {
        attributes;
    }

    children() is Sequencing<XmlNode> {
        children;
    }

    xml() is string {
        memo let text = XmlElementContent(name: name, attributes: attributes, children: children).xml();
        text;
    }

    depth() is int {
        memo let levels = XmlElementContent(name: name, attributes: attributes, children: children).depth();
        levels;
    }
}

hidden object XmlChildren {
    has values is @XmlNode;

    XmlChildren(source is Sequencing<XmlNode>) {
        let size = source.size();
        confirm size >= 0 && size <= 8192
            else throw InvalidXml.located(0, "XML child count exceeds 8192");
        let snapshot is @XmlNode = (0..size).map() -> index {
            source.item(index);
        };
        values = snapshot;
    }

    values() is @XmlNode {
        values;
    }
}

hidden object XmlAttributes {
    has values is @XmlAttribute;

    XmlAttributes(element is XmlName, source is Sequencing<XmlAttribute>) {
        let size = source.size();
        confirm size >= 0 && size <= 256
            else throw InvalidXml.located(0, "XML attribute count exceeds 256");
        let snapshot is @XmlAttribute = (0..size).map() -> index {
            source.item(index);
        };
        let total = snapshot.reduce(0) -> length, attribute {
            length + attribute.xml().length();
        };
        confirm total <= 33554432
            else throw InvalidXml.located(0, "aggregate XML attributes exceed 32 Mi scalars");
        for (0..size) -> index {
            let name = snapshot[index].name();
            confirm name.prefix() == ""
                || name.prefix() != element.prefix()
                || name.namespace() == element.namespace()
                else throw InvalidXml.located(0, "conflicting element prefix");
            for (0..index) -> prior {
                let before = snapshot[prior].name();
                confirm name.local_name() != before.local_name()
                    || name.namespace() != before.namespace()
                    else throw InvalidXml.located(0, "duplicate expanded attribute name");
                confirm name.prefix() == ""
                    || name.prefix() != before.prefix()
                    || name.namespace() == before.namespace()
                    else throw InvalidXml.located(0, "conflicting attribute prefix");
            }
        }
        values = snapshot;
    }

    values() is @XmlAttribute {
        values;
    }
}

hidden object XmlElementContent {
    has name is XmlName;
    has attributes is @XmlAttribute;
    has children is @XmlNode;

    XmlElementContent(:name, :attributes, :children);

    depth() is int {
        let maximum = children.reduce(0) -> value, child {
            let depth = child.depth();
            confirm depth >= 0 && depth < 64
                else throw InvalidXml.located(0, "XML depth exceeds 64");
            if depth > value {
                depth;
            }
            else {
                value;
            }
        };
        maximum + 1;
    }

    xml() is string {
        self.depth();
        let namespace = " xmlns=\"" + EscapedXml(
            origin: if name.prefix() == "" {
                name.namespace();
            }
            else {
                "";
            },
            attribute: true
        ).string() + "\"" +
            (if name.prefix() == "" || name.prefix() == "xml" {
                "";
            }
            else {
                " xmlns:" + name.prefix() + "=\"" + EscapedXml(origin: name.namespace(), attribute: true).string() + "\"";
            });
        let declarations is @string = (0..attributes.size()).map() -> index {
            let current = attributes[index].name();
            let previous = (0..index).reduce(false) -> seen, prior {
                seen || attributes[prior].name().prefix() == current.prefix();
            };
            if current.prefix() == ""
                || current.prefix() == "xml"
                || current.prefix() == name.prefix()
                || previous {
                    "";
                }
                else {
                    " xmlns:" + current.prefix() + "=\"" + EscapedXml(origin: current.namespace(), attribute: true).string() + "\"";
                }
        };
        let pairs is @string = attributes.map() -> attribute {
            " " + attribute.xml();
        };
        let parts is @string = children.map() -> child {
            let text = child.xml();
            confirm text.length() <= 33554432
                else throw InvalidXml.located(0, "XML child output limit");
            text;
        };
        let content_length = parts.reduce(0) -> length, text {
            length + text.length();
        };
        let declarations_length = declarations.reduce(0) -> length, text {
            length + text.length();
        };
        let attributes_length = pairs.reduce(0) -> length, text {
            length + text.length();
        };
        let total = content_length + namespace.length() + declarations_length + attributes_length + name.lexical().length() * 2 + 5;
        confirm total <= 33554432
            else throw InvalidXml.located(0, "XML element exceeds 32 Mi scalars");
        let opening = "<" + name.lexical() + namespace + declarations.join("") + pairs.join("");
        if children.size() == 0 {
            opening + "/>";
        }
        else {
            opening + ">" + parts.join("") + "</" + name.lexical() + ">";
        }
    }
}

object XmlDocument {
    has root is XmlElement;

    XmlDocument(root is XmlElement) {
        self.root = root;
    }

    root() is XmlElement {
        root;
    }

    xml() is string {
        memo let text = XmlDeclared(root: root).xml();
        text;
    }
}

hidden object XmlDeclared {
    has root is XmlElement;

    XmlDeclared(:root);

    xml() is string {
        let body = root.xml();
        confirm body.length() + 38 <= 33554432
            else throw InvalidXml.located(0, "XML document exceeds 32 Mi scalars");
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" + body;
    }
}

test "mixed XML text remains literal" {
    test.is(XmlElement(name: XmlName("p"), children: [XmlText("a<&")]).xml(), "<p xmlns=\"\">a&lt;&amp;</p>");
}

test "an element writes its namespaces, attributes and children in order" {
    let atom = "http://www.w3.org/2005/Atom";
    let entry = XmlElement(
        name: XmlName(namespace: atom, local: "entry", prefix: "a"),
        attributes: [XmlAttribute(name: XmlName("id"), value: "1 & 2")],
        children: [
            XmlElement(name: XmlName(namespace: atom, local: "title", prefix: "a"), children: [XmlText("Hi")]),
            XmlComment("note"),
            XmlProcessingInstruction(target: "render", data: "fast"),
        ],
    );
    test.is(
        entry.xml(),
        "<a:entry xmlns=\"\" xmlns:a=\"http://www.w3.org/2005/Atom\" id=\"1 &amp; 2\">"
            + "<a:title xmlns=\"\" xmlns:a=\"http://www.w3.org/2005/Atom\">Hi</a:title>"
            + "<!--note--><?render fast?></a:entry>",
    );
    test.is(entry.depth(), 2);
    test.is(entry.xml(), entry.xml());
    test.is(XmlElement(name: XmlName("br"), children: []).xml(), "<br xmlns=\"\"/>");
    test.is(XmlText("a<b").text(), "a<b");
    test.is(XmlComment("c").text(), "c");
    test.is(XmlDocument(XmlElement(name: XmlName("r"), children: [])).xml(), "<?xml version=\"1.0\" encoding=\"UTF-8\"?><r xmlns=\"\"/>");
}

test "bad nodes are refused when made; a tree too deep when written" {
    test.throws(InvalidXml) {
        XmlComment("a--b");
    };
    test.throws(InvalidXml) {
        XmlComment("ends-");
    };
    test.throws(InvalidXml) {
        XmlProcessingInstruction(target: "XmL", data: "");
    };
    test.throws(InvalidXml) {
        XmlProcessingInstruction(target: "p", data: "a?>b");
    };
    test.throws(InvalidXml) {
        XmlText("\u{1}");
    };
    test.throws(InvalidXml) {
        XmlElement(
            name: XmlName("e"),
            attributes: [XmlAttribute(name: XmlName("a"), value: "1"), XmlAttribute(name: XmlName("a"), value: "2")],
            children: [],
        );
    };
    let deep is XmlNode = (0..65).reduce(XmlText("x")) -> inner, level {
        let wrapped is XmlNode = XmlElement(name: XmlName("d"), children: [inner]);
        wrapped;
    };
    test.throws(InvalidXml) {
        deep.xml();
    };
    let fits is XmlNode = (0..64).reduce(XmlText("x")) -> inner, level {
        let wrapped is XmlNode = XmlElement(name: XmlName("d"), children: [inner]);
        wrapped;
    };
    test.is(fits.depth(), 64);
}
