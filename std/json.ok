module json v1.0.0;

import "math/decimal" take Decimal;
import "numbers/bigint" take BigInt, BigPowerLimitExceeded;
import "compare" take Order;
import "cell" take Cell;
import "runtime/number_text" take int_parse_valid, int_parse;
import "runtime/json" take JsonParseState, JsonNodeState, json_parse_state, json_parse_valid,
    json_parse_offset, json_parse_line, json_parse_column, json_parse_message, json_parse_duplicate,
    json_parse_has_duplicate, json_parse_root, json_node_kind, json_node_boolean, json_node_number,
    json_node_text, json_node_size, json_node_item, json_member_value, json_member_position,
    json_member_text, json_member_spelling, json_member_boolean, json_member_int, json_text_node,
    json_number_node, json_boolean_node, json_null_node, json_array_node, json_object_node,
    json_node_write, json_node_pointer, json_member_names, json_member_values, json_node_items,
    json_repeated_name;

// JSON values: one immutable Json, parsed or built in code, read without
// casts and written by the runtime in one call.
//
//     let order = ParsedJson(text).root();
//     order.int("id");                                // 4711
//     order.get("customer").text("name");             // "Ada"
//     order.maybe("note").text() else "";                // "" when absent or null
//     let lines = order.list("items").map() -> line {
//         Line(sku: line.text("sku"), qty: line.int("qty"));
//     };
//
//     let reply = Json([
//         JsonField("id", 4711),
//         JsonField("customer", Json([JsonField("name", "Ada")])),
//         JsonField("tags", Json(items: [Json("new"), Json("vip")])),
//     ]);
//     reply.string();                                 // compact text
//     reply.pretty(2);                                // indented text
//
// Everything that goes wrong is a JsonError. Reads check kinds: a value of
// another kind is JsonError.wrong_kind, a missing member or index
// JsonError.missing, a number that is not the integer asked for
// JsonError.invalid_number; each names the RFC 6901 pointer of the value
// ("" is the root). Strict RFC 8259 parsing keeps member order, rejects
// repeated names (JsonError.duplicate_member_at) and nests at most 128 values deep
// unless told otherwise. Numbers are exact: Decimal, BigInt or int, never
// float. Text output writes numbers positionally while that stays short
// (integers up to 21 digits, fractions down to 1e-6) and exactly otherwise.

enum JsonKind = (null_value, boolean_value, number_value, string_value, array_value, object_value);

object Json {
    has node is JsonNodeState;
    has root is JsonNodeState;

    // The runtime node of any Json, for building arrays and objects of them.
    cap Node {
        state is JsonNodeState {
            node;
        }
    }

    // null
    Json() {
        let made = json_null_node();
        node = made;
        root = made;
    }

    Json(value is string) {
        let made = json_text_node(value);
        node = made;
        root = made;
    }

    Json(value is int) {
        let made = json_number_node(value.string());
        node = made;
        root = made;
    }

    Json(value is Decimal) {
        let made = json_number_node(value.string());
        node = made;
        root = made;
    }

    Json(value is BigInt) {
        let made = json_number_node(value.string());
        node = made;
        root = made;
    }

    // The shortest decimal of the float, written exactly as that decimal.
    Json(value is float) {
        let made = json_number_node(value.string());
        node = made;
        root = made;
    }

    Json(value is bool) {
        let made = json_boolean_node(value);
        node = made;
        root = made;
    }

    // An object; repeated names are JsonError.duplicate_member. Json(fields: []) is {}.
    Json(fields is @JsonField) {
        let names is @string = fields.map() -> field {
            field::Member::name;
        };
        let repeated = json_repeated_name(names);
        confirm repeated == names.size() else throw JsonError.duplicate_member(names[repeated]);
        let values is @JsonNodeState = fields.map() -> field {
            let value = field::Member::value;
            value::Node::state;
        };
        let made = json_object_node(names, values);
        node = made;
        root = made;
    }

    // An array. Json(items: []) is [].
    Json(items is @Json) {
        let values is @JsonNodeState = items.map() -> item {
            item::Node::state;
        };
        let made = json_array_node(values);
        node = made;
        root = made;
    }

    // A document of the runtime, as ParsedJson makes it.
    Json(node is JsonNodeState) {
        self.node = node;
        root = node;
    }

    // A value inside the document root.
    Json(node is JsonNodeState, root is JsonNodeState) {
        self.node = node;
        self.root = root;
    }

    kind() is JsonKind {
        match json_node_kind(node) {
            case 0 {
                JsonKind.null_value;
            }
            case 1 {
                JsonKind.boolean_value;
            }
            case 2 {
                JsonKind.number_value;
            }
            case 3 {
                JsonKind.string_value;
            }
            case 4 {
                JsonKind.array_value;
            }
            else {
                JsonKind.object_value;
            }
        }
    }

    // The RFC 6901 pointer of this value in its document ("" for the root),
    // found only when asked; a value present twice in a built document is at
    // its first place.
    pointer() is string {
        json_node_pointer(root, node);
    }

    text() is string {
        try {
            json_node_text(node);
        }
        catch failure is NativeFailure {
            throw self.wrong(JsonKind.string_value);
        }
    }

    number() is Decimal {
        Decimal(self.spelling());
    }

    boolean() is bool {
        try {
            json_node_boolean(node);
        }
        catch failure is NativeFailure {
            throw self.wrong(JsonKind.boolean_value);
        }
    }

    // The exact integer of any size; fractions and exponents beyond 4096 bits
    // are JsonError.invalid_number.
    integer() is BigInt {
        ExactJsonNumber(exact: self.number(), origin: self).integer();
    }

    // A builtin int: the integer must fit the signed 64-bit range.
    int() is int {
        let spelling = self.spelling();
        if spelling.length() <= 18 && int_parse_valid(spelling, 10) {
            int_parse(spelling, 10);
        }
        else {
            ExactJsonNumber(exact: Decimal(spelling), origin: self).int();
        }
    }

    // Number of items of an array or members of an object.
    size() is int {
        let actual = self.kind();
        confirm actual == JsonKind.array_value || actual == JsonKind.object_value
            else throw JsonError.wrong_kind(self.pointer(), JsonKind.array_value, actual);
        json_node_size(node);
    }

    at(index is int) is Json {
        self.expect(JsonKind.array_value);
        confirm index >= 0 && index < json_node_size(node)
            else throw JsonError.missing(self.pointer() + "/" + index.string());
        Json(json_node_item(node, index), root);
    }

    items() is @Json {
        let nodes = try {
            json_node_items(node);
        }
        catch failure is NativeFailure {
            throw self.wrong(JsonKind.array_value);
        };
        let items is @Json = nodes.map() -> item {
            Json(item, root);
        };
        items;
    }

    // Member names in document order.
    names() is @string {
        try {
            json_member_names(node);
        }
        catch failure is NativeFailure {
            throw self.wrong(JsonKind.object_value);
        }
    }

    // Member values in document order, as names() gives their names.
    values() is @Json {
        let nodes = try {
            json_member_values(node);
        }
        catch failure is NativeFailure {
            throw self.wrong(JsonKind.object_value);
        };
        let values is @Json = nodes.map() -> value {
            Json(value, root);
        };
        values;
    }

    // This object with the members of other: a member of both takes other's
    // value in this object's place, and other's new members follow in its
    // order.
    merged(other is Json) is Json {
        let mine = self.names();
        let theirs = other.names();
        let kept is @JsonField = mine.map() -> name {
            if other.has(name) {
                JsonField(name, other.get(name));
            }
            else {
                JsonField(name, self.get(name));
            }
        };
        let added is @JsonField = theirs.filter() -> name {
            !self.has(name);
        }.map() -> name {
            JsonField(name, other.get(name));
        };
        Json(kept + added);
    }

    has(name is string) is bool {
        self.position(name) >= 0;
    }

    get(name is string) is Json {
        let position = self.position(name);
        confirm position >= 0
            else throw JsonError.missing(
                self.pointer() + "/" + JsonPointerToken(name).string()
            );
        Json(json_member_value(node, position), root);
    }

    // A member that may be absent or null: its reads give Maybe, so a
    // fallback is `order.maybe("note").text() else ""`; a member of another
    // kind is still JsonError.wrong_kind. presence(name) keeps absent and null
    // apart.
    maybe(name is string) is JsonMaybeReader {
        JsonMaybeReader(
            origin: self.presence(name),
            location: self.pointer() + "/" + JsonPointerToken(name).string()
        );
    }

    presence(name is string) is JsonPresenceReader {
        let position = self.position(name);
        let found is Presence<Json> = if position < 0 {
            Presence.missing;
        }
        else {
            let value = Json(json_member_value(node, position), root);
            if value.kind() == JsonKind.null_value {
                Presence.none;
            }
            else {
                Presence.some(value);
            }
        };
        JsonPresenceReader(origin: found);
    }

    // Members read in one runtime call; a member that is missing, of another
    // kind or not a short integer is read again the long way for its error.
    text(name is string) is string {
        try {
            json_member_text(node, name);
        }
        catch failure is NativeFailure {
            self.get(name).text();
        }
    }

    number(name is string) is Decimal {
        try {
            Decimal(json_member_spelling(node, name));
        }
        catch failure is NativeFailure {
            self.get(name).number();
        }
    }

    int(name is string) is int {
        try {
            json_member_int(node, name);
        }
        catch failure is NativeFailure {
            self.get(name).int();
        }
    }

    boolean(name is string) is bool {
        try {
            json_member_boolean(node, name);
        }
        catch failure is NativeFailure {
            self.get(name).boolean();
        }
    }

    integer(name is string) is BigInt {
        self.get(name).integer();
    }

    list(name is string) is @Json {
        self.get(name).items();
    }

    // Compact JSON text.
    string() is string {
        json_node_write(node, -1);
    }

    // Indented JSON text: one member or item per line, indentation spaces
    // per level, ": " after names, no final line break.
    pretty(indentation is int) is string {
        confirm indentation >= 0 else throw JsonError.invalid_indentation(indentation);
        json_node_write(node, indentation);
    }

    hidden expect(expected is JsonKind) is void {
        let actual = self.kind();
        confirm actual == expected
            else throw JsonError.wrong_kind(self.pointer(), expected, actual);
    }

    hidden wrong(expected is JsonKind) is JsonError {
        JsonError.wrong_kind(self.pointer(), expected, self.kind());
    }

    hidden spelling() is string {
        try {
            json_node_number(node);
        }
        catch failure is NativeFailure {
            throw self.wrong(JsonKind.number_value);
        }
    }

    hidden position(name is string) is int {
        try {
            json_member_position(node, name);
        }
        catch failure is NativeFailure {
            throw self.wrong(JsonKind.object_value);
        }
    }
}

// One member of an object: a name and its value. Scalars need no Json:
// JsonField("id", 42), JsonField("name", "Ada"), JsonField("vip", true).
object JsonField {
    has member is string;
    has content is Json;

    JsonField(name is string, value is Json) {
        member = name;
        content = value;
    }

    JsonField(name is string, value is string) {
        member = name;
        content = Json(value);
    }

    JsonField(name is string, value is int) {
        member = name;
        content = Json(value);
    }

    JsonField(name is string, value is Decimal) {
        member = name;
        content = Json(value);
    }

    JsonField(name is string, value is bool) {
        member = name;
        content = Json(value);
    }

    JsonField(name is string, value is BigInt) {
        member = name;
        content = Json(value);
    }

    JsonField(name is string, value is float) {
        member = name;
        content = Json(value);
    }

    // Read only by Json(fields), which writes the member.
    cap Member {
        name is string {
            member;
        }

        value is Json {
            content;
        }
    }
}

// Strict JSON text exposed through root(): JsonError.invalid for a syntax
// error, JsonError.duplicate_member_at for a repeated member name.
object ParsedJson {
    has state is JsonParseState;

    ParsedJson(origin is string) {
        state = json_parse_state(origin, 128);
    }

    ParsedJson(origin is string, maximum_depth is int) {
        confirm maximum_depth > 0
            else throw JsonError.invalid(0, 1, 1, "maximum JSON depth must be positive");
        state = json_parse_state(origin, maximum_depth);
    }

    root() is Json {
        if json_parse_valid(state) {
            Json(json_parse_root(state));
        }
        else if json_parse_has_duplicate(state) {
            throw JsonError.duplicate_member_at(
                json_parse_duplicate(state),
                json_parse_offset(state),
                json_parse_line(state),
                json_parse_column(state),
            );
        }
        else {
            throw JsonError.invalid(
                json_parse_offset(state),
                json_parse_line(state),
                json_parse_column(state),
                json_parse_message(state),
            );
        }
    }
}

// A selected member: missing and JSON null remain distinct.
object JsonPresenceReader {
    has origin is Presence<Json>;

    JsonPresenceReader(:origin);

    // The member as a node of any kind.
    node() is Presence<Json> {
        origin;
    }

    // Keep the Json object for strict reads of its members.
    object() is Presence<Json> {
        match origin {
            case Presence.some(value) {
                confirm value.kind() == JsonKind.object_value
                    else throw JsonError.wrong_kind(
                        value.pointer(),
                        JsonKind.object_value,
                        value.kind()
                    );
                Presence.some(value);
            }
            case Presence.none {
                Presence.none;
            }
            case Presence.missing {
                Presence.missing;
            }
        }
    }

    text() is Presence<string> {
        match origin {
            case Presence.some(value) {
                Presence.some(value.text());
            }
            case Presence.none {
                Presence.none;
            }
            case Presence.missing {
                Presence.missing;
            }
        }
    }

    int() is Presence<int> {
        match origin {
            case Presence.some(value) {
                Presence.some(value.int());
            }
            case Presence.none {
                Presence.none;
            }
            case Presence.missing {
                Presence.missing;
            }
        }
    }

    boolean() is Presence<bool> {
        match origin {
            case Presence.some(value) {
                Presence.some(value.boolean());
            }
            case Presence.none {
                Presence.none;
            }
            case Presence.missing {
                Presence.missing;
            }
        }
    }

    number() is Presence<Decimal> {
        match origin {
            case Presence.some(value) {
                Presence.some(value.number());
            }
            case Presence.none {
                Presence.none;
            }
            case Presence.missing {
                Presence.missing;
            }
        }
    }

    integer() is Presence<BigInt> {
        match origin {
            case Presence.some(value) {
                Presence.some(value.integer());
            }
            case Presence.none {
                Presence.none;
            }
            case Presence.missing {
                Presence.missing;
            }
        }
    }

    list() is Presence<@Json> {
        match origin {
            case Presence.some(value) {
                Presence.some(value.items());
            }
            case Presence.none {
                Presence.none;
            }
            case Presence.missing {
                Presence.missing;
            }
        }
    }
}

// The same readers with missing and JSON null folded into Maybe.none.
object JsonMaybeReader {
    has origin is JsonPresenceReader;
    // RFC 6901 pointer of the member, also while it is absent.
    has location is string;

    JsonMaybeReader(:origin, :location);

    // There and not null.
    present() is bool {
        match origin.node() {
            case Presence.some(found) {
                true;
            }
            case Presence.none {
                false;
            }
            case Presence.missing {
                false;
            }
        }
    }

    pointer() is string {
        location;
    }

    // A member of this member; absent whenever this one is absent or null.
    maybe(name is string) is JsonMaybeReader {
        match origin.node() {
            case Presence.some(found) {
                found.maybe(name);
            }
            case Presence.none {
                self.absent(name);
            }
            case Presence.missing {
                self.absent(name);
            }
        }
    }

    // The member as a node of any kind.
    node() is Maybe<Json> {
        origin.node().fold();
    }

    object() is Maybe<Json> {
        origin.object().fold();
    }

    text() is Maybe<string> {
        origin.text().fold();
    }

    int() is Maybe<int> {
        origin.int().fold();
    }

    boolean() is Maybe<bool> {
        origin.boolean().fold();
    }

    number() is Maybe<Decimal> {
        origin.number().fold();
    }

    integer() is Maybe<BigInt> {
        origin.integer().fold();
    }

    list() is Maybe<@Json> {
        origin.list().fold();
    }

    hidden absent(name is string) is JsonMaybeReader {
        let nothing is Presence<Json> = Presence.missing;
        JsonMaybeReader(
            origin: JsonPresenceReader(origin: nothing),
            location: location + "/" + JsonPointerToken(name).string()
        );
    }
}

// RFC 6901 reference token: "~" becomes "~0" and "/" becomes "~1".
object JsonPointerToken {
    has origin is string;

    JsonPointerToken(origin is string) {
        self.origin = origin;
    }

    string() is string {
        origin.replace("~", "~0").replace("/", "~1");
    }
}

// The exact value of a JSON number as an integer: of any size up to 4096
// bits, or a builtin int.
hidden object ExactJsonNumber {
    has exact is Decimal;
    has origin is Json;

    ExactJsonNumber(:exact, :origin);

    integer() is BigInt {
        confirm exact.exponent() >= 0
            else throw JsonError.invalid_number(
                origin.pointer(),
                exact.string(),
                "integer required"
            );
        if exact.exponent() == 0 {
            exact.coefficient();
        }
        else {
            let scale = try {
                BigInt("10").power(exact.exponent(), 4096);
            }
            catch failure is BigPowerLimitExceeded {
                throw JsonError.invalid_number(
                    origin.pointer(),
                    exact.string(),
                    "integer exceeds 4096 bits"
                );
            };
            (exact.coefficient() * scale);
        }
    }

    // A builtin int: an integer in the signed 64-bit range.
    int() is int {
        let integer = self.integer();
        confirm integer.order(BigInt("9223372036854775807")) != Order.greater
            && integer.order(BigInt("-9223372036854775808")) != Order.less
            else throw JsonError.invalid_number(
                origin.pointer(),
                integer.string(),
                "integer outside int range"
            );
        int_parse(integer.string(), 10);
    }
}

object JsonKindName {
    has origin is JsonKind;

    JsonKindName(origin is JsonKind) {
        self.origin = origin;
    }

    string() is string {
        match origin {
            case JsonKind.null_value {
                "null";
            }
            case JsonKind.boolean_value {
                "boolean";
            }
            case JsonKind.number_value {
                "number";
            }
            case JsonKind.string_value {
                "string";
            }
            case JsonKind.array_value {
                "array";
            }
            else {
                "object";
            }
        }
    }
}

object JsonLocation {
    has origin is string;

    JsonLocation(origin is string) {
        self.origin = origin;
    }

    string() is string {
        if origin == "" {
            "the document root";
        }
        else {
            origin;
        }
    }
}

// What goes wrong with JSON; reads name the RFC 6901 pointer of the value.
enum JsonError is Error = (wrong_kind(pointer is string, expected is JsonKind, actual is JsonKind), missing(
    pointer is string
), invalid_number(pointer is string, spelling is string, reason is string), invalid(
    offset is int,
    line is int,
    column is int,
    message is string
), duplicate_member(name is string), duplicate_member_at(
    name is string,
    offset is int,
    line is int,
    column is int
), invalid_indentation(amount is int));

test "values built in code are written compact and pretty" {
    let value = Json([
        JsonField("name", "Ada \"\u{1}\" é 🙂 /"),
        JsonField("tags", Json(items: [Json("a"), Json(), Json(false)])),
        JsonField("empty", Json(fields: [])),
        JsonField("none", Json(items: [])),
        JsonField("n", Decimal("-0.50")),
        JsonField("i", 42),
    ]);
    test.is(
        value.string(),
        "{\"name\":\"Ada \\\"\\u0001\\\" é 🙂 /\",\"tags\":[\"a\",null,false],\"empty\":{},\"none\":[],\"n\":-0.5,\"i\":42}"
    );
    test.is(
        Json(items: [Json(BigInt("123456789012345678901")), Json(1.5), Json(0.000000025)]).string(),
        "[123456789012345678901,1.5,2.5e-8]"
    );
    test.is(
        Json(items: [Json([JsonField("a", 1)]), Json(items: [])]).pretty(2),
        "[\n  {\n    \"a\": 1\n  },\n  []\n]"
    );
    test.is(Json(fields: []).pretty(0), "{}");
    test.is(
        try {
            Json(1).pretty(-1);
            "";
        }
        catch JsonError.invalid_indentation(amount) {
            amount.string();
        },
        "-1"
    );
    for [
        ["404", "404"],
        ["1000", "1000"],
        ["0.000001", "0.000001"],
        ["0.0000001", "1e-7"],
        ["1e21", "1e21"],
        ["123456789012345678901", "123456789012345678901"]
    ] -> pair {
        test.is(Json(Decimal(pair[0])).string(), pair[1]);
    }
}

test "repeated names are rejected when built and when parsed" {
    test.is(
        try {
            Json(
                [
                    JsonField("a", 1),
                    JsonField("b", 2),
                    JsonField("a", 3)
                ]
            );
            "";
        }
        catch JsonError.duplicate_member(name) {
            name
        },
        "a"
    );
    test.is(
        try {
            Json(
                [
                    JsonField("x", 1),
                    JsonField("x", 2)
                ]
            );
            false;
        }
        catch JsonError.duplicate_member_at(_, _, _, _) {
            true;
        }
        catch JsonError.duplicate_member(_) {
            false
        },
        false
    );
    let parsed = try {
        ParsedJson("{\"k\":1,\n \"k\":2}").root();
        "";
    }
    catch JsonError.duplicate_member_at(name, _, line, column) {
        name + "@" + line.string() + ":" + column.string();
    };
    test.is(parsed, "k@2:2");
    test.is(
        try {
            ParsedJson("[1,").root();
            "";
        }
        catch JsonError.invalid(_, line, column, _) {
            line.string() + ":" + column.string();
        },
        "1:4"
    );
    test.is(
        try {
            ParsedJson("[[1]]", 1).root();
            "";
        }
        catch JsonError.invalid(_, _, _, _) {
            "deep";
        },
        "deep"
    );
    // Большой объект: повтор ищется не перебором, а по множеству имён.
    let names is @string = (0..20).map() -> index {
        "\"m" + index.string() + "\":" + index.string();
    };
    let wide = "{" + names.join(",") + ",\"m3\":0}";
    test.is(
        try {
            ParsedJson(wide).root();
            "";
        }
        catch JsonError.duplicate_member(name) {
            name
        }
        catch JsonError.duplicate_member_at(name, _, _, _) {
            name
        },
        "m3"
    );
    test.is(ParsedJson("{" + names.join(",") + "}").root().size(), 20);
}

test "reads check kinds and name the pointer" {
    let doc = ParsedJson(
        "{\"a/b\":{\"~\":[1,-2,0.5,1e2,123456789012345678,1234567890123456789,9223372036854775808]},\"s\":\"x\",\"t\":true,\"n\":null,\"o\":{\"k\":\"v\"}}"
    ).root();
    let numbers = doc.get("a/b").list("~");
    test.is(numbers[0].int() + numbers[1].int(), -1);
    test.is(numbers[3].int(), 100);
    test.is(numbers[4].int(), 123456789012345678);
    test.is(numbers[5].int(), 1234567890123456789);
    test.is(numbers[2].number().string(), "5e-1");
    test.is(numbers[6].integer().string(), "9223372036854775808");
    //test.is(try { numbers[2].int(); ""; } catch failure is JsonError { failure.text(); }, "JSON number 5e-1 at /a~1b/~0/2: integer required");
    //test.is(try { numbers[6].int(); ""; } catch failure is JsonError { failure.pointer(); }, "/a~1b/~0/6");
    test.is(doc.text("s") + doc.get("o").text("k"), "xv");
    test.is(doc.boolean("t"), true);
    test.is(doc.get("n").kind() == JsonKind.null_value, true);
    test.is(
        try {
            doc.int("s");
            "";
        }
        catch failure is JsonError {
            failure.text();
        },
        "JsonError.wrong_kind(\"/s\", JsonKind.number_value, JsonKind.string_value)"
    );
    //test.is(try { doc.text("missing"); ""; } catch failure is JsonError { failure.text(); }, "JSON value at /missing is missing");
    test.is(
        try {
            doc.get("s").text("k");
            "";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/s"
    );
    //test.is(try { doc.get("a/b").get("~").at(7); ""; } catch failure is JsonError { failure.pointer(); }, "/a~1b/~0/7");
    test.is(
        try {
            doc.size();
            0;
        }
        catch JsonError.wrong_kind(_, _, _) {
            1;
        },
        0
    );
    test.is(
        try {
            doc.get("s").size();
            "";
        }
        catch failure is JsonError {
            failure.text();
        },
        "JsonError.wrong_kind(\"/s\", JsonKind.array_value, JsonKind.string_value)"
    );
    test.is(
        try {
            doc.text();
            "";
        }
        catch failure is JsonError {
            failure.text();
        },
        "JsonError.wrong_kind(\"\", JsonKind.string_value, JsonKind.object_value)"
    );
    test.is(doc.names(), ["a/b", "s", "t", "n", "o"]);
    let kinds = Json(doc.names().map() -> name {
        JsonField(name, Json(JsonKindName(doc.get(name).kind()).string()));
    });
    test.is(
        kinds.string(),
        "{\"a/b\":\"object\",\"s\":\"string\",\"t\":\"boolean\",\"n\":\"null\",\"o\":\"object\"}"
    );
    test.is(doc.has("t") && !doc.has("u"), true);
    test.is(doc.get("o").string(), "{\"k\":\"v\"}");
}

test "objects are walked by name and merged" {
    let doc = ParsedJson("{\"a\":1,\"b\":\"x\",\"c\":null}").root();
    let other = ParsedJson("{\"c\":3,\"d\":[4]}").root();
    test.is(doc.merged(other).string(), "{\"a\":1,\"b\":\"x\",\"c\":3,\"d\":[4]}");
    test.is(other.merged(doc).string(), "{\"c\":null,\"d\":[4],\"a\":1,\"b\":\"x\"}");
    test.is(doc.merged(Json(fields: [])).string(), doc.string());
    test.is(
        Json(doc.names().map() -> name {
            JsonField(name, Json(name + ":" + doc.get(name).string()));
        }).string(),
        "{\"a\":\"a:1\",\"b\":\"b:\\\"x\\\"\",\"c\":\"c:null\"}"
    );
    let seen = doc.names().reduce("") -> walked, name {
        walked + name + "=" + doc.get(name).string() + ";";
    };
    test.is(seen, "a=1;b=\"x\";c=null;");
    test.is(
        try {
            Json(1).merged(doc);
            "";
        }
        catch failure is JsonError {
            failure.text();
        },
        "JsonError.wrong_kind(\"\", JsonKind.object_value, JsonKind.number_value)"
    );
}

test "presence distinguishes missing null and non-null members" {
    let doc = ParsedJson(
        "{\"null\":null,\"empty\":\"\",\"zero\":0,\"false\":false,\"array\":[],\"object\":{},\"a/b\":{\"~\":\"Anton\"}}"
    ).root();
    test.is(doc.presence("missing").node() ?? .missing: true !! _: false, true);
    test.is(doc.presence("null").node() ?? .none: true !! _: false, true);
    test.is(doc.presence("empty").node() ?? .some(value): value.text() !! _: "absent", "");
    test.is(doc.presence("zero").node() ?? .some(value): value.int() !! _: -1, 0);
    test.is(doc.presence("false").node() ?? .some(value): !value.boolean() !! _: false, true);
    test.is(doc.presence("array").node() ?? .some(value): value.items().size() !! _: -1, 0);
    test.is(doc.presence("object").node() ?? .some(value): value.names().size() !! _: -1, 0);
    let nested = doc.presence("a/b").node().fold() else panic "expected object";
    let name = nested.presence("~").node().fold() else panic "expected name";
    test.is(name.text(), "Anton");
    test.is(name.pointer(), "/a~1b/~0");
    test.is(
        try {
            name.presence("field").node();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/a~1b/~0"
    );
    for [Json(), Json(items: []), Json(false), Json(0)] -> value {
        test.is(
            try {
                value.presence("field").node();
                false;
            }
            catch JsonError.wrong_kind(_, _, _) {
                true;
            },
            true
        );
    }
    let missing = doc.presence("missing").node().fold() else Json("fallback");
    let null_fallback = doc.presence("null").node().fold() else Json("fallback");
    let present = doc.presence("empty").node().fold() else panic "fallback must be lazy";
    test.is(missing.text(), "fallback");
    test.is(null_fallback.text(), "fallback");
    test.is(present.text(), "");
}

test "maybe members read as the given fallback when absent or null" {
    let doc = ParsedJson(
        "{\"name\":\"Ada\",\"nick\":null,\"age\":36,\"tags\":[\"a\"],\"address\":{\"city\":\"Oslo\",\"zip\":null},\"empty\":null}"
    ).root();
    test.is(doc.maybe("name").text() else "anonymous", "Ada");
    test.is(doc.maybe("nick").text() else "anonymous", "anonymous");
    test.is(doc.maybe("missing").text() else "anonymous", "anonymous");
    test.is(doc.maybe("age").int() else 0, 36);
    test.is(doc.maybe("height").int() else -1, -1);
    test.is(doc.maybe("vip").boolean() else false, false);
    test.is(doc.maybe("address").maybe("city").text() else "", "Oslo");
    test.is(doc.maybe("address").maybe("zip").text() else "none", "none");
    test.is(doc.maybe("empty").maybe("city").text() else "nowhere", "nowhere");
    test.is(doc.maybe("missing").maybe("city").maybe("x").pointer(), "/missing/city/x");
    test.is(doc.maybe("address").maybe("city").pointer(), "/address/city");
    let tags is @Json = doc.maybe("tags").list() else [];
    let labels is @Json = doc.maybe("labels").list() else [];
    test.is(tags.size(), 1);
    test.is(labels.size(), 0);
    test.is(
        doc.maybe("name").present()
            && !doc.maybe("nick").present()
            && !doc.maybe("missing").present(),
            true
    );
    test.is(
        try {
            doc.maybe("age").text() else "";
            "";
        }
        catch failure is JsonError {
            failure.text();
        },
        "JsonError.wrong_kind(\"/age\", JsonKind.string_value, JsonKind.number_value)"
    );
}

test "parsed text is written back exactly" {
    let source = "{\"a\":[1,2.50,-0,1E2,\"\\u00e9\\n\\\"\"],\"b\":{\"c\":true,\"d\":null}}";
    test.is(
        ParsedJson(source).root().string(),
        "{\"a\":[1,2.5,0,100,\"é\\n\\\"\"],\"b\":{\"c\":true,\"d\":null}}"
    );
    let built = Json([JsonField("doc", ParsedJson(source).root().get("b"))]);
    test.is(built.string(), "{\"doc\":{\"c\":true,\"d\":null}}");
}

test "typed member readers preserve absence and reject invalid values" {
    let doc = ParsedJson(
        "{\"nil\":null,\"empty\":\"\",\"zero\":0,\"flag\":false,\"decimal\":1.25,\"big\":9223372036854775808,\"items\":[],\"object\":{}}"
    ).root();
    test.is(doc.presence("absent").node() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").node() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").node() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").node() ?? .none: true !! _: false, true);
    test.is(doc.presence("absent").object() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").object() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").object() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").object() ?? .none: true !! _: false, true);
    test.is(doc.presence("absent").text() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").text() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").text() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").text() ?? .none: true !! _: false, true);
    test.is(doc.presence("absent").int() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").int() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").int() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").int() ?? .none: true !! _: false, true);
    test.is(doc.presence("absent").boolean() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").boolean() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").boolean() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").boolean() ?? .none: true !! _: false, true);
    test.is(doc.presence("absent").number() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").number() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").number() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").number() ?? .none: true !! _: false, true);
    test.is(doc.presence("absent").integer() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").integer() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").integer() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").integer() ?? .none: true !! _: false, true);
    test.is(doc.presence("absent").list() ?? .missing: true !! _: false, true);
    test.is(doc.maybe("absent").list() ?? .none: true !! _: false, true);
    test.is(doc.presence("nil").list() ?? .none: true !! _: false, true);
    test.is(doc.maybe("nil").list() ?? .none: true !! _: false, true);
    test.is((doc.maybe("empty").text() else panic "unexpected absence"), "");
    test.is((doc.presence("empty").text().fold() else panic "unexpected absence"), "");
    test.is((doc.maybe("zero").int() else panic "unexpected absence"), 0);
    test.is((doc.presence("zero").int().fold() else panic "unexpected absence"), 0);
    test.is((doc.maybe("flag").boolean() else panic "unexpected absence"), false);
    test.is((doc.presence("flag").boolean().fold() else panic "unexpected absence"), false);
    test.is((doc.maybe("decimal").number() else panic "unexpected absence").string(), "1.25");
    test.is(
        (doc.presence("decimal").number().fold() else panic "unexpected absence").string(),
        "1.25"
    );
    test.is(
        (doc.maybe("big").integer() else panic "unexpected absence").string(),
        "9223372036854775808"
    );
    test.is(
        (doc.presence("big").integer().fold() else panic "unexpected absence").string(),
        "9223372036854775808"
    );
    test.is((doc.maybe("items").list() else panic "unexpected absence").size(), 0);
    test.is((doc.presence("items").list().fold() else panic "unexpected absence").size(), 0);
    test.is((doc.maybe("object").object() else panic "unexpected absence").names().size(), 0);
    test.is(
        (doc.presence("object").object().fold() else panic "unexpected absence").names().size(),
        0
    );
    test.is(doc.maybe("empty").text() else panic "eager fallback", "");
    test.is(doc.maybe("absent").text() else "guest", "guest");
    test.is(doc.presence("nil").text().fold() else "guest", "guest");
    test.is(
        try {
            doc.maybe("zero").text();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/zero"
    );
    test.is(
        try {
            doc.maybe("decimal").int();
            "no error";
        }
        catch JsonError.invalid_number(location, _, _) {
            location
        },
        "/decimal"
    );
    test.is(
        try {
            doc.maybe("big").int();
            "no error";
        }
        catch JsonError.invalid_number(location, _, _) {
            location
        },
        "/big"
    );
    test.is(
        try {
            doc.maybe("flag").list();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/flag"
    );
    test.is(
        try {
            doc.maybe("items").object();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/items"
    );
    test.is(
        try {
            doc.maybe("object").list();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/object"
    );
    test.is(
        try {
            Json(0).maybe("name");
            false;
        }
        catch JsonError.wrong_kind(_, _, _) {
            true;
        },
        true
    );
    test.is(
        try {
            doc.presence("zero").text();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/zero"
    );
    test.is(
        try {
            doc.presence("decimal").int();
            "no error";
        }
        catch JsonError.invalid_number(location, _, _) {
            location
        },
        "/decimal"
    );
    test.is(
        try {
            doc.presence("big").int();
            "no error";
        }
        catch JsonError.invalid_number(location, _, _) {
            location
        },
        "/big"
    );
    test.is(
        try {
            doc.presence("flag").list();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/flag"
    );
    test.is(
        try {
            doc.presence("items").object();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/items"
    );
    test.is(
        try {
            doc.presence("object").list();
            "no error";
        }
        catch JsonError.wrong_kind(pointer, _, _) {
            pointer;
        },
        "/object"
    );
    test.is(
        try {
            Json(0).presence("name");
            false;
        }
        catch JsonError.wrong_kind(_, _, _) {
            true;
        },
        true
    );
}
