module testing/runner v1.0.0;

import "testing/result" take TestReport, TestResult, TestFailure, TestPosition, TestOutput,
    TestStatus, InvalidTestResult;
import "json" take Json, JsonKind, ParsedJson;
import "strings/parse" take Number;
import "time/clock" take Instant;
import "time/duration" take Duration, DurationUnit;
import "encoding/base64" take Base64Decoded;

// Explicit runner wire projection; arbitrary user objects are never inspected.
object RecordedTestReport {
    has report is TestReport;

    RecordedTestReport(origin is string) {
        confirm origin.length() <= 16777216
            else throw InvalidTestResult.because("runner wire budget");
        let document = ParsedJson(origin).root();
        let entries = document.get("results").items();
        confirm entries.size() <= 4096 else throw InvalidTestResult.because("runner case budget");
        let results is @TestResult = entries.map() -> entry {
            RecordedTestResult(entry).outcome();
        };
        report = TestReport(
            start: Instant(Duration(value: Number(document.text("start_ns")).rat(), unit: DurationUnit.nanosecond)),
            duration: Duration(value: Number(document.text("duration_ns")).rat(), unit: DurationUnit.nanosecond),
            seed: document.int("seed"),
            results: results
        );
    }

    report() is TestReport {
        report;
    }
}

hidden object RecordedTestResult {
    has result is TestResult;

    RecordedTestResult(entry is Json) {
        let label = entry.text("status");
        let status = match label {
            case "passed" {
                TestStatus.passed;
            }
            case "failed" {
                TestStatus.failed;
            }
            case "skipped" {
                TestStatus.skipped;
            }
            case "timed_out" {
                TestStatus.timed_out;
            }
            case "crashed" {
                TestStatus.crashed;
            }
            else {
                throw InvalidTestResult.because("unknown runner status");
            }
        };
        let messages = entry.get("failures").items();
        confirm messages.size() <= 1024
            else throw InvalidTestResult.because("runner failures budget");
        let details is @Json = if entry.has("failure_details") {
            entry.get("failure_details").items();
        }
        else {
            [];
        };
        let failures is @TestFailure = (0..messages.size()).map() -> index {
            let message = messages[index].text();
            let positions is @TestPosition = if index < details.size()
                && details[index].has("position")
                && details[index].get("position").has("source_name") {
                    let position = details[index].get("position");
                    if position.get("line").kind() == JsonKind.number_value
                        && position.get("column").kind() == JsonKind.number_value {
                            [
                                TestPosition(
                                    source: position.text("source_name"),
                                    line: position.int("line"),
                                    column: position.int("column")
                                )
                            ];
                        }
                        else {
                            [];
                        }
                }
                else {
                    [];
                };
            let causes is @TestFailure = if index < details.size() && details[index].has("cause") {
                [RecordedTestCause(origin: details[index].get("cause"), depth: 0).failure()];
            }
            else {
                [];
            };
            TestFailure(message: message, positions: positions, causes: causes);
        };
        let output = Base64Decoded(entry.text("stdout_base64")).bytes();
        let errors = Base64Decoded(entry.text("stderr_base64")).bytes();
        confirm output.size() + errors.size() <= 1048576
            else throw InvalidTestResult.because("runner output budget");
        result = TestResult(
            name: entry.text("name"),
            status: status,
            duration: Duration(value: Number(entry.text("duration_ns")).rat(), unit: DurationUnit.nanosecond),
            failures: failures,
            output: TestOutput(output: output, errors: errors, truncated: entry.boolean("truncated")),
            skip_reason: if entry.has("skip_reason") {
                entry.text("skip_reason");
            }
            else {
                "";
            }
        );
    }

    outcome() is TestResult {
        result;
    }
}

hidden object RecordedTestCause {
    has failure is TestFailure;

    RecordedTestCause(origin is Json, depth is int) {
        confirm depth >= 0 && depth < 31 else throw InvalidTestResult.because("runner cause depth");
        let positions is @TestPosition = [];
        let causes is @TestFailure = if origin.has("cause") {
            [RecordedTestCause(origin: origin.get("cause"), depth: depth + 1).failure()];
        }
        else {
            [];
        };
        failure = TestFailure(
            message: origin.text("type") + ": " + origin.text("message"),
            positions: positions,
            causes: causes
        );
    }

    failure() is TestFailure {
        failure;
    }
}

test "a runner report reads results, failures, positions, causes and output" {
    let wire = "{\"start_ns\":\"1700000000000000000\",\"duration_ns\":\"2500000\",\"seed\":42,\"results\":["
        + "{\"name\":\"adds\",\"status\":\"passed\",\"duration_ns\":\"1000\",\"failures\":[],\"stdout_base64\":\"aGk=\",\"stderr_base64\":\"\",\"truncated\":false},"
        + "{\"name\":\"divides\",\"status\":\"failed\",\"duration_ns\":\"2000\",\"failures\":[\"expected 2, got 3\"],"
        + "\"failure_details\":[{\"position\":{\"source_name\":\"math.ok\",\"line\":12,\"column\":5},\"cause\":{\"type\":\"DivisionByZero\",\"message\":\"zero\"}}],"
        + "\"stdout_base64\":\"\",\"stderr_base64\":\"\",\"truncated\":true},"
        + "{\"name\":\"later\",\"status\":\"skipped\",\"duration_ns\":\"0\",\"failures\":[],\"skip_reason\":\"slow\",\"stdout_base64\":\"\",\"stderr_base64\":\"\",\"truncated\":false}"
        + "]}";
    let report = RecordedTestReport(wire).report();
    test.is(report.seed(), 42);
    test.is(report.counts()::Counts::passes, 1);
    test.is(report.counts()::Counts::failures, 1);
    test.is(report.counts()::Counts::skips, 1);
    let passed = report.results().first();
    test.is(passed::Outcome::name, "adds");
    test.is(passed.output()::Captured::output, [104.byte(), 105.byte()]);
    let failed = report.results().item(1);
    test.is(failed::Outcome::status == TestStatus.failed, true);
    test.is(failed.output()::Captured::truncated, true);
    let failure = failed.failures().first();
    test.is(failure::Failure::message, "expected 2, got 3");
    test.is(failure.located(), true);
    test.is(failure.position()::Position::line, 12);
    test.is(failure.causes().first()::Failure::message, "DivisionByZero: zero");
    test.is(report.results().last()::Outcome::skip_reason, "slow");
    test.throws(InvalidTestResult) {
        RecordedTestReport("{\"start_ns\":\"0\",\"duration_ns\":\"0\",\"seed\":1,\"results\":[{\"name\":\"x\",\"status\":\"lost\",\"duration_ns\":\"0\",\"failures\":[],\"stdout_base64\":\"\",\"stderr_base64\":\"\",\"truncated\":false}]}");
    };
}
