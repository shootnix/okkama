module testing/snapshot v1.0.0;

// Snapshot tests: output compared with a file kept next to the tests.
//
//     Snapshot(origin: TextSnapshot(rendered), file: SnapshotFile(root: Directory(Path("snapshots")), name: "page.txt"), limit: 65536).check();
//     SnapshotUpdate(origin: TextSnapshot(rendered), file: file, limit: 65536).update();   // when the change is wanted
//
// A missing snapshot fails the test; it is written only by SnapshotUpdate.

import "io/stream" take ByteSource;
import "fs/directory" take DirectoryLocating;
import "fs/path" take Path;
import "runtime/fs" take path_encode;
import "runtime/snapshot" as backend;
import "testing/check" take Checking, CheckContext, BytesEqual;
import "encoding/utf" take Utf8Encoded;
import "json" take Json;
import "regex/pattern" take Regex;
import "regex/search" take RegexMatches;

// Where a snapshot is kept.
object SnapshotFile {
    has root is Path;
    has name is string;

    // The file name below root; InvalidSnapshot for a name with a path.
    SnapshotFile(root is DirectoryLocating, name is string) {
        confirm name.length() > 0
            && name != "."
            && name != ".."
            && Utf8Encoded(name).bytes().size() <= 255
            && !RegexMatches(origin: name, regex: Regex("[/\\\\\\x{0}]")).found()
            else throw InvalidSnapshot.because("name must be one relative component");
        self.root = root.path();
        self.name = name;
    }

    // The directory.
    root() is Path {
        root;
    }

    // The file name.
    name() is string {
        name;
    }
}

// Text as snapshot bytes.
object TextSnapshot does ByteSource {
    has content is @byte;

    // The text.
    TextSnapshot(origin is string) {
        confirm origin.length() <= 1048576 else throw InvalidSnapshot.because("text scalar budget");
        content = Utf8Encoded(origin.split("\r\n").join("\n").split("\r").join("\n")).bytes();
        confirm self.content.size() <= 1048576 else throw InvalidSnapshot.because("byte budget");
    }

    // Its UTF-8 bytes.
    bytes() is @byte {
        content;
    }
}

// JSON as snapshot bytes: its text and a newline.
object JsonSnapshot does ByteSource {
    has content is @byte;

    // The value.
    JsonSnapshot(origin is Json) {
        content = Utf8Encoded(origin.string() + "\n").bytes();
        confirm self.content.size() <= 1048576 else throw InvalidSnapshot.because("byte budget");
    }

    // The JSON.
    bytes() is @byte {
        content;
    }
}

// Bytes as they are.
object RawSnapshot does ByteSource {
    has content is @byte;

    // The bytes.
    RawSnapshot(origin is @byte) {
        confirm origin.size() <= 1048576 else throw InvalidSnapshot.because("byte budget");
        content = origin;
    }

    // The bytes.
    bytes() is @byte {
        content;
    }
}

// Output that must match its snapshot.
object Snapshot does Checking {
    has origin is ByteSource;
    has file is SnapshotFile;
    has limit is int;

    // origin against file, at most limit bytes (1 to 1 MiB).
    Snapshot(origin is ByteSource, file is SnapshotFile, limit is int) {
        confirm limit > 0 && limit <= 1048576
            else throw InvalidSnapshot.because("limit must be 1..1048576");
        self.origin = origin;
        self.file = file;
        self.limit = limit;
    }

    // Fails when they differ or the file is missing.
    check() is void {
        CheckContext().verify();
        let actual = origin.bytes();
        confirm actual.size() <= limit else throw InvalidSnapshot.because("actual exceeds limit");
        let root = backend.snapshot_root_open(path_encode(file.root().string()));
        defer backend.snapshot_root_close(root);
        let expected = try {
            backend.snapshot_read(root, file.name(), limit);
        }
        catch error is NativeFailure {
            if error.code() == "not_found" {
                test.fail("missing snapshot: " + file.name());
                return;
            }
            throw error;
        };
        BytesEqual(actual: actual, expected: expected, context: 8).check();
    }
}

// Writes a snapshot.
object SnapshotUpdate {
    has origin is ByteSource;
    has file is SnapshotFile;
    has limit is int;

    // origin to file, at most limit bytes.
    SnapshotUpdate(origin is ByteSource, file is SnapshotFile, limit is int) {
        confirm limit > 0 && limit <= 1048576
            else throw InvalidSnapshot.because("limit must be 1..1048576");
        self.origin = origin;
        self.file = file;
        self.limit = limit;
    }

    // Writes it.
    update() is void {
        CheckContext().verify();
        let content = origin.bytes();
        confirm content.size() <= limit else throw InvalidSnapshot.because("actual exceeds limit");
        let root = backend.snapshot_root_open(path_encode(file.root().string()));
        defer backend.snapshot_root_close(root);
        backend.snapshot_write(root, file.name(), content);
    }
}

// A snapshot that cannot be used; reason says why.
enum InvalidSnapshot is Error = (because(reason is string));

test "text normalization is explicit" {
    test.is(TextSnapshot("a\r\nb\r").bytes(), TextSnapshot("a\nb\n").bytes());
}
