module testing/time v1.0.0;

// A clock for tests that moves only when told.
//
//     let clock = ManualClock(Instant(Duration(seconds: 1700000000)));
//     let waiting = cache.expire_later(clock);
//     clock.advance(Duration(minutes: 5));        // wakes what waited up to then
//
// It works only inside a test.

import "testing/check" take CheckContext;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration, DurationUnit;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "collections/ordering" take SortedBy;
import "compare" take Order;
import "runtime/time" take clock_domain;

// Test-context-only owner, no host clock or sleeping. State publication precedes
// every wake. Nested advance during wake dispatch is explicitly rejected.
object ManualClock does Timing {
    has cell is Atomic<ManualClockFrame>;
    has domain is string;

    // A clock at start; only inside a test.
    ManualClock(start is Instant) {
        CheckContext().verify();
        domain = clock_domain(true);
        cell = Atomic(
            ManualClockFrame(
                wall: start,
                elapsed: Duration(seconds: 0),
                waiters: [],
                serial: 0,
                closed: false,
                dispatching: false
            )
        );
    }

    // The wall time now.
    instant() is Instant {
        CheckContext().verify();
        self.open().wall();
    }

    // The monotonic time now.
    monotonic_instant() is MonotonicInstant {
        CheckContext().verify();
        MonotonicInstant(origin: self.open().elapsed(), domain: domain);
    }

    // Sets the wall time; the monotonic time stays.
    set_wall(value is Instant) is void {
        CheckContext().verify();
        let old = self.open();
        cell.replace(
            ManualClockFrame(
                wall: value,
                elapsed: old.elapsed(),
                waiters: old.waiters(),
                serial: old.serial(),
                closed: false,
                dispatching: old.dispatching()
            )
        );
    }

    // How many waits are pending.
    pending() is int {
        CheckContext().verify();
        cell.value().waiters().size();
    }

    // Whether it was closed.
    closed() is bool {
        CheckContext().verify();
        cell.value().closed();
    }

    // Moves both times forward, waking the waits that are due.
    advance(duration is Duration) is void {
        CheckContext().verify();
        confirm duration::Span::seconds >= 0.rat()
            else throw InvalidManualClock.because("negative advance");
        let old = self.open();
        confirm !old.dispatching()
            else throw InvalidManualClock.because("reentrant advance during wake dispatch");
        let elapsed = old.elapsed().plus(duration);
        let waiting = old.waiters();
        let due is @ManualClockWaiter = waiting.filter() -> entry {
            entry.deadline().order(elapsed) != Order.greater;
        };
        let remaining is @ManualClockWaiter = waiting.filter() -> entry {
            entry.deadline().order(elapsed) == Order.greater;
        };
        let sorted is SortedBy<ManualClockWaiter, Duration> = SortedBy(
            origin: due,
            key: (entry is ManualClockWaiter) is Duration {
                entry.deadline();
            }
        );
        cell.replace(
            ManualClockFrame(
                wall: old.wall().plus(duration),
                elapsed: elapsed,
                waiters: remaining,
                serial: old.serial(),
                closed: false,
                dispatching: true
            )
        );
        defer self.finish_dispatch();
        for (0..sorted.size()) -> index {
            sorted.item(index).signal().set();
        }
    }

    // Waits until the clock is advanced past duration.
    async wait(duration is Duration) is void {
        CheckContext().verify();
        confirm duration::Span::seconds >= 0.rat()
            else throw InvalidManualClock.because("negative wait");
        let old = self.open();
        if duration::Span::seconds == 0.rat() {
            return;
        }
        confirm old.waiters().size() < 1024 && old.serial() < 2000000000
            else throw InvalidManualClock.because("waiter/registration budget");
        let signal = Event();
        let id = old.serial() + 1;
        let waiting = old.waiters();
        let added is @ManualClockWaiter = waiting + [
            ManualClockWaiter(id: id, deadline: old.elapsed().plus(duration), signal: signal)
        ];
        cell.replace(
            ManualClockFrame(
                wall: old.wall(),
                elapsed: old.elapsed(),
                waiters: added,
                serial: id,
                closed: false,
                dispatching: old.dispatching()
            )
        );
        defer self.remove(id);
        await signal.wait();
        self.open();
    }

    // Closes it and drops its waits; ManualClockClosed after.
    close() is void {
        CheckContext().verify();
        let old = cell.value();
        if old.closed() {
            return;
        }
        cell.replace(
            ManualClockFrame(
                wall: old.wall(),
                elapsed: old.elapsed(),
                waiters: [],
                serial: old.serial(),
                closed: true,
                dispatching: old.dispatching()
            )
        );
        for old.waiters() -> entry {
            entry.signal().set();
        }
    }

    destroy {
        self.close();
    }

    hidden open() is ManualClockFrame {
        let frame = cell.value();
        confirm !frame.closed() else throw ManualClockClosed.closed;
        frame;
    }

    hidden remove(id is int) is void {
        let old = cell.value();
        let remaining is @ManualClockWaiter = old.waiters().filter() -> entry {
            entry.id() != id;
        };
        cell.replace(
            ManualClockFrame(
                wall: old.wall(),
                elapsed: old.elapsed(),
                waiters: remaining,
                serial: old.serial(),
                closed: old.closed(),
                dispatching: old.dispatching()
            )
        );
    }

    hidden finish_dispatch() is void {
        let old = cell.value();
        cell.replace(
            ManualClockFrame(
                wall: old.wall(),
                elapsed: old.elapsed(),
                waiters: old.waiters(),
                serial: old.serial(),
                closed: old.closed(),
                dispatching: false
            )
        );
    }
}

hidden object ManualClockWaiter {
    has id is int;
    has deadline is Duration;
    has signal is Event;

    ManualClockWaiter(id is int, deadline is Duration, signal is Event) {
        self.id = id;
        self.deadline = deadline;
        self.signal = signal;
    }

    id() is int {
        id;
    }

    deadline() is Duration {
        deadline;
    }

    signal() is Event {
        signal;
    }
}

hidden object ManualClockFrame {
    has wall is Instant;
    has elapsed is Duration;
    has waiters is @ManualClockWaiter;
    has serial is int;
    has closed, dispatching is bool;

    ManualClockFrame(
        wall is Instant,
        elapsed is Duration,
        waiters is @ManualClockWaiter,
        serial is int,
        closed is bool,
        dispatching is bool
    ) {
        self.wall = wall;
        self.elapsed = elapsed;
        self.waiters = waiters;
        self.serial = serial;
        self.closed = closed;
        self.dispatching = dispatching;
    }

    wall() is Instant {
        wall;
    }

    elapsed() is Duration {
        elapsed;
    }

    waiters() is @ManualClockWaiter {
        waiters;
    }

    serial() is int {
        serial;
    }

    closed() is bool {
        closed;
    }

    dispatching() is bool {
        dispatching;
    }
}

// The clock was used after close().
enum ManualClockClosed is Error = (closed);

// A clock used wrongly; reason says why.
enum InvalidManualClock is Error = (because(reason is string));

test "manual clock changes no host clock" {
    let clock = ManualClock(Instant(Duration(seconds: 0)));
    defer clock.close();
    clock.advance(Duration(seconds: 2));
    test.is(clock.monotonic_instant().reading()::Span::seconds, 2.rat());
}
