module testing/result v1.0.0;

// Test results: what each test did and the report of a run.
//
//     report.counts()::Counts::failures;
//     for report.results() -> result { result::Outcome::name; result::Outcome::status; }
//     report.exit_status();                    // 0 when nothing failed

import "time/clock" take Instant;
import "time/duration" take Duration, DurationUnit;
import "collections/sequence" take Sequencing;

// Passed, failed, skipped, timed out or crashed.
enum TestStatus = (passed, failed, skipped, timed_out, crashed);

// Where in the source.
object TestPosition {
    has source is string;
    has line, column is int;

    // source at line and column.
    TestPosition(source is string, line is int, column is int) {
        confirm source.length() > 0 && source.length() <= 4096 && line > 0 && column > 0
            else throw InvalidTestResult.because("source position");
        self.source = source;
        self.line = line;
        self.column = column;
    }

    // The source, line and column.
    cap Position {
        source is string {
            source;
        }

        line is int {
            line;
        }

        column is int {
            column;
        }
    }
}

// Why a test failed.
object TestFailure {
    has message is string;
    has position is @TestPosition;
    has causes is @TestFailure;
    has depth is int;

    // message without a position.
    TestFailure(message is string) {
        confirm message.length() <= 65536
            else throw InvalidTestResult.because("failure text length");
        self.message = message;
        position = [];
        causes = [];
        depth = 0;
    }

    // message at position.
    TestFailure(message is string, position is TestPosition) {
        confirm message.length() <= 65536
            else throw InvalidTestResult.because("failure text length");
        self.message = message;
        self.position = [position];
        causes = [];
        depth = 0;
    }

    // message at positions, caused by causes.
    TestFailure(
        message is string,
        positions is Sequencing<TestPosition>,
        causes is Sequencing<TestFailure>
    ) {
        confirm message.length() <= 65536
            && positions.size() >= 0
            && positions.size() <= 1
            && causes.size() >= 0
            && causes.size() <= 1
            else throw InvalidTestResult.because("failure details bounds");
        let places is @TestPosition = (0..positions.size()).map() -> index {
            positions.item(index);
        };
        let reasons is @TestFailure = (0..causes.size()).map() -> index {
            causes.item(index);
        };
        let depth = if reasons.size() == 0 {
            0;
        }
        else {
            reasons[0]::Failure::depth + 1;
        };
        confirm depth < 32 else throw InvalidTestResult.because("failure cause depth");
        self.message = message;
        position = places;
        self.causes = reasons;
        self.depth = depth;
    }

    // Whether it has a position.
    located() is bool {
        position.size() == 1;
    }

    // Its position; MissingTestPosition without one.
    position() is TestPosition {
        confirm position.size() == 1 else throw MissingTestPosition.missing;
        position[0];
    }

    // The failures behind it.
    causes() is Sequencing<TestFailure> {
        causes;
    }

    // The message and how deep its causes go.
    cap Failure {
        message is string {
            message;
        }

        depth is int {
            depth;
        }
    }
}

// A failure as text.
object TestFailureText {
    has origin is TestFailure;

    // The failure.
    TestFailureText(origin is TestFailure) {
        self.origin = origin;
    }

    // It with its positions and causes.
    string() is string {
        let causes = origin.causes();
        origin::Failure::message + (if causes.size() == 1 {
            "\ncaused by: " + TestFailureText(causes.item(0)).string();
        }
        else {
            "";
        });
    }
}

// What a test printed.
object TestOutput {
    has output, errors is @byte;
    has truncated is bool;

    // Its output and errors, and whether they were cut short.
    TestOutput(output is @byte, errors is @byte, truncated is bool) {
        confirm output.size() + errors.size() <= 16777216
            else throw InvalidTestResult.because("captured byte budget");
        self.output = output;
        self.errors = errors;
        self.truncated = truncated;
    }

    // The output, the errors and whether they were cut short.
    cap Captured {
        output is @byte {
            output;
        }

        errors is @byte {
            errors;
        }

        truncated is bool {
            truncated;
        }
    }
}

// What one test did.
object TestResult {
    has name is string;
    has status is TestStatus;
    has duration is Duration;
    has failures is @TestFailure;
    has output is TestOutput;
    has skip_reason is string;

    // As given.
    TestResult(
        name is string,
        status is TestStatus,
        duration is Duration,
        failures is Sequencing<TestFailure>,
        output is TestOutput
    ) {
        confirm name.length() > 0 && name.length() <= 4096 && duration::Span::seconds >= 0.rat()
            else throw InvalidTestResult.because("test name/duration");
        let count = failures.size();
        confirm count >= 0 && count <= 1024 else throw InvalidTestResult.because("failure count");
        confirm (status != TestStatus.passed && status != TestStatus.skipped) || count == 0
            else throw InvalidTestResult.because("passed/skipped result carries failures");
        let snapshot is @TestFailure = (0..count).map() -> index {
            failures.item(index);
        };
        self.name = name;
        self.status = status;
        self.duration = duration;
        self.failures = snapshot;
        self.output = output;
        skip_reason = "";
    }

    // As given, with why it was skipped.
    TestResult(
        name is string,
        status is TestStatus,
        duration is Duration,
        failures is Sequencing<TestFailure>,
        output is TestOutput,
        skip_reason is string
    ) {
        confirm skip_reason.length() <= 4096 && (skip_reason == "" || status != TestStatus.passed)
            else throw InvalidTestResult.because("skip reason");
        confirm name.length() > 0 && name.length() <= 4096 && duration::Span::seconds >= 0.rat()
            else throw InvalidTestResult.because("test name/duration");
        let count = failures.size();
        confirm count >= 0 && count <= 1024 else throw InvalidTestResult.because("failure count");
        confirm (status != TestStatus.passed && status != TestStatus.skipped) || count == 0
            else throw InvalidTestResult.because("passed/skipped result carries failures");
        let snapshot is @TestFailure = (0..count).map() -> index {
            failures.item(index);
        };
        self.name = name;
        self.status = status;
        self.duration = duration;
        self.failures = snapshot;
        self.output = output;
        self.skip_reason = skip_reason;
    }

    // How long it ran.
    duration() is Duration {
        duration;
    }

    // Why it failed.
    failures() is Sequencing<TestFailure> {
        failures;
    }

    // What it printed.
    output() is TestOutput {
        output;
    }

    // Its name, status and skip reason.
    cap Outcome {
        name is string {
            name;
        }

        status is TestStatus {
            status;
        }

        skip_reason is string {
            skip_reason;
        }
    }
}

// How many passed, failed and were skipped.
object TestCounts {
    has passes, failures, skips is int;

    // As given.
    TestCounts(passes is int, failures is int, skips is int) {
        confirm passes >= 0 && failures >= 0 && skips >= 0 && passes + failures + skips <= 4096
            else throw InvalidTestResult.because("test counts");
        self.passes = passes;
        self.failures = failures;
        self.skips = skips;
    }

    // All of them.
    total() is int {
        passes + failures + skips;
    }

    // Passes, failures and skips.
    cap Counts {
        passes is int {
            passes;
        }

        failures is int {
            failures;
        }

        skips is int {
            skips;
        }
    }
}

// A run of tests.
object TestReport {
    has start is Instant;
    has duration is Duration;
    has seed is int;
    has results is @TestResult;
    has counts is TestCounts;

    // Started at start, lasting duration, with seed and results.
    TestReport(
        start is Instant,
        duration is Duration,
        seed is int,
        results is Sequencing<TestResult>
    ) {
        confirm duration::Span::seconds >= 0.rat()
            else throw InvalidTestResult.because("negative report duration");
        let size = results.size();
        confirm size >= 0 && size <= 4096 else throw InvalidTestResult.because("result count");
        let snapshot is @TestResult = (0..size).map() -> index {
            results.item(index);
        };
        let bytes = snapshot.reduce(0) -> total, result {
            total + result.output()::Captured::output.size() + result.output()::Captured::errors.size();
        };
        let scalars = snapshot.reduce(0) -> total, result {
            let failures = result.failures();
            let messages = (0..failures.size()).reduce(0) -> sum, index {
                sum + TestFailureText(failures.item(index)).string().length();
            };
            total + result::Outcome::name.length() + result::Outcome::skip_reason.length() + messages;
        };
        confirm bytes <= 16777216 && scalars <= 1048576
            else throw InvalidTestResult.because("aggregate report budget");
        let passed = snapshot.reduce(0) -> total, result {
            total + (if result::Outcome::status == TestStatus.passed {
                1;
            }
            else {
                0;
            });
        };
        let skipped = snapshot.reduce(0) -> total, result {
            total + (if result::Outcome::status == TestStatus.skipped {
                1;
            }
            else {
                0;
            });
        };
        self.start = start;
        self.duration = duration;
        self.seed = seed;
        self.results = snapshot;
        counts = TestCounts(passes: passed, failures: size - passed - skipped, skips: skipped);
    }

    // When it started.
    start() is Instant {
        start;
    }

    // How long it took.
    duration() is Duration {
        duration;
    }

    // The seed of the run.
    seed() is int {
        seed;
    }

    // Every result, in order.
    results() is Sequencing<TestResult> {
        results;
    }

    // The counts.
    counts() is TestCounts {
        counts;
    }

    // 0 when nothing failed, 1 otherwise.
    exit_status() is int {
        if counts::Counts::failures == 0 {
            0;
        }
        else {
            1;
        }
    }
}

// The failure has no position.
enum MissingTestPosition is Error = (missing);

// A result that cannot be built; reason says why.
enum InvalidTestResult is Error = (because(reason is string));

test "empty reports have successful exit status" {
    let duration = Duration(seconds: 0);
    test.is(
        TestReport(start: Instant(duration), duration: duration, seed: 42, results: []).exit_status(),
        0
    );
}
