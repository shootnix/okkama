module time/zone v1.0.0;

import "time/duration" take Duration, DurationUnit;
import "time/clock" take Instant;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "time/local_datetime" take LocalDateTime;
import "runtime/time_zone" take timezone_version, timezone_known, timezone_offset,
    timezone_daylight, timezone_abbreviation, timezone_local_candidates, timezone_local_instant;

// Deterministic time-zone values backed only by bundled IANA tzdata 2026c.
//
//     let zone = Zone(name: "America/New_York");
//     let local = ZonedDateTime(instant: clock.instant(), zone: zone)
//         .local_datetime();
//     TimeZoneDatabaseVersion().string(); // "2026c"
//
// Named zones never inspect the host's configured zone or host tzdata. Absolute
// to local conversion is total for instants whose local date lies in 1..9999.
// Local gaps throw MissingLocalTime; folds require an explicit earlier/later
// choice. FixedZone has no daylight-saving state and uses its name as its
// abbreviation.

enum Fold = (earlier, later);

role TimeZone {
    name() is string;
    offset(at is Instant) is Duration;
    daylight_saving(at is Instant) is bool;
    abbreviation(at is Instant) is string;
    instant(origin is LocalDateTime, fold is Fold) is Instant;
}

object Zone does TimeZone {
    has origin is string;

    Zone(name is string) {
        confirm timezone_known(name) else throw UnknownTimeZone.name(name);
        origin = name;
    }

    name() is string {
        origin;
    }

    offset(at is Instant) is Duration {
        Duration(
            value: timezone_offset(origin, at.unix_duration()::Span::seconds).rat(),
            unit: DurationUnit.second,
        );
    }

    daylight_saving(at is Instant) is bool {
        timezone_daylight(origin, at.unix_duration()::Span::seconds);
    }

    abbreviation(at is Instant) is string {
        timezone_abbreviation(origin, at.unix_duration()::Span::seconds);
    }

    instant(local is LocalDateTime, fold is Fold) is Instant {
        let date is Date = local.date();
        let time is TimeOfDay = local.time();
        confirm timezone_local_candidates(
            origin,
            date::Calendar::year,
            date::Calendar::month,
            date::Calendar::day,
            time::Clock::hour,
            time::Clock::minute,
            time::Clock::second,
            time::Clock::nanosecond,
        ) > 0
            else throw MissingLocalTime.zone(origin);
        Instant(origin: Duration(
            value: timezone_local_instant(
                origin,
                date::Calendar::year,
                date::Calendar::month,
                date::Calendar::day,
                time::Clock::hour,
                time::Clock::minute,
                time::Clock::second,
                time::Clock::nanosecond,
                fold == Fold.later,
            ),
            unit: DurationUnit.second,
        ));
    }
}

object FixedZone does TimeZone {
    has zone_name is string;
    has zone_offset is Duration;

    FixedZone(name is string, offset is Duration) {
        confirm name.length() > 0
            else throw InvalidTimeZone.because("fixed time-zone name must not be empty");
        confirm offset::Span::seconds.denominator() == "1"
            else throw InvalidTimeZone.because("time-zone offset must contain whole seconds");
        confirm offset::Span::seconds > -86400.rat() && offset::Span::seconds < 86400.rat()
            else throw InvalidTimeZone.because("time-zone offset must be within one day");
        zone_name = name;
        zone_offset = offset;
    }

    name() is string {
        zone_name;
    }

    offset(at is Instant) is Duration {
        zone_offset;
    }

    daylight_saving(at is Instant) is bool {
        false;
    }

    abbreviation(at is Instant) is string {
        zone_name;
    }

    instant(local is LocalDateTime, fold is Fold) is Instant {
        let epoch is LocalDateTime = LocalDateTime(
            date: Date(year: 1970, month: 1, day: 1),
            time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
        );
        Instant(origin: local.minus(epoch).minus(zone_offset));
    }
}

object ZonedDateTime {
    has source_instant is Instant;
    has source_zone is TimeZone;

    ZonedDateTime(instant is Instant, zone is TimeZone) {
        source_instant = instant;
        source_zone = zone;
    }

    instant() is Instant {
        source_instant;
    }

    zone() is TimeZone {
        source_zone;
    }

    local_datetime() is LocalDateTime {
        let epoch is LocalDateTime = LocalDateTime(
            date: Date(year: 1970, month: 1, day: 1),
            time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
        );
        epoch.plus(source_instant.unix_duration()).plus(self.offset());
    }

    offset() is Duration {
        source_zone.offset(source_instant);
    }
}

object ZoneObservation {
    has origin is ZonedDateTime;

    ZoneObservation(origin is ZonedDateTime) {
        self.origin = origin;
    }

    daylight_saving() is bool {
        origin.zone().daylight_saving(origin.instant());
    }

    abbreviation() is string {
        origin.zone().abbreviation(origin.instant());
    }
}

// A local date-time in a time zone, read as an instant; `fold` picks the
// earlier or later of an ambiguous wall time.
object Zoned {
    has origin is LocalDateTime;
    has zone is TimeZone;
    has fold is Fold;

    Zoned(local is LocalDateTime, zone is TimeZone, fold is Fold) {
        origin = local;
        self.zone = zone;
        self.fold = fold;
    }

    instant() is Instant {
        zone.instant(origin, fold);
    }
}

object TimeZoneDatabaseVersion {
    TimeZoneDatabaseVersion();

    string() is string {
        timezone_version();
    }
}

enum UnknownTimeZone is Error = (name(name is string));

enum InvalidTimeZone is Error = (because(message is string));

enum MissingLocalTime is Error = (zone(name is string));

test "local times resolve to instants through a named zone" {
    let at = (year is int, month is int, day is int, hour is int, minute is int) is LocalDateTime {
        LocalDateTime(
            date: Date(year: year, month: month, day: day),
            time: TimeOfDay(hour: hour, minute: minute, second: 0, nanosecond: 0),
        );
    };
    let unix = (instant is Instant) is rat { instant.unix_duration()::Span::seconds; };
    let york = Zone("America/New_York");
    test.is(unix(Zoned(local: at(2026, 7, 1, 12, 0), zone: york, fold: Fold.earlier).instant()), 1782921600.rat());
    let berlin = Zone("Europe/Berlin");
    test.is(unix(Zoned(local: at(2026, 1, 15, 12, 0), zone: berlin, fold: Fold.later).instant()), 1768474800.rat());
    // 02:30 happens twice when summer time ends, and never when it starts.
    test.is(unix(Zoned(local: at(2026, 10, 25, 2, 30), zone: berlin, fold: Fold.earlier).instant()), 1792888200.rat());
    test.is(unix(Zoned(local: at(2026, 10, 25, 2, 30), zone: berlin, fold: Fold.later).instant()), 1792891800.rat());
    test.is(
        try {
            Zoned(local: at(2026, 3, 29, 2, 30), zone: berlin, fold: Fold.earlier).instant();
            "found";
        }
        catch MissingLocalTime.zone(name) {
            name;
        },
        "Europe/Berlin"
    );
}

test "a zone shows an instant as local time with its offset" {
    let summer = Instant(origin: Duration(value: 1792888200.rat(), unit: DurationUnit.second));
    let winter = Instant(origin: Duration(value: 1792891800.rat(), unit: DurationUnit.second));
    let berlin = Zone("Europe/Berlin");
    test.is(berlin.name(), "Europe/Berlin");
    let before = ZonedDateTime(instant: summer, zone: berlin);
    test.is(before.local_datetime().time()::Clock::hour, 2);
    test.is(before.offset()::Span::seconds, 7200.rat());
    test.is(ZoneObservation(origin: before).abbreviation(), "CEST");
    test.ok(ZoneObservation(origin: before).daylight_saving());
    let after = ZonedDateTime(instant: winter, zone: berlin);
    test.is(after.local_datetime().time()::Clock::hour, 2);
    test.is(after.offset()::Span::seconds, 3600.rat());
    test.is(berlin.abbreviation(winter), "CET");
    test.ok(!berlin.daylight_saving(winter));
    test.is(TimeZoneDatabaseVersion().string(), "2026c");
}

test "fixed zones have one offset and refuse bad ones" {
    let plus_five = FixedZone(name: "UTC+5", offset: Duration(value: 5.rat(), unit: DurationUnit.hour));
    let instant = Instant(origin: Duration(value: 0.rat(), unit: DurationUnit.second));
    test.is(plus_five.offset(instant)::Span::seconds, 18000.rat());
    test.is(plus_five.abbreviation(instant), "UTC+5");
    test.ok(!plus_five.daylight_saving(instant));
    test.is(ZonedDateTime(instant: instant, zone: plus_five).local_datetime().time()::Clock::hour, 5);
    test.is(
        try {
            FixedZone(name: "far", offset: Duration(value: 25.rat(), unit: DurationUnit.hour)).name();
        }
        catch error is InvalidTimeZone {
            "refused";
        },
        "refused"
    );
    test.is(
        try {
            Zone("Mars/Base").name();
        }
        catch UnknownTimeZone.name(name) {
            "unknown " + name;
        },
        "unknown Mars/Base"
    );
}
