module time/rfc3339 v1.0.0;

import "time/duration" take Duration, DurationUnit;
import "time/clock" take Instant;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "time/local_datetime" take LocalDateTime;
import "time/iso" take IsoLocalDateTime, IsoText, InvalidIsoLocalDateTime;
import "strings/parse" take Number, InvalidInteger;

// Strict nanosecond-resolution RFC 3339 timestamps.
//
//     Rfc3339(
//         origin: clock.instant(),
//         offset: Duration(value: 0.rat(), unit: DurationUnit.second),
//     ).string(); // ...Z
//
//     let instant = Rfc3339("2026-08-11T12:30:45.125+05:00").instant();
//
// This profile requires uppercase T/Z, seconds and either Z or ±HH:MM.
// Fractions contain one through nine digits and are never rounded. Numeric
// offsets must be whole minutes and have magnitude below 24 hours. Parsing
// accepts RFC 3339 `-00:00` as a zero displacement with unknown local-offset
// provenance; formatting canonicalizes every zero displacement to `Z`.

object Rfc3339 {
    has origin is Instant;
    has offset is Duration;

    Rfc3339(origin is Instant, offset is Duration) {
        confirm offset::Span::seconds.denominator() == "1"
            else throw InvalidRfc3339Offset.because("RFC 3339 offset must contain whole seconds");
        let seconds is int = offset::Span::seconds.int();
        confirm seconds % 60 == 0
            else throw InvalidRfc3339Offset.because("RFC 3339 offset must contain whole minutes");
        confirm seconds > -86400 && seconds < 86400
            else throw InvalidRfc3339Offset.because(
                "RFC 3339 offset magnitude must be below 24 hours"
            );
        self.origin = origin;
        self.offset = offset;
    }

    // Reads a timestamp; its offset is kept for string().
    Rfc3339(text is string) {
        let length is int = text.length();
        confirm length >= 20 else throw InvalidRfc3339.origin(text);

        let utc is bool = text.slice(length - 1, length) == "Z";
        let numeric is bool = length >= 25
            && (text.slice(length - 6, length - 5) == "+"
            || text.slice(length - 6, length - 5) == "-")
            && text.slice(length - 3, length - 2) == ":";
        confirm utc || numeric else throw InvalidRfc3339.origin(text);

        let local_source is string = if utc {
            text.slice(0, length - 1);
        }
        else {
            text.slice(0, length - 6);
        };
        let local is LocalDateTime = try {
            IsoText(local_source).local_date_time();
        }
        catch error is InvalidIsoLocalDateTime {
            throw InvalidRfc3339.origin(text);
        };

        let offset is Duration = if utc {
            Duration(value: 0.rat(), unit: DurationUnit.second);
        }
        else {
            try {
                let hour is int = Number(text.slice(length - 5, length - 3)).int();
                let minute is int = Number(text.slice(length - 2, length)).int();
                confirm hour <= 23 && minute <= 59
                    else throw InvalidRfc3339.origin(text);
                let sign is int = if text.slice(length - 6, length - 5) == "-" {
                    -1;
                }
                else {
                    1;
                };
                Duration(
                    value: (sign * (hour * 3600 + minute * 60)).rat(),
                    unit: DurationUnit.second,
                );
            }
            catch error is InvalidInteger {
                throw InvalidRfc3339.origin(text);
            }
        };

        let epoch is LocalDateTime = LocalDateTime(
            date: Date(year: 1970, month: 1, day: 1),
            time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
        );
        self.origin = Instant(origin: local.minus(epoch).minus(offset));
        self.offset = offset;
    }

    instant() is Instant {
        origin;
    }

    string() is string {
        let epoch is LocalDateTime = LocalDateTime(
            date: Date(year: 1970, month: 1, day: 1),
            time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
        );
        let local is LocalDateTime = epoch
            .plus(origin.unix_duration())
            .plus(offset);
        let seconds is int = offset::Span::seconds.int();
        let suffix is string = if seconds == 0 {
            "Z";
        }
        else {
            let sign is string = if seconds < 0 {
                "-";
            }
            else {
                "+";
            };
            let magnitude is int = if seconds < 0 {
                -seconds;
            }
            else {
                seconds;
            };
            let hour is string = (magnitude / 3600).int().string();
            let minute is string = ((magnitude % 3600) / 60).int().string();
            sign +
                ("00" + hour).slice(hour.length(), hour.length() + 2) +
                ":" +
                ("00" + minute).slice(minute.length(), minute.length() + 2);
        };
        IsoLocalDateTime(origin: local).string() + suffix;
    }
}

enum InvalidRfc3339 is Error = (origin(origin is string));

enum InvalidRfc3339Offset is Error = (because(message is string));

test "RFC 3339 text reads an instant and keeps its offset" {
    let read = Rfc3339("2026-08-11T12:30:45.125+05:00");
    test.is(read.string(), "2026-08-11T12:30:45.125+05:00");
    let utc = Rfc3339(
        origin: read.instant(),
        offset: Duration(value: 0.rat(), unit: DurationUnit.second)
    );
    test.is(utc.string(), "2026-08-11T07:30:45.125Z");
    test.is(Rfc3339("1970-01-01T00:00:00Z").instant().unix_duration()::Span::seconds.string(), "0");
    for ["2026-08-11t12:30:45Z", "2026-08-11T12:30:45", "2026-08-11T12:30:45+5:00"] -> bad {
        test.is(
            try {
                Rfc3339(bad).instant();
                "accepted";
            }
            catch InvalidRfc3339.origin(given) {
                given;
            },
            bad
        );
    }
}
