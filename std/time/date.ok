module time/date v1.0.0;

import "compare" take Comparing, Order;

// Immutable dates in the proleptic Gregorian calendar.
//
//     let release = Date(year: 2026, month: 8, day: 11);
//     release.weekday(); // Weekday.tuesday
//     let tomorrow = release.shifted(1);
//     DaysBetween(left: release, right: tomorrow).count(); // 1
//
// Supported years are 1..9999. There is no year zero, implicit time zone or
// host calendar dependency. Date ordinals are one-based: 0001-01-01 is day 1
// and Monday. DaysBetween(left: left, right: right) is signed and means right minus left.

enum Weekday = (monday, tuesday, wednesday, thursday, friday, saturday, sunday);

object Date does Comparing<Date> {
    has year_value is int;
    has month_value is int;
    has day_value is int;

    Date(year is int, month is int, day is int) {
        confirm year >= 1 && year <= 9999
            else throw InvalidDate.because("date year must be within 1..9999");
        confirm month >= 1 && month <= 12
            else throw InvalidDate.because("date month must be within 1..12");

        let leap is bool = year % 4 == 0
            && (year % 100 != 0 || year % 400 == 0);
        let maximum is int = match month {
            case 2 {
                if leap {
                    29;
                }
                else {
                    28;
                }
            }
            case 4, 6, 9, 11 {
                30;
            }
            else {
                31;
            }
        };
        confirm day >= 1 && day <= maximum
            else throw InvalidDate.because("date day is outside the selected month");

        year_value = year;
        month_value = month;
        day_value = day;
    }

    // The date of a day number counted from 0001-01-01 (day 1), as
    // day_number() answers it: Date(day_number: 739931).
    Date(day_number is int) {
        let found = GregorianDay(day_number).date();
        year_value = found::Calendar::year;
        month_value = found::Calendar::month;
        day_value = found::Calendar::day;
    }

    // The parts of the date, already checked by the constructor.
    cap Calendar {
        year is int {
            year_value;
        }

        month is int {
            month_value;
        }

        day is int {
            day_value;
        }
    }

    // ISO 8601: "2026-08-11".
    string() is string {
        let year is string = year_value.string();
        let month is string = month_value.string();
        let day is string = day_value.string();
        ("0000" + year).slice(year.length(), year.length() + 4) +
            "-" +
            ("00" + month).slice(month.length(), month.length() + 2) +
            "-" +
            ("00" + day).slice(day.length(), day.length() + 2);
    }

    weekday() is Weekday {
        match (GregorianDay(self).number() - 1) % 7 {
            case 0 {
                Weekday.monday;
            }
            case 1 {
                Weekday.tuesday;
            }
            case 2 {
                Weekday.wednesday;
            }
            case 3 {
                Weekday.thursday;
            }
            case 4 {
                Weekday.friday;
            }
            case 5 {
                Weekday.saturday;
            }
            else {
                Weekday.sunday;
            }
        }
    }

    order(other is Date) is Order {
        if year_value != other::Calendar::year {
            year_value.order(other::Calendar::year);
        }
        else {
            if month_value != other::Calendar::month {
                month_value.order(other::Calendar::month);
            }
            else {
                day_value.order(other::Calendar::day);
            }
        }
    }

    // The day number, counted from 0001-01-01 (day 1).
    day_number() is int {
        GregorianDay(self).number();
    }

    // Days from this date to `other`, negative when `other` is earlier.
    days_until(other is Date) is int {
        GregorianDay(other).number() - GregorianDay(self).number();
    }

    // This date moved by `days` (negative: earlier).
    shifted(days is int) is Date {
        let number is int = GregorianDay(self).number();
        confirm days >= 1 - number && days <= 3652059 - number
            else throw InvalidDate.because("shifted date is outside years 1..9999");
        GregorianDay(number + days).date();
    }
}

object DaysBetween {
    has left is Date;
    has right is Date;

    DaysBetween(left is Date, right is Date) {
        self.left = left;
        self.right = right;
    }

    count() is int {
        GregorianDay(right).number() - GregorianDay(left).number();
    }
}

enum InvalidDate is Error = (because(message is string));

// The day number of a date in the proleptic Gregorian calendar, counted from
// 0001-01-01 (day 1), and the date of a day number: the shared arithmetic
// representation of dates.
//
//     GregorianDay(Date(year: 1970, month: 1, day: 1)).number(); // 719163
//     GregorianDay(719163).date();                              // 1970-01-01
object GregorianDay {
    has origin is int;
    has given is Maybe<Date>;

    GregorianDay(date is Date) {
        origin = 0;
        given = Maybe.some(date);
    }

    GregorianDay(number is int) {
        confirm number >= 1 && number <= 3652059
            else throw InvalidDate.because("day number is outside years 1..9999");
        origin = number;
        given = Maybe<Date>.none;
    }

    number() is int {
        once let counted = self.counted();
        counted;
    }

    // The day number: given, or counted from the date.
    hidden counted() is int {
        match given {
            case Maybe.some(date) {
                self.count(date);
            }
            else {
                origin;
            }
        }
    }

    hidden count(date is Date) is int {
        let year is int = date::Calendar::year;
        let month is int = date::Calendar::month;
        let previous_year is int = year - 1;
        let leap is bool = year % 4 == 0
            && (year % 100 != 0 || year % 400 == 0);
        let adjustment is int = if month <= 2 {
            0;
        }
        else {
            if leap {
                -1;
            }
            else {
                -2;
            }
        };
        previous_year * 365 +
            (previous_year / 4).int() -
            (previous_year / 100).int() +
            (previous_year / 400).int() +
            ((367 * month - 362) / 12).int() +
            adjustment +
            date::Calendar::day;
    }

    date() is Date {
        let shifted is int = self.number() + 305;
        let era is int = (shifted / 146097).int();
        let day_of_era is int = shifted - era * 146097;
        let year_of_era is int = ((day_of_era -
            (day_of_era / 1460).int() +
            (day_of_era / 36524).int() -
            (day_of_era / 146096).int()) / 365).int();
        let year_base is int = year_of_era + era * 400;
        let day_of_year is int = day_of_era - (year_of_era * 365 +
            (year_of_era / 4).int() -
            (year_of_era / 100).int());
        let month_part is int = ((5 * day_of_year + 2) / 153).int();
        let day is int = day_of_year -
            ((153 * month_part + 2) / 5).int() +
            1;
        let month is int = if month_part < 10 {
            month_part + 3;
        }
        else {
            month_part - 9;
        };
        let year is int = year_base + (if month <= 2 {
            1;
        }
        else {
            0;
        });

        Date(year: year, month: month, day: day);
    }
}

test "dates shift, count days between and map to day numbers" {
    let release = Date(year: 2026, month: 8, day: 11);
    test.is(release.weekday(), Weekday.tuesday);
    test.is(release.shifted(1)::Calendar::day, 12);
    test.is(release.shifted(-11)::Calendar::month, 7);
    test.is(release.shifted(143)::Calendar::year, 2027);
    test.is(DaysBetween(left: release, right: release.shifted(30)).count(), 30);
    test.is(DaysBetween(left: release.shifted(30), right: release).count(), -30);
    test.is(GregorianDay(Date(year: 1, month: 1, day: 1)).number(), 1);
    test.is(GregorianDay(Date(year: 1970, month: 1, day: 1)).number(), 719163);
    test.is(GregorianDay(719163).date()::Calendar::year, 1970);
    test.is(GregorianDay(GregorianDay(release).number()).date().order(release), Order.equal);
    test.ok(try {
        GregorianDay(0).date();
        false;
    }
    catch e is InvalidDate {
        true;
    });
    test.ok(try {
        Date(year: 9999, month: 12, day: 31).shifted(1);
        false;
    }
    catch e is InvalidDate {
        true;
    });
}

test "a date writes itself in ISO 8601" {
    test.is(Date(year: 2026, month: 8, day: 11).string(), "2026-08-11");
    test.is(Date(year: 1, month: 1, day: 1).string(), "0001-01-01");
}

test "a date counts its own days" {
    let release = Date(year: 2026, month: 11, day: 11);
    test.is(release.days_until(release.shifted(30)), 30);
    test.is(release.shifted(30).days_until(release), -30);
    test.is(Date(year: 1970, month: 1, day: 1).day_number(), 719163);
    test.ok(Date(day_number: release.day_number()) == release);
    test.is(Date(day_number: 1).string(), "0001-01-01");
    test.throws(InvalidDate) {
        Date(day_number: 0);
    };
}
