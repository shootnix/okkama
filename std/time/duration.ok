module time/duration v1.0.0;

import "compare" take Comparing, Order;
import "operators" take Adding, Subtracting, Negating;
import "numbers/bigint" take BigInt;

// Exact immutable durations with nanosecond resolution.
//
//     let delay = Duration(value: rat(3, 2), unit: DurationUnit.second);
//     delay::Span::seconds;          // rat(3, 2)
//     delay.nanoseconds().string();  // "1500000000"
//     DurationString(origin: delay).string(); // "3/2s"
//
// Every unit is an exact rational number of seconds. A day is exactly 86,400
// seconds and is not a civil-calendar day. Negative and zero durations are
// valid. Construction and scaling reject values that cannot be represented as
// an integral number of nanoseconds; no rounding is performed.
//
// DurationString is a lossless canonical `<rat>s` representation. Primitive
// numbers deliberately have no `.duration()` or unit conversion methods: a
// stdlib type is always introduced through its explicit constructor.

enum DurationUnit = (nanosecond, microsecond, millisecond, second, minute, hour, day);

object Duration does Comparing<Duration>, Adding<Duration, Duration>, Subtracting<Duration, Duration>, Negating<Duration> {
    has origin is rat;

    Duration(value is rat, unit is DurationUnit) {
        let multiplier is rat = match unit {
            case DurationUnit.nanosecond {
                rat(1, 1000000000);
            }
            case DurationUnit.microsecond {
                rat(1, 1000000);
            }
            case DurationUnit.millisecond {
                rat(1, 1000);
            }
            case DurationUnit.second {
                1.rat();
            }
            case DurationUnit.minute {
                60.rat();
            }
            case DurationUnit.hour {
                3600.rat();
            }
            case DurationUnit.day {
                86400.rat();
            }
            else {
                1.rat();
            }
        };
        let seconds is rat = value * multiplier;
        confirm (seconds * 1000000000.rat()).denominator() == "1"
            else throw InvalidDuration.because(
                "duration must contain an integral number of nanoseconds"
            );
        origin = seconds;
    }

    // Whole amounts of one unit: Duration(seconds: 5), Duration(milliseconds: 250).
    Duration(days is int) {
        origin = days.rat() * 86400.rat();
    }

    Duration(hours is int) {
        origin = hours.rat() * 3600.rat();
    }

    Duration(minutes is int) {
        origin = minutes.rat() * 60.rat();
    }

    Duration(seconds is int) {
        origin = seconds.rat();
    }

    Duration(milliseconds is int) {
        origin = rat(milliseconds, 1000);
    }

    Duration(microseconds is int) {
        origin = rat(microseconds, 1000000);
    }

    Duration(nanoseconds is int) {
        origin = rat(nanoseconds, 1000000000);
    }

    // The exact length in seconds, normalised by the constructor.
    cap Span {
        seconds is rat {
            origin;
        }
    }

    nanoseconds() is BigInt {
        BigInt(origin: (origin * 1000000000.rat()).numerator());
    }

    plus(other is Duration) is Duration {
        Duration(
            value: origin + other::Span::seconds,
            unit: DurationUnit.second,
        );
    }

    minus(other is Duration) is Duration {
        Duration(
            value: origin - other::Span::seconds,
            unit: DurationUnit.second,
        );
    }

    // -a
    negated() is Duration {
        Duration(value: -origin, unit: DurationUnit.second);
    }

    // This duration scaled by `factor`.
    times(factor is rat) is Duration {
        Duration(value: origin * factor, unit: DurationUnit.second);
    }

    order(other is Duration) is Order {
        origin.order(other::Span::seconds);
    }
}

object DurationString {
    has origin is Duration;

    DurationString(origin is Duration) {
        self.origin = origin;
    }

    string() is string {
        origin::Span::seconds.string() + "s";
    }
}

enum InvalidDuration is Error = (because(message is string));

test "durations scale exactly" {
    let minute = Duration(minutes: 1);
    test.is(minute.times(rat(3, 2))::Span::seconds.string(), "90");
    test.is(minute.times(0.rat())::Span::seconds.string(), "0");
    test.is(minute.times(-2.rat())::Span::seconds.string(), "-120");
}

test "whole amounts of one unit" {
    test.is(Duration(seconds: 5) == Duration(value: 5.rat(), unit: DurationUnit.second), true);
    test.is(Duration(milliseconds: 250)::Span::seconds, rat(1, 4));
    test.is(Duration(minutes: 2)::Span::seconds, 120.rat());
    test.is(Duration(hours: 1) == Duration(minutes: 60), true);
    test.is(Duration(days: 1)::Span::seconds, 86400.rat());
    test.is(Duration(microseconds: 1500)::Span::seconds, rat(3, 2000));
    test.is(Duration(nanoseconds: 1).nanoseconds().string(), "1");
    test.is(Duration(seconds: -3)::Span::seconds, -3.rat());
}
