module time/clock v1.0.0;

import "compare" take Comparing, Order;
import "operators" take Adding, Subtracting;
import "time/duration" take Duration, DurationUnit;
import "time/local_datetime" take LocalDateTime;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "runtime/time" take wall_clock, monotonic_clock, clock_domain, sleep_nanoseconds;

// Wall-clock and monotonic time are deliberately different nominal values.
//
//     let clock = SystemClock();
//     let before = clock.monotonic_instant();
//     await clock.wait(Duration(milliseconds: 5));
//     let elapsed = clock.monotonic_instant().minus(before);
//
// Instant is a duration from the Unix epoch and may later be interpreted by
// civil-time modules. MonotonicInstant is only a runtime-local reading suitable
// for ordering and elapsed-time measurement. It has no Unix/civil projection.
// Runtime readings carry a domain; comparisons across domains are rejected.
// The one-argument constructor binds explicitly supplied readings to the
// "explicit" domain and never claims compatibility with a live clock.

object Instant does Comparing<Instant>, Adding<Duration, Instant>, Subtracting<Duration, Instant>, Subtracting<Instant, Duration> {
    has origin is Duration;

    Instant(origin is Duration) {
        self.origin = origin;
    }

    unix_duration() is Duration {
        origin;
    }

    // RFC 3339 in UTC: "2026-12-01T08:00:00Z". Rfc3339 writes other offsets.
    string() is string {
        let epoch = LocalDateTime(
            date: Date(year: 1970, month: 1, day: 1),
            time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
        );
        epoch.plus(origin).string() + "Z";
    }

    plus(duration is Duration) is Instant {
        Instant(origin: origin.plus(duration));
    }

    minus(duration is Duration) is Instant {
        Instant(origin: origin.minus(duration));
    }

    minus(other is Instant) is Duration {
        origin.minus(other.unix_duration());
    }

    order(other is Instant) is Order {
        origin.order(other.unix_duration());
    }
}

object MonotonicInstant does Comparing<MonotonicInstant>, Adding<Duration, MonotonicInstant>, Subtracting<Duration, MonotonicInstant>, Subtracting<MonotonicInstant, Duration> {
    has origin is Duration;
    has domain is string;

    MonotonicInstant(origin is Duration) {
        self.origin = origin;
        domain = "explicit";
    }

    MonotonicInstant(origin is Duration, domain is string) {
        confirm domain.length() > 0 && domain.length() <= 128
            else throw IncompatibleClock.incompatible;
        self.origin = origin;
        self.domain = domain;
    }

    domain() is string {
        domain;
    }

    reading() is Duration {
        origin;
    }

    plus(duration is Duration) is MonotonicInstant {
        MonotonicInstant(origin: origin.plus(duration), domain: domain);
    }

    minus(duration is Duration) is MonotonicInstant {
        MonotonicInstant(origin: origin.minus(duration), domain: domain);
    }

    minus(other is MonotonicInstant) is Duration {
        confirm domain == other.domain() else throw IncompatibleClock.incompatible;
        origin.minus(other.reading());
    }

    order(other is MonotonicInstant) is Order {
        confirm domain == other.domain() else throw IncompatibleClock.incompatible;
        origin.order(other.reading());
    }
}

// wait completes without a value; await it as a statement.
role Timing {
    instant() is Instant;
    monotonic_instant() is MonotonicInstant;
    async wait(duration is Duration) is void;
}

object SystemClock does Timing {
    SystemClock();

    instant() is Instant {
        Instant(origin: Duration(
            value: wall_clock().rat(),
            unit: DurationUnit.nanosecond,
        ));
    }

    monotonic_instant() is MonotonicInstant {
        MonotonicInstant(
            origin: Duration(
                value: monotonic_clock().rat(),
                unit: DurationUnit.nanosecond,
            ),
            domain: clock_domain(false)
        );
    }

    async wait(duration is Duration) is void {
        confirm duration::Span::seconds >= 0.rat()
            else throw InvalidWait.because("wait duration must not be negative");
        await sleep_nanoseconds(duration.nanoseconds().string());
    }
}

enum IncompatibleClock is Error = (incompatible);

enum InvalidWait is Error = (because(message is string));

test "instants are durations from the epoch" {
    let second = Duration(seconds: 1);
    let epoch = Instant(origin: Duration(seconds: 0));
    let later = epoch + second;
    test.is(later.unix_duration()::Span::seconds, 1.rat());
    test.is((later - epoch)::Span::seconds, 1.rat());
    test.is((later - second).order(epoch), Order.equal);
    test.ok(epoch < later);
}

test "monotonic readings never mix domains" {
    let tick = Duration(milliseconds: 5);
    let start = MonotonicInstant(origin: Duration(seconds: 10));
    test.is(start.domain(), "explicit");
    test.is((start + tick - start)::Span::seconds, 1.rat() / 200.rat());
    let other = MonotonicInstant(origin: Duration(seconds: 10), domain: "elsewhere");
    test.is(
        try {
            (start - other)::Span::seconds.string();
        }
        catch error is IncompatibleClock {
            "incompatible";
        },
        "incompatible"
    );
    let clock = SystemClock();
    let before = clock.monotonic_instant();
    test.ok(clock.monotonic_instant() >= before);
    test.ok(clock.instant().unix_duration()::Span::seconds > 1700000000.rat());
}

test "an instant writes itself in RFC 3339 UTC" {
    test.is(Instant(origin: Duration(seconds: 0)).string(), "1970-01-01T00:00:00Z");
    test.is(Instant(origin: Duration(seconds: -1)).string(), "1969-12-31T23:59:59Z");
    test.is(Instant(origin: Duration(milliseconds: 1786451445125)).string(), "2026-08-11T12:30:45.125Z");
}
