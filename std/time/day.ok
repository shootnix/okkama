module time/day v1.0.0;

import "compare" take Comparing, Order;

// Immutable civil time within one nominal day.
//
//     let noon = TimeOfDay(
//         hour: 12,
//         minute: 0,
//         second: 0,
//         nanosecond: 0,
//     );
//     noon.order(TimeOfDay(
//         hour: 12,
//         minute: 0,
//         second: 0,
//         nanosecond: 1,
//     )); // Order.less
//
// TimeOfDay carries no date, offset or time zone. Seconds are 0..59: leap
// seconds are timeline events and are deliberately not encoded as civil field
// values. Nanoseconds are integral and never rounded.

object TimeOfDay does Comparing<TimeOfDay> {
    has hour_value is int;
    has minute_value is int;
    has second_value is int;
    has nanosecond_value is int;

    TimeOfDay(hour is int, minute is int, second is int, nanosecond is int) {
        confirm hour >= 0 && hour <= 23
            else throw InvalidTimeOfDay.because("hour must be within 0..23");
        confirm minute >= 0 && minute <= 59
            else throw InvalidTimeOfDay.because("minute must be within 0..59");
        confirm second >= 0 && second <= 59
            else throw InvalidTimeOfDay.because("second must be within 0..59");
        confirm nanosecond >= 0 && nanosecond <= 999999999
            else throw InvalidTimeOfDay.because("nanosecond must be within 0..999999999");

        hour_value = hour;
        minute_value = minute;
        second_value = second;
        nanosecond_value = nanosecond;
    }

    // The parts of the time, already checked by the constructor.
    cap Clock {
        hour is int {
            hour_value;
        }

        minute is int {
            minute_value;
        }

        second is int {
            second_value;
        }

        nanosecond is int {
            nanosecond_value;
        }
    }

    order(other is TimeOfDay) is Order {
        if hour_value != other::Clock::hour {
            hour_value.order(other::Clock::hour);
        }
        else {
            if minute_value != other::Clock::minute {
                minute_value.order(other::Clock::minute);
            }
            else {
                if second_value != other::Clock::second {
                    second_value.order(other::Clock::second);
                }
                else {
                    nanosecond_value.order(other::Clock::nanosecond);
                }
            }
        }
    }
}

enum InvalidTimeOfDay is Error = (because(message is string));

test "times of day are checked and ordered" {
    let noon = TimeOfDay(hour: 12, minute: 0, second: 0, nanosecond: 0);
    test.is(noon::Clock::hour, 12);
    test.is(noon.order(TimeOfDay(hour: 12, minute: 0, second: 0, nanosecond: 1)), Order.less);
    test.is(TimeOfDay(hour: 23, minute: 59, second: 59, nanosecond: 999999999)::Clock::nanosecond, 999999999);
    for [[24, 0, 0, 0], [0, 60, 0, 0], [0, 0, 60, 0], [0, 0, 0, 1000000000], [-1, 0, 0, 0]] -> parts {
        test.is(
            try {
                TimeOfDay(hour: parts[0], minute: parts[1], second: parts[2], nanosecond: parts[3])::Clock::hour;
            }
            catch error is InvalidTimeOfDay {
                -1;
            },
            -1
        );
    }
}
