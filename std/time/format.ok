module time/format v1.0.0;

import "compare" take Order;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "time/local_datetime" take LocalDateTime;
import "runtime/time_format" take time_pattern_invalid_offset, time_format_date, time_format_local,
    time_parse_invalid_offset, time_parse_parts;

// Explicit, locale-free formatting and parsing.
//
//     FormattedDate(
//         origin: Date(year: 2026, month: 8, day: 11),
//         pattern: "%d/%m/%Y",
//     ).string(); // "11/08/2026"
//
//     FormattedDate(text: "11/08/2026", pattern: "%d/%m/%Y").date();
//
// Directives are `%Y`, `%m`, `%d`, `%H`, `%M`, `%S`, `%f` and `%%`.
// Numeric fields have fixed widths 4/2/2/2/2/2/9. Date patterns reject time
// directives. Parsing requires every date field, and local-date-time parsing
// additionally requires hour, minute and second; nanoseconds default to zero.
// Every other character is a literal Unicode scalar. Month/day names and all
// locale-dependent directives are deliberately absent until an explicit
// locale value exists.

object FormattedDate {
    has origin is Date;
    has pattern is string;

    FormattedDate(origin is Date, pattern is string) {
        self.origin = origin;
        self.pattern = pattern;
    }

    // Reads `text` written in `pattern`.
    FormattedDate(text is string, pattern is string) {
        let pattern_offset is int = time_pattern_invalid_offset(
            pattern,
            false,
            true,
        );
        confirm pattern_offset == -1
            else throw InvalidTimePattern.located(pattern, pattern_offset);
        let source_offset is int = time_parse_invalid_offset(
            text,
            pattern,
            false,
        );
        confirm source_offset == -1
            else throw InvalidFormattedDate.located(text, source_offset);
        let parts is @int = time_parse_parts(text, pattern, false);
        origin = Date(year: parts[0], month: parts[1], day: parts[2]);
        self.pattern = pattern;
    }

    date() is Date {
        origin;
    }

    string() is string {
        let invalid is int = time_pattern_invalid_offset(pattern, false, false);
        confirm invalid == -1 else throw InvalidTimePattern.located(pattern, invalid);
        time_format_date(
            origin.year(),
            origin.month(),
            origin.day(),
            pattern,
        );
    }
}

object FormattedLocalDateTime {
    has origin is LocalDateTime;
    has pattern is string;

    FormattedLocalDateTime(origin is LocalDateTime, pattern is string) {
        self.origin = origin;
        self.pattern = pattern;
    }

    // Reads `text` written in `pattern`.
    FormattedLocalDateTime(text is string, pattern is string) {
        let pattern_offset is int = time_pattern_invalid_offset(
            pattern,
            true,
            true,
        );
        confirm pattern_offset == -1
            else throw InvalidTimePattern.located(pattern, pattern_offset);
        let source_offset is int = time_parse_invalid_offset(
            text,
            pattern,
            true,
        );
        confirm source_offset == -1
            else throw InvalidFormattedLocalDateTime.located(text, source_offset);
        let parts is @int = time_parse_parts(text, pattern, true);
        origin = LocalDateTime(
            date: Date(year: parts[0], month: parts[1], day: parts[2]),
            time: TimeOfDay(
                hour: parts[3],
                minute: parts[4],
                second: parts[5],
                nanosecond: parts[6],
            ),
        );
        self.pattern = pattern;
    }

    local_date_time() is LocalDateTime {
        origin;
    }

    string() is string {
        let invalid is int = time_pattern_invalid_offset(pattern, true, false);
        confirm invalid == -1 else throw InvalidTimePattern.located(pattern, invalid);
        let date is Date = origin.date();
        let time is TimeOfDay = origin.time();
        time_format_local(
            date.year(),
            date.month(),
            date.day(),
            time.hour(),
            time.minute(),
            time.second(),
            time.nanosecond(),
            pattern,
        );
    }
}

enum InvalidTimePattern is Error = (located(pattern is string, offset is int));

enum InvalidFormattedDate is Error = (located(origin is string, offset is int));

enum InvalidFormattedLocalDateTime is Error = (located(origin is string, offset is int));

test "patterns format and read dates and local date-times" {
    let date = Date(year: 2026, month: 8, day: 11);
    test.is(FormattedDate(origin: date, pattern: "%d/%m/%Y").string(), "11/08/2026");
    let read = FormattedDate(text: "11/08/2026", pattern: "%d/%m/%Y");
    test.is(read.date().order(date), Order.equal);
    test.is(read.string(), "11/08/2026");
    let local = FormattedLocalDateTime(text: "2026-08-11 12:30:45", pattern: "%Y-%m-%d %H:%M:%S").local_date_time();
    test.is(FormattedLocalDateTime(origin: local, pattern: "%H.%M").string(), "12.30");
    test.ok(try {
        FormattedDate(text: "11-08-2026", pattern: "%d/%m/%Y").date();
        false;
    }
    catch e is InvalidFormattedDate {
        true;
    });
}
