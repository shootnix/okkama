module crypto/nonce v1.0.0;

// Entropy is the explicit randomness capability of crypto/*: keys, salts,
// nonces and randomized signatures draw from the Entropy they are given and
// never from ambient state. SystemEntropy is the host CSPRNG (getrandom).
// Entropy.fake() is a deterministic test source, never secure.
//
//     let entropy = SystemEntropy();
//     let nonce = RandomNonce(entropy, 12).bytes();
//
// RandomNonce draws `size` fresh bytes on every bytes() call (1..1024).
// CounterNonce is the deterministic AEAD nonce prefix || big-endian counter,
// exactly `size` bytes; the counter must fit the remaining width. The caller
// owns counter uniqueness per key: a repeated (key, nonce) pair breaks AEAD.

import "crypto/error" take HostOperation, DecimalArgument, InvalidCryptoInput;

// Where crypto draws randomness; pass one in, so tests can use Entropy.fake().
role Entropy {
    // size random bytes.
    bytes(size is int) is @byte;

    fake {
        has origin is int = 0;

        bytes(size is int) is @byte {
            (0..size).map() -> index {
                ((index * 167 + 13) % 256).byte();
            };
        }
    }
}

// The operating system's cryptographic random source.
object SystemEntropy does Entropy {
    // The system source.
    SystemEntropy();

    // size random bytes.
    bytes(size is int) is @byte {
        confirm size >= 0 && size <= 16777216
            else throw InvalidCryptoInput.because("entropy size must be 0..16777216");
        if size == 0 {
            [];
        }
        else {
            HostOperation(operation: "random", arguments: [DecimalArgument(size).bytes()]).bytes();
        }
    }
}

// A fresh random nonce on every bytes() call.
object RandomNonce {
    has entropy is Entropy;
    has size is int;

    // Nonces of size bytes (1 to 1024) from entropy.
    RandomNonce(entropy is Entropy, size is int) {
        confirm size >= 1 && size <= 1024
            else throw InvalidCryptoInput.because("nonce size must be 1..1024");
        self.entropy = entropy;
        self.size = size;
    }

    // A new nonce.
    bytes() is @byte {
        entropy.bytes(size);
    }
}

// A nonce made of a prefix and a big-endian counter.
object CounterNonce {
    has prefix is @byte;
    has counter is int;
    has size is int;

    // prefix then counter, size bytes in all; the counter must fit.
    CounterNonce(prefix is @byte, counter is int, size is int) {
        confirm size >= 1 && size <= 1024 && prefix.size() < size
            else throw InvalidCryptoInput.because("nonce prefix must be shorter than the nonce");
        // A counter field of eight bytes or more holds any non-negative int.
        let width = size - prefix.size();
        confirm counter >= 0 && (width >= 8 || counter < (1 << (8 * width)))
            else throw InvalidCryptoInput.because("nonce counter does not fit");
        self.prefix = prefix;
        self.counter = counter;
        self.size = size;
    }

    // The nonce.
    bytes() is @byte {
        let start = prefix.size();
        (0..size).map() -> index {
            if index < start {
                prefix[index];
            }
            else {
                let shift = 8 * (size - 1 - index);
                if shift >= 64 {
                    0.byte();
                }
                else {
                    ((counter >> shift) & 255).byte();
                }
            }
        };
    }
}

test "system entropy is fresh and sized" {
    let entropy = SystemEntropy();
    test.is(entropy.bytes(32).size(), 32);
    test.ok(entropy.bytes(32) != entropy.bytes(32));
    test.is(entropy.bytes(0).size(), 0);
    test.throws(InvalidCryptoInput) {
        entropy.bytes(-1);
    };
}

test "counter nonces are prefix and big-endian counter" {
    test.is(CounterNonce(prefix: [1.byte()], counter: 258, size: 4).bytes(), [1.byte(), 0.byte(), 1.byte(), 2.byte()]);
    test.throws(InvalidCryptoInput) {
        CounterNonce(prefix: [1.byte()], counter: 256, size: 2);
    };
    // The usual AEAD shape: a 4-byte prefix and an 8-byte counter in 12 bytes.
    let twelve = CounterNonce(prefix: [9.byte(), 9.byte(), 9.byte(), 9.byte()], counter: 1, size: 12).bytes();
    test.is(twelve.size(), 12);
    test.is(twelve.slice(4, 12), [0.byte(), 0.byte(), 0.byte(), 0.byte(), 0.byte(), 0.byte(), 0.byte(), 1.byte()]);
    let wide = CounterNonce(prefix: [], counter: 258, size: 24).bytes();
    test.is(wide.slice(0, 22), (0..22).map() -> index { 0.byte(); });
    test.is(wide.slice(22, 24), [1.byte(), 2.byte()]);
    test.throws(InvalidCryptoInput) {
        CounterNonce(prefix: [], counter: -1, size: 12);
    };
    test.is(RandomNonce(entropy: Entropy.fake(), size: 12).bytes().size(), 12);
}
