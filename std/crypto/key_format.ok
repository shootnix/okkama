    test.ok(try { ParsedPrivateKey("-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAigREzzduCyebc+NFzycZPZorxURCPJ/PUBcIYWCzXO4=\n-----END PUBLIC KEY-----\n").pkcs8(); false; } catch e is InvalidCryptoInput { true; });
