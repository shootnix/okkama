    test.ok(ParsedPublicKey("-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEApXK3hfNeafhb+Q2vhlh1\nMNhgBscPEto29NJQFaQaXVOlSEvMvOO1Lap8VeIipc9bTKngjR5qPUNBG/PR2fCe\nVgagNaxDIKYlqwEinVvKs0CcbAfYWRJ+XT2RYBmQzwiEl2Jq8+fyZpDxXUWJJsr+\nq05pFoZoGOew7oZlEgzYITu98bvLZ210+8OR0li1JoX6tPNQ0MKv1l9IBPBfSMqC\nkBXRX5DWiTvGuNWLytkpql8peqRgHJ8mc3QGm8+Uj3yCELrK8xMjarYfZ2i4/PDX\nvQI7N/YvajQQ4JPWWixil50T+aVrOeIMts+3Qd4hI71Nd9qmEu94zyl9umnr5Zu+\niwIDAQAB\n-----END PUBLIC KEY-----\n").algorithm() == KeyAlgorithm.rsa);
    test.ok(ParsedPrivateKey("-----BEGIN PRIVATE KEY-----\nMIIEvwIBADANBgkqhkiG9w0BAQEFAASCBKkwggSlAgEAAoIBAQClcreF815p+Fv5\nDa+GWHUw2GAGxw8S2jb00lAVpBpdU6VIS8y847UtqnxV4iKlz1tMqeCNHmo9Q0Eb\n89HZ8J5WBqA1rEMgpiWrASKdW8qzQJxsB9hZEn5dPZFgGZDPCISXYmrz5/JmkPFd\nRYkmyv6rTmkWhmgY57DuhmUSDNghO73xu8tnbXT7w5HSWLUmhfq081DQwq/WX0gE\n8F9IyoKQFdFfkNaJO8a41YvK2SmqXyl6pGAcnyZzdAabz5SPfIIQusrzEyNqth9n\naLj88Ne9Ajs39i9qNBDgk9ZaLGKXnRP5pWs54gy2z7dB3iEjvU132qYS73jPKX26\naevlm76LAgMBAAECggEANWWeXKGMvbfV+z4TAdGH1SFocJeLQmLiLMa56RojFi7a\nX8hzBh2ZymjFIzTOSORxC3+iRPllgWs01tAs0OGLQKl3yIrVyXJGIvhFUzMeaxb1\nxRoNFcZVuUMXKcRmi6Mso+00Jo8cGUU7WQaJutb2NZSjbw0nCK6yWHFQqnAxyxuH\nW/fA3ztmL8Tc57/vGo6/EgITSMmITK4nQfJKLTp3GQCDu6Ui6aKkmBFGQnOtxTIs\nk/avfW1cSB+Ecr20ilDHM8SrUW7eLz/aqHkoRGObaNtNZzir3cEGSb4A4ny+8WQ/\nBsck46qE4/qv1r3kI0xUJ2EPtBvhUnKWgy3ttgnlBQKBgQDa5RzTliKjRddRtwPm\n4tG9DkfrbDeGNINi8zJdK1umgcerS2ZV1Z67BMiWj4+omQnOM5W/jeDbrdjXR1jt\nZ5OdhF+0sGpWpqaF6+uuaKzXvePujVYGFkluEJoNO1zdAI70kimdN1pEUHlBneZN\n4uGlPLZBbKnQGGeAp3hfOCRFZQKBgQDBfkrgkUskEhNiRcqF2GY1z6lBnhJ4ByUT\nytdhjFUkebzUTUUznQELmQ/px32qhcXGAGbZAV/JvxEeAdbjSL3j2IEgSuxv3E8k\naqlGhP4yi7yCQ9tWukfE8KmvdKmuoVWim7Z17nJBtCXkSdhbwzpGMWJopDg4JP0H\nPMdiKNttLwKBgQCqGpvhLW3zdcXTIactmJwnD98B61HmwA5OKfG8h4IsjfQNgIWh\nNGWqrhf3MM8R1QPSszGu72GLNbkp6q8HppMHOKRrNSEd/1mu/txi58NR0KY9bqYo\nCs+7cblViQksUU/GbYNbQnWqWuMwA7XCVwrFLr3vb7MzHJPqXbpkPKurJQKBgQCv\ns7XcnDMGax+M8mEID0wo+wvwGNEeiyZhBaV04BCEkcMlaZE4YA6N8IyhtdPoH5dK\nyBycW4IW2dh6TiNKukgsePIwV7jBjuWS5QQXlDabwYYJKAMpivgW3o7HU4GtoLT5\ndrpF9qNsBGEQHvpHwUzOZpO8/7pJSVU22DsZaI5wYwKBgQCfYLTKcp2YRE1SFUHl\nqjpYHyDgCaoggLHwq0JSRZfiWdE8eN3Ipqw2bep/qO7IkL7mr8S1+x8HMblcXAqI\nxR+4pCvSTiD9/KEGLiNmWc4TishmuTd0yfXFhhjHVGoZ7PVBIjPCSUpfCdzeeaml\naCVhjunRYNIoO7jzgo/muY2kzA==\n-----END PRIVATE KEY-----\n").algorithm() == KeyAlgorithm.rsa);
