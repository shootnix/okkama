module crypto/kdf v1.0.0;

import "crypto/secret" take SecretBytes;
import "crypto/error" take HostOperation, DecimalArgument, InvalidCryptoInput;
import "encoding/hex" take HexEncoded;

// Key derivation. HkdfSecret is HKDF (RFC 5869) extract-and-expand from input
// keying material: salt and info are public context, the output length is
// 1..255 hash lengths. Pbkdf2Secret is PBKDF2-HMAC (RFC 8018) for password
// stretching; prefer crypto/password (Argon2id) for stored passwords. Both
// derive only when secret() is observed and return fresh SecretBytes; inputs
// are exported from their SecretBytes at that moment.
//
//     let key = HkdfSecret(KdfHash.sha256, shared, salt, info, 32).secret();
enum KdfHash = (sha256, sha384, sha512);

object KdfHashName {
    has hash is KdfHash;
    KdfHashName(hash is KdfHash) { self.hash = hash; }
    string() is string {
        match hash {
            case KdfHash.sha256 { "sha256"; }
            case KdfHash.sha384 { "sha384"; }
            case KdfHash.sha512 { "sha512"; }
        }
    }
}

object HkdfSecret {
    has hash is KdfHash;
    has input is SecretBytes;
    has salt is @byte;
    has info is @byte;
    has length is int;
    HkdfSecret(hash is KdfHash, input is SecretBytes, salt is @byte, info is @byte, length is int) {
        confirm length >= 1 else throw InvalidCryptoInput("HKDF output length must be positive");
        self.hash = hash;
        self.input = input;
        self.salt = salt;
        self.info = info;
        self.length = length;
    }
    secret() is SecretBytes {
        SecretBytes(HostOperation("hkdf-" + KdfHashName(hash).string(),
            [input.export_bytes(), salt, info, DecimalArgument(length).bytes()]).bytes());
    }
}

object Pbkdf2Secret {
    has hash is KdfHash;
    has password is SecretBytes;
    has salt is @byte;
    has iterations is int;
    has length is int;
    Pbkdf2Secret(hash is KdfHash, password is SecretBytes, salt is @byte, iterations is int, length is int) {
        confirm iterations >= 1 && iterations <= 4294967295 else throw InvalidCryptoInput("PBKDF2 iterations must be 1..4294967295");
        confirm length >= 1 && length <= 65536 else throw InvalidCryptoInput("PBKDF2 output length must be 1..65536");
        self.hash = hash;
        self.password = password;
        self.salt = salt;
        self.iterations = iterations;
        self.length = length;
    }
    secret() is SecretBytes {
        SecretBytes(HostOperation("pbkdf2-" + KdfHashName(hash).string(),
            [password.export_bytes(), salt, DecimalArgument(iterations).bytes(), DecimalArgument(length).bytes()]).bytes());
    }
}

test "HKDF matches RFC 5869 test case 1" {
    let ikm = SecretBytes((0..22).map() -> i { 11.byte(); });
    let salt is @byte = (0..13).map() -> i { i.byte(); };
    let info is @byte = (0..10).map() -> i { (240 + i).byte(); };
    let okm = HkdfSecret(KdfHash.sha256, ikm, salt, info, 42).secret();
    test.is(HexEncoded(okm.export_bytes()).string(), "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865");
    test.ok(try { HkdfSecret(KdfHash.sha256, ikm, salt, info, 255 * 32 + 1).secret(); false; } catch e is InvalidCryptoInput { true; });
}

test "PBKDF2 matches RFC 7914 / known SHA-256 vectors" {
    let password = SecretBytes([112.byte(), 97.byte(), 115.byte(), 115.byte(), 119.byte(), 111.byte(), 114.byte(), 100.byte()]);
    let salt = [115.byte(), 97.byte(), 108.byte(), 116.byte()];
    test.is(HexEncoded(Pbkdf2Secret(KdfHash.sha256, password, salt, 1, 32).secret().export_bytes()).string(), "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b");
    test.is(HexEncoded(Pbkdf2Secret(KdfHash.sha256, password, salt, 2, 32).secret().export_bytes()).string(), "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43");
    test.ok(try { Pbkdf2Secret(KdfHash.sha256, password, salt, 0, 32); false; } catch e is InvalidCryptoInput { true; });
}
