module crypto/x509/certificate v1.0.0;

import "runtime/x509" as x509;
import "crypto/x509/value" take CertificateValidity, CertificateConstraints, InvalidCertificate;
import "crypto/x509/name" take DistinguishedName, RelativeDistinguishedName, NameAttribute,
    InvalidDistinguishedName;
import "crypto/key" take PublicKey;
import "time/clock" take Instant;
import "time/duration" take Duration, DurationUnit;
import "strings/parse" take Number;
import "collections/sequence" take Sequencing;
import "net/ip" take IpAddress;
import "collections/set" take Set, OrderedSet;
import "encoding/hex" take HexDecoded;

// ParsedCertificate(bytes).value() validates a bounded DER envelope and asks
// OpenSSL to decode its certificate/public key. It neither verifies a signature
// nor asks a clock, resolver, filesystem trust store, or peer hostname.
// Exact DER plus a deterministic private facts snapshot define identity;
// repeated getters acquire no persistent host pointers. Names preserve RDN
// groups and DER member order. Unsupported text encodings fail on observation.
// Limits: 1 MiB input, 8192 envelope nodes, nesting 32, 128 extensions/groups,
// 32 attributes per RDN, 4096 scalars per decoded value, 65536 per decoded name.
object ParsedCertificate {
    has origin is @byte;

    ParsedCertificate(origin is @byte) {
        self.origin = origin;
    }

    certificate() is Certificate {
        Certificate(origin);
    }
}

object Certificate {
    has origin is @byte;
    has facts is string;

    Certificate(origin is @byte) {
        try {
            facts = x509.certificate_facts(origin);
        }
        catch e is NativeFailure {
            if e.domain() == "core.x509" {
                if e.code() == "resource_exhausted" {
                    throw CertificateLimitExceeded.exceeded;
                }
                if e.code() == "unsupported" {
                    throw CertificateBackendUnavailable.unavailable;
                }
                if e.code() == "invalid_data" {
                    throw InvalidCertificate.because("invalid DER certificate");
                }
            }
            throw;
        }
        self.origin = origin;
    }

    der() is @byte {
        origin;
    }

    subject() is DistinguishedName {
        CertificateName(facts: facts, issuer: false).name();
    }

    issuer() is DistinguishedName {
        CertificateName(facts: facts, issuer: true).name();
    }

    validity() is CertificateValidity {
        let times = x509.certificate_times(facts);
        CertificateValidity(
            starts: Instant(Duration(value: Number(times[0]).int().rat(), unit: DurationUnit.second)),
            ends: Instant(Duration(value: Number(times[1]).int().rat(), unit: DurationUnit.second))
        );
    }

    public_key() is PublicKey {
        CertificatePublicKey(x509.certificate_spki(facts));
    }

    names() is CertificateNames {
        try {
            let entries = x509.certificate_san(facts);
            let dns_entries = entries.filter() -> entry {
                entry[0] == "DNS";
            };
            let ip_entries = entries.filter() -> entry {
                entry[0] == "IP";
            };
            let dns_values is @string = dns_entries.map() -> entry {
                entry[1];
            };
            let ip_values is @IpAddress = ip_entries.map() -> entry {
                IpAddress(entry[1]);
            };
            CertificateNames(dns: dns_values, ips: ip_values);
        }
        catch e is NativeFailure {
            if e.domain() == "core.x509" {
                if e.code() == "resource_exhausted" {
                    throw CertificateLimitExceeded.exceeded;
                }
                if e.code() == "invalid_data" {
                    throw InvalidCertificate.because("invalid subjectAltName");
                }
            }
            throw;
        }
    }

    extensions_items() is Sequencing<CertificateExtension> {
        let records = x509.certificate_extensions(facts);
        let values is @CertificateExtension = records.map() -> record {
            CertificateExtension(identifier: record[0], critical: record[1] == "1", origin: HexDecoded(record[2]).bytes());
        };
        values;
    }

    extensions_extension(identifier is string) is CertificateExtension {
        let wanted = CertificateObjectIdentifier(identifier).identifier();
        let records = x509.certificate_extensions(facts);
        for records -> record {
            if record[0] == wanted {
                return CertificateExtension(
                    identifier: record[0],
                    critical: record[1] == "1",
                    origin: HexDecoded(record[2]).bytes()
                );
            }
        }
        throw MissingCertificateExtension.identifier(wanted);
    }

    extensions_critical() is Sequencing<string> {
        let records = x509.certificate_extensions(facts);
        let critical = records.filter() -> record {
            record[1] == "1";
        };
        let values is @string = critical.map() -> record {
            record[0];
        };
        values;
    }

    extensions_constraints() is CertificateConstraints {
        try {
            let value = x509.certificate_constraints(facts);
            let authority = value[0] == "1";
            if value[1] == "" {
                CertificateConstraints(authority);
            }
            else {
                CertificateConstraints(authority: authority, maximum_depth: Number(value[1]).int());
            }
        }
        catch e is NativeFailure {
            if e.domain() == "core.x509" {
                if e.code() == "resource_exhausted" {
                    throw CertificateLimitExceeded.exceeded;
                }
                if e.code() == "invalid_data" {
                    throw InvalidCertificate.because("invalid basicConstraints");
                }
            }
            throw;
        }
    }

    extensions_key_usages() is Set<CertificateKeyUsage> {
        try {
            let all is @CertificateKeyUsage = [
                CertificateKeyUsage.digital_signature,
                CertificateKeyUsage.content_commitment,
                CertificateKeyUsage.key_encipherment,
                CertificateKeyUsage.data_encipherment,
                CertificateKeyUsage.key_agreement,
                CertificateKeyUsage.key_cert_sign,
                CertificateKeyUsage.crl_sign,
                CertificateKeyUsage.encipher_only,
                CertificateKeyUsage.decipher_only
            ];
            let bits = x509.certificate_key_usages(facts);
            let values is @CertificateKeyUsage = bits.map() -> bit {
                all[bit];
            };
            OrderedSet(values);
        }
        catch e is NativeFailure {
            if e.domain() == "core.x509" {
                if e.code() == "resource_exhausted" {
                    throw CertificateLimitExceeded.exceeded;
                }
                if e.code() == "invalid_data" {
                    throw InvalidCertificate.because("invalid keyUsage");
                }
            }
            throw;
        }
    }

    extensions_purposes() is Set<CertificatePurpose> {
        try {
            let identifiers = x509.certificate_purposes(facts);
            let values is @CertificatePurpose = identifiers.map() -> identifier {
                CertificatePurpose(identifier);
            };
            OrderedSet(values);
        }
        catch e is NativeFailure {
            if e.domain() == "core.x509" {
                if e.code() == "resource_exhausted" {
                    throw CertificateLimitExceeded.exceeded;
                }
                if e.code() == "invalid_data" {
                    throw InvalidCertificate.because("invalid extendedKeyUsage");
                }
            }
            throw;
        }
    }
}

hidden object CertificateName {
    has facts is string;
    has issuer is bool;

    CertificateName(facts is string, issuer is bool) {
        self.facts = facts;
        self.issuer = issuer;
    }

    name() is DistinguishedName {
        try {
            let groups = x509.certificate_names(facts, issuer);
            let result is @RelativeDistinguishedName = groups.map() -> group {
                let attributes is @NameAttribute = group.map() -> attribute {
                    NameAttribute(identifier: attribute[0], value: attribute[1]);
                };
                RelativeDistinguishedName(attributes);
            };
            DistinguishedName(result);
        }
        catch e is NativeFailure {
            if e.domain() == "core.x509" {
                if e.code() == "unsupported" {
                    throw UnsupportedCertificateName.unsupported;
                }
                if e.code() == "resource_exhausted" {
                    throw CertificateLimitExceeded.exceeded;
                }
                if e.code() == "invalid_data" {
                    throw InvalidCertificate.because("invalid encoded certificate name");
                }
            }
            throw;
        }
    }
}

hidden object CertificatePublicKey does PublicKey {
    has origin is @byte;

    CertificatePublicKey(origin is @byte) {
        self.origin = origin;
    }

    bytes() is @byte {
        origin;
    }
}

// Metadata projection only: no matching, CN fallback, IDNA transformation,
// resolution or trust assertion. DNS spelling and repetitions are retained;
// IP GeneralNames become nominal addresses and never enter the DNS sequence.
object CertificateNames {
    has dns is @string;
    has ips is @IpAddress;

    CertificateNames(origin is Certificate) {
        let snapshot = origin.names();
        let names is @string = snapshot.dns().map() -> value {
            value;
        };
        dns = names;
        let addresses is @IpAddress = snapshot.ips().map() -> value {
            value;
        };
        ips = addresses;
    }

    CertificateNames(dns is @string, ips is @IpAddress) {
        self.dns = dns;
        self.ips = ips;
    }

    dns() is Sequencing<string> {
        dns;
    }

    ips() is Sequencing<IpAddress> {
        ips;
    }
}

// Snapshot of supplied, untrusted leaf-first certificates. It is not a verified
// prospective path: repetitions/order are retained for the verifier to handle.
object CertificateChain {
    has origin is @Certificate;

    CertificateChain(certificates is Sequencing<Certificate>) {
        let count = certificates.size();
        confirm count > 0
            else throw InvalidCertificate.because("empty or invalid certificate chain size");
        confirm count <= 32 else throw CertificateLimitExceeded.exceeded;
        let values is @Certificate = (0..count).map() -> index {
            certificates.item(index);
        };
        let bytes = values.reduce(0) -> sum, certificate {
            sum + certificate.der().size();
        };
        confirm bytes <= 8388608 else throw CertificateLimitExceeded.exceeded;
        origin = values;
    }

    certificates() is Sequencing<Certificate> {
        origin;
    }
}

enum CertificateKeyUsage = (digital_signature, content_commitment, key_encipherment, data_encipherment, key_agreement, key_cert_sign, crl_sign, encipher_only, decipher_only);

// Purposes retain exact EKU OIDs, including unknown purposes. Construction is
// metadata validation, never permission to bypass verification policy.
object CertificatePurpose {
    has identifier is string;

    CertificatePurpose(identifier is string) {
        self.identifier = CertificateObjectIdentifier(identifier).identifier();
    }

    identifier() is string {
        identifier;
    }
}

object CertificateExtension {
    has identifier is string;
    has critical is bool;
    has origin is @byte;

    CertificateExtension(identifier is string, critical is bool, origin is @byte) {
        self.identifier = CertificateObjectIdentifier(identifier).identifier();
        self.critical = critical;
        self.origin = origin;
    }

    identifier() is string {
        identifier;
    }

    critical() is bool {
        critical;
    }

    bytes() is @byte {
        origin;
    }
}

object CertificateExtensions {
    has owner is Certificate;

    CertificateExtensions(origin is Certificate) {
        owner = origin;
    }

    items() is Sequencing<CertificateExtension> {
        owner.extensions_items();
    }

    extension(identifier is string) is CertificateExtension {
        owner.extensions_extension(identifier);
    }

    critical() is Sequencing<string> {
        owner.extensions_critical();
    }

    constraints() is CertificateConstraints {
        owner.extensions_constraints();
    }

    key_usages() is Set<CertificateKeyUsage> {
        owner.extensions_key_usages();
    }

    purposes() is Set<CertificatePurpose> {
        owner.extensions_purposes();
    }
}

hidden object CertificateObjectIdentifier {
    has origin is string;

    CertificateObjectIdentifier(origin is string) {
        self.origin = origin;
    }

    identifier() is string {
        try {
            NameAttribute(identifier: origin, value: "").identifier();
        }
        catch e is InvalidDistinguishedName {
            throw InvalidCertificate.because("invalid certificate object identifier");
        }
    }
}

enum MissingCertificateExtension is Error = (identifier(identifier is string));

test "unknown purpose OIDs remain exact metadata" {
    test.is(CertificatePurpose("1.2.3.4").identifier(), "1.2.3.4");
    test.ok(try {
        CertificatePurpose("1.40");
        false;
    }
    catch e is InvalidCertificate {
        true;
    });
}

enum CertificateLimitExceeded is Error = (exceeded);

enum CertificateBackendUnavailable is Error = (unavailable);

enum UnsupportedCertificateName is Error = (unsupported);

test "empty DER is rejected before certificate publication" {
    test.ok(try {
        ParsedCertificate([]).certificate();
        false;
    }
    catch e is InvalidCertificate {
        true;
    });
}

test "empty supplied chain cannot denote a peer chain" {
    test.ok(try {
        CertificateChain([]);
        false;
    }
    catch e is InvalidCertificate {
        true;
    });
}
