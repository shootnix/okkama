module crypto/error v1.0.0;

// The failures of digest and crypto modules.
//
//     try { cipher.opened(nonce, aad, sealed); }
//     catch failure is AuthenticationFailed { … }               // tampered or wrong key
//
// - InvalidCryptoInput: a key, nonce or other input of the wrong size or form.
// - AuthenticationFailed: sealed data or its associated data was changed.
// - CryptoUnavailable: the engine has no provider for the operation.
//
// HostOperation and DecimalArgument are the boundary to the runtime's provider;
// programs do not need them.

import "runtime/host_crypto" as host;
import "encoding/utf" take Utf8Encoded;

// An input of the wrong size or form; reason says which.
enum InvalidCryptoInput is Error = (because(reason is string));

// The data or associated data was changed, or the key is wrong.
enum AuthenticationFailed is Error = (failed);

// The engine cannot do this; reason says why.
enum CryptoUnavailable is Error = (because(reason is string));

// Internal: one host operation over byte arguments; integers are decimal ASCII.
object HostOperation {
    has operation is string;
    has arguments is @@byte;

    // A provider call and its arguments.
    HostOperation(operation is string, arguments is @@byte) {
        self.operation = operation;
        self.arguments = arguments;
    }

    // The call's result.
    bytes() is @byte {
        try {
            host.crypto(operation, arguments);
        }
        catch failure is NativeFailure {
            if failure.code() == "invalid_input" {
                throw InvalidCryptoInput.because(failure.message());
            }
            if failure.code() == "permission_denied" {
                throw AuthenticationFailed.failed;
            }
            throw CryptoUnavailable.because(failure.message());
        }
    }

    // Host predicates answer [1] or [0].
    truth() is bool {
        self.bytes() == [1.byte()];
    }
}

// Internal: decimal ASCII form of a host integer argument.
object DecimalArgument {
    has value is int;

    // An int as a provider argument.
    DecimalArgument(value is int) {
        self.value = value;
    }

    // Its decimal digits as bytes.
    bytes() is @byte {
        Utf8Encoded(value.string()).bytes();
    }
}

test "host failures become typed errors" {
    test.ok(try {
        HostOperation(operation: "aead-open:aes-256-gcm", arguments: [[1.byte()], [], [], []]).bytes();
        false;
    }
    catch InvalidCryptoInput.because(reason) {
        reason == "aes-256-gcm key must be 32 bytes";
    });
    test.throws(CryptoUnavailable) {
        HostOperation(operation: "no-such-operation", arguments: []).bytes();
    };
    test.is(DecimalArgument(42).bytes(), [52.byte(), 50.byte()]);
}
