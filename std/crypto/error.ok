module crypto/error v1.0.0;

import "runtime/host_crypto" as host;
import "encoding/utf" take Utf8Encoded;

// Typed failures of digest/* and crypto/*, and the internal host boundary.
//
// Host cryptography comes from reviewed providers in okkama-native, RustCrypto
// and aws-lc (RSA); std composes them and never reimplements primitives.
// HostOperation is the only caller of runtime/host_crypto.crypto:
// invalid_input becomes InvalidCryptoInput (wrong key/nonce length,
// parameters, encodings), permission_denied becomes AuthenticationFailed
// (AEAD tag, RSA-OAEP padding, non-contributory X25519 key) and any other
// host failure CryptoUnavailable. Messages never contain key or plaintext
// bytes.
enum InvalidCryptoInput is Error = (because(reason is string));

enum AuthenticationFailed is Error = (failed);

enum CryptoUnavailable is Error = (because(reason is string));

// Internal: one host operation over byte arguments; integers are decimal ASCII.
object HostOperation {
    has operation is string;
    has arguments is @@byte;

    HostOperation(operation is string, arguments is @@byte) {
        self.operation = operation;
        self.arguments = arguments;
    }

    bytes() is @byte {
        try {
            host.crypto(operation, arguments);
        } catch failure is NativeFailure {
            if failure.code() == "invalid_input" { throw InvalidCryptoInput.because(failure.message()); }
            if failure.code() == "permission_denied" { throw AuthenticationFailed.failed; }
            throw CryptoUnavailable.because(failure.message());
        }
    }

    // Host predicates answer [1] or [0].
    truth() is bool { self.bytes() == [1.byte()]; }
}

// Internal: decimal ASCII form of a host integer argument.
object DecimalArgument {
    has value is int;
    DecimalArgument(value is int) { self.value = value; }
    bytes() is @byte { Utf8Encoded(value.string()).bytes(); }
}

test "host failures become typed errors" {
    test.ok(try { HostOperation("aead-open:aes-256-gcm", [[1.byte()], [], [], []]).bytes(); false; }
        catch InvalidCryptoInput.because(reason) { reason == "aes-256-gcm key must be 32 bytes"; });
    test.ok(try { HostOperation("no-such-operation", []).bytes(); false; } catch e is CryptoUnavailable { true; });
    test.is(DecimalArgument(42).bytes(), [52.byte(), 50.byte()]);
}
