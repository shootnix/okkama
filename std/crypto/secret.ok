module crypto/secret v1.0.0;

import "runtime/secret" as native_secret;
import "io/stream" take Closing;
import "encoding/utf" take Utf8Encoded;
import "crypto/constant_time" take ConstantTimeEqual;

// Opaque owned memory capability. Ordinary field traversal/equality cannot see
// bytes; export is explicit. Native overwrite cannot erase copies held by a
// garbage-collected host or by a caller who explicitly exported the payload.
object SecretBytes does Closing {
    has state is native_secret.SecretState;

    SecretBytes(origin is @byte) {
        confirm origin.size() <= 1048576 else throw SecretLimit.exceeded;
        state = native_secret.create(origin);
    }

    // A secret written as text, kept as its UTF-8 bytes: SecretBytes("shared key").
    SecretBytes(text is string) {
        let bytes = Utf8Encoded(text).bytes();
        confirm bytes.size() <= 1048576 else throw SecretLimit.exceeded;
        state = native_secret.create(bytes);
    }

    size() is int {
        confirm !self.closed() else throw SecretClosed.closed;
        native_secret.size(state);
    }

    closed() is bool {
        native_secret.closed(state);
    }

    close() is void {
        native_secret.close(state);
    }

    destroy {
        native_secret.close(state);
    }

    // Constant-time equality: the running time does not depend on where the
    // bytes differ. Different lengths are unequal.
    matches(other is @byte) is bool {
        confirm !self.closed() else throw SecretClosed.closed;
        ConstantTimeEqual(left: native_secret.export(state), right: other).matches();
    }

    matches(other is SecretBytes) is bool {
        self.matches(other.export_bytes());
    }

    export_bytes() is @byte {
        confirm !self.closed() else throw SecretClosed.closed;
        native_secret.export(state);
    }
}

object ExportedSecret {
    has owner is SecretBytes;

    ExportedSecret(origin is SecretBytes) {
        confirm !origin.closed() else throw SecretClosed.closed;
        owner = origin;
    }

    bytes() is @byte {
        owner.export_bytes();
    }
}

enum SecretClosed is Error = (closed);

enum SecretLimit is Error = (exceeded);

test "secret export is explicit and close affects its aliases" {
    let secret = SecretBytes([0.byte(), 255.byte()]);
    let exported = ExportedSecret(secret);
    test.ok(secret.size() == 2 && exported.bytes().size() == 2);
    secret.close();
    test.ok(try {
        exported.bytes();
        false;
    }
    catch e is SecretClosed {
        true;
    });
}

test "a secret compares itself in constant time" {
    let stored = SecretBytes([1.byte(), 2.byte(), 3.byte()]);
    test.is(stored.matches([1.byte(), 2.byte(), 3.byte()]), true);
    test.is(stored.matches([1.byte(), 2.byte(), 4.byte()]), false);
    test.is(stored.matches([1.byte(), 2.byte()]), false);
    test.is(stored.matches(SecretBytes([1.byte(), 2.byte(), 3.byte()])), true);
    stored.close();
    test.throws(SecretClosed) {
        stored.matches([1.byte()]);
    };
}

test "a secret can be written as text" {
    let secret = SecretBytes("ké");
    test.is(secret.size(), 3);
    test.ok(secret.matches(SecretBytes([107.byte(), 195.byte(), 169.byte()])));
}
