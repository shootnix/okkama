module crypto/secret v1.0.0;
import "runtime/secret" as native_secret;
import "io/stream" take Closing;

// Opaque owned memory capability. Ordinary field traversal/equality cannot see
// bytes; export is explicit. Native overwrite cannot erase copies held by a
// garbage-collected host or by a caller who explicitly exported the payload.
object SecretBytes does Closing {
    has state is native_secret.SecretState;

    SecretBytes(origin is @byte){
        confirm origin.size()<=1048576 else throw SecretLimit();state=native_secret.create(origin);
    }
    size() is int{confirm !self.closed() else throw SecretClosed();native_secret.size(state);}
    closed() is bool{native_secret.closed(state);}close() is void{native_secret.close(state);}
    destroy{native_secret.close(state);}

    export_bytes() is @byte{confirm !self.closed() else throw SecretClosed();native_secret.export(state);}
}
object ExportedSecret {
    has owner is SecretBytes;
    ExportedSecret(origin is SecretBytes){confirm !origin.closed() else throw SecretClosed();owner=origin;}
    bytes() is @byte{owner.export_bytes();}
}
object SecretClosed does Error{SecretClosed();text() is string{"secret is closed";}}
object SecretLimit does Error{SecretLimit();text() is string{"secret payload exceeds limit";}}
test "secret export is explicit and close affects its aliases" {
    let secret=SecretBytes([0.byte(),255.byte()]);let exported=ExportedSecret(secret);
    test.ok(secret.size()==2 && exported.bytes().size()==2);secret.close();
    test.ok(try{exported.bytes();false;}catch e is SecretClosed{true;});
}
