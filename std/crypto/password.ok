module crypto/password v1.0.0;

import "crypto/secret" take SecretBytes;
import "crypto/nonce" take Entropy;
import "crypto/error" take HostOperation, DecimalArgument, InvalidCryptoInput;
import "encoding/utf" take Utf8Decoded, Utf8Encoded;

// Password storage with Argon2id (RFC 9106) in PHC string format.
//
//     let stored = PasswordHash(password, Argon2Policy(), SystemEntropy()).string();
//     PasswordCheck(stored, attempt).matches(); // constant-time verification
//
// Argon2Policy() is the OWASP baseline (19 MiB, 2 iterations, 1 lane);
// Argon2Policy(memory_kib, iterations, parallelism) is explicit: memory
// 8*parallelism..4194304 KiB, iterations 1..1000, parallelism 1..255
// (InvalidCryptoInput otherwise). PasswordHash.string() draws a fresh 16-byte
// salt from its Entropy on every observation, so two strings of one password
// differ. PasswordCheck accepts only "$argon2id$" strings; a malformed string
// is InvalidCryptoInput, a wrong password is false. outdated(policy) tells
// whether a stored hash used other parameters and should be rehashed.
object Argon2Policy {
    has memory is int;
    has iterations is int;
    has parallelism is int;
    Argon2Policy() { memory = 19456; iterations = 2; parallelism = 1; }
    Argon2Policy(memory_kib is int, iterations is int, parallelism is int) {
        confirm parallelism >= 1 && parallelism <= 255 else throw InvalidCryptoInput("Argon2 parallelism must be 1..255");
        confirm memory_kib >= 8 * parallelism && memory_kib <= 4194304 else throw InvalidCryptoInput("Argon2 memory must be 8*parallelism..4194304 KiB");
        confirm iterations >= 1 && iterations <= 1000 else throw InvalidCryptoInput("Argon2 iterations must be 1..1000");
        memory = memory_kib;
        self.iterations = iterations;
        self.parallelism = parallelism;
    }
    arguments() is @@byte {
        [DecimalArgument(memory).bytes(), DecimalArgument(iterations).bytes(), DecimalArgument(parallelism).bytes()];
    }
    parameters() is string { "m=" + memory.string() + ",t=" + iterations.string() + ",p=" + parallelism.string(); }
}

object PasswordHash {
    has password is SecretBytes;
    has policy is Argon2Policy;
    has entropy is Entropy;
    PasswordHash(password is SecretBytes, policy is Argon2Policy, entropy is Entropy) {
        self.password = password;
        self.policy = policy;
        self.entropy = entropy;
    }
    string() is string {
        let arguments = policy.arguments();
        Utf8Decoded(HostOperation("argon2-phc", [password.export_bytes(), entropy.bytes(16), arguments[0], arguments[1], arguments[2]]).bytes()).string();
    }
}

object PasswordCheck {
    has stored is string;
    has password is SecretBytes;
    PasswordCheck(stored is string, password is SecretBytes) {
        self.stored = stored;
        self.password = password;
    }
    matches() is bool {
        confirm stored.length() >= 10 && stored.slice(0, 10) == "$argon2id$" else throw InvalidCryptoInput("only $argon2id$ password hashes are accepted");
        HostOperation("argon2-verify", [Utf8Encoded(stored).bytes(), password.export_bytes()]).truth();
    }
    outdated(policy is Argon2Policy) is bool { stored.split("$" + policy.parameters() + "$").size() < 2; }
}

test "Argon2id hashes verify the right password only" {
    let password = SecretBytes(Utf8Encoded("correct horse").bytes());
    let policy = Argon2Policy(1024, 1, 1);
    let stored = PasswordHash(password, policy, Entropy.fake()).string();
    test.is(stored.slice(0, 30), "$argon2id$v=19$m=1024,t=1,p=1$");
    test.ok(PasswordCheck(stored, password).matches());
    test.ok(!PasswordCheck(stored, SecretBytes(Utf8Encoded("wrong horse").bytes())).matches());
    test.ok(!PasswordCheck(stored, password).outdated(policy));
    test.ok(PasswordCheck(stored, password).outdated(Argon2Policy()));
}

test "password inputs are validated" {
    test.ok(try { Argon2Policy(4, 1, 1); false; } catch e is InvalidCryptoInput { true; });
    test.ok(try { PasswordCheck("$2b$10$abc", SecretBytes([])).matches(); false; } catch e is InvalidCryptoInput { true; });
    test.ok(try { PasswordCheck("$argon2id$garbage", SecretBytes([])).matches(); false; } catch e is InvalidCryptoInput { true; });
}
