module crypto/ecdsa v1.0.0;

// ECDSA signatures on P-256 with SHA-256 and P-384 with SHA-384 (FIPS 186-5),
// with deterministic nonces.
//
//     let key = EcdsaPrivateKey(curve: EcdsaCurve.p256, entropy: SystemEntropy());
//     let signature = key.signature(message);
//     key.public_key().verified(message, signature);         // true
//     let pem = PrivateKeyPem(key.pkcs8()).string();
//
// Signatures are DER-encoded, as TLS and X.509 use them.

import "crypto/key" take PublicKey, VerifyingKey, SigningKey;
import "crypto/secret" take SecretBytes;
import "crypto/nonce" take Entropy;
import "crypto/error" take HostOperation, InvalidCryptoInput;
import "encoding/utf" take Utf8Decoded;

// The curve: P-256 or P-384.
enum EcdsaCurve = (p256, p384);

hidden object EcdsaCurveName {
    has curve is EcdsaCurve;

    EcdsaCurveName(curve is EcdsaCurve) {
        self.curve = curve;
    }

    name() is string {
        match curve {
            case EcdsaCurve.p256 {
                "p256";
            }
            case EcdsaCurve.p384 {
                "p384";
            }
        }
    }

    width() is int {
        match curve {
            case EcdsaCurve.p256 {
                32;
            }
            case EcdsaCurve.p384 {
                48;
            }
        }
    }

    algorithm() is string {
        match curve {
            case EcdsaCurve.p256 {
                "1.2.840.10045.2.1|1.2.840.10045.3.1.7";
            }
            case EcdsaCurve.p384 {
                "1.2.840.10045.2.1|1.3.132.0.34";
            }
        }
    }
}

// An ECDSA private key.
object EcdsaPrivateKey does SigningKey {
    has curve is EcdsaCurve;
    has key is SecretBytes;

    // The key in a DER PKCS#8 document.
    EcdsaPrivateKey(curve is EcdsaCurve, pkcs8 is SecretBytes) {
        let algorithm = HostOperation(operation: "pkcs8-algorithm", arguments: [pkcs8.export_bytes()]).bytes();
        confirm EcdsaCurveName(curve).algorithm() == Utf8Decoded(algorithm).string()
            else throw InvalidCryptoInput.because("PKCS#8 key is not an ECDSA key of this curve");
        self.curve = curve;
        key = pkcs8;
    }

    // A new key from entropy.
    EcdsaPrivateKey(curve is EcdsaCurve, entropy is Entropy) {
        self.curve = curve;
        key = EcdsaScalar(curve: curve, entropy: entropy).pkcs8();
    }

    // The key as DER PKCS#8.
    pkcs8() is SecretBytes {
        SecretBytes(key.export_bytes());
    }

    // Its public key.
    public_key() is VerifyingKey {
        EcdsaPublicKey(
            curve: curve,
            spki: HostOperation("ecdsa-" + EcdsaCurveName(curve).name() + "-public", [key.export_bytes()]).bytes()
        );
    }

    // The DER signature of message.
    signature(message is @byte) is @byte {
        HostOperation(
            operation: "ecdsa-" + EcdsaCurveName(curve).name() + "-sign",
            arguments: [key.export_bytes(), message]
        ).bytes();
    }
}

// An ECDSA public key.
object EcdsaPublicKey does PublicKey, VerifyingKey {
    has curve is EcdsaCurve;
    has origin is @byte;

    // The key in a DER SubjectPublicKeyInfo document.
    EcdsaPublicKey(curve is EcdsaCurve, spki is @byte) {
        let algorithm = HostOperation(operation: "spki-algorithm", arguments: [spki]).bytes();
        confirm EcdsaCurveName(curve).algorithm() == Utf8Decoded(algorithm).string()
            else throw InvalidCryptoInput.because(
                "SubjectPublicKeyInfo is not an ECDSA key of this curve"
            );
        self.curve = curve;
        origin = spki;
    }

    // The key as DER SubjectPublicKeyInfo.
    bytes() is @byte {
        origin;
    }

    // Whether signature signs message with this key.
    verified(message is @byte, signature is @byte) is bool {
        HostOperation(
            operation: "ecdsa-" + EcdsaCurveName(curve).name() + "-verify",
            arguments: [origin, message, signature]
        ).truth();
    }
}

// Internal: rejection sampling of a nonzero scalar below the group order.
hidden object EcdsaScalar {
    has curve is EcdsaCurve;
    has entropy is Entropy;

    EcdsaScalar(curve is EcdsaCurve, entropy is Entropy) {
        self.curve = curve;
        self.entropy = entropy;
    }

    pkcs8() is SecretBytes {
        let candidate = entropy.bytes(EcdsaCurveName(curve).width());
        try {
            SecretBytes(
                HostOperation(operation: "ecdsa-" + EcdsaCurveName(curve).name() + "-from-scalar", arguments: [candidate]).bytes()
            );
        }
        catch e is InvalidCryptoInput {
            self.pkcs8();
        }
    }
}

test "ECDSA keys sign deterministically and verify" {
    let key = EcdsaPrivateKey(curve: EcdsaCurve.p256, entropy: Entropy.fake());
    let public = key.public_key();
    let signature = key.signature([1.byte(), 2.byte()]);
    test.is(key.signature([1.byte(), 2.byte()]), signature);
    test.ok(public.verified([1.byte(), 2.byte()], signature));
    test.ok(!public.verified([1.byte()], signature));
    test.ok(!public.verified([1.byte(), 2.byte()], [48.byte()]));
    test.is(
        EcdsaPrivateKey(curve: EcdsaCurve.p256, pkcs8: key.pkcs8()).signature([9.byte()]),
        key.signature([9.byte()])
    );
}

test "ECDSA rejects keys of another curve" {
    let p384 = EcdsaPrivateKey(curve: EcdsaCurve.p384, entropy: Entropy.fake());
    test.ok(p384.public_key().verified([3.byte()], p384.signature([3.byte()])));
    test.throws(InvalidCryptoInput) {
        EcdsaPrivateKey(curve: EcdsaCurve.p256, pkcs8: p384.pkcs8());
    };
    test.throws(InvalidCryptoInput) {
        EcdsaPublicKey(curve: EcdsaCurve.p256, spki: p384.public_key().bytes());
    };
}
