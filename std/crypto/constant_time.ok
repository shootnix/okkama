module crypto/constant_time v1.0.0;

import "crypto/error" take HostOperation;

// Equality of two byte strings whose running time does not depend on where
// they differ (host `subtle`). Different lengths are unequal; the length
// itself is not secret. Use it for MAC tags, tokens and password digests.
//
//     ConstantTimeEqual(left: expected, right: supplied).matches();
//
// A key or token kept as SecretBytes compares itself: `stored.matches(supplied)`.
object ConstantTimeEqual {
    has left is @byte;
    has right is @byte;

    ConstantTimeEqual(left is @byte, right is @byte) {
        self.left = left;
        self.right = right;
    }

    matches() is bool {
        HostOperation(operation: "ct-equal", arguments: [left, right]).truth();
    }
}

test "constant-time equality compares whole byte strings" {
    test.ok(ConstantTimeEqual(left: [1.byte(), 2.byte()], right: [1.byte(), 2.byte()]).matches());
    test.ok(!ConstantTimeEqual(left: [1.byte(), 2.byte()], right: [1.byte(), 3.byte()]).matches());
    test.ok(!ConstantTimeEqual(left: [1.byte()], right: [1.byte(), 0.byte()]).matches());
    test.ok(ConstantTimeEqual(left: [], right: []).matches());
}
