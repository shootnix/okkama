module crypto/chacha20_poly1305 v1.0.0;

// ChaCha20-Poly1305 (RFC 8439) with a 12-byte nonce, and XChaCha20-Poly1305
// with a 24-byte nonce, long enough to pick at random for every message.
//
//     let cipher = XChaCha20Poly1305(SecretBytes(SystemEntropy().bytes(32)));
//     let nonce = RandomNonce(SystemEntropy(), 24).bytes();
//     let sealed = cipher.sealed(nonce, aad, plaintext);
//
// Both take a 32-byte key and add a 16-byte tag.

import "crypto/aead" take Sealing;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "crypto/secret" take SecretBytes;
import "crypto/error" take HostOperation, InvalidCryptoInput, AuthenticationFailed;
import "encoding/hex" take HexEncoded, HexDecoded;

// ChaCha20-Poly1305 with a 12-byte nonce.
object ChaCha20Poly1305 does Sealing {
    has key is SecretBytes;

    // A cipher with a 32-byte key.
    ChaCha20Poly1305(key is SecretBytes) {
        confirm key.size() == 32
            else throw InvalidCryptoInput.because("ChaCha20-Poly1305 key must be 32 bytes");
        self.key = key;
    }

    // How many bytes a nonce has.
    nonce_size() is int {
        12;
    }

    // How many bytes the tag adds.
    tag_size() is int {
        16;
    }

    // plaintext encrypted and authenticated with aad, under nonce; never reuse
    // a nonce with the same key.
    sealed(nonce is @byte, aad is @byte, plaintext is @byte) is @byte {
        HostOperation(operation: "aead-seal:chacha20-poly1305", arguments: [key.export_bytes(), nonce, aad, plaintext]).bytes();
    }

    // The plaintext of sealed; AuthenticationFailed when it or aad was changed.
    opened(nonce is @byte, aad is @byte, sealed is @byte) is @byte {
        HostOperation(operation: "aead-open:chacha20-poly1305", arguments: [key.export_bytes(), nonce, aad, sealed]).bytes();
    }

    // Text, as UTF-8: cipher.sealed(nonce, "record 7", "balance: 42").
    sealed(nonce is @byte, aad is string, text is string) is @byte {
        self.sealed(nonce, Utf8Encoded(aad).bytes(), Utf8Encoded(text).bytes());
    }

    // The same with aad as UTF-8 text.
    opened(nonce is @byte, aad is string, sealed is @byte) is @byte {
        self.opened(nonce, Utf8Encoded(aad).bytes(), sealed);
    }

    // The plaintext as UTF-8 text.
    opened_text(nonce is @byte, aad is string, sealed is @byte) is string {
        Utf8Decoded(self.opened(nonce, Utf8Encoded(aad).bytes(), sealed)).string();
    }
}

// XChaCha20-Poly1305 with a 24-byte nonce, safe to pick at random.
object XChaCha20Poly1305 does Sealing {
    has key is SecretBytes;

    // A cipher with a 32-byte key.
    XChaCha20Poly1305(key is SecretBytes) {
        confirm key.size() == 32
            else throw InvalidCryptoInput.because("XChaCha20-Poly1305 key must be 32 bytes");
        self.key = key;
    }

    // How many bytes a nonce has.
    nonce_size() is int {
        24;
    }

    // How many bytes the tag adds.
    tag_size() is int {
        16;
    }

    // plaintext encrypted and authenticated with aad, under nonce; never reuse
    // a nonce with the same key.
    sealed(nonce is @byte, aad is @byte, plaintext is @byte) is @byte {
        HostOperation(operation: "aead-seal:xchacha20-poly1305", arguments: [key.export_bytes(), nonce, aad, plaintext]).bytes();
    }

    // The plaintext of sealed; AuthenticationFailed when it or aad was changed.
    opened(nonce is @byte, aad is @byte, sealed is @byte) is @byte {
        HostOperation(operation: "aead-open:xchacha20-poly1305", arguments: [key.export_bytes(), nonce, aad, sealed]).bytes();
    }

    // Text, as UTF-8: cipher.sealed(nonce, "record 7", "balance: 42").
    sealed(nonce is @byte, aad is string, text is string) is @byte {
        self.sealed(nonce, Utf8Encoded(aad).bytes(), Utf8Encoded(text).bytes());
    }

    // The same with aad as UTF-8 text.
    opened(nonce is @byte, aad is string, sealed is @byte) is @byte {
        self.opened(nonce, Utf8Encoded(aad).bytes(), sealed);
    }

    // The plaintext as UTF-8 text.
    opened_text(nonce is @byte, aad is string, sealed is @byte) is string {
        Utf8Decoded(self.opened(nonce, Utf8Encoded(aad).bytes(), sealed)).string();
    }
}

test "ChaCha20-Poly1305 matches RFC 8439 section 2.8.2" {
    let key is @byte = (0..32).map() -> i {
        (128 + i).byte();
    };
    let nonce = [7, 0, 0, 0, 64, 65, 66, 67, 68, 69, 70, 71].map() -> value {
        value.byte();
    };
    let aad = [80, 81, 82, 83, 192, 193, 194, 195, 196, 197, 198, 199].map() -> value {
        value.byte();
    };
    let text = HexDecoded(
        "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e"
    ).bytes();
    let sealed = ChaCha20Poly1305(SecretBytes(key)).sealed(nonce, aad, text);
    test.is(
        HexEncoded(sealed.slice(sealed.size() - 16, sealed.size())).string(),
        "1ae10b594f09e26a7e902ecbd0600691"
    );
    test.is(HexEncoded(sealed.slice(0, 16)).string(), "d31a8d34648e60db7b86afbc53ef7ec2");
    test.is(ChaCha20Poly1305(SecretBytes(key)).opened(nonce, aad, sealed), text);
}

test "XChaCha20-Poly1305 round-trips and authenticates" {
    let key is @byte = (0..32).map() -> i {
        i.byte();
    };
    let nonce is @byte = (0..24).map() -> i {
        3.byte();
    };
    let cipher = XChaCha20Poly1305(SecretBytes(key));
    let sealed = cipher.sealed(nonce, [], [1.byte()]);
    test.is(cipher.opened(nonce, [], sealed), [1.byte()]);
    test.throws(AuthenticationFailed) {
        cipher.opened(nonce, [], sealed.slice(0, sealed.size() - 1));
    };
}

test "a cipher seals and opens text" {
    let cipher = ChaCha20Poly1305(SecretBytes((0..32).map() -> index { byte(index); }));
    let nonce is @byte = (0..12).map() -> index { byte(index); };
    let sealed = cipher.sealed(nonce, "record 7", "balance: 42 é");
    test.is(cipher.opened_text(nonce, "record 7", sealed), "balance: 42 é");
    test.is(cipher.opened(nonce, "record 7", sealed), cipher.opened(nonce, [114.byte(), 101.byte(), 99.byte(), 111.byte(), 114.byte(), 100.byte(), 32.byte(), 55.byte()], sealed));
    test.throws(AuthenticationFailed) {
        cipher.opened_text(nonce, "record 8", sealed);
    };
}
