module calendar v1.0.0;

import "collections/iteration" take Cursor, Iterating, IterationEnded;
import "collections/sequence" take Sequencing;
import "compare" take Comparing, Order;
import "error" take OutOfRange;
import "size" take Sizing;
import "time/date" take Date, GregorianDay, Weekday;
import "time/iso" take IsoDate;

// Immutable Gregorian calendar views.
//
// MonthDates contains only dates belonging to its month:
//
//     let august = MonthDates(origin: YearMonth(year: 2026, month: 8));
//     august.size();       // 31
//     august.first()::Calendar::day; // 1
//     august.last()::Calendar::day;  // 31
//
// CalendarMonth divides a month into complete seven-day rows. A row may
// contain dates from adjacent months:
//
//     let grid = CalendarMonth(
//         origin: YearMonth(year: 2026, month: 8),
//         first_weekday: Weekday.monday,
//     );
//     grid.first().first(); // 2026-07-27
//     grid.last().last();   // 2026-09-06
//
// ISO weeks always run from Monday through Sunday; IsoWeek refuses a week its
// year does not have when made. A calendar grid whose complete seven-day span
// would leave Date's supported years 1..9999 is refused when it is walked or
// measured, instead of returning partial weeks. Year(2028).leap() tells a
// leap year.

// A month of a year, for calendar views; ordered by time.
object YearMonth does Comparing<YearMonth> {
    has year_value is int;
    has month_value is int;

    // Month 1 to 12 of year 1 to 9999; anything else is InvalidYearMonth.
    YearMonth(year is int, month is int) {
        confirm year >= 1 && year <= 9999
            else throw InvalidYearMonth.because("year must be within 1..9999");
        confirm month >= 1 && month <= 12
            else throw InvalidYearMonth.because("month must be within 1..12");
        year_value = year;
        month_value = month;
    }

    // The month as given.
    cap Calendar {
        year is int {
            year_value;
        }

        month is int {
            month_value;
        }
    }

    // Earlier months come first.
    order(other is YearMonth) is Order {
        if year_value != other::Calendar::year {
            year_value.order(other::Calendar::year);
        }
        else {
            month_value.order(other::Calendar::month);
        }
    }
}

// The dates of one month, in order: `MonthDates(origin: YearMonth(2026,
// 8)).size()` is 31.
object MonthDates does Sequencing<Date>, Iterating<Date>, Sizing {
    has origin is YearMonth;

    // The dates of origin.
    MonthDates(:origin);

    // Walks the dates.
    cursor() is Cursor<Date> {
        MonthDateCursor(origin: self, position: 0);
    }

    // How many days the month has.
    size() is int {
        match origin::Calendar::month {
            case 2 {
                if Year(year: origin::Calendar::year).leap() {
                    29;
                }
                else {
                    28;
                }
            }
            case 4, 6, 9, 11 {
                30;
            }
            else {
                31;
            }
        }
    }

    // The date at index, from 0.
    item(index is int) is Date {
        confirm index >= 0 && index < self.size()
            else throw OutOfRange.because("month date index is outside the sequence");
        Date(
            year: origin::Calendar::year,
            month: origin::Calendar::month,
            day: index + 1,
        );
    }

    // The first of the month.
    first() is Date {
        self.item(0);
    }

    // The last day of the month.
    last() is Date {
        self.item(self.size() - 1);
    }
}

hidden object MonthDateCursor does Cursor<Date> {
    has origin is MonthDates;
    has position is int;

    MonthDateCursor(origin is MonthDates, position is int) {
        confirm position >= 0 && position <= origin.size()
            else throw OutOfRange.because("month date cursor position is invalid");
        self.origin = origin;
        self.position = position;
    }

    available() is bool {
        position < origin.size();
    }

    item() is Date {
        confirm self.available() else throw IterationEnded.ended;
        origin.item(position);
    }

    successor() is Cursor<Date> {
        confirm self.available() else throw IterationEnded.ended;
        MonthDateCursor(origin: origin, position: position + 1);
    }
}

// Seven dates from start.
object CalendarWeek does Sequencing<Date>, Iterating<Date>, Sizing {
    has first_date is Date;

    // The week that begins on start.
    CalendarWeek(start is Date) {
        self.first_date = start;
    }

    // Walks the seven dates.
    cursor() is Cursor<Date> {
        CalendarWeekCursor(origin: self, position: 0);
    }

    // Always 7.
    size() is int {
        7;
    }

    // The date at index, 0 to 6.
    item(index is int) is Date {
        confirm index >= 0 && index < 7
            else throw OutOfRange.because("calendar week index is outside the sequence");
        let start is int = GregorianDay(first_date).number();
        confirm start <= 3652053
            else throw InvalidCalendarMonth.because(
                "calendar week leaves the supported date range"
            );
        GregorianDay(start + index).date();
    }

    // The first day.
    first() is Date {
        first_date;
    }

    // The seventh day.
    last() is Date {
        self.item(6);
    }
}

hidden object CalendarWeekCursor does Cursor<Date> {
    has origin is CalendarWeek;
    has position is int;

    CalendarWeekCursor(origin is CalendarWeek, position is int) {
        confirm position >= 0 && position <= 7
            else throw OutOfRange.because("calendar week cursor position is invalid");
        self.origin = origin;
        self.position = position;
    }

    available() is bool {
        position < 7;
    }

    item() is Date {
        confirm self.available() else throw IterationEnded.ended;
        origin.item(position);
    }

    successor() is Cursor<Date> {
        confirm self.available() else throw IterationEnded.ended;
        CalendarWeekCursor(origin: origin, position: position + 1);
    }
}

// A month laid out as whole weeks, as a wall calendar shows it; edge weeks hold
// days of the months around it.
object CalendarMonth does Sequencing<Sequencing<Date>>, Iterating<Sequencing<Date>>, Sizing {
    has origin is YearMonth;
    has first_weekday is Weekday;

    // The weeks of origin, each starting on first_weekday.
    CalendarMonth(origin is YearMonth, first_weekday is Weekday) {
        self.origin = origin;
        self.first_weekday = first_weekday;
    }

    // Walks the weeks.
    cursor() is Cursor<Sequencing<Date>> {
        CalendarMonthCursor(origin: self, position: 0);
    }

    // How many weeks: 4 to 6.
    size() is int {
        let layout = CalendarMonthLayout(
            origin: origin,
            first_weekday: first_weekday,
        );
        layout.first_ordinal();
        layout.size();
    }

    // The week at index.
    item(index is int) is Sequencing<Date> {
        confirm index >= 0 && index < self.size()
            else throw OutOfRange.because("calendar month row is outside the sequence");
        let layout = CalendarMonthLayout(
            origin: origin,
            first_weekday: first_weekday,
        );
        CalendarWeek(
            start: GregorianDay(layout.first_ordinal() + index * 7).date(),
        );
    }

    // The week holding the first of the month.
    first() is Sequencing<Date> {
        self.item(0);
    }

    // The week holding the last day of the month.
    last() is Sequencing<Date> {
        self.item(self.size() - 1);
    }
}

hidden object CalendarMonthCursor does Cursor<Sequencing<Date>> {
    has origin is CalendarMonth;
    has position is int;

    CalendarMonthCursor(origin is CalendarMonth, position is int) {
        confirm position >= 0 && position <= origin.size()
            else throw OutOfRange.because("calendar month cursor position is invalid");
        self.origin = origin;
        self.position = position;
    }

    available() is bool {
        position < origin.size();
    }

    item() is Sequencing<Date> {
        confirm self.available() else throw IterationEnded.ended;
        origin.item(position);
    }

    successor() is Cursor<Sequencing<Date>> {
        confirm self.available() else throw IterationEnded.ended;
        CalendarMonthCursor(origin: origin, position: position + 1);
    }
}

hidden object CalendarMonthLayout {
    has origin is YearMonth;
    has first_weekday is Weekday;

    CalendarMonthLayout(:origin, :first_weekday);

    first_ordinal() is int {
        let first = Date(year: origin::Calendar::year, month: origin::Calendar::month, day: 1);
        let lead is int = ((WeekdayIndex(origin: first.weekday()).index()) -
            (WeekdayIndex(origin: first_weekday).index()) +
            7) % 7;
        let result is int = (GregorianDay(first).number()) - lead;
        confirm result >= 1 && result + self.size() * 7 - 1 <= 3652059
            else throw InvalidCalendarMonth.because(
                "calendar month leaves the supported date range"
            );
        result;
    }

    size() is int {
        let first = Date(year: origin::Calendar::year, month: origin::Calendar::month, day: 1);
        let lead is int = ((WeekdayIndex(origin: first.weekday()).index()) -
            (WeekdayIndex(origin: first_weekday).index()) +
            7) % 7;
        ((lead + MonthDates(origin: origin).size() + 6) / 7).int();
    }
}

// An ISO 8601 week: Monday to Sunday, numbered within its week-based year.
object IsoWeek does Comparing<IsoWeek> {
    has year_value is int;
    has week_value is int;
    has start is int;

    // Week 1 to 52 or 53 of year; a week the year does not have is
    // InvalidIsoWeek.
    IsoWeek(year is int, week is int) {
        confirm year >= 1 && year <= 9999
            else throw InvalidIsoWeek.because("ISO week year must be within 1..9999");
        // Day numbers count from 0001-01-01, a Monday, as GregorianDay does.
        let prior = year - 1;
        let before is int = prior * 365 + (prior / 4).int() - (prior / 100).int() + (prior / 400).int();
        let january_index is int = before % 7;
        let leap is bool = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
        let maximum is int = if january_index == 3
            || (january_index == 2 && leap) {
                53;
            }
            else {
                52;
            };
        confirm week >= 1 && week <= maximum
            else throw InvalidIsoWeek.because("ISO week is outside its week-year");
        let first_ordinal is int = before + 4 - (january_index + 3) % 7 + (week - 1) * 7;
        confirm first_ordinal >= 1 && first_ordinal + 6 <= 3652059
            else throw InvalidIsoWeek.because(
                "ISO week leaves the supported date range"
            );
        year_value = year;
        week_value = week;
        start = first_ordinal;
    }

    // The week as given: its week-year and its number in it.
    cap Calendar {
        year is int {
            year_value;
        }

        week is int {
            week_value;
        }
    }

    // Its Monday.
    first() is Date {
        GregorianDay(start).date();
    }

    // Its Sunday.
    last() is Date {
        GregorianDay(start + 6).date();
    }

    // Earlier weeks come first.
    order(other is IsoWeek) is Order {
        if year_value != other::Calendar::year {
            year_value.order(other::Calendar::year);
        }
        else {
            week_value.order(other::Calendar::week);
        }
    }
}

// A Gregorian year: Year(2028).leap().
object Year {
    has origin is int;

    // The year, 1 to 9999.
    Year(year is int) {
        confirm year >= 1 && year <= 9999
            else throw InvalidYearMonth.because("year must be within 1..9999");
        origin = year;
    }

    // Whether February has 29 days.
    leap() is bool {
        origin % 4 == 0 && (origin % 100 != 0 || origin % 400 == 0);
    }
}

hidden object WeekdayIndex {
    has origin is Weekday;

    WeekdayIndex(:origin);

    index() is int {
        match origin {
            case Weekday.monday {
                0;
            }
            case Weekday.tuesday {
                1;
            }
            case Weekday.wednesday {
                2;
            }
            case Weekday.thursday {
                3;
            }
            case Weekday.friday {
                4;
            }
            case Weekday.saturday {
                5;
            }
            else {
                6;
            }
        }
    }
}

// A year or month out of range.
enum InvalidYearMonth is Error = (because(reason is string));

// A calendar grid that would leave years 1 to 9999.
enum InvalidCalendarMonth is Error = (because(reason is string));

// A week the year does not have.
enum InvalidIsoWeek is Error = (because(reason is string));

test "a year knows whether it is leap" {
    test.ok(Year(2028).leap());
    test.ok(Year(2000).leap());
    test.ok(!Year(1900).leap());
    test.ok(!Year(2026).leap());
    test.throws(InvalidYearMonth) {
        Year(0);
    };
    test.throws(InvalidYearMonth) {
        Year(10000);
    };
}

test "a month lists its own dates and compares by year, then month" {
    let february = YearMonth(year: 2028, month: 2);
    test.is(february::Calendar::year, 2028);
    test.is(february::Calendar::month, 2);
    test.is(MonthDates(origin: february).size(), 29);
    test.is(MonthDates(origin: YearMonth(year: 2026, month: 2)).size(), 28);
    let august = MonthDates(origin: YearMonth(year: 2026, month: 8));
    test.is(august.size(), 31);
    test.is(august.first()::Calendar::day, 1);
    test.is(august.last()::Calendar::day, 31);
    test.is(august.item(9)::Calendar::day, 10);
    let days is @int = august.map() -> date { date::Calendar::day; };
    test.is(days.size(), 31);
    test.ok(YearMonth(year: 2026, month: 12).order(YearMonth(year: 2027, month: 1)) == Order.less);
    test.ok(YearMonth(year: 2026, month: 8).order(YearMonth(year: 2026, month: 3)) == Order.greater);
    test.throws(InvalidYearMonth) {
        YearMonth(year: 2026, month: 13);
    };
    test.throws(OutOfRange) {
        august.item(31);
    };
}

test "a calendar month is whole weeks from the chosen first weekday" {
    let grid = CalendarMonth(origin: YearMonth(year: 2026, month: 8), first_weekday: Weekday.monday);
    test.is(grid.size(), 6);
    test.is(IsoDate(origin: grid.first().first()).string(), "2026-07-27");
    test.is(IsoDate(origin: grid.last().last()).string(), "2026-09-06");
    let sundays = CalendarMonth(origin: YearMonth(year: 2026, month: 8), first_weekday: Weekday.sunday);
    test.is(IsoDate(origin: sundays.first().first()).string(), "2026-07-26");
    test.is(sundays.size(), 6);
    let rows is @int = grid.map() -> week { week.size(); };
    test.is(rows, [7, 7, 7, 7, 7, 7]);
    test.is(CalendarMonth(origin: YearMonth(year: 2026, month: 2), first_weekday: Weekday.sunday).size(), 4);
    test.throws(InvalidCalendarMonth) {
        CalendarMonth(origin: YearMonth(year: 1, month: 1), first_weekday: Weekday.tuesday).size();
    };
}

test "ISO weeks run Monday to Sunday and know how many a year has" {
    let week = IsoWeek(year: 2026, week: 1);
    test.is(IsoDate(origin: week.first()).string(), "2025-12-29");
    test.is(IsoDate(origin: week.last()).string(), "2026-01-04");
    test.is(week::Calendar::year, 2026);
    test.is(week::Calendar::week, 1);
    test.is(IsoDate(origin: IsoWeek(year: 2026, week: 53).first()).string(), "2026-12-28");
    test.throws(InvalidIsoWeek) {
        IsoWeek(year: 2027, week: 53);
    };
    test.throws(InvalidIsoWeek) {
        IsoWeek(year: 2026, week: 0);
    };
    test.is(IsoDate(origin: IsoWeek(year: 1, week: 1).first()).string(), "0001-01-01");
    test.ok(IsoWeek(year: 2026, week: 9).order(IsoWeek(year: 2026, week: 10)) == Order.less);
    test.ok(IsoWeek(year: 2027, week: 1).order(IsoWeek(year: 2026, week: 53)) == Order.greater);
}
