module runtime/postgres v1.0.0;

// The DataRow messages of one result portion (raw, as read from the wire)
// become one result page in the PostgreSQL text format: one call per portion
// instead of one object per row and column. `types` are the column type oids.
//
// Cells use the db cell codes (0 null, 1 boolean, 2 integer, 3 floating,
// 4 decimal, 5 text, 6 bytes); a value is the integer of an integer or
// boolean cell, else the ordinal of the cell in its typed array (decimals
// and texts share `pg_page_texts`). A malformed portion gives a page whose
// failure is one of "message", "truncated", "width", "utf8", "integer",
// "floating", "nonfinite", "bytea"; a whole page has an empty failure.
native object PgPageState;

native pg_page(rows is @byte, width is int, types is @int) is PgPageState;

native pg_page_failure(page is PgPageState) is string;

native pg_page_rows(page is PgPageState) is int;

native pg_page_kinds(page is PgPageState) is @int;

native pg_page_values(page is PgPageState) is @int;

native pg_page_floats(page is PgPageState) is @float;

native pg_page_texts(page is PgPageState) is @string;

native pg_page_blobs(page is PgPageState) is @@byte;
