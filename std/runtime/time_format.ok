module runtime/time_format v1.0.0;

// The native layer under time/format: the calls those modules make into the
// host runtime. Programs use those modules instead; these declarations may
// change with the runtime.

// Where pattern is not valid, or -1.
native time_pattern_invalid_offset(
    pattern is string,
    local is bool,
    parsing is bool,
) is int;

// The date written by pattern.
native time_format_date(
    year is int,
    month is int,
    day is int,
    pattern is string,
) is string;

// The local date and time written by pattern.
native time_format_local(
    year is int,
    month is int,
    day is int,
    hour is int,
    minute is int,
    second is int,
    nanosecond is int,
    pattern is string,
) is string;

// Where origin does not fit pattern, or -1.
native time_parse_invalid_offset(
    origin is string,
    pattern is string,
    local is bool,
) is int;

// The fields origin gives by pattern.
native time_parse_parts(
    origin is string,
    pattern is string,
    local is bool,
) is @int;
