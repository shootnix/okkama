module runtime/html v1.0.0;

// Private immutable tokenizer state for html/events. Numeric kinds and random
// accessors remain below the public typed event boundary.

native object HtmlEventsState;

native html_events(origin is string) is HtmlEventsState;
native html_event_count(origin is HtmlEventsState) is int;
native html_event_kind(origin is HtmlEventsState, index is int) is int;
native html_event_name(origin is HtmlEventsState, index is int) is string;
native html_event_value(origin is HtmlEventsState, index is int) is string;
native html_event_target(origin is HtmlEventsState, index is int) is string;
native html_event_data(origin is HtmlEventsState, index is int) is string;
native html_event_self_closing(origin is HtmlEventsState, index is int) is bool;
native html_attribute_count(origin is HtmlEventsState, index is int) is int;
native html_attribute_name(origin is HtmlEventsState, event is int, attribute is int) is string;
native html_attribute_valued(origin is HtmlEventsState, event is int, attribute is int) is bool;
native html_attribute_value(origin is HtmlEventsState, event is int, attribute is int) is string;

// html_events eagerly snapshots the source into ordered lexical events; this
// is a tokenizer, not a repaired DOM. Text references decode except inside
// script/style raw text. Names use ASCII lowercase. Kind tags are substrate
// only: 0 start, 1 end, 2 text, 3 comment, 4 declaration, 5 instruction.
// Event and attribute indices are zero-based and invalid_input on bounds/kind
// failure. Boolean attributes retain valued=false separately from empty value.
// Pure immutable handles remain registry-owned; no I/O or external resources.

test "HTML event coordinates and attributes preserve lexical order" {
    let events = html_events("<!DOCTYPE html><?xml data?><P disabled title='a&amp;b'/>text<!--note--></p>");
    test.is(html_event_count(events), 6);
    test.is(html_event_kind(events, 0), 4);
    test.is(html_event_value(events, 0), "DOCTYPE html");
    test.is(html_event_kind(events, 1), 5);
    test.is(html_event_target(events, 1), "xml");
    test.is(html_event_data(events, 1), "data");
    test.is(html_event_name(events, 2), "p");
    test.ok(html_event_self_closing(events, 2));
    test.is(html_attribute_count(events, 2), 2);
    test.is(html_attribute_name(events, 2, 0), "disabled");
    test.is(html_attribute_valued(events, 2, 0), false);
    test.is(html_attribute_value(events, 2, 0), "");
    test.ok(html_attribute_valued(events, 2, 1));
    test.is(html_attribute_value(events, 2, 1), "a&b");
    test.is(html_event_value(events, 3), "text");
    test.is(html_event_kind(events, 4), 3);
    test.is(html_event_value(events, 4), "note");
    test.is(html_event_kind(events, 5), 1);
}
test "HTML empty and invalid indices return predictable results" {
    test.is(html_event_count(html_events("")), 0);
    let events = html_events("<p a=1>");
    for [-1, 1] -> index {
        test.is(try {html_event_kind(events, index); "";} catch failure is NativeFailure {failure.code();}, "invalid_input");
        test.is(try {html_attribute_name(events, 0, index); "";} catch failure is NativeFailure {failure.code();}, "invalid_input");
    }
}
