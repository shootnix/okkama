module runtime/random v1.0.0;

// The native layer under random/source: the calls those modules make into the
// host runtime. Programs use those modules instead; these declarations may
// change with the runtime.
//
// Portable PCG32 state and fixed-width sample interpretation.

// A PCG random generator.
native object PcgState;

// A generator seeded with seed.
native pcg_state(seed is int) is PcgState;

// An integer from start up to stop.
native pcg_integer(state is PcgState, start is int, stop is int) is int;

// A float in [0, 1).
native pcg_float(state is PcgState) is float;

// size random bytes.
native pcg_bytes(state is PcgState, size is int) is @byte;

// Whether sample gives an unbiased integer in start..stop.
native random_sample_accepted(
    sample is @byte,
    start is int,
    stop is int,
) is bool;

// The integer sample gives in start..stop.
native random_integer_from_sample(
    sample is @byte,
    start is int,
    stop is int,
) is int;

// The float in [0, 1) sample gives.
native random_float_from_sample(sample is @byte) is float;
