module runtime/csv_state v1.0.0;

// The native layer under csv, csv/stream: the calls those modules make into the
// host runtime. Programs use those modules instead; these declarations may
// change with the runtime.

// Opaque bounded scanner state; owned by csv/stream, never owns its source.
native object CsvState;

// A CSV reader with these byte, input, field, row and column limits.
native csv_state_create(bytes is int, input is int, field is int, rows is int, columns is int) is CsvState;

// Feeds bytes.
native csv_state_feed(state is CsvState, bytes is @byte) is bool;

// What comes next: a row, the end, a request for more input, or an error.
native csv_state_advance(state is CsvState) is string;

// The row advance announced.
native csv_state_row(state is CsvState) is @string;

// Where an error was.
native csv_state_offset(state is CsvState) is int;

// How many more bytes it wants.
native csv_state_request(state is CsvState) is int;

// Whether it was closed.
native csv_state_closed(state is CsvState) is bool;

// Frees it.
native csv_state_close(state is CsvState) is bool;
