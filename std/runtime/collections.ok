module runtime/collections v1.0.0;

// Pure typed snapshot boundary, no environment/JSON conversion or I/O.
// Parallel string coordinates must have equal lengths and unique exact keys.
// Caller budgets are nonnegative, capped at4096 entries and1048576 Unicode
// scalars; limits charge key+value before publishing. Empty maps retain their
// exact string/string types. Inputs are unchanged; the resulting builtin map
// uses its existing deterministic lexical key order. Budget failures use
// resource_exhausted; malformed coordinates use invalid_input.
// Literal scalars plus '*' only; anchored=false accepts a matching prefix.
// Step budget 1..262144 counts pointer/retry iterations, including termination.
native string_star_match(pattern is string,target is string,anchored is bool,steps is int) is bool;

native string_map_snapshot(keys is @string,values is @string,entries is int,characters is int) is %string:string;

test "empty snapshot preserves map type and exact aggregate boundary" {
    let empty is @string=[];let map is %string:string=string_map_snapshot(empty,empty,0,0);
    test.is(map.size(),0);test.is(string_map_snapshot(["key"],[""],1,3)["key"],"");
}
