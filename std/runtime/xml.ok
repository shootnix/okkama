module runtime/xml v1.0.0;

// The native layer under plist/parse, xml/parse: the calls those modules make
// into the host runtime. Programs use those modules instead; these declarations
// may change with the runtime.
//
// XML events of a whole document (#144), for xml/parse: the runtime checks
// that the document is well formed, with no DTD and bounded depth and size.
// Kinds: 0 start, 1 end, 2 text, 3 comment, 4 processing instruction.

// The events of a parsed XML document.
native object XmlEventsState;

// Parses origin within the depth and event limits.
native xml_events(origin is string, maximum_depth is int, maximum_events is int) is XmlEventsState;

// Why it failed, or "".
native xml_events_error(state is XmlEventsState) is string;

// Where it failed.
native xml_events_offset(state is XmlEventsState) is int;

// How many events.
native xml_event_count(state is XmlEventsState) is int;

// The kind of event index.
native xml_event_kind(state is XmlEventsState, index is int) is int;

// The name of event index.
native xml_event_name(state is XmlEventsState, index is int) is string;

// The text of event index.
native xml_event_text(state is XmlEventsState, index is int) is string;

// How many attributes event index has.
native xml_attribute_count(state is XmlEventsState, index is int) is int;

// The name of an attribute.
native xml_attribute_name(state is XmlEventsState, index is int, attribute is int) is string;

// The value of an attribute.
native xml_attribute_value(state is XmlEventsState, index is int, attribute is int) is string;

// The character offset where an event starts.
native xml_event_offset(state is XmlEventsState, index is int) is int;
