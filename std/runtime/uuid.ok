module runtime/uuid v1.0.0;

// The native layer under uuid/generation, uuid/value: the calls those modules
// make into the host runtime. Programs use those modules instead; these
// declarations may change with the runtime.

// Strict canonical UUID parsing and formatting boundary.
native uuid_valid(origin is string) is bool;

// The 16 bytes of a UUID's text.
native uuid_bytes(origin is string) is @byte;

// The UUID's text.
native uuid_string(origin is @byte) is string;

// Its version.
native uuid_version(origin is @byte) is int;

// Its variant.
native uuid_variant(origin is @byte) is string;

// origin with the version and variant bits set.
native uuid_versioned(origin is @byte, version is int) is @byte;

// A name-based UUID (version 3 or 5) of name in namespace.
native uuid_named(
    namespace is @byte,
    name is @byte,
    version is int,
) is @byte;

// A UUID from three integers.
native uuid_custom(high is int, middle is int, low is int) is @byte;
