module runtime/host_crypto v1.0.0;

// Private substrate for digest/* and crypto/*: reviewed host implementations
// (RustCrypto in okkama-native) behind one byte-in/byte-out operation and
// cloneable digest states. Integers travel as decimal ASCII. Failures are
// NativeFailure in domain core.crypto: invalid_input (bad lengths, keys,
// parameters), permission_denied (authentication failed), unsupported,
// unexpected. Public modules wrap every call in typed objects and errors.
native object DigestState;
native digest_create(algorithm is string, key is @byte, length is int) is DigestState;
native digest_update(origin is DigestState, bytes is @byte) is DigestState;
native digest_bytes(origin is DigestState, length is int) is @byte;
native crypto(operation is string, arguments is @@byte) is @byte;
