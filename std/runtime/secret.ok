module runtime/secret v1.0.0;

// The native layer under crypto/secret: the calls those modules make into the
// host runtime. Programs use those modules instead; these declarations may
// change with the runtime.

// Secret bytes kept in locked memory.
native object SecretState;

// Keeps source as a secret.
native create(source is @byte) is SecretState;

// How many bytes.
native size(origin is SecretState) is int;

// The bytes, for one deliberate use.
native export(origin is SecretState) is @byte;

// Wipes the bytes.
native close(origin is SecretState) is bool;

// Whether it was wiped.
native closed(origin is SecretState) is bool;
