module runtime/collation v1.0.0;

// The native layer under locale/collation: the calls those modules make into
// the host runtime. Programs use those modules instead; these declarations may
// change with the runtime.

// Pinned ICU 76.1 / Unicode and UCA 16 / CLDR 46.0. No host default.
native collation_key(
    text is string,
    locale is string,
    collation is string,
    strength is int,
    case_first is int,
    numeric is bool,
    normalization is bool
) is @byte;
