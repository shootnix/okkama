module http/cache_freshness v1.0.0;

import "http/header" take Headers, HeaderName;
import "http/cache_control" take CacheControl, CacheDeltaSeconds;
import "http/date" take ParsedHttpDate;
import "time/clock" take Instant, MonotonicInstant;
import "time/duration" take Duration, DurationUnit;

// Wall time supplies Date comparison only; elapsed delay/residence is monotonic.
object CacheResponseTiming {
    has received is Instant;
    has started, finished is MonotonicInstant;

    CacheResponseTiming(
        received is Instant,
        started is MonotonicInstant,
        finished is MonotonicInstant
    ) {
        confirm finished.minus(started)::Span::seconds >= 0.rat() else throw InvalidCacheTiming.invalid;
        self.received = received;
        self.started = started;
        self.finished = finished;
    }

    received() is Instant {
        received;
    }

    finished() is MonotonicInstant {
        finished;
    }

    delay() is Duration {
        finished.minus(started);
    }
}

object CacheFreshness {
    has timing is CacheResponseTiming;
    has initial, lifetime is Duration;
    has reusable is bool;

    CacheFreshness(headers is Headers, timing is CacheResponseTiming) {
        self.timing = timing;
        let metadata = CacheFreshnessMetadata(headers: headers, received: timing.received());
        let apparent = timing.received().minus(metadata.date())::Span::seconds;
        let nonnegative = if apparent > 0.rat() {
            apparent;
        }
        else {
            0.rat();
        };
        let corrected = metadata.age().rat() + timing.delay()::Span::seconds;
        initial = Duration(
            value: if nonnegative > corrected {
                nonnegative;
            }
            else {
                corrected;
            },
            unit: DurationUnit.second
        );
        lifetime = metadata.lifetime();
        reusable = metadata.reusable();
    }

    age(now is MonotonicInstant) is Duration {
        let resident = now.minus(timing.finished());
        confirm resident::Span::seconds >= 0.rat() else throw InvalidCacheTiming.invalid;
        initial.plus(resident);
    }

    lifetime() is Duration {
        lifetime;
    }

    reusable() is bool {
        reusable;
    }

    fresh(now is MonotonicInstant) is bool {
        let current = self.age(now);
        reusable && current::Span::seconds < lifetime::Span::seconds;
    }
}

hidden object CacheFreshnessMetadata {
    has date is Instant;
    has age is int;
    has lifetime is Duration;
    has reusable is bool;

    CacheFreshnessMetadata(headers is Headers, received is Instant) {
        let observed = try {
            CacheFreshnessObservations(headers: headers, received: received);
        }
        catch e is Error {
            CacheFreshnessObservations(received);
        };
        date = observed.date();
        age = observed.age();
        lifetime = observed.lifetime();
        reusable = observed.reusable();
    }

    date() is Instant {
        date;
    }

    age() is int {
        age;
    }

    lifetime() is Duration {
        lifetime;
    }

    reusable() is bool {
        reusable;
    }
}

hidden object CacheFreshnessObservations {
    has date is Instant;
    has age is int;
    has lifetime is Duration;
    has reusable is bool;

    // Invalid received cache metadata remains an unusable observation, not an
    // error in the application response or permission to try a weaker fallback.
    CacheFreshnessObservations(received is Instant) {
        date = received;
        age = 0;
        lifetime = Duration(seconds: 0);
        reusable = false;
    }

    CacheFreshnessObservations(headers is Headers, received is Instant) {
        let dates = headers.values(HeaderName("Date"));
        confirm dates.size() <= 1 else throw InvalidCacheMetadata.invalid;
        let observed = if dates.size() == 1 {
            ParsedHttpDate(origin: dates.item(0), reference: received).instant();
        }
        else {
            received;
        };
        date = observed;
        let ages = headers.values(HeaderName("Age"));
        confirm ages.size() <= 1 else throw InvalidCacheMetadata.invalid;
        age = if ages.size() == 1 {
            CacheDeltaSeconds(ages.item(0)).seconds();
        }
        else {
            0;
        };
        let control = CacheControl(headers);
        let max_age = control.count("max-age");
        let duration = if max_age > 0 {
            control.seconds("max-age").rat();
        }
        else {
            let expires = headers.values(HeaderName("Expires"));
            confirm expires.size() <= 1 else throw InvalidCacheMetadata.invalid;
            if expires.size() == 1 {
                let difference = ParsedHttpDate(origin: expires.item(0), reference: received).instant().minus(observed)::Span::seconds;
                if difference > 0.rat() {
                    difference;
                }
                else {
                    0.rat();
                }
            }
            else {
                0.rat();
            }
        };
        lifetime = Duration(value: duration, unit: DurationUnit.second);
        reusable = !control.present("no-cache") && !control.present("no-store");
    }

    date() is Instant {
        date;
    }

    age() is int {
        age;
    }

    lifetime() is Duration {
        lifetime;
    }

    reusable() is bool {
        reusable;
    }
}

enum InvalidCacheMetadata is Error = (invalid);

enum InvalidCacheTiming is Error = (invalid);

test "cache age includes monotonic response delay" {
    let received = Instant(Duration(seconds: 100));
    let began = MonotonicInstant(Duration(seconds: 0));
    let ended = began.plus(Duration(seconds: 2));
    let value = CacheFreshness(headers: Headers(), timing: CacheResponseTiming(received, began, ended));
    test.is(value.age(ended)::Span::seconds, 2.rat());
}
