module http/http2_settings v1.0.0;

// The SETTINGS this side advertises on an HTTP/2 connection.
//
//     Http2Settings();                     // 4096 table, 65535 window, 16384 frames, 100 streams

import "encoding/binary" take IntegerBytes, Signedness;
import "encoding/utf" take ByteOrder;

// Local bounded receive advertisements, not received peer settings and not an
// H2 session. Zero table/window/stream cap is meaningful and permitted.
object Http2Settings {
    has header_table, initial_window, frame_size, streams is int;

    // A 4096-byte header table, a 65535-byte window, 16384-byte frames, 100
    // streams.
    Http2Settings() {
        header_table = 4096;
        initial_window = 65535;
        frame_size = 16384;
        streams = 100;
    }

    // The settings as given; InvalidHttp2Settings out of range.
    Http2Settings(header_table is int, initial_window is int, frame_size is int, streams is int) {
        confirm header_table >= 0
            && header_table <= 1048576
            && initial_window >= 0
            && initial_window <= 2147483647
            && frame_size >= 16384
            && frame_size <= 16777215
            && streams >= 0
            && streams <= 65535
            else throw InvalidHttp2Settings.invalid;
        self.header_table = header_table;
        self.initial_window = initial_window;
        self.frame_size = frame_size;
        self.streams = streams;
    }

    // The table size, initial window, frame size and stream count.
    cap Settings {
        header_table is int {
            header_table;
        }

        initial_window is int {
            initial_window;
        }

        frame_size is int {
            frame_size;
        }

        streams is int {
            streams;
        }
    }
}

// Internal wire collaborator; not a public frame/HPACK API.
object Http2SettingsWire {
    has origin is Http2Settings;
    has client is bool;

    // origin as sent by a client or a server.
    Http2SettingsWire(origin is Http2Settings, client is bool) {
        self.origin = origin;
        self.client = client;
    }

    // The SETTINGS frame.
    bytes() is @byte {
        let rows is @Http2Setting = if client {
            [
                Http2Setting(identifier: 1, value: origin::Settings::header_table),
                Http2Setting(identifier: 2, value: 0),
                Http2Setting(identifier: 3, value: origin::Settings::streams),
                Http2Setting(identifier: 4, value: origin::Settings::initial_window),
                Http2Setting(identifier: 5, value: origin::Settings::frame_size)
            ];
        }
        else {
            [
                Http2Setting(identifier: 1, value: origin::Settings::header_table),
                Http2Setting(identifier: 3, value: origin::Settings::streams),
                Http2Setting(identifier: 4, value: origin::Settings::initial_window),
                Http2Setting(identifier: 5, value: origin::Settings::frame_size)
            ];
        };
        let chunks is @@byte = rows.map() -> row {
            row.bytes();
        };
        (0..chunks.size() * 6).map() -> index {
            chunks[(index / 6).int()][index % 6];
        };
    }
}

hidden object Http2Setting {
    has identifier, value is int;

    Http2Setting(identifier is int, value is int) {
        self.identifier = identifier;
        self.value = value;
    }

    bytes() is @byte {
        let key = IntegerBytes(
            value: identifier,
            size: 2,
            signedness: Signedness.unsigned,
            order: ByteOrder.big
        ).bytes();
        let data = IntegerBytes(
            value: value,
            size: 4,
            signedness: Signedness.unsigned,
            order: ByteOrder.big
        ).bytes();
        (0..6).map() -> index {
            if index < 2 {
                key[index];
            }
            else {
                data[index - 2];
            }
        };
    }
}

// A setting out of range.
enum InvalidHttp2Settings is Error = (invalid);

test "zero stream/window/table caps remain explicit" {
    let settings = Http2Settings(header_table: 0, initial_window: 0, frame_size: 16384, streams: 0);
    test.ok(settings::Settings::streams == 0 && settings::Settings::initial_window == 0);
    test.ok(Http2SettingsWire(origin: settings, client: true).bytes().size() == 30);
}
