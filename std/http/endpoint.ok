module http/endpoint v1.0.0;

// Which addresses a client may connect to, checked after DNS and before the
// socket.
//
//     HttpClient();                                         // PublicEndpoints
//     HttpClient(endpoints: LoopbackEndpoints());           // tests, local servers
//     HttpClient(endpoints: ListedNetworks(IpNetwork(address: IpAddress("10.0.0.0"), prefix: 8)));
//     HttpClient(endpoints: AllEndpoints());
//
// PublicEndpoints keeps a client off loopback, private and other special
// addresses, which guards against requests aimed at the inside of a network
// (SSRF). A host that resolves only to refused addresses is EndpointDenied.

import "url/value" take ParsedUrl, UrlParts, UrlHostKind;
import "net/ip" take IpAddress, IpNetwork, IpProperty;
import "net/endpoint" take IpEndpoint, HostEndpoint;
import "net/dns" take Resolving;
import "collections/sequence" take Sequencing;

// The caller can inspect both the effective URL and the exact numeric candidate.
// This capability grants no DNS lookup, socket mutation or implicit redirect.
role EndpointAllowing {
    // Whether url may be reached at endpoint.
    allowed(url is UrlParts, endpoint is IpEndpoint) is bool;
}

// Every address.
object AllEndpoints does EndpointAllowing {
    // The policy.
    AllEndpoints();

    // true.
    allowed(url is UrlParts, endpoint is IpEndpoint) is bool {
        true;
    }
}

// Global addresses only: no loopback, private or special ranges.
object PublicEndpoints does EndpointAllowing {
    // The policy.
    PublicEndpoints();

    // Whether the address is global, not loopback and not private.
    allowed(url is UrlParts, endpoint is IpEndpoint) is bool {
        if endpoint::Parts::zone != "" {
            return false;
        }
        let properties = endpoint.address().properties();
        properties.membership(IpProperty.global)
            && !properties.membership(IpProperty.unspecified)
            && !properties.membership(IpProperty.loopback)
            && !properties.membership(IpProperty.link_local)
            && !properties.membership(IpProperty.private_network)
            && !properties.membership(IpProperty.multicast)
            && !properties.membership(IpProperty.reserved)
            && !properties.membership(IpProperty.documentation);
    }
}

// Only this machine: 127.0.0.0/8 and ::1. For local servers, tests and
// examples: HttpClient(endpoints: LoopbackEndpoints()).
object LoopbackEndpoints does EndpointAllowing {
    // The policy.
    LoopbackEndpoints();

    // Whether the address is a loopback one.
    allowed(url is UrlParts, endpoint is IpEndpoint) is bool {
        endpoint::Parts::zone == ""
            && endpoint.address().properties().membership(IpProperty.loopback);
    }
}

// Addresses in some networks.
object ListedNetworks does EndpointAllowing {
    has networks is @IpNetwork;

    // The networks.
    ListedNetworks(origins is Sequencing<IpNetwork>) {
        let count = origins.size();
        confirm count >= 0 && count <= 1024 else throw EndpointSelectionLimit.stage("networks");
        let snapshot is @IpNetwork = (0..count).map() -> index {
            origins.item(index);
        };
        networks = snapshot;
    }

    // The same, one argument per part: ListedNetworks(a, b).
    ListedNetworks(origins is ...IpNetwork) {
        let listed is @IpNetwork = origins...;
        let count = listed.size();
        confirm count >= 0 && count <= 1024 else throw EndpointSelectionLimit.stage("networks");
        let snapshot is @IpNetwork = (0..count).map() -> index {
            listed.item(index);
        };
        networks = snapshot;
    }

    // Whether the address is in one of the networks.
    allowed(url is UrlParts, endpoint is IpEndpoint) is bool {
        networks.reduce(false) -> permitted, network {
            permitted || network.membership(endpoint.address());
        };
    }
}

// A bounded resolution request, not a connection or a record of unchecked
// addresses. It validates route coordinates eagerly and filters every candidate
// at lazy startup, retaining exact numeric endpoints for the eventual connector.
object HttpEndpointSelection {
    has url is UrlParts;
    has port is int;
    has resolver is Resolving;
    has access is EndpointAllowing;

    // The endpoints of url, resolved by resolver and filtered by access;
    // InvalidHttpEndpoint for a URL a client cannot reach.
    HttpEndpointSelection(url is UrlParts, resolver is Resolving, access is EndpointAllowing) {
        let scheme = url::Parts::scheme;
        confirm scheme == "http" || scheme == "https"
            else throw InvalidHttpEndpoint.because("scheme");
        confirm url::Parts::host != Maybe<string>.none
            else throw InvalidHttpEndpoint.because("authority");
        confirm url::Parts::userinfo == Maybe<string>.none
            else throw InvalidHttpEndpoint.because("userinfo");
        let kind = url.host_kind();
        confirm kind == UrlHostKind.name || kind == UrlHostKind.address
            else throw InvalidHttpEndpoint.because("host");
        let number = url::Parts::port else if scheme == "https" {
            443;
        }
        else {
            80;
        };
        confirm number > 0 else throw InvalidHttpEndpoint.because("destination port");
        self.url = url;
        port = number;
        self.resolver = resolver;
        self.access = access;
    }

    // The URL.
    url() is UrlParts {
        url;
    }

    // The allowed addresses with the URL's port (at most 256); EndpointDenied
    // when none.
    async endpoints() is Sequencing<IpEndpoint> {
        let source is Sequencing<IpEndpoint> = if url.host_kind() == UrlHostKind.address {
            let direct is @IpEndpoint = [IpEndpoint(address: url.host_address(), port: port)];
            direct;
        }
        else {
            let pending = resolver.addresses(HostEndpoint(host: url.host_name(), port: port));
            await pending;
        };
        let count = source.size();
        confirm count >= 0 && count <= 256 else throw EndpointSelectionLimit.stage("addresses");
        let snapshot is @IpEndpoint = (0..count).map() -> index {
            let endpoint = source.item(index);
            confirm endpoint::Parts::port == port
                else throw InvalidHttpEndpoint.because("resolver port");
            endpoint;
        };
        let allowed is @IpEndpoint = snapshot.filter() -> endpoint {
            access.allowed(url, endpoint);
        };
        confirm allowed.size() > 0 else throw EndpointDenied.denied;
        allowed;
    }
}

// A URL a client cannot connect to; reason says why.
enum InvalidHttpEndpoint is Error = (because(reason is string));

// Every address of the host was refused.
enum EndpointDenied is Error = (denied);

// Too many addresses; stage says where.
enum EndpointSelectionLimit is Error = (stage(stage is string));

test "explicit empty network selection grants no endpoint" {
    let url = ParsedUrl("https://example.test/").parts();
    let endpoint = IpEndpoint(address: IpAddress("127.0.0.1"), port: 443);
    test.ok(AllEndpoints().allowed(url, endpoint));
    test.ok(!ListedNetworks().allowed(url, endpoint));
    test.ok(!PublicEndpoints().allowed(url, endpoint));
}

test "loopback endpoints allow this machine only" {
    let url = ParsedUrl("http://127.0.0.1:8080/").parts();
    let local = LoopbackEndpoints();
    test.is(local.allowed(url, IpEndpoint(address: IpAddress("127.0.0.1"), port: 8080)), true);
    test.is(local.allowed(url, IpEndpoint(address: IpAddress("127.5.0.9"), port: 8080)), true);
    test.is(local.allowed(url, IpEndpoint(address: IpAddress("::1"), port: 8080)), true);
    test.is(local.allowed(url, IpEndpoint(address: IpAddress("10.0.0.1"), port: 8080)), false);
    test.is(local.allowed(url, IpEndpoint(address: IpAddress("93.184.216.34"), port: 80)), false);
}
