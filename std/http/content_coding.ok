module http/content_coding v1.0.0;

// Content codings (RFC 9110 §8.4): the names in Content-Encoding and
// Accept-Encoding.
//
//     ContentCoding("GZip").string();          // "gzip"
//
// Names are case-insensitive and kept lowercase. This is only the name; the
// codecs are in http/body_coding.

import "http/token" take HttpToken, InvalidToken;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;

// A canonical coding identity, not a compressor and not an installed-codec
// observation. Wildcards belong to negotiation. No I/O or algorithm fallback.
object ContentCoding {
    has origin is string;

    // Checks origin as a token; `*` and anything else are InvalidContentCoding.
    ContentCoding(origin is string) {
        confirm origin != "*" else throw InvalidContentCoding.origin(origin);
        let checked = try {
            HttpToken(origin).string();
        }
        catch failure is InvalidToken {
            throw InvalidContentCoding.origin(origin);
        };
        let folded is @byte = Utf8Encoded(checked).bytes().map() -> octet {
            let code = octet.int();
            if code >= 65 && code <= 90 {
                (code + 32).byte();
            }
            else {
                octet;
            }
        };
        self.origin = Utf8Decoded(folded).string();
    }

    // The name, lowercase.
    string() is string {
        origin;
    }
}

// A name that is not a coding.
enum InvalidContentCoding is Error = (origin(origin is string));

test "coding identity is canonical without claiming codec support" {
    test.is(ContentCoding("GZip").string(), "gzip");
    test.ok(ContentCoding("X-Custom") == ContentCoding("x-custom"));
}
