module http/http1_continue v1.0.0;

// `Expect: 100-continue` on the client side: the head goes first, the body
// after a 100 or after a short wait.

import "http/message" take Request, InvalidHttpMessage;
import "http/http1_head" take Http1RequestHead, Http1ResponseHead, Http1Limits;
import "http/http1_framing" take Http1BodyPlan, Http1BodyKind;
import "http/http1_message_writing" take Http1RequestWriting;
import "http/http1_writing" take Http1RequestHeadWriting;
import "http/http1_reading" take Http1HeadRead;
import "http/http1_body_check" take Http1BodyCheck;
import "http/body" take BodyOpening;
import "http/header" take HeaderName, HttpAsciiLowercase;
import "http/version" take HttpVersion;
import "io/stream" take AsyncWriting;
import "async/scope" take FutureScope, Supervising;
import "async/timeout" take Before;
import "time/clock" take Timing, MonotonicInstant, SystemClock;
import "time/duration" take Duration, DurationUnit;

// The start of a request: its head, and its body unless it waits for 100.
object Http1RequestStart {
    has pending is Future<AsyncWriting>;
    has expectation is bool;

    // Writes request to origin as head and plan say, within limits.
    Http1RequestStart(
        origin is AsyncWriting,
        request is Request,
        head is Http1RequestHead,
        plan is Http1BodyPlan,
        limits is Http1Limits
    ) {
        let values = request::Head::headers.values(HeaderName("Expect"));
        let present = values.size() > 0;
        if present {
            confirm values.size() == 1
                && HttpAsciiLowercase(values.item(0)).string() == "100-continue"
                else throw InvalidHttpMessage.because("unsupported or ambiguous expectation");
            confirm request::Head::version == HttpVersion.http_1_1
                else throw InvalidHttpMessage.because("continue coordination requires HTTP1.1");
            confirm plan::Plan::kind == Http1BodyKind.chunked
                || (plan::Plan::kind == Http1BodyKind.fixed && plan.length().sign() > 0)
                else throw InvalidHttpMessage.because("100-continue requires request content");
            let sending = Http1ContinueHead(
                pending: Http1RequestHeadWriting(origin, head, limits).output(),
                body: request.body(),
                plan: plan,
                limits: limits
            );
            let scope is FutureScope<AsyncWriting, AsyncWriting> = FutureScope(
                action: sending.write
            );
            pending = scope.outcome();
        }
        else {
            pending = Http1RequestWriting(origin: origin, request: request, limits: limits).output();
        }
        expectation = present;
    }

    // Writes the head, and the body unless it waits; the future gives the
    // writer back when done.
    output() is Future<AsyncWriting> {
        pending;
    }

    // Whether the request expects 100-continue.
    expectation() is bool {
        expectation;
    }
}

hidden object Http1ContinueHead {
    has pending is Future<AsyncWriting>;
    has body is BodyOpening;
    has plan is Http1BodyPlan;
    has limits is Http1Limits;

    Http1ContinueHead(
        pending is Future<AsyncWriting>,
        body is BodyOpening,
        plan is Http1BodyPlan,
        limits is Http1Limits
    ) {
        self.pending = pending;
        self.body = body;
        self.plan = plan;
        self.limits = limits;
    }

    async write(group is Supervising<AsyncWriting>) is AsyncWriting {
        let known = Http1BodyCheck(body: body, plan: plan, limits: limits, request: true).known();
        confirm known.size() == 0 || known[0].sign() > 0
            else throw InvalidHttpMessage.because("100-continue requires request content");
        group.start(pending);
        await pending;
    }
}

// Where a 100-continue wait stands.
object Http1ContinueState {
    has active, sent is bool;
    has clock is Timing;
    has limit is Duration;
    has deadline is @MonotonicInstant;

    // A wait of up to limit, when active.
    Http1ContinueState(active is bool, clock is Timing, limit is Duration) {
        self.active = active;
        sent = !active;
        self.clock = clock;
        self.limit = limit;
        deadline = [];
    }

    // This state once the head is sent.
    begun() is ^Http1ContinueState {
        if active {
            ^deadline = [clock.monotonic_instant().plus(limit)];
        }
    }

    // Whether the body has gone.
    body_sent() is bool {
        sent;
    }

    // This state once the body has gone.
    sending_completed() is ^Http1ContinueState {
        ^sent = true;
    }

    // The response head, sending the body on 100 or when the wait ends.
    reading(origin is Future<Http1HeadRead<Http1ResponseHead>>) is Future<Http1HeadRead<Http1ResponseHead>> {
        if active && !sent {
            let bounded is Before<Http1HeadRead<Http1ResponseHead>> = Before(
                origin: origin,
                deadline: deadline[0],
                clock: clock
            );
            return bounded.outcome();
        }
        origin;
    }
}

test "ordinary request entry has no outstanding continue permission" {
    let state = Http1ContinueState(active: false, clock: SystemClock(), limit: Duration(seconds: 1));
    state = state.begun();
    test.ok(state.body_sent());
}
