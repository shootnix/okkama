module http/cookie v1.0.0;

// Cookies (RFC 6265bis): Set-Cookie on the way out, Cookie on the way in.
//
//     Response(status: Status.ok, headers: Headers(
//         SetCookie(name: "sid", value: token),
//         SetCookie(name: "theme", value: "dark", max_age: Duration(days: 30)),
//     ));
//     Headers(ExpiredCookie("sid"));                     // removes it
//
//     let cookies = RequestCookies(request);
//     cookies.text("sid");                               // MissingCookie when absent
//     cookies.maybe("theme").text() else "light";
//
// SetCookie(name, value) is safe by default: Path=/, Secure, HttpOnly and
// SameSite=Lax. Build a Cookie with CookieAttributes to say otherwise. A cookie
// without an expiry is a session cookie. Values are redacted in diagnostics.

import "time/clock" take Instant;
import "encoding/utf" take Utf8Encoded;
import "net/endpoint" take HostName, InvalidHostName;
import "http/token" take HttpToken, InvalidToken;
import "http/header" take HttpAsciiLowercase, Header, HeaderField, HeaderName, Headers;
import "http/message" take Request;
import "http/target" take OriginTarget;
import "strings/parse" take Number, InvalidInteger;
import "time/duration" take Duration;
import "http/date" take HttpDate, InvalidHttpDate;
import "collections/set" take Set, OrderedSet;
import "collections/iteration" take Cursor;
import "collections/sequence" take Sequencing;

// When a cookie expires: an instant, or none for a session cookie.
object CookieExpiry {
    has origin is @Instant;

    // A session cookie: no expiry.
    CookieExpiry() {
        origin = [];
    }

    // Expires at origin.
    CookieExpiry(origin is Instant) {
        self.origin = [origin];
    }

    // Whether it has an instant.
    persistent() is bool {
        origin.size() == 1;
    }

    // The instant; MissingCookieExpiry for a session cookie.
    instant() is Instant {
        confirm self.persistent() else throw MissingCookieExpiry.missing;
        origin[0];
    }
}

// A session cookie has no expiry instant.
enum MissingCookieExpiry is Error = (missing);

// Secure, HttpOnly and Partitioned.
enum CookieFlag = (secure, http_only, partitioned);

// The SameSite attribute; cross_site is written `None`, unspecified is left
// out.
enum SameSite = (unspecified, strict, lax, cross_site);

// Names retain case; the prefix checks follow the case-insensitive consumer
// policy of RFC 6265bis draft-22. cross_site renders the wire token None because
// none is the language's null literal. A constructor snapshots role flags before
// retaining them, and explicit string() rendering is the only payload diagnostic.
object CookieAttributes {
    has domain, path is string;
    has expiry is CookieExpiry;
    has same_site is SameSite;
    has secure, http_only, partitioned is bool;

    // No attributes at all: no domain, no path, a session cookie, no SameSite,
    // no flags.
    CookieAttributes() {
        domain = "";
        path = "";
        expiry = CookieExpiry();
        same_site = SameSite.unspecified;
        secure = false;
        http_only = false;
        partitioned = false;
    }

    // The attributes as given.
    CookieAttributes(
        domain is string,
        path is string,
        expiry is CookieExpiry,
        same_site is SameSite,
        flags is Set<CookieFlag>
    ) {
        confirm domain.length() <= 1024 && path.length() <= 4096
            else throw InvalidCookie.because("attribute source limit exceeded");
        let canonical = if domain == "" {
            "";
        }
        else {
            let name = if domain.slice(0, 1) == "." {
                domain.slice(1, domain.length());
            }
            else {
                domain;
            };
            let host = try {
                HostName(name).ascii();
            }
            catch failure is InvalidHostName {
                throw InvalidCookie.because("invalid cookie domain");
            };
            confirm host.slice(host.length() - 1, host.length()) != "."
                else throw InvalidCookie.because("cookie domain cannot end with a dot");
            host;
        };
        confirm path == "" || path.slice(0, 1) == "/"
            else throw InvalidCookie.because("cookie path must be absolute or omitted");
        confirm CookieAttributeOctets(path).valid()
            else throw InvalidCookie.because("invalid cookie path octets");
        let checked = CookieFlagSnapshot(flags).flags();
        confirm same_site != SameSite.cross_site || checked.secure()
            else throw InvalidCookie.because("SameSite=None requires Secure");
        confirm !checked.partitioned() || checked.secure()
            else throw InvalidCookie.because("Partitioned requires Secure");
        self.domain = canonical;
        self.path = path;
        self.expiry = expiry;
        self.same_site = same_site;
        secure = checked.secure();
        http_only = checked.http_only();
        partitioned = checked.partitioned();
    }

    // When it expires.
    expiry() is CookieExpiry {
        expiry;
    }

    // Its flags.
    flags() is Set<CookieFlag> {
        let all = [CookieFlag.secure, CookieFlag.http_only, CookieFlag.partitioned];
        let selected is @CookieFlag = all.filter() -> flag {
            match flag {
                case CookieFlag.secure {
                    secure;
                }
                case CookieFlag.http_only {
                    http_only;
                }
                case CookieFlag.partitioned {
                    partitioned;
                }
                else {
                    false;
                }
            }
        };
        OrderedSet(selected);
    }

    // The attributes as Set-Cookie writes them, each after `; `.
    string() is string {
        let date = if expiry.persistent() {
            let wire = try {
                HttpDate(expiry.instant()).string();
            }
            catch failure is InvalidHttpDate {
                throw InvalidCookie.because("expiry is outside HTTP date range");
            };
            "; Expires=" + wire;
        }
        else {
            "";
        };
        let site = match same_site {
            case SameSite.strict {
                "; SameSite=Strict";
            }
            case SameSite.lax {
                "; SameSite=Lax";
            }
            case SameSite.cross_site {
                "; SameSite=None";
            }
            else {
                "";
            }
        };
        (if domain == "" {
            "";
        }
        else {
            "; Domain=" + domain;
        }) + (if path == "" {
            "";
        }
        else {
            "; Path=" + path;
        }) + date + site +
            (if secure {
                "; Secure";
            }
            else {
                "";
            }) + (if http_only {
                "; HttpOnly";
            }
            else {
                "";
            }) + (if partitioned {
                "; Partitioned";
            }
            else {
                "";
            });
    }

    // The Domain, the Path and SameSite.
    cap Attributes {
        domain is string {
            domain;
        }

        path is string {
            path;
        }

        same_site is SameSite {
            same_site;
        }
    }
}

// A cookie: a name, a value and attributes.
object Cookie {
    has name, value is string;
    has attributes is CookieAttributes;

    // The cookie; InvalidCookie for a name or value Set-Cookie cannot carry.
    Cookie(name is string, value is string, attributes is CookieAttributes) {
        confirm name.length() + value.length() <= 4096
            else throw InvalidCookie.because("cookie pair source limit exceeded");
        confirm name != "" || value != "" else throw InvalidCookie.because("empty cookie pair");
        if name != "" {
            try {
                HttpToken(name);
            }
            catch failure is InvalidToken {
                throw InvalidCookie.because("cookie name token required");
            }
        }
        confirm CookieValueWire(value).valid()
            else throw InvalidCookie.because("invalid cookie value octets");
        let candidate = HttpAsciiLowercase(if name == "" {
            value;
        }
        else {
            name;
        }).string();
        let flags = attributes.flags();
        if candidate.length() >= 9 && candidate.slice(0, 9) == "__secure-" {
            confirm flags.membership(CookieFlag.secure)
                else throw InvalidCookie.because("secure cookie prefix requires Secure");
        }
        if candidate.length() >= 7 && candidate.slice(0, 7) == "__host-" {
            confirm flags.membership(CookieFlag.secure)
                && attributes::Attributes::domain == ""
                && attributes::Attributes::path == "/"
                else throw InvalidCookie.because(
                    "host cookie prefix requires Secure, omitted Domain and explicit Path=/"
                );
        }
        self.name = name;
        self.value = value;
        self.attributes = attributes;
    }

    // Its name.
    name() is string {
        name;
    }

    // Its value.
    value() is string {
        value;
    }

    // Its attributes.
    attributes() is CookieAttributes {
        attributes;
    }

    // `name=value`, as a Cookie field sends it.
    pair() is string {
        if name == "" {
            value;
        }
        else {
            name + "=" + value;
        }
    }

    // The Set-Cookie value: the pair and the attributes.
    string() is string {
        self.pair() + attributes.string();
    }

    // `cookie name=<redacted>`, for logs.
    diagnostic() is string {
        "cookie " + name + "=<redacted>";
    }
}

hidden object CookieValueOctets {
    has origin is string;

    CookieValueOctets(origin is string) {
        self.origin = origin;
    }

    valid() is bool {
        Utf8Encoded(origin).bytes().reduce(true) -> valid, octet {
            let code = octet.int();
            valid
                && (code == 33
                || (code >= 35 && code <= 43)
                || (code >= 45 && code <= 58)
                || (code >= 60 && code <= 91)
                || (code >= 93 && code <= 126));
        };
    }
}

hidden object CookieValueWire {
    has origin is string;

    CookieValueWire(origin is string) {
        self.origin = origin;
    }

    valid() is bool {
        if origin.length() >= 2
            && origin.slice(0, 1) == "\""
            && origin.slice(origin.length() - 1, origin.length()) == "\"" {
                return CookieValueOctets(origin.slice(1, origin.length() - 1)).valid();
            }
        CookieValueOctets(origin).valid();
    }
}

hidden object CookieAttributeOctets {
    has origin is string;

    CookieAttributeOctets(origin is string) {
        self.origin = origin;
    }

    valid() is bool {
        Utf8Encoded(origin).bytes().reduce(true) -> valid, octet {
            let code = octet.int();
            valid && code >= 32 && code <= 126 && code != 59;
        };
    }
}

hidden object CookieFlagSnapshot {
    has origin is Set<CookieFlag>;

    CookieFlagSnapshot(origin is Set<CookieFlag>) {
        self.origin = origin;
    }

    flags() is CookieFlagValues {
        let count = origin.size();
        confirm count >= 0 && count <= 3
            else throw InvalidCookie.because("cookie flag count must be 0..3");
        let state = CookieFlagReading(origin.cursor());
        for (0..count) -> index {
            state = state.following();
        }
        state.flags();
    }
}

hidden object CookieFlagReading {
    has cursor is Cursor<CookieFlag>;
    has values is CookieFlagValues;

    CookieFlagReading(cursor is Cursor<CookieFlag>) {
        self.cursor = cursor;
        values = CookieFlagValues();
    }

    following() is ^CookieFlagReading {
        confirm cursor.available()
            else throw InvalidCookie.because("cookie flag cursor ended early");
        ^values = values.following(cursor.item());
        ^cursor = cursor.successor();
    }

    flags() is CookieFlagValues {
        confirm !cursor.available()
            else throw InvalidCookie.because("cookie flag cursor exceeds declared size");
        values;
    }
}

hidden object CookieFlagValues {
    has secure, http_only, partitioned is bool;

    CookieFlagValues() {
        secure = false;
        http_only = false;
        partitioned = false;
    }

    following(flag is CookieFlag) is ^CookieFlagValues {
        match flag {
            case CookieFlag.secure {
                confirm !secure else throw InvalidCookie.because("duplicate cookie flag");
                ^secure = true;
            }
            case CookieFlag.http_only {
                confirm !http_only else throw InvalidCookie.because("duplicate cookie flag");
                ^http_only = true;
            }
            case CookieFlag.partitioned {
                confirm !partitioned else throw InvalidCookie.because("duplicate cookie flag");
                ^partitioned = true;
            }
            else {
                throw InvalidCookie.because("unknown cookie flag");
            }
        }
    }

    secure() is bool {
        secure;
    }

    http_only() is bool {
        http_only;
    }

    partitioned() is bool {
        partitioned;
    }
}

// A Set-Cookie field of a response, with safe defaults: Path=/, Secure,
// HttpOnly and SameSite=Lax, and Max-Age when it is given (#207):
//
//     Headers(SetCookie(name: "sid", value: token),
//         SetCookie(name: "theme", value: "dark", max_age: Duration(days: 30)))
//
// SetCookie(cookie) sends a Cookie with exactly its own attributes.
object SetCookie does HeaderField {
    has cookie is Cookie;
    has seconds is @int;

    // A session cookie with Path=/, Secure, HttpOnly and SameSite=Lax.
    SetCookie(name is string, value is string) {
        cookie = Cookie(name: name, value: value, attributes: SafeCookieAttributes().attributes());
        seconds = [];
    }

    // The same, kept for max_age (whole seconds); InvalidCookie when negative.
    SetCookie(name is string, value is string, max_age is Duration) {
        let whole = max_age::Span::seconds.int();
        confirm whole >= 0 else throw InvalidCookie.because("Max-Age cannot be negative");
        cookie = Cookie(name: name, value: value, attributes: SafeCookieAttributes().attributes());
        seconds = [whole];
    }

    // cookie as it is.
    SetCookie(cookie is Cookie) {
        self.cookie = cookie;
        seconds = [];
    }

    // The Set-Cookie field.
    header() is Header {
        let age = if seconds.size() == 1 {
            "; Max-Age=" + seconds[0].string();
        }
        else {
            "";
        };
        Header(name: "Set-Cookie", value: cookie.string() + age);
    }
}

// The Set-Cookie field that removes a cookie set with the defaults of
// SetCookie: an empty value at Path=/ with Max-Age=0.
object ExpiredCookie does HeaderField {
    has cookie is Cookie;

    // Removes the cookie name; InvalidCookie for an empty name.
    ExpiredCookie(name is string) {
        confirm name != "" else throw InvalidCookie.because("an expired cookie needs its name");
        cookie = Cookie(name: name, value: "", attributes: SafeCookieAttributes().attributes());
    }

    // The Set-Cookie field.
    header() is Header {
        Header(name: "Set-Cookie", value: cookie.string() + "; Max-Age=0");
    }
}

hidden object SafeCookieAttributes {
    SafeCookieAttributes();

    attributes() is CookieAttributes {
        let flags is Set<CookieFlag> = OrderedSet([CookieFlag.secure, CookieFlag.http_only]);
        CookieAttributes(
            domain: "",
            path: "/",
            expiry: CookieExpiry(),
            same_site: SameSite.lax,
            flags: flags
        );
    }
}

// The cookies a client sent in its Cookie fields, read by name on the server
// (#206): name=value pairs separated by semicolons (RFC 6265 5.4). A value in
// double quotes loses them; a pair without "=" is skipped; with one name twice,
// text() takes the first, as browsers send the more specific cookie first.
//
//     let cookies = RequestCookies(request);
//     let session = cookies.text("sid");
//     let theme = cookies.maybe("theme").text() else "light";
object RequestCookies {
    has request is Request;

    // The cookies request sent.
    RequestCookies(request is Request) {
        self.request = request;
    }

    // The value of a cookie; MissingCookie when the request has none.
    text(name is string) is string {
        let found = self.list(name);
        confirm found.size() > 0 else throw MissingCookie.name(name);
        found[0];
    }

    // A cookie read as a decimal integer; InvalidCookie when it is not one.
    int(name is string) is int {
        CookieInteger(name: name, value: self.text(name)).int();
    }

    // Every value sent under the name, in order; [] when there is none.
    list(name is string) is @string {
        let pairs = self.pairs();
        let names is @int = (0..pairs.size()).filter() -> index {
            index % 2 == 0 && pairs[index] == name;
        };
        let found is @string = names.map() -> index {
            pairs[index + 1];
        };
        found;
    }

    // A cookie that may be absent: cookies.maybe("theme").text() else "light".
    maybe(name is string) is CookieMaybeReader {
        let found = self.list(name);
        let first = if found.size() > 0 {
            Maybe.some(found[0]);
        }
        else {
            Maybe<string>.none;
        };
        CookieMaybeReader(name: name, value: first);
    }

    // Names and values in turn, parsed once.
    hidden pairs() is @string {
        once let parsed = CookieFieldPairs(request::Head::headers.values(HeaderName("Cookie"))).pairs();
        parsed;
    }
}

// A cookie that may be absent, as RequestCookies.maybe(name) gives it.
object CookieMaybeReader {
    has name is string;
    has value is Maybe<string>;

    // Made by RequestCookies.maybe(name); not constructed directly.
    CookieMaybeReader(name is string, value is Maybe<string>) {
        self.name = name;
        self.value = value;
    }

    // The value, or none.
    text() is Maybe<string> {
        value;
    }

    // The value as a decimal integer, or none; InvalidCookie for another form.
    int() is Maybe<int> {
        match value {
            case Maybe.some(text) {
                Maybe.some(CookieInteger(name: name, value: text).int());
            }
            else {
                Maybe<int>.none;
            }
        };
    }
}

hidden object CookieInteger {
    has name is string;
    has value is string;

    CookieInteger(name is string, value is string) {
        self.name = name;
        self.value = value;
    }

    int() is int {
        try {
            Number(value).int();
        }
        catch failure is InvalidInteger {
            throw InvalidCookie.because("cookie " + name + " must be a decimal integer");
        };
    }
}

// The name=value pairs of Cookie field values, flattened as name, value,
// name, value.
hidden object CookieFieldPairs {
    has values is Sequencing<string>;

    CookieFieldPairs(values is Sequencing<string>) {
        self.values = values;
    }

    pairs() is @string {
        let lines is @string = (0..values.size()).map() -> index {
            values.item(index);
        };
        let empty is @string = [];
        lines.join(";").split(";").reduce(empty) -> kept, piece {
            let at = piece.find("=");
            match at {
                case Maybe.some(position) {
                    let name = piece.slice(0, position).trim();
                    let raw = piece.slice(position + 1, piece.length()).trim();
                    let quoted = raw.length() >= 2 && raw.starts_with("\"") && raw.ends_with("\"");
                    let value = if quoted {
                        raw.slice(1, raw.length() - 1);
                    }
                    else {
                        raw;
                    };
                    if name == "" {
                        kept;
                    }
                    else {
                        kept + [name, value];
                    }
                }
                else {
                    kept;
                }
            };
        };
    }
}

// The request sent no cookie of that name.
enum MissingCookie is Error = (name(name is string));

// A cookie that cannot be written or read; reason says why.
enum InvalidCookie is Error = (because(reason is string));

test "session expiry has no absolute instant" {
    test.ok(!CookieExpiry().persistent());
    test.ok(try {
        CookieExpiry().instant();
        false;
    }
    catch e is MissingCookieExpiry {
        true;
    });
}

test "cookie prefix and wire policy" {
    let attrs = CookieAttributes(
        domain: "",
        path: "/",
        expiry: CookieExpiry(),
        same_site: SameSite.cross_site,
        flags: OrderedSet([CookieFlag.secure])
    );
    test.ok(
        Cookie(name: "__Host-id", value: "secret", attributes: attrs).string() == "__Host-id=secret; Path=/; SameSite=None; Secure"
    );
    test.ok(
        Cookie(name: "id", value: "secret", attributes: CookieAttributes()).diagnostic() == "cookie id=<redacted>"
    );
    test.ok(try {
        Cookie(name: "__secure-id", value: "secret", attributes: CookieAttributes());
        false;
    }
    catch e is InvalidCookie {
        true;
    });
}

test "set-cookie fields carry safe defaults, Max-Age and expiry" {
    test.is(
        SetCookie(name: "sid", value: "abc").header().value(),
        "sid=abc; Path=/; SameSite=Lax; Secure; HttpOnly"
    );
    test.is(
        SetCookie(name: "theme", value: "dark", max_age: Duration(days: 30)).header().value(),
        "theme=dark; Path=/; SameSite=Lax; Secure; HttpOnly; Max-Age=2592000"
    );
    test.is(
        ExpiredCookie("sid").header().value(),
        "sid=; Path=/; SameSite=Lax; Secure; HttpOnly; Max-Age=0"
    );
    test.is(SetCookie(name: "sid", value: "abc").header().name().string(), "Set-Cookie");
    test.throws(InvalidCookie) {
        SetCookie(name: "bad name", value: "x");
    };
}

test "request cookies are read by name" {
    let request = Request(
        target: OriginTarget(path: "/", query: Maybe<string>.none),
        headers: Headers(
            Header(name: "Cookie", value: "sid=abc123; theme=\"dark\"; flag; count=7"),
            Header(name: "cookie", value: "sid=older; =nameless"),
        )
    );
    let cookies = RequestCookies(request);
    test.is(cookies.text("sid"), "abc123");
    test.is(cookies.list("sid").join(","), "abc123,older");
    test.is(cookies.text("theme"), "dark");
    test.is(cookies.int("count"), 7);
    test.is(cookies.maybe("lang").text() else "en", "en");
    test.is(cookies.maybe("count").int() else 0, 7);
    test.is(cookies.list("flag").size(), 0);
    test.throws(MissingCookie) {
        cookies.text("lang");
    };
    test.throws(InvalidCookie) {
        cookies.int("theme");
    };
    let bare = RequestCookies(Request(target: OriginTarget(path: "/", query: Maybe<string>.none)));
    test.is(bare.list("sid").size(), 0);
}
