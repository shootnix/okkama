module http/internal/http2_flow v1.0.0;

// HTTP/2 flow control (RFC 9113 §5.2): window accounting for the connection and
// each stream, DATA payloads and WINDOW_UPDATE frames.
//
// Internal to the http modules; programs do not import it.

import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2FrameRules, Http2Fault,
    Http2FaultScope;
import "encoding/binary" take IntegerBytes, Binary, Signedness;
import "encoding/utf" take ByteOrder;

// Pure window accounting, not an async scheduler. Connection owns the two
// directional window sets and publishes immutable successors under its reader.
object Http2FlowWindow {
    has scope is Http2FaultScope;
    has stream, remaining is int;

    // The window of stream (0 for the connection) with remaining bytes.
    Http2FlowWindow(scope is Http2FaultScope, stream is int, remaining is int) {
        confirm remaining >= -2147483647
            && remaining <= 2147483647
            && stream >= 0
            && stream <= 2147483647
            && ((scope == Http2FaultScope.connection && stream == 0)
            || (scope == Http2FaultScope.stream && stream > 0))
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "invalid flow window coordinates"
            );
        self.scope = scope;
        self.stream = stream;
        self.remaining = remaining;
    }

    // Connection or stream.
    scope() is Http2FaultScope {
        scope;
    }

    // The stream.
    stream() is int {
        stream;
    }

    // The window, which may be negative after a settings change.
    remaining() is int {
        remaining;
    }

    // The window, or 0 when negative.
    available() is int {
        if remaining < 0 {
            0;
        }
        else {
            remaining;
        }
    }

    // This window after sending length bytes; Http2NoCredit beyond it.
    sent(length is int) is ^Http2FlowWindow {
        Http2FlowDebit(length);
        // Caller decides when an empty terminal DATA frame is legal; zero
        // consumes no credit even if a SETTINGS reduction made it negative.
        confirm length == 0 || length <= remaining else throw Http2NoCredit.stream(stream);
        ^remaining = remaining - length;
    }

    // This window after receiving length bytes; Http2Fault beyond it.
    received(length is int) is ^Http2FlowWindow {
        Http2FlowDebit(length);
        confirm length == 0 || length <= remaining
            else throw Http2Fault.detailed(scope, 3, stream, "peer exceeded flow window");
        ^remaining = remaining - length;
    }

    // This window after a WINDOW_UPDATE of increment; Http2Fault for 0 or an
    // overflow.
    credited(increment is int) is ^Http2FlowWindow {
        confirm increment > 0 && increment <= 2147483647
            else throw Http2Fault.detailed(scope, 1, stream, "invalid window increment");
        confirm increment <= 2147483647 - remaining
            else throw Http2Fault.detailed(scope, 3, stream, "flow window overflow");
        ^remaining = remaining + increment;
    }

    // This stream window after a change of the initial window by delta.
    adjusted(delta is int) is ^Http2FlowWindow {
        confirm scope == Http2FaultScope.stream
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "initial setting cannot change connection window"
            );
        confirm delta >= -2147483647
            && delta <= 2147483647
            && remaining + delta >= -2147483647
            && remaining + delta <= 2147483647
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                3,
                0,
                "settings flow window overflow"
            );
        ^remaining = remaining + delta;
    }
}

hidden object Http2FlowDebit {
    Http2FlowDebit(length is int) {
        confirm length >= 0 && length <= 2147483647
            else throw Http2Fault.detailed(Http2FaultScope.connection, 1, 0, "invalid flow debit");
    }
}

// Sender reservation is atomic data publication under the owning scheduler.
// Receiving deliberately has no all-or-nothing pair: valid connection charge
// must survive a stream error until the discarded bytes are credited back.
object Http2SendCredit {
    has connection, stream is Http2FlowWindow;

    // The connection's window and the stream's.
    Http2SendCredit(connection is Http2FlowWindow, stream is Http2FlowWindow) {
        confirm connection.scope() == Http2FaultScope.connection
            && stream.scope() == Http2FaultScope.stream
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "invalid send window pair"
            );
        self.connection = connection;
        self.stream = stream;
    }

    // The connection window.
    connection() is Http2FlowWindow {
        connection;
    }

    // The stream window.
    stream() is Http2FlowWindow {
        stream;
    }

    // How many bytes may be sent now.
    available() is int {
        let first = connection.available();
        let second = stream.available();
        if first < second {
            first;
        }
        else {
            second;
        }
    }

    // This credit after sending length bytes.
    spent(length is int) is ^Http2SendCredit {
        Http2FlowDebit(length);
        confirm length == 0 || length <= self.available()
            else throw Http2NoCredit.stream(stream.stream());
        ^connection = connection.sent(length);
        ^stream = stream.sent(length);
    }
}

// A send went beyond the window.
enum Http2NoCredit is Error = (stream(stream is int));

// A received DATA frame.
object Http2DataPayload {
    has frame is Http2Frame;

    // Reads frame; Http2Fault when it is not valid DATA.
    Http2DataPayload(frame is Http2Frame) {
        confirm frame.header().kind().int() == 0
            else throw Http2Fault.detailed(Http2FaultScope.connection, 1, 0, "DATA required");
        Http2FrameRules(frame).check();
        self.frame = frame;
    }

    // The stream.
    stream() is int {
        frame.header().stream();
    }

    // The bytes it counts against the window, padding included.
    flow_bytes() is int {
        frame.header().length();
    }

    // Whether it ends the stream.
    end_stream() is bool {
        (frame.header().flags().int() & 1) != 0;
    }

    // The data, without padding.
    bytes() is @byte {
        let payload = frame.payload();
        let padded = (frame.header().flags().int() & 8) != 0;
        if padded {
            payload.slice(1, payload.size() - payload[0].int());
        }
        else {
            payload;
        }
    }
}

// A received WINDOW_UPDATE.
object Http2WindowIncrement {
    has stream, amount is int;

    // Reads frame; Http2Fault when it is not a valid WINDOW_UPDATE.
    Http2WindowIncrement(frame is Http2Frame) {
        confirm frame.header().kind().int() == 8
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "WINDOW_UPDATE required"
            );
        Http2FrameRules(frame).check();
        stream = frame.header().stream();
        amount = Binary(bytes: frame.payload(), order: ByteOrder.big).int(Signedness.unsigned) & 2147483647;
    }

    // The stream, 0 for the connection.
    stream() is int {
        stream;
    }

    // The increment.
    amount() is int {
        amount;
    }
}

// A WINDOW_UPDATE to send.
object Http2WindowFrame {
    has stream, amount is int;

    // amount for stream (0 for the connection).
    Http2WindowFrame(stream is int, amount is int) {
        confirm stream >= 0 && stream <= 2147483647 && amount > 0 && amount <= 2147483647
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "invalid outgoing window increment"
            );
        self.stream = stream;
        self.amount = amount;
    }

    // The frame.
    frame() is Http2Frame {
        Http2Frame(
            header: Http2FrameHeader(8.byte(), 0.byte(), stream, 4),
            payload: IntegerBytes(
                value: amount,
                size: 4,
                signedness: Signedness.unsigned,
                order: ByteOrder.big
            ).bytes()
        );
    }
}

test "send reservation needs both flow windows" {
    let credit = Http2SendCredit(
        connection: Http2FlowWindow(Http2FaultScope.connection, 0, 10),
        stream: Http2FlowWindow(Http2FaultScope.stream, 1, 3)
    );
    credit = credit.spent(3);
    test.is(credit.connection().remaining(), 7);
    test.is(credit.stream().remaining(), 0);
}
