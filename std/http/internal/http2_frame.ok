module http/internal/http2_frame v1.0.0;

// HTTP/2 frames (RFC 9113 §4): the 9-byte header, the payload, the rules every
// frame must follow, and the faults that end a stream or a connection.
//
// Internal to the http modules; programs do not import it.

import "encoding/binary" take IntegerBytes, Binary, Signedness;
import "encoding/utf" take ByteOrder;
import "http/internal/wire_bytes" take HttpWireBytes;

// Internal wire values; these do not publish a session or stable public frame API.
enum Http2FaultScope = (connection, stream);

// A protocol fault: its scope, the error code to send, the stream and why.
enum Http2Fault is Error = (detailed(
    scope is Http2FaultScope,
    code is int,
    stream is int,
    reason is string
));

// The fields of a fault, for code that routes or reports it.
object Http2FaultView {
    has fault is Http2Fault;

    // The fields of fault.
    Http2FaultView(fault is Http2Fault) {
        self.fault = fault;
    }

    // Stream or connection.
    scope() is Http2FaultScope {
        match fault {
            case Http2Fault.detailed(scope, _, _, _) {
                scope;
            }
        }
    }

    // The HTTP/2 error code.
    code() is int {
        match fault {
            case Http2Fault.detailed(_, code, _, _) {
                code;
            }
        }
    }

    // The stream, 0 for the connection.
    stream() is int {
        match fault {
            case Http2Fault.detailed(_, _, stream, _) {
                stream;
            }
        }
    }

    // Why.
    reason() is string {
        match fault {
            case Http2Fault.detailed(_, _, _, reason) {
                reason;
            }
        }
    }
}

// The header of a frame: type, flags, stream and payload length.
object Http2FrameHeader {
    has kind, flags is byte;
    has stream, length is int;

    // As given; Http2Fault for a stream or length out of range.
    Http2FrameHeader(kind is byte, flags is byte, stream is int, length is int) {
        confirm stream >= 0 && stream <= 2147483647 && length >= 0 && length <= 16777215
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "invalid frame coordinates"
            );
        self.kind = kind;
        self.flags = flags;
        self.stream = stream;
        self.length = length;
    }

    // The frame type.
    kind() is byte {
        kind;
    }

    // The flags.
    flags() is byte {
        flags;
    }

    // The stream identifier.
    stream() is int {
        stream;
    }

    // The payload length.
    length() is int {
        length;
    }

    // The 9 bytes.
    bytes() is @byte {
        let size = IntegerBytes(
            value: length,
            size: 3,
            signedness: Signedness.unsigned,
            order: ByteOrder.big
        ).bytes();
        let id = IntegerBytes(
            value: stream,
            size: 4,
            signedness: Signedness.unsigned,
            order: ByteOrder.big
        ).bytes();
        [size[0], size[1], size[2], kind, flags, id[0], id[1], id[2], id[3]];
    }
}

// A frame header read from 9 bytes.
object ParsedHttp2FrameHeader {
    has origin is @byte;
    has maximum is int;

    // Reads origin with payloads up to 16384 bytes.
    ParsedHttp2FrameHeader(origin is @byte) {
        self.origin = origin;
        maximum = 16384;
    }

    // Reads origin with payloads up to maximum bytes.
    ParsedHttp2FrameHeader(origin is @byte, maximum is int) {
        confirm maximum >= 16384 && maximum <= 16777215
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "invalid receive frame limit"
            );
        self.origin = origin;
        self.maximum = maximum;
    }

    // The header; Http2Fault for a payload over the maximum.
    header() is Http2FrameHeader {
        confirm origin.size() == 9
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                6,
                0,
                "exact frame header required"
            );
        let length = Binary(bytes: origin.slice(0, 3), order: ByteOrder.big).int(
            Signedness.unsigned
        );
        confirm length <= maximum
            else throw Http2Fault.detailed(Http2FaultScope.connection, 6, 0, "receive frame limit");
        let stream = Binary(bytes: origin.slice(5, 9), order: ByteOrder.big).int(
            Signedness.unsigned
        ) & 2147483647;
        Http2FrameHeader(kind: origin[3], flags: origin[4], stream: stream, length: length);
    }
}

// A whole frame: header and payload.
object Http2Frame {
    has header is Http2FrameHeader;
    has payload is @byte;

    // header with payload; their lengths must agree.
    Http2Frame(header is Http2FrameHeader, payload is @byte) {
        confirm payload.size() == header.length()
            else throw Http2Fault.detailed(Http2FaultScope.connection, 6, 0, "frame payload length");
        self.header = header;
        self.payload = payload;
    }

    // The header.
    header() is Http2FrameHeader {
        header;
    }

    // The payload.
    payload() is @byte {
        payload;
    }

    // The frame's bytes.
    bytes() is @byte {
        HttpWireBytes(chunks: [header.bytes(), payload], maximum: 9 + payload.size()).bytes();
    }
}

// The rules a frame header must follow by type.
object Http2HeaderRules {
    has origin is Http2FrameHeader;

    // The rules for origin.
    Http2HeaderRules(origin is Http2FrameHeader) {
        self.origin = origin;
    }

    // Throws Http2Fault for a frame on the wrong stream, a fixed-size frame of
    // another length, or a push.
    check() is void {
        let kind = origin.kind().int();
        let stream = origin.stream();
        let flags = origin.flags().int();
        let length = origin.length();
        if kind == 0 || kind == 1 || kind == 2 || kind == 3 || kind == 9 {
            confirm stream > 0
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    1,
                    0,
                    "stream frame on stream zero"
                );
        }
        if kind == 4 || kind == 6 || kind == 7 {
            confirm stream == 0
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    1,
                    0,
                    "connection frame on a stream"
                );
        }
        if kind == 5 {
            throw Http2Fault.detailed(Http2FaultScope.connection, 1, 0, "server push disabled");
        }
        if kind == 2 {
            confirm length == 5
                else throw Http2Fault.detailed(Http2FaultScope.stream, 6, stream, "priority length");
        }
        if kind == 3 || kind == 8 {
            confirm length == 4
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    6,
                    0,
                    "fixed frame length"
                );
        }
        if kind == 6 {
            confirm length == 8
                else throw Http2Fault.detailed(Http2FaultScope.connection, 6, 0, "ping length");
        }
        if kind == 7 {
            confirm length >= 8
                else throw Http2Fault.detailed(Http2FaultScope.connection, 6, 0, "goaway length");
        }
        if kind == 4 {
            confirm length % 6 == 0 && ((flags & 1) == 0 || length == 0)
                else throw Http2Fault.detailed(Http2FaultScope.connection, 6, 0, "settings length");
        }
        if (kind == 0 || kind == 1) && (flags & 8) != 0 {
            confirm length > 0
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    1,
                    0,
                    "missing padding length"
                );
        }
        if kind == 1 && (flags & 32) != 0 {
            let minimum = if (flags & 8) != 0 {
                6;
            }
            else {
                5;
            };
            confirm length >= minimum
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    6,
                    0,
                    "headers priority length"
                );
        }
    }
}

// The rules a whole frame must follow.
object Http2FrameRules {
    has origin is Http2Frame;

    // The rules for origin.
    Http2FrameRules(origin is Http2Frame) {
        self.origin = origin;
    }

    // Throws Http2Fault for a frame that breaks them.
    check() is void {
        let header = origin.header();
        Http2HeaderRules(header).check();
        let kind = header.kind().int();
        let stream = header.stream();
        let flags = header.flags().int();
        let data = origin.payload();
        let length = data.size();
        if kind == 8 {
            let increment = Binary(bytes: data, order: ByteOrder.big).int(Signedness.unsigned) & 2147483647;
            let scope = if stream == 0 {
                Http2FaultScope.connection;
            }
            else {
                Http2FaultScope.stream;
            };
            confirm increment > 0
                else throw Http2Fault.detailed(scope, 1, stream, "zero window increment");
        }
        if kind == 0 || kind == 1 {
            let padded = (flags & 8) != 0;
            if padded {
                confirm length > 0 && data[0].int() < length
                    else throw Http2Fault.detailed(
                        Http2FaultScope.connection,
                        1,
                        0,
                        "padding length"
                    );
            }
            if kind == 1 && (flags & 32) != 0 {
                let offset = if padded {
                    1;
                }
                else {
                    0;
                };
                let padding = if padded {
                    data[0].int();
                }
                else {
                    0;
                };
                confirm length >= offset + 5 + padding
                    else throw Http2Fault.detailed(
                        Http2FaultScope.connection,
                        6,
                        0,
                        "headers priority length"
                    );
            }
        }
    }
}

test "a frame header is nine bytes and refuses impossible coordinates" {
    let header = Http2FrameHeader(kind: 4.byte(), flags: 0.byte(), stream: 0, length: 6);
    test.is(
        header.bytes(),
        [0.byte(), 0.byte(), 6.byte(), 4.byte(), 0.byte(), 0.byte(), 0.byte(), 0.byte(), 0.byte()]
    );
    let parsed = ParsedHttp2FrameHeader(
        [0.byte(), 0.byte(), 8.byte(), 6.byte(), 0.byte(), 0.byte(), 0.byte(), 0.byte(), 0.byte()]
    ).header();
    test.is(parsed.kind().int(), 6);
    test.is(parsed.length(), 8);
    test.is(parsed.stream(), 0);
    test.throws(Http2Fault) {
        Http2FrameHeader(kind: 0.byte(), flags: 0.byte(), stream: -1, length: 0);
    };
    let frame = Http2Frame(
        header: header,
        payload: [0.byte(), 3.byte(), 0.byte(), 0.byte(), 0.byte(), 100.byte()]
    );
    test.is(frame.bytes().size(), 15);
    Http2FrameRules(frame).check();
    test.throws(Http2Fault) {
        Http2Frame(header: header, payload: [0.byte()]);
    };
    let acknowledged = Http2FrameHeader(kind: 4.byte(), flags: 1.byte(), stream: 0, length: 6);
    test.throws(Http2Fault) {
        Http2FrameRules(
            Http2Frame(
                header: acknowledged,
                payload: [0.byte(), 3.byte(), 0.byte(), 0.byte(), 0.byte(), 100.byte()]
            )
        ).check();
    };
    let fault = try {
        Http2HeaderRules(Http2FrameHeader(kind: 0.byte(), flags: 0.byte(), stream: 0, length: 0)).check();
        "";
    }
    catch error is Http2Fault {
        let view = Http2FaultView(error);
        if view.scope() == Http2FaultScope.connection {
            "connection " + view.code().string();
        }
        else {
            "stream";
        }
    };
    test.is(fault, "connection 1");
}
