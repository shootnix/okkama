module http/internal/hpack_tables v1.0.0;
import "http/internal/hpack_static" take HpackStaticEntries;
import "http/internal/http2_frame" take Http2Fault,Http2FaultScope;
import "encoding/single_byte" take Latin1Encoded,UnrepresentableLatin1Character;
import "async/atomic" take Atomic;

// Opaque octet strings. Compression accepts pseudo-fields and control octets;
// actual HTTP field/message validity is checked above this internal layer.
object HpackField {
    has name,value is string;has sensitive is bool;
    HpackField(name is string,value is string){self.name=HpackOctetText(name).value();self.value=HpackOctetText(value).value();sensitive=false;}
    HpackField(name is string,value is string,sensitive is bool){self.name=HpackOctetText(name).value();self.value=HpackOctetText(value).value();self.sensitive=sensitive;}
    name() is string{name;}value() is string{value;}sensitive() is bool{sensitive;}
    size() is int{name.length()+value.length()+32;}
}
object HpackOctetText {
    has origin is string;HpackOctetText(origin is string){
        confirm origin.length()<=1048576 else throw Http2Fault(Http2FaultScope.connection,9,0,"HPACK octet string bound");
        try{Latin1Encoded(origin).bytes();}catch failure is UnrepresentableLatin1Character{throw Http2Fault(Http2FaultScope.connection,9,0,"HPACK requires octet strings");}
        self.origin=origin;
    }
    value() is string{origin;}
}
object HpackStaticTable {
    has entries is @HpackField;HpackStaticTable(){let fixed=HpackStaticEntries();let names=fixed.names();let values=fixed.values();let rows is @HpackField=(0..61).map()->index{HpackField(names[index],values[index]);};entries=rows;}
    size() is int{61;}
    field(index is int) is HpackField{
        confirm index>=1 && index<=61 else throw Http2Fault(Http2FaultScope.connection,9,0,"invalid static index");entries[index-1];
    }
    named(name is string) is int{
        for (0..61) -> index{if entries[index].name()==name{return index+1;}}0;
    }
    exact(field is HpackField) is int{
        for (0..61) -> index{let entry=entries[index];if entry.name()==field.name() && entry.value()==field.value(){return index+1;}}0;
    }
}
object HpackDynamicTable {
    has entries is @HpackField;has capacity,used is int;
    HpackDynamicTable(capacity is int){HpackTableBound(capacity);entries=[];self.capacity=capacity;used=0;}
    size() is int{entries.size();}capacity() is int{capacity;}used() is int{used;}
    field(index is int) is HpackField{
        confirm index>=1 && index<=entries.size() else throw Http2Fault(Http2FaultScope.connection,9,0,"invalid dynamic index");entries[index-1];
    }
    resized(capacity is int) is ^HpackDynamicTable{
        HpackTableBound(capacity);let retained=HpackKept(entries,capacity);
        ^entries=retained.entries();^used=retained.used();^capacity=capacity;
    }
    added(field is HpackField) is ^HpackDynamicTable{
        let size=field.size();
        if size>capacity{let empty is @HpackField=[];^entries=empty;^used=0;}
        else{
            let retained=HpackKept(entries,capacity-size);let rows=retained.entries();
            let following is @HpackField=(0..rows.size()+1).map()->index{if index==0{field;}else{rows[index-1];}};
            ^entries=following;^used=retained.used()+size;
        }
    }
}
object HpackTableBound {
    HpackTableBound(value is int){confirm value>=0 && value<=1048576 else throw Http2Fault(Http2FaultScope.connection,9,0,"HPACK table bound");}
}
object HpackKept {
    has entries is @HpackField;has used is int;
    HpackKept(origin is @HpackField,maximum is int){
        let size=Atomic(0);let count=Atomic(0);
        for origin -> field{if field.size()>maximum-size.value(){last;}size.replace(size.value()+field.size());count.replace(count.value()+1);}
        entries=origin.slice(0,count.value());used=size.value();
    }
    entries() is @HpackField{entries;}used() is int{used;}
}
object HpackLookup {
    has field is HpackField;
    HpackLookup(fixed is HpackStaticTable,dynamic is HpackDynamicTable,index is int){
        confirm index>0 else throw Http2Fault(Http2FaultScope.connection,9,0,"zero HPACK index");
        field=if index<=61{fixed.field(index);}else{dynamic.field(index-61);};
    }
    field() is HpackField{field;}
}
