module http/internal/trailers v1.0.0;
import "http/header" take Header;
import "http/message" take InvalidHttpMessage;

// Shared conservative trailer policy for HTTP1 and HTTP2. HTTP1 additionally
// provides Connection-nominated names; HTTP2 forbids Connection altogether.
object HttpTrailerRules {
    has forbidden,nominated is @string;
    HttpTrailerRules(nominated is @string){
        self.nominated=nominated;
        forbidden=["content-length","transfer-encoding","host","connection","trailer","te","upgrade","keep-alive","proxy-connection",
            "authorization","proxy-authorization","www-authenticate","proxy-authenticate","content-encoding","content-type","content-range",
            "expect","max-forwards","range","cookie","set-cookie","if-match","if-none-match","if-modified-since","if-unmodified-since","if-range",
            "cache-control","pragma","age","date","expires","vary","warning","retry-after","location","content-language","content-location","content-disposition"];
    }
    check(entry is Header) is void{
        let name=entry.name().lowercase();let banned is bool=forbidden.reduce(false)->found,value{found || value==name;};
        confirm !banned else throw InvalidHttpMessage("forbidden trailer field");
        let connection is bool=nominated.reduce(false)->found,value{found || value==name;};
        confirm !connection else throw InvalidHttpMessage("Connection nominated trailer field");
    }
}
