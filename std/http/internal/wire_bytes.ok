module http/internal/wire_bytes v1.0.0;

// Joining byte chunks into one bounded buffer.
//
// Internal to the http modules; programs do not import it.

import "runtime/buffer" take buffer_state_create, buffer_state_append, buffer_state_bytes,
    buffer_state_close;

// Bounded in-memory concatenation through the existing native buffer boundary.
// No interpreted per-octet callback and no new provider or transport effect.
object HttpWireBytes {
    has chunks is @@byte;

    // chunks joined, at most maximum bytes.
    HttpWireBytes(chunks is @@byte, maximum is int) {
        confirm maximum >= 0 && maximum <= 16777224 && chunks.size() <= 1024
            else throw WireByteLimit.exceeded;
        let total is int = chunks.reduce(0) -> used, chunk {
            confirm chunk.size() <= maximum - used else throw WireByteLimit.exceeded;
            used + chunk.size();
        };
        self.chunks = chunks;
    }

    // The bytes; WireByteLimit beyond maximum.
    bytes() is @byte {
        let buffer = buffer_state_create([]);
        defer buffer_state_close(buffer);
        for chunks -> chunk {
            let copied = buffer_state_append(buffer, chunk);
            confirm copied == chunk.size() else throw WireByteLimit.exceeded;
        }
        buffer_state_bytes(buffer);
    }
}

// The bytes would exceed the limit.
enum WireByteLimit is Error = (exceeded);

test "bulk join returns independent octets after its private buffer closes" {
    let wire = HttpWireBytes(chunks: [[0.byte(), 255.byte()], [], [65.byte()]], maximum: 3).bytes();
    test.is(wire.size(), 3);
    test.is(wire[1].int(), 255);
}
