module http/internal/http2_receiving v1.0.0;

// The receive side of HTTP/2 flow control: the connection window, the bodies of
// open streams, and the credit returned as they are read.
//
// Internal to the http modules; programs do not import it.

import "http/internal/http2_body" take Http2BodyBuffer, Http2BodyEvents;
import "http/internal/http2_input" take Http2ControlQueuing;
import "http/internal/http2_flow" take Http2FlowWindow, Http2DataPayload, Http2WindowFrame;
import "http/internal/http2_frame" take Http2Fault, Http2FaultScope, Http2FaultView;
import "http/internal/http2_controls" take Http2ResetFrame;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "error" take InvalidState;

// Connection-level receive ledger. Native body owners are deliberately
// borrowed: the owning session retains them in supervised stream lifetimes.
object Http2ReceiveFlow does Http2BodyEvents {
    has controls is Http2ControlQueuing;
    has window is Atomic<Http2FlowWindow>;
    has slots is Atomic<@Http2ReceivingSlot>;
    has highest is Atomic<int>;
    has maximum is int;
    has stopped is Event;

    // A ledger queuing WINDOW_UPDATEs on controls, with maximum streams.
    Http2ReceiveFlow(controls is Http2ControlQueuing, maximum is int) {
        confirm maximum > 0 && maximum <= 256
            else throw InvalidState.because("invalid receive slot limit");
        self.controls = controls;
        self.maximum = maximum;
        window = Atomic(
            Http2FlowWindow(scope: Http2FaultScope.connection, stream: 0, remaining: 65535)
        );
        let empty is @Http2ReceivingSlot = [];
        slots = Atomic(empty);
        highest = Atomic(0);
        stopped = Event();
    }

    // The same, starting from window.
    Http2ReceiveFlow(controls is Http2ControlQueuing, maximum is int, window is Http2FlowWindow) {
        confirm maximum > 0
            && maximum <= 256
            && window.scope() == Http2FaultScope.connection
            && window.remaining() >= 0
            else throw InvalidState.because("invalid receive context");
        self.controls = controls;
        self.maximum = maximum;
        self.window = Atomic(window);
        let empty is @Http2ReceivingSlot = [];
        slots = Atomic(empty);
        highest = Atomic(0);
        stopped = Event();
    }

    // The connection window left.
    remaining() is int {
        window.value().remaining();
    }

    // How many streams have bodies.
    active() is int {
        slots.value().size();
    }

    // A server can reject decoded request fields before allocating a body.
    // Remember only the increasing boundary, so late DATA still spends and
    // returns connection credit without allocating a tombstone per stream.
    observed_closed(stream is int) is void {
        confirm stream > 0 && stream <= 2147483647 && stream % 2 == 1
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "invalid closed receive stream"
            );
        if stream > highest.value() {
            highest.replace(stream);
        }
    }

    // Expects a body on stream.
    register(stream is int) is void {
        confirm !stopped.ready() else throw InvalidState.because("receive ledger stopped");
        confirm stream > highest.value() && stream <= 2147483647 && stream % 2 == 1
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "receive stream IDs must increase"
            );
        let old = slots.value();
        confirm old.size() < maximum
            else throw Http2Fault.detailed(Http2FaultScope.connection, 11, 0, "receive slot budget");
        let slot = Http2ReceivingSlot(stream);
        let following is @Http2ReceivingSlot = old + [slot];
        slots.replace(following);
        highest.replace(stream);
    }

    // Attaches body to stream.
    attach(stream is int, body is Http2BodyBuffer) is void {
        confirm !stopped.ready() && body.stream() == stream && !body.closed()
            else throw InvalidState.because("invalid receive body attachment");
        let matched = self.matching(stream);
        confirm matched.size() == 1
            else throw InvalidState.because("receive stream not registered");
        matched[0].attach(body);
    }

    // Registers stream with body.
    open(stream is int, body is Http2BodyBuffer) is void {
        confirm body.stream() == stream && !body.closed()
            else throw InvalidState.because("invalid receive body attachment");
        self.register(stream);
        self.attach(stream, body);
    }

    // The slot of stream, if any.
    matching(stream is int) is @Http2ReceivingSlot {
        slots.value().filter() -> slot {
            slot.stream() == stream;
        };
    }

    // Forgets stream.
    retire(stream is int) is void {
        slots.replace(slots.value().filter() -> slot {
            slot.stream() != stream;
        });
    }

    // Returns amount bytes to the connection window.
    return_credit(amount is int) is void {
        if amount > 0 {
            window.replace(window.value().credited(amount));
            if !stopped.ready() {
                controls.frame(Http2WindowFrame(stream: 0, amount: amount).frame());
            }
        }
    }

    // amount bytes of stream were read.
    credit(stream is int, amount is int, stream_update is bool) is void {
        self.return_credit(amount);
        if amount > 0 && stream_update && !stopped.ready() {
            controls.frame(Http2WindowFrame(stream: stream, amount: amount).frame());
        }
    }

    // amount bytes of stream were dropped.
    discard(stream is int, amount is int, cancel is bool) is void {
        self.return_credit(amount);
        self.retire(stream);
        if cancel && !stopped.ready() {
            controls.frame(Http2ResetFrame(stream: stream, code: 8).frame());
        }
    }

    // Charges and delivers a DATA frame.
    data(data is Http2DataPayload) is void {
        confirm !stopped.ready() else throw InvalidState.because("receive ledger stopped");
        window.replace(window.value().received(data.flow_bytes()));
        let stream = data.stream();
        let matched = self.matching(stream);
        if matched.size() == 0 {
            confirm stream <= highest.value() && stream % 2 == 1
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    1,
                    0,
                    "DATA on idle stream"
                );
            self.return_credit(data.flow_bytes());
            return;
        }
        let known = matched[0].bodies();
        if known.size() == 0 {
            self.return_credit(data.flow_bytes());
            throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "DATA before final response fields"
            );
        }
        let body = known[0];
        if body.closed() || body.wire_ended() {
            self.return_credit(data.flow_bytes());
            return;
        }
        try {
            body.data(data);
        }
        catch Http2Fault.detailed(scope, _, _, _) {
            if scope == Http2FaultScope.stream {
                self.return_credit(data.flow_bytes());
            }
            throw;
        }
    }

    // Applies a stream fault; true when it was handled.
    failed(failure is Http2Fault) is bool {
        let matched = self.matching(Http2FaultView(failure).stream());
        if matched.size() == 0 {
            return false;
        }
        let known = matched[0].bodies();
        for known -> body {
            if body.closed() || body.wire_ended() {
                return false;
            }
            body.fail(failure);
        }
        self.retire(Http2FaultView(failure).stream());
        true;
    }

    // Cancels the body of stream.
    cancel(stream is int) is void {
        let matched = self.matching(stream);
        if matched.size() == 0 {
            return;
        }
        let known = matched[0].bodies();
        if known.size() == 0 {
            self.discard(stream, 0, true);
            return;
        }
        known[0].close();
    }

    // Fails every body with failure.
    stop(failure is Error) is void {
        stopped.set();
        for slots.value() -> slot {
            for slot.bodies() -> body {
                if !body.wire_ended() {
                    body.fail(failure);
                }
            }
        }
        slots.replace([]);
    }
}

// The bodies waiting on one stream.
object Http2ReceivingSlot {
    has stream is int;
    has body is Atomic<@Http2BodyBuffer>;

    // The slot of stream.
    Http2ReceivingSlot(stream is int) {
        self.stream = stream;
        let empty is @Http2BodyBuffer = [];
        body = Atomic(empty);
    }

    // The stream.
    stream() is int {
        stream;
    }

    // Its bodies.
    bodies() is @Http2BodyBuffer {
        body.value();
    }

    // Attaches origin.
    attach(origin is Http2BodyBuffer) is void {
        confirm body.value().size() == 0
            else throw InvalidState.because("receive body already attached");
        body.replace([origin]);
    }
}
