module http/internal/websocket_reading v1.0.0;

// Reading WebSocket frames from a stream, one at a time.
//
// Internal to the http modules; programs do not import it.

import "http/internal/websocket_frame" take ParsedWebSocketFrameHeader, WebSocketFrame,
    WebSocketMaskedBytes, WebSocketHeaderPrefix;
import "http/websocket" take WebSocketFailure, WebSocketClosed;

import "io/stream" take AsyncReading;
import "async/scope" take FutureGroup;
import "io/buffer" take ByteBuffer;
import "io/decorators" take InvalidReading;
import "http/internal/wire_bytes" take HttpWireBytes;

// Memoized one-frame consumption, borrowed input and one supervised child per
// physical read. No completed-read history survives to the next operation.
object WebSocketFrameReading {
    has waiting is Future<WebSocketFrame>;

    // Reads from origin, expecting masking or not, payloads up to maximum
    // bytes.
    WebSocketFrameReading(origin is AsyncReading, masked is bool, maximum is int) {
        let input = WebSocketFrameInput(origin: origin, masked: masked, maximum: maximum);
        waiting = input.reading();
    }

    // The frame, unmasked; WebSocketFailure for an invalid one.
    async frame() is WebSocketFrame {
        let group is FutureGroup<WebSocketFrame> = FutureGroup();
        let cleanup = WebSocketFrameSettlement(group);
        defer await cleanup.close();
        group.start(waiting);
        await waiting;
    }
}

hidden object WebSocketFrameInput {
    has origin is AsyncReading;
    has masked is bool;
    has maximum is int;

    WebSocketFrameInput(origin is AsyncReading, masked is bool, maximum is int) {
        self.origin = origin;
        self.masked = masked;
        self.maximum = maximum;
    }

    async chunk(limit is int) is @byte {
        let waiting = origin.bytes(limit);
        await waiting;
    }

    async exact(amount is int, between_frames is bool) is @byte {
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        loop {
            let remaining = amount - buffer.content().size();
            last if remaining == 0;
            let limit = if remaining <= 65536 {
                remaining;
            }
            else {
                65536;
            };
            let chunk = await self.chunk(limit);
            confirm chunk.size() <= limit
                else throw InvalidReading.because("WebSocket source exceeded requested limit");
            if chunk.size() == 0 {
                if between_frames && buffer.content().size() == 0 {
                    throw WebSocketClosed.detailed(1006, "");
                }
                throw WebSocketFailure.because("truncated frame");
            }
            buffer.writing().write(chunk);
        }
        buffer.content().bytes();
    }

    async reading() is WebSocketFrame {
        let prefix = await self.exact(2, true);
        WebSocketHeaderPrefix(origin: prefix, masked: masked).checked();
        let indicator = prefix[1].int() & 127;
        let width = if indicator == 126 {
            2;
        }
        else {
            if indicator == 127 {
                8;
            }
            else {
                0;
            }
        };
        let extended = await self.exact(width, false);
        let header = ParsedWebSocketFrameHeader(
            origin: HttpWireBytes([prefix, extended], 10).bytes(),
            masked: masked,
            maximum: maximum
        ).header();
        let mask is @byte = if masked {
            await self.exact(4, false);
        }
        else {
            let empty is @byte = [];
            empty;
        };
        let bytes = await self.exact(header.length(), false);
        let payload = if masked {
            WebSocketMaskedBytes(origin: bytes, mask: mask, offset: 0).bytes();
        }
        else {
            bytes;
        };
        WebSocketFrame(opcode: header.opcode(), final: header.final(), payload: payload);
    }
}

hidden object WebSocketFrameSettlement {
    has group is FutureGroup<WebSocketFrame>;

    WebSocketFrameSettlement(group is FutureGroup<WebSocketFrame>) {
        self.group = group;
    }

    async close() is void {
        if group.active() > 0 {
            group.cancel();
            await group.wait();
        }
    }
}
