module http/internal/hpack_primitives v1.0.0;

// The HPACK primitives (RFC 7541 §5): prefixed integers and string literals,
// with Huffman decoding.
//
// Internal to the http modules; programs do not import it.

import "http/internal/http2_frame" take Http2Fault, Http2FaultScope;
import "runtime/hpack" take huffman_decode;
import "http/internal/wire_bytes" take HttpWireBytes;
import "async/atomic" take Atomic;
import "io/buffer" take ByteBuffer;

// Internal bounded uint32 integer profile. No public header/HPACK API.
object HpackInteger {
    has value, prefix, pattern is int;

    // value in a prefix of prefix bits, the other bits of the first byte from
    // pattern.
    HpackInteger(value is int, prefix is int, pattern is int) {
        confirm value >= 0
            && value <= 4294967295
            && prefix >= 1
            && prefix <= 8
            && pattern >= 0
            && pattern <= 255
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "invalid HPACK integer"
            );
        let mask = (1 << prefix) - 1;
        confirm (pattern & mask) == 0
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "overlapping HPACK prefix"
            );
        self.value = value;
        self.prefix = prefix;
        self.pattern = pattern;
    }

    // Its encoding.
    bytes() is @byte {
        let maximum = (1 << prefix) - 1;
        if value < maximum {
            return [(pattern | value).byte()];
        }
        let output = ByteBuffer();
        let remaining = Atomic(value - maximum);
        output.writing().write([(pattern | maximum).byte()]);
        for (0..5) -> step {
            let chunk = remaining.value() & 127;
            if remaining.value() < 128 {
                output.writing().write([chunk.byte()]);
                return output.content().bytes();
            }
            output.writing().write([(chunk | 128).byte()]);
            remaining.replace(remaining.value() >> 7);
        }
        throw Http2Fault.detailed(Http2FaultScope.connection, 9, 0, "oversized HPACK integer");
    }
}

// An integer read at an offset.
object ParsedHpackInteger {
    has number, following is int;

    // Reads the integer at offset with a prefix of prefix bits.
    ParsedHpackInteger(origin is @byte, offset is int, prefix is int) {
        let parsed = HpackIntegerInput(origin: origin, offset: offset, prefix: prefix).number();
        number = parsed.int();
        following = parsed.following();
    }

    // Its value; Http2Fault past 2³²−1 or the end of origin.
    int() is int {
        number;
    }

    // The offset after it.
    following() is int {
        following;
    }
}

hidden object HpackNumber {
    has value, following is int;

    HpackNumber(value is int, following is int) {
        self.value = value;
        self.following = following;
    }

    int() is int {
        value;
    }

    following() is int {
        following;
    }
}

hidden object HpackIntegerInput {
    has origin is @byte;
    has offset, prefix is int;

    HpackIntegerInput(origin is @byte, offset is int, prefix is int) {
        self.origin = origin;
        self.offset = offset;
        self.prefix = prefix;
    }

    number() is HpackNumber {
        confirm offset >= 0 && offset < origin.size() && prefix >= 1 && prefix <= 8
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "missing HPACK integer"
            );
        let maximum = (1 << prefix) - 1;
        let initial = origin[offset].int() & maximum;
        if initial < maximum {
            return HpackNumber(value: initial, following: offset + 1);
        }
        let value = Atomic(initial);
        for (0..5) -> step {
            let index = offset + 1 + step;
            confirm index < origin.size()
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    9,
                    0,
                    "truncated HPACK integer"
                );
            let octet = origin[index].int();
            let amount = (octet & 127) * (1 << (7 * step));
            confirm amount <= 4294967295 - value.value()
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    9,
                    0,
                    "HPACK integer overflow"
                );
            value.replace(value.value() + amount);
            if octet < 128 {
                return HpackNumber(value: value.value(), following: index + 1);
            }
        }
        throw Http2Fault.detailed(Http2FaultScope.connection, 9, 0, "oversized HPACK integer");
    }
}

// A string literal, written without Huffman coding.
object HpackString {
    has origin is @byte;

    // The bytes.
    HpackString(origin is @byte) {
        confirm origin.size() <= 1048576
            else throw Http2Fault.detailed(Http2FaultScope.connection, 9, 0, "HPACK string budget");
        self.origin = origin;
    }

    // Its encoding: the length and the bytes.
    bytes() is @byte {
        let prefix = HpackInteger(value: origin.size(), prefix: 7, pattern: 0).bytes();
        HttpWireBytes(chunks: [prefix, origin], maximum: prefix.size() + origin.size()).bytes();
    }
}

// A string literal read at an offset.
object ParsedHpackString {
    has data is @byte;
    has following is int;

    // Reads the literal at offset, at most maximum bytes once decoded.
    ParsedHpackString(origin is @byte, offset is int, maximum is int) {
        confirm maximum >= 0 && maximum <= 1048576
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "invalid HPACK string budget"
            );
        let length = ParsedHpackInteger(origin: origin, offset: offset, prefix: 7);
        let start = length.following();
        let count = length.int();
        confirm count <= 1048576 && count <= origin.size() - start
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "truncated or oversized HPACK string"
            );
        let huffman = (origin[offset].int() & 128) != 0;
        confirm huffman || count <= maximum
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "decoded HPACK string budget"
            );
        let encoded = origin.slice(start, start + count);
        data = if huffman {
            HpackHuffman(origin: encoded, maximum: maximum).bytes();
        }
        else {
            encoded;
        };
        following = start + count;
    }

    // Its bytes, Huffman-decoded when flagged.
    bytes() is @byte {
        data;
    }

    // The offset after it.
    following() is int {
        following;
    }
}

// Huffman-coded bytes (RFC 7541 Appendix B), decoded.
object HpackHuffman {
    has origin is @byte;
    has maximum is int;

    // origin to decode into at most maximum bytes.
    HpackHuffman(origin is @byte, maximum is int) {
        confirm origin.size() <= 1048576 && maximum >= 0 && maximum <= 1048576
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "invalid Huffman budget"
            );
        self.origin = origin;
        self.maximum = maximum;
    }

    // The decoded bytes; Http2Fault for invalid coding or more than maximum
    // bytes.
    bytes() is @byte {
        let result is @byte = try {
            huffman_decode(origin, maximum);
        }
        catch failure is NativeFailure {
            throw Http2Fault.detailed(
                Http2FaultScope.connection,
                9,
                0,
                "invalid or oversized HPACK Huffman string"
            );
        };
        result;
    }
}

test "bounded HPACK primitives preserve wire values" {
    let encoded = HpackInteger(value: 1337, prefix: 5, pattern: 0).bytes();
    test.is(ParsedHpackInteger(origin: encoded, offset: 0, prefix: 5).int(), 1337);
    test.is(HpackHuffman(origin: [31.byte()], maximum: 1).bytes()[0].int(), 97);
}
