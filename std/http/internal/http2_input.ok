module http/internal/http2_input v1.0.0;

// The single reader of an HTTP/2 connection: it reads every frame, answers PING
// and SETTINGS, and hands the rest to the session as events.
//
// Internal to the http modules; programs do not import it.

import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2Fault, Http2FaultScope,
    Http2FaultView;
import "http/internal/http2_reading" take Http2FrameReading, EndOfHttp2Frames;
import "http/internal/http2_headers" take Http2HeaderBlock, Http2HeaderBlockReading;
import "http/internal/hpack" take HpackDecoder, HpackBudget;
import "http/internal/http2_settings" take Http2PeerSettings;
import "http/http2_settings" take Http2Settings;
import "http/internal/http2_flow" take Http2DataPayload, Http2WindowIncrement;
import "http/internal/http2_controls" take Http2Reset, Http2ResetFrame, Http2PingReply, Http2GoAway,
    Http2GoAwayProgress;
import "io/stream" take AsyncReading;
import "encoding/binary" take Binary, Signedness;
import "encoding/utf" take ByteOrder;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "error" take InvalidState;

// What the reader reports to the session.
role Http2ReceivingEvents {
    // A header block arrived.
    headers(block is Http2HeaderBlock) is void;
    // A DATA frame arrived.
    data(data is Http2DataPayload) is void;
    // A stream was reset by the peer.
    reset(reset is Http2Reset) is void;
    // A WINDOW_UPDATE arrived.
    window(update is Http2WindowIncrement) is void;
    // The peer changed its settings from previous to current.
    settings(previous is Http2PeerSettings, current is Http2PeerSettings) is void;
    // The peer acknowledged our settings.
    local_settings(settings is Http2Settings) is void;
    // A GOAWAY arrived.
    goaway(frame is Http2GoAway) is void;
    // A stream broke the protocol; true when it was handled.
    stream_fault(fault is Http2Fault) is bool;
    // The input ended.
    ended() is void;
}

// Optional owner acquisition barrier; never waits for application completion.
role Http2ReceivingBarrier {
    // Waits until the session is ready; true to go on.
    async published() is bool;
}

// Told after each frame is handed over.
role Http2ReadBoundary {
    // A frame was handed over.
    dispatched() is void;
}

// Where the reader queues control frames to send.
role Http2ControlQueuing {
    // Queues frame.
    frame(frame is Http2Frame) is void;
}

// Reads a connection until it ends.
object Http2ConnectionInput {
    has origin is AsyncReading;
    has receiver is Http2ReceivingEvents;
    has controls is Http2ControlQueuing;
    has local is Http2Settings;
    has peer is Atomic<Http2PeerSettings>;
    has decoder is Atomic<HpackDecoder>;
    has boundaries is @Http2ReadBoundary;
    has barriers is @Http2ReceivingBarrier;
    has from_server is bool;
    has acknowledged, started is Event;
    has goaway is Atomic<Http2GoAwayProgress>;
    has budget is HpackBudget;

    // Reads origin on a client, reporting to receiver and queuing controls,
    // with both sides' settings.
    Http2ConnectionInput(
        origin is AsyncReading,
        receiver is Http2ReceivingEvents,
        controls is Http2ControlQueuing,
        local is Http2Settings,
        peer is Http2PeerSettings
    ) {
        self.origin = origin;
        self.receiver = receiver;
        self.controls = controls;
        self.local = local;
        self.peer = Atomic(peer);
        decoder = Atomic(HpackDecoder());
        acknowledged = Event();
        started = Event();
        goaway = Atomic(Http2GoAwayProgress());
        budget = HpackBudget();
        from_server = true;
        barriers = [];
        boundaries = [];
    }

    // The same with an HPACK budget.
    Http2ConnectionInput(
        origin is AsyncReading,
        receiver is Http2ReceivingEvents,
        controls is Http2ControlQueuing,
        local is Http2Settings,
        peer is Http2PeerSettings,
        budget is HpackBudget
    ) {
        self.origin = origin;
        self.receiver = receiver;
        self.controls = controls;
        self.local = local;
        self.peer = Atomic(peer);
        decoder = Atomic(HpackDecoder());
        acknowledged = Event();
        started = Event();
        goaway = Atomic(Http2GoAwayProgress());
        self.budget = budget;
        from_server = true;
        barriers = [];
        boundaries = [];
    }

    // Explicit receiving direction; old overloads remain client-side.
    Http2ConnectionInput(
        origin is AsyncReading,
        receiver is Http2ReceivingEvents,
        controls is Http2ControlQueuing,
        local is Http2Settings,
        peer is Http2PeerSettings,
        budget is HpackBudget,
        from_server is bool
    ) {
        self.origin = origin;
        self.receiver = receiver;
        self.controls = controls;
        self.local = local;
        self.peer = Atomic(peer);
        decoder = Atomic(HpackDecoder());
        acknowledged = Event();
        started = Event();
        goaway = Atomic(Http2GoAwayProgress());
        self.budget = budget;
        self.from_server = from_server;
        barriers = [];
        boundaries = [];
    }

    // The same, waiting for barrier first.
    Http2ConnectionInput(
        origin is AsyncReading,
        receiver is Http2ReceivingEvents,
        controls is Http2ControlQueuing,
        local is Http2Settings,
        peer is Http2PeerSettings,
        budget is HpackBudget,
        from_server is bool,
        barrier is Http2ReceivingBarrier
    ) {
        self.origin = origin;
        self.receiver = receiver;
        self.controls = controls;
        self.local = local;
        self.peer = Atomic(peer);
        decoder = Atomic(HpackDecoder());
        acknowledged = Event();
        started = Event();
        goaway = Atomic(Http2GoAwayProgress());
        self.budget = budget;
        self.from_server = from_server;
        barriers = [barrier];
        boundaries = [];
    }

    // The same, telling boundary after each frame.
    Http2ConnectionInput(
        origin is AsyncReading,
        receiver is Http2ReceivingEvents,
        controls is Http2ControlQueuing,
        local is Http2Settings,
        peer is Http2PeerSettings,
        budget is HpackBudget,
        from_server is bool,
        barrier is Http2ReceivingBarrier,
        boundary is Http2ReadBoundary
    ) {
        self.origin = origin;
        self.receiver = receiver;
        self.controls = controls;
        self.local = local;
        self.peer = Atomic(peer);
        decoder = Atomic(HpackDecoder());
        acknowledged = Event();
        started = Event();
        goaway = Atomic(Http2GoAwayProgress());
        self.budget = budget;
        self.from_server = from_server;
        barriers = [barrier];
        boundaries = [boundary];
    }

    // Reads until the input ends; true when it ended cleanly, Http2Fault on a
    // protocol error.
    async run() is bool {
        confirm !started.ready() else throw InvalidState.because("HTTP2 wire reader is single-use");
        started.set();
        let pending = self.read_loop();
        await pending;
    }

    hidden async read_loop() is bool {
        loop {
            let eof = Event();
            let pending = Http2FrameReading(origin: origin, maximum: local::Settings::frame_size).frame();
            let available is @Http2Frame = try {
                [await pending];
            }
            catch failure is EndOfHttp2Frames {
                eof.set();
                receiver.ended();
                let empty is @Http2Frame = [];
                empty;
            }
            catch failure is Http2Fault {
                if Http2FaultView(failure).scope() == Http2FaultScope.connection {
                    throw;
                }
                self.stream_fault(failure);
                let empty is @Http2Frame = [];
                empty;
            };
            if available.size() == 0 {
                for boundaries -> boundary {
                    boundary.dispatched();
                }
                if eof.ready() {
                    return true;
                }
                next;
            }
            let dispatched = self.dispatch(available[0]);
            try {
                await dispatched;
            }
            catch failure is Http2Fault {
                if Http2FaultView(failure).scope() == Http2FaultScope.connection {
                    throw;
                }
                self.stream_fault(failure);
            }
            for boundaries -> boundary {
                boundary.dispatched();
            }
        }
    }

    hidden stream_fault(failure is Http2Fault) is void {
        if receiver.stream_fault(failure) {
            controls.frame(
                Http2ResetFrame(
                    stream: Http2FaultView(failure).stream(),
                    code: Http2FaultView(failure).code()
                ).frame()
            );
        }
    }

    hidden async dispatch(frame is Http2Frame) is bool {
        let kind = frame.header().kind().int();
        if kind == 1 {
            let pending = Http2HeaderBlockReading(
                first: frame,
                origin: origin,
                context: decoder.value(),
                budget: budget,
                maximum: local::Settings::frame_size
            ).block();
            let block = await pending;
            decoder.replace(block.context());
            receiver.headers(block);
            for barriers -> barrier {
                let waiting = barrier.published();
                await waiting;
            }
            return true;
        }
        if kind == 0 {
            receiver.data(Http2DataPayload(frame));
            return true;
        }
        if kind == 3 {
            receiver.reset(Http2Reset(frame));
            return true;
        }
        if kind == 8 {
            receiver.window(Http2WindowIncrement(frame));
            return true;
        }
        if kind == 6 {
            for Http2PingReply(frame).frames() -> reply {
                controls.frame(reply);
            }
            return true;
        }
        if kind == 7 {
            let progress = Http2GoAway(frame);
            goaway.replace(goaway.value().received(progress));
            receiver.goaway(progress);
            return true;
        }
        if kind == 4 {
            if (frame.header().flags().int() & 1) != 0 {
                confirm !acknowledged.ready()
                    else throw Http2Fault.detailed(
                        Http2FaultScope.connection,
                        1,
                        0,
                        "unexpected settings acknowledgment"
                    );
                decoder.replace(decoder.value().allowed(local::Settings::header_table));
                receiver.local_settings(local);
                acknowledged.set();
                return true;
            }
            let payload = frame.payload();
            for (0..(payload.size() / 6).int()) -> row {
                let offset = row * 6;
                let id = Binary(bytes: payload.slice(offset, offset + 2), order: ByteOrder.big).int(
                    Signedness.unsigned
                );
                let value = Binary(
                    bytes: payload.slice(offset + 2, offset + 6),
                    order: ByteOrder.big
                ).int(Signedness.unsigned);
                let previous = peer.value();
                let following = previous.setting(id, value, from_server);
                receiver.settings(previous, following);
                peer.replace(following);
            }
            controls.frame(
                Http2Frame(header: Http2FrameHeader(4.byte(), 1.byte(), 0, 0), payload: [])
            );
            return true;
        }
        if kind == 9 {
            throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "unexpected standalone CONTINUATION"
            );
        }
        // Valid deprecated PRIORITY and unknown extension frames are ignored.
        // PUSH_PROMISE was already rejected by the structural frame reader.
        true;
    }
}
