module http/internal/http2_output v1.0.0;

// The single writer of an HTTP/2 connection: a bounded queue of frame groups,
// each written whole and in order.
//
// Internal to the http modules; programs do not import it.

import "http/internal/http2_input" take Http2ControlQueuing;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2FrameRules, Http2Fault,
    Http2FaultScope;
import "http/internal/hpack" take HpackBudget;
import "http/internal/hpack_tables" take HpackField;
import "http/internal/http2_headers" take Http2EncodedHeaderFrames;
import "collections/sequence" take Sequencing;
import "io/stream" take AsyncWriting;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "error" take InvalidState;

// Told when a queued group starts to be written.
role Http2OutputStarting {
    // The group started.
    start() is void;
}

hidden object Http2OutputUnreserved does Http2OutputStarting {
    Http2OutputUnreserved();

    start() is void {}
}

// Connection owns run(); stream callers own only tickets. Cancelling a ticket
// never cancels a started physical frame or splits a HEADERS/CONTINUATION block.
object Http2ConnectionOutput does Http2ControlQueuing {
    has origin is AsyncWriting;
    has jobs is Atomic<@Http2OutputTicket>;
    has current is Atomic<@Http2OutputTicket>;
    has changed, space is Atomic<Event>;
    has stopping, started is Event;
    has count, bytes is Atomic<int>;
    has maximum, byte_limit is int;

    // Writes to origin, queuing at most maximum groups and byte_limit bytes.
    Http2ConnectionOutput(origin is AsyncWriting, maximum is int, byte_limit is int) {
        confirm maximum > 0 && maximum <= 256 && byte_limit >= 9 && byte_limit <= 1048576
            else throw Http2OutputLimit.exceeded;
        self.origin = origin;
        self.maximum = maximum;
        self.byte_limit = byte_limit;
        let empty is @Http2OutputTicket = [];
        jobs = Atomic(empty);
        current = Atomic(empty);
        changed = Atomic(Event());
        space = Atomic(Event());
        stopping = Event();
        started = Event();
        count = Atomic(0);
        bytes = Atomic(0);
    }

    // Queues frames; Http2OutputLimit when the queue is full.
    submit(frames is @Http2Frame) is Http2OutputTicket {
        self.submit(frames, Http2OutputUnreserved());
    }

    // The same, telling starting when they start.
    submit(frames is @Http2Frame, starting is Http2OutputStarting) is Http2OutputTicket {
        confirm !stopping.ready() else throw Http2OutputStopped.stopped;
        confirm frames.size() > 0 && frames.size() <= 1024 && count.value() < maximum
            else throw Http2OutputLimit.exceeded;
        let amount is int = frames.reduce(0) -> total, frame {
            Http2FrameRules(frame).check();
            let following is int = total + 9 + frame.header().length();
            confirm following <= byte_limit - bytes.value() else throw Http2OutputLimit.exceeded;
            following;
        };
        let ticket = Http2OutputTicket(frames: frames, amount: amount, starting: starting);
        let old = jobs.value();
        let following is @Http2OutputTicket = old + [ticket];
        jobs.replace(following);
        count.replace(count.value() + 1);
        bytes.replace(bytes.value() + amount);
        changed.value().set();
        ticket;
    }

    // Queues one control frame.
    frame(frame is Http2Frame) is void {
        self.submit([frame]);
    }

    // Queues a header block for stream.
    headers(
        stream is int,
        fields is Sequencing<HpackField>,
        budget is HpackBudget,
        fragment is int,
        end_stream is bool
    ) is Http2OutputTicket {
        self.headers(stream, fields, budget, fragment, end_stream, Http2OutputUnreserved());
    }

    // The same, telling starting when it starts.
    headers(
        stream is int,
        fields is Sequencing<HpackField>,
        budget is HpackBudget,
        fragment is int,
        end_stream is bool,
        starting is Http2OutputStarting
    ) is Http2OutputTicket {
        confirm !stopping.ready() else throw Http2OutputStopped.stopped;
        confirm count.value() < maximum else throw Http2OutputLimit.exceeded;
        let encoded = Http2EncodedHeaderFrames(
            stream: stream,
            fields: fields,
            budget: budget,
            fragment: fragment,
            end_stream: end_stream
        );
        self.submit(encoded.frames(), starting);
    }

    // Fires when the queue has room.
    space() is Event {
        space.value();
    }

    // The byte limit of the queue.
    maximum_bytes() is int {
        byte_limit;
    }

    // Writes what is queued, then stops.
    finish() is void {
        stopping.set();
        changed.value().set();
        space.value().set();
    }

    // Takes the queued groups.
    take() is @Http2OutputTicket {
        let queue = jobs.value();
        if queue.size() == 0 {
            return [];
        }
        let first = queue[0];
        jobs.replace(queue.slice(1, queue.size()));
        current.replace([first]);
        [first];
    }

    // ticket is done and its room is free.
    released(ticket is Http2OutputTicket) is void {
        current.replace([]);
        count.replace(count.value() - 1);
        bytes.replace(bytes.value() - ticket.size());
        space.value().set();
        space.replace(Event());
    }

    // Stops at once, failing what is queued.
    abort() is void {
        self.finish();
        for current.value() -> ticket {
            ticket.failed();
        }
        for jobs.value() -> ticket {
            ticket.failed();
        }
        current.replace([]);
        jobs.replace([]);
        count.replace(0);
        bytes.replace(0);
    }

    // Writes until finished or aborted; true when it finished cleanly.
    async run() is bool {
        confirm !started.ready() else throw InvalidState.because("HTTP2 wire writer is single-use");
        started.set();
        defer self.abort();
        let pending = self.write_loop();
        await pending;
    }

    hidden async write_loop() is bool {
        loop {
            let available = self.take();
            if available.size() == 0 {
                if stopping.ready() {
                    return true;
                }
                let signal = Event();
                changed.replace(signal);
                await signal.wait();
                next;
            }
            let ticket = available[0];
            if !ticket.cancelled() {
                ticket.begin();
                for ticket.frames() -> frame {
                    let pending = origin.write(frame.bytes());
                    await pending;
                }
                ticket.completed();
            }
            self.released(ticket);
        }
    }
}

// One queued group of frames.
object Http2OutputTicket {
    has frames is @Http2Frame;
    has amount is int;
    has finished, cancellation, stopped is Event;
    has starting is Http2OutputStarting;
    has begun is Event;

    // frames taking amount bytes of the queue.
    Http2OutputTicket(frames is @Http2Frame, amount is int, starting is Http2OutputStarting) {
        self.frames = frames;
        self.amount = amount;
        self.starting = starting;
        finished = Event();
        cancellation = Event();
        stopped = Event();
        begun = Event();
    }

    // The frames.
    frames() is @Http2Frame {
        frames;
    }

    // The bytes it takes.
    size() is int {
        amount;
    }

    // Whether it was cancelled before it started.
    cancelled() is bool {
        cancellation.ready();
    }

    // Marks it started.
    begin() is void {
        starting.start();
        begun.set();
    }

    // Whether it started.
    started() is bool {
        begun.ready();
    }

    // Cancels it unless it started.
    cancel() is void {
        if !finished.ready() {
            cancellation.set();
            finished.set();
        }
    }

    // Marks it written.
    completed() is void {
        finished.set();
    }

    // Marks it failed.
    failed() is void {
        if !finished.ready() {
            stopped.set();
            finished.set();
        }
    }

    // Waits for it; true when written, Http2OutputCancelled or
    // Http2OutputStopped otherwise.
    async delivered() is bool {
        defer self.cancel();
        await finished.wait();
        confirm !stopped.ready() else throw Http2OutputStopped.stopped;
        confirm !cancellation.ready() else throw Http2OutputCancelled.cancelled;
        true;
    }
}

// The output queue is full.
enum Http2OutputLimit is Error = (exceeded);

// The output stopped before the frames were written.
enum Http2OutputStopped is Error = (stopped);

// The frames were cancelled before they were written.
enum Http2OutputCancelled is Error = (cancelled);
