module http/internal/http2_fields v1.0.0;

import "http/internal/hpack_tables" take HpackField;
import "http/internal/http2_frame" take Http2Fault, Http2FaultScope;
import "http/message" take Request, Response;
import "http/body" take BodyOpening;
import "http/method" take Method, MethodName, InvalidMethod;
import "http/status" take Status, InvalidStatus, StatusCode;
import "http/version" take HttpVersion;
import "http/target" take RequestTarget, RequestTargetKind, AbsoluteTarget, ParsedRequestTarget,
    InvalidRequestTarget;
import "http/header" take Headers, Header, HeaderName, HeaderLimits, Http2Headers,
    HttpAsciiLowercase, InvalidHeader;
import "url/value" take UrlParts, ParsedUrl, MissingUrlPort, UrlHostKind, InvalidUrl;
import "encoding/single_byte" take Latin1Encoded;
import "async/atomic" take Atomic;

// Pure outbound control-data mapping. Bodies are deliberately unobserved.
object Http2RequestFields {
    has fields is @HpackField;

    Http2RequestFields(request is Request, stream is int) {
        Http2StreamCoordinate(stream);
        let target = request::Head::target;
        let prefix is @HpackField = if target.kind() == RequestTargetKind.authority {
            confirm request::Head::method == Method.connect
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "authority target requires CONNECT"
                );
            Http2HostAgreement(fields: request::Head::headers, scheme: "", authority: target.string(), stream: stream);
            [
                HpackField(name: ":method", value: "CONNECT"),
                HpackField(name: ":authority", value: target.string())
            ];
        }
        else {
            confirm target.kind() == RequestTargetKind.absolute
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "absolute URL or explicit route required"
                );
            Http2RequestControl(request: request, url: target.url(), stream: stream).fields();
        };
        fields = Http2JoinedFields(
            prefix: prefix,
            ordinary: Http2OrdinaryFields(request::Head::headers, true, stream).fields()
        ).fields();
    }

    Http2RequestFields(request is Request, stream is int, route is UrlParts) {
        Http2StreamCoordinate(stream);
        AbsoluteTarget(route);
        if request::Head::target.kind() == RequestTargetKind.absolute {
            confirm request::Head::target.url().string() == route.string()
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "route URL disagrees with request"
                );
        }
        confirm request::Head::target.kind() != RequestTargetKind.authority
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "CONNECT uses authority coordinates"
            );
        fields = Http2JoinedFields(
            prefix: Http2RequestControl(request, route, stream).fields(),
            ordinary: Http2OrdinaryFields(request::Head::headers, true, stream).fields()
        ).fields();
    }

    fields() is @HpackField {
        fields;
    }
}

hidden object Http2RequestControl {
    has fields is @HpackField;

    Http2RequestControl(request is Request, url is UrlParts, stream is int) {
        AbsoluteTarget(url);
        let parts = url;
        let authority = parts.authority();
        Http2HostAgreement(fields: request::Head::headers, scheme: parts::Parts::scheme, authority: authority, stream: stream);
        let target = request::Head::target;
        let path = match target.kind() {
            case RequestTargetKind.asterisk {
                "*";
            }
            case RequestTargetKind.origin {
                target.string();
            }
            case RequestTargetKind.absolute {
                (if parts::Parts::path == "" {
                    "/";
                }
                else {
                    parts::Parts::path;
                }) + match parts::Parts::query {
                    case Maybe.some(query) {
                        "?" + query;
                    }
                    else {
                        "";
                    }
                };
            }
            else {
                throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "unsupported request target"
                );
            }
        };
        fields = [
            HpackField(name: ":method", value: MethodName(request::Head::method).string()),
            HpackField(name: ":scheme", value: parts::Parts::scheme),
            HpackField(name: ":authority", value: authority),
            HpackField(name: ":path", value: path)
        ];
    }

    fields() is @HpackField {
        fields;
    }
}

hidden object Http2HostAgreement {
    Http2HostAgreement(fields is Headers, scheme is string, authority is string, stream is int) {
        let hosts = fields.values(HeaderName("Host"));
        confirm hosts.size() <= 1
            else throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "duplicate Host");
        let expected = Http2AuthorityKey(scheme: scheme, origin: authority, stream: stream).string();
        if hosts.size() == 1 {
            confirm Http2AuthorityKey(scheme: scheme, origin: hosts.item(0), stream: stream).string() == expected
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "Host disagrees with authority"
                );
        }
    }
}

hidden object Http2AuthorityKey {
    has key is string;

    Http2AuthorityKey(scheme is string, origin is string, stream is int) {
        let authority = try {
            ParsedUrl("//" + origin).parts();
        }
        catch failure is InvalidUrl {
            throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "invalid authority");
        };
        confirm authority::Parts::path == ""
            && authority::Parts::query == Maybe<string>.none
            && (authority::Parts::host else "") != ""
            && authority::Parts::userinfo == Maybe<string>.none
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "authority without host or with userinfo"
            );
        let port = match authority::Parts::port {
            case Maybe.some(number) {
                number;
            }
            else {
            if scheme == "https" {
                443;
            }
            else {
                if scheme == "http" {
                    80;
                }
                else {
                    throw Http2Fault.detailed(
                        Http2FaultScope.stream,
                        1,
                        stream,
                        "explicit authority port required"
                    );
                }
            }
            }
        };
        key = (authority::Parts::host else "") + ":" + port.string();
    }

    string() is string {
        key;
    }
}

object Http2ResponseFields {
    has fields is @HpackField;

    Http2ResponseFields(response is Response, stream is int) {
        Http2StreamCoordinate(stream);
        confirm response::Head::status != Status.switching_protocols
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "101 is invalid in HTTP2"
            );
        fields = Http2JoinedFields(
            prefix: [HpackField(":status", StatusCode(response::Head::status).number().string())],
            ordinary: Http2OrdinaryFields(response::Head::headers, false, stream).fields()
        ).fields();
    }

    fields() is @HpackField {
        fields;
    }
}

object Http2OrdinaryFields {
    has fields is @HpackField;

    Http2OrdinaryFields(origin is Headers, request is bool, stream is int) {
        let checked = try {
            Http2Headers(origin: origin, request: request).headers();
        }
        catch failure is InvalidHeader {
            throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "invalid HTTP2 ordinary field"
            );
        };
        let entries = checked.entries();
        let rows is @HpackField = (0..entries.size()).map() -> index {
            let field = entries.item(index);
            HpackField(name: field.name().string(), value: field.value());
        };
        fields = rows;
    }

    fields() is @HpackField {
        fields;
    }
}

hidden object Http2JoinedFields {
    has fields is @HpackField;

    Http2JoinedFields(prefix is @HpackField, ordinary is @HpackField) {
        let rows is @HpackField = (0..prefix.size() + ordinary.size()).map() -> index {
            if index < prefix.size() {
                prefix[index];
            }
            else {
                ordinary[index - prefix.size()];
            }
        };
        fields = rows;
    }

    fields() is @HpackField {
        fields;
    }
}

object ParsedHttp2Response {
    has status is Status;
    has headers is Headers;

    ParsedHttp2Response(origin is @HpackField, stream is int, end_stream is bool) {
        let section = Http2FieldSection(origin: origin, allowed: [":status"], request: false, stream: stream);
        let value = section.pseudos().value(":status");
        let bytes = Latin1Encoded(value).bytes();
        confirm bytes.size() == 3
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "three status digits required"
            );
        let code is int = bytes.reduce(0) -> number, octet {
            let digit = octet.int();
            confirm digit >= 48 && digit <= 57
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "invalid status digits"
                );
            number * 10 + digit - 48;
        };
        confirm code != 101 && !(code < 200 && end_stream)
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "invalid HTTP2 informational status or end"
            );
        status = try {
            StatusCode(code).status();
        }
        catch failure is InvalidStatus {
            throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "invalid status range");
        };
        headers = section.headers();
    }

    status() is Status {
        status;
    }

    headers() is Headers {
        headers;
    }

    response(body is BodyOpening) is Response {
        Response(status: status, headers: headers, body: body, version: HttpVersion.http_2);
    }
}

object ParsedHttp2Request {
    has method is Method;
    has target is RequestTarget;
    has headers is Headers;
    has scheme is string;
    has authority is UrlParts;

    ParsedHttp2Request(origin is @HpackField, stream is int) {
        let section = Http2FieldSection(
            origin: origin,
            allowed: [":method", ":scheme", ":authority", ":path"],
            request: true,
            stream: stream
        );
        let known = section.pseudos();
        let method = try {
            MethodName(known.value(":method")).method();
        }
        catch failure is InvalidMethod {
            throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "invalid method token");
        };
        let connect = method == Method.connect;
        let scheme = if connect {
            "";
        }
        else {
            HttpAsciiLowercase(known.value(":scheme")).string();
        };
        confirm connect || scheme == "http" || scheme == "https"
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "unsupported request scheme"
            );
        let raw = if known.contains(":authority") {
            known.value(":authority");
        }
        else {
            let hosts = section.headers().values(HeaderName("Host"));
            confirm !connect && hosts.size() == 1
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "authority required"
                );
            hosts.item(0);
        };
        Http2HostAgreement(fields: section.headers(), scheme: scheme, authority: raw, stream: stream);
        let authority = try {
            ParsedUrl("//" + raw).parts();
        }
        catch failure is InvalidUrl {
            throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "invalid authority");
        };
        confirm authority::Parts::path == "" && authority::Parts::query == Maybe<string>.none
            else throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "invalid authority");
        let target is RequestTarget = if connect {
            confirm !known.contains(":scheme") && !known.contains(":path")
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "CONNECT forbids scheme and path"
                );
            try {
                ParsedRequestTarget(origin: raw, method: method).target();
            }
            catch failure is InvalidRequestTarget {
                throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "invalid CONNECT authority target"
                );
            }
        }
        else {
            let path = known.value(":path");
            let checked = try {
                ParsedRequestTarget(origin: path, method: method).target();
            }
            catch failure is InvalidRequestTarget {
                throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "invalid request path");
            };
            confirm checked.kind() == RequestTargetKind.origin
                || checked.kind() == RequestTargetKind.asterisk
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "origin or OPTIONS star path required"
                );
            // Handlers see the origin form whatever the protocol, with the
            // authority in Host, as an HTTP/1.1 request carries it (#497).
            checked;
        };
        self.method = method;
        self.target = target;
        headers = if section.headers().membership(HeaderName("Host")) {
            section.headers();
        }
        else {
            section.headers().addition(Header(name: HeaderName("Host"), value: raw));
        };
        self.scheme = scheme;
        self.authority = authority;
    }

    method() is Method {
        method;
    }

    target() is RequestTarget {
        target;
    }

    headers() is Headers {
        headers;
    }

    scheme() is string {
        scheme;
    }

    // The :authority pseudo-field as authority-only parts.
    authority() is UrlParts {
        authority;
    }

    request(body is BodyOpening) is Request {
        Request(
            method: method,
            target: target,
            headers: headers,
            body: body,
            version: HttpVersion.http_2
        );
    }
}

hidden object Http2StreamCoordinate {
    Http2StreamCoordinate(stream is int) {
        confirm stream > 0 && stream <= 2147483647
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "invalid header stream"
            );
    }
}

object Http2FieldSection {
    has pseudos is Http2PseudoFields;
    has headers is Headers;

    Http2FieldSection(origin is @HpackField, allowed is @string, request is bool, stream is int) {
        Http2StreamCoordinate(stream);
        confirm origin.size() <= 1024
            else throw Http2Fault.detailed(Http2FaultScope.stream, 11, stream, "field count budget");
        let known = Http2PseudoFields(stream);
        let ordinary = Atomic(false);
        let used = Atomic(0);
        for origin -> field {
            confirm field.size() <= 1048576 - used.value()
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    11,
                    stream,
                    "field list budget"
                );
            used.replace(used.value() + field.size());
            let name = field.name();
            confirm name != "" && name == HttpAsciiLowercase(name).string()
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "empty or uppercase field name"
                );
            let pseudo = name.slice(0, 1) == ":";
            if pseudo {
                let permitted is bool = allowed.reduce(false) -> found, key {
                    found || key == name;
                };
                confirm permitted && !ordinary.value() && !known.contains(name)
                    else throw Http2Fault.detailed(
                        Http2FaultScope.stream,
                        1,
                        stream,
                        "unknown duplicate or late pseudo-field"
                    );
                known = known.added(field);
            }
            else {
                ordinary.replace(true);
            }
            let validated = try {
                Header(
                    name: HeaderName(if pseudo {
                        "x";
                    }
                    else {
                        name;
                    }),
                    value: field.value()
                );
            }
            catch failure is InvalidHeader {
                throw Http2Fault.detailed(Http2FaultScope.stream, 1, stream, "invalid field octets");
            };
            confirm validated.value() == field.value()
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    stream,
                    "field edge whitespace"
                );
        }
        let filtered is @HpackField = origin.filter() -> field {
            field.name().slice(0, 1) != ":";
        };
        let entries is @Header = filtered.map() -> field {
            Header(name: HeaderName(field.name()), value: field.value());
        };
        headers = try {
            Http2Headers(origin: Headers(entries, HeaderLimits(1024, 1048576)), request: request).headers();
        }
        catch failure is InvalidHeader {
            throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                stream,
                "connection-specific or invalid TE field"
            );
        };
        pseudos = known;
    }

    pseudos() is Http2PseudoFields {
        pseudos;
    }

    headers() is Headers {
        headers;
    }
}

object Http2PseudoFields {
    has fields is @HpackField;
    has stream is int;

    Http2PseudoFields(stream is int) {
        fields = [];
        self.stream = stream;
    }

    contains(name is string) is bool {
        fields.reduce(false) -> found, field {
            found || field.name() == name;
        };
    }

    value(name is string) is string {
        for fields -> field {
            if field.name() == name {
                return field.value();
            }
        }
        throw Http2Fault.detailed(
            Http2FaultScope.stream,
            1,
            stream,
            "required pseudo-field missing"
        );
    }

    added(field is HpackField) is ^Http2PseudoFields {
        let following is @HpackField = (0..fields.size() + 1).map() -> index {
            if index < fields.size() {
                fields[index];
            }
            else {
                field;
            }
        };
        ^fields = following;
    }
}

test "response pseudo-status stays outside ordinary Headers" {
    let response = ParsedHttp2Response(origin: [HpackField(":status", "200")], stream: 1, end_stream: true);
    test.is(response.status(), Status.ok);
    test.is(response.headers().entries().size(), 0);
}
