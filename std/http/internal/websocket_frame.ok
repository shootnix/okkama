module http/internal/websocket_frame v1.0.0;

// WebSocket frames (RFC 6455 §5): headers, masking and payloads.
//
// Internal to the http modules; programs do not import it.

import "http/websocket" take WebSocketFailure;
import "encoding/binary" take IntegerBytes, Binary, Signedness;
import "encoding/utf" take ByteOrder;
import "http/internal/wire_bytes" take HttpWireBytes;
import "runtime/binary" take binary_masked_slice;
import "io/buffer" take ByteBuffer;

// A frame header: opcode, FIN, payload length and whether it is masked.
object WebSocketFrameHeader {
    has opcode, length is int;
    has final, masked is bool;

    // As given; WebSocketFailure for an opcode or length the protocol refuses.
    WebSocketFrameHeader(opcode is int, final is bool, length is int, masked is bool) {
        confirm opcode == 0
            || opcode == 1
            || opcode == 2
            || opcode == 8
            || opcode == 9
            || opcode == 10
            else throw WebSocketFailure.because("unknown opcode");
        confirm length >= 0 else throw WebSocketFailure.because("negative frame length");
        if opcode >= 8 {
            confirm final && length <= 125
                else throw WebSocketFailure.because("control frame finality or length");
        }
        self.opcode = opcode;
        self.final = final;
        self.length = length;
        self.masked = masked;
    }

    // The opcode.
    opcode() is int {
        opcode;
    }

    // The payload length.
    length() is int {
        length;
    }

    // Whether FIN is set.
    final() is bool {
        final;
    }

    // Whether the payload is masked.
    masked() is bool {
        masked;
    }

    // The header's bytes, with mask when masked.
    bytes(mask is @byte) is @byte {
        confirm mask.size() == if masked {
            4;
        }
        else {
            0;
        }
            else throw WebSocketFailure.because("mask width");
        let first = (opcode + if final {
            128;
        }
        else {
            0;
        }).byte();
        let indicator = if length <= 125 {
            length;
        }
        else {
            if length <= 65535 {
                126;
            }
            else {
                127;
            }
        };
        let second = (indicator + if masked {
            128;
        }
        else {
            0;
        }).byte();
        let extended is @byte = if indicator == 126 {
            IntegerBytes(
                value: length,
                size: 2,
                signedness: Signedness.unsigned,
                order: ByteOrder.big
            ).bytes();
        }
        else {
            if indicator == 127 {
                IntegerBytes(
                    value: length,
                    size: 8,
                    signedness: Signedness.unsigned,
                    order: ByteOrder.big
                ).bytes();
            }
            else {
                let empty is @byte = [];
                empty;
            }
        };
        HttpWireBytes(chunks: [[first, second], extended, mask], maximum: 14).bytes();
    }
}

// Validate everything already decidable from the first two bytes before any
// extended-length or payload read can block on the peer.
object WebSocketHeaderPrefix {
    has origin is @byte;
    has masked is bool;

    // The two bytes; masked says whether frames must be masked.
    WebSocketHeaderPrefix(origin is @byte, masked is bool) {
        self.origin = origin;
        self.masked = masked;
    }

    // Throws WebSocketFailure for reserved bits, an unknown opcode or the wrong
    // masking.
    checked() is void {
        confirm origin.size() >= 2 else throw WebSocketFailure.because("incomplete frame header");
        let first = origin[0].int();
        let second = origin[1].int();
        confirm (first & 112) == 0
            else throw WebSocketFailure.because("unnegotiated reserved bits");
        confirm ((second & 128) != 0) == masked
            else throw WebSocketFailure.because("peer masking direction");
        let opcode = first & 15;
        confirm opcode == 0
            || opcode == 1
            || opcode == 2
            || opcode == 8
            || opcode == 9
            || opcode == 10
            else throw WebSocketFailure.because("unknown opcode");
        if opcode >= 8 {
            confirm (first & 128) != 0 && (second & 127) <= 125
                else throw WebSocketFailure.because("control frame finality or length");
        }
    }
}

// A frame header read from bytes.
object ParsedWebSocketFrameHeader {
    has origin is @byte;
    has masked is bool;
    has maximum is int;

    // Reads origin, expecting masking or not, payloads up to maximum bytes.
    ParsedWebSocketFrameHeader(origin is @byte, masked is bool, maximum is int) {
        self.origin = origin;
        self.masked = masked;
        confirm maximum > 0 && maximum <= 1048576
            else throw WebSocketFailure.because("frame budget");
        self.maximum = maximum;
    }

    // The header; WebSocketFailure when it is not valid.
    header() is WebSocketFrameHeader {
        WebSocketHeaderPrefix(origin: origin, masked: masked).checked();
        let first = origin[0].int();
        let second = origin[1].int();
        let indicator = second & 127;
        let width = if indicator == 126 {
            2;
        }
        else {
            if indicator == 127 {
                8;
            }
            else {
                0;
            }
        };
        confirm origin.size() == 2 + width
            else throw WebSocketFailure.because("exact frame header required");
        if width == 8 {
            confirm origin[2].int() < 128
                else throw WebSocketFailure.because("payload length sign bit");
        }
        let length = if width == 0 {
            indicator;
        }
        else {
            Binary(bytes: origin.slice(2, 2 + width), order: ByteOrder.big).int(Signedness.unsigned);
        };
        confirm (indicator != 126 || length >= 126) && (indicator != 127 || length >= 65536)
            else throw WebSocketFailure.because("nonminimal payload length");
        let opcode = first & 15;
        if opcode < 8 {
            confirm length <= maximum else throw WebSocketFailure.because("data frame byte limit");
        }
        WebSocketFrameHeader(
            opcode: opcode,
            final: (first & 128) != 0,
            length: length,
            masked: masked
        );
    }
}

hidden object WebSocketMaskPosition {
    has index is int;

    WebSocketMaskPosition(index is int) {
        self.index = index;
    }

    index() is int {
        index;
    }

    following(index is int) is ^WebSocketMaskPosition {
        ^index = index;
    }
}

// Bytes XORed with a 4-byte mask.
object WebSocketMaskedBytes {
    has origin, mask is @byte;
    has offset is int;

    // origin masked with mask, starting at offset in the mask.
    WebSocketMaskedBytes(origin is @byte, mask is @byte, offset is int) {
        confirm mask.size() == 4 && offset >= 0 && offset < 4
            else throw WebSocketFailure.because("mask coordinates");
        self.origin = origin;
        self.mask = mask;
        self.offset = offset;
    }

    // The masked bytes; masking twice gives the original.
    bytes() is @byte {
        let output = ByteBuffer();
        defer output.closing().close();
        let writing = output.writing();
        let position = WebSocketMaskPosition(0);
        loop {
            let start = position.index();
            last if start == origin.size();
            let count = if origin.size() - start > 65536 {
                65536;
            }
            else {
                origin.size() - start;
            };
            writing.write(binary_masked_slice(origin, mask, offset, start, count));
            position = position.following(start + count);
        }
        output.content().bytes();
    }
}

// A whole frame.
object WebSocketFrame {
    has opcode is int;
    has final is bool;
    has payload is @byte;

    // A frame of opcode with payload; final sets FIN.
    WebSocketFrame(opcode is int, final is bool, payload is @byte) {
        WebSocketFrameHeader(opcode: opcode, final: final, length: payload.size(), masked: false);
        self.opcode = opcode;
        self.final = final;
        self.payload = payload;
    }

    // The opcode.
    opcode() is int {
        opcode;
    }

    // Whether FIN is set.
    final() is bool {
        final;
    }

    // The payload, unmasked.
    payload() is @byte {
        payload;
    }

    // The frame's bytes, masked with mask when it is not empty.
    bytes(mask is @byte) is @byte {
        confirm mask.size() == 0 || mask.size() == 4
            else throw WebSocketFailure.because("mask width");
        let header = WebSocketFrameHeader(
            opcode: opcode,
            final: final,
            length: payload.size(),
            masked: mask.size() == 4
        ).bytes(
            mask
        );
        let data = if mask.size() == 4 {
            WebSocketMaskedBytes(origin: payload, mask: mask, offset: 0).bytes();
        }
        else {
            payload;
        };
        HttpWireBytes(chunks: [header, data], maximum: 14 + data.size()).bytes();
    }
}

test "WebSocket server frame contains no mask" {
    let frame = WebSocketFrame(opcode: 2, final: true, payload: [0.byte(), 255.byte()]);
    test.is(frame.bytes([]), [130.byte(), 2.byte(), 0.byte(), 255.byte()]);
}
