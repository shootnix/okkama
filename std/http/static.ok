module http/static v1.0.0;

// Files from a directory, with validators, ranges and precompressed variants.
//
//     let files = StaticFiles(root: FileRoot(Directory(Path("public"))), media: StandardMediaTypes(), policy: StaticPolicy());
//     Route(method: Method.get, pattern: RoutePattern("/assets/*file"),
//         handling: StaticFiles(root: root, media: types, policy: StaticPolicy(), random: SecureRandom(),
//             clock: SystemClock(), parameter: "file"));
//
// Paths never leave the root: each name is opened below it without following
// links. Responses carry ETag and Last-Modified, answer conditional and range
// requests, and serve `.br` or `.gz` companions when the policy allows. By
// default index.html is the index, there is no listing, at most 16 ranges and
// 1024 names per directory. web/routing's Files is the usual way in.

import "http/method" take MethodName, Method;
import "fs/root" take FileRoot, RootedEntry;
import "fs/stat" take FileStat, FileKind;
import "fs/error" take FileError;
import "fs/path" take Path;
import "mime/types" take MediaIdentifying, UnknownMediaType, StandardMediaTypes;
import "http/handler" take Handling, HandlingResult, ResponseHandling;
import "http/request_context" take HttpRequestContext;
import "http/message" take Request, Response;
import "http/status" take Status, StatusCode;
import "http/target" take RequestTargetKind, OriginTarget;
import "http/header" take Headers, Header, HeaderName, ReplacedHeader;
import "http/body" take BodyOpening, BodyReading, ByteBody, BodyClosed, BodyAlreadyOpened,
    TrailersUnavailable;
import "http/conditional" take EntityTag, ParsedEntityTags, ByteRanges, ByteRange,
    ConditionalLimits, ConditionalItems, InvalidRange, InvalidEntityTag, ConditionalLimitExceeded;
import "http/date" take HttpDate, ParsedHttpDate, InvalidHttpDate;
import "http/negotiation" take AcceptedContentCodings, NoAcceptableValue, InvalidNegotiation;
import "http/content_coding" take ContentCoding;
import "url/percent" take PercentDecoded, PercentEncoded, UrlComponent, InvalidPercentEncoding;
import "encoding/utf" take Utf8Encoded, Utf8Decoded, InvalidUtf8;
import "html/entities" take EscapedHtml;
import "collections/sequence" take Sequencing;
import "numbers/bigint" take BigInt;
import "strings/parse" take Number;
import "compare" take Order;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "io/stream" take InvalidReadLimit;
import "random/source" take Randomizing, SecureRandom;
import "encoding/hex" take HexEncoded;
import "time/clock" take Timing, SystemClock, Instant;
import "http/routing" take Routes, Route, RoutePattern;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "async/cancellation" take Cancellation;
import "fs/temp" take TemporaryDirectory;
import "fs/directory" take Directory;
import "fs/file" take File, FileMode;
import "digest/sha2" take Sha256;
import "digest/state" take Digesting;

// Policy is immutable; the supplied root is borrowed. Every selected response
// owns an independent descriptor. No joined request path or stat/open pair.
object StaticPolicy {
    has indexes is @string;
    has listing, precompressed is bool;
    has ranges, names is int;
    has cache is string;
    has tags is FileTags;

    // index.html, no listing, no companions, 16 ranges, 1024 names, no
    // Cache-Control, metadata ETags.
    StaticPolicy() {
        indexes = ["index.html"];
        listing = false;
        precompressed = false;
        ranges = 16;
        names = 1024;
        cache = "";
        tags = FileTags.metadata;
    }

    // These indexes, listing and companions, with the other defaults.
    StaticPolicy(indexes is Sequencing<string>, listing is bool, precompressed is bool) {
        let checked = StaticIndexes(indexes);
        self.indexes = checked.values();
        self.listing = listing;
        self.precompressed = precompressed;
        ranges = 16;
        names = 1024;
        cache = "";
        tags = FileTags.metadata;
    }

    // cache: the Cache-Control of every file served, "" for none (#109);
    // tags: how ETags are made, from metadata (the default) or from content.
    StaticPolicy(
        indexes is Sequencing<string>,
        listing is bool,
        precompressed is bool,
        ranges is int,
        names is int,
        cache is string = "",
        tags is FileTags = FileTags.metadata
    ) {
        confirm ranges >= 0 && ranges <= 128 && names >= 0 && names <= 4096
            else throw InvalidStaticPolicy.because("range/listing budget");
        self.indexes = StaticIndexes(indexes).values();
        self.listing = listing;
        self.precompressed = precompressed;
        self.ranges = ranges;
        self.names = names;
        if cache != "" {
            Header(name: HeaderName("Cache-Control"), value: cache);
        }
        self.cache = cache;
        self.tags = tags;
    }

    // The index file names, tried in order.
    indexes() is Sequencing<string> {
        indexes;
    }

    // Listing, companions, ranges, names, Cache-Control and ETags.
    cap Settings {
        listing is bool {
            listing;
        }

        precompressed is bool {
            precompressed;
        }

        ranges is int {
            ranges;
        }

        names is int {
            names;
        }

        cache is string {
            cache;
        }

        tags is FileTags {
            tags;
        }
    }
}

hidden object StaticIndexes {
    has origin is @string;

    StaticIndexes(values is Sequencing<string>) {
        confirm values.size() >= 0 && values.size() <= 32
            else throw InvalidStaticPolicy.because("index count");
        let names is @string = (0..values.size()).map() -> index {
            let name = values.item(index);
            try {
                StaticCoordinate(name);
            }
            catch e is InvalidStaticPath {
                throw InvalidStaticPolicy.because("invalid index coordinate");
            }
            name;
        };
        origin = names;
    }

    values() is @string {
        origin;
    }
}

hidden object StaticCoordinate {
    StaticCoordinate(name is string) {
        confirm name != ""
            && name != "."
            && name != ".."
            && Utf8Encoded(name).bytes().size() <= 255
            && name.split("/").size() == 1
            && name.split("\\").size() == 1
            else throw InvalidStaticPath.invalid;
        for Utf8Encoded(name).bytes() -> octet {
            confirm octet.int() >= 32 && octet.int() != 127 else throw InvalidStaticPath.invalid;
        }
    }
}

hidden object StaticPath {
    has segments is @string;
    has wire, query is string;
    has slash is bool;

    // relative: the file's path below the root when a route parameter holds
    // it, already decoded; none takes the request path.
    StaticPath(request is Request, relative is Maybe<string>) {
        let target = request::Head::target;
        let path = if target.kind() == RequestTargetKind.origin {
            target.path();
        }
        else {
            if target.kind() == RequestTargetKind.absolute {
                let url = target.url();
                url::Parts::path;
            }
            else {
                throw InvalidStaticPath.invalid;
            }
        };
        let raw = if path == "" {
            "/";
        }
        else {
            path;
        };
        confirm raw.length() <= 8192 && raw.slice(0, 1) == "/" else throw InvalidStaticPath.invalid;
        let trailing = raw.slice(raw.length() - 1, raw.length()) == "/";
        slash = trailing;
        wire = raw;
        let q is Maybe<string> = if target.kind() == RequestTargetKind.origin {
            target.query();
        }
        else {
            let url = target.url();
            url::Parts::query;
        };
        query = if q != Maybe<string>.none {
            "?" + (q else "");
        }
        else {
            "";
        };
        // The coordinates come from the raw path, decoded here, or from the
        // route parameter, decoded already; the final slash is the request's.
        let decoded = relative != Maybe<string>.none;
        let given = relative else "";
        let inner = if given.ends_with("/") {
            given.slice(0, given.length() - 1);
        }
        else {
            given;
        };
        let named is @string = if !decoded {
            raw.split("/");
        }
        else {
            if inner == "" {
                [""];
            }
            else {
                ("/" + inner).split("/");
            }
        };
        let parts is @string = if decoded && trailing {
            named + [""];
        }
        else {
            named;
        };
        confirm parts.size() <= 258 else throw InvalidStaticPath.invalid;
        let end = parts.size() - if trailing {
            1;
        }
        else {
            0;
        };
        let coordinates is @string = (1..end).map() -> index {
            let name = if decoded {
                parts[index];
            }
            else {
                try {
                    PercentDecoded(parts[index]).string();
                }
                catch e is InvalidPercentEncoding {
                    throw InvalidStaticPath.invalid;
                }
                catch e is InvalidUtf8 {
                    throw InvalidStaticPath.invalid;
                };
            };
            StaticCoordinate(name);
            name;
        };
        segments = coordinates;
    }

    segments() is @string {
        segments;
    }

    slash() is bool {
        slash;
    }

    redirect() is string {
        wire + "/" + query;
    }
}

// Files below root, answered with validators, ranges and optional precompressed
// companions. The request path names the file, or, with parameter:, the route
// parameter of that name does (a final wildcard, #107):
//
//     Route(method: Method.get, pattern: RoutePattern("/assets/*file"),
//         handling: StaticFiles(root:, media:, policy:, random:, clock:, parameter: "file"))
object StaticFiles does Handling {
    has root is FileRoot;
    has media is MediaIdentifying;
    has policy is StaticPolicy;
    has random is Randomizing;
    has clock is Timing;
    has parameter is string;
    has tagged is Atomic<%string:string>;

    // Files below root, typed by media.
    StaticFiles(root is FileRoot, media is MediaIdentifying, policy is StaticPolicy) {
        self.root = root;
        self.media = media;
        self.policy = policy;
        random = SecureRandom();
        clock = SystemClock();
        parameter = "";
        tagged = Atomic([:]);
    }

    // The same; random makes multipart range boundaries.
    StaticFiles(
        root is FileRoot,
        media is MediaIdentifying,
        policy is StaticPolicy,
        random is Randomizing
    ) {
        self.root = root;
        self.media = media;
        self.policy = policy;
        self.random = random;
        clock = SystemClock();
        parameter = "";
        tagged = Atomic([:]);
    }

    // The same with clock for Date; parameter names the route parameter that
    // holds the path.
    StaticFiles(
        root is FileRoot,
        media is MediaIdentifying,
        policy is StaticPolicy,
        random is Randomizing,
        clock is Timing,
        parameter is string = ""
    ) {
        self.root = root;
        self.media = media;
        self.policy = policy;
        self.random = random;
        self.clock = clock;
        self.parameter = parameter;
        tagged = Atomic([:]);
    }

    // Answers GET and HEAD with the file the request names.
    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        context.cancelling().check();
        let method = MethodName(request::Head::method).string();
        let now = clock.instant();
        if method != "GET" && method != "HEAD" {
            return ResponseHandling(
                Response(
                    status: Status.method_not_allowed,
                    headers: Headers(
                        Header(name: HeaderName("Allow"), value: "GET, HEAD"),
                        Header(name: HeaderName("Date"), value: HttpDate(now).string())
                    )
                )
            );
        }
        let relative = if parameter == "" {
            Maybe<string>.none;
        }
        else {
            Maybe.some(context.parameters()[parameter] else "");
        };
        ResponseHandling(self.answered(request, now, relative));
    }

    // The response for the file at path below root, as a GET of request asks
    // for it (validators and ranges), with the Date of now: web/reply's
    // FileReply (#82). A missing file is 404, a bad path 400.
    file_response(request is Request, path is string) is Response {
        self.answered(request, clock.instant(), Maybe.some(path));
    }

    // The answer to request at now.
    response(request is Request, now is Instant) is Response {
        self.served(request, now, Maybe<string>.none);
    }

    hidden answered(request is Request, now is Instant, relative is Maybe<string>) is Response {
        let response = try {
            self.served(request, now, relative);
        }
        catch e is InvalidStaticPath {
            Response(status: Status.bad_request);
        }
        catch e is InvalidEntityTag {
            Response(status: Status.bad_request);
        }
        catch e is ConditionalLimitExceeded {
            Response(status: Status.bad_request);
        }
        catch e is InvalidNegotiation {
            Response(status: Status.bad_request);
        }
        catch e is NoAcceptableValue {
            Response(
                status: Status.not_acceptable,
                headers: Headers(Header(name: HeaderName("Vary"), value: "Accept-Encoding"))
            );
        }
        catch FileError.not_found(_), FileError.invalid_operation(_), FileError.permission_denied(_), FileError.invalid_text(
            _
        ) {
            Response(status: Status.not_found);
        };
        let headers = ReplacedHeader(
            origin: response::Head::headers,
            entry: Header(name: HeaderName("Date"), value: HttpDate(now).string())
        ).headers();
        Response(
            status: response::Head::status,
            headers: headers,
            body: response.body(),
            version: response::Head::version
        );
    }

    hidden served(request is Request, now is Instant, relative is Maybe<string>) is Response {
        let path = StaticPath(request: request, relative: relative);
        let coordinates = path.segments();
        let opened = root.entry(coordinates);
        let owned = StaticSelection(entry: opened, coding: "");
        defer owned.close_unclaimed();
        let metadata = opened.stat();
        if metadata::Shape::kind == FileKind.directory && !path.slash() {
            return Response(
                status: Status.permanent_redirect,
                headers: Headers(Header(name: HeaderName("Location"), value: path.redirect()))
            );
        }
        let chosen = self.index(coordinates, metadata::Shape::kind == FileKind.directory);
        if metadata::Shape::kind == FileKind.directory {
            if chosen.size() == 0 {
                if !policy::Settings::listing {
                    return Response(status: Status.forbidden);
                }
                return self.listing(opened, request);
            }
            owned.replace(chosen[0].entry(), "", chosen[0].name());
        }
        else {
            confirm metadata::Shape::kind == FileKind.file else throw InvalidStaticPath.invalid;
            if path.slash() {
                return Response(status: Status.not_found);
            }
            owned.name(if coordinates.size() > 0 {
                coordinates[coordinates.size() - 1];
            }
            else {
                "";
            });
        }
        // The opened file answers for itself: an index or a companion is
        // asked once, the same file is not asked again (#108).
        let source = owned.entry();
        let source_stat = if metadata::Shape::kind == FileKind.directory {
            source.stat();
        }
        else {
            metadata;
        };
        let type = try {
            media.type(Path(owned.name())).string();
        }
        catch e is UnknownMediaType {
            "application/octet-stream";
        };
        let companions = self.companions(
            coordinates,
            owned.name(),
            metadata::Shape::kind == FileKind.directory,
            source_stat,
            policy::Settings::precompressed
        );
        let compression = StaticRepresentations(companions);
        defer compression.close();
        if policy::Settings::precompressed {
            let preferences = StaticEncoding(request::Head::headers).codings();
            let rows is @StaticRepresentation = [
                StaticRepresentation(entry: source, coding: "identity")
            ] + companions;
            let available is @ContentCoding = rows.map() -> row {
                ContentCoding(row.coding());
            };
            let selected = preferences.preference(available).string();
            for companions -> row {
                if row.coding() == selected {
                    owned.replace(row.entry(), selected, owned.name());
                    compression.claim(row.coding());
                }
            }
        }
        else {
            confirm StaticEncoding(request::Head::headers).codings().quality(
                ContentCoding("identity")
            ).acceptable()
                else throw NoAcceptableValue.none;
        }
        let file = owned.entry();
        let facts = if owned.coding() == "" {
            source_stat;
        }
        else {
            file.stat();
        };
        confirm facts::Shape::size >= 0 && facts::Shape::size <= 9007199254740991
            else throw InvalidStaticPolicy.because("file size exceeds exact offsets");
        let size = facts::Shape::size;
        let tag = if policy::Settings::tags == FileTags.content {
            self.content_tag(file, facts, owned.coding());
        }
        else {
            StaticValidator(facts: facts, coding: owned.coding()).tag();
        };
        let modified = facts.times().modification();
        let date = HttpDate(if modified.order(now) == Order.greater {
            now;
        }
        else {
            modified;
        });
        let headers = Atomic(
            Headers(
                Header(name: HeaderName("Content-Type"), value: type),
                Header(name: HeaderName("Content-Length"), value: size.string()),
                Header(name: HeaderName("ETag"), value: tag.string()),
                Header(name: HeaderName("Last-Modified"), value: date.string()),
                Header(name: HeaderName("Accept-Ranges"), value: "bytes")
            )
        );
        if policy::Settings::cache != "" {
            headers.replace(
                headers.value().addition(
                    Header(name: HeaderName("Cache-Control"), value: policy::Settings::cache)
                )
            );
        }
        if policy::Settings::precompressed {
            headers.replace(
                ReplacedHeader(
                    origin: headers.value(),
                    entry: Header(name: HeaderName("Vary"), value: "Accept-Encoding")
                ).headers()
            );
        }
        if owned.coding() != "" {
            headers.replace(
                ReplacedHeader(
                    origin: headers.value(),
                    entry: Header(name: HeaderName("Content-Encoding"), value: owned.coding())
                ).headers()
            );
        }
        let decision = StaticPreconditions(
            head: request::Head::headers,
            tag: tag,
            date: date,
            reference: now
        ).status();
        if decision == 304 {
            return Response(status: Status.not_modified, headers: headers.value());
        }
        if decision == 412 {
            return Response(
                status: Status.precondition_failed,
                headers: Headers(Header(name: HeaderName("ETag"), value: tag.string()))
            );
        }
        if request::Head::method == Method.head {
            return Response(status: Status.ok, headers: headers.value());
        }
        let range = StaticRanges(
            head: request::Head::headers,
            size: size,
            maximum: policy::Settings::ranges
        );
        let ranges = range.values();
        let apply = range.present()
            && StaticIfRange(head: request::Head::headers, tag: tag, date: date).allowed();
        if apply && ranges.size() == 0 {
            return Response(
                status: Status.range_not_satisfiable,
                headers: Headers(
                    Header(name: HeaderName("Content-Range"), value: "bytes */" + size.string()),
                    Header(name: HeaderName("ETag"), value: tag.string())
                )
            );
        }
        let pieces is ConditionalItems<StaticPiece> = ConditionalItems();
        let status = if apply {
            206;
        }
        else {
            200;
        };
        if apply {
            if ranges.size() == 1 {
                let part = ranges[0];
                headers.replace(
                    ReplacedHeader(
                        origin: headers.value(),
                        entry: Header(
                            HeaderName("Content-Range"),
                            "bytes " + part.string() + "/" + size.string()
                        )
                    ).headers()
                );
                pieces = pieces.following(
                    StaticPiece(
                        start: part.start().int(),
                        size: part.size().int()
                    )
                );
            }
            else {
                let boundary = "okkama-" + HexEncoded(random.bytes(24)).string();
                headers.replace(
                    ReplacedHeader(
                        origin: headers.value(),
                        entry: Header(
                            HeaderName("Content-Type"),
                            "multipart/byteranges; boundary=" + boundary
                        )
                    ).headers()
                );
                for ranges -> part {
                    pieces = pieces.following(
                        StaticPiece(
                            "--" + boundary + "\r\nContent-Type: " + type + "\r\nContent-Range: bytes " + part.string() + "/" + size.string() + "\r\n\r\n"
                        )
                    );
                    pieces = pieces.following(
                        StaticPiece(
                            start: part.start().int(),
                            size: part.size().int()
                        )
                    );
                    pieces = pieces.following(StaticPiece("\r\n"));
                }
                pieces = pieces.following(StaticPiece("--" + boundary + "--\r\n"));
            }
        }
        else {
            pieces = pieces.following(StaticPiece(start: 0, size: size));
        }
        let body = StaticBody(entry: file, pieces: pieces.values());
        headers.replace(
            ReplacedHeader(
                origin: headers.value(),
                entry: Header(name: HeaderName("Content-Length"), value: body.length().string())
            ).headers()
        );
        owned.claim();
        Response(status: StatusCode(status).status(), headers: headers.value(), body: body);
    }

    // A strong ETag from the bytes of the file, the same on every replica
    // (#109). It is computed once per version of a file (its identity, size and
    // times) and kept for at most 4096 versions.
    hidden content_tag(file is RootedEntry, facts is FileStat, coding is string) is EntityTag {
        let version = StaticValidator(facts: facts, coding: coding).tag().string();
        let known = tagged.value();
        if known.has(version) {
            return EntityTag(value: known[version], weak: false);
        }
        let digest = StaticDigest(entry: file, size: facts::Shape::size).hex().slice(0, 32);
        let value = if coding == "" {
            digest;
        }
        else {
            digest + "-" + coding;
        };
        let kept is %string:string = if known.size() >= 4096 {
            [:];
        }
        else {
            known;
        };
        tagged.replace(kept + [version: value]);
        EntityTag(value: value, weak: false);
    }

    // The index files of a directory at coordinates.
    index(coordinates is @string, directory is bool) is @StaticIndexFile {
        if !directory {
            let empty is @StaticIndexFile = [];
            return empty;
        }
        for policy.indexes() -> name {
            let parts is @string = coordinates + [name];
            let candidates is @RootedEntry = try {
                [root.entry(parts)];
            }
            catch FileError.not_found(_), FileError.invalid_operation(_) {
                [];
            };
            if candidates.size() == 1 {
                let candidate = candidates[0];
                if candidate.stat()::Shape::kind == FileKind.file {
                    return [StaticIndexFile(entry: candidate, name: name)];
                }
                candidate.close();
            }
        }
        let empty is @StaticIndexFile = [];
        empty;
    }

    // The precompressed variants of a file, when enabled.
    companions(
        coordinates is @string,
        name is string,
        directory is bool,
        facts is FileStat,
        enabled is bool
    ) is @StaticRepresentation {
        if !enabled {
            let empty is @StaticRepresentation = [];
            return empty;
        }
        let base is @string = if directory {
            coordinates + [name];
        }
        else {
            coordinates;
        };
        let groups is @@StaticRepresentation = ["br", "gzip"].map() -> coding {
            let suffix = if coding == "br" {
                ".br";
            }
            else {
                ".gz";
            };
            let parts is @string = (0..base.size()).map() -> index {
                if index + 1 == base.size() {
                    base[index] + suffix;
                }
                else {
                    base[index];
                }
            };
            let candidates is @RootedEntry = try {
                [root.entry(parts)];
            }
            catch FileError.not_found(_), FileError.invalid_operation(_) {
                [];
            };
            if candidates.size() == 1 {
                let candidate = candidates[0];
                let metadata = candidate.stat();
                if metadata::Shape::kind == FileKind.file
                    && metadata.times().modification().order(facts.times().modification()) == Order.equal {
                        return [StaticRepresentation(entry: candidate, coding: coding)];
                    }
                candidate.close();
            }
            let empty is @StaticRepresentation = [];
            empty;
        };
        let result is ConditionalItems<StaticRepresentation> = ConditionalItems();
        for groups -> group {
            for group -> row {
                result = result.following(row);
            }
        }
        result.values();
    }

    // An HTML listing of directory.
    listing(directory is RootedEntry, request is Request) is Response {
        let names = directory.names(policy::Settings::names);
        let text = Atomic("<!doctype html><meta charset=\"utf-8\"><title>Directory</title><ul>");
        let used = Atomic(text.value().length());
        for names -> name {
            let href = PercentEncoded(origin: name, component: UrlComponent.data).string();
            let row = "<li><a href=\"./" + EscapedHtml(origin: href, quotes: true).string() + "\">" + EscapedHtml(
                name
            ).string() + "</a></li>";
            let width = Utf8Encoded(row).bytes().size();
            confirm width <= 1048576 - used.value()
                else throw InvalidStaticPolicy.because("listing byte budget");
            used.replace(used.value() + width);
            text.replace(text.value() + row);
        }
        let bytes = Utf8Encoded(text.value() + "</ul>").bytes();
        let headers = Headers(
            Header(name: HeaderName("Content-Type"), value: "text/html; charset=utf-8"),
            Header(name: HeaderName("Content-Length"), value: bytes.size().string()),
            Header(name: HeaderName("Cache-Control"), value: "no-store")
        );
        if request::Head::method == Method.head {
            Response(status: Status.ok, headers: headers);
        }
        else {
            Response(status: Status.ok, headers: headers, body: ByteBody(bytes));
        }
    }
}

hidden object StaticSelection {
    has current is Atomic<RootedEntry>;
    has encoding, name is Atomic<string>;
    has claimed is Event;

    StaticSelection(entry is RootedEntry, coding is string) {
        current = Atomic(entry);
        encoding = Atomic(coding);
        name = Atomic("");
        claimed = Event();
    }

    entry() is RootedEntry {
        current.value();
    }

    coding() is string {
        encoding.value();
    }

    name() is string {
        name.value();
    }

    name(value is string) is void {
        name.replace(value);
    }

    replace(entry is RootedEntry, coding is string, name is string) is void {
        current.value().close();
        current.replace(entry);
        encoding.replace(coding);
        self.name.replace(name);
    }

    claim() is void {
        claimed.set();
    }

    close_unclaimed() is void {
        if !claimed.ready() {
            current.value().close();
        }
    }
}

// An index file found in a directory.
object StaticIndexFile {
    has entry is RootedEntry;
    has name is string;

    // entry called name.
    StaticIndexFile(entry is RootedEntry, name is string) {
        self.entry = entry;
        self.name = name;
    }

    // The file.
    entry() is RootedEntry {
        entry;
    }

    // Its name.
    name() is string {
        name;
    }
}

// A file or one of its precompressed companions.
object StaticRepresentation {
    has entry is RootedEntry;
    has coding is string;

    // entry with its content coding ("" for none).
    StaticRepresentation(entry is RootedEntry, coding is string) {
        self.entry = entry;
        self.coding = coding;
    }

    // The file.
    entry() is RootedEntry {
        entry;
    }

    // Its content coding.
    coding() is string {
        coding;
    }
}

hidden object StaticRepresentations {
    has rows is @StaticRepresentation;
    has claimed is Atomic<string>;

    StaticRepresentations(rows is @StaticRepresentation) {
        self.rows = rows;
        claimed = Atomic("");
    }

    claim(coding is string) is void {
        claimed.replace(coding);
    }

    close() is void {
        for rows -> row {
            if row.coding() != claimed.value() {
                row.entry().close();
            }
        }
    }
}

hidden object StaticEncoding {
    has head is Headers;

    StaticEncoding(head is Headers) {
        self.head = head;
    }

    codings() is AcceptedContentCodings {
        let fields = head.values(HeaderName("Accept-Encoding"));
        if fields.size() == 0 {
            AcceptedContentCodings();
        }
        else {
            let text is @string = fields.map() -> field {
                field;
            };
            AcceptedContentCodings(text.join(","));
        }
    }
}

hidden object StaticValidator {
    has tag is EntityTag;

    StaticValidator(facts is FileStat, coding is string) {
        let value = facts.identity()::Identity::device.string() + "-" + facts.identity().inode().string() + "-" + facts::Shape::size.string() + "-" + facts.times().modification().unix_duration()::Span::seconds.int().string() + "-" + facts.times().change().unix_duration()::Span::seconds.int().string() + "-" + coding;
        tag = EntityTag(value: value, weak: true);
    }

    tag() is EntityTag {
        tag;
    }
}

hidden object StaticPreconditions {
    has head is Headers;
    has tag is EntityTag;
    has date is HttpDate;
    has reference is Instant;

    StaticPreconditions(head is Headers, tag is EntityTag, date is HttpDate, reference is Instant) {
        self.head = head;
        self.tag = tag;
        self.date = date;
        self.reference = reference;
    }

    status() is int {
        let matches = head.values(HeaderName("If-Match"));
        if matches.size() > 0 {
            let strings is @string = matches.map() -> field {
                field;
            };
            if !ParsedEntityTags(strings.join(",")).tags().strong_matches(tag) {
                return 412;
            }
        }
        else {
            let fields = head.values(HeaderName("If-Unmodified-Since"));
            if fields.size() == 1 {
                let valid is @HttpDate = try {
                    [
                        HttpDate(
                            ParsedHttpDate(origin: fields.item(0), reference: reference).instant()
                        )
                    ];
                }
                catch e is InvalidHttpDate {
                    [];
                };
                if valid.size() == 1 && date.order(valid[0]) == Order.greater {
                    return 412;
                }
            }
        }
        let none_matches = head.values(HeaderName("If-None-Match"));
        if none_matches.size() > 0 {
            let strings is @string = none_matches.map() -> field {
                field;
            };
            if ParsedEntityTags(strings.join(",")).tags().weak_matches(tag) {
                return 304;
            }
        }
        else {
            let fields = head.values(HeaderName("If-Modified-Since"));
            if fields.size() == 1 {
                let valid is @HttpDate = try {
                    [
                        HttpDate(
                            ParsedHttpDate(origin: fields.item(0), reference: reference).instant()
                        )
                    ];
                }
                catch e is InvalidHttpDate {
                    [];
                };
                if valid.size() == 1 && date.order(valid[0]) != Order.greater {
                    return 304;
                }
            }
        }
        200;
    }
}

// Metadata validators are weak; no date-only or tag If-Range can certify byte
// identity under in-place filesystem mutation. Such requests receive full 200.
hidden object StaticIfRange {
    has head is Headers;

    StaticIfRange(head is Headers, tag is EntityTag, date is HttpDate) {
        self.head = head;
    }

    allowed() is bool {
        head.values(HeaderName("If-Range")).size() == 0;
    }
}

hidden object StaticRanges {
    has ranges is @ByteRange;
    has present is bool;

    StaticRanges(head is Headers, size is int, maximum is int) {
        let fields = head.values(HeaderName("Range"));
        let empty is @ByteRange = [];
        let selected = Atomic(empty);
        let accepted = Atomic(false);
        if fields.size() == 1 && maximum > 0 {
            let parsed is @ByteRange = try {
                let entries = ByteRanges(
                    origin: fields.item(0),
                    limits: ConditionalLimits(8192, maximum)
                ).ranges(
                    BigInt(size)
                );
                accepted.replace(true);
                (0..entries.size()).map() -> index {
                    entries.item(index);
                };
            }
            catch e is InvalidRange {
                [];
            }
            catch e is ConditionalLimitExceeded {
                [];
            };
            selected.replace(parsed);
        }
        ranges = selected.value();
        present = accepted.value();
    }

    values() is @ByteRange {
        ranges;
    }

    present() is bool {
        present;
    }
}

hidden object StaticPiece {
    has data is @byte;
    has start, size is int;
    has file is bool;

    StaticPiece(text is string) {
        data = Utf8Encoded(text).bytes();
        size = self.data.size();
        start = 0;
        file = false;
    }

    StaticPiece(start is int, size is int) {
        data = [];
        self.start = start;
        self.size = size;
        file = true;
    }

    size() is int {
        size;
    }

    file() is bool {
        file;
    }

    start() is int {
        start;
    }

    bytes(start is int, size is int) is @byte {
        (start..start + size).map() -> index {
            data[index];
        };
    }
}

hidden object StaticBody does BodyOpening {
    has reading is StaticBodyReading;
    has size is int;
    has opened is Atomic<bool>;

    StaticBody(entry is RootedEntry, pieces is @StaticPiece) {
        size = pieces.reduce(0) -> used, piece {
            confirm piece.size() <= 9007199254740991 - used
                else throw InvalidStaticPolicy.because("response byte budget");
            used + piece.size();
        };
        reading = StaticBodyReading(entry: entry, pieces: pieces);
        opened = Atomic(false);
    }

    length() is BigInt {
        BigInt(size);
    }

    replayable() is bool {
        false;
    }

    // The whole body when it is already in memory (#115).
    contained() is Maybe<@byte> {
        Maybe<@byte>.none;
    }

    reading() is BodyReading {
        confirm opened.compare_and_replace(false, true) else throw BodyAlreadyOpened.opened;
        reading;
    }

    destroy {
        if !opened.value() {
            reading.close();
        }
    }
}

hidden object StaticBodyReading does BodyReading {
    has entry is RootedEntry;
    has pieces is @StaticPiece;
    has index, offset is Atomic<int>;
    has stopped, finished is Event;

    StaticBodyReading(entry is RootedEntry, pieces is @StaticPiece) {
        self.entry = entry;
        self.pieces = pieces;
        index = Atomic(0);
        offset = Atomic(0);
        stopped = Event();
        finished = Event();
    }

    closed() is bool {
        stopped.ready();
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            entry.close();
        }
    }

    trailers() is Headers {
        confirm finished.ready() else throw TrailersUnavailable.unavailable;
        Headers();
    }

    async bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        confirm !self.closed() else throw BodyClosed.closed;
        if finished.ready() {
            return [];
        }
        let complete = Event();
        let cleanup = StaticReadCleanup(source: self, complete: complete);
        defer cleanup.close();
        loop {
            if index.value() == pieces.size() {
                entry.close();
                finished.set();
                complete.set();
                return [];
            }
            let piece = pieces[index.value()];
            let remaining = piece.size() - offset.value();
            if remaining == 0 {
                index.replace(index.value() + 1);
                offset.replace(0);
                next;
            }
            let maximum = if limit < 65536 {
                limit;
            }
            else {
                65536;
            };
            let amount = if remaining < maximum {
                remaining;
            }
            else {
                maximum;
            };
            let bytes = if piece.file() {
                await entry.piece(offset: piece.start() + offset.value(), limit: amount);
            }
            else {
                piece.bytes(offset.value(), amount);
            };
            confirm bytes.size() > 0 && bytes.size() <= amount else throw StaticFileChanged.changed;
            offset.replace(offset.value() + bytes.size());
            complete.set();
            return bytes;
        }
    }

    destroy {
        self.close();
    }
}

hidden object StaticReadCleanup {
    has source is StaticBodyReading;
    has complete is Event;

    StaticReadCleanup(source is StaticBodyReading, complete is Event) {
        self.source = source;
        self.complete = complete;
    }

    close() is void {
        if !complete.ready() {
            source.close();
        }
    }
}

// How a file's ETag is made (#109): metadata from its identity, size and times
// (the default, cheap, different on each replica), content from its bytes
// (read once per version of the file, the same on every replica).
enum FileTags = (metadata, content);

// The SHA-256 of a file's bytes, read in 64 KiB pieces.
hidden object StaticDigest {
    has entry is RootedEntry;
    has size is int;

    StaticDigest(entry is RootedEntry, size is int) {
        self.entry = entry;
        self.size = size;
    }

    hex() is string {
        let count = ((size + 65535) / 65536).int();
        let start is Digesting = Sha256();
        let digest is Digesting = (0..count).reduce(start) -> state, index {
            let following is Digesting = state.state(entry.bytes_at(index * 65536, 65536));
            following;
        };
        digest.hex();
    }
}

enum InvalidStaticPath is Error = (invalid);

enum InvalidStaticPolicy is Error = (because(reason is string));

enum StaticFileChanged is Error = (changed);

test "static policy defaults bound ranges and disable optional file modes" {
    let policy = StaticPolicy();
    test.ok(!policy::Settings::listing && !policy::Settings::precompressed);
    test.is(policy::Settings::ranges, 16);
    test.is(policy::Settings::names, 1024);
    test.ok(try {
        StaticPolicy(indexes: ["../outside"], listing: false, precompressed: false);
        false;
    }
    catch e is InvalidStaticPolicy {
        true;
    });
}

// What a table answers to a GET of path with headers: the response and its body.
hidden object StaticDispatch {
    has routes is Routes;

    StaticDispatch(routes is Routes) {
        self.routes = routes;
    }

    async get(path is string, headers is Headers) is Response {
        let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
            local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
            remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: 50000)
        );
        let context = HttpRequestContext(
            details: ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1),
            cancellation: Cancellation().cancelling()
        );
        let request = Request(
            target: OriginTarget(path: path, query: Maybe<string>.none),
            headers: headers
        );
        (await routes.handling(request, context)).response();
    }
}

hidden object StaticText {
    has response is Response;

    StaticText(response is Response) {
        self.response = response;
    }

    async text() is string {
        let input = response.body().reading();
        defer input.close();
        let pieces = Atomic("");
        loop {
            let chunk = await input.bytes(65536);
            if chunk.size() == 0 {
                last;
            }
            pieces.replace(pieces.value() + Utf8Decoded(chunk).string());
        }
        pieces.value();
    }
}

async test "files are served below a route parameter with a cache rule and content tags" {
    let scratch = TemporaryDirectory(
        parent: Directory(path: Path(".")),
        prefix: "http-static-test-"
    );
    let base = scratch.path();
    Directory(path: base.child("css")).create();
    let style = File(path: base.child("css").child("site.css"), mode: FileMode.writing);
    style.text().write("body{}");
    style.close();
    let index = File(path: base.child("index.html"), mode: FileMode.writing);
    index.text().write("<h1>hi</h1>");
    index.close();
    let root = FileRoot(directory: Directory(path: base));
    let policy = StaticPolicy(
        indexes: ["index.html"],
        listing: false,
        precompressed: false,
        ranges: 16,
        names: 1024,
        cache: "public, max-age=60",
        tags: FileTags.content
    );
    let files = StaticFiles(
        root: root,
        media: StandardMediaTypes(),
        policy: policy,
        random: SecureRandom(),
        clock: SystemClock(),
        parameter: "file"
    );
    let table = StaticDispatch(
        Routes(
            routes: [
                Route(method: Method.get, pattern: RoutePattern("/assets/*file"), handling: files)
            ],
            fallback: files
        )
    );
    let page = await table.get("/assets/css/site.css", Headers());
    test.is(page::Head::status, Status.ok);
    test.is(page::Head::headers.text("Cache-Control"), "public, max-age=60");
    let tag = page::Head::headers.text("ETag");
    test.is(tag, "\"" + Sha256("body{}").hex().slice(0, 32) + "\"");
    test.is(await StaticText(page).text(), "body{}");
    test.is((await table.get("/assets/css/site.css", Headers()))::Head::headers.text("ETag"), tag);
    let unchanged = await table.get(
        "/assets/css/site.css",
        Headers(Header(name: "If-None-Match", value: tag))
    );
    test.is(unchanged::Head::status, Status.not_modified);
    test.is(unchanged::Head::headers.text("Cache-Control"), "public, max-age=60");
    let directory = await table.get("/assets", Headers());
    test.is(directory::Head::status, Status.permanent_redirect);
    test.is(directory::Head::headers.text("Location"), "/assets/");
    test.is(await StaticText(await table.get("/assets/", Headers())).text(), "<h1>hi</h1>");
    test.is((await table.get("/assets/missing.txt", Headers()))::Head::status, Status.not_found);
    let request = Request(target: OriginTarget(path: "/download", query: Maybe<string>.none));
    let one = files.file_response(request, "css/site.css");
    test.is(one::Head::status, Status.ok);
    test.is(await StaticText(one).text(), "body{}");
    test.is(files.file_response(request, "../secret")::Head::status, Status.bad_request);
    root.close();
    scratch.close();
}
