module http/http1_framing v1.0.0;

import "http/method" take Method;
import "http/status" take StatusCode, Status, StatusClass;
import "http/http1_head" take Http1RequestHead, Http1ResponseHead, Http1Limits, Http1LimitExceeded,
    ParsedHttp1RequestHead;
import "http/message" take InvalidHttpMessage;
import "http/header" take Headers, Header, HeaderName, HttpAsciiLowercase;
import "http/token" take HttpToken, InvalidToken;
import "http/version" take HttpVersion;
import "http/body" take UnknownBodyLength;
import "numbers/bigint" take BigInt, InvalidBigInt;
import "compare" take Order;

enum Http1BodyKind = (empty, fixed, chunked, close_delimited, tunnel, upgrade);

// Immutable decision only. Eligibility requires actual clean body completion;
// this value neither reads bytes nor grants a connection lease.
object Http1BodyPlan {
    has kind is Http1BodyKind;
    has count is BigInt;
    has reusable is bool;

    Http1BodyPlan(kind is Http1BodyKind, count is BigInt, reusable is bool) {
        confirm count.sign() >= 0
            else throw InvalidHttpMessage.because("negative body plan length");
        confirm kind == Http1BodyKind.fixed || count.sign() == 0
            else throw InvalidHttpMessage.because("nonfixed body plan length");
        self.kind = kind;
        self.count = count;
        self.reusable = reusable
            && kind != Http1BodyKind.close_delimited
            && kind != Http1BodyKind.tunnel
            && kind != Http1BodyKind.upgrade;
    }

    kind() is Http1BodyKind {
        kind;
    }

    length() is BigInt {
        confirm kind == Http1BodyKind.empty || kind == Http1BodyKind.fixed
            else throw UnknownBodyLength.unknown;
        count;
    }

    reuse_after_eof() is bool {
        reusable;
    }
}

object Http1RequestFraming {
    has head is Http1RequestHead;
    has limits is Http1Limits;

    Http1RequestFraming(head is Http1RequestHead) {
        self.head = head;
        limits = Http1Limits();
    }

    Http1RequestFraming(head is Http1RequestHead, limits is Http1Limits) {
        self.head = head;
        self.limits = limits;
    }

    plan() is Http1BodyPlan {
        let fields = Http1FramingFields(head.headers(), head.version(), limits);
        let reuse = fields.reusable();
        let length = fields.length();
        let codings = fields.codings();
        confirm length.size() == 0 || codings.size() == 0
            else throw InvalidHttpMessage.because("Transfer-Encoding with Content-Length");
        if codings.size() > 0 {
            fields.supported(codings);
            return Http1BodyPlan(Http1BodyKind.chunked, BigInt("0"), reuse);
        }
        if length.size() > 0 {
            return fields.fixed(length[0], reuse);
        }
        Http1BodyPlan(Http1BodyKind.empty, BigInt("0"), reuse);
    }
}

object Http1ResponseFraming {
    has head is Http1ResponseHead;
    has method is Method;
    has limits is Http1Limits;

    Http1ResponseFraming(head is Http1ResponseHead, method is Method) {
        self.head = head;
        self.method = method;
        limits = Http1Limits();
    }

    Http1ResponseFraming(head is Http1ResponseHead, method is Method, limits is Http1Limits) {
        self.head = head;
        self.method = method;
        self.limits = limits;
    }

    plan() is Http1BodyPlan {
        let status = head.status();
        let class = StatusCode(status).class();
        if method == Method.connect && class == StatusClass.successful {
            return Http1BodyPlan(Http1BodyKind.tunnel, BigInt("0"), false);
        }
        let fields = Http1FramingFields(head.headers(), head.version(), limits);
        let length = fields.length();
        let codings = fields.codings();
        confirm length.size() == 0 || codings.size() == 0
            else throw InvalidHttpMessage.because("Transfer-Encoding with Content-Length");
        if class == StatusClass.informational || status == Status.no_content {
            confirm length.size() == 0 && codings.size() == 0
                else throw InvalidHttpMessage.because("framing field on body-forbidden status");
            if status == Status.switching_protocols {
                return Http1BodyPlan(Http1BodyKind.upgrade, BigInt("0"), false);
            }
            return Http1BodyPlan(Http1BodyKind.empty, BigInt("0"), fields.reusable());
        }
        if method == Method.head || status == Status.not_modified {
            return Http1BodyPlan(Http1BodyKind.empty, BigInt("0"), fields.reusable());
        }
        if codings.size() > 0 {
            fields.supported(codings);
            return Http1BodyPlan(Http1BodyKind.chunked, BigInt("0"), fields.reusable());
        }
        if length.size() > 0 {
            return fields.fixed(length[0], fields.reusable());
        }
        Http1BodyPlan(Http1BodyKind.close_delimited, BigInt("0"), false);
    }
}

object Http1FramingFields {
    has origin is Headers;
    has version is HttpVersion;
    has limits is Http1Limits;

    Http1FramingFields(origin is Headers, version is HttpVersion, limits is Http1Limits) {
        confirm version != HttpVersion.http_2
            else throw InvalidHttpMessage.because("HTTP1 body plan requires HTTP1 version");
        let entries = origin.entries();
        confirm entries.size() <= limits.fields() else throw Http1LimitExceeded.kind("fields");
        let size = (0..entries.size()).reduce(0) -> used, index {
            let entry = entries.item(index);
            let width = entry.name().string().length() + entry.value().length() + 3;
            confirm width - 2 <= limits.line_bytes()
                else throw Http1LimitExceeded.kind("line_bytes");
            confirm width <= limits.head_bytes() - used
                else throw Http1LimitExceeded.kind("head_bytes");
            used + width;
        };
        self.origin = origin;
        self.version = version;
        self.limits = limits;
    }

    list(name is string) is @string {
        let values = origin.values(HeaderName(name));
        if values.size() == 0 {
            let empty is @string = [];
            return empty;
        }
        let count = (0..values.size()).reduce(0) -> used, index {
            let amount = values.item(index).split(",").size();
            confirm amount <= 16 - used else throw Http1LimitExceeded.kind("framing_items");
            used + amount;
        };
        let joined = (0..values.size()).reduce("") -> all, index {
            if index == 0 {
                values.item(index);
            }
            else {
                all + "," + values.item(index);
            }
        };
        let items = joined.split(",");
        let clean is @string = items.map() -> value {
            let part = Header(HeaderName(name), value).value();
            confirm part != "" else throw InvalidHttpMessage.because("empty framing list member");
            part;
        };
        clean;
    }

    length() is @BigInt {
        let values = self.list("Content-Length");
        if values.size() == 0 {
            let empty is @BigInt = [];
            return empty;
        }
        let original = values[0];
        confirm original.length() <= 1024 else throw Http1LimitExceeded.kind("length_digits");
        confirm original.slice(0, 1) != "-"
            else throw InvalidHttpMessage.because("unsigned Content-Length required");
        let parsed = try {
            BigInt(original);
        }
        catch e is InvalidBigInt {
            throw InvalidHttpMessage.because("decimal Content-Length required");
        };
        for values -> value {
            confirm value == original
                else throw InvalidHttpMessage.because("conflicting Content-Length lexemes");
        }
        [parsed];
    }

    codings() is @string {
        let values = self.list("Transfer-Encoding");
        confirm values.size() == 0 || version != HttpVersion.http_1_0
            else throw InvalidHttpMessage.because("Transfer-Encoding on HTTP1.0");
        let canonical is @string = values.map() -> value {
            let token = try {
                HttpToken(value).string();
            }
            catch e is InvalidToken {
                throw InvalidHttpMessage.because("transfer coding token required");
            };
            HttpAsciiLowercase(token).string();
        };
        for (0..canonical.size()) -> index {
            if canonical[index] == "chunked" {
                confirm index == canonical.size() - 1
                    else throw InvalidHttpMessage.because("chunked must occur once and last");
            }
        }
        canonical;
    }

    supported(codings is @string) is void {
        confirm codings.size() > 0 && codings[codings.size() - 1] == "chunked"
            else throw InvalidHttpMessage.because("final chunked transfer coding required");
        for codings -> coding {
            confirm coding == "chunked" else throw UnsupportedTransferCoding.unsupported;
        }
    }

    fixed(length is BigInt, reuse is bool) is Http1BodyPlan {
        confirm length.order(BigInt(limits.body_bytes().string())) != Order.greater
            else throw Http1LimitExceeded.kind("body_bytes");
        Http1BodyPlan(Http1BodyKind.fixed, length, reuse);
    }

    reusable() is bool {
        let values = self.list("Connection");
        let canonical is @string = values.map() -> value {
            let token = try {
                HttpToken(value).string();
            }
            catch e is InvalidToken {
                throw InvalidHttpMessage.because("Connection token required");
            };
            HttpAsciiLowercase(token).string();
        };
        let closing = canonical.reduce(false) -> found, value {
            found || value == "close";
        };
        let keeping = canonical.reduce(false) -> found, value {
            found || value == "keep-alive";
        };
        !closing && (version == HttpVersion.http_1_1 || keeping);
    }
}

enum UnsupportedTransferCoding is Error = (unsupported);

test "request body boundaries are decided before reading" {
    let head = ParsedHttp1RequestHead("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n").value();
    let plan = Http1RequestFraming(head).plan();
    test.ok(plan.kind() == Http1BodyKind.fixed && plan.length().string() == "0");
}
