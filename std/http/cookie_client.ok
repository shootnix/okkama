module http/cookie_client v1.0.0;

import "http/exchange" take ClientResponse, Exchanging;
import "http/message" take Request;
import "http/target" take RequestTargetKind;
import "http/header" take Header, HeaderName, HeadersWithout;
import "http/cookie_jar" take CookieStoring;
import "http/cookie_policy" take CookieContext;
import "http/cookie" take Cookie;
import "http/redirect" take RedirectResponseCleanup;
import "collections/sequence" take Sequencing;
import "async/event" take Event;
import "async/atomic" take Atomic;
import "error" take InvalidArgument;
import "http/target" take AbsoluteTarget;
import "http/method" take Method;
import "http/header" take Headers;
import "url/value" take ParsedUrl;

role CookieContextualizing {
    context(request is Request) is CookieContext;
}

object FirstPartyCookies does CookieContextualizing {
    FirstPartyCookies();

    context(request is Request) is CookieContext {
        confirm request::Head::target.kind() == RequestTargetKind.absolute
            else throw InvalidArgument.because("absolute cookie request required");
        CookieContext(
            site: request::Head::target.url(),
            top_level: true,
            method: request::Head::method
        );
    }
}

enum CallerCookiePolicy = (reject, preserve, replace);

object CookieExchanging does Exchanging {
    has origin is Exchanging;
    has jar is CookieStoring;
    has contexts is CookieContextualizing;
    has conflict is CallerCookiePolicy;

    CookieExchanging(origin is Exchanging, jar is CookieStoring, contexts is CookieContextualizing) {
        self.origin = origin;
        self.jar = jar;
        self.contexts = contexts;
        conflict = CallerCookiePolicy.reject;
    }

    CookieExchanging(
        origin is Exchanging,
        jar is CookieStoring,
        contexts is CookieContextualizing,
        conflict is CallerCookiePolicy
    ) {
        self.origin = origin;
        self.jar = jar;
        self.contexts = contexts;
        self.conflict = conflict;
    }

    async response(request is Request) is ClientResponse {
        confirm request::Head::target.kind() == RequestTargetKind.absolute
            else throw InvalidArgument.because("absolute cookie request required");
        let supplied = request::Head::headers.values(HeaderName("Cookie"));
        confirm supplied.size() <= 1
            && (supplied.size() == 0 || conflict != CallerCookiePolicy.reject)
            else throw CallerCookieConflict.conflict;
        let context = contexts.context(request);
        let fields = if supplied.size() == 1 && conflict == CallerCookiePolicy.preserve {
            request::Head::headers;
        }
        else {
            let selected = CookieRequestPairs(jar.cookies(request::Head::target.url(), context)).string();
            let clean = HeadersWithout(
                origin: request::Head::headers,
                names: [HeaderName("Cookie")]
            ).headers();
            if selected == "" {
                clean;
            }
            else {
                clean.addition(Header(name: HeaderName("Cookie"), value: selected));
            }
        };
        let outgoing = Request(
            method: request::Head::method,
            target: request::Head::target,
            headers: fields,
            body: request.body(),
            version: request::Head::version
        );
        let result = await origin.response(outgoing);
        let retained = Event();
        let cleanup = RedirectResponseCleanup(
            response: result::Exchange::response,
            retained: retained
        );
        defer cleanup.close();
        // Storage is correct even if a caller places this outside Redirecting,
        // but selection per hop requires Redirecting(CookieExchanging(...)).
        for result::Exchange::history -> hop {
            jar.store(
                hop::Exchange::request::Head::target.url(),
                hop::Exchange::response::Head::headers,
                contexts.context(hop::Exchange::request)
            );
        }
        let same_hop = result::Exchange::history.size() == 0
            && result::Exchange::request::Head::target.url().string() == request::Head::target.url().string();
        let effective_context = if same_hop {
            context;
        }
        else {
            contexts.context(result::Exchange::request);
        };
        jar.store(
            result::Exchange::request::Head::target.url(),
            result::Head::headers,
            effective_context
        );
        // Generated jar headers are internal to this hop. Returning the caller's
        // coordinates prevents the next redirect from treating them as explicit
        // caller Cookie fields. Preserve an origin's actual multi-hop result.
        let reported = if same_hop {
            ClientResponse(
                request: request,
                response: result::Exchange::response,
                details: result::Exchange::details
            );
        }
        else {
            result;
        };
        retained.set();
        reported;
    }
}

hidden object CookieRequestPairs {
    has text is string;

    CookieRequestPairs(cookies is Sequencing<Cookie>) {
        let count = cookies.size();
        confirm count >= 0 && count <= 256 else throw CookieExchangeLimit.because("cookie count");
        let used = Atomic(0);
        let pairs is @string = (0..count).map() -> index {
            let pair = cookies.item(index).pair();
            let size = used.value() + pair.length() + 2;
            confirm size <= 65536 else throw CookieExchangeLimit.because("cookie bytes");
            used.replace(size);
            pair;
        };
        text = pairs.join("; ");
    }

    string() is string {
        text;
    }
}

enum CallerCookieConflict is Error = (conflict);

enum CookieExchangeLimit is Error = (because(reason is string));

test "first-party cookies use the current request site and method" {
    let request = Request(
        method: Method.post,
        target: AbsoluteTarget(ParsedUrl("https://example.com/path").parts())
    );
    let context = FirstPartyCookies().context(request);
    test.ok(
        context::Context::top_level
            && context::Context::method == Method.post
            && context.site().string() == "https://example.com/path"
    );
    test.ok(CookieRequestPairs([]).string() == "");
}
