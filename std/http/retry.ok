module http/retry v1.0.0;

// Sending a request once more when a reused connection closed before it
// answered.
//
//     let client = Retrying(HttpClient());
//
// Only HttpStaleConnection is retried, only once, and only for idempotent
// methods with replayable bodies. Every other failure goes to the caller.

import "http/client" take HttpStaleConnection;
import "http/message" take Request;
import "http/method" take MethodSemantics;
import "http/exchange" take ClientResponse, Exchanging;
import "http/method" take Method;
import "async/atomic" take Atomic;

// Optional one-shot retry. Only the client transport can establish the stale
// before-response condition; ordinary errors and response failures propagate.
object Retrying does Exchanging {
    has origin is Exchanging;

    // Sends through origin.
    Retrying(origin is Exchanging) {
        self.origin = origin;
    }

    // The response; one more attempt after HttpStaleConnection when that is
    // safe.
    async response(request is Request) is ClientResponse {
        let outcome is @ClientResponse = try {
            [await self.once(request)];
        }
        catch e is HttpStaleConnection {
            if !MethodSemantics(request::Head::method).idempotent() || !request.body().replayable() {
                throw;
            }
            let empty is @ClientResponse = [];
            empty;
        };
        if outcome.size() == 1 {
            return outcome[0];
        }
        await self.once(request);
    }

    // One attempt.
    async once(request is Request) is ClientResponse {
        let pending = origin.response(request);
        await pending;
    }
}

hidden object StaleOnce does Exchanging {
    has calls is Atomic<int>;

    StaleOnce() {
        calls = Atomic(0);
    }

    async response(request is Request) is ClientResponse {
        calls.replace(calls.value() + 1);
        if calls.value() == 1 {
            throw HttpStaleConnection.unexplained;
        }
        throw RetryProbe.second_attempt;
    }

    calls() is int {
        calls.value();
    }
}

// Thrown by the test double of http/retry on its second attempt.
enum RetryProbe is Error = (second_attempt);

async test "a stale connection is retried once for an idempotent, replayable request" {
    let read = StaleOnce();
    test.throws(RetryProbe) {
        await Retrying(read).response(Request(url: "http://example.com/"));
    };
    test.is(read.calls(), 2);
    let write = StaleOnce();
    test.throws(HttpStaleConnection) {
        await Retrying(write).response(Request(url: "http://example.com/", method: Method.post));
    };
    test.is(write.calls(), 1);
}
