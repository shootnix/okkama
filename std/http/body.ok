module http/body v1.0.0;

import "http/header" take Headers;
import "json" take Json;
import "encoding/utf" take Utf8Encoded;
import "numbers/bigint" take BigInt;
import "io/stream" take AsyncReading, Closing, InvalidReadLimit;
import "io/decorators" take InvalidReading;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/lock" take Lock;
import "async/scope" take FutureGroup;

// Body openings describe a source; each reader owns one consumption lifetime.
// Unknown length is explicit and never represented by a negative sentinel.
role BodyOpening {
    length() is BigInt;
    replayable() is bool;
    reading() is BodyReading;
    // The whole body when it is already in memory, for writing it with its
    // head in one write (#115); a stream answers none.
    contained() is Maybe<@byte>;
}

role BodyReading {
    async bytes(limit is int) is @byte;
    trailers() is Headers;
    closed() is bool;
    close() is void;
}

object ByteBody does BodyOpening {
    has origin is @byte;

    ByteBody(origin is @byte) {
        self.origin = origin;
    }

    length() is BigInt {
        BigInt(origin.size().string());
    }

    replayable() is bool {
        true;
    }

    // The whole body when it is already in memory (#115).
    contained() is Maybe<@byte> {
        Maybe.some(origin);
    }

    reading() is BodyReading {
        MemoryBodyReading(origin);
    }
}

// A body already in memory, read directly: no lock and no task per read
// (#117). Trailers are empty and known once the end has been read.
hidden object MemoryBodyReading does BodyReading, AsyncReading, Closing {
    has origin is @byte;
    has offset is Atomic<int>;
    has stopped, finished is Atomic<bool>;

    MemoryBodyReading(origin is @byte) {
        self.origin = origin;
        offset = Atomic(0);
        stopped = Atomic(false);
        finished = Atomic(false);
    }

    async bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        confirm !stopped.value() else throw BodyClosed.closed;
        let start = offset.value();
        let end = if origin.size() - start < limit {
            origin.size();
        }
        else {
            start + limit;
        };
        offset.replace(end);
        if end == start {
            finished.replace(true);
        }
        origin.slice(start, end);
    }

    trailers() is Headers {
        confirm finished.value() else throw TrailersUnavailable.unavailable;
        Headers();
    }

    closed() is bool {
        stopped.value();
    }

    close() is void {
        stopped.replace(true);
    }
}

// A body together with its media type: what a client's post, put and patch
// send, with the type as their Content-Type.
role Content {
    media_type() is string;
    opening() is BodyOpening;
}

// A JSON document as a body, `application/json`.
object JsonBody does Content {
    has value is Json;

    JsonBody(value is Json) {
        self.value = value;
    }

    media_type() is string {
        "application/json";
    }

    opening() is BodyOpening {
        ByteBody(Utf8Encoded(value.string()).bytes());
    }
}

// Text as a UTF-8 body; `text/plain` unless another type is given.
object TextBody does Content {
    has text is string;
    has media is string;

    TextBody(text is string, media_type is string = "text/plain; charset=utf-8") {
        self.text = text;
        media = media_type;
    }

    media_type() is string {
        media;
    }

    opening() is BodyOpening {
        ByteBody(Utf8Encoded(text).bytes());
    }
}

// Bytes as a body; `application/octet-stream` unless another type is given.
object BytesBody does Content {
    has bytes is @byte;
    has media is string;

    BytesBody(bytes is @byte, media_type is string = "application/octet-stream") {
        self.bytes = bytes;
        media = media_type;
    }

    media_type() is string {
        media;
    }

    opening() is BodyOpening {
        ByteBody(bytes);
    }
}

object EmptyBody does BodyOpening {
    EmptyBody();

    length() is BigInt {
        BigInt("0");
    }

    replayable() is bool {
        true;
    }

    // The whole body when it is already in memory (#115).
    contained() is Maybe<@byte> {
        let empty is @byte = [];
        Maybe.some(empty);
    }

    reading() is BodyReading {
        let empty is @byte = [];
        MemoryBodyReading(empty);
    }
}

object OneShotBody does BodyOpening {
    has origin is BodyReading;
    has opened is Atomic<bool>;

    OneShotBody(origin is BodyReading) {
        confirm !origin.closed() else throw BodyClosed.closed;
        self.origin = origin;
        opened = Atomic(false);
    }

    length() is BigInt {
        throw UnknownBodyLength.unknown;
    }

    replayable() is bool {
        false;
    }

    // The whole body when it is already in memory (#115).
    contained() is Maybe<@byte> {
        Maybe<@byte>.none;
    }

    reading() is BodyReading {
        confirm opened.compare_and_replace(false, true) else throw BodyAlreadyOpened.opened;
        origin;
    }

    destroy {
        try {
            if !opened.value() {
                origin.close();
            }
        }
        catch failure is Error {}
        catch failure is NativeFailure {}
    }
}

// Adopts an already body-delimited input and its exclusive owner. This is not
// a socket/message framer. Trailer metadata is published only at clean EOF.
// Pending storage is at most one Future and is cleared on every started exit.
object StreamBodyReading does BodyReading, AsyncReading, Closing {
    has input is AsyncReading;
    has owner is Closing;
    has end is Headers;
    has stopped, finished is Event;
    has lock is Lock;
    has pending is Atomic<@Future<@byte>>;

    StreamBodyReading(input is AsyncReading, owner is Closing, trailers is Headers) {
        confirm !owner.closed() else throw BodyClosed.closed;
        self.input = input;
        self.owner = owner;
        end = trailers;
        stopped = Event();
        finished = Event();
        lock = Lock();
        let empty is @Future<@byte> = [];
        pending = Atomic(empty);
    }

    closed() is bool {
        stopped.ready();
    }

    trailers() is Headers {
        confirm finished.ready() else throw TrailersUnavailable.unavailable;
        end;
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            for pending.value() -> waiting {
                waiting.cancel();
            }
            if !owner.closed() {
                owner.close();
            }
        }
    }

    abort() is void {
        try {
            self.close();
        }
        catch failure is Error {}
        catch failure is NativeFailure {}
    }

    async bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        confirm !self.closed() else throw BodyClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw BodyClosed.closed;
        if finished.ready() {
            return [];
        }
        let complete = Event();
        let group is FutureGroup<@byte> = FutureGroup();
        let cleanup = BodyReadCleanup(origin: self, complete: complete, pending: pending, group: group);
        defer await cleanup.close();
        let waiting = input.bytes(limit);
        pending.replace([waiting]);
        group.start(waiting);
        let chunk = await waiting;
        confirm !self.closed() else throw BodyClosed.closed;
        confirm chunk.size() <= limit
            else throw InvalidReading.because("HTTP body source exceeded requested limit");
        if chunk.size() == 0 {
            if !owner.closed() {
                owner.close();
            }
            finished.set();
        }
        complete.set();
        chunk;
    }

    destroy {
        self.abort();
    }
}

// Owned infrastructure for an immutable byte source. All operations are local;
// the outer reader supplies serialization and the shared body lifecycle.
object ByteBodyInput does AsyncReading, Closing {
    has origin is @byte;
    has offset is Atomic<int>;
    has stopped is Event;

    ByteBodyInput(origin is @byte) {
        self.origin = origin;
        offset = Atomic(0);
        stopped = Event();
    }

    async bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        confirm !self.closed() else throw BodyClosed.closed;
        let start = offset.value();
        let remaining = origin.size() - start;
        let amount = if limit < remaining {
            limit;
        }
        else {
            remaining;
        };
        offset.replace(start + amount);
        origin.slice(start, start + amount);
    }

    closed() is bool {
        stopped.ready();
    }

    close() is void {
        stopped.set();
    }
}

// One group per read: it owns exactly one child, so completed bodies never
// accumulate read results. Group cancellation retains secondary cleanup errors.
hidden object BodyReadCleanup {
    has origin is StreamBodyReading;
    has complete is Event;
    has pending is Atomic<@Future<@byte>>;
    has group is FutureGroup<@byte>;

    BodyReadCleanup(
        origin is StreamBodyReading,
        complete is Event,
        pending is Atomic<@Future<@byte>>,
        group is FutureGroup<@byte>
    ) {
        self.origin = origin;
        self.complete = complete;
        self.pending = pending;
        self.group = group;
    }

    async close() is void {
        let unfinished = group.active() > 0;
        if !complete.ready() {
            group.cancel();
            origin.abort();
        }
        let empty is @Future<@byte> = [];
        pending.replace(empty);
        if unfinished {
            await group.wait();
        }
    }
}

enum BodyClosed is Error = (closed);

enum BodyAlreadyOpened is Error = (opened);

enum UnknownBodyLength is Error = (unknown);

enum TrailersUnavailable is Error = (unavailable);

async test "byte body reads are independent and trailers require EOF" {
    let body = ByteBody([7.byte()]);
    let first = body.reading();
    let second = body.reading();
    test.is(await first.bytes(1), [7.byte()]);
    test.is(await second.bytes(1), [7.byte()]);
    test.is(await first.bytes(1), []);
    test.is(first.trailers().entries().size(), 0);
}

async test "a body in memory is read in pieces, then ends with its trailers" {
    let reading = ByteBody([1.byte(), 2.byte(), 3.byte()]).reading();
    let first = await reading.bytes(2);
    test.is(first.size(), 2);
    test.throws(TrailersUnavailable) {
        reading.trailers();
    };
    let second = await reading.bytes(5);
    test.is(second[0], 3.byte());
    let end = await reading.bytes(5);
    test.is(end.size(), 0);
    test.is(reading.trailers().entries().size(), 0);
    reading.close();
    test.ok(reading.closed());
    let refused = try {
        await reading.bytes(1);
        "read";
    }
    catch failure is BodyClosed {
        "closed";
    };
    test.is(refused, "closed");
    let nothing = await EmptyBody().reading().bytes(8);
    test.is(nothing.size(), 0);
}

