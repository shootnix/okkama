module http/exchange v1.0.0;

import "url/value" take UrlParts, MissingUrlPort;
import "net/ip" take IpAddress;
import "http/method" take Method;
import "http/message" take Request, Response;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/tls" take TlsDetails;
import "collections/sequence" take Sequencing;
import "error" take InvalidArgument;
import "http/status" take Status, StatusCode, StatusClass;
import "http/header" take Headers, HeaderName, HttpAsciiLowercase, Header;
import "http/body" take BodyReading, ByteBody;
import "http/media_type" take HttpMediaType;
import "io/buffer" take ByteBuffer;
import "io/decorators" take ByteSnapshot;
import "encoding/utf" take Utf8Decoded, Utf8Encoded;
import "encoding/single_byte" take AsciiDecoded, Latin1Decoded;
import "json" take Json, ParsedJson;

object ExchangeDetails {
    has endpoints is ConnectionEndpoints<IpEndpoint>;
    has tls is @TlsDetails;
    has version is HttpVersion;

    ExchangeDetails(endpoints is ConnectionEndpoints<IpEndpoint>, version is HttpVersion) {
        self.endpoints = endpoints;
        self.version = version;
        tls = [];
    }

    ExchangeDetails(
        endpoints is ConnectionEndpoints<IpEndpoint>,
        version is HttpVersion,
        tls is TlsDetails
    ) {
        self.endpoints = endpoints;
        self.version = version;
        self.tls = [tls];
    }

    endpoints() is ConnectionEndpoints<IpEndpoint> {
        endpoints;
    }

    version() is HttpVersion {
        version;
    }

    secure() is bool {
        tls.size() == 1;
    }

    tls() is TlsDetails {
        confirm tls.size() == 1 else throw PlainHttpHasNoTls.none;
        tls[0];
    }
}

enum PlainHttpHasNoTls is Error = (none);

// Sends a request and answers what came back: a client, or a decorator of one.
role Exchanging {
    async response(request is Request) is ClientResponse;
}

// The pool key of a URL: scheme, host and effective port. Policy and TLS
// identity are scoped to it; no proxy is implicit.
object HttpClientKey {
    has key is string;

    HttpClientKey(url is UrlParts) {
        let port = url::Parts::port else if url::Parts::scheme == "https" {
            443;
        }
        else {
            80;
        };
        key = url::Parts::scheme + "://" + (url::Parts::host else "") + ":" + port.string();
    }

    string() is string {
        key;
    }
}

// One redirect or retry step before the final response.
object ExchangeHop {
    has request is Request;
    has response is Response;

    ExchangeHop(request is Request, response is Response) {
        self.request = request;
        self.response = response;
    }

    cap Exchange {
        request is Request {
            request;
        }

        response is Response {
            response;
        }
    }
}

// What a client got back for a request: the final response, the hops before
// it and how it travelled. Its head is the cap `Head` and the exchange around
// it the cap `Exchange`. The body is read once: whole with `bytes()`, `text()`
// or `json()`, or piece by piece through `reading()`.
object ClientResponse {
    has request is Request;
    has response is Response;
    has history is @ExchangeHop;
    has details is ExchangeDetails;

    ClientResponse(request is Request, response is Response, details is ExchangeDetails) {
        self.request = request;
        self.response = response;
        self.details = details;
        history = [];
    }

    ClientResponse(
        request is Request,
        response is Response,
        history is Sequencing<ExchangeHop>,
        details is ExchangeDetails
    ) {
        let count = history.size();
        confirm count >= 0 && count <= 20 else throw InvalidArgument.because("HTTP history limit");
        let snapshot is @ExchangeHop = (0..count).map() -> index {
            history.item(index);
        };
        self.request = request;
        self.response = response;
        self.history = snapshot;
        self.details = details;
    }

    cap Head {
        status is Status {
            response::Head::status;
        }

        code is int {
            response::Head::code;
        }

        class is StatusClass {
            response::Head::class;
        }

        headers is Headers {
            response::Head::headers;
        }

        version is HttpVersion {
            response::Head::version;
        }
    }

    cap Exchange {
        request is Request {
            request;
        }

        response is Response {
            response;
        }

        history is Sequencing<ExchangeHop> {
            history;
        }

        details is ExchangeDetails {
            details;
        }
    }

    // The body piece by piece; whoever takes it closes it.
    reading() is BodyReading {
        response.body().reading();
    }

    // The whole body; the client's body limit bounds it.
    async bytes() is @byte {
        let input = response.body().reading();
        defer input.close();
        let joined = ByteBuffer();
        defer joined.closing().close();
        let output = joined.writing();
        loop {
            let chunk = await input.bytes(65536);
            if chunk.size() == 0 {
                last;
            }
            output.write(ByteSnapshot(chunk));
        }
        joined.content().bytes();
    }

    // The whole body as text, decoded by the charset of its Content-Type:
    // UTF-8 when there is none; US-ASCII and ISO-8859-1 are also read.
    async text() is string {
        let charset = BodyCharset(response::Head::headers).name();
        let bytes = await self.bytes();
        if charset == "us-ascii" {
            AsciiDecoded(bytes).string();
        }
        else if charset == "iso-8859-1" {
            Latin1Decoded(bytes).string();
        }
        else {
            Utf8Decoded(bytes).string();
        }
    }

    // The whole body parsed as JSON.
    async json() is Json {
        ParsedJson(await self.text()).root();
    }
}

// The charset named by a Content-Type field, lowercase; "utf-8" without one.
hidden object BodyCharset {
    has headers is Headers;

    BodyCharset(headers is Headers) {
        self.headers = headers;
    }

    name() is string {
        let field = HeaderName("Content-Type");
        if !headers.membership(field) {
            return "utf-8";
        }
        let parameters = HttpMediaType(headers.first(field)).parameters();
        if !parameters.membership("charset") {
            return "utf-8";
        }
        let name = HttpAsciiLowercase(parameters.first("charset")).string();
        confirm name == "utf-8" || name == "us-ascii" || name == "iso-8859-1"
            else throw UnsupportedBodyCharset.named(name);
        name;
    }
}

enum UnsupportedBodyCharset is Error = (named(name is string));

async test "a client response reads its head through caps and its body whole" {
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
        local: IpEndpoint(IpAddress("127.0.0.1"), 40000),
        remote: IpEndpoint(IpAddress("127.0.0.1"), 80)
    );
    let details = ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1);
    let request = Request(url: "http://example.test/");
    let page = ClientResponse(
        request: request,
        response: Response(
            status: Status.ok,
            headers: Headers(Header(name: HeaderName("Content-Type"), value: "text/plain; charset=utf-8")),
            body: ByteBody(Utf8Encoded("héllo").bytes())
        ),
        details: details
    );
    test.is(page::Head::status, Status.ok);
    test.is(page::Head::class, StatusClass.successful);
    test.is(page::Head::headers.first(HeaderName("Content-Type")), "text/plain; charset=utf-8");
    test.is(page::Exchange::request::Head::method, Method.get);
    test.is(page::Exchange::history.size(), 0);
    test.is(await page.text(), "héllo");
}

async test "text follows the charset, json parses, an unknown charset is refused" {
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
        local: IpEndpoint(IpAddress("127.0.0.1"), 40000),
        remote: IpEndpoint(IpAddress("127.0.0.1"), 80)
    );
    let details = ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1);
    let request = Request(url: "http://example.test/");
    let latin = ClientResponse(
        request: request,
        response: Response(
            status: Status.ok,
            headers: Headers(Header(name: HeaderName("Content-Type"), value: "text/plain; charset=ISO-8859-1")),
            body: ByteBody([104.byte(), 233.byte()])
        ),
        details: details
    );
    test.is(await latin.text(), "hé");
    let data = ClientResponse(
        request: request,
        response: Response(
            status: Status.created,
            headers: Headers(Header(name: HeaderName("Content-Type"), value: "application/json")),
            body: ByteBody(Utf8Encoded("{\"id\": 7}").bytes())
        ),
        details: details
    );
    test.is((await data.json()).int("id"), 7);
    let odd = ClientResponse(
        request: request,
        response: Response(
            status: Status.ok,
            headers: Headers(Header(name: HeaderName("Content-Type"), value: "text/plain; charset=koi8-r")),
            body: ByteBody([65.byte()])
        ),
        details: details
    );
    test.is(
        try {
            await odd.text();
        }
        catch UnsupportedBodyCharset.named(name) {
            name;
        },
        "koi8-r"
    );
    let raw = ClientResponse(
        request: request,
        response: Response(status: Status.no_content, body: ByteBody([1.byte(), 2.byte()])),
        details: details
    );
    test.is(await raw.bytes(), [1.byte(), 2.byte()]);
}
