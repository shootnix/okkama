module http/websocket_origin v1.0.0;

// Whether a WebSocket upgrade may come from its Origin.
//
//     WebSocketUpgrade(protocols: [], limits: WebSocketLimits(), access: SameOriginWebSockets(), deadline: Duration(seconds: 5));
//
// The server's own URL, from its configuration, is what the Origin is checked
// against; the Host field of the request is not trusted. A non-browser client
// that sends no Origin needs a policy of its own.

import "http/message" take Request;
import "http/header" take HeaderName;
import "url/value" take UrlParts, ParsedUrl, InvalidUrl, MissingUrlPort, UrlHostKind;
import "http/header" take Header, Headers;

// What decides whether an upgrade may come from its Origin.
role WebSocketAllowing {
    // Whether request may open a WebSocket on destination.
    allowed(request is Request, destination is UrlParts) is bool;
}

// Upgrades whose Origin has the server's scheme, host and port.
object SameOriginWebSockets does WebSocketAllowing {
    // The policy.
    SameOriginWebSockets();

    // One Origin field, of the same scheme, host and port as destination.
    allowed(request is Request, destination is UrlParts) is bool {
        let values = request::Head::headers.values(HeaderName("Origin"));
        if values.size() != 1 {
            return false;
        }
        let origin = values.item(0);
        if origin.length() == 0 || origin.length() > 8192 || origin == "null" {
            return false;
        }
        try {
            let parsed = ParsedUrl(origin).parts();
            let parts = parsed;
            if parts::Parts::scheme != "http" && parts::Parts::scheme != "https" {
                return false;
            }
            if parts::Parts::path != ""
                || parts::Parts::query != Maybe<string>.none
                || parts::Parts::fragment != Maybe<string>.none {
                    return false;
                }
            let left = WebSocketOriginCoordinates(parsed);
            let right = WebSocketOriginCoordinates(destination);
            left.scheme() == right.scheme()
                && left.host() == right.host()
                && left.port() == right.port();
        }
        catch e is InvalidUrl {
            false;
        }
        catch e is MissingUrlPort {
            false;
        }
    }
}

hidden object WebSocketOriginCoordinates {
    has scheme, host is string;
    has port is int;

    WebSocketOriginCoordinates(origin is UrlParts) {
        let parts = origin;
        let supplied = parts::Parts::scheme;
        confirm supplied == "https" || supplied == "http" || supplied == "wss" || supplied == "ws"
            else throw InvalidUrl.located(0, "origin scheme");
        confirm parts::Parts::host != Maybe<string>.none
            && parts::Parts::userinfo == Maybe<string>.none
            else throw InvalidUrl.located(0, "origin authority");
        let kind = parts.host_kind();
        confirm kind == UrlHostKind.name || kind == UrlHostKind.address
            else throw InvalidUrl.located(0, "origin host");
        let secure = supplied == "https" || supplied == "wss";
        scheme = if secure {
            "https";
        }
        else {
            "http";
        };
        host = parts::Parts::host else "";
        let number = parts::Parts::port else if secure {
            443;
        }
        else {
            80;
        };
        confirm number > 0 else throw InvalidUrl.located(0, "origin port");
        port = number;
    }

    scheme() is string {
        scheme;
    }

    host() is string {
        host;
    }

    port() is int {
        port;
    }
}

test "a WebSocket upgrade is allowed only from the same origin" {
    let site = ParsedUrl("https://chat.example.com/socket").parts();
    let policy = SameOriginWebSockets();
    let from = (origin is string) is Request {
        Request(
            url: "https://chat.example.com/socket",
            headers: Headers(Header(name: HeaderName("Origin"), value: origin))
        );
    };
    test.is(policy.allowed(from("https://chat.example.com"), site), true);
    test.is(policy.allowed(from("https://chat.example.com:443"), site), true);
    test.is(policy.allowed(from("https://evil.example.com"), site), false);
    test.is(policy.allowed(from("http://chat.example.com"), site), false);
    test.is(policy.allowed(from("https://chat.example.com/path"), site), false);
    test.is(policy.allowed(from("null"), site), false);
    test.is(policy.allowed(Request(url: "https://chat.example.com/socket"), site), false);
}
