module http/http1_head v1.0.0;

import "http/message" take Request, Response, RequestCoordinates, InvalidHttpMessage;
import "http/method" take Method, MethodName, InvalidMethod;
import "http/target" take RequestTarget, ParsedRequestTarget, InvalidRequestTarget;
import "http/status" take Status, InvalidStatus, StatusCode;
import "http/version" take HttpVersion, ParsedHttp1Version, UnsupportedHttpVersion;
import "http/header" take Headers, Header, HeaderName, HeaderLimits, InvalidHeader;
import "http/body" take BodyOpening;
import "url/value" take InvalidUrl, UrlParts;
import "encoding/single_byte" take Latin1Encoded;
import "runtime/single_byte" take latin1_representable_prefix, ascii_representable_prefix;

object Http1Limits {
    has head_bytes, line_bytes, fields, body_bytes is int;

    Http1Limits() {
        head_bytes = 65536;
        line_bytes = 8192;
        fields = 128;
        body_bytes = 1073741824;
    }

    Http1Limits(head_bytes is int, line_bytes is int, fields is int, body_bytes is int) {
        confirm head_bytes >= 4
            && head_bytes <= 1048576
            && line_bytes >= 1
            && line_bytes <= head_bytes
            && fields >= 0
            && fields <= 1024
            && body_bytes >= 0
            && body_bytes <= 9007199254740991
            else throw InvalidHttpMessage.because("invalid HTTP1 budgets");
        self.head_bytes = head_bytes;
        self.line_bytes = line_bytes;
        self.fields = fields;
        self.body_bytes = body_bytes;
    }

    cap Limits {
        head_bytes is int {
            head_bytes;
        }

        line_bytes is int {
            line_bytes;
        }

        fields is int {
            fields;
        }

        body_bytes is int {
            body_bytes;
        }
    }
}

enum Http1LimitExceeded is Error = (kind(kind is string));

object ParsedHttp1RequestHead {
    has origin is string;
    has limits is Http1Limits;

    ParsedHttp1RequestHead(origin is string) {
        self.origin = origin;
        limits = Http1Limits();
    }

    ParsedHttp1RequestHead(origin is string, limits is Http1Limits) {
        self.origin = origin;
        self.limits = limits;
    }

    head() is Http1RequestHead {
        let head = Http1HeadLines(origin: origin, limits: limits);
        let words = head.start_line().split(" ");
        confirm words.size() == 3 && words[0] != "" && words[1] != "" && words[2] != ""
            else throw InvalidHttpMessage.because("strict request-line spacing required");
        let method = try {
            MethodName(words[0]).method();
        }
        catch e is InvalidMethod {
            throw InvalidHttpMessage.because("invalid request method token");
        };
        let target = try {
            ParsedRequestTarget(origin: words[1], method: method).target();
        }
        catch e is InvalidRequestTarget {
            throw InvalidHttpMessage.because("invalid request target");
        };
        let version = try {
            ParsedHttp1Version(words[2]).version();
        }
        catch e is UnsupportedHttpVersion {
            throw InvalidHttpMessage.because("unsupported request wire version");
        };
        Http1RequestHead(method: method, target: target, headers: head.headers(), version: version);
    }
}

object ParsedHttp1ResponseHead {
    has origin is string;
    has limits is Http1Limits;

    ParsedHttp1ResponseHead(origin is string) {
        self.origin = origin;
        limits = Http1Limits();
    }

    ParsedHttp1ResponseHead(origin is string, limits is Http1Limits) {
        self.origin = origin;
        self.limits = limits;
    }

    head() is Http1ResponseHead {
        let head = Http1HeadLines(origin: origin, limits: limits);
        let line = head.start_line();
        confirm line.length() >= 13 && line.slice(8, 9) == " " && line.slice(12, 13) == " "
            else throw InvalidHttpMessage.because("strict status-line spacing required");
        let version = try {
            ParsedHttp1Version(line.slice(0, 8)).version();
        }
        catch e is UnsupportedHttpVersion {
            throw InvalidHttpMessage.because("unsupported response wire version");
        };
        let digits = Latin1Encoded(line.slice(9, 12)).bytes();
        let code = digits.reduce(0) -> value, octet {
            let code = octet.int();
            confirm code >= 48 && code <= 57
                else throw InvalidHttpMessage.because("three status digits required");
            value * 10 + code - 48;
        };
        let status = try {
            StatusCode(code).status();
        }
        catch e is InvalidStatus {
            throw InvalidHttpMessage.because("status outside supported range");
        };
        let reason = Latin1Encoded(line.slice(13, line.length())).bytes();
        confirm reason.reduce(true) -> valid, octet {
            let code = octet.int();
            valid && (code == 9 || (code >= 32 && code != 127));
        }
            else throw InvalidHttpMessage.because("invalid reason phrase octets");
        Http1ResponseHead(status: status, headers: head.headers(), version: version);
    }
}

// Importable implementation collaborator only because module-private exports
// are not supported. Raw lines stay private even from ordinary helper receivers.
hidden object Http1HeadLines {
    has lines is @string;
    has limits is Http1Limits;

    Http1HeadLines(origin is string, limits is Http1Limits) {
        confirm origin.length() <= limits::Limits::head_bytes
            else throw Http1LimitExceeded.kind("head_bytes");
        confirm latin1_representable_prefix(origin) == origin.length()
            else throw InvalidHttpMessage.because("octet head source required");
        confirm origin.find("\r\n\r\n") == Maybe.some(origin.length() - 4)
            else throw InvalidHttpMessage.because("exact CRLF head framing required");
        let values = origin.split("\r\n");
        confirm values.size() >= 3 else throw InvalidHttpMessage.because("missing start line");
        confirm values.size() - 3 <= limits::Limits::fields else throw Http1LimitExceeded.kind("fields");
        // Every CR and LF belongs to a CRLF when there are as many of each as
        // there are lines; only then the lines need no look of their own (#113).
        let clean = origin.split("\r").size() == values.size() && origin.split("\n").size() == values.size();
        for (0..values.size() - 2) -> index {
            let line = values[index];
            confirm line.length() <= limits::Limits::line_bytes
                else throw Http1LimitExceeded.kind("line_bytes");
            confirm clean || (line.split("\r").size() == 1 && line.split("\n").size() == 1)
                else throw InvalidHttpMessage.because("bare CR/LF in head");
        }
        lines = values;
        self.limits = limits;
    }

    headers() is Headers {
        let entries is @Header = (1..lines.size() - 2).map() -> index {
            let line = lines[index];
            let colon = line.find(":") else 0;
            confirm colon > 0 else throw InvalidHttpMessage.because("field colon required");
            let name = try {
                HeaderName(line.slice(0, colon));
            }
            catch e is InvalidHeader {
                throw InvalidHttpMessage.because("invalid field name or obsolete folding");
            };
            try {
                Header(name: name, value: line.slice(colon + 1, line.length()));
            }
            catch e is InvalidHeader {
                throw InvalidHttpMessage.because("invalid field value octets");
            }
        };
        // Logical fields budget canonical ': ' even if the peer omitted that
        // optional space. Wire head bytes were already checked independently.
        Headers(entries: entries, limits: HeaderLimits(limits::Limits::fields, limits::Limits::head_bytes + limits::Limits::fields));
    }

    start_line() is string {
        lines[0];
    }
}

object Http1RequestHead {
    has method is Method;
    has target is RequestTarget;
    has headers is Headers;
    has version is HttpVersion;
    has host is @UrlParts;

    Http1RequestHead(
        method is Method,
        target is RequestTarget,
        headers is Headers,
        version is HttpVersion
    ) {
        confirm version != HttpVersion.http_2
            else throw InvalidHttpMessage.because("HTTP1 head requires HTTP1 wire version");
        let canonical = RequestCoordinates(method: method, target: target).target();
        let fields = headers.values(HeaderName("Host"));
        confirm fields.size() <= 1 && (version != HttpVersion.http_1_1 || fields.size() == 1)
            else throw InvalidHttpMessage.because("exactly one HTTP1.1 Host required");
        let authorities is @UrlParts = if fields.size() == 0 {
            let empty is @UrlParts = [];
            empty;
        }
        else {
            let value = fields.item(0);
            confirm ascii_representable_prefix(value) == value.length()
                else throw InvalidHttpMessage.because("ASCII Host required");
            let checked = try {
                Http1HostAuthority(value).parts();
            }
            catch e is InvalidUrl {
                throw InvalidHttpMessage.because("invalid Host authority");
            };
            confirm checked::Parts::path == "" && checked::Parts::query == Maybe<string>.none
                else throw InvalidHttpMessage.because("invalid Host authority");
            confirm (checked::Parts::host else "") != ""
                && checked::Parts::userinfo == Maybe<string>.none
                else throw InvalidHttpMessage.because("nonempty Host without userinfo required");
            [checked];
        };
        self.method = method;
        self.target = canonical;
        self.headers = headers;
        self.version = version;
        host = authorities;
    }

    target() is RequestTarget {
        target;
    }

    headers() is Headers {
        headers;
    }

    // The Host field as the authority-only parts of ParsedUrl("//" + host).
    host() is UrlParts {
        confirm host.size() == 1 else throw MissingHttp1Host.missing;
        host[0];
    }

    request(body is BodyOpening) is Request {
        Request(method: method, target: target, headers: headers, body: body, version: version);
    }

    cap Head {
        method is Method {
            method;
        }

        version is HttpVersion {
            version;
        }
    }
}

object Http1ResponseHead {
    has status is Status;
    has headers is Headers;
    has version is HttpVersion;

    Http1ResponseHead(status is Status, headers is Headers, version is HttpVersion) {
        confirm version != HttpVersion.http_2
            else throw InvalidHttpMessage.because("HTTP1 head requires HTTP1 wire version");
        self.status = status;
        self.headers = headers;
        self.version = version;
    }

    headers() is Headers {
        headers;
    }

    response(body is BodyOpening) is Response {
        Response(status: status, headers: headers, body: body, version: version);
    }

    cap Head {
        status is Status {
            status;
        }

        version is HttpVersion {
            version;
        }
    }
}

enum MissingHttp1Host is Error = (missing);

// A Host field as URL parts. Only the port is split off here, past an IPv6
// literal's brackets; UrlParts checks the host itself, in one pass instead of
// parsing "//" + host as a whole URL first (#503).
hidden object Http1HostAuthority {
    has origin is string;

    Http1HostAuthority(origin is string) {
        self.origin = origin;
    }

    parts() is UrlParts {
        let end = if origin.starts_with("[") {
            (origin.find("]") else origin.length()) + 1;
        }
        else {
            origin.find(":") else origin.length();
        };
        confirm end <= origin.length() else throw InvalidUrl.located(0, "IP literal closing bracket required");
        let rest = origin.slice(end, origin.length());
        confirm rest == "" || rest.starts_with(":") else throw InvalidUrl.located(end, "invalid authority suffix");
        let digits = if rest == "" {
            "";
        }
        else {
            rest.slice(1, rest.length());
        };
        let port is Maybe<int> = if digits == "" {
            Maybe<int>.none;
        }
        else {
            let number = digits.characters().reduce(0) -> value, character {
                let code = character.code();
                confirm code >= 48 && code <= 57 else throw InvalidUrl.located(end + 1, "ASCII decimal port required");
                let grown = value * 10 + code - 48;
                confirm grown <= 65535 else throw InvalidUrl.located(end + 1, "port exceeds 65535");
                grown;
            };
            Maybe.some(number);
        };
        UrlParts(
            scheme: "",
            userinfo: Maybe<string>.none,
            host: Maybe.some(origin.slice(0, end)),
            port: port,
            path: "",
            query: Maybe<string>.none,
            fragment: Maybe<string>.none,
        );
    }
}

test "strict HTTP1 head preserves extension status and duplicate fields" {
    let head = ParsedHttp1ResponseHead("HTTP/1.1 299 phrase\r\nX: 1\r\nX: 2\r\n\r\n").head();
    test.ok(
        head::Head::status == Status.other(299) && head.headers().values(HeaderName("X")).size() == 2
    );
    test.ok(try {
        ParsedHttp1RequestHead("GET / HTTP/1.1\r\n\r\n").head();
        false;
    }
    catch e is InvalidHttpMessage {
        true;
    });
}

test "a Host field is one authority: a host and an optional port" {
    let read = ParsedHttp1RequestHead("GET / HTTP/1.1\r\nHost: EXAMPLE.com:8080\r\n\r\n").head().host();
    test.is(read::Parts::host else "", "example.com");
    test.is(read::Parts::port else 0, 8080);
    let literal = ParsedHttp1RequestHead("GET / HTTP/1.1\r\nHost: [::1]:81\r\n\r\n").head().host();
    test.is(literal::Parts::host else "", "[::1]");
    test.is(literal::Parts::port else 0, 81);
    test.is(ParsedHttp1RequestHead("GET / HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n").head().host()::Parts::port, Maybe<int>.none);
    for ["a:b:c", "user@host", "host/x", "host?x", "[::1", "[::1]x", "host:99999", "host:x", ":80", ""] -> bad {
        test.throws(InvalidHttpMessage) {
            ParsedHttp1RequestHead("GET / HTTP/1.1\r\nHost: " + bad + "\r\n\r\n").head();
        };
    }
}

