module http/connection v1.0.0;

// HTTP/1 connections for a client: TCP to an address already checked, racing
// the candidates a little apart, then TLS when the URL is https. HttpTransport
// uses it.

import "http/endpoint" take HttpEndpointSelection;
import "http/transport_observation" take HttpResponseObservation;
import "http/http1_session" take Http1Session;
import "http/http1_head" take Http1Limits;
import "http/tls_session" take Http1TlsProtocol;
import "http/version" take UnsupportedHttpVersion, HttpVersion;
import "http/exchange" take ExchangeDetails;
import "net/tcp" take TcpConnection, TcpOptions;
import "net/tcp_racing" take TcpRacing;
import "net/tls" take TlsClientPolicy, TlsClientHandshake, TlsConnection;
import "url/value" take UrlHostKind;
import "crypto/x509/trust" take CertificateIdentity, DnsCertificateIdentity, IpCertificateIdentity;
import "time/clock" take Timing, SystemClock;
import "time/duration" take Duration, DurationUnit;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "http/endpoint" take AllEndpoints;
import "net/dns" take FixedResolution;
import "url/value" take ParsedUrl;
import "net/tls" take TlsVersion;
import "crypto/x509/trust" take TrustedCertificates;
import "collections/set" take Set, OrderedSet;

// How to open an HTTP/1 connection to a route.
object Http1Connecting {
    has route is HttpEndpointSelection;
    has policy is TlsClientPolicy;
    has limits is Http1Limits;
    has clock is Timing;

    // To route with policy and the default limits.
    Http1Connecting(route is HttpEndpointSelection, policy is TlsClientPolicy) {
        for policy.protocols() -> protocol {
            confirm protocol == "http/1.1" else throw UnsupportedHttpVersion.unsupported;
        }
        self.route = route;
        self.policy = policy;
        limits = Http1Limits();
        clock = SystemClock();
    }

    // The same, within limits and with clock for timeouts.
    Http1Connecting(
        route is HttpEndpointSelection,
        policy is TlsClientPolicy,
        limits is Http1Limits,
        clock is Timing
    ) {
        for policy.protocols() -> protocol {
            confirm protocol == "http/1.1" else throw UnsupportedHttpVersion.unsupported;
        }
        self.route = route;
        self.policy = policy;
        self.limits = limits;
        self.clock = clock;
    }

    // A new HTTP/1 session.
    async session() is Http1Session {
        let group is FutureGroup<Http1Acquisition> = FutureGroup();
        let empty is @Future<Http1Acquisition> = [];
        let pending = Atomic(empty);
        let taken = Event();
        let cleanup = HttpAcquisitionCleanup(
            group: group,
            pending: pending,
            taken: taken,
            dispose: Http1AcquisitionDisposal().release
        );
        defer await cleanup.close();
        let opening = self.acquisition();
        pending.replace([opening]);
        group.start(opening);
        let acquired = await opening;
        taken.set();
        acquired.session();
    }

    // A new session and how it connected.
    async acquisition() is Http1Acquisition {
        let endpoints = await route.endpoints();
        let group is FutureGroup<TcpConnection> = FutureGroup();
        let empty is @Future<TcpConnection> = [];
        let pending = Atomic(empty);
        let taken = Event();
        let cleanup = HttpAcquisitionCleanup(
            group: group,
            pending: pending,
            taken: taken,
            dispose: HttpTcpDisposal().release
        );
        defer await cleanup.close();
        let waiting = TcpRacing(
            origins: endpoints,
            options: TcpOptions(),
            delay: Duration(milliseconds: 250),
            clock: clock
        ).connection();
        pending.replace([waiting]);
        group.start(waiting);
        let tcp = await waiting;
        taken.set();
        let published = Event();
        let anchor = HttpUnpublishedTcp(origin: tcp, published: published);
        defer anchor.close();
        let route_url = route.url();
        if route_url::Parts::scheme == "https" {
            let host = route.url();
            let identity is CertificateIdentity = if host.host_kind() == UrlHostKind.name {
                DnsCertificateIdentity(host.host_name());
            }
            else {
                IpCertificateIdentity(host.host_address());
            };
            let tls_group is FutureGroup<TlsConnection> = FutureGroup();
            let empty_tls is @Future<TlsConnection> = [];
            let tls_pending = Atomic(empty_tls);
            let tls_taken = Event();
            let tls_cleanup = HttpAcquisitionCleanup(
                group: tls_group,
                pending: tls_pending,
                taken: tls_taken,
                dispose: HttpTlsDisposal().release
            );
            defer await tls_cleanup.close();
            let upgrading = TlsClientHandshake(
                origin: tcp,
                server: identity,
                policy: policy,
                clock: clock
            ).connection();
            tls_pending.replace([upgrading]);
            tls_group.start(upgrading);
            let tls = await upgrading;
            tls_taken.set();
            let tls_anchor = HttpUnpublishedTls(origin: tls, published: published);
            defer tls_anchor.close();
            Http1TlsProtocol(tls.details()::Session::protocol).version();
            let observation = HttpResponseObservation();
            let session = Http1Session(
                input: observation.reading(tls.input()),
                output: observation.writing(tls.output()),
                owner: tls,
                limits: limits
            );
            let acquired = Http1Acquisition(
                session: session,
                details: ExchangeDetails(
                    tls.details().endpoints(),
                    HttpVersion.http_1_1,
                    tls.details()
                ),
                observation: observation
            );
            published.set();
            return acquired;
        }
        let observation = HttpResponseObservation();
        let session = Http1Session(
            input: observation.reading(tcp.input()),
            output: observation.writing(tcp.output()),
            owner: tcp,
            limits: limits
        );
        let acquired = Http1Acquisition(
            session: session,
            details: ExchangeDetails(tcp.endpoints(), HttpVersion.http_1_1),
            observation: observation
        );
        published.set();
        acquired;
    }
}

// A new session and how it connected.
object Http1Acquisition {
    has session is Http1Session;
    has details is ExchangeDetails;
    has observation is @HttpResponseObservation;

    // As given.
    Http1Acquisition(session is Http1Session, details is ExchangeDetails) {
        self.session = session;
        self.details = details;
        observation = [];
    }

    // As given, with the observation of its first response.
    Http1Acquisition(
        session is Http1Session,
        details is ExchangeDetails,
        observation is HttpResponseObservation
    ) {
        self.session = session;
        self.details = details;
        self.observation = [observation];
    }

    // Starts watching for the first response.
    begin() is void {
        for observation -> value {
            value.begin();
        }
    }

    // The session.
    session() is Http1Session {
        session;
    }

    // How it connected.
    details() is ExchangeDetails {
        details;
    }
}

hidden object Http1AcquisitionDisposal {
    Http1AcquisitionDisposal();

    release(acquired is Http1Acquisition) is void {
        acquired.session().close();
    }
}

// Own the raw result before eager adaptation. A granted successful connection
// can become unclaimed when cancellation wins; it must be explicitly disposed.
object HttpAcquisitionCleanup<T> {
    has group is FutureGroup<T>;
    has pending is Atomic<@Future<T>>;
    has taken is Event;
    has dispose is (T) is void;

    // Disposes of what group produced and nobody took.
    HttpAcquisitionCleanup(
        group is FutureGroup<T>,
        pending is Atomic<@Future<T>>,
        taken is Event,
        dispose is (T) is void
    ) {
        self.group = group;
        self.pending = pending;
        self.taken = taken;
        self.dispose = dispose;
    }

    // Cancels the rest and disposes of it.
    async close() is void {
        if group.active() > 0 {
            group.cancel();
            defer await group.wait();
        }
        if !taken.ready() {
            for pending.value() -> waiting {
                let acquired is @T = try {
                    [await waiting];
                }
                catch e is Cancelled {
                    let empty is @T = [];
                    empty;
                }
                catch e is Error {
                    let empty is @T = [];
                    empty;
                }
                catch e is NativeFailure {
                    let empty is @T = [];
                    empty;
                };
                for acquired -> value {
                    dispose(value);
                }
            }
        }
    }
}

// Closes a TCP connection nobody took.
object HttpTcpDisposal {
    // The disposal.
    HttpTcpDisposal();

    // Closes connection.
    release(connection is TcpConnection) is void {
        connection.close();
    }
}

// Closes a TLS connection nobody took.
object HttpTlsDisposal {
    // The disposal.
    HttpTlsDisposal();

    // Closes connection.
    release(connection is TlsConnection) is void {
        connection.close();
    }
}

// A TCP connection closed unless it is handed out.
object HttpUnpublishedTcp {
    has origin is TcpConnection;
    has published is Event;

    // origin, kept once published fires.
    HttpUnpublishedTcp(origin is TcpConnection, published is Event) {
        self.origin = origin;
        self.published = published;
    }

    // Closes origin unless it was handed out.
    close() is void {
        if !published.ready() {
            origin.close();
        }
    }
}

// A TLS connection closed unless it is handed out.
object HttpUnpublishedTls {
    has origin is TlsConnection;
    has published is Event;

    // origin, kept once published fires.
    HttpUnpublishedTls(origin is TlsConnection, published is Event) {
        self.origin = origin;
        self.published = published;
    }

    // Closes origin unless it was handed out.
    close() is void {
        if !published.ready() {
            origin.close();
        }
    }
}

test "HTTP1 opener rejects incompatible ALPN before acquisition" {
    let route = HttpEndpointSelection(
        url: ParsedUrl("https://example.test/").parts(),
        resolver: FixedResolution(),
        access: AllEndpoints()
    );
    let versions is Set<TlsVersion> = OrderedSet([TlsVersion.tls1_3]);
    let policy = TlsClientPolicy(
        trust: TrustedCertificates(),
        versions: versions,
        protocols: ["h2"]
    );
    test.ok(try {
        Http1Connecting(route: route, policy: policy);
        false;
    }
    catch e is UnsupportedHttpVersion {
        true;
    });
}
