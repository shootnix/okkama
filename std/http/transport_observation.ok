module http/transport_observation v1.0.0;

import "net/failure" take NetworkFailure, NetworkFailureKind, NetworkClosed;
import "io/stream" take AsyncReading, AsyncWriting, ByteSource;
import "http/message" take InvalidHttpMessage;
import "async/atomic" take Atomic;
import "async/event" take Event;

// Used only by an exclusive HTTP1 conversation. Includes partial and 1xx
// bytes; absence of a parsed final head is insufficient evidence for replay.
object HttpResponseObservation {
    has observed is Atomic<Event>;
    has armed is Event;

    HttpResponseObservation() {
        observed = Atomic(Event());
        armed = Event();
    }

    begin() is void {
        observed.replace(Event());
        armed.set();
    }

    active() is bool {
        armed.ready();
    }

    received() is bool {
        observed.value().ready();
    }

    receive() is void {
        observed.value().set();
    }

    reading(origin is AsyncReading) is AsyncReading {
        HttpObservedReading(origin, self);
    }

    writing(origin is AsyncWriting) is AsyncWriting {
        HttpObservedWriting(origin, self);
    }
}

enum HttpPeerGoneBeforeResponse is Error = (reset(cause is NetworkFailure), closed(
    cause is NetworkClosed
), truncated(cause is InvalidHttpMessage));

object HttpObservedReading does AsyncReading {
    has origin is AsyncReading;
    has observation is HttpResponseObservation;

    HttpObservedReading(origin is AsyncReading, observation is HttpResponseObservation) {
        self.origin = origin;
        self.observation = observation;
    }

    async bytes(limit is int) is @byte {
        try {
            let pending = origin.bytes(limit);
            let bytes = await pending;
            if bytes.size() > 0 {
                observation.receive();
            }
            else {
                if observation.active() && !observation.received() {
                    throw HttpPeerGoneBeforeResponse.truncated(
                        InvalidHttpMessage.because("EOF before complete HTTP1 head")
                    );
                }
            }
            bytes;
        }
        catch e is NetworkFailure {
            match e {
                case NetworkFailure.detailed(_, kind, _) {
                    if observation.active()
                        && !observation.received()
                        && (kind == NetworkFailureKind.reset || kind == NetworkFailureKind.aborted) {
                            throw HttpPeerGoneBeforeResponse.reset(e);
                        }
                    throw;
                }
            }
        }
        catch e is NetworkClosed {
            if observation.active() && !observation.received() {
                throw HttpPeerGoneBeforeResponse.closed(e);
            }
            throw;
        }
    }
}

object HttpObservedWriting does AsyncWriting {
    has origin is AsyncWriting;
    has observation is HttpResponseObservation;

    HttpObservedWriting(origin is AsyncWriting, observation is HttpResponseObservation) {
        self.origin = origin;
        self.observation = observation;
    }

    async write(source is ByteSource) is AsyncWriting {
        try {
            let pending = origin.write(source);
            await pending;
            self;
        }
        catch e is NetworkFailure {
            match e {
                case NetworkFailure.detailed(_, kind, _) {
                    if observation.active()
                        && !observation.received()
                        && (kind == NetworkFailureKind.reset || kind == NetworkFailureKind.aborted) {
                            throw HttpPeerGoneBeforeResponse.reset(e);
                        }
                    throw;
                }
            }
        }
        catch e is NetworkClosed {
            if observation.active() && !observation.received() {
                throw HttpPeerGoneBeforeResponse.closed(e);
            }
            throw;
        }
    }
}
