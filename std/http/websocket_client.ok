module http/websocket_client v1.0.0;

import "http/status" take StatusCode, Status, StatusClass;
import "http/websocket" take WebSocketConnection, WebSocketLimits, WebSocketFailure, TextWebSocketMessage, BinaryWebSocketMessage, WebSocketMessageKind, WebSocketClosed;
import "http/websocket_handshake" take WebSocketClientHandshake;
import "http/websocket_session" take WebSocketSession;
import "http/internal/websocket_upgrade" take WebSocketOpeningCleanup, WebSocketPrefixedInput;
import "http/endpoint" take HttpEndpointSelection, EndpointAllowing, PublicEndpoints, AllEndpoints;
import "http/header" take Headers;
import "http/http1_head" take Http1Limits;
import "http/http1_reading" take Http1ResponseHeadReading;
import "http/http1_message_writing" take Http1RequestWriting;
import "http/body" take EmptyBody;
import "http/connection" take HttpAcquisitionCleanup, HttpTcpDisposal, HttpTlsDisposal, HttpUnpublishedTcp, HttpUnpublishedTls;
import "net/tcp" take TcpConnection, TcpOptions, TcpListening;
import "net/tcp_racing" take TcpRacing;
import "net/dns" take Resolving, FixedResolution, SystemResolution;
import "net/tls" take TlsClientPolicy, TlsClientHandshake, TlsConnection;
import "crypto/x509/trust" take CertificateIdentity, DnsCertificateIdentity, IpCertificateIdentity, TrustStore, SystemTrustStore;
import "url/value" take UrlParts, UrlHostKind, ParsedUrl;
import "random/source" take SecureRandom;
import "time/clock" take Timing, SystemClock;
import "time/duration" take Duration;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "async/timeout" take Within;
import "io/stream" take AsyncReading, AsyncWriting;
import "http/server" take HttpServer;
import "http/server_policy" take ServerPolicy;
import "http/handler" take Handling, HandlingResult, WebSocketHandling, WebSocketHandlingResult;
import "http/request_context" take HttpRequestContext;
import "http/message" take Request;
import "http/websocket_server" take WebSocketUpgrade;
import "http/websocket_origin" take WebSocketAllowing;

object WebSocketPolicy {
    has limits is WebSocketLimits;
    has opening, closing is Duration;
    has access is EndpointAllowing;

    WebSocketPolicy() {
        limits = WebSocketLimits();
        opening = Duration(seconds: 30);
        closing = Duration(seconds: 5);
        access = PublicEndpoints();
    }

    WebSocketPolicy(
        limits is WebSocketLimits,
        opening is Duration,
        closing is Duration,
        access is EndpointAllowing
    ) {
        confirm opening::Span::seconds > 0.rat() && closing::Span::seconds > 0.rat()
            else throw WebSocketFailure.because("positive WebSocket deadlines required");
        self.limits = limits;
        self.opening = opening;
        self.closing = closing;
        self.access = access;
    }

    limits() is WebSocketLimits {
        limits;
    }

    opening_timeout() is Duration {
        opening;
    }

    closing_timeout() is Duration {
        closing;
    }

    access() is EndpointAllowing {
        access;
    }
}

// Direct HTTP1 Upgrade opener; ordinary Exchanging cannot transfer the socket.
// Repeated connection() observes the same lazy attempt/result, never reconnects.
object WebSocketConnecting {
    has waiting is Future<WebSocketSession>;

    // WebSocketConnecting(url: ParsedUrl("wss://example.com/chat").parts()):
    // the system's DNS and trusted roots, no subprotocols and no extra
    // headers unless given, as HttpClient() does.
    WebSocketConnecting(
        url is UrlParts,
        protocols is @string = [],
        headers is Headers = Headers(),
        resolver is Resolving = SystemResolution(),
        trust is TrustStore = SystemTrustStore(),
        policy is WebSocketPolicy = WebSocketPolicy(),
        clock is Timing = SystemClock()
    ) {
        waiting = WebSocketStart(url: url, protocols: protocols, headers: headers, resolver: resolver, tls: TlsClientPolicy(trust), policy: policy, clock: clock).outcome();
    }

    WebSocketConnecting(
        url is UrlParts,
        protocols is @string,
        headers is Headers,
        resolver is Resolving,
        tls is TlsClientPolicy,
        policy is WebSocketPolicy,
        clock is Timing
    ) {
        waiting = WebSocketStart(url: url, protocols: protocols, headers: headers, resolver: resolver, tls: tls, policy: policy, clock: clock).outcome();
    }

    async connection() is WebSocketConnection {
        let group is FutureGroup<WebSocketSession> = FutureGroup();
        let taken = Event();
        let cleanup = WebSocketOpeningCleanup(group: group, waiting: waiting, taken: taken);
        defer await cleanup.close();
        group.start(waiting);
        let session = await waiting;
        taken.set();
        await session.started();
        session;
    }
}

hidden object WebSocketStart {
    has url is UrlParts;
    has protocols is @string;
    has headers is Headers;
    has resolver is Resolving;
    has tls is TlsClientPolicy;
    has policy is WebSocketPolicy;
    has clock is Timing;

    WebSocketStart(
        url is UrlParts,
        protocols is @string,
        headers is Headers,
        resolver is Resolving,
        tls is TlsClientPolicy,
        policy is WebSocketPolicy,
        clock is Timing
    ) {
        self.url = url;
        self.protocols = protocols;
        self.headers = headers;
        self.resolver = resolver;
        self.tls = tls;
        self.policy = policy;
        self.clock = clock;
    }

    outcome() is Future<WebSocketSession> {
        let nonce is @byte = (0..16).map() -> index {
            0.byte();
        };
        WebSocketClientHandshake(url: url, protocols: protocols, headers: headers, nonce: nonce);
        for tls.protocols() -> protocol {
            confirm protocol == "http/1.1"
                else throw WebSocketFailure.because("HTTP1 Upgrade ALPN policy required");
        }
        let parts = url;
        let transport = UrlParts(
            scheme: if parts::Parts::scheme == "wss" {
                "https";
            }
            else {
                "http";
            },
            userinfo: parts::Parts::userinfo,
            host: parts::Parts::host,
            port: parts::Parts::port,
            path: parts::Parts::path,
            query: parts::Parts::query,
            fragment: Maybe<string>.none,
        );
        let route = HttpEndpointSelection(url: transport, resolver: resolver, access: policy.access());
        let operation = WebSocketOpening(url: url, protocols: protocols, headers: headers, route: route, tls: tls, policy: policy, clock: clock);
        let bounded is Within<WebSocketSession> = Within(
            origin: operation.open(),
            limit: policy.opening_timeout(),
            clock: clock
        );
        bounded.outcome();
    }
}

object WebSocketOpening {
    has url is UrlParts;
    has protocols is @string;
    has headers is Headers;
    has route is HttpEndpointSelection;
    has tls is TlsClientPolicy;
    has policy is WebSocketPolicy;
    has clock is Timing;

    WebSocketOpening(
        url is UrlParts,
        protocols is @string,
        headers is Headers,
        route is HttpEndpointSelection,
        tls is TlsClientPolicy,
        policy is WebSocketPolicy,
        clock is Timing
    ) {
        self.url = url;
        self.protocols = protocols;
        self.headers = headers;
        self.route = route;
        self.tls = tls;
        self.policy = policy;
        self.clock = clock;
    }

    async open() is WebSocketSession {
        let random = SecureRandom();
        let handshake = WebSocketClientHandshake(url: url, protocols: protocols, headers: headers, nonce: random.bytes(16));
        let endpoints = await route.endpoints();
        let group is FutureGroup<TcpConnection> = FutureGroup();
        let empty is @Future<TcpConnection> = [];
        let pending = Atomic(empty);
        let taken = Event();
        let cleanup = HttpAcquisitionCleanup(group: group, pending: pending, taken: taken, dispose: HttpTcpDisposal().release);
        defer await cleanup.close();
        let waiting = TcpRacing(
            origins: endpoints,
            options: TcpOptions(),
            delay: Duration(milliseconds: 250),
            clock: clock
        ).connection();
        pending.replace([waiting]);
        group.start(waiting);
        let tcp = await waiting;
        taken.set();
        let published = Event();
        let anchor = HttpUnpublishedTcp(origin: tcp, published: published);
        defer anchor.close();
        if url::Parts::scheme == "wss" {
            let host = url;
            let identity is CertificateIdentity = if host.host_kind() == UrlHostKind.name {
                DnsCertificateIdentity(host.host_name());
            }
            else {
                IpCertificateIdentity(host.host_address());
            };
            let group is FutureGroup<TlsConnection> = FutureGroup();
            let empty is @Future<TlsConnection> = [];
            let pending = Atomic(empty);
            let taken = Event();
            let cleanup = HttpAcquisitionCleanup(group: group, pending: pending, taken: taken, dispose: HttpTlsDisposal().release);
            defer await cleanup.close();
            let waiting = TlsClientHandshake(origin: tcp, server: identity, policy: tls, clock: clock).connection();
            pending.replace([waiting]);
            group.start(waiting);
            let secure = await waiting;
            taken.set();
            let anchor = HttpUnpublishedTls(origin: secure, published: published);
            defer anchor.close();
            let protocol = secure.details()::Session::protocol;
            confirm protocol == "" || protocol == "http/1.1"
                else throw WebSocketFailure.because("negotiated ALPN is not HTTP1");
            let prefix = await self.upgrade(secure.input(), secure.output(), handshake);
            let session = WebSocketSession(
                input: WebSocketPrefixedInput(secure.input(), prefix),
                output: secure.output(),
                owner: secure,
                client: true,
                random: random,
                limits: policy.limits(),
                close_timeout: policy.closing_timeout(),
                clock: clock
            );
            published.set();
            return session;
        }
        let prefix = await self.upgrade(tcp.input(), tcp.output(), handshake);
        let session = WebSocketSession(
            input: WebSocketPrefixedInput(tcp.input(), prefix),
            output: tcp.output(),
            owner: tcp,
            client: true,
            random: random,
            limits: policy.limits(),
            close_timeout: policy.closing_timeout(),
            clock: clock
        );
        published.set();
        session;
    }

    async upgrade(
        input is AsyncReading,
        output is AsyncWriting,
        handshake is WebSocketClientHandshake
    ) is @byte {
        let pending = Http1RequestWriting(origin: output, request: handshake.request()).output();
        await pending;
        let empty is @byte = [];
        let prefix = Atomic(empty);
        let count = Atomic(0);
        loop {
            let pending = Http1ResponseHeadReading(origin: input, prefix: prefix.value(), limits: Http1Limits(), chunk_bytes: 4096).head();
            let received = await pending;
            let status = received.head()::Head::status;
            if StatusCode(status).class() == StatusClass.informational
                && status != Status.switching_protocols {
                    confirm count.value() < 16
                        else throw WebSocketFailure.because("informational handshake limit");
                    count.replace(count.value() + 1);
                    prefix.replace(received.remainder());
                    next;
                }
            handshake.selected(received.head().response(EmptyBody()));
            return received.remainder();
        }
    }
}

hidden object AnyWebSocketOrigin does WebSocketAllowing {
    AnyWebSocketOrigin();

    allowed(request is Request, destination is UrlParts) is bool {
        true;
    }
}

hidden object ShoutingEcho does Handling, WebSocketHandling {
    ShoutingEcho();

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        let upgrade = WebSocketUpgrade(
            protocols: [],
            limits: WebSocketLimits(),
            access: AnyWebSocketOrigin(),
            deadline: Duration(seconds: 5),
        );
        WebSocketHandlingResult(origin: upgrade, application: self);
    }

    async handle(connection is WebSocketConnection, request is Request, context is HttpRequestContext) is WebSocketHandling {
        try {
            loop {
                let message = await connection.message();
                if message.kind() == WebSocketMessageKind.text {
                    await connection.send(TextWebSocketMessage(message.text().upper()));
                }
                else {
                    await connection.send(BinaryWebSocketMessage(message.bytes() + message.bytes()));
                }
            }
        }
        catch e is WebSocketClosed {
            self;
        }
        self;
    }
}

async test "a WebSocket client talks to a server over loopback and closes cleanly" {
    let listener = await TcpListening(port: 0).listener();
    let clock = SystemClock();
    // WebSocket upgrades need the server's own URL to check the Origin against.
    let own = ParsedUrl("http://127.0.0.1:" + listener::Local::port.string() + "/").parts();
    let server = HttpServer(listener: listener, handling: ShoutingEcho(), policy: ServerPolicy(), clock: clock, url: own).started();
        let url = ParsedUrl("ws://127.0.0.1:" + server::Local::port.string() + "/echo").parts();
    let policy = WebSocketPolicy(
        limits: WebSocketLimits(),
        opening: Duration(seconds: 5),
        closing: Duration(seconds: 2),
        access: AllEndpoints(),
    );
    let connection = await WebSocketConnecting(url: url, resolver: FixedResolution(), policy: policy).connection();
    await connection.send(TextWebSocketMessage("hello"));
    test.is((await connection.message()).text(), "HELLO");
    await connection.send(BinaryWebSocketMessage([1.byte(), 2.byte()]));
    test.is((await connection.message()).bytes(), [1.byte(), 2.byte(), 1.byte(), 2.byte()]);
    await connection.close(1000, "done");
    test.is(connection.closed(), true);
    await server.drain(limit: Duration(seconds: 5));
}
