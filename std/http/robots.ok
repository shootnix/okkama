module http/robots v1.0.0;

import "http/status" take StatusCode, StatusClass;
import "url/value" take UrlParts, ParsedUrl, UrlComponentText;
import "url/percent" take UrlComponent;
import "http/exchange" take ClientResponse, Exchanging;
import "http/message" take Request;
import "http/target" take AbsoluteTarget;
import "http/method" take Method;
import "http/header" take Headers, Header, HeaderName, HttpAsciiLowercase;
import "time/duration" take Duration, DurationUnit;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "encoding/single_byte" take Latin1Encoded, Latin1Decoded;
import "strings/parse" take Number;
import "collections/list" take List, EmptyList;
import "collections/sequence" take Sequencing;
import "collections/ordering" take LowerBound;
import "runtime/collections" take string_star_match;
import "async/atomic" take Atomic;
import "async/scope" take FutureGroup;
import "io/decorators" take InvalidReading;

enum InvalidRobots is Error = (because(reason is string));

enum RobotsLimitExceeded is Error = (kind(kind is string));

enum MissingCrawlDelay is Error = (missing);

enum RobotsFetchFailed is Error = (status(status is int));

hidden object RobotsTrim {
    has origin is string;

    RobotsTrim(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let start = Atomic(0);
        let ending = Atomic(origin.length());
        loop {
            let at = start.value();
            if at == ending.value() {
                last;
            }
            let scalar = origin.slice(at, at + 1);
            if scalar != " " && scalar != "\t" {
                last;
            }
            start.replace(at + 1);
        }
        loop {
            let at = ending.value();
            if at == start.value() {
                last;
            }
            let scalar = origin.slice(at - 1, at);
            if scalar != " " && scalar != "\t" {
                last;
            }
            ending.replace(at - 1);
        }
        origin.slice(start.value(), ending.value());
    }
}

hidden object RobotsRecord {
    has name, value is string;
    has group is int;
    has pattern is @RobotsPattern;
    has parsed_delay is @Duration;

    RobotsRecord(name is string, value is string, group is int) {
        self.name = name;
        self.value = value;
        self.group = group;
        pattern = [];
        parsed_delay = [];
    }

    RobotsRecord(name is string, value is string, group is int, pattern is RobotsPattern) {
        self.name = name;
        self.value = value;
        self.group = group;
        self.pattern = [pattern];
        parsed_delay = [];
    }

    RobotsRecord(
        name is string,
        value is string,
        group is int,
        patterns is @RobotsPattern,
        delays is @Duration
    ) {
        self.name = name;
        self.value = value;
        self.group = group;
        pattern = patterns;
        parsed_delay = delays;
    }

    pattern() is RobotsPattern {
        confirm pattern.size() == 1 else throw InvalidRobots.because("record is not a rule");
        pattern[0];
    }

    delay() is Duration {
        confirm parsed_delay.size() == 1
            else throw InvalidRobots.because("record has no compiled delay");
        parsed_delay[0];
    }

    name() is string {
        name;
    }

    value() is string {
        value;
    }

    group() is int {
        group;
    }
}

object RobotsPolicy {
    has agents, delays is @RobotsRecord;
    has rules is @RobotsRule;
    has rule_groups, delay_groups is @int;
    has maps is @UrlParts;

    RobotsPolicy(origin is string) {
        confirm Utf8Encoded(origin).bytes().size() <= 524288
            else throw RobotsLimitExceeded.kind("bytes");
        let text = if origin != "" && origin.slice(0, 1) == "﻿" {
            origin.slice(1, origin.length());
        }
        else {
            origin;
        };
        let lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n");
        confirm lines.size() <= 16384 else throw RobotsLimitExceeded.kind("lines");
        let empty is List<RobotsRecord> = EmptyList();
        let records = Atomic(empty);
        let no_maps is List<UrlParts> = EmptyList();
        let sitemaps = Atomic(no_maps);
        let group = Atomic(-1);
        let has_rules = Atomic(false);
        for lines -> raw {
            confirm Utf8Encoded(raw).bytes().size() <= 8192
                else throw RobotsLimitExceeded.kind("line_bytes");
            let line = RobotsTrim(raw.split("#")[0]).string();
            let fields = line.split(":");
            if fields.size() < 2 {
                next;
            }
            let name = try {
                HttpAsciiLowercase(RobotsTrim(fields[0]).string()).string();
            }
            catch e is Error {
                "";
            };
            let value = RobotsTrim(line.slice(fields[0].length() + 1, line.length())).string();
            if name == "sitemap" {
                let found is @UrlParts = try {
                    let url = ParsedUrl(value).parts();
                    let parts = url;
                    confirm (parts::Parts::scheme == "http" || parts::Parts::scheme == "https")
                        && parts::Parts::host != Maybe<string>.none
                        && parts::Parts::fragment == Maybe<string>.none
                        else throw InvalidRobots.because("sitemap URL");
                    [url];
                }
                catch e is Error {
                    [];
                };
                for found -> url {
                    confirm sitemaps.value().size() < 256
                        else throw RobotsLimitExceeded.kind("sitemaps");
                    sitemaps.replace(sitemaps.value().prefix(url));
                }
                next;
            }
            if name == "user-agent" {
                let token = try {
                    RobotsAgent(value).string();
                }
                catch e is InvalidRobots {
                    "";
                };
                if token == "" {
                    next;
                }
                if group.value() < 0 || has_rules.value() {
                    group.replace(group.value() + 1);
                    has_rules.replace(false);
                }
                confirm group.value() < 256 else throw RobotsLimitExceeded.kind("groups");
                confirm records.value().size() < 4096
                    else throw RobotsLimitExceeded.kind("records");
                records.replace(records.value().prefix(RobotsRecord(name: name, value: token, group: group.value())));
                next;
            }
            if group.value() < 0 {
                next;
            }
            if name == "allow" || name == "disallow" {
                has_rules.replace(true);
                if value == "" {
                    next;
                }
                let patterns is @RobotsPattern = try {
                    [RobotsPattern(value)];
                }
                catch e is InvalidRobots {
                    [];
                };
                for patterns -> checked {
                    confirm records.value().size() < 4096
                        else throw RobotsLimitExceeded.kind("records");
                    records.replace(
                        records.value().prefix(RobotsRecord(name: name, value: value, group: group.value(), pattern: checked))
                    );
                }
            }
            if name == "crawl-delay" {
                let parsed is @Duration = try {
                    [RobotsDelay(value).duration()];
                }
                catch e is Error {
                    [];
                };
                for parsed -> checked {
                    confirm records.value().size() < 4096
                        else throw RobotsLimitExceeded.kind("records");
                    records.replace(
                        records.value().prefix(
                            RobotsRecord(name: name, value: value, group: group.value(), patterns: [], delays: [checked])
                        )
                    );
                }
            }
        }
        let backward is @RobotsRecord = records.value().map() -> entry {
            entry;
        };
        let entries is @RobotsRecord = (0..backward.size()).map() -> index {
            backward[backward.size() - index - 1];
        };
        agents = entries.filter() -> entry {
            entry.name() == "user-agent";
        };
        let rule_entries = entries.filter() -> entry {
            entry.name() == "allow" || entry.name() == "disallow";
        };
        let compiled is @RobotsRule = rule_entries.map() -> entry {
            RobotsRule(entry);
        };
        rules = compiled;
        let groups is @int = compiled.map() -> rule {
            rule.group();
        };
        rule_groups = groups;
        let delay_records = entries.filter() -> entry {
            entry.name() == "crawl-delay";
        };
        delays = delay_records;
        let delay_ids is @int = delay_records.map() -> entry {
            entry.group();
        };
        delay_groups = delay_ids;
        let reverse_maps is @UrlParts = sitemaps.value().map() -> url {
            url;
        };
        let ordered_maps is @UrlParts = (0..reverse_maps.size()).map() -> index {
            reverse_maps[reverse_maps.size() - index - 1];
        };
        maps = ordered_maps;
    }

    selected(agent is string) is @int {
        confirm agent != "" && agent.length() <= 256
            else throw InvalidRobots.because("agent identification");
        let lower = try {
            HttpAsciiLowercase(agent).string();
        }
        catch e is Error {
            throw InvalidRobots.because("ASCII agent required");
        };
        let scores is @int = agents.map() -> entry {
            RobotsAgentMatch(token: entry.value(), agent: lower).score();
        };
        let best = scores.reduce(-1) -> old, score {
            if score > old {
                score;
            }
            else {
                old;
            }
        };
        let positions = (0..agents.size()).filter() -> index {
            scores[index] == best && best >= 0;
        };
        let ids is @int = positions.map() -> index {
            agents[index].group();
        };
        ids;
    }

    allowed(agent is string, url is UrlParts) is bool {
        let parts = url;
        confirm parts::Parts::scheme == "http" || parts::Parts::scheme == "https"
            else throw InvalidRobots.because("HTTP URL required");
        let path = if parts::Parts::path == "" {
            "/";
        }
        else {
            parts::Parts::path;
        };
        if path == "/robots.txt" {
            return true;
        }
        let target = (path + match parts::Parts::query {
            case Maybe.some(query) {
                "?" + query;
            }
            else {
                "";
            }
        }).replace("*", "%2A").replace("$", "%24");
        let ids = self.selected(agent);
        let score = Atomic(-1);
        let permitted = Atomic(true);
        // Parsing emits groups monotonically, so their cached ids are already
        // ordered. Sorting selected ids restores source order and permits each
        // selected group once even when several agent records choose it.
        let selected = ids.ordering();
        for (0..selected.size()) -> index {
            let id = selected[index];
            if index > 0 && selected[index - 1] == id {
                next;
            }
            let start = LowerBound(origin: rule_groups, item: id).index();
            let stop = LowerBound(origin: rule_groups, item: id + 1).index();
            for (start..stop) -> at {
                let entry = rules[at];
                if entry.matches(target) {
                    let size = entry.specificity();
                    if size > score.value() || (size == score.value() && entry.name() == "allow") {
                        score.replace(size);
                        permitted.replace(entry.name() == "allow");
                    }
                }
            }
        }
        permitted.value();
    }

    delay(agent is string) is Duration {
        let ids = self.selected(agent).ordering();
        let found = Atomic(false);
        let seconds = Atomic(0.rat());
        defer found.close();
        defer seconds.close();
        for (0..ids.size()) -> index {
            let id = ids[index];
            if index > 0 && ids[index - 1] == id {
                next;
            }
            let start = LowerBound(origin: delay_groups, item: id).index();
            let stop = LowerBound(origin: delay_groups, item: id + 1).index();
            for (start..stop) -> at {
                found.replace(true);
                let value = delays[at].delay()::Span::seconds;
                if value > seconds.value() {
                    seconds.replace(value);
                }
            }
        }
        confirm found.value() else throw MissingCrawlDelay.missing;
        Duration(value: seconds.value(), unit: DurationUnit.second);
    }

    sitemaps() is Sequencing<UrlParts> {
        maps;
    }
}

hidden object RobotsAgent {
    has value is string;

    RobotsAgent(origin is string) {
        confirm origin != "" && origin.length() <= 128
            else throw InvalidRobots.because("agent token");
        if origin != "*" {
            for Utf8Encoded(origin).bytes() -> octet {
                let code = octet.int();
                confirm (code >= 65 && code <= 90)
                    || (code >= 97 && code <= 122)
                    || code == 45
                    || code == 95
                    else throw InvalidRobots.because("agent token grammar");
            }
        }
        value = HttpAsciiLowercase(origin).string();
    }

    string() is string {
        value;
    }
}

hidden object RobotsAgentMatch {
    has token, agent is string;

    RobotsAgentMatch(token is string, agent is string) {
        self.token = token;
        self.agent = agent;
    }

    score() is int {
        if token == "*" {
            0;
        }
        else {
            if agent.split(token).size() > 1 {
                token.length();
            }
            else {
                -1;
            }
        }
    }
}

hidden object RobotsRule {
    has entry is RobotsRecord;
    has pattern is RobotsPattern;

    RobotsRule(entry is RobotsRecord) {
        self.entry = entry;
        pattern = entry.pattern();
    }

    group() is int {
        entry.group();
    }

    name() is string {
        entry.name();
    }

    matches(target is string) is bool {
        pattern.matches(target);
    }

    specificity() is int {
        pattern.specificity();
    }
}

hidden object RobotsPattern {
    has value is string;
    has anchored, wildcard is bool;
    has weight is int;

    RobotsPattern(origin is string) {
        confirm origin != "" && origin.length() <= 8192 && origin.slice(0, 1) == "/"
            else throw InvalidRobots.because("path pattern");
        let terminal = origin.slice(origin.length() - 1, origin.length()) == "$";
        let body = if terminal {
            origin.slice(0, origin.length() - 1);
        }
        else {
            origin;
        };
        let compiled = try {
            UrlComponentText(origin: body.replace("$", "%24"), component: UrlComponent.query).string();
        }
        catch e is Error {
            throw InvalidRobots.because("path encoding");
        };
        value = compiled;
        anchored = terminal;
        wildcard = compiled.split("*").size() > 1;
        weight = compiled.replace("*", "").length();
    }

    string() is string {
        value + if anchored {
            "$";
        }
        else {
            "";
        };
    }

    specificity() is int {
        weight;
    }

    matches(target is string) is bool {
        // Exact literal and prefix checks need no per-character mutable state.
        // Escaped %2A remains literal; only compiled '*' enters the old matcher.
        if !wildcard {
            return if anchored {
                target == value;
            }
            else {
                target.length() >= value.length() && target.slice(0, value.length()) == value;
            };
        }
        try {
            string_star_match(value, target, anchored, 262144);
        }
        catch e is NativeFailure {
            if e.domain() == "core.collections" && e.code() == "resource_exhausted" {
                throw RobotsLimitExceeded.kind("match_steps");
            }
            throw;
        }
    }
}

hidden object RobotsDelay {
    has seconds is rat;

    RobotsDelay(origin is string) {
        confirm origin != "" && origin.length() <= 16
            else throw InvalidRobots.because("delay spelling");
        let parts = origin.split(".");
        confirm parts.size() <= 2 && parts[0] != ""
            else throw InvalidRobots.because("delay decimal");
        let denominator = Atomic(1);
        if parts.size() == 2 {
            confirm parts[1] != "" && parts[1].length() <= 9
                else throw InvalidRobots.because("delay precision");
            for (0..parts[1].length()) -> index {
                denominator.replace(denominator.value() * 10);
            }
        }
        let digits = parts.join("");
        for (0..digits.length()) -> index {
            confirm "0123456789".split(digits.slice(index, index + 1)).size() == 2
                else throw InvalidRobots.because("delay digits");
        }
        seconds = rat(Number(digits).int(), denominator.value());
        confirm self.seconds <= 86400.rat() else throw InvalidRobots.because("delay cap");
    }

    duration() is Duration {
        Duration(value: seconds, unit: DurationUnit.second);
    }
}

object FetchedRobots {
    has origin is Exchanging;
    has destination is UrlParts;
    has agent is string;
    has pending is Atomic<@Future<RobotsPolicy>>;

    FetchedRobots(origin is Exchanging, site is UrlParts, agent is string) {
        let parts = site;
        confirm (parts::Parts::scheme == "http" || parts::Parts::scheme == "https")
            && parts::Parts::host != Maybe<string>.none
            else throw InvalidRobots.because("HTTP site required");
        Header(name: HeaderName("User-Agent"), value: agent);
        self.origin = origin;
        destination = UrlParts(
            scheme: parts::Parts::scheme,
            userinfo: parts::Parts::userinfo,
            host: parts::Parts::host,
            port: parts::Parts::port,
            path: "/robots.txt",
            query: Maybe<string>.none,
            fragment: Maybe<string>.none,
        );
        self.agent = agent;
        let empty is @Future<RobotsPolicy> = [];
        pending = Atomic(empty);
    }

    async policy() is RobotsPolicy {
        let group is FutureGroup<RobotsPolicy> = FutureGroup();
        let cleanup = RobotsSettlement(group);
        defer await cleanup.close();
        let task = self.operation();
        group.start(task);
        await task;
    }

    async fetch() is RobotsPolicy {
        let request = Request(
            method: Method.get,
            target: AbsoluteTarget(destination),
            headers: Headers(
                [
                    Header(name: HeaderName("User-Agent"), value: agent),
                    Header(name: HeaderName("Accept"), value: "text/plain")
                ]
            )
        );
        let waiting = origin.response(request);
        let exchange = await waiting;
        let response = exchange::Exchange::response;
        let input = response.body().reading();
        defer input.close();
        let class = StatusCode(response::Head::status).class();
        if class == StatusClass.client_error {
            return RobotsPolicy("");
        }
        if class == StatusClass.server_error {
            return RobotsPolicy("User-agent: *\nDisallow: /\n");
        }
        confirm class == StatusClass.successful
            else throw RobotsFetchFailed.status(StatusCode(response::Head::status).number());
        let text = Atomic("");
        loop {
            let remaining = 524288 - text.value().length();
            let limit = if remaining >= 8192 {
                8192;
            }
            else {
                remaining + 1;
            };
            let pending = input.bytes(limit);
            let bytes = await pending;
            confirm bytes.size() <= limit
                else throw InvalidReading.because("robots input exceeded requested limit");
            confirm bytes.size() <= remaining else throw RobotsLimitExceeded.kind("bytes");
            if bytes.size() == 0 {
                last;
            }
            text.replace(text.value() + Latin1Decoded(bytes).string());
        }
        let decoded = try {
            Utf8Decoded(Latin1Encoded(text.value()).bytes()).string();
        }
        catch e is Error {
            throw InvalidRobots.because("UTF8 body required");
        };
        RobotsPolicy(decoded);
    }

    hidden operation() is Future<RobotsPolicy> {
        let known = pending.value();
        if known.size() > 0 {
            known[0];
        }
        else {
            let task = self.fetch();
            pending.replace([task]);
            task;
        }
    }
}

hidden object RobotsSettlement<T> {
    has group is FutureGroup<T>;

    RobotsSettlement(group is FutureGroup<T>) {
        self.group = group;
    }

    async close() is void {
        if group.active() > 0 {
            group.cancel();
            await group.wait();
        }
    }
}

test "wildcard fallback and implicit robots path" {
    let policy = RobotsPolicy("User-agent: *\nDisallow: /\n");
    test.ok(policy.allowed("Bot", ParsedUrl("https://example.test/robots.txt").parts()));
}
