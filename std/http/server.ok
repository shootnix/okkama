async test "a server speaks HTTPS and offers HTTP/2 and HTTP/1.1 by ALPN" {
    let listener = await TcpListening(port: 0).listener();
    let both is Set<HttpVersion> = OrderedSet([HttpVersion.http_1_1, HttpVersion.http_2]);
    let policy = ServerPolicy(
        protocols: both,
        limits: HttpLimits(),
        timeouts: ServerTimeouts(),
        connections: 8,
        ranges: 16
    );
    let identity = TlsIdentity(certificates: HTTPS_TEST_CERTIFICATE, key: HTTPS_TEST_KEY);
    let server = HttpServer(
        listener: listener,
        handling: EchoApplication(),
        tls: TlsServerPolicy(identity: identity),
        policy: policy,
        clock: SystemClock()
    ).started();
    let base = "https://127.0.0.1:" + server::Local::port.string();
    let modern = HttpClient(
        trust: PemTrustStore(HTTPS_TEST_CA),
        endpoints: LoopbackEndpoints(),
        protocols: both
    );
    let page = await modern.get(base + "/one");
    test.is(page::Head::version == HttpVersion.http_2, true);
    test.is(await page.text(), "GET /one ");
    let posted = await modern.post(url: base + "/notes", body: TextBody(text: "over tls"));
    test.is(await posted.text(), "POST /notes over tls");
    modern.close();
    let older = HttpClient(trust: PemTrustStore(HTTPS_TEST_CA), endpoints: LoopbackEndpoints());
    let plain = await older.get(base + "/two");
    test.is(plain::Head::version == HttpVersion.http_1_1, true);
    test.is(await plain.text(), "GET /two ");
    older.close();
    await server.drain(limit: Duration(seconds: 5));
    test.is(server.closed(), true);
}
