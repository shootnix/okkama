// Adopts an already selected H2 transport AFTER client preface. Pool/ALPN and
// external deadlines belong to opening/client decorators, never guessed here.
object Http2Session does Closing {
    has state is Http2SessionState;
    Http2Session(input is AsyncReading,output is AsyncWriting,owner is Closing,local is Http2Settings,peer is Http2PeerSettings,limits is HttpLimits){state=Http2SessionState(input,output,owner,local,peer,limits);}
    closed() is bool{state.closed();}accepting() is bool{state.accepting();}close() is void{state.close();}
    async settled() is bool{await state.settled();}
    async exchange(request is Request) is Http2Exchange{
        let operation=Http2SessionExchange(state,request);let group is FutureGroup<Http2Exchange>=FutureGroup();let cleanup=Http2SessionSettlement(group);defer await cleanup.close();
        let pending=operation.run();group.start(pending);await pending;
    }
    destroy{try{self.close();}catch e is Error{}catch e is NativeFailure{}}
}
object Http2Exchange does Closing {
    has request is Request;has response is Response;has information is @Response;has leases is @Closing;
    Http2Exchange(request is Request,response is Response,information is @Response){self.request=request;self.response=response;self.information=information;leases=[];}
    Http2Exchange(request is Request,response is Response,information is @Response,lease is Closing){self.request=request;self.response=response;self.information=information;leases=[lease];}
    closed() is bool{leases.size()==1 && leases[0].closed();}close() is void{for leases -> lease{lease.close();}}
    request() is Request{request;}response() is Response{response;}informational() is Sequencing<Response>{information;}
}
object Http2SessionState does Http2ReceivingEvents,Http2BodyEvents {
