object Http2RequestBodySending {
    has entry is Http2StreamEntry;has sender is Http2DataScheduler;has opening is BodyOpening;has declared,known is @BigInt;has maximum is int;
    Http2RequestBodySending(entry is Http2StreamEntry,sender is Http2DataScheduler,opening is BodyOpening,declared is @BigInt,known is @BigInt,maximum is int){self.entry=entry;self.sender=sender;self.opening=opening;self.declared=declared;self.known=known;self.maximum=maximum;}
