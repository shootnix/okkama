    start() is void{if !started.ready(){started.set();loops.start(self.reading());loops.start(self.writing());}}
    async reading() is bool{
        
        let group is FutureGroup<bool>=FutureGroup();let cleanup=Http2SessionSettlement(group);defer await cleanup.close();
        let reader=Http2ConnectionInput(input,self,output,local,peer.value(),HpackBudget(limits.header_bytes(),limits.header_bytes(),128));let pending=reader.run();group.start(pending);
