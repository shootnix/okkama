object Http2ExchangeCleanup {
    has entry is Http2StreamEntry;has published is Event;Http2ExchangeCleanup(entry is Http2StreamEntry,published is Event){self.entry=entry;self.published=published;}
    async close() is void{if !published.ready(){entry.close();await entry.settled();}}
