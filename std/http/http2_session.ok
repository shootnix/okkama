object Http2AdmissionCleanup{has owner is Http2SessionState;has position is int;Http2AdmissionCleanup(owner is Http2SessionState,position is int){self.owner=owner;self.position=position;}close() is void{owner.unqueue(position);}}
object Http2SessionSettlement<T>{has group is FutureGroup<T>;Http2SessionSettlement(group is FutureGroup<T>){self.group=group;}async close() is void{if group.active()>0{group.cancel();await group.wait();}}}
object Http2SessionClosed does Error{Http2SessionClosed();text() is string{"HTTP2 session closed";}}
object Http2Unprocessed does Error{has stream is int;Http2Unprocessed(stream is int){self.stream=stream;}stream() is int{stream;}text() is string{"HTTP2 request unprocessed after GOAWAY";}}
