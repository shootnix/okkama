object Http2HoldingSignal{has signal is Event;Http2HoldingSignal(signal is Event){self.signal=signal;}close() is void{signal.set();}}
object Http2HoldingCleanup{has entry is Http2StreamEntry;Http2HoldingCleanup(entry is Http2StreamEntry){self.entry=entry;}async close() is void{if !entry.finished_consumption(){entry.close();}else{entry.cancel_writing();}await entry.settled();}}
object Http2SessionExchange {
    has owner is Http2SessionState;has request is Request;
