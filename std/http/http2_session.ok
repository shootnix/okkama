    }
    window(update is Http2WindowIncrement) is void{sender.window(update);}
    settings(previous is Http2PeerSettings,current is Http2PeerSettings) is void{sender.settings(previous,current);peer.replace(current);self.wake();}
    local_settings(settings is Http2Settings) is void{}
