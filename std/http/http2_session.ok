        entries.replace(entries.value().filter()->entry{entry.stream()!=stream;});retiring.replace(retiring.value().filter()->entry{entry.stream()!=stream;});sender.close(stream);self.wake();
    }
    source_failed(stream is int,failure is Error) is void{for self.matching(stream) -> entry{entry.fail(failure);if entry.started() && !self.closed(){output.frame(Http2ResetFrame(stream,8).frame());}}}
    credit(stream is int,amount is int,stream_update is bool) is void{flow.credit(stream,amount,stream_update);}
