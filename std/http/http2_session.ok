    has loops is FutureGroup<bool>;has disposal is FutureGroup<bool>;has closing_started is Event;has retiring is Atomic<@Http2StreamHolding>;has serial is Atomic<int>;has admission is Atomic<@int>;
    Http2SessionState(input is AsyncReading,output is AsyncWriting,owner is Closing,local is Http2Settings,peer is Http2PeerSettings,limits is HttpLimits){
