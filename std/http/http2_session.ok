// Ready but unclaimed response bodies stay owned in a supervised task, just
// as pooled HTTP1 transports do; Atomic observations borrow this native owner.
object Http2StreamHolding {
    has owner is Http2SessionState;has stream is int;has request is Request;has known,declared is @BigInt;
    has ready,released,preserved is Event;has origin is Atomic<@Http2StreamEntry>;has group is FutureGroup<bool>;
    Http2StreamHolding(owner is Http2SessionState,stream is int,request is Request,known is @BigInt,declared is @BigInt){self.owner=owner;self.stream=stream;self.request=request;self.known=known;self.declared=declared;ready=Event();released=Event();preserved=Event();let empty is @Http2StreamEntry=[];origin=Atomic(empty);group=FutureGroup();}
    stream() is int{stream;}ready() is Event{ready;}values() is @Http2StreamEntry{origin.value();}
    async value() is Http2StreamEntry{await ready.wait();let values=origin.value();if values.size()==0{await group.wait();throw Http2SessionClosed();}values[0];}
    start() is void{group.start(self.run());}release() is void{released.set();}
    async run() is bool{
        let signal=Http2HoldingSignal(ready);defer signal.close();let entry=Http2StreamEntry(owner,stream,request,known,declared);
        let cleanup=Http2HoldingCleanup(entry);defer await cleanup.close();origin.replace([entry]);owner.attach(stream,entry.buffer());ready.set();entry.start();await released.wait();await entry.settled();true;
    }
    preserving() is bool{preserved.ready() && !released.ready();}
    close(failure is Error) is void{
        for origin.value() -> entry{entry.fail(failure);if entry.buffer().wire_ended() && !entry.finished_consumption() && !entry.buffer().closed(){preserved.set();}}
        ready.set();if !self.preserving(){released.set();group.cancel();}
