module http/message v1.0.0;

import "http/method" take Method, MethodName;
import "http/status" take Status, StatusCode;
import "http/header" take Headers;
import "http/body" take BodyOpening, EmptyBody;
import "http/version" take HttpVersion;
import "http/target" take RequestTarget, RequestTargetSnapshot, RequestTargetMethod, AbsoluteTarget;
import "url/value" take ParsedUrl;

// Immutable message metadata retains the body opening's declared capability.
// It never opens, measures, closes or queries replayability during construction.
// Connection/framing consumers own body consumption and transport validation.
// A request shows its head through the cap `Head`; `body()` is the opening to
// read. Unless told, it is a GET with no fields, an empty body and HTTP/1.1.
object Request {
    has method is Method;
    has target is RequestTarget;
    has headers is Headers;
    has body is BodyOpening;
    has version is HttpVersion;

    Request(
        target is RequestTarget,
        method is Method = Method.get,
        headers is Headers = Headers([]),
        body is BodyOpening = EmptyBody(),
        version is HttpVersion = HttpVersion.http_1_1
    ) {
        self.target = RequestCoordinates(method, target).target();
        self.method = method;
        self.headers = headers;
        self.body = body;
        self.version = version;
    }

    // A client request to an absolute http or https URL.
    Request(
        url is string,
        method is Method = Method.get,
        headers is Headers = Headers([]),
        body is BodyOpening = EmptyBody(),
        version is HttpVersion = HttpVersion.http_1_1
    ) {
        self.target = RequestCoordinates(method, AbsoluteTarget(ParsedUrl(url).parts())).target();
        self.method = method;
        self.headers = headers;
        self.body = body;
        self.version = version;
    }

    cap Head {
        method is Method {
            method;
        }

        target is RequestTarget {
            target;
        }

        headers is Headers {
            headers;
        }

        version is HttpVersion {
            version;
        }
    }

    body() is BodyOpening {
        body;
    }
}

// A response shows its head through the cap `Head`; `body()` is the opening
// to read. Unless told, it has no fields, an empty body and HTTP/1.1.
object Response {
    has status is Status;
    has headers is Headers;
    has body is BodyOpening;
    has version is HttpVersion;

    Response(
        status is Status,
        headers is Headers = Headers([]),
        body is BodyOpening = EmptyBody(),
        version is HttpVersion = HttpVersion.http_1_1
    ) {
        self.status = status;
        self.headers = headers;
        self.body = body;
        self.version = version;
    }

    cap Head {
        status is Status {
            status;
        }

        headers is Headers {
            headers;
        }

        version is HttpVersion {
            version;
        }
    }

    body() is BodyOpening {
        body;
    }
}

object RequestCoordinates {
    has target is RequestTarget;

    RequestCoordinates(method is Method, target is RequestTarget) {
        confirm MethodName(method).string().length() <= 8192
            else throw InvalidHttpMessage.because("method source limit exceeded");
        let checked = RequestTargetSnapshot(target).value();
        confirm RequestTargetMethod(method, checked.kind()).valid()
            else throw InvalidHttpMessage.because("method does not permit target form");
        self.target = checked;
    }

    target() is RequestTarget {
        target;
    }
}

enum InvalidHttpMessage is Error = (because(reason is string));

test "message metadata does not open its empty body" {
    let response = Response(status: StatusCode(299).status());
    test.ok(
        response::Head::status == Status.other(299)
            && response::Head::version == HttpVersion.http_1_1
    );
    test.ok(response.body().replayable() && response.body().length().string() == "0");
}

test "a request to a URL is a GET with no fields unless told" {
    let request = Request(url: "https://example.com/a?b=1");
    test.is(request::Head::method, Method.get);
    test.is(request::Head::target.string(), "https://example.com/a?b=1");
    test.is(request::Head::headers.entries().size(), 0);
    let put = Request(url: "https://example.com/a", method: Method.put);
    test.is(put::Head::method, Method.put);
}
