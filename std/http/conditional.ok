module http/conditional v1.0.0;

import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "encoding/single_byte" take Latin1Encoded, UnrepresentableLatin1Character;
import "error" take InvalidArgument;
import "numbers/bigint" take BigInt;
import "collections/ordering" take SortedBy;
import "compare" take Order;
import "http/header" take HttpAsciiLowercase;

// Immutable HTTP validators. This is etagc, not quoted-string: a backslash is
// opaque data and never quotes a following character. See http-conditional.md.
object EntityTag {
    has opaque is string;
    has weak is bool;

    EntityTag(value is string, weak is bool) {
        let bytes = try {
            Latin1Encoded(value).bytes();
        }
        catch UnrepresentableLatin1Character.at(offset) {
            throw InvalidEntityTag.located(offset, "validator is not an octet string");
        };
        for (0..bytes.size()) -> index {
            let code = bytes[index].int();
            confirm code == 33 || (code >= 35 && code <= 126) || code >= 128
                else throw InvalidEntityTag.located(index, "invalid opaque validator octet");
        }
        opaque = value;
        self.weak = weak;
    }

    string() is string {
        let prefix = if weak {
            "W/";
        }
        else {
            "";
        };
        prefix + "\"" + opaque + "\"";
    }

    strong_matches(other is EntityTag) is bool {
        !weak && !other::Tag::weak && opaque == other::Tag::opaque;
    }

    weak_matches(other is EntityTag) is bool {
        opaque == other::Tag::opaque;
    }

    cap Tag {
        opaque is string {
            opaque;
        }

        weak is bool {
            weak;
        }
    }
}

object ConditionalLimits {
    has bytes, entries is int;

    ConditionalLimits() {
        bytes = 8192;
        entries = 128;
    }

    ConditionalLimits(bytes is int, entries is int) {
        confirm bytes >= 0 && entries >= 0
            else throw InvalidArgument.because("conditional budgets must be nonnegative");
        self.bytes = bytes;
        self.entries = entries;
    }

    cap Limits {
        bytes is int {
            bytes;
        }

        entries is int {
            entries;
        }
    }
}

// A wildcard denotes any EXISTING representation. Existence is a consumer's
// precondition, not a hidden query performed by this pure list value.
object EntityTags {
    has origin is @EntityTag;
    has wildcard is bool;

    EntityTags() {
        origin = [];
        wildcard = true;
    }

    EntityTags(values is Sequencing<EntityTag>) {
        origin = EntityTagSnapshot(values, ConditionalLimits()).values();
        wildcard = false;
    }

    EntityTags(values is Sequencing<EntityTag>, limits is ConditionalLimits) {
        origin = EntityTagSnapshot(values, limits).values();
        wildcard = false;
    }

    wildcard() is bool {
        wildcard;
    }

    values() is Sequencing<EntityTag> {
        origin;
    }

    string() is string {
        if wildcard {
            "*";
        }
        else {
            let parts is @string = origin.map() -> tag {
                tag.string();
            };
            parts.join(", ");
        }
    }

    strong_matches(other is EntityTag) is bool {
        if wildcard {
            return true;
        }
        origin.reduce(false) -> matched, tag {
            matched || tag.strong_matches(other);
        };
    }

    weak_matches(other is EntityTag) is bool {
        if wildcard {
            return true;
        }
        origin.reduce(false) -> matched, tag {
            matched || tag.weak_matches(other);
        };
    }
}

object ParsedEntityTags {
    has origin is string;
    has limits is ConditionalLimits;

    ParsedEntityTags(origin is string) {
        self.origin = origin;
        limits = ConditionalLimits();
    }

    ParsedEntityTags(origin is string, limits is ConditionalLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    tags() is EntityTags {
        confirm origin.length() <= limits::Limits::bytes else throw ConditionalLimitExceeded.kind("bytes");
        try {
            Latin1Encoded(origin).bytes();
        }
        catch UnrepresentableLatin1Character.at(offset) {
            throw InvalidEntityTag.located(offset, "field is not an octet string");
        }
        let position = ConditionalPosition(self.space(0), 1);
        if position.index() == origin.length() {
            let empty is @EntityTag = [];
            return EntityTags(empty, limits);
        }
        if origin.slice(position.index(), position.index() + 1) == "*" {
            confirm self.space(position.index() + 1) == origin.length()
                else throw InvalidEntityTag.located(
                    position.index() + 1,
                    "wildcard must stand alone"
                );
            confirm limits::Limits::entries >= 1 else throw ConditionalLimitExceeded.kind("entries");
            return EntityTags();
        }
        confirm position.slots() <= limits::Limits::entries
            else throw ConditionalLimitExceeded.kind("entries");
        let tags is ConditionalItems<EntityTag> = ConditionalItems();
        loop {
            let at = position.index();
            last if at == origin.length();
            if origin.slice(at, at + 1) == "," {
                position = position.separator(self.space(at + 1));
                confirm position.slots() <= limits::Limits::entries
                    else throw ConditionalLimitExceeded.kind("entries");
                next;
            }
            let weak = origin.length() - at >= 2 && origin.slice(at, at + 2) == "W/";
            let quote = at + if weak {
                2;
            }
            else {
                0;
            };
            confirm quote < origin.length() && origin.slice(quote, quote + 1) == "\""
                else throw InvalidEntityTag.located(quote, "expected quoted entity tag");
            let start = quote + 1;
            let cursor = ConditionalPosition(start, 0);
            loop {
                confirm cursor.index() < origin.length()
                    else throw InvalidEntityTag.located(quote, "unterminated entity tag");
                last if origin.slice(cursor.index(), cursor.index() + 1) == "\"";
                cursor = cursor.following(cursor.index() + 1);
            }
            let tag = try {
                EntityTag(origin.slice(start, cursor.index()), weak);
            }
            catch InvalidEntityTag.located(offset, reason) {
                throw InvalidEntityTag.located(start + offset, reason);
            };
            tags = tags.following(tag);
            position = position.following(self.space(cursor.index() + 1));
            confirm position.index() == origin.length()
                || origin.slice(position.index(), position.index() + 1) == ","
                else throw InvalidEntityTag.located(position.index(), "expected list separator");
        }
        EntityTags(tags.values(), limits);
    }

    hidden space(start is int) is int {
        let position = ConditionalPosition(start, 0);
        loop {
            let at = position.index();
            if at == origin.length() {
                return at;
            }
            let char = origin.slice(at, at + 1);
            if char != " " && char != "\t" {
                return at;
            }
            position = position.following(at + 1);
        }
    }
}

// Snapshot size is validated before invoking a user sequence's item action.
hidden object EntityTagSnapshot {
    has origin is @EntityTag;

    EntityTagSnapshot(values is Sequencing<EntityTag>, limits is ConditionalLimits) {
        let count = values.size();
        confirm count >= 0 else throw InvalidArgument.because("negative entity tag sequence size");
        confirm count <= limits::Limits::entries else throw ConditionalLimitExceeded.kind("entries");
        let tags is @EntityTag = (0..count).map() -> index {
            values.item(index);
        };
        let used = tags.reduce(0) -> total, tag {
            let size = tag.string().length() + if total == 0 {
                0;
            }
            else {
                2;
            };
            confirm size <= limits::Limits::bytes - total
                else throw ConditionalLimitExceeded.kind("bytes");
            total + size;
        };
        origin = tags;
    }

    values() is @EntityTag {
        origin;
    }
}

// Persistent list accumulation avoids rebuilding a complete array per member.
object ConditionalItems<T> {
    has reversed is List<T>;

    ConditionalItems() {
        let empty is List<T> = EmptyList();
        reversed = empty;
    }

    following(item is T) is ^ConditionalItems<T> {
        ^reversed = reversed.prefix(item);
    }

    values() is @T {
        let reverse is @T = reversed.map() -> item {
            item;
        };
        let ordered is @T = (0..reverse.size()).map() -> index {
            reverse[reverse.size() - index - 1];
        };
        ordered;
    }
}

hidden object ConditionalPosition {
    has index, slots is int;

    ConditionalPosition(index is int, slots is int) {
        confirm index >= 0 && slots >= 0
            else throw InvalidArgument.because("negative conditional position");
        self.index = index;
        self.slots = slots;
    }

    index() is int {
        index;
    }

    slots() is int {
        slots;
    }

    following(index is int) is ^ConditionalPosition {
        ^index = index;
    }

    separator(index is int) is ^ConditionalPosition {
        ^index = index;
        ^slots = slots + 1;
    }
}

// A concrete interval has inclusive bounds and is always nonempty. Its size
// derives from the bounds with arbitrary precision, never from an int cast.
object ByteRange {
    has start, end is BigInt;

    ByteRange(start is BigInt, end is BigInt) {
        confirm start.sign() >= 0 && end.order(start) != Order.less
            else throw InvalidRange.because("invalid inclusive coordinates");
        self.start = start;
        self.end = end;
    }

    start() is BigInt {
        start;
    }

    end() is BigInt {
        end;
    }

    size() is BigInt {
        ((end - start) + BigInt("1"));
    }

    string() is string {
        start.string() + "-" + end.string();
    }
}

object ByteRanges {
    has origin is @ByteRangeSpec;

    ByteRanges(origin is string) {
        self.origin = ByteRangeParsing(origin, ConditionalLimits()).values();
    }

    ByteRanges(origin is string, limits is ConditionalLimits) {
        self.origin = ByteRangeParsing(origin, limits).values();
    }

    string() is string {
        let parts is @string = origin.map() -> entry {
            entry.string();
        };
        "bytes=" + parts.join(", ");
    }

    satisfiable(size is BigInt) is bool {
        confirm size.sign() >= 0
            else throw InvalidRange.because("negative or unknown representation size");
        origin.reduce(false) -> matched, entry {
            matched || entry.satisfiable(size);
        };
    }

    ranges(size is BigInt) is Sequencing<ByteRange> {
        confirm size.sign() >= 0
            else throw InvalidRange.because("negative or unknown representation size");
        let materialized is ConditionalItems<ByteRange> = ConditionalItems();
        for origin -> entry {
            for entry.ranges(size) -> range {
                materialized = materialized.following(range);
            }
        }
        let sorted is SortedBy<ByteRange, BigInt> = SortedBy(
            origin: materialized.values(),
            key: (range is ByteRange) is BigInt {
                range.start();
            }
        );
        let merged = CoalescedByteRanges();
        for sorted -> range {
            merged = merged.following(range);
        }
        merged.values();
    }
}

// A validated wire spec has zero/one first and last coordinates: suffix, open,
// or bounded. No negative/maximum sentinel pretends to be a missing position.
hidden object ByteRangeSpec {
    has lower, upper is @BigInt;

    ByteRangeSpec(origin is string) {
        let fields = origin.split("-");
        confirm fields.size() == 2 else throw InvalidRange.because("expected one range dash");
        confirm fields[0] != "" || fields[1] != "" else throw InvalidRange.because("empty range");
        let left is @BigInt = if fields[0] == "" {
            [];
        }
        else {
            [ConditionalDecimal(fields[0]).integer()];
        };
        let right is @BigInt = if fields[1] == "" {
            [];
        }
        else {
            [ConditionalDecimal(fields[1]).integer()];
        };
        if left.size() == 1 && right.size() == 1 {
            confirm right[0].order(left[0]) != Order.less
                else throw InvalidRange.because("end precedes start");
        }
        lower = left;
        upper = right;
    }

    string() is string {
        let left = if lower.size() == 0 {
            "";
        }
        else {
            lower[0].string();
        };
        let right = if upper.size() == 0 {
            "";
        }
        else {
            upper[0].string();
        };
        left + "-" + right;
    }

    satisfiable(size is BigInt) is bool {
        confirm size.sign() >= 0 else throw InvalidRange.because("negative representation size");
        if lower.size() == 0 {
            upper[0].sign() > 0;
        }
        else {
            lower[0].order(size) == Order.less;
        }
    }

    ranges(size is BigInt) is @ByteRange {
        confirm size.sign() >= 0 else throw InvalidRange.because("negative representation size");
        if size.sign() == 0 || !self.satisfiable(size) {
            let empty is @ByteRange = [];
            return empty;
        }
        let end = (size - BigInt("1"));
        if lower.size() == 0 {
            let start = if upper[0].order(size) == Order.less {
                (size - upper[0]);
            }
            else {
                BigInt("0");
            };
            return [ByteRange(start, end)];
        }
        let clipped = if upper.size() == 1 && upper[0].order(end) == Order.less {
            upper[0];
        }
        else {
            end;
        };
        [ByteRange(lower[0], clipped)];
    }
}

hidden object ByteRangeParsing {
    has origin is string;
    has limits is ConditionalLimits;

    ByteRangeParsing(origin is string, limits is ConditionalLimits) {
        self.origin = origin;
        self.limits = limits;
    }

    values() is @ByteRangeSpec {
        confirm origin.length() <= limits::Limits::bytes else throw ConditionalLimitExceeded.kind("bytes");
        try {
            Latin1Encoded(origin).bytes();
        }
        catch failure is UnrepresentableLatin1Character {
            throw InvalidRange.because("field is not an octet string");
        }
        let field = ConditionalText(origin).string();
        let fields = field.split("=");
        confirm fields.size() == 2 && HttpAsciiLowercase(fields[0]).string() == "bytes"
            else throw InvalidRange.because("expected bytes range unit");
        let parts = fields[1].split(",");
        confirm parts.size() <= limits::Limits::entries
            else throw ConditionalLimitExceeded.kind("entries");
        let texts is @string = parts.map() -> part {
            ConditionalText(part).string();
        };
        let nonempty is @string = texts.filter() -> part {
            part != "";
        };
        confirm nonempty.size() > 0 else throw InvalidRange.because("range list requires a member");
        let values is @ByteRangeSpec = nonempty.map() -> part {
            ByteRangeSpec(part);
        };
        let canonical is @string = values.map() -> part {
            part.string();
        };
        confirm 6 + canonical.join(", ").length() <= limits::Limits::bytes
            else throw ConditionalLimitExceeded.kind("bytes");
        values;
    }
}

hidden object ConditionalDecimal {
    has origin is string;

    ConditionalDecimal(origin is string) {
        self.origin = origin;
    }

    integer() is BigInt {
        confirm origin.length() > 0 else throw InvalidRange.because("empty decimal coordinate");
        let bytes = try {
            Latin1Encoded(origin).bytes();
        }
        catch failure is UnrepresentableLatin1Character {
            throw InvalidRange.because("ASCII decimal required");
        };
        for bytes -> octet {
            confirm octet.int() >= 48 && octet.int() <= 57
                else throw InvalidRange.because("ASCII decimal required");
        }
        BigInt(origin);
    }
}

// Strict HTTP OWS, not the host's Unicode whitespace trimming policy.
hidden object ConditionalText {
    has origin is string;

    ConditionalText(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let left = ConditionalPosition(0, 0);
        let right = ConditionalPosition(origin.length(), 0);
        loop {
            last if left.index() == right.index();
            let char = origin.slice(left.index(), left.index() + 1);
            last if char != " " && char != "\t";
            left = left.following(left.index() + 1);
        }
        loop {
            last if right.index() == left.index();
            let char = origin.slice(right.index() - 1, right.index());
            last if char != " " && char != "\t";
            right = right.following(right.index() - 1);
        }
        origin.slice(left.index(), right.index());
    }
}

hidden object CoalescedByteRanges {
    has reversed is List<ByteRange>;

    CoalescedByteRanges() {
        let empty is List<ByteRange> = EmptyList();
        reversed = empty;
    }

    following(range is ByteRange) is ^CoalescedByteRanges {
        if reversed.size() == 0 {
            ^reversed = reversed.prefix(range);
        }
        else {
            let previous = reversed.first();
            confirm range.start().order(previous.start()) != Order.less
                else throw InvalidRange.because("coalescing requires sorted intervals");
            let after = (previous.end() + BigInt("1"));
            if range.start().order(after) != Order.greater {
                let end = if range.end().order(previous.end()) == Order.greater {
                    range.end();
                }
                else {
                    previous.end();
                };
                ^reversed = reversed.tail().prefix(ByteRange(previous.start(), end));
            }
            else {
                ^reversed = reversed.prefix(range);
            }
        }
    }

    values() is @ByteRange {
        let reverse is @ByteRange = reversed.map() -> range {
            range;
        };
        let ordered is @ByteRange = (0..reverse.size()).map() -> index {
            reverse[reverse.size() - index - 1];
        };
        ordered;
    }
}

enum InvalidRange is Error = (because(reason is string));

enum InvalidEntityTag is Error = (located(offset is int, reason is string));

enum ConditionalLimitExceeded is Error = (kind(kind is string));

test "entity tag comparison respects validator strength" {
    let strong = EntityTag("version-1", false);
    let weak = EntityTag("version-1", true);
    test.is(strong.strong_matches(weak), false);
    test.is(strong.weak_matches(weak), true);
    test.is(ParsedEntityTags("\"a,b\", W/\"version-1\"").tags().weak_matches(strong), true);
}

test "entity tag list wildcard and empty list differ" {
    test.is(EntityTags().string(), "*");
    let empty is @EntityTag = [];
    test.is(EntityTags(empty).weak_matches(EntityTag("", false)), false);
}

test "byte range plans normalize exact inclusive intervals" {
    let ranges = ByteRanges("bytes=9-, 0-4, 3-8").ranges(BigInt("10"));
    test.is(ranges.size(), 1);
    test.is(ranges.first().size().string(), "10");
    test.is(ByteRanges("bytes=-1").satisfiable(BigInt("0")), true);
}
