module http/target v1.0.0;

import "http/method" take Method;
import "url/value" take UrlParts, UrlComponentText, ParsedUrl, InvalidUrl;
import "url/percent" take UrlComponent;
import "encoding/single_byte" take AsciiEncoded, UnrepresentableAsciiCharacter;

enum RequestTargetKind = (origin, absolute, authority, asterisk);

role RequestTarget {
    kind() is RequestTargetKind;
    path() is string;
    query() is Maybe<string>;
    url() is UrlParts;
    authority() is UrlParts;
    string() is string;
}

// Origin-form owns absolute path/query coordinates. A generic URI-reference
// would interpret //path as authority, so it is not the carrier of this form.
object OriginTarget does RequestTarget {
    has path is string;
    has query is Maybe<string>;

    // The path and query are kept in their canonical spelling.
    OriginTarget(path is string, query is Maybe<string>) {
        confirm path != "" && path.length() <= 8192 && path.slice(0, 1) == "/"
            else throw InvalidRequestTarget.because("absolute origin path required");
        let canonical = try {
            UrlComponentText(origin: path, component: UrlComponent.path).string();
        }
        catch e is InvalidUrl {
            throw InvalidRequestTarget.because("invalid origin path");
        };
        let canonical_query is Maybe<string> = match query {
            case Maybe.some(text) {
                let checked = try {
                    UrlComponentText(origin: text, component: UrlComponent.query).string();
                }
                catch e is InvalidUrl {
                    throw InvalidRequestTarget.because("invalid origin query");
                };
                Maybe.some(checked);
            }
            else {
                Maybe<string>.none;
            }
        };
        let wire = canonical + match canonical_query {
            case Maybe.some(text) {
                "?" + text;
            }
            else {
                "";
            }
        };
        confirm wire.length() <= 8192
            else throw InvalidRequestTarget.because("target byte limit exceeded");
        self.path = canonical;
        self.query = canonical_query;
    }

    OriginTarget(origin is UrlParts) {
        confirm origin::Parts::scheme == ""
            && origin::Parts::host == Maybe<string>.none
            && origin::Parts::fragment == Maybe<string>.none
            else throw InvalidRequestTarget.because(
                "origin coordinates cannot contain scheme, authority or fragment"
            );
        let checked = OriginTarget(path: origin::Parts::path, query: origin::Parts::query);
        path = checked.path();
        query = checked.query();
    }

    kind() is RequestTargetKind {
        RequestTargetKind.origin;
    }

    path() is string {
        path;
    }

    query() is Maybe<string> {
        query;
    }

    url() is UrlParts {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.absolute, self.kind());
    }

    authority() is UrlParts {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.authority, self.kind());
    }

    string() is string {
        path + match query {
            case Maybe.some(text) {
                "?" + text;
            }
            else {
                "";
            }
        };
    }
}

object AbsoluteTarget does RequestTarget {
    has origin is UrlParts;

    AbsoluteTarget(origin is UrlParts) {
        confirm origin::Parts::scheme == "http" || origin::Parts::scheme == "https"
            else throw InvalidRequestTarget.because("HTTP absolute URL required");
        confirm (origin::Parts::host else "") != ""
            else throw InvalidRequestTarget.because("nonempty HTTP authority required");
        confirm origin::Parts::userinfo == Maybe<string>.none
            && origin::Parts::fragment == Maybe<string>.none
            else throw InvalidRequestTarget.because("userinfo and fragment cannot enter target");
        confirm origin.string().length() <= 8192
            else throw InvalidRequestTarget.because("target byte limit exceeded");
        self.origin = origin;
    }

    kind() is RequestTargetKind {
        RequestTargetKind.absolute;
    }

    url() is UrlParts {
        origin;
    }

    // The URL's path and query: an absolute target reads like an origin one.
    path() is string {
        origin::Parts::path;
    }

    query() is Maybe<string> {
        origin::Parts::query;
    }

    authority() is UrlParts {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.authority, self.kind());
    }

    string() is string {
        origin.string();
    }
}

// The authority-form of CONNECT: host and port only, as the parts of
// ParsedUrl("//" + authority).
object AuthorityTarget does RequestTarget {
    has origin is UrlParts;

    AuthorityTarget(origin is UrlParts) {
        confirm origin::Parts::scheme == ""
            && origin::Parts::path == ""
            && origin::Parts::query == Maybe<string>.none
            && origin::Parts::fragment == Maybe<string>.none
            else throw InvalidRequestTarget.because("CONNECT target is an authority only");
        confirm (origin::Parts::host else "") != ""
            else throw InvalidRequestTarget.because("nonempty CONNECT authority required");
        confirm origin::Parts::userinfo == Maybe<string>.none
            else throw InvalidRequestTarget.because("CONNECT userinfo prohibited");
        confirm origin::Parts::port != Maybe<int>.none
            else throw InvalidRequestTarget.because("explicit CONNECT port required");
        confirm origin.authority().length() <= 8192
            else throw InvalidRequestTarget.because("target byte limit exceeded");
        self.origin = origin;
    }

    kind() is RequestTargetKind {
        RequestTargetKind.authority;
    }

    authority() is UrlParts {
        origin;
    }

    path() is string {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.origin, self.kind());
    }

    query() is Maybe<string> {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.origin, self.kind());
    }

    url() is UrlParts {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.absolute, self.kind());
    }

    string() is string {
        origin.authority();
    }
}

object AsteriskTarget does RequestTarget {
    AsteriskTarget();

    kind() is RequestTargetKind {
        RequestTargetKind.asterisk;
    }

    string() is string {
        "*";
    }

    path() is string {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.origin, self.kind());
    }

    query() is Maybe<string> {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.origin, self.kind());
    }

    url() is UrlParts {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.absolute, self.kind());
    }

    authority() is UrlParts {
        throw WrongRequestTargetKind.detailed(RequestTargetKind.authority, self.kind());
    }
}

object RequestTargetMethod {
    has method is Method;
    has kind is RequestTargetKind;

    RequestTargetMethod(method is Method, kind is RequestTargetKind) {
        self.method = method;
        self.kind = kind;
    }

    valid() is bool {
        if method == Method.connect {
            return kind == RequestTargetKind.authority;
        }
        kind != RequestTargetKind.authority
            && (kind != RequestTargetKind.asterisk || method == Method.options);
    }
}

object ParsedRequestTarget {
    has origin is string;
    has method is Method;

    ParsedRequestTarget(origin is string, method is Method) {
        self.origin = origin;
        self.method = method;
    }

    target() is RequestTarget {
        confirm origin != "" && origin.length() <= 8192
            else throw InvalidRequestTarget.because("target source length");
        try {
            AsciiEncoded(origin).bytes();
        }
        catch e is UnrepresentableAsciiCharacter {
            throw InvalidRequestTarget.because("ASCII wire target required");
        }
        confirm !origin.contains("#")
            else throw InvalidRequestTarget.because("wire target fragment prohibited");
        let parsed is RequestTarget = try {
            if origin == "*" {
                AsteriskTarget();
            }
            else {
                if method == Method.connect {
                    AuthorityTarget(ParsedUrl("//" + origin).parts());
                }
                else {
                    if origin.slice(0, 1) == "/" {
                        let mark = origin.find("?") else -1;
                        let query is Maybe<string> = if mark < 0 {
                            Maybe<string>.none;
                        }
                        else {
                            Maybe.some(origin.slice(mark + 1, origin.length()));
                        };
                        let path = if mark < 0 {
                            origin;
                        }
                        else {
                            origin.slice(0, mark);
                        };
                        OriginTarget(path: path, query: query);
                    }
                    else {
                        AbsoluteTarget(ParsedUrl(origin).parts());
                    }
                }
            }
        }
        catch e is InvalidUrl {
            throw InvalidRequestTarget.because("invalid target URL coordinates");
        };
        confirm RequestTargetMethod(method: method, kind: parsed.kind()).valid()
            else throw InvalidRequestTarget.because("method does not permit target form");
        parsed;
    }
}

// Read only role coordinates and retain a fresh validated representation. A
// nominal tag alone cannot certify a hand-written string() implementation.
object RequestTargetSnapshot {
    has origin is RequestTarget;

    RequestTargetSnapshot(origin is RequestTarget) {
        self.origin = origin;
    }

    target() is RequestTarget {
        let wire = origin.string();
        confirm wire != "" && wire.length() <= 8192
            else throw InvalidRequestTarget.because("target byte limit exceeded");
        let checked is RequestTarget = match origin.kind() {
            case RequestTargetKind.origin {
                OriginTarget(path: origin.path(), query: origin.query());
            }
            case RequestTargetKind.absolute {
                AbsoluteTarget(origin.url());
            }
            case RequestTargetKind.authority {
                AuthorityTarget(origin.authority());
            }
            case RequestTargetKind.asterisk {
                AsteriskTarget();
            }
            else {
                throw InvalidRequestTarget.because("unknown target form");
            }
        };
        confirm checked.string() == wire
            else throw InvalidRequestTarget.because("target wire disagrees with coordinates");
        checked;
    }
}

enum WrongRequestTargetKind is Error = (detailed(
    expected is RequestTargetKind,
    actual is RequestTargetKind
));

enum InvalidRequestTarget is Error = (because(reason is string));

test "origin-form keeps double slash path and explicit query" {
    let target = ParsedRequestTarget(origin: "//a/b?", method: Method.get).target();
    test.ok(target.kind() == RequestTargetKind.origin && target.path() == "//a/b");
    test.ok(target.query() == Maybe.some("") && target.string() == "//a/b?");
    test.ok(!RequestTargetMethod(method: Method.get, kind: RequestTargetKind.asterisk).valid());
}
