module http/auth_challenge v1.0.0;

// WWW-Authenticate challenges (RFC 9110 §11): the schemes a server offers.
//
//     for AuthenticationChallenges(response::Head::headers.text("WWW-Authenticate")).values() -> challenge {
//         challenge::Challenge::scheme;                  // "digest", lowercase
//         challenge.parameter("realm");
//     }
//
// Input is bounded: 8192 bytes, 32 challenges and 32 parameters each, by
// default.

import "http/header" take HttpAsciiLowercase;
import "http/media_type" take HttpMediaOctet, HttpMediaPosition, HttpMediaScanned, HttpMediaItems;
import "encoding/single_byte" take Latin1Encoded, Latin1Decoded, UnrepresentableLatin1Character;
import "io/buffer" take ByteBuffer;

// One `name=value` parameter of a challenge.
object AuthenticationParameter {
    has name, value is string;
    has quoted is bool;

    // The parameter; quoted says whether its value was quoted.
    AuthenticationParameter(name is string, value is string, quoted is bool) {
        self.name = HttpAsciiLowercase(name).string();
        self.value = value;
        self.quoted = quoted;
    }

    // Its name, lowercase.
    name() is string {
        name;
    }

    // Its value, unquoted.
    value() is string {
        value;
    }

    // Whether it was quoted.
    quoted() is bool {
        quoted;
    }
}

// One challenge: a scheme and either parameters or a token68.
object AuthenticationChallenge {
    has scheme is string;
    has parameters is @AuthenticationParameter;
    has token is string;

    // The challenge as given.
    AuthenticationChallenge(
        scheme is string,
        parameters is @AuthenticationParameter,
        token68 is string
    ) {
        self.scheme = HttpAsciiLowercase(scheme).string();
        self.parameters = parameters;
        token = token68;
    }

    // Whether it has the parameter.
    present(name is string) is bool {
        let key = HttpAsciiLowercase(name).string();
        parameters.reduce(false) -> found, parameter {
            found || parameter.name() == key;
        };
    }

    // The parameter's value; InvalidAuthenticationChallenge when absent.
    parameter(name is string) is string {
        let key = HttpAsciiLowercase(name).string();
        for parameters -> parameter {
            if parameter.name() == key {
                return parameter.value();
            }
        }
        throw InvalidAuthenticationChallenge.because("missing parameter");
    }

    // Whether the parameter was quoted.
    quoted(name is string) is bool {
        let key = HttpAsciiLowercase(name).string();
        for parameters -> parameter {
            if parameter.name() == key {
                return parameter.quoted();
            }
        }
        throw InvalidAuthenticationChallenge.because("missing parameter");
    }

    // The scheme, lowercase, and the token68 ("" for none).
    cap Challenge {
        scheme is string {
            scheme;
        }

        token68 is string {
            token;
        }
    }
}

// The challenges of a WWW-Authenticate value.
object AuthenticationChallenges {
    has origin is @AuthenticationChallenge;

    // Reads origin within 8192 bytes, 32 challenges and 32 parameters.
    AuthenticationChallenges(origin is string) {
        self.origin = AuthenticationChallengeScanning(
            origin: origin,
            budget: 8192,
            challenges: 32,
            parameters: 32
        ).values();
    }

    // Reads origin within these limits.
    AuthenticationChallenges(origin is string, bytes is int, challenges is int, parameters is int) {
        self.origin = AuthenticationChallengeScanning(
            origin: origin,
            budget: bytes,
            challenges: challenges,
            parameters: parameters
        ).values();
    }

    // The challenges, in order.
    values() is @AuthenticationChallenge {
        origin;
    }
}

// Bounded HTTP auth grammar. A comma belongs to the current challenge only
// when the following token is an assignment; quoted commas remain data.
hidden object AuthenticationChallengeScanning {
    has text is string;
    has bytes is @byte;
    has width, challenge_limit, parameter_limit is int;

    AuthenticationChallengeScanning(
        origin is string,
        budget is int,
        challenges is int,
        parameters is int
    ) {
        confirm budget >= 0 && challenges >= 0 && parameters >= 0 && origin.length() <= budget
            else throw InvalidAuthenticationChallenge.because("limits");
        let wire = try {
            Latin1Encoded(origin).bytes();
        }
        catch e is UnrepresentableLatin1Character {
            throw InvalidAuthenticationChallenge.because("invalid octet");
        };
        for wire -> octet {
            let code = octet.int();
            confirm code == 9 || (code >= 32 && code != 127)
                else throw InvalidAuthenticationChallenge.because("invalid octet");
        }
        text = origin;
        bytes = wire;
        width = wire.size();
        challenge_limit = challenges;
        parameter_limit = parameters;
    }

    values() is @AuthenticationChallenge {
        let position = HttpMediaPosition(index: self.list(0), slots: 0);
        let result is HttpMediaItems<AuthenticationChallenge> = HttpMediaItems();
        loop {
            let at = position.index();
            last if at == width;
            confirm position.slots() < challenge_limit
                else throw InvalidAuthenticationChallenge.because("challenge limit");
            let scheme = self.token(at);
            let boundary = self.space(scheme.end());
            let after = self.list(boundary);
            let fields is HttpMediaItems<AuthenticationParameter> = HttpMediaItems();
            if after == width
                || (boundary < width
                && bytes[boundary].int() == 44
                && (boundary == scheme.end() || !self.assignment(after))) {
                    result = result.following(
                        AuthenticationChallenge(scheme: scheme.text(), parameters: [], token68: "")
                    );
                    position = position.separator(after);
                    next;
                }
            confirm after > scheme.end()
                else throw InvalidAuthenticationChallenge.because("scheme separator");
            if !self.assignment(after) {
                let token = self.token68(after);
                result = result.following(
                    AuthenticationChallenge(
                        scheme: scheme.text(),
                        parameters: [],
                        token68: token.text()
                    )
                );
                position = position.separator(self.separator(self.space(token.end())));
                next;
            }
            let cursor = HttpMediaPosition(index: after, slots: 0);
            loop {
                confirm cursor.slots() < parameter_limit
                    else throw InvalidAuthenticationChallenge.because("parameter limit");
                let name = self.token(cursor.index());
                let equals = self.space(name.end());
                confirm equals < width && bytes[equals].int() == 61
                    else throw InvalidAuthenticationChallenge.because("assignment required");
                let start = self.space(equals + 1);
                confirm start < width
                    else throw InvalidAuthenticationChallenge.because("value required");
                let quoted = bytes[start].int() == 34;
                let value = if quoted {
                    self.quoted(start);
                }
                else {
                    self.token(start);
                };
                let key = HttpAsciiLowercase(name.text()).string();
                for fields.values() -> field {
                    confirm field.name() != key
                        else throw InvalidAuthenticationChallenge.because("duplicate parameter");
                }
                fields = fields.following(
                    AuthenticationParameter(name: name.text(), value: value.text(), quoted: quoted)
                );
                let end = self.space(value.end());
                if end == width {
                    cursor = cursor.following(end);
                    last;
                }
                confirm bytes[end].int() == 44
                    else throw InvalidAuthenticationChallenge.because("parameter separator");
                let following = self.list(end);
                cursor = cursor.separator(following);
                last if following == width || !self.assignment(following);
            }
            result = result.following(
                AuthenticationChallenge(
                    scheme: scheme.text(),
                    parameters: fields.values(),
                    token68: ""
                )
            );
            position = position.separator(cursor.index());
        }
        result.values();
    }

    hidden space(start is int) is int {
        let position = HttpMediaPosition(index: start, slots: 0);
        loop {
            let at = position.index();
            if at == width {
                return at;
            }
            let code = bytes[at].int();
            if code != 32 && code != 9 {
                return at;
            }
            position = position.following(at + 1);
        }
    }

    hidden separator(start is int) is int {
        if start == width {
            return start;
        }
        confirm bytes[start].int() == 44
            else throw InvalidAuthenticationChallenge.because("challenge separator");
        self.list(start);
    }

    hidden list(start is int) is int {
        let position = HttpMediaPosition(index: self.space(start), slots: 0);
        loop {
            let at = position.index();
            last if at == width || bytes[at].int() != 44;
            confirm position.slots() < 64
                else throw InvalidAuthenticationChallenge.because("empty list member limit");
            position = position.separator(self.space(at + 1));
        }
        position.index();
    }

    hidden token(start is int) is HttpMediaScanned {
        let position = HttpMediaPosition(index: start, slots: 0);
        loop {
            let at = position.index();
            last if at == width || !HttpMediaOctet(bytes[at].int()).token();
            position = position.following(at + 1);
        }
        confirm position.index() > start
            else throw InvalidAuthenticationChallenge.because("token required");
        HttpMediaScanned(text: text.slice(start, position.index()), end: position.index());
    }

    hidden assignment(start is int) is bool {
        let name = self.token(start);
        let end = self.space(name.end());
        end < width
            && bytes[end].int() == 61
            && end + 1 < width
            && bytes[end + 1].int() != 61
            && bytes[end + 1].int() != 44;
    }

    hidden token68(start is int) is HttpMediaScanned {
        let position = HttpMediaPosition(index: start, slots: 0);
        loop {
            let at = position.index();
            last if at == width
                || bytes[at].int() == 32
                || bytes[at].int() == 9
                || bytes[at].int() == 44;
            let code = bytes[at].int();
            if code == 61 {
                confirm at > start
                    else throw InvalidAuthenticationChallenge.because("token68 required");
                position = position.separator(at + 1);
            }
            else {
                confirm position.slots() == 0
                    && ((code >= 65 && code <= 90)
                    || (code >= 97 && code <= 122)
                    || (code >= 48 && code <= 57)
                    || code == 45
                    || code == 46
                    || code == 95
                    || code == 126
                    || code == 43
                    || code == 47)
                    else throw InvalidAuthenticationChallenge.because("token68 syntax");
                position = position.following(at + 1);
            }
        }
        confirm position.index() > start
            else throw InvalidAuthenticationChallenge.because("token68 required");
        HttpMediaScanned(text: text.slice(start, position.index()), end: position.index());
    }

    hidden quoted(start is int) is HttpMediaScanned {
        let position = HttpMediaPosition(index: start + 1, slots: 0);
        let output = ByteBuffer();
        defer output.closing().close();
        let writer = output.writing();
        loop {
            let at = position.index();
            confirm at < width
                else throw InvalidAuthenticationChallenge.because("unfinished quote");
            let code = bytes[at].int();
            if code == 34 {
                return HttpMediaScanned(
                    text: Latin1Decoded(output.content().bytes()).string(),
                    end: at + 1
                );
            }
            if code == 92 {
                confirm at + 1 < width
                    else throw InvalidAuthenticationChallenge.because("unfinished escape");
                writer.write([bytes[at + 1]]);
                position = position.following(at + 2);
            }
            else {
                writer.write([bytes[at]]);
                position = position.following(at + 1);
            }
        }
    }
}

// Text that is not a challenge list; reason says why.
enum InvalidAuthenticationChallenge is Error = (because(reason is string));

test "Authentication fields separate challenge schemes from quoted commas" {
    let parsed = AuthenticationChallenges(
        "Basic realm=\"legacy\", Digest realm=\"a,b\",nonce=\"n\""
    ).values();
    test.ok(parsed.size() == 2 && parsed[1].parameter("realm") == "a,b");
}
