object XmlRpcFaultCapture does XmlRpcWriting {
    has code is Atomic<@int>;has message is Atomic<@string>;has seen is Event;
    XmlRpcFaultCapture(){let codes is @int=[];code=Atomic(codes);let messages is @string=[];message=Atomic(messages);seen=Event();}
    fault() is XmlRpcFault{confirm seen.ready() && code.value().size()==1 && message.value().size()==1 else throw InvalidXmlRpc("fault fields");XmlRpcFault(code.value()[0],message.value()[0]);}
    members(values is Sequencing<XmlRpcMember>) is void{confirm !seen.ready() && values.size()==2 else throw InvalidXmlRpc("fault structure");seen.set();for (0..2) -> index{let member=values.item(index);confirm member.name()=="faultCode" || member.name()=="faultString" else throw InvalidXmlRpc("unknown fault member");member.value().print(XmlRpcFaultScalar(member.name(),code,message));}}
    integer(value is int) is void{throw InvalidXmlRpc("fault must be a struct");}boolean(value is bool) is void{throw InvalidXmlRpc("fault must be a struct");}text(value is string) is void{throw InvalidXmlRpc("fault must be a struct");}floating(value is Decimal) is void{throw InvalidXmlRpc("fault must be a struct");}datetime(value is LocalDateTime) is void{throw InvalidXmlRpc("fault must be a struct");}binary(value is @byte) is void{throw InvalidXmlRpc("fault must be a struct");}elements(values is Sequencing<XmlRpcValue>) is void{throw InvalidXmlRpc("fault must be a struct");}nil_value() is void{throw InvalidXmlRpc("fault must be a struct");}
}
object XmlRpcFaultScalar does XmlRpcWriting {
    has name is string;has code is Atomic<@int>;has message is Atomic<@string>;XmlRpcFaultScalar(name is string,code is Atomic<@int>,message is Atomic<@string>){self.name=name;self.code=code;self.message=message;}
    integer(value is int) is void{confirm name=="faultCode" && code.value().size()==0 else throw InvalidXmlRpc("faultCode type/cardinality");XmlRpcInteger(value);code.replace([value]);}
    text(value is string) is void{confirm name=="faultString" && message.value().size()==0 else throw InvalidXmlRpc("faultString type/cardinality");message.replace([value]);}
    members(values is Sequencing<XmlRpcMember>) is void{throw InvalidXmlRpc("scalar fault member required");}boolean(value is bool) is void{throw InvalidXmlRpc("scalar fault member required");}floating(value is Decimal) is void{throw InvalidXmlRpc("scalar fault member required");}datetime(value is LocalDateTime) is void{throw InvalidXmlRpc("scalar fault member required");}binary(value is @byte) is void{throw InvalidXmlRpc("scalar fault member required");}elements(values is Sequencing<XmlRpcValue>) is void{throw InvalidXmlRpc("scalar fault member required");}nil_value() is void{throw InvalidXmlRpc("scalar fault member required");}
}
