object XmlRpcBudget{XmlRpcBudget(depth is int,values is int,text_bytes is BigInt,binary_bytes is BigInt){confirm depth>=0 && depth<=64 && values>=0 && values<=4096 else throw InvalidXmlRpc("structural budgets");for [text_bytes,binary_bytes] -> bytes{confirm bytes.sign()>=0 && bytes.order(BigInt("8388608"))!=Order.greater else throw InvalidXmlRpc("byte budget");}}}
object XmlRpcUsage {
    has limits is XmlRpcLimits;has values,text,binary is Atomic<int>;
    XmlRpcUsage(limits is XmlRpcLimits){self.limits=limits;values=Atomic(0);text=Atomic(0);binary=Atomic(0);}
    node(depth is int) is void{confirm depth<=limits.depth() else throw XmlRpcLimitExceeded("depth");confirm values.value()<limits.values() else throw XmlRpcLimitExceeded("values");values.replace(values.value()+1);}
