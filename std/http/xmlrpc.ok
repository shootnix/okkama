object XmlRpcParsedDouble{has value is Decimal;XmlRpcParsedDouble(origin is string){confirm origin!="" && origin.length()<=4096 else throw InvalidXmlRpc("double spelling budget");let text=if origin.slice(0,1)=="+"{origin.slice(1,origin.length());}else{origin;};let offset=if text!="" && text.slice(0,1)=="-"{1;}else{0;};let digits=text.slice(offset,text.length());let points=digits.split(".");confirm points.size()<=2 && digits!="" && digits!="." else throw InvalidXmlRpc("double spelling");let packed=points.join("");for (0..packed.length()) -> index{confirm "0123456789".split(packed.slice(index,index+1)).size()==2 else throw InvalidXmlRpc("double digits");}let normalized=if digits.slice(0,1)=="."{text.slice(0,offset)+"0"+digits;}else{text;};let complete=if normalized.slice(normalized.length()-1,normalized.length())=="."{normalized+"0";}else{normalized;};value=try{Decimal(complete);}catch e is Error{throw InvalidXmlRpc("double decimal");};XmlRpcDouble(self.value);}value() is Decimal{value;}}
