object XmlRpcMember{has name is string;has value is XmlRpcValue;XmlRpcMember(name is string,value is XmlRpcValue){self.name=name;self.value=value;}name() is string{name;}value() is XmlRpcValue{value;}}
object XmlRpcStruct does XmlRpcValue{
    has origin is @XmlRpcMember;
    XmlRpcStruct(values is Sequencing<XmlRpcMember>){
