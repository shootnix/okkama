object XmlRpcBoolean does XmlRpcValue{has origin is bool;XmlRpcBoolean(value is bool){origin=value;}value() is bool{origin;}kind() is XmlRpcKind{XmlRpcKind.boolean;}print(to is XmlRpcWriting) is void{to.boolean(origin);}}
object XmlRpcText does XmlRpcValue{has origin is string;XmlRpcText(value is string){origin=value;}value() is string{origin;}kind() is XmlRpcKind{XmlRpcKind.text;}print(to is XmlRpcWriting) is void{to.text(origin);}}
object XmlRpcFloat does XmlRpcValue{has origin is float;XmlRpcFloat(value is float){origin=value;}value() is float{origin;}kind() is XmlRpcKind{XmlRpcKind.floating;}print(to is XmlRpcWriting) is void{to.floating(Decimal(origin.string()));}}
