    XmlRpcLimits(depth is int,values is int,text_bytes is BigInt,binary_bytes is BigInt,nil_enabled is bool){XmlRpcBudget(depth,values,text_bytes,binary_bytes);self.depth=depth;self.values=values;self.text_bytes=ParsedInt(text_bytes.string()).value();self.binary_bytes=ParsedInt(binary_bytes.string()).value();self.nil_enabled=nil_enabled;}
    depth() is int{depth;}values() is int{values;}text_bytes() is BigInt{BigInt(text_bytes.string());}binary_bytes() is BigInt{BigInt(binary_bytes.string());}nil_enabled() is bool{nil_enabled;}
    wire_bytes() is int{let derived=text_bytes*6+((binary_bytes+2)/3).int()*4+values*128+1024;if derived<16777216{derived;}else{16777216;}}
