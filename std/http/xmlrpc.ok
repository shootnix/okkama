enum XmlRpcResultKind=(success,fault);
object InvalidXmlRpc does Error{has reason is string;InvalidXmlRpc(reason is string){self.reason=reason;}text() is string{"invalid XML-RPC: "+reason;}}
object XmlRpcLimitExceeded does Error{has kind is string;XmlRpcLimitExceeded(kind is string){self.kind=kind;}kind() is string{kind;}text() is string{"XML-RPC limit: "+kind;}}
object WrongXmlRpcResult does Error{WrongXmlRpcResult();text() is string{"wrong XML-RPC result projection";}}
object XmlRpcHttpFailed does Error{has code is int;XmlRpcHttpFailed(code is int){self.code=code;}status() is int{code;}text() is string{"XML-RPC HTTP status: "+code.string();}}
