role XmlRpcValue{kind() is XmlRpcKind;print(to is XmlRpcWriting) is void;}
role XmlRpcWriting{integer(value is int) is void;boolean(value is bool) is void;text(value is string) is void;floating(value is Decimal) is void;datetime(value is LocalDateTime) is void;binary(value is @byte) is void;elements(values is Sequencing<XmlRpcValue>) is void;members(values is Sequencing<XmlRpcMember>) is void;nil_value() is void;}
