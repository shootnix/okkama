object XmlRpcDateTime does XmlRpcValue{has origin is LocalDateTime;XmlRpcDateTime(value is LocalDateTime){confirm value.time().nanosecond()==0 else throw InvalidXmlRpc("whole local seconds required");origin=value;}value() is LocalDateTime{origin;}kind() is XmlRpcKind{XmlRpcKind.datetime;}print(to is XmlRpcWriting) is void{to.datetime(origin);}}
object XmlRpcBinary does XmlRpcValue{has origin is @byte;XmlRpcBinary(value is @byte){origin=value;}value() is @byte{origin;}kind() is XmlRpcKind{XmlRpcKind.binary;}print(to is XmlRpcWriting) is void{to.binary(origin);}}
object XmlRpcArray does XmlRpcValue{
    has origin is @XmlRpcValue;XmlRpcArray(values is Sequencing<XmlRpcValue>){let count=values.size();confirm count>=0 && count<=4096 else throw XmlRpcLimitExceeded("container_items");let copied is @XmlRpcValue=(0..count).map()->index{values.item(index);};origin=copied;}
    values() is Sequencing<XmlRpcValue>{origin;}kind() is XmlRpcKind{XmlRpcKind.array;}print(to is XmlRpcWriting) is void{to.elements(origin);}
