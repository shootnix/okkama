object XmlRpcNil does XmlRpcValue{XmlRpcNil();kind() is XmlRpcKind{XmlRpcKind.nil_value;}print(to is XmlRpcWriting) is void{to.nil_value();}}
object XmlRpcCall{has method is string;has parameters is @XmlRpcValue;XmlRpcCall(method is string,parameters is Sequencing<XmlRpcValue>){XmlRpcMethod(method);self.method=method;let count=parameters.size();confirm count>=0 && count<=4096 else throw XmlRpcLimitExceeded("parameters");let copied is @XmlRpcValue=(0..count).map()->index{parameters.item(index);};self.parameters=copied;}method() is string{method;}parameters() is Sequencing<XmlRpcValue>{parameters;}}
object XmlRpcMethod{XmlRpcMethod(origin is string){confirm origin!="" && origin.length()<=256 else throw InvalidXmlRpc("method name budget");for Utf8Encoded(origin).bytes() -> octet{let code=octet.int();confirm (code>=65 && code<=90) || (code>=97 && code<=122) || (code>=48 && code<=57) || code==95 || code==46 || code==58 || code==47 else throw InvalidXmlRpc("method name grammar");}}}
object XmlRpcFault{has code is int;has message is string;XmlRpcFault(code is int,message is string){XmlRpcInteger(code);self.code=code;self.message=message;}code() is int{code;}text() is string{message;}}
role XmlRpcResult{kind() is XmlRpcResultKind;value() is XmlRpcValue;fault() is XmlRpcFault;}
object XmlRpcSuccess does XmlRpcResult{has origin is XmlRpcValue;XmlRpcSuccess(origin is XmlRpcValue){self.origin=origin;}kind() is XmlRpcResultKind{XmlRpcResultKind.success;}value() is XmlRpcValue{origin;}fault() is XmlRpcFault{throw WrongXmlRpcResult();}}
object XmlRpcFailure does XmlRpcResult{has origin is XmlRpcFault;XmlRpcFailure(origin is XmlRpcFault){self.origin=origin;}kind() is XmlRpcResultKind{XmlRpcResultKind.fault;}value() is XmlRpcValue{throw WrongXmlRpcResult();}fault() is XmlRpcFault{origin;}}
object XmlRpcLimits {
    has depth,values,text_bytes,binary_bytes is int;has nil_enabled is bool;
