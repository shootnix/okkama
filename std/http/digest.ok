module http/digest v1.0.0;

// Digest authentication (RFC 7616) with SHA-256 and SHA-512-256, qop=auth.
//
//     let client = DigestExchanging(
//         origin: HttpClient(),
//         scope: ParsedUrl("https://example.com/private/").parts(),
//         credentials: DigestCredentials(username: "ann", password: secret),
//         random: SecureRandom(),
//     );
//     await client.response(Request(url: "https://example.com/private/report"));
//
// A 401 with a Digest challenge inside the scope is answered once, and a stale
// nonce once more. There is no MD5, no preemptive nonce cache and no body
// hashing. The server's Authentication-Info proof can be checked with
// DigestServerProof.

import "http/status" take StatusCode, Status;
import "http/method" take MethodName;
import "http/auth" take InvalidAuthentication, HttpAuthorizing, AuthenticationScope,
    AuthenticationConflict;
import "http/auth_challenge" take AuthenticationChallenge, AuthenticationChallenges,
    InvalidAuthenticationChallenge;
import "http/header" take Header, HeaderName, Headers, HttpAsciiLowercase;
import "http/message" take Request, Response;
import "http/client_request" take HttpDirectRequest;
import "crypto/secret" take SecretBytes, ExportedSecret;
import "encoding/single_byte" take AsciiEncoded, AsciiDecoded, Latin1Encoded, Latin1Decoded,
    UnrepresentableAsciiCharacter, UnrepresentableLatin1Character;
import "encoding/utf" take Utf8Encoded, Utf8Decoded, InvalidUtf8;
import "unicode/normalization" take Normalized, NormalizationForm;
import "url/percent" take PercentEncoded, UrlComponent;
import "encoding/hex" take HexEncoded, HexDecoded, InvalidHex;
import "runtime/crypto" as native_crypto;
import "io/buffer" take ByteBuffer;
import "async/atomic" take Atomic;
import "http/exchange" take ClientResponse, Exchanging;
import "random/source" take SecureRandom;
import "async/event" take Event;
import "url/value" take UrlParts;
import "http/version" take HttpVersion;
import "http/body" take BodyOpening, BodyReading;
import "numbers/bigint" take BigInt;

// A username and a password for Digest authentication.
object DigestCredentials {
    has username is string;
    has password is SecretBytes;

    // The credentials.
    DigestCredentials(username is string, password is SecretBytes) {
        confirm username.length() > 0 && username.length() <= 1024 && password.size() <= 4096
            else throw InvalidAuthentication.because("digest credential size");
        let name = DigestText(username).bytes();
        for name -> octet {
            confirm octet.int() != 58
                else throw InvalidAuthentication.because("digest username syntax");
        }
        self.username = username;
        self.password = password;
    }

    // The `response` value for challenge, uri and method with cnonce and count.
    response_digest(
        challenge is DigestChallenge,
        uri is string,
        method is string,
        cnonce is string,
        count is string
    ) is string {
        let identity = self.identity(challenge);
        let raw_password = ExportedSecret(password).bytes();
        let password = if challenge::Challenge::utf8 {
            let text = try {
                Utf8Decoded(raw_password).string();
            }
            catch e is InvalidUtf8 {
                throw InvalidAuthentication.because("digest password UTF-8");
            };
            DigestText(text).bytes();
        }
        else {
            for raw_password -> octet {
                confirm octet.int() >= 32 && octet.int() <= 126
                    else throw InvalidAuthentication.because("ASCII digest password required");
            }
            raw_password;
        };
        let a1 is @byte = (0..identity.size() + 1 + password.size()).map() -> index {
            if index < identity.size() {
                identity[index];
            }
            else {
                if index == identity.size() {
                    58.byte();
                }
                else {
                    password[index - identity.size() - 1];
                }
            }
        };
        let original = DigestHash(origin: a1, algorithm: challenge::Challenge::algorithm).string();
        let secret = if challenge.session() {
            DigestHash(
                origin: DigestAscii(original + ":" + challenge::Challenge::nonce + ":" + cnonce).bytes(),
                algorithm: challenge::Challenge::algorithm
            ).string();
        }
        else {
            original;
        };
        let a2 = DigestHash(
            origin: DigestAscii(method + ":" + uri).bytes(),
            algorithm: challenge::Challenge::algorithm
        ).string();
        DigestHash(
            origin: DigestAscii(
                secret + ":" + challenge::Challenge::nonce + ":" + count + ":" + cnonce + ":auth:" + a2
            ).bytes(),
            algorithm: challenge::Challenge::algorithm
        ).string();
    }

    // `username:realm` as bytes, the start of A1.
    identity(challenge is DigestChallenge) is @byte {
        let name = if challenge::Challenge::utf8 {
            DigestText(self::Credentials::username).bytes();
        }
        else {
            DigestAscii(self::Credentials::username).bytes();
        };
        let realm = challenge.realm_bytes();
        (0..name.size() + 1 + realm.size()).map() -> index {
            if index < name.size() {
                name[index];
            }
            else {
                if index == name.size() {
                    58.byte();
                }
                else {
                    realm[index - name.size() - 1];
                }
            }
        };
    }

    // The username.
    cap Credentials {
        username is string {
            username;
        }
    }
}

// Explicit SHA-256/SHA-512-256 profile and session variants, qop=auth.
// UTF-8 challenges normalize username/password to NFC. Without charset,
// credentials remain ASCII. No MD5 fallback or inferred body hashing.
object DigestChallenge {
    has realm, nonce, algorithm, opaque is string;
    has opaque_present, userhash, stale, utf8 is bool;

    // A Digest challenge; UnsupportedDigestChallenge without an algorithm of
    // SHA-256 or SHA-512-256, without qop=auth, or of another scheme.
    DigestChallenge(origin is AuthenticationChallenge) {
        confirm origin::Challenge::scheme == "digest" && origin::Challenge::token68 == ""
            else throw UnsupportedDigestChallenge.unsupported;
        confirm origin.present("algorithm") else throw UnsupportedDigestChallenge.unsupported;
        let offered = origin.parameter("algorithm");
        let kind = HttpAsciiLowercase(offered).string();
        confirm (kind == "sha-256"
            || kind == "sha-256-sess"
            || kind == "sha-512-256"
            || kind == "sha-512-256-sess")
            else throw UnsupportedDigestChallenge.unsupported;
        confirm origin.present("qop") else throw UnsupportedDigestChallenge.unsupported;
        let options = origin.parameter("qop").split(",");
        let supported = options.reduce(false) -> found, option {
            found || Header(name: HeaderName("Qop"), value: option).value() == "auth";
        };
        confirm supported else throw UnsupportedDigestChallenge.unsupported;
        confirm origin.present("realm") && origin.present("nonce")
            else throw InvalidAuthentication.because("digest required parameters");
        let realm = origin.parameter("realm");
        let nonce = origin.parameter("nonce");
        confirm nonce.length() > 0 && nonce.length() <= 1024 && realm.length() <= 1024
            else throw InvalidAuthentication.because("digest challenge size");
        let utf8 = origin.present("charset");
        if utf8 {
            try {
                Utf8Decoded(Latin1Encoded(realm).bytes()).string();
            }
            catch e is InvalidUtf8 {
                throw InvalidAuthentication.because("digest realm UTF-8");
            }
        }
        else {
            DigestAscii(realm).bytes();
        }
        DigestAscii(nonce).bytes();
        if origin.present("charset") {
            confirm HttpAsciiLowercase(origin.parameter("charset")).string() == "utf-8"
                else throw UnsupportedDigestChallenge.unsupported;
        }
        let opaque_present = origin.present("opaque");
        let opaque = if opaque_present {
            origin.parameter("opaque");
        }
        else {
            "";
        };
        confirm opaque.length() <= 1024
            else throw InvalidAuthentication.because("digest opaque size");
        DigestAscii(opaque).bytes();
        self.realm = realm;
        self.nonce = nonce;
        self.algorithm = offered;
        self.opaque = opaque;
        self.opaque_present = opaque_present;
        self.utf8 = utf8;
        userhash = DigestFlag(origin: origin, name: "userhash").bool();
        stale = DigestFlag(origin: origin, name: "stale").bool();
    }

    // Whether it is a `-sess` algorithm.
    session() is bool {
        let kind = HttpAsciiLowercase(algorithm).string();
        kind == "sha-256-sess" || kind == "sha-512-256-sess";
    }

    // The realm as bytes.
    realm_bytes() is @byte {
        if utf8 {
            Latin1Encoded(realm).bytes();
        }
        else {
            DigestAscii(realm).bytes();
        }
    }

    // The realm, nonce, algorithm and opaque, and its opaque, userhash, stale
    // and charset=UTF-8 flags.
    cap Challenge {
        realm is string {
            realm;
        }

        nonce is string {
            nonce;
        }

        algorithm is string {
            algorithm;
        }

        opaque is string {
            opaque;
        }

        opaque_present is bool {
            opaque_present;
        }

        userhash is bool {
            userhash;
        }

        stale is bool {
            stale;
        }

        utf8 is bool {
            utf8;
        }
    }
}

hidden object DigestFlag {
    has origin is AuthenticationChallenge;
    has name is string;

    DigestFlag(origin is AuthenticationChallenge, name is string) {
        self.origin = origin;
        self.name = name;
    }

    bool() is bool {
        if !origin.present(name) {
            return false;
        }
        let value = HttpAsciiLowercase(origin.parameter(name)).string();
        confirm value == "true" || value == "false"
            else throw InvalidAuthentication.because("digest flag syntax");
        value == "true";
    }
}

// The Authorization field answering a Digest challenge.
object DigestAuthorization does HttpAuthorizing {
    has credentials is DigestCredentials;
    has challenge is DigestChallenge;
    has uri, method, cnonce, count is string;

    // The answer to challenge for request, with cnonce and nonce count.
    DigestAuthorization(
        credentials is DigestCredentials,
        challenge is DigestChallenge,
        request is Request,
        cnonce is string,
        count is int
    ) {
        confirm count >= 1 && count <= 4294967295 && cnonce.length() > 0 && cnonce.length() <= 256
            else throw InvalidAuthentication.because("digest nonce count or cnonce");
        DigestAscii(cnonce).bytes();
        self.credentials = credentials;
        self.challenge = challenge;
        uri = HttpDirectRequest(
            Request(
                method: request::Head::method,
                target: request::Head::target,
                headers: request::Head::headers,
                body: request.body()
            )
        ).request()::Head::target.string();
        method = MethodName(request::Head::method).string();
        self.cnonce = cnonce;
        self.count = HexEncoded(
            [
                ((count >> 24) & 255).byte(),
                ((count >> 16) & 255).byte(),
                ((count >> 8) & 255).byte(),
                (count & 255).byte()
            ]
        ).string();
    }

    // The Authorization field.
    header() is Header {
        let response = self.response_digest(method);
        let name = if challenge::Challenge::utf8 {
            DigestText(credentials::Credentials::username).string();
        }
        else {
            DigestAscii(credentials::Credentials::username).bytes();
            credentials::Credentials::username;
        };
        let user = if challenge::Challenge::userhash {
            "username=" + DigestQuoted(
                DigestHash(origin: self.identity(), algorithm: challenge::Challenge::algorithm).string()
            ).string();
        }
        else {
            let ascii = try {
                AsciiEncoded(name).bytes();
                true;
            }
            catch e is UnrepresentableAsciiCharacter {
                false;
            };
            if ascii {
                "username=" + DigestQuoted(name).string();
            }
            else {
                "username*=UTF-8''" + PercentEncoded(origin: name, component: UrlComponent.data).string();
            }
        };
        let value = "Digest " + user + ", realm=" + DigestQuoted(challenge::Challenge::realm).string() + ", nonce=" + DigestQuoted(
            challenge::Challenge::nonce
        ).string() +
            ", uri=" + DigestQuoted(uri).string() + ", algorithm=" + challenge::Challenge::algorithm + ", response=" + DigestQuoted(
                response
            ).string() + ", qop=auth, nc=" + count + ", cnonce=" + DigestQuoted(cnonce).string() +
            if challenge::Challenge::opaque_present {
                ", opaque=" + DigestQuoted(challenge::Challenge::opaque).string();
            }
            else {
                "";
            } + if challenge::Challenge::userhash {
                ", userhash=true";
            }
            else {
                "";
            };
        Header(name: HeaderName("Authorization"), value: value);
    }

    // What the server's Authentication-Info must say.
    proof() is DigestServerProof {
        DigestServerProof(expected: self.response_digest(""), cnonce: cnonce, count: count);
    }

    hidden response_digest(method is string) is string {
        credentials.response_digest(challenge, uri, method, cnonce, count);
    }

    hidden identity() is @byte {
        credentials.identity(challenge);
    }
}

hidden object DigestAscii {
    has origin is string;

    DigestAscii(origin is string) {
        self.origin = origin;
    }

    bytes() is @byte {
        let bytes = try {
            AsciiEncoded(origin).bytes();
        }
        catch e is UnrepresentableAsciiCharacter {
            throw InvalidAuthentication.because("ASCII digest profile required");
        };
        for bytes -> octet {
            confirm octet.int() >= 32 && octet.int() <= 126
                else throw InvalidAuthentication.because("digest control character");
        }
        bytes;
    }
}

hidden object DigestHash {
    has origin is @byte;
    has algorithm is string;

    DigestHash(origin is @byte) {
        self.origin = origin;
        algorithm = "sha256";
    }

    DigestHash(origin is @byte, algorithm is string) {
        self.origin = origin;
        let kind = HttpAsciiLowercase(algorithm).string();
        confirm kind == "sha-256"
            || kind == "sha-256-sess"
            || kind == "sha-512-256"
            || kind == "sha-512-256-sess"
            else throw UnsupportedDigestChallenge.unsupported;
        self.algorithm = if kind == "sha-256" || kind == "sha-256-sess" {
            "sha256";
        }
        else {
            "sha512256";
        };
    }

    string() is string {
        let bytes = try {
            native_crypto.digest(algorithm, origin);
        }
        catch e is NativeFailure {
            throw InvalidAuthentication.because("digest provider unavailable");
        };
        confirm bytes.size() == 32
            else throw InvalidAuthentication.because("digest provider result");
        HexEncoded(bytes).string();
    }
}

hidden object DigestQuoted {
    has origin is string;

    DigestQuoted(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let bytes = try {
            Latin1Encoded(origin).bytes();
        }
        catch e is UnrepresentableLatin1Character {
            throw InvalidAuthentication.because("digest wire octet");
        };
        for bytes -> octet {
            confirm octet.int() >= 32 && octet.int() != 127
                else throw InvalidAuthentication.because("digest wire control");
        }
        let output = ByteBuffer();
        defer output.closing().close();
        let writer = output.writing();
        writer.write([34.byte()]);
        for bytes -> octet {
            if octet.int() == 34 || octet.int() == 92 {
                writer.write([92.byte()]);
            }
            writer.write([octet]);
        }
        writer.write([34.byte()]);
        Latin1Decoded(output.content().bytes()).string();
    }
}

hidden object DigestNonce {
    has nonce is string;
    has count is int;

    DigestNonce(nonce is string, count is int) {
        self.nonce = nonce;
        self.count = count;
    }

    nonce() is string {
        nonce;
    }

    count() is int {
        count;
    }
}

hidden object DigestNonces {
    has entries is Atomic<@DigestNonce>;
    has maximum is int;

    DigestNonces(maximum is int) {
        confirm maximum > 0 && maximum <= 1024
            else throw InvalidAuthentication.because("digest nonce ledger limit");
        self.maximum = maximum;
        let empty is @DigestNonce = [];
        entries = Atomic(empty);
    }

    ticket(nonce is string) is int {
        confirm nonce.length() > 0 && nonce.length() <= 1024
            else throw InvalidAuthentication.because("digest nonce size");
        loop {
            let previous = entries.value();
            let found = previous.reduce(false) -> found, entry {
                found || entry.nonce() == nonce;
            };
            confirm found || previous.size() < maximum
                else throw InvalidAuthentication.because("digest nonce history limit");
            let count = previous.reduce(1) -> count, entry {
                if entry.nonce() == nonce {
                    entry.count() + 1;
                }
                else {
                    count;
                }
            };
            confirm count <= 4294967295
                else throw InvalidAuthentication.because("digest nonce count exhausted");
            let following is @DigestNonce = (0..previous.size() + if found {
                0;
            }
            else {
                1;
            }).map() -> index {
                if index == previous.size() || previous[index].nonce() == nonce {
                    DigestNonce(nonce: nonce, count: count);
                }
                else {
                    previous[index];
                }
            };
            if entries.compare_and_replace(previous, following) {
                return count;
            }
        }
    }
}

// A challenge this client does not answer.
enum UnsupportedDigestChallenge is Error = (unsupported);

// No preemptive nonce cache or domain expansion. A direct scoped 401 can
// authorize one replay; one further stale=true/new-nonce refresh is bounded.
object DigestExchanging does Exchanging {
    has origin is Exchanging;
    has scope is AuthenticationScope;
    has credentials is DigestCredentials;
    has random is SecureRandom;
    has counts is DigestNonces;

    // Sends through origin; answers challenges inside scope with credentials
    // and random cnonces.
    DigestExchanging(
        origin is Exchanging,
        scope is UrlParts,
        credentials is DigestCredentials,
        random is SecureRandom
    ) {
        self.origin = origin;
        self.scope = AuthenticationScope(scope);
        self.credentials = credentials;
        self.random = random;
        counts = DigestNonces(128);
    }

    // Sends request; a 401 Digest challenge inside the scope is answered once
    // more.
    async response(request is Request) is ClientResponse {
        if !scope.matches(request) {
            return await self.once(request);
        }
        confirm !request::Head::headers.membership(HeaderName("Authorization"))
            else throw AuthenticationConflict.conflict;
        let first = await self.once(request);
        let retained = Event();
        let cleanup = DigestResponseCleanup(origin: first::Exchange::response, retained: retained);
        defer cleanup.close();
        if !self.eligible(first, request) || !request.body().replayable() {
            retained.set();
            return first;
        }
        let challenges = DigestSelection(first::Head::headers).values();
        if challenges.size() == 0 {
            retained.set();
            return first;
        }
        let selected = challenges[0];
        cleanup.close();
        let result = await self.authorized(request, selected);
        let final = Event();
        let final_cleanup = DigestResponseCleanup(
            origin: result::Exchange::response,
            retained: final
        );
        defer final_cleanup.close();
        if self.eligible(result, request) {
            let refreshing = DigestSelection(result::Head::headers).values();
            if refreshing.size() == 1
                && refreshing[0]::Challenge::stale
                && refreshing[0]::Challenge::nonce != selected::Challenge::nonce {
                    final_cleanup.close();
                    let refreshed = await self.authorized(request, refreshing[0]);
                    return self.result(request, refreshed);
                }
        }
        final.set();
        self.result(request, result);
    }

    hidden eligible(result is ClientResponse, request is Request) is bool {
        result::Head::status == Status.unauthorized
            && result::Exchange::history.size() == 0
            && result::Exchange::request::Head::target.url().string() == request::Head::target.url().string()
            && scope.matches(result::Exchange::request);
    }

    hidden async authorized(request is Request, challenge is DigestChallenge) is ClientResponse {
        let count = counts.ticket(challenge::Challenge::nonce);
        let nonce = HexEncoded(random.bytes(16)).string();
        let authorization = DigestAuthorization(
            credentials: credentials,
            challenge: challenge,
            request: request,
            cnonce: nonce,
            count: count
        );
        let header = authorization.header();
        let proof = authorization.proof();
        let outgoing = Request(
            method: request::Head::method,
            target: request::Head::target,
            headers: request::Head::headers.addition(header),
            body: request.body(),
            version: request::Head::version
        );
        let result = await self.once(outgoing);
        let retained = Event();
        let cleanup = DigestResponseCleanup(origin: result::Exchange::response, retained: retained);
        defer cleanup.close();
        confirm result::Exchange::history.size() == 0
            && result::Exchange::request::Head::target.url().string() == request::Head::target.url().string()
            else throw InvalidAuthentication.because("Digest requires a direct exchange");
        proof.verify(result::Head::headers);
        let source = result::Exchange::response;
        let response = Response(
            status: source::Head::status,
            headers: source::Head::headers,
            body: DigestBody(origin: source.body(), proof: proof),
            version: source::Head::version
        );
        let verified = ClientResponse(
            request: result::Exchange::request,
            response: response,
            details: result::Exchange::details
        );
        retained.set();
        verified;
    }

    hidden async once(request is Request) is ClientResponse {
        let pending = origin.response(request);
        await pending;
    }

    hidden result(request is Request, result is ClientResponse) is ClientResponse {
        if result::Exchange::history.size() == 0
            && result::Exchange::request::Head::target.url().string() == request::Head::target.url().string() {
                return ClientResponse(
                    request: request,
                    response: result::Exchange::response,
                    details: result::Exchange::details
                );
            }
        result;
    }
}

hidden object DigestSelection {
    has headers is Headers;

    DigestSelection(headers is Headers) {
        self.headers = headers;
    }

    values() is @DigestChallenge {
        let fields = headers.values(HeaderName("WWW-Authenticate"));
        confirm fields.size() <= 32
            else throw InvalidAuthentication.because("digest challenge field limit");
        let size = fields.reduce(0) -> size, field {
            size + field.length();
        };
        confirm size <= 8192
            else throw InvalidAuthentication.because("digest challenge byte limit");
        let selected is @DigestChallenge = [];
        for (0..fields.size()) -> index {
            for AuthenticationChallenges(fields.item(index)).values() -> challenge {
                if challenge::Challenge::scheme == "digest" {
                    let supported is @DigestChallenge = try {
                        [DigestChallenge(challenge)];
                    }
                    catch e is UnsupportedDigestChallenge {
                        let empty is @DigestChallenge = [];
                        empty;
                    };
                    if supported.size() == 1 {
                        return supported;
                    }
                }
            }
        }
        selected;
    }
}

hidden object DigestResponseCleanup {
    has origin is Response;
    has retained, closed is Event;

    DigestResponseCleanup(origin is Response, retained is Event) {
        self.origin = origin;
        self.retained = retained;
        closed = Event();
    }

    close() is void {
        if !retained.ready() && !closed.ready() {
            closed.set();
            origin.body().reading().close();
        }
    }
}

// The rspauth a server must send back.
object DigestServerProof {
    has expected, cnonce, count is string;

    // The expected rspauth, cnonce and nonce count.
    DigestServerProof(expected is string, cnonce is string, count is string) {
        self.expected = expected;
        self.cnonce = cnonce;
        self.count = count;
    }

    // Checks the Authentication-Info of headers; InvalidAuthentication when it
    // does not prove the server.
    verify(headers is Headers) is void {
        let fields = headers.values(HeaderName("Authentication-Info"));
        if fields.size() == 0 {
            return;
        }
        confirm fields.size() <= 32
            else throw InvalidAuthentication.because("digest server proof limit");
        let width = fields.reduce(0) -> width, field {
            width + field.length();
        };
        confirm width <= 8192 else throw InvalidAuthentication.because("digest server proof limit");
        let wire = (0..fields.size()).reduce("") -> text, index {
            text + if index == 0 {
                "";
            }
            else {
                ", ";
            } + fields.item(index);
        };
        let parsed = try {
            AuthenticationChallenges("Digest " + wire).values();
        }
        catch e is InvalidAuthenticationChallenge {
            throw InvalidAuthentication.because("digest server proof syntax");
        };
        confirm parsed.size() == 1 && parsed[0]::Challenge::token68 == ""
            else throw InvalidAuthentication.because("digest server proof syntax");
        let info = parsed[0];
        confirm info.present("qop")
            && info.present("cnonce")
            && info.present("nc")
            && info.present("rspauth")
            else throw InvalidAuthentication.because("digest server proof components");
        confirm HttpAsciiLowercase(info.parameter("qop")).string() == "auth"
            && info.parameter("cnonce") == cnonce
            && HttpAsciiLowercase(info.parameter("nc")).string() == count
            else throw InvalidAuthentication.because("digest server proof coordinates");
        let value = info.parameter("rspauth");
        confirm value.length() == 64
            else throw InvalidAuthentication.because("digest server proof size");
        let actual = try {
            HexDecoded(value).bytes();
        }
        catch e is InvalidHex {
            throw InvalidAuthentication.because("digest server proof syntax");
        };
        let correct = try {
            native_crypto.secure_equal(HexDecoded(expected).bytes(), actual);
        }
        catch e is NativeFailure {
            throw InvalidAuthentication.because("digest server proof provider");
        };
        confirm correct else throw InvalidAuthentication.because("digest server proof mismatch");
    }
}

hidden object DigestBody does BodyOpening {
    has origin is BodyOpening;
    has proof is DigestServerProof;

    DigestBody(origin is BodyOpening, proof is DigestServerProof) {
        self.origin = origin;
        self.proof = proof;
    }

    length() is BigInt {
        origin.length();
    }

    replayable() is bool {
        origin.replayable();
    }

    // The whole body when it is already in memory (#115).
    contained() is Maybe<@byte> {
        Maybe<@byte>.none;
    }

    reading() is BodyReading {
        DigestReading(origin: origin.reading(), proof: proof);
    }
}

hidden object DigestReading does BodyReading {
    has origin is BodyReading;
    has proof is DigestServerProof;

    DigestReading(origin is BodyReading, proof is DigestServerProof) {
        self.origin = origin;
        self.proof = proof;
    }

    closed() is bool {
        origin.closed();
    }

    close() is void {
        origin.close();
    }

    trailers() is Headers {
        origin.trailers();
    }

    async bytes(limit is int) is @byte {
        try {
            let pending = origin.bytes(limit);
            let bytes = await pending;
            if bytes.size() == 0 {
                proof.verify(origin.trailers());
            }
            bytes;
        }
        catch e is Error {
            origin.close();
            throw;
        }
        catch e is NativeFailure {
            origin.close();
            throw;
        }
    }
}

test "Digest nonce counts remain independent and monotone" {
    let counts = DigestNonces(2);
    test.ok(counts.ticket("n") == 1 && counts.ticket("n") == 2 && counts.ticket("other") == 1);
}

hidden object DigestText {
    has origin is string;

    DigestText(origin is string) {
        self.origin = origin;
    }

    string() is string {
        let normalized = Normalized(origin: origin, form: NormalizationForm.nfc).string();
        for Utf8Encoded(normalized).bytes() -> octet {
            confirm octet.int() >= 32 && octet.int() != 127
                else throw InvalidAuthentication.because("digest control character");
        }
        normalized;
    }

    bytes() is @byte {
        Utf8Encoded(self.string()).bytes();
    }
}
