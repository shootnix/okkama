module http/websocket_handshake v1.0.0;

import "http/method" take Method;
import "http/websocket" take WebSocketFailure;
import "http/message" take Request, Response;
import "http/header" take Header, HeaderName, Headers, HttpAsciiLowercase;
import "http/token" take HttpToken, InvalidToken;
import "http/status" take Status, StatusCode;
import "http/target" take OriginTarget, RequestTargetKind;
import "http/version" take HttpVersion;
import "http/http1_head" take Http1RequestHead;
import "url/value" take UrlParts, UrlHostKind;
import "encoding/base64" take Base64Encoded, Base64Decoded, InvalidBase64;
import "encoding/single_byte" take AsciiEncoded;
import "digest/legacy" take Sha1;

// The nonce is checked canonical standard Base64, exactly sixteen bytes.
// SHA-1 is mandated solely for protocol interoperability, not authentication.
hidden object WebSocketAccept {
    has key is string;

    WebSocketAccept(key is string) {
        confirm key.length() == 24 else throw WebSocketFailure.because("nonce width");
        let bytes = try {
            Base64Decoded(key).bytes();
        }
        catch e is InvalidBase64 {
            throw WebSocketFailure.because("nonce encoding");
        };
        confirm bytes.size() == 16 else throw WebSocketFailure.because("nonce width");
        self.key = key;
    }

    string() is string {
        Base64Encoded(
            Sha1(AsciiEncoded(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").bytes()).bytes()
        ).string();
    }
}

object WebSocketProtocols {
    has origin is @string;

    WebSocketProtocols(origin is @string) {
        confirm origin.size() <= 32 else throw WebSocketFailure.because("subprotocol count");
        for (0..origin.size()) -> index {
            let value = origin[index];
            confirm value.length() > 0 && value.length() <= 256
                else throw WebSocketFailure.because("subprotocol width");
            try {
                HttpToken(value);
            }
            catch e is InvalidToken {
                throw WebSocketFailure.because("subprotocol token");
            }
            for (0..index) -> prior {
                confirm origin[prior] != value
                    else throw WebSocketFailure.because("duplicate subprotocol");
            }
        }
        self.origin = origin;
    }

    values() is @string {
        origin;
    }

    string() is string {
        (0..origin.size()).reduce("") -> joined, index {
            joined + if index == 0 {
                "";
            }
            else {
                ", ";
            } + origin[index];
        };
    }

    contains(value is string) is bool {
        origin.reduce(false) -> found, item {
            found || item == value;
        };
    }
}

// Bounded field/token parsing without silently joining singleton fields.
hidden object WebSocketHandshakeFields {
    has origin is Headers;

    WebSocketHandshakeFields(origin is Headers) {
        confirm origin.entries().size() <= 128
            else throw WebSocketFailure.because("handshake field count");
        let size = (0..origin.entries().size()).reduce(0) -> used, index {
            let field = origin.entries().item(index);
            let width = field.name().string().length() + field.value().length() + 4;
            confirm width <= 65536 - used
                else throw WebSocketFailure.because("handshake field budget");
            used + width;
        };
        self.origin = origin;
    }

    single(name is string) is string {
        let values = origin.values(HeaderName(name));
        confirm values.size() == 1 else throw WebSocketFailure.because("handshake singleton field");
        values.item(0);
    }

    tokens(name is string) is @string {
        let values = origin.values(HeaderName(name));
        let joined = (0..values.size()).reduce("") -> all, index {
            all + if index == 0 {
                "";
            }
            else {
                ",";
            } + values.item(index);
        };
        if values.size() == 0 {
            let empty is @string = [];
            return empty;
        }
        let parts = joined.split(",");
        confirm parts.size() <= 32 else throw WebSocketFailure.because("handshake token count");
        let tokens is @string = parts.map() -> part {
            let value = Header(HeaderName(name), part).value();
            confirm value != "" else throw WebSocketFailure.because("empty handshake token");
            try {
                HttpToken(value);
            }
            catch e is InvalidToken {
                throw WebSocketFailure.because("handshake token");
            }
            value;
        };
        tokens;
    }

    upgrade() is void {
        confirm HttpAsciiLowercase(self.single("Upgrade")).string() == "websocket"
            else throw WebSocketFailure.because("WebSocket Upgrade required");
        let tokens = self.tokens("Connection");
        confirm (tokens.reduce(false) -> found, token {
            found || HttpAsciiLowercase(token).string() == "upgrade";
        })
            else throw WebSocketFailure.because("Connection Upgrade required");
        confirm !(tokens.reduce(false) -> found, token {
            found || HttpAsciiLowercase(token).string() == "close";
        })
            else throw WebSocketFailure.because("conflicting Connection close");
    }
}

object WebSocketClientHandshake {
    has request is Request;
    has accept is WebSocketAccept;
    has offered is WebSocketProtocols;

    WebSocketClientHandshake(url is UrlParts, protocols is @string, headers is Headers, nonce is @byte) {
        let parts = url;
        confirm parts::Parts::scheme == "ws" || parts::Parts::scheme == "wss"
            else throw WebSocketFailure.because("WebSocket URL required");
        confirm parts::Parts::host != Maybe<string>.none
            && parts.host_kind() != UrlHostKind.empty
            && parts.host_kind() != UrlHostKind.future
            else throw WebSocketFailure.because("WebSocket authority required");
        confirm parts::Parts::userinfo == Maybe<string>.none && parts::Parts::fragment == Maybe<string>.none
            else throw WebSocketFailure.because("WebSocket URL userinfo or fragment");
        confirm (parts::Parts::port else 1) > 0 else throw WebSocketFailure.because("WebSocket port");
        confirm url.string().length() <= 8192
            else throw WebSocketFailure.because("WebSocket URL budget");
        WebSocketHandshakeFields(headers);
        let reserved = [
            "host",
            "upgrade",
            "connection",
            "sec-websocket-key",
            "sec-websocket-version",
            "sec-websocket-protocol",
            "sec-websocket-extensions",
            "sec-websocket-accept",
            "content-length",
            "transfer-encoding",
            "expect",
            "trailer",
            "proxy-authorization"
        ];
        for (0..headers.entries().size()) -> index {
            let name = headers.entries().item(index).name().lowercase();
            confirm !(reserved.reduce(false) -> found, value {
                found || name == value;
            })
                else throw WebSocketFailure.because("reserved handshake caller field");
        }
        confirm nonce.size() == 16 else throw WebSocketFailure.because("nonce width");
        let key = Base64Encoded(nonce).string();
        let checked = WebSocketProtocols(protocols);
        let fields = headers.addition(Header(HeaderName("Host"), parts.authority())).addition(
            Header(HeaderName("Upgrade"), "websocket")
        ).addition(Header(HeaderName("Connection"), "Upgrade")).addition(
            Header(HeaderName("Sec-WebSocket-Key"), key)
        ).addition(Header(HeaderName("Sec-WebSocket-Version"), "13"));
        let complete = if protocols.size() == 0 {
            fields;
        }
        else {
            fields.addition(Header(HeaderName("Sec-WebSocket-Protocol"), checked.string()));
        };
        WebSocketHandshakeFields(complete);
        request = Request(
            method: Method.get,
            target: OriginTarget(
                if parts::Parts::path == "" {
                    "/";
                }
                else {
                    parts::Parts::path;
                },
                parts::Parts::query
            ),
            headers: complete
        );
        accept = WebSocketAccept(key);
        offered = checked;
    }

    request() is Request {
        request;
    }

    selected(response is Response) is string {
        confirm response::Head::status == Status.switching_protocols
            && response::Head::version == HttpVersion.http_1_1
            else throw WebSocketFailure.because("HTTP1.1 switching response required");
        let fields = WebSocketHandshakeFields(response::Head::headers);
        fields.upgrade();
        confirm fields.single("Sec-WebSocket-Accept") == accept.string()
            else throw WebSocketFailure.because("WebSocket accept mismatch");
        confirm !response::Head::headers.membership(HeaderName("Sec-WebSocket-Extensions"))
            else throw WebSocketFailure.because("unnegotiated extensions");
        confirm !response::Head::headers.membership(HeaderName("Content-Length"))
            && !response::Head::headers.membership(HeaderName("Transfer-Encoding"))
            else throw WebSocketFailure.because("switching response framing");
        let values = response::Head::headers.values(HeaderName("Sec-WebSocket-Protocol"));
        confirm values.size() <= 1
            else throw WebSocketFailure.because("multiple selected subprotocols");
        if values.size() == 0 {
            return "";
        }
        let selected = WebSocketProtocols([values.item(0)]).values()[0];
        confirm offered.contains(selected)
            else throw WebSocketFailure.because("unoffered subprotocol");
        selected;
    }
}

// Protocol validation only. Caller must authorize Origin before writing response.
object WebSocketServerHandshake {
    has accept is WebSocketAccept;
    has offered is WebSocketProtocols;

    WebSocketServerHandshake(request is Http1RequestHead) {
        confirm request::Head::method == Method.get
            && request::Head::version == HttpVersion.http_1_1
            && request.target().kind() == RequestTargetKind.origin
            else throw WebSocketFailure.because("HTTP1.1 origin GET required");
        let fields = WebSocketHandshakeFields(request.headers());
        fields.upgrade();
        confirm fields.single("Sec-WebSocket-Version") == "13"
            else throw WebSocketFailure.because("WebSocket version 13 required");
        confirm !request.headers().membership(HeaderName("Transfer-Encoding"))
            else throw WebSocketFailure.because("upgrade request transfer coding");
        let lengths = request.headers().values(HeaderName("Content-Length"));
        confirm lengths.size() == 0 || (lengths.size() == 1 && lengths.item(0) == "0")
            else throw WebSocketFailure.because("upgrade request body");
        accept = WebSocketAccept(fields.single("Sec-WebSocket-Key"));
        offered = WebSocketProtocols(fields.tokens("Sec-WebSocket-Protocol"));
    }

    protocols() is @string {
        offered.values();
    }

    response(protocol is string) is Response {
        confirm protocol == "" || offered.contains(protocol)
            else throw WebSocketFailure.because("unoffered subprotocol");
        let fields = Headers(
            [
                Header(HeaderName("Upgrade"), "websocket"),
                Header(HeaderName("Connection"), "Upgrade"),
                Header(HeaderName("Sec-WebSocket-Accept"), accept.string())
            ]
        );
        Response(
            status: Status.switching_protocols,
            headers: if protocol == "" {
                fields;
            }
            else {
                fields.addition(Header(HeaderName("Sec-WebSocket-Protocol"), protocol));
            }
        );
    }
}

test "WebSocket accept uses RFC6455 nonce" {
    test.is(WebSocketAccept("dGhlIHNhbXBsZSBub25jZQ==").string(), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=");
}
