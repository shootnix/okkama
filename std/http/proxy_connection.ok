module http/proxy_connection v1.0.0;

// Connections through a proxy for one client pool. Proxied uses it.

import "http/proxy_policy" take ProxyPolicy;
import "http/proxy_tunnel" take HttpProxyTunnel;
import "http/auth" take BasicAuthorization;
import "http/header" take Header, HeaderName;
import "http/conversation" take HttpConversationRouting, HttpConversationConnecting,
    HttpConversationAcquisition, Http1Conversation, HttpConversationAcquisitionDisposal;
import "http/selected_connection" take HttpConversationAdopting;
import "http/endpoint" take HttpEndpointSelection, EndpointAllowing;
import "http/client_policy" take ClientPolicy;
import "http/client_protocols" take HttpClientProtocols;
import "http/version" take HttpVersion, UnsupportedHttpVersion;
import "http/exchange" take ExchangeDetails;
import "http/connection" take HttpAcquisitionCleanup, HttpTcpDisposal, HttpUnpublishedTcp;
import "http/http1_session" take Http1Session;
import "http/transport_observation" take HttpResponseObservation;
import "net/tcp" take TcpConnection, TcpOptions;
import "net/tcp_racing" take TcpRacing;
import "net/dns" take Resolving;
import "net/tls" take TlsClientPolicy;
import "time/clock" take Timing;
import "time/duration" take Duration, DurationUnit;
import "url/value" take UrlParts;
import "async/scope" take FutureGroup;
import "async/atomic" take Atomic;
import "async/event" take Event;

// A routing capability is fixed for one client pool. Only the actual proxy
// socket is locally resolved/filtered; remote origin routing belongs to proxy.
object HttpProxyRouting does HttpConversationRouting {
    has proxy is ProxyPolicy;
    has resolver is Resolving;
    has tls is TlsClientPolicy;
    has client is ClientPolicy;
    has clock is Timing;

    // Routes through proxy; only the proxy's address is resolved and checked.
    HttpProxyRouting(
        proxy is ProxyPolicy,
        resolver is Resolving,
        tls is TlsClientPolicy,
        client is ClientPolicy,
        clock is Timing
    ) {
        self.proxy = proxy;
        self.resolver = resolver;
        self.tls = tls;
        self.client = client;
        self.clock = clock;
        HttpClientProtocols(policy: client, tls: tls);
    }

    // How to reach url through the proxy.
    connecting(url is UrlParts) is HttpConversationConnecting {
        HttpProxyConnecting(
            proxy: proxy,
            target: url,
            resolver: resolver,
            tls: tls,
            client: client,
            clock: clock
        );
    }

    // Whether a connection with details may serve url.
    allowed(url is UrlParts, details is ExchangeDetails, access is EndpointAllowing) is bool {
        access.allowed(proxy.url(), details.endpoints().remote_endpoint());
    }
}

hidden object HttpProxyConnecting does HttpConversationConnecting {
    has proxy is ProxyPolicy;
    has target is UrlParts;
    has route is HttpEndpointSelection;
    has tls is TlsClientPolicy;
    has client is ClientPolicy;
    has clock is Timing;

    HttpProxyConnecting(
        proxy is ProxyPolicy,
        target is UrlParts,
        resolver is Resolving,
        tls is TlsClientPolicy,
        client is ClientPolicy,
        clock is Timing
    ) {
        HttpClientProtocols(policy: client, tls: tls);
        if target::Parts::scheme == "http" {
            confirm client.protocols().membership(HttpVersion.http_1_1)
                else throw UnsupportedHttpVersion.unsupported;
        }
        self.proxy = proxy;
        self.target = target;
        route = HttpEndpointSelection(url: proxy.url(), resolver: resolver, access: client.access());
        self.tls = tls;
        self.client = client;
        self.clock = clock;
    }

    async acquisition() is HttpConversationAcquisition {
        let fields is @Header = if proxy.authenticated() {
            [
                Header(
                    name: HeaderName("Proxy-Authorization"),
                    value: BasicAuthorization(proxy.credentials()).header().value()
                )
            ];
        }
        else {
            let empty is @Header = [];
            empty;
        };
        let endpoints = await route.endpoints();
        let raw is FutureGroup<TcpConnection> = FutureGroup();
        let empty is @Future<TcpConnection> = [];
        let pending = Atomic(empty);
        let taken = Event();
        let cleanup = HttpAcquisitionCleanup(
            group: raw,
            pending: pending,
            taken: taken,
            dispose: HttpTcpDisposal().release
        );
        defer await cleanup.close();
        let opening = TcpRacing(
            origins: endpoints,
            options: TcpOptions(),
            delay: Duration(milliseconds: 250),
            clock: clock
        ).connection();
        pending.replace([opening]);
        raw.start(opening);
        let tcp = await opening;
        taken.set();
        let published = Event();
        let anchor = HttpUnpublishedTcp(origin: tcp, published: published);
        defer anchor.close();
        if target::Parts::scheme == "http" {
            let observation = HttpResponseObservation();
            let session = Http1Conversation(
                origin: Http1Session(
                    observation.reading(tcp.input()),
                    observation.writing(tcp.output()),
                    tcp,
                    client.limits().http1()
                ),
                observation: observation,
                proxy_fields: fields
            );
            let acquired = HttpConversationAcquisition(
                session: session,
                details: ExchangeDetails(tcp.endpoints(), HttpVersion.http_1_1)
            );
            published.set();
            return acquired;
        }
        let tunneling = HttpProxyTunnel(
            input: tcp.input(),
            output: tcp.output(),
            target: target,
            fields: fields,
            limits: client.limits().http1()
        ).ready();
        await tunneling;
        let adopted is FutureGroup<HttpConversationAcquisition> = FutureGroup();
        let empty_acquired is @Future<HttpConversationAcquisition> = [];
        let acquisition_pending = Atomic(empty_acquired);
        let acquisition_taken = Event();
        let adopted_cleanup = HttpAcquisitionCleanup(
            group: adopted,
            pending: acquisition_pending,
            taken: acquisition_taken,
            dispose: HttpConversationAcquisitionDisposal().release
        );
        defer await adopted_cleanup.close();
        let adapting = HttpConversationAdopting(
            tcp: tcp,
            target: target,
            policy: tls,
            client: client,
            clock: clock
        ).acquisition();
        acquisition_pending.replace([adapting]);
        adopted.start(adapting);
        let acquired = await adapting;
        acquisition_taken.set();
        published.set();
        acquired;
    }
}
