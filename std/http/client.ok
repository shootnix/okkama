object HttpClientReadCleanup {
    has operation is HttpClientOperation;has successful is Event;has reads is FutureGroup<@byte>;
    HttpClientReadCleanup(operation is HttpClientOperation,successful is Event,reads is FutureGroup<@byte>){self.operation=operation;self.successful=successful;self.reads=reads;}
    async close() is void{if !successful.ready(){defer await operation.settle();defer operation.close();reads.cancel();await reads.wait();}}
