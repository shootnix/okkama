        }
        confirm !self.closed() else throw ClientClosed();let direct=HttpDirectRequest(request);
        let route=HttpEndpointSelection(direct.url(),resolver,policy.access());
        let operation=state.operation();let published=Event();let cleanup=HttpClientStartupCleanup(operation,published);defer await cleanup.close();
        let lease=await operation.acquisition(HttpClientKey(direct.url()).string(),Http1Connecting(route,tls,policy.limits().http1(),clock),policy.timeouts().connection_timeout(),clock);let acquired=lease.acquired();
        if lease.reused(){confirm policy.access().allowed(direct.url(),acquired.details().endpoints().remote_endpoint()) else throw EndpointDenied();}
        acquired.begin();let waiting=acquired.session().exchange(direct.request());operation.exchanges().start(waiting);
        let bounded is HttpDeadline<Http1Exchange>=HttpDeadline(waiting,policy.timeouts().headers_timeout(),clock,"headers");let exchange=try{await bounded.result();}catch e is HttpPeerGoneBeforeResponse{if lease.reused(){throw HttpStaleConnection(e.origin());}throw e.origin();};
