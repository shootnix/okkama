    HttpClientReading(origin is BodyReading,operation is HttpClientOperation,retained is HttpClientAcquired,limit is Duration,clock is Timing){self.origin=origin;self.operation=operation;self.retained=retained;self.limit=limit;self.clock=clock;complete=Event();}
