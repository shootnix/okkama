object HttpMixedDirectRequest {
    has url is Url;has request is Request;
    HttpMixedDirectRequest(origin is Request){
        let target=origin.target();confirm target.kind()==RequestTargetKind.absolute else throw InvalidClientRequest("absolute HTTP URL required");
        confirm origin.version()==HttpVersion.http_1_1 || origin.version()==HttpVersion.http_2 else throw InvalidClientRequest("unsupported HTTP request source version");
