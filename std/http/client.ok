object HttpSharedClientSignal {has ready is Event;HttpSharedClientSignal(ready is Event){self.ready=ready;}close() is void{ready.set();}}
object HttpSharedClientAcquisitionDisposal {HttpSharedClientAcquisitionDisposal();release(acquired is HttpConversationAcquisition) is void{acquired.session().close();}}
object HttpSharedClientStartupCleanup {
    has operation is HttpSharedClientOperation;has published is Event;
