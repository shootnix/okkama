    close() is void{if !stopped.ready(){stopped.set();let active=operations.value();for active -> operation{operation.cancel();}for active -> operation{operation.close();}operations.replace([]);let entries=shared.value();shared.replace([]);for entries -> entry{entry.transport().close();}}}
