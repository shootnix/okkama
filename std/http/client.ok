    finish() is void{if !finished.ready() && !self.closed(){finished.set();held.replace([]);self.release();}}
    cancel() is void{bookings.cancel();acquisitions.cancel();exchanges.cancel();}
    close() is void{if !stopped.ready() && !finished.ready(){stopped.set();self.cancel();for held.value() -> exchange{exchange.close();}held.replace([]);self.release();}}
