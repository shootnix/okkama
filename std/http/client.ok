// Policy and TLS identity are scoped to this state; no proxy is implicit.
object HttpClientKey {
    has key is string;HttpClientKey(url is Url){
        let parts=url.parts();let authority=parts.authority();
        let port=try{authority.port();}catch e is MissingUrlPort{if parts.scheme()=="https"{443;}else{80;}};
        key=parts.scheme()+"://"+authority.host().string()+":"+port.string();
    }
    string() is string{key;}
}
object HttpClientIdle {
    has key is string;has transport is HttpClientTransport;
    HttpClientIdle(key is string,transport is HttpClientTransport){self.key=key;self.transport=transport;}
    key() is string{key;}transport() is HttpClientTransport{transport;}
}
object HttpClientState does Closing {
    has capacity is Semaphore;has stopped is Event;has serial is Atomic<int>;
