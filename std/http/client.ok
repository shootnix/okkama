            confirm !self.closed() else throw ClientClosed();let direct=HttpMixedDirectRequest(request);
            let route=HttpEndpointSelection(direct.url(),resolver,policy.access());
            let operation=mixed[0].operation();let published=Event();let cleanup=HttpSharedClientStartupCleanup(operation,published);defer await cleanup.close();
            let connecting is HttpConversationConnecting=if routing.size()==1{routing[0].connecting(direct.url());}else{HttpSelectedConnecting(route,tls,policy,clock);};
            let reserving=operation.acquisition(HttpClientKey(direct.url()).string(),connecting,policy.timeouts().connection_timeout(),clock);operation.bookings().start(reserving);let lease=await reserving;let acquired=lease.acquired();
