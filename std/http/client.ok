            confirm !self.closed() else throw ClientClosed();let direct=Http2DirectRequest(request);
            let route=HttpEndpointSelection(direct.url(),resolver,policy.access());
            let operation=h2[0].operation();let published=Event();let cleanup=HttpSharedClientStartupCleanup(operation,published);defer await cleanup.close();
            let reserving=operation.acquisition(HttpClientKey(direct.url()).string(),Http2ConversationConnecting(Http2Connecting(route,tls,Http2Settings(),policy.limits(),clock)),policy.timeouts().connection_timeout(),clock);operation.bookings().start(reserving);let lease=await reserving;let acquired=lease.acquired();
