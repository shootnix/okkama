        HttpClientProtocols(policy,tls);self.resolver=resolver;self.tls=tls;self.policy=policy;self.clock=clock;self.routing=[routing];
        state=HttpClientState(policy.connections());h2=[];mixed=[HttpSharedClientState(policy.connections())];
    }
    closed() is bool{if mixed.size()==1{return mixed[0].closed();}if h2.size()==1{h2[0].closed();}else{state.closed();}}close() is void{if mixed.size()==1{mixed[0].close();return;}if h2.size()==1{h2[0].close();}else{state.close();}}
