    has bookings is FutureGroup<HttpSharedClientAcquired>;has acquisitions is FutureGroup<HttpConversationAcquisition>;has exchanges is FutureGroup<HttpConversationExchange>;
    HttpSharedClientOperation(owner is HttpSharedClientState,position is int){self.owner=owner;self.position=position;stopped=Event();finished=Event();entered=Event();let empty_transports is @HttpSharedClientTransport=[];transports=Atomic(empty_transports);let empty_exchanges is @HttpConversationExchange=[];held=Atomic(empty_exchanges);bookings=FutureGroup();acquisitions=FutureGroup();exchanges=FutureGroup();}
    position() is int{position;}closed() is bool{stopped.ready();}exchanges() is FutureGroup<HttpConversationExchange>{exchanges;}
    bookings() is FutureGroup<HttpSharedClientAcquired>{bookings;}
    published(exchange is HttpConversationExchange) is void{held.replace([exchange]);}
