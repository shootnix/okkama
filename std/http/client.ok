object HttpConversationUnavailable does Error{HttpConversationUnavailable();text() is string{"HTTP conversation no longer accepts an unsent request";}}

object HttpStaleConnection does Error{
    has failures is @Error;
    HttpStaleConnection(){failures=[];}HttpStaleConnection(origin is Error){failures=[origin];}
    text() is string{"stale pooled HTTP connection before any response bytes";}
    origin() is Error{if failures.size()==1{failures[0];}else{self;}}
}
