        h2=if use_h2{[HttpSharedClientState(policy.connections())];}else{let absent is @HttpSharedClientState=[];absent;};self.resolver=resolver;self.tls=tls;self.policy=policy;self.clock=clock;state=HttpClientState(policy.connections());
    }
