    has acquisition_group is FutureGroup<Http1Acquisition>;has acquisition_pending is Atomic<@Future<Http1Acquisition>>;has acquisition_taken is Event;
    has exchanges is FutureGroup<Http1Exchange>;
    HttpClientOperation(owner is HttpClientState,position is int){
        self.owner=owner;self.position=position;key=Atomic("");stopped=Event();finished=Event();
        let no_permits is @Permit=[];permits=Atomic(no_permits);let no_connections is @Http1Acquisition=[];acquired=Atomic(no_connections);
        let no_transports is @HttpClientTransport=[];transports=Atomic(no_transports);
        permit_group=FutureGroup();let no_waiters is @Future<Permit>=[];permit_pending=Atomic(no_waiters);permit_taken=Event();
        acquisition_group=FutureGroup();let no_acquisitions is @Future<Http1Acquisition>=[];acquisition_pending=Atomic(no_acquisitions);acquisition_taken=Event();exchanges=FutureGroup();
