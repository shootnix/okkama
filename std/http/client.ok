// Atomic payloads are borrowed. A long-lived, supervised task owns the actual
// acquired session in its lexical scope until eviction or client close.
object HttpClientTransport {
    has connecting is Http1Connecting;has ready,stopped is Event;
    has acquired is Atomic<@Http1Acquisition>;has group is FutureGroup<bool>;
    HttpClientTransport(connecting is Http1Connecting){self.connecting=connecting;ready=Event();stopped=Event();let empty is @Http1Acquisition=[];acquired=Atomic(empty);group=FutureGroup();}
    start() is void{group.start(self.run());}
