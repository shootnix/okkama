    reading() is BodyReading{confirm !operation.closed() else throw BodyClosed();confirm opened.compare_and_replace(false,true) else throw BodyAlreadyOpened();HttpSharedClientReading(origin.reading(),operation,retained,limit,clock);}
    destroy{try{if !opened.value(){operation.close();}}catch e is Error{}catch e is NativeFailure{}}
}
object HttpSharedClientReading does BodyReading {
    has origin is BodyReading;has operation is HttpSharedClientOperation;has retained is HttpSharedClientAcquired;has limit is Duration;has clock is Timing;has complete is Event;
    HttpSharedClientReading(origin is BodyReading,operation is HttpSharedClientOperation,retained is HttpSharedClientAcquired,limit is Duration,clock is Timing){self.origin=origin;self.operation=operation;self.retained=retained;self.limit=limit;self.clock=clock;complete=Event();}
    closed() is bool{operation.closed() || origin.closed();}close() is void{if !complete.ready(){operation.close();origin.close();}}
