object HttpClientAcquired {
    has acquired is Http1Acquisition;has permit is Permit;has transport is HttpClientTransport;has reused is bool;
    HttpClientAcquired(acquired is Http1Acquisition,permit is Permit,transport is HttpClientTransport,reused is bool){self.acquired=acquired;self.permit=permit;self.transport=transport;self.reused=reused;}
    acquired() is Http1Acquisition{acquired;}reused() is bool{reused;}
