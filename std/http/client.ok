object HttpSharedClientSelected {
    has transport is HttpSharedClientTransport;has reused is bool;HttpSharedClientSelected(transport is HttpSharedClientTransport,reused is bool){self.transport=transport;self.reused=reused;}
    transport() is HttpSharedClientTransport{transport;}reused() is bool{reused;}
