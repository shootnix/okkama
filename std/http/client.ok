        let cleanup=HttpAcquisitionCleanup(children,pending,taken,HttpClientAcquisitionDisposal().release);defer await cleanup.close();children.start(opening);
        let connection=await opening;taken.set();defer connection.session().close();acquired.replace([connection]);ready.set();
