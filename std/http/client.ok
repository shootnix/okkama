object ClientClosed does Error{ClientClosed();text() is string{"HTTP client is closed";}}
object HttpTimeout does Error {
    has phase is string;HttpTimeout(phase is string){self.phase=phase;}
    phase() is string{phase;}text() is string{"HTTP "+phase+" timeout";}
}
async test "unstarted client response cancellation acquires no route or connection" {
    let client=HttpClient(FixedResolution([]),TlsClientPolicy(TrustedCertificates([])),ClientPolicy(),SystemClock());
    let request=Request(Method("GET"),AbsoluteTarget(ParsedUrl("http://example.test/").value()),Headers([]));
    let waiting=client.response(request);waiting.cancel();
    test.ok(try{await waiting;false;}catch e is Cancelled{true;});test.ok(!client.closed());client.close();test.ok(client.closed());
}

// Policy and TLS identity are scoped to this state; no proxy is implicit.
// Each shared H2 conversation owns one physical connection permit;
// request/body leases are independent of that transport lifetime.
object Http2ClientProtocols {
    Http2ClientProtocols(policy is ClientPolicy,tls is TlsClientPolicy){
        confirm policy.protocols().size()==1 && policy.protocols().membership(HttpVersion.http_2) else throw UnsupportedHttpVersion();
        for tls.protocols() -> protocol{confirm protocol=="h2" else throw UnsupportedHttpVersion();}
    }
}
object Http2DirectRequest {
    has url is Url;has request is Request;
    Http2DirectRequest(origin is Request){
        let target=origin.target();confirm target.kind()==RequestTargetKind.absolute else throw InvalidClientRequest("absolute HTTP URL required");let destination=target.url();
        confirm origin.version()==HttpVersion.http_1_1 || origin.version()==HttpVersion.http_2 else throw InvalidClientRequest("unsupported H2 request source version");
        let prepared=Request(origin.method(),target,origin.headers(),origin.body(),HttpVersion.http_2);Http2RequestFields(prepared,1);request=prepared;url=destination;
    }
    url() is Url{url;}request() is Request{request;}
}

object HttpSharedClientIdle {
    has key is string;has transport is HttpSharedClientTransport;
    HttpSharedClientIdle(key is string,transport is HttpSharedClientTransport){self.key=key;self.transport=transport;}
    key() is string{key;}transport() is HttpSharedClientTransport{transport;}
}
