    operation() is HttpSharedClientOperation{
        confirm !self.closed() else throw ClientClosed();let old=operations.value();confirm old.size()<256 else throw InvalidClientRequest("pending H2 exchange budget");
        let position=serial.value();serial.replace(position+1);let operation=HttpSharedClientOperation(self,position);
        let next_operations is @HttpSharedClientOperation=(0..old.size()+1).map()->index{if index<old.size(){old[index];}else{operation;}};operations.replace(next_operations);operation;
