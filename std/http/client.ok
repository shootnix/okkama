    async close() is void{defer await operation.settle();if !published.ready(){operation.close();}}
}
object HttpSharedClientBody does BodyOpening {
    has origin is BodyOpening;has operation is HttpSharedClientOperation;has retained is HttpSharedClientAcquired;has limit is Duration;has clock is Timing;has opened is Atomic<bool>;
    HttpSharedClientBody(origin is BodyOpening,operation is HttpSharedClientOperation,retained is HttpSharedClientAcquired,limit is Duration,clock is Timing){self.origin=origin;self.operation=operation;self.retained=retained;self.limit=limit;self.clock=clock;opened=Atomic(false);}
