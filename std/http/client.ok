object HttpSharedSessionWait<T>{has group is FutureGroup<T>;HttpSharedSessionWait(group is FutureGroup<T>){self.group=group;}async close() is void{if group.active()>0{group.cancel();await group.wait();}}}
object HttpSharedClientAcquired {
    has acquired is HttpConversationAcquisition;has transport is HttpSharedClientTransport;has reused is bool;
    HttpSharedClientAcquired(acquired is HttpConversationAcquisition,transport is HttpSharedClientTransport,reused is bool){self.acquired=acquired;self.transport=transport;self.reused=reused;}
    acquired() is HttpConversationAcquisition{acquired;}reused() is bool{reused;}
}
object HttpSharedClientTransport {
    has connecting is HttpConversationConnecting;has capacity is Semaphore;has ready,stopped,admission,granted is Event;has refs is Atomic<int>;has busy is Atomic<bool>;has changed is Atomic<Event>;
    has acquired is Atomic<@HttpConversationAcquisition>;has group is FutureGroup<bool>;
    HttpSharedClientTransport(connecting is HttpConversationConnecting,capacity is Semaphore){self.connecting=connecting;self.capacity=capacity;ready=Event();stopped=Event();admission=Event();granted=Event();refs=Atomic(0);busy=Atomic(false);changed=Atomic(Event());let empty is @HttpConversationAcquisition=[];acquired=Atomic(empty);group=FutureGroup();}
