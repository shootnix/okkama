module http/routing v1.0.0;

import "http/handler" take Handling, HandlingResult, ResponseHandling;
import "http/request_context" take HttpRequestContext;
import "http/message" take Request, Response;
import "http/method" take Method, MethodName;
import "http/status" take Status, StatusCode;
import "http/header" take Headers, Header, HeaderName;
import "http/target" take RequestTargetKind, ParsedRequestTarget, OriginTarget;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "collections/sequence" take Sequencing;
import "collections/ordering" take SortedBy;
import "url/percent" take PercentDecoded;
import "encoding/utf" take Utf8Encoded;
import "runtime/collections" take string_map_snapshot;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "async/cancellation" take Cancellation;

enum RouteSegmentKind = (literal, parameter, wildcard);

enum InvalidRoute is Error = (because(reason is string));

// What a table does with a path no route matches when the same path with or
// without its final slash does (#105): strict sends it to the fallback,
// redirect answers 308 to the declared form.
enum SlashPolicy = (strict, redirect);

// Split raw separators first, then decode once. Encoded slash remains data in
// one segment, never a second match position. No Unicode/case normalization.
hidden object RoutedPath {
    has segments is @string;

    RoutedPath(origin is string) {
        confirm origin != ""
            && origin.length() <= 8192
            && origin.slice(0, 1) == "/"
            && !origin.contains("?")
            && !origin.contains("#")
            else throw InvalidRoute.because("absolute path without query/fragment required");
        let raw is @string = if origin == "/" {
            [];
        }
        else {
            origin.slice(1, origin.length()).split("/");
        };
        confirm raw.size() <= 128 else throw InvalidRoute.because("path segment budget");
        // Annotated binding supplies the element type when "/" yields no segments.
        let decoded is @string = raw.map() -> segment {
            RouteLiteral(segment).string();
        };
        segments = decoded;
    }

    segments() is @string {
        segments;
    }
}

hidden object RouteLiteral {
    has value is string;

    RouteLiteral(origin is string) {
        let decoded = try {
            PercentDecoded(origin).string();
        }
        catch e is Error {
            throw InvalidRoute.because("invalid percent/UTF8 segment");
        };
        // Character codes: a character past ASCII is no control, as none of
        // its UTF-8 bytes was (#503).
        for decoded.characters() -> character {
            let code = character.code();
            confirm code >= 32 && code != 127
                else throw InvalidRoute.because("control in decoded segment");
        }
        value = decoded;
    }

    string() is string {
        value;
    }
}

hidden object RouteParameterName {
    RouteParameterName(origin is string) {
        let bytes = Utf8Encoded(origin).bytes();
        confirm bytes.size() > 0 && bytes.size() <= 32
            else throw InvalidRoute.because("parameter name budget");
        for (0..bytes.size()) -> index {
            let code = bytes[index].int();
            let letter = (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95;
            confirm letter || (index > 0 && code >= 48 && code <= 57)
                else throw InvalidRoute.because("ASCII identifier required");
        }
    }
}

object RouteSegment {
    has kind is RouteSegmentKind;
    has value is string;

    RouteSegment(origin is string, final is bool) {
        let first = if origin == "" {
            "";
        }
        else {
            origin.slice(0, 1);
        };
        if first == ":" || first == "*" {
            let name = origin.slice(1, origin.length());
            RouteParameterName(name);
            confirm first != "*" || final else throw InvalidRoute.because("wildcard must be final");
            kind = if first == ":" {
                RouteSegmentKind.parameter;
            }
            else {
                RouteSegmentKind.wildcard;
            };
            value = name;
        }
        else {
            kind = RouteSegmentKind.literal;
            value = RouteLiteral(origin).string();
        }
    }

    cap Segment {
        kind is RouteSegmentKind {
            kind;
        }

        text is string {
            value;
        }
    }
}

object RoutePattern {
    has origin is string;
    has parts is @RouteSegment;

    RoutePattern(origin is string) {
        confirm origin != ""
            && Utf8Encoded(origin).bytes().size() <= 8192
            && origin.slice(0, 1) == "/"
            && !origin.contains("?")
            && !origin.contains("#")
            else throw InvalidRoute.because("pattern path budget or grammar");
        let raw is @string = if origin == "/" {
            [];
        }
        else {
            origin.slice(1, origin.length()).split("/");
        };
        confirm raw.size() <= 128 else throw InvalidRoute.because("pattern segment budget");
        let segments is @RouteSegment = (0..raw.size()).map() -> index {
            RouteSegment(origin: raw[index], final: index + 1 == raw.size());
        };
        // Segment grammar is validated before name uniqueness, as before.
        // Capture names (including the final wildcard) share one namespace.
        let named = segments.filter() -> segment {
            segment::Segment::kind != RouteSegmentKind.literal;
        };
        let names is @string = named.map() -> segment {
            segment::Segment::text;
        };
        let ordered = names.ordering();
        for (0..ordered.size()) -> index {
            if index > 0 {
                confirm (ordered[index] != ordered[index - 1])
                    else throw InvalidRoute.because("duplicate parameter name");
            }
        }
        self.origin = origin;
        parts = segments;
    }

    string() is string {
        origin;
    }

    parts() is @RouteSegment {
        parts;
    }

    match(path is string) is RouteMatch {
        self.matching(RoutedPath(path).segments());
    }

    matches(path is @string) is bool {
        confirm path.size() <= 128 else throw InvalidRoute.because("decoded path segment budget");
        let wildcard = parts.size() > 0
            && parts[parts.size() - 1]::Segment::kind == RouteSegmentKind.wildcard;
        let fixed = parts.size() - (if wildcard {
            1;
        }
        else {
            0;
        });
        if path.size() < fixed || (!wildcard && path.size() != fixed) {
            return false;
        }
        for (0..fixed) -> index {
            let part = parts[index];
            if part::Segment::kind == RouteSegmentKind.literal && part::Segment::text != path[index] {
                return false;
            }
            if part::Segment::kind == RouteSegmentKind.parameter && path[index] == "" {
                return false;
            }
        }
        true;
    }

    matching(path is @string) is RouteMatch {
        if !self.matches(path) {
            return RouteMatch();
        }
        let _width = path.reduce(0) -> used, segment {
            confirm segment.length() <= 8192 - used
                else throw InvalidRoute.because("decoded path character budget");
            used + segment.length();
        };
        RouteMatch(RouteCapture(parts: parts, path: path).parameters());
    }

    // Whether some path matches both patterns. Routes accepts overlapping
    // patterns and gives a request to the most specific one; it refuses only
    // two routes of one method with the same shape.
    overlaps(other is RoutePattern) is bool {
        let right = other.parts();
        let common = if parts.size() < right.size() {
            parts.size();
        }
        else {
            right.size();
        };
        for (0..common) -> index {
            let left = parts[index];
            let peer = right[index];
            if left::Segment::kind == RouteSegmentKind.wildcard
                || peer::Segment::kind == RouteSegmentKind.wildcard {
                    return true;
                }
            if left::Segment::kind == RouteSegmentKind.literal
                && peer::Segment::kind == RouteSegmentKind.literal
                && left::Segment::text != peer::Segment::text {
                    return false;
                }
            if (left::Segment::kind == RouteSegmentKind.parameter
                && peer::Segment::kind == RouteSegmentKind.literal
                && peer::Segment::text == "")
                || (peer::Segment::kind == RouteSegmentKind.parameter
                && left::Segment::kind == RouteSegmentKind.literal
                && left::Segment::text == "") {
                    return false;
                }
        }
        if parts.size() == right.size() {
            return true;
        }
        let longer = if parts.size() > right.size() {
            parts;
        }
        else {
            right;
        };
        longer[common]::Segment::kind == RouteSegmentKind.wildcard;
    }
}

object RouteMatch {
    has matched is bool;
    has parameters is %string:string;

    RouteMatch() {
        matched = false;
        parameters = [:];
    }

    RouteMatch(parameters is %string:string) {
        matched = true;
        self.parameters = parameters;
    }

    matched() is bool {
        matched;
    }

    parameters() is %string:string {
        confirm matched else throw InvalidRoute.because("no route match");
        parameters;
    }
}

// A pattern, the handler for it and the method it serves, or every method.
object Route {
    has method is Maybe<Method>;
    has pattern is RoutePattern;
    has handling is Handling;
    has name is string;

    // name is how links find the route (web/request link, #106); "" for none.
    Route(method is Method, pattern is RoutePattern, handling is Handling, name is string = "") {
        self.method = Maybe.some(method);
        self.pattern = pattern;
        self.handling = handling;
        self.name = name;
    }

    // A route for every method, as web/routing's Any (#78). A more specific
    // pattern still wins, and on the same pattern a route of the request's own
    // method wins over this one.
    Route(pattern is RoutePattern, handling is Handling, name is string = "") {
        method = Maybe<Method>.none;
        self.pattern = pattern;
        self.handling = handling;
        self.name = name;
    }

    // The name links find the route by, or "".
    name() is string {
        name;
    }

    // The method; a route for every method has none and throws.
    method() is Method {
        match method {
            case Maybe.some(one) {
                one;
            }
            else {
                throw InvalidRoute.because("a route for every method has no one method");
            }
        };
    }

    // The method's token on the wire, or "" for a route of every method.
    method_token() is string {
        match method {
            case Maybe.some(one) {
                MethodName(one).string();
            }
            else {
                "";
            }
        };
    }

    pattern() is RoutePattern {
        pattern;
    }

    handling() is Handling {
        handling;
    }
}

// Answers requests that Routes itself rejects before any handler runs. A 405
// answer must carry the Allow field built from `allowed`; EmptyRouteRejection
// is the default and sends empty 400/405 responses.
role RouteRejecting {
    malformed(request is Request, reason is string) is HandlingResult;
    disallowed(request is Request, allowed is @string) is HandlingResult;
}

hidden object EmptyRouteRejection does RouteRejecting {
    EmptyRouteRejection();

    malformed(request is Request, reason is string) is HandlingResult {
        ResponseHandling(Response(status: Status.bad_request));
    }

    disallowed(request is Request, allowed is @string) is HandlingResult {
        ResponseHandling(
            Response(
                status: Status.method_not_allowed,
                headers: Headers(Header(name: HeaderName("Allow"), value: allowed.join(", ")))
            )
        );
    }
}

// A route table, and the Handling that sends each request to its route.
//
// Patterns of one method may overlap: a request goes to the most specific one
// (#103). Segment by segment, left to right, a literal wins over a parameter
// and a parameter over a final wildcard; a pattern that ends with the path
// wins over a wildcard that would take nothing:
//
//     GET /users/me       before  GET /users/:id
//     GET /files/index    before  GET /files/*path
//     GET /files          before  GET /files/*path
//
// When the most specific pattern has no route for the method, the next one is
// tried: with POST /users/me and GET /users/:id, GET /users/me reaches
// /users/:id. Within one pattern the method's own route wins, and HEAD falls
// back to GET. Only two routes of one method with the same shape, such as
// /users/:id and /users/:name, are refused, at construction.
//
// The table becomes a segment tree on the first request, so finding the route
// takes one step per path segment, whatever the number of routes (#104).
object Routes does Handling {
    has routes is @Route;
    has fallback is Handling;
    has rejection is RouteRejecting;
    has slashes is SlashPolicy;

    Routes(routes is Sequencing<Route>, fallback is Handling) {
        let snapshot is @Route = (0..routes.size()).map() -> index {
            routes.item(index);
        };
        let duplicate = RouteShapes(snapshot).duplicate();
        confirm duplicate == ""
            else throw InvalidRoute.because("routes of one method with one shape: " + duplicate);
        self.routes = snapshot;
        self.fallback = fallback;
        rejection = EmptyRouteRejection();
        slashes = SlashPolicy.strict;
    }

    // slashes: SlashPolicy.redirect answers a path no route matches with 308 to
    // the same path with or without its final slash, when that one matches
    // (#105); strict, the default, sends it to the fallback.
    Routes(
        routes is Sequencing<Route>,
        fallback is Handling,
        rejection is RouteRejecting,
        slashes is SlashPolicy = SlashPolicy.strict
    ) {
        let snapshot is @Route = (0..routes.size()).map() -> index {
            routes.item(index);
        };
        let duplicate = RouteShapes(snapshot).duplicate();
        confirm duplicate == ""
            else throw InvalidRoute.because("routes of one method with one shape: " + duplicate);
        self.routes = snapshot;
        self.fallback = fallback;
        self.rejection = rejection;
        self.slashes = slashes;
    }

    async invoke(handler is Handling, request is Request, context is HttpRequestContext) is HandlingResult {
        let pending = handler.handling(request, context);
        await pending;
    }

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        context.cancelling().check();
        let target = request::Head::target;
        if target.kind() != RequestTargetKind.origin && target.kind() != RequestTargetKind.absolute {
            return await self.invoke(fallback, request, context);
        }
        let raw = if target.kind() == RequestTargetKind.origin {
            target.path();
        }
        else {
            let url = target.url();
            url::Parts::path;
        };
        let sections is @@string = try {
            [RoutedPath(raw).segments()];
        }
        catch e is InvalidRoute {
            [];
        };
        if sections.size() == 0 {
            return rejection.malformed(request, "invalid route path");
        }
        let path = sections[0];
        let tree = self.tree();
        let chosen = tree.chosen(path, 0, MethodName(request::Head::method).string());
        if chosen >= 0 {
            let route = routes[chosen];
            let parameters = self.parameters(route, path, context.parameters());
            if parameters.size() == 0 {
                return rejection.malformed(request, "route parameter budget exceeded");
            }
            return await self.invoke(route.handling(), request, context.parameters(parameters[0]));
        }
        let matching = tree.matching(path, 0);
        if matching.size() > 0 {
            return rejection.disallowed(request, self.allowed(matching));
        }
        if slashes == SlashPolicy.redirect && raw != "/" {
            let other = if raw.ends_with("/") {
                raw.slice(0, raw.length() - 1);
            }
            else {
                raw + "/";
            };
            let found is @@string = try {
                [RoutedPath(other).segments()];
            }
            catch e is InvalidRoute {
                [];
            };
            if found.size() > 0 && tree.matching(found[0], 0).size() > 0 {
                let query = if target.kind() == RequestTargetKind.origin {
                    target.query();
                }
                else {
                    let url = target.url();
                    url::Parts::query;
                };
                let location = match query {
                    case Maybe.some(text) {
                        other + "?" + text;
                    }
                    else {
                        other;
                    }
                };
                return ResponseHandling(
                    Response(
                        status: Status.permanent_redirect,
                        headers: Headers(
                            Header(name: HeaderName("Location"), value: location),
                            Header(name: HeaderName("Content-Length"), value: "0")
                        )
                    )
                );
            }
        }
        await self.invoke(fallback, request, context);
    }

    // The segment tree, built on the first request and kept.
    hidden tree() is RouteNode {
        once let built = RouteTreeBuilding(entries: self.entries(), depth: 0).node();
        built;
    }

    hidden entries() is @RouteEntry {
        let entries is @RouteEntry = (0..routes.size()).map() -> index {
            let route = routes[index];
            RouteEntry(index: index, method: route.method_token(), parts: route.pattern().parts());
        };
        entries;
    }

    // The route's captures over the parameters an outer table has set. An empty
    // array when they pass the budget of 128 names and 8192 characters.
    hidden parameters(route is Route, path is @string, existing is %string:string) is @%string:string {
        let captured is @%string:string = try {
            [RouteCapture(parts: route.pattern().parts(), path: path).parameters()];
        }
        catch e is InvalidRoute {
            [];
        };
        if captured.size() == 0 || existing.size() == 0 {
            return captured;
        }
        let merged = existing + captured[0];
        let bounded is @%string:string = try {
            [string_map_snapshot(merged.keys(), merged.values(), 128, 8192)];
        }
        catch e is NativeFailure {
            [];
        };
        bounded;
    }

    // The methods of the routes that match the path, in the table's order and
    // each once; GET brings HEAD.
    hidden allowed(matching is @int) is @string {
        let start is @string = [];
        let names is @string = matching.ordering().reduce(start) -> kept, index {
            let name = routes[index].method_token();
            let named is @string = if name == "" || kept.contains(name) {
                kept;
            }
            else {
                kept + [name];
            };
            if name == "GET" && !named.contains("HEAD") {
                named + ["HEAD"];
            }
            else {
                named;
            }
        };
        names;
    }
}

// Two routes of one method with one shape would leave the choice to the order
// of the table, so the table refuses them. A shape is the method and, segment
// by segment, the literal or the kind of capture: /users/:id and /users/:name
// have one shape. Decoded literals hold no control characters, so a tab and a
// newline separate the parts of a key unambiguously.
hidden object RouteShapes {
    has routes is @Route;

    RouteShapes(routes is @Route) {
        self.routes = routes;
    }

    // The method and the two patterns of the first pair with one shape, or "".
    duplicate() is string {
        let keys is @string = routes.map() -> route {
            self.key(route);
        };
        let ordered = keys.ordering();
        let repeated is @int = (0..ordered.size()).filter() -> index {
            if index == 0 {
                false;
            }
            else {
                ordered[index] == ordered[index - 1];
            }
        };
        if repeated.size() == 0 {
            return "";
        }
        let key = ordered[repeated[0]];
        let pair is @int = (0..keys.size()).filter() -> index {
            keys[index] == key;
        };
        let first = routes[pair[0]];
        let method = if first.method_token() == "" {
            "any method";
        }
        else {
            first.method_token();
        };
        method + " " + first.pattern().string() + " and " + routes[pair[1]].pattern().string();
    }

    hidden key(route is Route) is string {
        let parts is @string = route.pattern().parts().map() -> part {
            if part::Segment::kind == RouteSegmentKind.literal {
                "=" + part::Segment::text;
            }
            else {
                if part::Segment::kind == RouteSegmentKind.parameter {
                    ":";
                }
                else {
                    "*";
                }
            }
        };
        route.method_token() + "\t" + parts.join("\n");
    }
}

// One route as the tree sees it: its position in the table, its method and its
// segments.
hidden object RouteEntry {
    has index is int;
    has method is string;
    has parts is @RouteSegment;

    RouteEntry(index is int, method is string, parts is @RouteSegment) {
        self.index = index;
        self.method = method;
        self.parts = parts;
    }

    index() is int {
        index;
    }

    method() is string {
        method;
    }

    // Whether the pattern ends after depth segments.
    ends(depth is int) is bool {
        parts.size() == depth;
    }

    // Whether segment depth exists and is of this kind.
    continues(depth is int, kind is RouteSegmentKind) is bool {
        parts.size() > depth && parts[depth]::Segment::kind == kind;
    }

    literal(depth is int) is string {
        parts[depth]::Segment::text;
    }
}

// The node for the entries that share their first depth segments.
hidden object RouteTreeBuilding {
    has entries is @RouteEntry;
    has depth is int;

    RouteTreeBuilding(entries is @RouteEntry, depth is int) {
        self.entries = entries;
        self.depth = depth;
    }

    node() is RouteNode {
        let at = depth;
        let ending = entries.filter() -> entry {
            entry.ends(at);
        };
        let methods is %string:int = ending.reduce([:]) -> kept, entry {
            kept + [entry.method(): entry.index()];
        };
        let named = entries.filter() -> entry {
            entry.continues(at, RouteSegmentKind.parameter);
        };
        let parameter = if named.size() == 0 {
            Maybe<RouteNode>.none;
        }
        else {
            Maybe.some(RouteTreeBuilding(entries: named, depth: at + 1).node());
        };
        let wild = entries.filter() -> entry {
            entry.continues(at, RouteSegmentKind.wildcard);
        };
        let wildcard = if wild.size() == 0 {
            Maybe<RouteNode>.none;
        }
        else {
            Maybe.some(RouteTreeBuilding(entries: wild, depth: at + 1).node());
        };
        let literal = entries.filter() -> entry {
            entry.continues(at, RouteSegmentKind.literal);
        };
        let sorted is SortedBy<RouteEntry, string> = SortedBy(
            origin: literal,
            key: (entry is RouteEntry) is string {
                entry.literal(at);
            }
        );
        let values is @RouteEntry = (0..sorted.size()).map() -> index {
            sorted.item(index);
        };
        // Where each run of one literal starts.
        let starts is @int = (0..values.size()).filter() -> index {
            if index == 0 {
                true;
            }
            else {
                values[index].literal(at) != values[index - 1].literal(at);
            }
        };
        let children is @RouteNode = (0..starts.size()).map() -> run {
            let end = if run + 1 < starts.size() {
                starts[run + 1];
            }
            else {
                values.size();
            };
            RouteTreeBuilding(entries: values.slice(starts[run], end), depth: at + 1).node();
        };
        let literals is %string:int = (0..starts.size()).reduce([:]) -> kept, run {
            kept + [values[starts[run]].literal(at): run];
        };
        RouteNode(
            methods: methods,
            literals: literals,
            children: children,
            parameter: parameter,
            wildcard: wildcard
        );
    }
}

// One node of the segment tree: the routes that end here by method token ("" for
// every method), and the nodes for the next segment, one per literal, one for a
// parameter and one for a final wildcard.
hidden object RouteNode {
    has methods is %string:int;
    has literals is %string:int;
    has children is @RouteNode;
    has parameter is Maybe<RouteNode>;
    has wildcard is Maybe<RouteNode>;

    RouteNode(
        methods is %string:int,
        literals is %string:int,
        children is @RouteNode,
        parameter is Maybe<RouteNode>,
        wildcard is Maybe<RouteNode>
    ) {
        self.methods = methods;
        self.literals = literals;
        self.children = children;
        self.parameter = parameter;
        self.wildcard = wildcard;
    }

    // The route that ends here and takes the method: its own, else GET for
    // HEAD, else a route for every method (keyed ""); -1 for none.
    accepted(method is string) is int {
        let own = methods[method] else -1;
        if own >= 0 {
            return own;
        }
        if method == "HEAD" {
            let get = methods["GET"] else -1;
            if get >= 0 {
                return get;
            }
        }
        methods[""] else -1;
    }

    // The routes that end here, whatever their method.
    ending() is @int {
        methods.values();
    }

    // The most specific route for the rest of the path: the literal child
    // first, then the parameter, then the wildcard, trying the next when one
    // finds nothing. A node sits at one depth, so a request visits it at most
    // once.
    chosen(path is @string, depth is int, method is string) is int {
        if depth == path.size() {
            let own = self.accepted(method);
            if own >= 0 {
                return own;
            }
            return self.rest(method);
        }
        let segment = path[depth];
        let literal = literals[segment] else -1;
        if literal >= 0 {
            let found = children[literal].chosen(path, depth + 1, method);
            if found >= 0 {
                return found;
            }
        }
        if segment != "" {
            let named = match parameter {
                case Maybe.some(child) {
                    child.chosen(path, depth + 1, method);
                }
                else {
                    -1;
                }
            };
            if named >= 0 {
                return named;
            }
        }
        self.rest(method);
    }

    // Every route whose pattern matches the rest of the path, whatever its
    // method.
    matching(path is @string, depth is int) is @int {
        let wild is @int = match wildcard {
            case Maybe.some(node) {
                node.ending();
            }
            else {
                [];
            }
        };
        if depth == path.size() {
            return methods.values() + wild;
        }
        let segment = path[depth];
        let literal = literals[segment] else -1;
        let exact is @int = if literal >= 0 {
            children[literal].matching(path, depth + 1);
        }
        else {
            [];
        };
        let named is @int = if segment == "" {
            [];
        }
        else {
            match parameter {
                case Maybe.some(child) {
                    child.matching(path, depth + 1);
                }
                else {
                    [];
                }
            };
        };
        exact + named + wild;
    }

    // The wildcard route that takes the rest of the path, or -1.
    hidden rest(method is string) is int {
        match wildcard {
            case Maybe.some(node) {
                node.accepted(method);
            }
            else {
                -1;
            }
        };
    }
}

// The parameters a pattern captures from a path it matches.
hidden object RouteCapture {
    has parts is @RouteSegment;
    has path is @string;

    RouteCapture(parts is @RouteSegment, path is @string) {
        self.parts = parts;
        self.path = path;
    }

    parameters() is %string:string {
        let positions is @int = (0..parts.size()).filter() -> index {
            parts[index]::Segment::kind != RouteSegmentKind.literal;
        };
        let keys is @string = positions.map() -> index {
            parts[index]::Segment::text;
        };
        let values is @string = positions.map() -> index {
            if parts[index]::Segment::kind == RouteSegmentKind.wildcard {
                path.slice(index, path.size()).join("/");
            }
            else {
                path[index];
            }
        };
        let parameters = try {
            string_map_snapshot(keys, values, 128, 8192);
        }
        catch e is NativeFailure {
            throw InvalidRoute.because("captured parameter budget");
        };
        parameters;
    }
}

test "encoded separators are one decoded route coordinate" {
    let matched = RoutePattern("/:id").match("/a%2Fb");
    test.ok(matched.matched());
    test.is(matched.parameters()["id"], "a/b");
    test.ok(!RoutePattern("/:id").match("/a/b").matched());
}

test "root path is zero segments and matches only the root pattern" {
    test.ok(RoutePattern("/").match("/").matched());
    test.is(RoutePattern("/").match("/").parameters().size(), 0);
    test.ok(!RoutePattern("/a").match("/").matched());
    test.ok(!RoutePattern("/").match("/a").matched());
}

test "default rejection keeps empty 400 and Allow-carrying 405 responses" {
    let methods is @string = ["GET", "HEAD"];
    test.is(
        EmptyRouteRejection().disallowed(
            Request(
                method: Method.put,
                target: ParsedRequestTarget(origin: "/a", method: Method.put).target()
            ),
            methods
        ).response()::Head::headers.first(HeaderName("Allow")),
        "GET, HEAD"
    );
    test.is(
        EmptyRouteRejection().malformed(
            Request(
                method: Method.get,
                target: ParsedRequestTarget(origin: "/a", method: Method.get).target()
            ),
            "x"
        ).response()::Head::status,
        Status.bad_request
    );
}

// Answers with its name and the parameters it was given, for the tests below.
hidden object RouteProbe does Handling {
    has name is string;

    RouteProbe(name is string) {
        self.name = name;
    }

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        let parameters = context.parameters();
        let pairs is @string = parameters.keys().map() -> key {
            key + "=" + parameters[key];
        };
        let answer = if pairs.size() == 0 {
            name;
        }
        else {
            name + " " + pairs.join(",");
        };
        ResponseHandling(
            Response(status: Status.ok, headers: Headers(Header(name: "X-Route", value: answer)))
        );
    }
}

// What a table answers to a method and a path: the probe's answer, or the
// status code of a refusal, with the Allow field for 405.
hidden object RouteDispatch {
    has routes is Routes;

    RouteDispatch(routes is Routes) {
        self.routes = routes;
    }

    async answer(method is Method, path is string) is string {
        let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
            local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
            remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: 50000)
        );
        let context = HttpRequestContext(
            details: ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1),
            cancellation: Cancellation().cancelling()
        );
        let request = Request(
            target: OriginTarget(path: path, query: Maybe<string>.none),
            method: method
        );
        let result = await routes.handling(request, context);
        let response = result.response();
        let headers = response::Head::headers;
        if response::Head::status == Status.ok {
            return headers.first(HeaderName("X-Route"));
        }
        let code = StatusCode(response::Head::status).number().string();
        if response::Head::status == Status.method_not_allowed {
            return code + " " + headers.first(HeaderName("Allow"));
        }
        if response::Head::status == Status.permanent_redirect {
            return code + " " + headers.first(HeaderName("Location"));
        }
        code;
    }
}

async test "a literal wins over a parameter, and a parameter over a wildcard" {
    let routes is @Route = [
        Route(method: Method.get, pattern: RoutePattern("/users/:id"), handling: RouteProbe("user")),
        Route(method: Method.get, pattern: RoutePattern("/users/me"), handling: RouteProbe("me")),
        Route(
            method: Method.get,
            pattern: RoutePattern("/files/*path"),
            handling: RouteProbe("files")
        ),
        Route(
            method: Method.get,
            pattern: RoutePattern("/files/index"),
            handling: RouteProbe("index")
        ),
        Route(
            method: Method.get,
            pattern: RoutePattern("/files/:name/raw"),
            handling: RouteProbe("raw")
        ),
        Route(method: Method.get, pattern: RoutePattern("/files"), handling: RouteProbe("list")),
    ];
    let table = RouteDispatch(Routes(routes: routes, fallback: RouteProbe("fallback")));
    test.is(await table.answer(Method.get, "/users/me"), "me");
    test.is(await table.answer(Method.get, "/users/7"), "user id=7");
    test.is(await table.answer(Method.get, "/files/index"), "index");
    test.is(await table.answer(Method.get, "/files/a/raw"), "raw name=a");
    test.is(await table.answer(Method.get, "/files/a/b"), "files path=a/b");
    test.is(await table.answer(Method.get, "/files"), "list");
    test.is(await table.answer(Method.get, "/files/"), "files path=");
    test.is(await table.answer(Method.get, "/other"), "fallback");
}

async test "a pattern without the method gives way to the next one" {
    let routes is @Route = [
        Route(
            method: Method.post,
            pattern: RoutePattern("/users/me"),
            handling: RouteProbe("update me")
        ),
        Route(method: Method.get, pattern: RoutePattern("/users/:id"), handling: RouteProbe("user")),
        Route(method: Method.get, pattern: RoutePattern("/a/b/c"), handling: RouteProbe("abc")),
        Route(method: Method.get, pattern: RoutePattern("/a/:x/d"), handling: RouteProbe("axd")),
        Route(
            method: Method.head,
            pattern: RoutePattern("/users/:id"),
            handling: RouteProbe("head user")
        ),
        Route(method: Method.get, pattern: RoutePattern("/notes"), handling: RouteProbe("notes")),
        Route(
            method: Method.post,
            pattern: RoutePattern("/notes"),
            handling: RouteProbe("add note")
        ),
    ];
    let table = RouteDispatch(Routes(routes: routes, fallback: RouteProbe("fallback")));
    test.is(await table.answer(Method.get, "/users/me"), "user id=me");
    test.is(await table.answer(Method.post, "/users/me"), "update me");
    test.is(await table.answer(Method.get, "/a/b/d"), "axd x=b");
    test.is(await table.answer(Method.get, "/a/b/c"), "abc");
    test.is(await table.answer(Method.head, "/users/7"), "head user id=7");
    test.is(await table.answer(Method.head, "/notes"), "notes");
    test.is(await table.answer(Method.delete, "/notes"), "405 GET, HEAD, POST");
    test.is(await table.answer(Method.delete, "/users/me"), "405 POST, GET, HEAD");
    test.is(await table.answer(Method.get, "/a/b"), "fallback");
}

test "only routes of one method with one shape are refused" {
    let probe = RouteProbe("x");
    test.is(
        try {
            Routes(
                routes: [
                    Route(method: Method.get, pattern: RoutePattern("/users/:id"), handling: probe),
                    Route(method: Method.get, pattern: RoutePattern("/files/*a"), handling: probe),
                    Route(
                        method: Method.get,
                        pattern: RoutePattern("/users/:name"),
                        handling: probe
                    ),
                ],
                fallback: probe
            );
            "built";
        }
        catch InvalidRoute.because(reason) {
            reason;
        },
        "routes of one method with one shape: GET /users/:id and /users/:name"
    );
    test.throws(InvalidRoute) {
        Routes(
            routes: [
                Route(method: Method.put, pattern: RoutePattern("/files/*a"), handling: probe),
                Route(method: Method.put, pattern: RoutePattern("/files/*b"), handling: probe),
            ],
            fallback: probe
        );
    };
    Routes(
        routes: [
            Route(method: Method.get, pattern: RoutePattern("/users/:id"), handling: probe),
            Route(method: Method.post, pattern: RoutePattern("/users/:name"), handling: probe),
            Route(method: Method.get, pattern: RoutePattern("/users/me"), handling: probe),
            Route(method: Method.get, pattern: RoutePattern("/users/"), handling: probe),
            Route(method: Method.get, pattern: RoutePattern("/files"), handling: probe),
            Route(method: Method.get, pattern: RoutePattern("/files/*rest"), handling: probe),
            Route(method: Method.get, pattern: RoutePattern("/:a/:b"), handling: probe),
            Route(method: Method.get, pattern: RoutePattern("/:a/*b"), handling: probe),
        ],
        fallback: probe
    );
}

async test "a route for every method gives way to the request's own method" {
    let routes is @Route = [
        Route(pattern: RoutePattern("/proxy/*rest"), handling: RouteProbe("proxy")),
        Route(
            method: Method.get,
            pattern: RoutePattern("/proxy/health"),
            handling: RouteProbe("health")
        ),
        Route(pattern: RoutePattern("/notes"), handling: RouteProbe("any note")),
        Route(method: Method.get, pattern: RoutePattern("/notes"), handling: RouteProbe("notes")),
    ];
    let table = RouteDispatch(Routes(routes: routes, fallback: RouteProbe("fallback")));
    test.is(await table.answer(Method.get, "/proxy/health"), "health");
    test.is(await table.answer(Method.post, "/proxy/health"), "proxy rest=health");
    test.is(await table.answer(Method.other("PROPFIND"), "/proxy/a/b"), "proxy rest=a/b");
    test.is(await table.answer(Method.get, "/notes"), "notes");
    test.is(await table.answer(Method.head, "/notes"), "notes");
    test.is(await table.answer(Method.delete, "/notes"), "any note");
    test.is(
        try {
            routes[0].method();
            "a method";
        }
        catch InvalidRoute.because(reason) {
            reason;
        },
        "a route for every method has no one method"
    );
    test.is(routes[0].method_token(), "");
    test.is(routes[1].method_token(), "GET");
    test.throws(InvalidRoute) {
        Routes(
            routes: [
                Route(pattern: RoutePattern("/a/:x"), handling: RouteProbe("a")),
                Route(pattern: RoutePattern("/a/:y"), handling: RouteProbe("b")),
            ],
            fallback: RouteProbe("fallback")
        );
    };
}

async test "a table takes more than 256 routes" {
    let routes is @Route = (0..300).map() -> index {
        Route(
            method: Method.get,
            pattern: RoutePattern("/items/" + index.string() + "/:part"),
            handling: RouteProbe("item " + index.string())
        );
    };
    let table = RouteDispatch(Routes(routes: routes, fallback: RouteProbe("fallback")));
    test.is(await table.answer(Method.get, "/items/0/a"), "item 0 part=a");
    test.is(await table.answer(Method.get, "/items/299/b"), "item 299 part=b");
    test.is(await table.answer(Method.get, "/items/300/b"), "fallback");
}

async test "a table redirects a path to its declared form with or without the final slash" {
    let routes is @Route = [
        Route(method: Method.get, pattern: RoutePattern("/notes"), handling: RouteProbe("notes")),
        Route(
            method: Method.post,
            pattern: RoutePattern("/drafts/"),
            handling: RouteProbe("drafts")
        ),
    ];
    let strict = RouteDispatch(Routes(routes: routes, fallback: RouteProbe("fallback")));
    test.is(await strict.answer(Method.get, "/notes/"), "fallback");
    let table = Routes(
        routes: routes,
        fallback: RouteProbe("fallback"),
        rejection: EmptyRouteRejection(),
        slashes: SlashPolicy.redirect
    );
    let redirecting = RouteDispatch(table);
    test.is(await redirecting.answer(Method.get, "/notes"), "notes");
    test.is(await redirecting.answer(Method.get, "/notes/"), "308 /notes");
    test.is(await redirecting.answer(Method.post, "/drafts"), "308 /drafts/");
    test.is(await redirecting.answer(Method.get, "/other/"), "fallback");
    test.is(await redirecting.answer(Method.get, "/"), "fallback");
}
