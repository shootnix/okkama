module http/client_policy v1.0.0;

// What a client allows itself: limits, timeouts, protocols, connections and
// endpoints.
//
//     HttpClient(
//         limits: HttpLimits(header_bytes: 65536, line_bytes: 8192, body_bytes: BigInt(10485760)),
//         timeouts: ClientTimeouts(connection: Duration(seconds: 5), headers: Duration(seconds: 10), body_idle: Duration(seconds: 10)),
//     );
//
// By default: 64 KiB of header, 8 KiB per line, 1 GiB of body, 30 seconds for
// each timeout, HTTP/1.1, 8 connections and public endpoints only.

import "http/http1_head" take Http1Limits;
import "http/version" take HttpVersion, UnsupportedHttpVersion;
import "http/endpoint" take EndpointAllowing, PublicEndpoints;
import "collections/set" take Set, OrderedSet;
import "numbers/bigint" take BigInt;
import "compare" take Order;
import "time/duration" take Duration, DurationUnit;
import "net/tls" take TlsClientPolicy;

// Explicit, reusable inputs; these objects never resolve or acquire a socket.
object HttpLimits {
    has header_bytes, line_bytes is int;
    has body_bytes is BigInt;

    // 64 KiB of header, 8 KiB per line and 1 GiB of body.
    HttpLimits() {
        header_bytes = 65536;
        line_bytes = 8192;
        body_bytes = BigInt(1073741824);
    }

    // The limits as given; InvalidClientPolicy for ones too small to read a
    // head.
    HttpLimits(header_bytes is int, line_bytes is int, body_bytes is BigInt) {
        confirm header_bytes >= 4
            && header_bytes <= 1048576
            && line_bytes > 0
            && line_bytes <= header_bytes
            && body_bytes.sign() > 0
            && body_bytes.order(BigInt(9007199254740991)) != Order.greater
            else throw InvalidClientPolicy.because("invalid HTTP budgets");
        self.header_bytes = header_bytes;
        self.line_bytes = line_bytes;
        self.body_bytes = body_bytes;
    }

    // Bytes in a whole head.
    header_bytes() is int {
        header_bytes;
    }

    // Bytes in one line of a head.
    line_bytes() is int {
        line_bytes;
    }

    // Bytes in a body read whole.
    body_bytes() is BigInt {
        body_bytes;
    }

    // Once per limits (#503): a server asks for them on every request.
    http1() is Http1Limits {
        once let limits = Http1Limits(
            head_bytes: header_bytes,
            line_bytes: line_bytes,
            fields: 128,
            body_bytes: self.body_amount()
        );
        limits;
    }

    hidden body_amount() is int {
        body_bytes.string().characters().reduce(0) -> count, character {
            count * 10 + character.code() - 48;
        };
    }
}

// How long a client waits.
object ClientTimeouts {
    has connection, headers, body_idle is Duration;

    // 30 seconds for each.
    ClientTimeouts() {
        let interval = Duration(seconds: 30);
        connection = interval;
        headers = interval;
        body_idle = interval;
    }

    // To connect, for the response head, and for each pause in the body.
    ClientTimeouts(connection is Duration, headers is Duration, body_idle is Duration) {
        confirm connection::Span::seconds >= 0.rat()
            && headers::Span::seconds >= 0.rat()
            && body_idle::Span::seconds >= 0.rat()
            else throw InvalidClientPolicy.because("negative deadline");
        self.connection = connection;
        self.headers = headers;
        self.body_idle = body_idle;
    }

    // To connect, TLS included.
    connection_timeout() is Duration {
        connection;
    }

    // From sending to the end of the response head.
    headers_timeout() is Duration {
        headers;
    }

    // For each pause while the body is read.
    body_idle_timeout() is Duration {
        body_idle;
    }
}

// Everything a transport needs besides DNS, TLS and a clock.
object ClientPolicy {
    has protocols is Set<HttpVersion>;
    has limits is HttpLimits;
    has timeouts is ClientTimeouts;
    has connections is int;
    has access is EndpointAllowing;

    // HTTP/1.1, the default limits and timeouts, 8 connections, public
    // endpoints.
    ClientPolicy() {
        let enabled is Set<HttpVersion> = OrderedSet([HttpVersion.http_1_1]);
        protocols = enabled;
        limits = HttpLimits();
        timeouts = ClientTimeouts();
        connections = 8;
        access = PublicEndpoints();
    }

    // The policy as given; InvalidClientPolicy for no protocols or connections
    // out of 1..1024.
    ClientPolicy(
        protocols is Set<HttpVersion>,
        limits is HttpLimits,
        timeouts is ClientTimeouts,
        connections is int,
        access is EndpointAllowing
    ) {
        let count = protocols.size();
        confirm count >= 1 && count <= 3 && connections >= 1 && connections <= 1024
            else throw InvalidClientPolicy.because("invalid protocol or connection count");
        let selected is @HttpVersion = [
            HttpVersion.http_1_0,
            HttpVersion.http_1_1,
            HttpVersion.http_2
        ].filter() -> version {
            protocols.membership(version);
        };
        confirm selected.size() == count
            else throw InvalidClientPolicy.because("inconsistent protocol set");
        let snapshot is Set<HttpVersion> = OrderedSet(selected);
        self.protocols = snapshot;
        self.limits = limits;
        self.timeouts = timeouts;
        self.connections = connections;
        self.access = access;
    }

    // The versions it may speak.
    protocols() is Set<HttpVersion> {
        protocols;
    }

    // The limits.
    limits() is HttpLimits {
        limits;
    }

    // The timeouts.
    timeouts() is ClientTimeouts {
        timeouts;
    }

    // How many connections it keeps at most.
    connections() is int {
        connections;
    }

    // Which endpoints it may reach.
    access() is EndpointAllowing {
        access;
    }
}

// The currently available transport is deliberately selected here. A policy
// value can describe H2, but it cannot silently become an HTTP1 conversation.
object Http1ClientProtocols {
    // Checks that policy and tls agree on HTTP/1.1.
    Http1ClientProtocols(policy is ClientPolicy, tls is TlsClientPolicy) {
        confirm policy.protocols().size() == 1
            && policy.protocols().membership(HttpVersion.http_1_1)
            else throw UnsupportedHttpVersion.unsupported;
        for tls.protocols() -> protocol {
            confirm protocol == "http/1.1" else throw UnsupportedHttpVersion.unsupported;
        }
    }

    // HTTP/1.1; UnsupportedHttpVersion when the policy does not allow it.
    version() is HttpVersion {
        HttpVersion.http_1_1;
    }
}

// A policy that cannot be used; reason says why.
enum InvalidClientPolicy is Error = (because(reason is string));

test "default client policy is explicit and HTTP1-only" {
    let policy = ClientPolicy();
    test.ok(policy.protocols().membership(HttpVersion.http_1_1));
    test.ok(policy.connections() == 8 && policy.limits().http1()::Limits::body_bytes == 1073741824);
}
