module http/proxy_tunnel v1.0.0;

import "http/status" take StatusCode, Status, StatusClass;
import "http/proxy_request" take HttpConnectRequest;
import "http/proxy_policy" take ProxyConnectRejected;
import "http/http1_message_writing" take Http1RequestWriting;
import "http/http1_reading" take Http1ResponseHeadReading, Http1HeadRead;
import "http/http1_head" take Http1ResponseHead, Http1Limits;
import "http/header" take Header;
import "http/message" take InvalidHttpMessage;
import "io/stream" take AsyncReading, AsyncWriting;
import "url/value" take Url;
import "http/media_type" take HttpMediaPosition;

// Borrowed raw halves. Reading one byte at a time avoids consuming a tunnel
// prefix that the native TLS handshake must receive from the same TCP stream.
object HttpProxyTunnel {
    has input is AsyncReading;
    has output is AsyncWriting;
    has target is Url;
    has fields is @Header;
    has limits is Http1Limits;

    HttpProxyTunnel(input is AsyncReading, output is AsyncWriting, target is Url, fields is @Header) {
        self.input = input;
        self.output = output;
        self.target = target;
        self.fields = fields;
        limits = Http1Limits();
    }

    HttpProxyTunnel(
        input is AsyncReading,
        output is AsyncWriting,
        target is Url,
        fields is @Header,
        limits is Http1Limits
    ) {
        self.input = input;
        self.output = output;
        self.target = target;
        self.fields = fields;
        self.limits = limits;
    }

    async ready() is bool {
        let request = HttpConnectRequest(target, fields).request();
        let sending = Http1RequestWriting(output, request, limits).result();
        await sending;
        let information = HttpMediaPosition(0, 0);
        loop {
            let pending = Http1ResponseHeadReading(input, [], limits, 1).result();
            let received = await pending;
            let status = received.head().status();
            let class = StatusCode(status).class();
            if class == StatusClass.successful {
                return true;
            }
            if class == StatusClass.informational && status != Status.switching_protocols {
                confirm information.slots() < 16
                    else throw InvalidHttpMessage.because("proxy informational response limit");
                information = information.separator(0);
                next;
            }
            throw ProxyConnectRejected.status(status);
        }
    }
}
