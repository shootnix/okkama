module http/http1_writing v1.0.0;

import "http/status" take StatusCode;
import "http/http1_head" take Http1RequestHead, Http1ResponseHead, Http1Limits, Http1LimitExceeded;
import "http/http1_framing" take Http1RequestFraming, Http1ResponseFraming;
import "http/header" take Headers;
import "http/method" take Method, MethodName;
import "http/version" take Http1VersionText;
import "io/stream" take AsyncWriting;
import "io/buffer" take ByteBuffer;
import "io/decorators" take ByteSnapshot;
import "encoding/single_byte" take Latin1Encoded, Latin1Decoded;

// Canonical head bytes are fully bounded/validated before a lazy single write.
// Sink is borrowed. Started failure may emit a prefix: discard the session.
object Http1RequestHeadWriting {
    has pending is Future<AsyncWriting>;

    Http1RequestHeadWriting(origin is AsyncWriting, head is Http1RequestHead) {
        pending = Http1HeadOutput().request(origin, head, Http1Limits());
    }

    Http1RequestHeadWriting(origin is AsyncWriting, head is Http1RequestHead, limits is Http1Limits) {
        pending = Http1HeadOutput().request(origin, head, limits);
    }

    output() is Future<AsyncWriting> {
        pending;
    }
}

// The bytes of a head, for a writer that sends the head and a body that is
// already in memory in one write (#115).
object Http1RequestHeadWire {
    has head is Http1RequestHead;
    has limits is Http1Limits;

    Http1RequestHeadWire(head is Http1RequestHead, limits is Http1Limits) {
        self.head = head;
        self.limits = limits;
    }

    bytes() is @byte {
        Http1HeadOutput().request_wire(head, limits);
    }
}

object Http1ResponseHeadWire {
    has head is Http1ResponseHead;
    has method is Method;
    has limits is Http1Limits;

    Http1ResponseHeadWire(head is Http1ResponseHead, method is Method, limits is Http1Limits) {
        self.head = head;
        self.method = method;
        self.limits = limits;
    }

    bytes() is @byte {
        Http1HeadOutput().response_wire(head, method, limits);
    }
}

object Http1ResponseHeadWriting {
    has pending is Future<AsyncWriting>;

    Http1ResponseHeadWriting(origin is AsyncWriting, head is Http1ResponseHead, method is Method) {
        pending = Http1HeadOutput().response(origin, head, method, Http1Limits());
    }

    Http1ResponseHeadWriting(
        origin is AsyncWriting,
        head is Http1ResponseHead,
        method is Method,
        limits is Http1Limits
    ) {
        pending = Http1HeadOutput().response(origin, head, method, limits);
    }

    output() is Future<AsyncWriting> {
        pending;
    }
}

hidden object Http1HeadOutput {
    Http1HeadOutput();

    request(origin is AsyncWriting, head is Http1RequestHead, limits is Http1Limits) is Future<AsyncWriting> {
        self.writing(origin, self.request_wire(head, limits));
    }

    request_wire(head is Http1RequestHead, limits is Http1Limits) is @byte {
        Http1RequestFraming(head: head, limits: limits).plan();
        let start = MethodName(head::Head::method).string() + " " + head.target().string() + " " + Http1VersionText(
            head::Head::version
        ).string();
        // The wire is built from checked parts within the limits; it is not
        // parsed back (#113).
        Http1HeadWire(start: start, fields: head.headers(), limits: limits).bytes();
    }

    response(
        origin is AsyncWriting,
        head is Http1ResponseHead,
        method is Method,
        limits is Http1Limits
    ) is Future<AsyncWriting> {
        self.writing(origin, self.response_wire(head, method, limits));
    }

    response_wire(head is Http1ResponseHead, method is Method, limits is Http1Limits) is @byte {
        Http1ResponseFraming(head: head, method: method, limits: limits).plan();
        let start = Http1VersionText(head::Head::version).string() + " " + StatusCode(head::Head::status).number().string() + " " + StatusCode(
            head::Head::status
        ).phrase();
        Http1HeadWire(start: start, fields: head.headers(), limits: limits).bytes();
    }

    writing(origin is AsyncWriting, wire is @byte) is Future<AsyncWriting> {
        origin.write(ByteSnapshot(wire));
    }
}

// Implementation-only serializer; Request/Response/Head metadata never exposes
// a raw line. Every serialized field uses canonical ': ' and terminating CRLF.
hidden object Http1HeadWire {
    has start is string;
    has fields is Headers;
    has limits is Http1Limits;

    Http1HeadWire(start is string, fields is Headers, limits is Http1Limits) {
        self.start = start;
        self.fields = fields;
        self.limits = limits;
    }

    bytes() is @byte {
        confirm start.length() <= limits::Limits::line_bytes
            else throw Http1LimitExceeded.kind("line_bytes");
        confirm start.length() + 4 <= limits::Limits::head_bytes
            else throw Http1LimitExceeded.kind("head_bytes");
        let entries = fields.entries();
        confirm entries.size() <= limits::Limits::fields else throw Http1LimitExceeded.kind("fields");
        let total = (0..entries.size()).reduce(start.length() + 4) -> used, index {
            let field = entries.item(index);
            let width = field.name().string().length() + field.value().length() + 2;
            confirm width <= limits::Limits::line_bytes else throw Http1LimitExceeded.kind("line_bytes");
            confirm width + 2 <= limits::Limits::head_bytes - used
                else throw Http1LimitExceeded.kind("head_bytes");
            used + width + 2;
        };
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let writer = buffer.writing();
        writer.write(ByteSnapshot(Latin1Encoded(start + "\r\n").bytes()));
        for (0..entries.size()) -> index {
            let field = entries.item(index);
            writer.write(
                ByteSnapshot(
                    Latin1Encoded(field.name().string() + ": " + field.value() + "\r\n").bytes()
                )
            );
        }
        writer.write(ByteSnapshot([13.byte(), 10.byte()]));
        buffer.content().bytes();
    }
}

test "extension response status keeps mandatory reason separator" {
    let wire = Http1HeadWire(start: "HTTP/1.1 299 ", fields: Headers(), limits: Http1Limits()).bytes();
    test.is(Latin1Decoded(wire).string(), "HTTP/1.1 299 \r\n\r\n");
}
