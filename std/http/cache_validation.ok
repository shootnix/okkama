module http/cache_validation v1.0.0;

import "http/status" take StatusCode, Status;
import "http/cache_memory" take CachedHttpEntry, CacheStoredHeaders;
import "http/cache_freshness" take CacheResponseTiming;
import "http/message" take Request, Response;
import "http/exchange" take ClientResponse;
import "http/header" take Headers, Header, HeaderName, HeadersWithout, ReplacedHeader;
import "http/conditional" take ParsedEntityTags, EntityTag;
import "http/date" take ParsedHttpDate, HttpDate;
import "http/cache_control" take CacheControl, CacheDeltaSeconds;
import "time/clock" take MonotonicInstant;
import "compare" take Order;
import "http/media_type" take HttpMediaItems;

// One selected complete variant, conservative received validator matching.
object CacheValidation {
    has original is Request;
    has request is Request;
    has entry is CachedHttpEntry;
    has tags is @EntityTag;
    has modified is @string;

    CacheValidation(original is Request, entry is CachedHttpEntry) {
        self.original = original;
        self.entry = entry;
        let fields = entry.response()::Head::headers;
        let etags = fields.values(HeaderName("ETag"));
        let parsed is @EntityTag = try {
            confirm etags.size() == 1 else throw InvalidCacheRevalidation.invalid;
            let value = ParsedEntityTags(etags.item(0)).tags();
            confirm !value.wildcard() && value.values().size() == 1
                else throw InvalidCacheRevalidation.invalid;
            [value.values().item(0)];
        }
        catch e is Error {
            let empty is @EntityTag = [];
            empty;
        };
        tags = parsed;
        let dates = fields.values(HeaderName("Last-Modified"));
        let dates_checked is @string = try {
            confirm dates.size() == 1 else throw InvalidCacheRevalidation.invalid;
            ParsedHttpDate(dates.item(0), entry.timing().received()).instant();
            [dates.item(0)];
        }
        catch e is Error {
            let empty is @string = [];
            empty;
        };
        modified = dates_checked;
        let conditional = if parsed.size() == 1 {
            ReplacedHeader(
                original::Head::headers,
                Header(HeaderName("If-None-Match"), parsed[0].string())
            ).headers();
        }
        else {
            if dates_checked.size() == 1 {
                ReplacedHeader(
                    original::Head::headers,
                    Header(HeaderName("If-Modified-Since"), dates_checked[0])
                ).headers();
            }
            else {
                original::Head::headers;
            }
        };
        request = Request(
            method: original::Head::method,
            target: original::Head::target,
            headers: conditional,
            body: original.body(),
            version: original::Head::version
        );
    }

    request() is Request {
        request;
    }

    conditional() is bool {
        tags.size() == 1 || modified.size() == 1;
    }

    refreshed(result is ClientResponse, timing is CacheResponseTiming) is CachedHttpEntry {
        confirm self.conditional()
            && result::Head::status == Status.not_modified
            && result::Exchange::history.size() == 0
            && result::Exchange::request::Head::target.string() == request::Head::target.string()
            else throw InvalidCacheRevalidation.invalid;
        let updated = result::Head::headers;
        let etags = updated.values(HeaderName("ETag"));
        confirm etags.size() <= 1 else throw InvalidCacheRevalidation.invalid;
        if etags.size() == 1 {
            let value = ParsedEntityTags(etags.item(0)).tags();
            confirm !value.wildcard() && value.values().size() == 1 && tags.size() == 1
                else throw InvalidCacheRevalidation.invalid;
            let tag = value.values().item(0);
            confirm if tag.weak() {
                tag.weak_matches(tags[0]);
            }
            else {
                tag.strong_matches(tags[0]);
            }
                else throw InvalidCacheRevalidation.invalid;
        }
        else {
            confirm tags.size() == 0 else throw InvalidCacheRevalidation.invalid;
        }
        if tags.size() == 0 && modified.size() == 1 {
            let dates = updated.values(HeaderName("Last-Modified"));
            confirm dates.size() <= 1 else throw InvalidCacheRevalidation.invalid;
            if dates.size() == 1 {
                let changed = try {
                    ParsedHttpDate(dates.item(0), timing.received()).instant();
                }
                catch e is Error {
                    throw InvalidCacheRevalidation.invalid;
                };
                let stored = ParsedHttpDate(modified[0], entry.timing().received()).instant();
                confirm changed.order(stored) == Order.equal
                    else throw InvalidCacheRevalidation.invalid;
            }
        }
        let old = entry.response()::Exchange::response;
        if updated.membership(HeaderName("Content-Encoding")) {
            confirm updated.values(HeaderName("Content-Encoding")).size() == old::Head::headers.values(
                HeaderName("Content-Encoding")
            ).size()
                && updated.first(HeaderName("Content-Encoding")) == old::Head::headers.first(
                    HeaderName("Content-Encoding")
                )
                else throw InvalidCacheRevalidation.invalid;
        }
        let fields = Cache304Fields(old::Head::headers, updated, timing).headers();
        let response = Response(
            status: old::Head::status,
            headers: fields,
            body: old.body(),
            version: old::Head::version
        );
        CachedHttpEntry(
            original,
            ClientResponse(
                request: original,
                response: response,
                details: result::Exchange::details
            ),
            timing,
            entry.bytes(),
            entry.trailers()
        );
    }
}

hidden object Cache304Fields {
    has result is Headers;

    Cache304Fields(stored is Headers, updated is Headers, timing is CacheResponseTiming) {
        let sanitized = CacheStoredHeaders(updated).headers();
        let replacements = if sanitized.membership(HeaderName("Content-Length")) {
            HeadersWithout(sanitized, [HeaderName("Content-Length")]).headers();
        }
        else {
            sanitized;
        };
        let names is @HeaderName = (0..replacements.entries().size()).map() -> index {
            replacements.entries().item(index).name();
        };
        let initial = HeadersWithout(stored, names).headers();
        let fields = CacheMergedFields(initial, replacements).headers();
        let dated = if updated.membership(HeaderName("Date")) {
            fields;
        }
        else {
            ReplacedHeader(fields, Header(HeaderName("Date"), HttpDate(timing.received()).string())).headers();
        };
        result = if updated.membership(HeaderName("Age")) {
            dated;
        }
        else {
            ReplacedHeader(dated, Header(HeaderName("Age"), "0")).headers();
        };
    }

    headers() is Headers {
        result;
    }
}

hidden object CacheMergedFields {
    has result is Headers;

    CacheMergedFields(stored is Headers, updated is Headers) {
        let state = CacheFieldState(stored);
        for updated.entries() -> field {
            state = state.following(field);
        }
        result = state.headers();
    }

    headers() is Headers {
        result;
    }
}

hidden object CacheFieldState {
    has result is Headers;

    CacheFieldState(origin is Headers) {
        result = origin;
    }

    headers() is Headers {
        result;
    }

    following(field is Header) is ^CacheFieldState {
        ^result = result.addition(field);
    }
}

object CacheRequestFreshness {
    has request is Request;
    has entry is CachedHttpEntry;

    CacheRequestFreshness(request is Request, entry is CachedHttpEntry) {
        self.request = request;
        self.entry = entry;
    }

    usable(now is MonotonicInstant) is bool {
        let observed = entry.freshness();
        if !observed.reusable() {
            return false;
        }
        let permitted = try {
            let control = CacheControl(request::Head::headers);
            let age = observed.age(now)::Span::seconds;
            let remaining = observed.lifetime()::Span::seconds - age;
            let required = !control.present("no-cache")
                && !control.present("no-store")
                && (!control.present("max-age") || age <= control.seconds("max-age").rat())
                && (!control.present("min-fresh") || remaining >= control.seconds("min-fresh").rat());
            if !required {
                false;
            }
            else {
                if observed.fresh(now) {
                    true;
                }
                else {
                    let incoming = CacheControl(entry.response()::Head::headers);
                    let arguments = control.arguments("max-stale");
                    control.count("max-stale") == 1
                        && arguments.size() <= 1
                        && !incoming.present("must-revalidate")
                        && !incoming.present("no-cache")
                        && !incoming.present("no-store")
                        && (arguments.size() == 0
                        || age - observed.lifetime()::Span::seconds <= CacheDeltaSeconds(arguments[0]).seconds().rat());
                }
            }
        }
        catch e is Error {
            false;
        };
        permitted;
    }
}

enum InvalidCacheRevalidation is Error = (invalid);
