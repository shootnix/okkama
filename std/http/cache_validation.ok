module http/cache_validation v1.0.0;
import "http/cache_memory" take CachedHttpEntry,CacheStoredHeaders;
import "http/cache_freshness" take CacheResponseTiming;
import "http/message" take Request,Response;
import "http/exchange" take ClientResponse;
import "http/header" take Headers,Header,HeaderName,HeadersWithout,ReplacedHeader;
import "http/conditional" take ParsedEntityTags,EntityTag;
import "http/date" take ParsedHttpDate,HttpDate;
import "http/cache_control" take CacheControl,CacheDeltaSeconds;
import "time/clock" take MonotonicInstant;
import "compare" take Order;
import "http/media_type" take HttpMediaItems;
// One selected complete variant, conservative received validator matching.
object CacheValidation {
    has original is Request;has request is Request;has entry is CachedHttpEntry;has tags is @EntityTag;has modified is @string;
    CacheValidation(original is Request,entry is CachedHttpEntry){
        self.original=original;self.entry=entry;let fields=entry.result().response().headers();let etags=fields.values(HeaderName("ETag"));
        let parsed is @EntityTag=try{confirm etags.size()==1 else throw InvalidCacheRevalidation();let value=ParsedEntityTags(etags.item(0)).value();confirm !value.wildcard() && value.values().size()==1 else throw InvalidCacheRevalidation();[value.values().item(0)];}catch e is Error{let empty is @EntityTag=[];empty;};tags=parsed;
        let dates=fields.values(HeaderName("Last-Modified"));let dates_checked is @string=try{confirm dates.size()==1 else throw InvalidCacheRevalidation();ParsedHttpDate(dates.item(0),entry.timing().received()).value();[dates.item(0)];}catch e is Error{let empty is @string=[];empty;};modified=dates_checked;
        let conditional=if parsed.size()==1{ReplacedHeader(original.headers(),Header(HeaderName("If-None-Match"),parsed[0].string())).result();}else{if dates_checked.size()==1{ReplacedHeader(original.headers(),Header(HeaderName("If-Modified-Since"),dates_checked[0])).result();}else{original.headers();}};
        request=Request(original.method(),original.target(),conditional,original.body(),original.version());
    }
    request() is Request{request;}conditional() is bool{tags.size()==1 || modified.size()==1;}
    refreshed(result is ClientResponse,timing is CacheResponseTiming) is CachedHttpEntry{
        confirm self.conditional() && result.response().status().code()==304 && result.history().size()==0 && result.request().target().string()==request.target().string() else throw InvalidCacheRevalidation();
        let updated=result.response().headers();let etags=updated.values(HeaderName("ETag"));confirm etags.size()<=1 else throw InvalidCacheRevalidation();
        if etags.size()==1{let value=ParsedEntityTags(etags.item(0)).value();confirm !value.wildcard() && value.values().size()==1 && tags.size()==1 else throw InvalidCacheRevalidation();let tag=value.values().item(0);confirm if tag.weak(){tag.weak_matches(tags[0]);}else{tag.strong_matches(tags[0]);} else throw InvalidCacheRevalidation();}
        else{confirm tags.size()==0 else throw InvalidCacheRevalidation();}
        if tags.size()==0 && modified.size()==1{
            let dates=updated.values(HeaderName("Last-Modified"));confirm dates.size()<=1 else throw InvalidCacheRevalidation();
            if dates.size()==1{let changed=try{ParsedHttpDate(dates.item(0),timing.received()).value();}catch e is Error{throw InvalidCacheRevalidation();};let stored=ParsedHttpDate(modified[0],entry.timing().received()).value();confirm changed.order(stored)==Order.equal else throw InvalidCacheRevalidation();}
        }
        let old=entry.result().response();
        if updated.membership(HeaderName("Content-Encoding")){confirm updated.values(HeaderName("Content-Encoding")).size()==old.headers().values(HeaderName("Content-Encoding")).size() && updated.first(HeaderName("Content-Encoding"))==old.headers().first(HeaderName("Content-Encoding")) else throw InvalidCacheRevalidation();}
        let fields=Cache304Fields(old.headers(),updated,timing).result();let response=Response(old.status(),fields,old.body(),old.version());
        CachedHttpEntry(original,ClientResponse(original,response,result.details()),timing,entry.bytes(),entry.trailers());
    }
}
object Cache304Fields {
    has result is Headers;
    Cache304Fields(stored is Headers,updated is Headers,timing is CacheResponseTiming){
        let sanitized=CacheStoredHeaders(updated).result();let replacements=if sanitized.membership(HeaderName("Content-Length")){HeadersWithout(sanitized,[HeaderName("Content-Length")]).result();}else{sanitized;};
        let names is @HeaderName=(0..replacements.entries().size()).map()->index{replacements.entries().item(index).name();};
        let initial=HeadersWithout(stored,names).result();let fields=CacheMergedFields(initial,replacements).result();
        let dated=if updated.membership(HeaderName("Date")){fields;}else{ReplacedHeader(fields,Header(HeaderName("Date"),HttpDate(timing.received()).string())).result();};
        result=if updated.membership(HeaderName("Age")){dated;}else{ReplacedHeader(dated,Header(HeaderName("Age"),"0")).result();};
    }
    result() is Headers{result;}
}
object CacheMergedFields {
    has result is Headers;CacheMergedFields(stored is Headers,updated is Headers){let state=CacheFieldState(stored);for updated.entries() -> field{state=state.following(field);}result=state.result();}result() is Headers{result;}
}
object CacheFieldState {
    has result is Headers;CacheFieldState(origin is Headers){result=origin;}result() is Headers{result;}
    following(field is Header) is ^CacheFieldState{^result=result.addition(field);}
}
object CacheRequestFreshness {
    has request is Request;has entry is CachedHttpEntry;CacheRequestFreshness(request is Request,entry is CachedHttpEntry){self.request=request;self.entry=entry;}
    usable(now is MonotonicInstant) is bool{
        let observed=entry.freshness();if !observed.reusable(){return false;}
        let permitted=try{
            let control=CacheControl(request.headers());let age=observed.age(now).seconds();let remaining=observed.lifetime().seconds()-age;
            let required=!control.present("no-cache") && !control.present("no-store") && (!control.present("max-age") || age<=control.seconds("max-age").rat()) && (!control.present("min-fresh") || remaining>=control.seconds("min-fresh").rat());
            if !required{false;}else{if observed.fresh(now){true;}else{
                let incoming=CacheControl(entry.result().response().headers());let arguments=control.arguments("max-stale");
                control.count("max-stale")==1 && arguments.size()<=1 && !incoming.present("must-revalidate") && !incoming.present("no-cache") && !incoming.present("no-store") && (arguments.size()==0 || age-observed.lifetime().seconds()<=CacheDeltaSeconds(arguments[0]).value().rat());
            }}
        }catch e is Error{false;};permitted;
    }

}
object InvalidCacheRevalidation does Error{InvalidCacheRevalidation();text() is string{"HTTP cache revalidation did not identify the stored representation";}}
