module http/websocket_server v1.0.0;

// Accepting WebSocket upgrades on a server.
//
//     async handling(request is Request, context is HttpRequestContext) is HandlingResult {
//         WebSocketHandlingResult(
//             origin: WebSocketUpgrade(protocols: [], limits: WebSocketLimits(), access: SameOriginWebSockets(), deadline: Duration(seconds: 5)),
//             application: self,
//         );
//     }
//
//     async handle(connection is WebSocketConnection, request is Request, context is HttpRequestContext) is WebSocketHandling {
//         for await connection -> message { await connection.send(message); }
//         self;
//     }
//
// The server must be built with url: so that the Origin can be checked. The
// first protocol of the server's list that the client offers is chosen; no
// extensions are negotiated.

import "http/websocket" take WebSocketConnection, WebSocketLimits, WebSocketFailure;
import "http/websocket_handshake" take WebSocketServerHandshake, WebSocketProtocols;
import "http/websocket_origin" take WebSocketAllowing;
import "http/websocket_session" take WebSocketSession;
import "http/internal/websocket_upgrade" take WebSocketPrefixedInput, WebSocketOpeningCleanup;
import "http/internal/websocket_output" take WebSocketOutputSettlement;
import "http/http1_reading" take Http1HeadRead;
import "http/http1_head" take Http1RequestHead, Http1ResponseHead;
import "http/http1_writing" take Http1ResponseHeadWriting;
import "http/body" take EmptyBody;
import "io/stream" take AsyncReading, AsyncWriting, Closing;
import "url/value" take UrlParts;
import "time/duration" take Duration;
import "time/clock" take Timing;
import "random/source" take SecureRandom;
import "async/scope" take FutureGroup;
import "async/event" take Event;
import "async/timeout" take Within;

// Explicit upgrade policy. Origin approval is mandatory; server preference
// orders subprotocol selection. No extension negotiation is implicit.
object WebSocketUpgrade {
    has protocols is WebSocketProtocols;
    has limits is WebSocketLimits;
    has access is WebSocketAllowing;
    has deadline is Duration;

    // Accepts these protocols in order of preference, within limits, from
    // origins access allows, finishing within deadline.
    WebSocketUpgrade(
        protocols is @string,
        limits is WebSocketLimits,
        access is WebSocketAllowing,
        deadline is Duration
    ) {
        self.protocols = WebSocketProtocols(protocols);
        self.limits = limits;
        self.access = access;
        confirm deadline::Span::seconds > 0.rat()
            else throw WebSocketFailure.because("positive server upgrade deadline required");
        self.deadline = deadline;
    }

    // The protocols, preferred first.
    protocols() is @string {
        protocols.values();
    }

    // The message limits.
    limits() is WebSocketLimits {
        limits;
    }

    // The Origin policy.
    access() is WebSocketAllowing {
        access;
    }

    // How long the handshake may take.
    deadline() is Duration {
        deadline;
    }
}

// Dedicated server consumer adopts one HTTP1 head plus its exact over-read tail
// and the owned transport. The caller keeps the ordinary request handler scope
// separate from the eventual WebSocket application lifetime.
object WebSocketAccepting {
    has waiting is Future<WebSocketSession>;

    // Accepts the upgrade in head on input and output for destination, under
    // upgrade.
    WebSocketAccepting(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        head is Http1HeadRead<Http1RequestHead>,
        destination is UrlParts,
        upgrade is WebSocketUpgrade,
        clock is Timing
    ) {
        let operation = WebSocketServerOpening(
            input: input,
            output: output,
            owner: owner,
            head: head,
            destination: destination,
            upgrade: upgrade,
            clock: clock
        );
        let bounded is Within<WebSocketSession> = Within(
            origin: operation.open(),
            limit: upgrade.deadline(),
            clock: clock
        );
        waiting = bounded.outcome();
    }

    // Checks the Origin, answers 101 and gives the connection; WebSocketFailure
    // when the Origin is denied.
    async connection() is WebSocketConnection {
        let group is FutureGroup<WebSocketSession> = FutureGroup();
        let taken = Event();
        let cleanup = WebSocketOpeningCleanup(group: group, waiting: waiting, taken: taken);
        defer await cleanup.close();
        group.start(waiting);
        let session = await waiting;
        taken.set();
        await session.started();
        session;
    }
}

hidden object WebSocketServerOpening {
    has input is AsyncReading;
    has output is AsyncWriting;
    has owner is Closing;
    has head is Http1HeadRead<Http1RequestHead>;
    has destination is UrlParts;
    has upgrade is WebSocketUpgrade;
    has clock is Timing;

    WebSocketServerOpening(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        head is Http1HeadRead<Http1RequestHead>,
        destination is UrlParts,
        upgrade is WebSocketUpgrade,
        clock is Timing
    ) {
        self.input = input;
        self.output = output;
        self.owner = owner;
        self.head = head;
        self.destination = destination;
        self.upgrade = upgrade;
        self.clock = clock;
    }

    async open() is WebSocketSession {
        let published = Event();
        let cleanup = WebSocketServerUnpublished(owner: owner, published: published);
        defer cleanup.close();
        let request = head.head();
        let handshake = WebSocketServerHandshake(request);
        confirm upgrade.access().allowed(request.request(EmptyBody()), destination)
            else throw WebSocketFailure.because("Origin denied");
        let selected = WebSocketServerProtocol(
            offered: handshake.protocols(),
            supported: upgrade.protocols()
        ).protocol();
        let response = handshake.response(selected);
        let wire = Http1ResponseHead(
            status: response::Head::status,
            headers: response::Head::headers,
            version: response::Head::version
        );
        let pending = Http1ResponseHeadWriting(
            origin: output,
            head: wire,
            method: request::Head::method
        ).output();
        await pending;
        let session = WebSocketSession(
            input: WebSocketPrefixedInput(input, head.remainder()),
            output: output,
            owner: owner,
            client: false,
            random: SecureRandom(),
            limits: upgrade.limits(),
            close_timeout: upgrade.deadline(),
            clock: clock
        );
        published.set();
        session;
    }
}

hidden object WebSocketServerProtocol {
    has offered, supported is @string;

    WebSocketServerProtocol(offered is @string, supported is @string) {
        self.offered = offered;
        self.supported = supported;
    }

    protocol() is string {
        for supported -> protocol {
            if offered.reduce(false) -> found, value {
                found || protocol == value;
            } {
                return protocol;
            }
        }
        "";
    }
}

hidden object WebSocketServerUnpublished {
    has owner is Closing;
    has published is Event;

    WebSocketServerUnpublished(owner is Closing, published is Event) {
        self.owner = owner;
        self.published = published;
    }

    close() is void {
        if !published.ready() {
            owner.close();
        }
    }
}
