module logging/filter v1.0.0;

import "logging/name" take LogName;
import "logging/level" take LogLevel, LogLevelOrder;
import "logging/record" take LogRecord, LogContext;
import "logging/write" take LogWriting, CollectedLogs, DiscardingLogs;
import "collections/sequence" take Sequencing;
import "compare" take Order;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "async/atomic" take Atomic;

role LogAllowing {
    allowed(name is LogName, level is LogLevel) is bool;
}

object LevelOverride {
    has name is LogName;
    has level is LogLevel;

    LevelOverride(name is LogName, level is LogLevel) {
        self.name = name;
        self.level = level;
    }

    name() is LogName {
        name;
    }

    level() is LogLevel {
        level;
    }
}

object LevelThresholds does LogAllowing {
    has fallback is LogLevel;
    has overrides is @LevelOverride;
    // The threshold of each logger name asked about, resolved once (#182).
    has resolved is Atomic<%string:LogLevel>;

    LevelThresholds(fallback is LogLevel, overrides is Sequencing<LevelOverride>) {
        let size = overrides.size();
        confirm size >= 0 && size <= 1024 else throw InvalidLogThreshold.invalid;
        let snapshot is @LevelOverride = (0..size).map() -> index {
            overrides.item(index);
        };
        for (0..size) -> index {
            for (0..index) -> previous {
                confirm snapshot[index].name().order(snapshot[previous].name()) != Order.equal
                    else throw InvalidLogThreshold.invalid;
            }
        }
        self.fallback = fallback;
        self.overrides = snapshot;
        let empty is %string:LogLevel = [:];
        resolved = Atomic(empty);
    }

    // Levels by dotted logger name, the longest name winning:
    // LevelThresholds(fallback: LogLevel.info, overrides: ["shop.db": LogLevel.debug]).
    LevelThresholds(fallback is LogLevel, overrides is %string:LogLevel = [:]) {
        let names = overrides.keys();
        let levels = overrides.values();
        confirm names.size() <= 1024 else throw InvalidLogThreshold.invalid;
        let listed is @LevelOverride = (0..names.size()).map() -> index {
            LevelOverride(name: LogName(names[index].split(".")), level: levels[index]);
        };
        self.fallback = fallback;
        self.overrides = listed;
        let empty is %string:LogLevel = [:];
        resolved = Atomic(empty);
    }

    // A logger's threshold is looked up once per name; at most 4096 names are
    // kept, and the 4097th starts the table afresh.
    allowed(name is LogName, level is LogLevel) is bool {
        let key = name.string();
        let known = resolved.value();
        let threshold = if known.has(key) {
            known[key];
        }
        else {
            let chosen = self.threshold(name);
            let kept is %string:LogLevel = if known.size() >= 4096 {
                [:];
            }
            else {
                known;
            };
            resolved.replace(kept + [key: chosen]);
            chosen;
        };
        LogLevelOrder(left: level, right: threshold).order() != Order.less;
    }

    // The level of the longest override that is a prefix of name.
    hidden threshold(name is LogName) is LogLevel {
        let choice = overrides.reduce(LogThresholdChoice(level: fallback, size: 0)) -> old, override {
            let prefix = override.name().segments();
            let actual = name.segments();
            let matches = if prefix.size() > actual.size() {
                false;
            }
            else {
                (0..prefix.size()).reduce(true) -> same, index {
                    same && prefix.item(index) == actual.item(index);
                };
            };
            if matches && prefix.size() > old.size() {
                LogThresholdChoice(level: override.level(), size: prefix.size());
            }
            else {
                old;
            }
        };
        choice.level();
    }
}

hidden object LogThresholdChoice {
    has level is LogLevel;
    has size is int;

    LogThresholdChoice(level is LogLevel, size is int) {
        self.level = level;
        self.size = size;
    }

    level() is LogLevel {
        level;
    }

    size() is int {
        size;
    }
}

object AllowedLogs does LogWriting {
    has origin is LogWriting;
    has allowing is LogAllowing;

    AllowedLogs(origin is LogWriting, allowing is LogAllowing) {
        self.origin = origin;
        self.allowing = allowing;
    }

    // Records at `level` and above, with other levels for some loggers:
    // AllowedLogs(origin: logs, level: LogLevel.info, overrides: ["shop.db": LogLevel.debug]).
    AllowedLogs(origin is LogWriting, level is LogLevel, overrides is %string:LogLevel = [:]) {
        self.origin = origin;
        allowing = LevelThresholds(fallback: level, overrides: overrides);
    }

    write(record is LogRecord) is void {
        if allowing.allowed(record.context().name(), record::Entry::level) {
            origin.write(record);
        }
    }

    enabled(name is LogName, level is LogLevel) is bool {
        allowing.allowed(name, level) && origin.enabled(name, level);
    }
}

hidden object EnabledLog {
    has origin is LogAllowing;
    has name is LogName;
    has level is LogLevel;

    EnabledLog(origin is LogAllowing, name is LogName, level is LogLevel) {
        self.origin = origin;
        self.name = name;
        self.level = level;
    }

    enabled() is bool {
        origin.allowed(name, level);
    }
}

enum InvalidLogThreshold is Error = (invalid);

test "thresholds: the most specific override wins; allowed logs drop the rest" {
    let thresholds = LevelThresholds(
        fallback: LogLevel.warning,
        overrides: [LevelOverride(name: LogName("app", "db"), level: LogLevel.debug)],
    );
    test.ok(!thresholds.allowed(LogName("app"), LogLevel.info));
    test.ok(thresholds.allowed(LogName("app"), LogLevel.error));
    test.ok(thresholds.allowed(LogName("app", "db"), LogLevel.debug));
    test.ok(thresholds.allowed(LogName("app", "db", "pool"), LogLevel.debug));
    test.ok(!thresholds.allowed(LogName("app", "http"), LogLevel.debug));
    // Asked again, from the resolved table (#182).
    for (0..2) -> round {
        test.ok(!thresholds.allowed(LogName("app"), LogLevel.info));
        test.ok(thresholds.allowed(LogName("app", "db", "pool"), LogLevel.debug));
        test.ok(!thresholds.allowed(LogName("app", "http"), LogLevel.debug));
    }
    let collected = CollectedLogs();
    let allowed = AllowedLogs(origin: collected, allowing: thresholds);
    for [[LogLevel.info, LogLevel.error]] -> pair {
        for pair -> level {
            let name = LogName("app");
            allowed.write(LogRecord(
                occurred: Instant(Duration(seconds: 0)),
                level: level,
                message: "m",
                context: LogContext(name: name, fields: LogFields(), process: 1),
            ));
        }
    }
    test.is(collected.size(), 1);
}

test "thresholds and filters take levels by dotted name" {
    let levels = LevelThresholds(
        fallback: LogLevel.info,
        overrides: ["shop.db": LogLevel.debug, "shop.db.slow": LogLevel.error]
    );
    test.ok(levels.allowed(LogName("shop", "db"), LogLevel.debug));
    test.ok(!levels.allowed(LogName("shop"), LogLevel.debug));
    test.ok(!levels.allowed(LogName("shop", "db", "slow"), LogLevel.warning));
    test.ok(LevelThresholds(fallback: LogLevel.warning).allowed(LogName("any"), LogLevel.error));
    let kept = CollectedLogs();
    let filtered = AllowedLogs(
        origin: kept,
        level: LogLevel.info,
        overrides: ["shop.db": LogLevel.debug]
    );
    for [LogName("shop"), LogName("shop", "db")] -> name {
        filtered.write(LogRecord(
            occurred: Instant(Duration(seconds: 0)),
            level: LogLevel.debug,
            message: "m",
            context: LogContext(name: name, fields: LogFields(), process: 1),
        ));
    }
    test.is(kept.size(), 1);
}

test "allowed logs say which levels pass before a record exists" {
    let logs = AllowedLogs(
        origin: CollectedLogs(),
        level: LogLevel.info,
        overrides: ["shop.db": LogLevel.debug]
    );
    test.ok(!logs.enabled(LogName("shop"), LogLevel.debug));
    test.ok(logs.enabled(LogName("shop"), LogLevel.warning));
    test.ok(logs.enabled(LogName(["shop", "db"]), LogLevel.debug));
    test.ok(
        !AllowedLogs(origin: DiscardingLogs(), level: LogLevel.debug).enabled(
            LogName("shop"),
            LogLevel.error
        )
    );
}
