module logging/name v1.0.0;

// Logger names: dotted segments, `shop.db.pool`.
//
//     LogName("shop", "db").string();
//     ChildLogName(origin: name, segment: "pool").name();

import "collections/sequence" take Sequencing;
import "config/key" take SettingKey, InvalidSettingKey;
import "compare" take Comparing, Order;

// A logger name: dotted segments.
object LogName does Comparing<LogName> {
    has key is SettingKey;

    // The segments; InvalidLogName for an empty one or a dot.
    LogName(segments is Sequencing<string>) {
        key = try {
            SettingKey(segments);
        }
        catch e is InvalidSettingKey {
            throw InvalidLogName.because(e.text());
        };
    }

    // The same, one argument per part: LogName(a, b).
    LogName(segments is ...string) {
        let listed is @string = segments...;
        key = try {
            SettingKey(listed);
        }
        catch e is InvalidSettingKey {
            throw InvalidLogName.because(e.text());
        };
    }

    // The segments.
    segments() is Sequencing<string> {
        key.segments();
    }

    // Joined once per name: thresholds look loggers up by it (#180).
    string() is string {
        once let text = key.string();
        text;
    }

    // Orders segment by segment.
    order(other is LogName) is Order {
        key.order(SettingKey(other.segments()));
    }
}

// A name one segment below another.
object ChildLogName {
    has origin is LogName;
    has segment is string;

    // origin and segment.
    ChildLogName(origin is LogName, segment is string) {
        self.origin = origin;
        self.segment = segment;
    }

    // The name.
    name() is LogName {
        let base = origin.segments();
        let parts is @string = (0..base.size() + 1).map() -> index {
            if index < base.size() {
                base.item(index);
            }
            else {
                segment;
            }
        };
        LogName(parts);
    }
}

// A name that is not valid; reason says why.
enum InvalidLogName is Error = (because(reason is string));

test "a name is dotted segments; a child adds one" {
    let name = LogName("app", "db");
    test.is(name.string(), "app.db");
    test.is(name.segments().size(), 2);
    test.is(ChildLogName(origin: name, segment: "pool").name().string(), "app.db.pool");
    test.ok(LogName("a").order(LogName("b")) == Order.less);
    test.ok(LogName("app") == LogName("app"));
    test.throws(InvalidLogName) {
        LogName();
    };
    test.throws(InvalidLogName) {
        LogName("app", "");
    };
}
