module logging/record v1.0.0;

import "logging/name" take LogName;
import "logging/level" take LogLevel;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "json" take JsonField;
import "time/duration" take Duration, DurationUnit;

object LogContext {
    has origin is LogName;
    has fields is LogFields;
    has process is int;

    LogContext(name is LogName, fields is LogFields, process is int) {
        confirm process >= 0 else throw InvalidLogProcess.invalid;
        origin = name;
        self.fields = fields;
        self.process = process;
    }

    name() is LogName {
        origin;
    }

    fields() is LogFields {
        fields;
    }

    process() is int {
        process;
    }
}

object LogRecord {
    has occurred is Instant;
    has level is LogLevel;
    has message is string;
    has context is LogContext;
    has causes is @Error;

    LogRecord(occurred is Instant, level is LogLevel, message is string, context is LogContext) {
        self.occurred = occurred;
        self.level = level;
        self.message = message;
        self.context = context;
        causes = [];
    }

    LogRecord(
        occurred is Instant,
        level is LogLevel,
        message is string,
        context is LogContext,
        cause is Error
    ) {
        self.occurred = occurred;
        self.level = level;
        self.message = message;
        self.context = context;
        causes = [cause];
    }

    time() is Instant {
        occurred;
    }

    context() is LogContext {
        context;
    }

    has_cause() is bool {
        causes.size() == 1;
    }

    cause() is Error {
        confirm self.has_cause() else throw MissingLogCause.missing;
        causes[0];
    }

    cap Entry {
        level is LogLevel {
            level;
        }

        message is string {
            message;
        }
    }
}

enum MissingLogCause is Error = (missing);

enum InvalidLogProcess is Error = (invalid);

test "a record keeps its moment, level, message, context and optional cause" {
    let context = LogContext(name: LogName("app"), fields: LogFields(JsonField("id", 7)), process: 42);
    let record = LogRecord(occurred: Instant(Duration(seconds: 0)), level: LogLevel.warning, message: "slow", context: context);
    test.ok(record::Entry::level == LogLevel.warning);
    test.is(record::Entry::message, "slow");
    test.is(record.context().process(), 42);
    test.is(record.context().name().string(), "app");
    test.ok(!record.has_cause());
    test.throws(MissingLogCause) {
        record.cause();
    };
    let failed = LogRecord(occurred: Instant(Duration(seconds: 0)), level: LogLevel.error, message: "down", context: context, cause: InvalidLogProcess.invalid);
    test.ok(failed.has_cause());
    test.is(failed.cause().text(), "InvalidLogProcess.invalid");
    test.throws(InvalidLogProcess) {
        LogContext(name: LogName("app"), fields: LogFields(), process: -1);
    };
}
