module logging/line v1.0.0;

import "logging/record" take LogRecord, LogContext, InvalidLogProcess;
import "logging/level" take LogLevelName, LogLevel;
import "json" take Json, JsonField, ParsedJson;
import "time/zone" take TimeZone, FixedZone;
import "time/duration" take Duration, DurationUnit;
import "time/rfc3339" take Rfc3339;
import "encoding/utf" take Utf8Encoded;
import "runtime/unicode_character";
import "logging/field" take LogFields;
import "logging/name" take LogName;
import "time/clock" take Instant;

object TextLogLine {
    has origin is LogRecord;
    has zone is TimeZone;

    TextLogLine(origin is LogRecord, zone is TimeZone) {
        self.origin = origin;
        self.zone = zone;
    }

    string() is string {
        let time = origin.time();
        let context = origin.context();
        let name = BoundedLogJson(Json(context.name().string())).string();
        let message = BoundedLogJson(Json(origin::Entry::message)).string();
        let fields = BoundedLogJson(context.fields().values()).string();
        let cause = if origin.has_cause() {
            " cause=" + BoundedLogJson(Json(origin.cause().text())).string();
        }
        else {
            "";
        };
        PhysicalLogLine(
            Rfc3339(origin: time, offset: zone.offset(time)).string() + " level=" + LogLevelName(origin::Entry::level).string() + " name=" + name + " process=" + context.process().string() + " message=" + message + " fields=" + fields + cause
        ).string();
    }
}

object JsonLogLine {
    has origin is LogRecord;

    JsonLogLine(origin is LogRecord) {
        self.origin = origin;
    }

    string() is string {
        let context = origin.context();
        let members is @JsonField = [
            JsonField(
                "time",
                Rfc3339(origin: origin.time(), offset: Duration(0.rat(), DurationUnit.second)).string()
            ),
            JsonField("level", LogLevelName(origin::Entry::level).string()),
            JsonField("name", context.name().string()),
            JsonField("process", context.process()),
            JsonField("message", origin::Entry::message),
            JsonField("fields", context.fields().values())
        ];
        let complete is @JsonField = if origin.has_cause() {
            (0..members.size() + 1).map() -> index {
                if index < members.size() {
                    members[index];
                }
                else {
                    JsonField("cause", origin.cause().text());
                }
            };
        }
        else {
            members;
        };
        PhysicalLogLine(BoundedLogJson(Json(complete)).string()).string();
    }
}

hidden object BoundedLogJson {
    has origin is Json;

    BoundedLogJson(origin is Json) {
        self.origin = origin;
    }

    // Compact text of at most 34 levels and 1 MiB.
    string() is string {
        let text = origin.string();
        confirm Utf8Encoded(text).bytes().size() <= 1048576 else throw LogLineLimit.exceeded;
        ParsedJson(text, 34).root();
        text;
    }
}

// JSON already escapes C0. Escape remaining terminal controls and Unicode line
// separators without altering quoting, so text and JSON remain one line.
hidden object PhysicalLogLine {
    has origin is string;

    PhysicalLogLine(origin is string) {
        self.origin = origin;
    }

    string() is string {
        confirm origin.length() <= 1048576 else throw LogLineLimit.exceeded;
        if unicode_character.display_invalid_index(origin) < 0 {
            confirm Utf8Encoded(origin).bytes().size() <= 1048576 else throw LogLineLimit.exceeded;
            return origin;
        }
        let digits = "0123456789abcdef";
        let parts is @string = (0..origin.length()).map() -> index {
            let char = origin.slice(index, index + 1);
            let bytes = Utf8Encoded(char).bytes();
            let first = bytes[0].int();
            if first < 32 || first == 127 || (first == 194 && bytes[1].int() < 160) {
                let code = if first == 194 {
                    bytes[1].int();
                }
                else {
                    first;
                };
                let high = (code / 16).int();
                let low = code % 16;
                "\\u00" + digits.slice(high, high + 1) + digits.slice(low, low + 1);
            }
            else if bytes.size() == 3
                && first == 226
                && bytes[1].int() == 128
                && (bytes[2].int() == 168 || bytes[2].int() == 169) {
                    if bytes[2].int() == 168 {
                        "\\u2028";
                    }
                    else {
                        "\\u2029";
                    }
                }
                else {
                    char;
                }
        };
        let result = parts.join("");
        confirm Utf8Encoded(result).bytes().size() <= 1048576 else throw LogLineLimit.exceeded;
        result;
    }
}

enum LogLineLimit is Error = (exceeded);

test "a record is one physical line of text or JSON, quotes escaped" {
    let record = LogRecord(
        occurred: Instant(Duration(value: 1700000000.rat(), unit: DurationUnit.second)),
        level: LogLevel.warning,
        message: "slow \"query\"",
        context: LogContext(name: LogName(["app", "db"]), fields: LogFields([JsonField("ms", 900)]), process: 7),
        cause: InvalidLogProcess.invalid,
    );
    test.is(TextLogLine(origin: record, zone: FixedZone(name: "UTC", offset: Duration(value: 0.rat(), unit: DurationUnit.second))).string(), "2023-11-14T22:13:20Z level=WARNING name=\"app.db\" process=7 message=\"slow \\\"query\\\"\" fields={\"ms\":900} cause=\"InvalidLogProcess.invalid\"");
    test.is(JsonLogLine(record).string(), "{\"time\":\"2023-11-14T22:13:20Z\",\"level\":\"WARNING\",\"name\":\"app.db\",\"process\":7,\"message\":\"slow \\\"query\\\"\",\"fields\":{\"ms\":900},\"cause\":\"InvalidLogProcess.invalid\"}");
}
