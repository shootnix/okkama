module logging/level v1.0.0;
import "compare" take Order;
enum LogLevel=(debug,info,warning,error,critical);
object LogLevelName{
    has origin is LogLevel;
    LogLevelName(origin is LogLevel){self.origin=origin;}
    string() is string{match origin{case LogLevel.debug{"DEBUG";}case LogLevel.info{"INFO";}case LogLevel.warning{"WARNING";}case LogLevel.error{"ERROR";}case LogLevel.critical{"CRITICAL";}}}
}
object LogLevelFromName{
    has origin is string;
    LogLevelFromName(origin is string){self.origin=origin;}
    #projected
    value() is LogLevel{
        confirm origin.length()>0 && origin.length()<=8 else throw InvalidLogLevel(origin);
        let alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZ";let lower="abcdefghijklmnopqrstuvwxyz";
        let parts is @string=(0..origin.length()).map()->index{let char=origin.slice(index,index+1);let split=alphabet.split(char);if split.size()==2{lower.slice(split[0].length(),split[0].length()+1);}else{char;}};
        match parts.join(""){case "debug"{LogLevel.debug;}case "info"{LogLevel.info;}case "warning"{LogLevel.warning;}case "error"{LogLevel.error;}case "critical"{LogLevel.critical;}else{throw InvalidLogLevel(origin);}}}
}
object LogLevelOrder{
    has left,right is LogLevel;
    LogLevelOrder(left is LogLevel,right is LogLevel){self.left=left;self.right=right;}
    #projected
    value() is Order{LogLevelRank(left).value().order(LogLevelRank(right).value());}
}
object LogLevelRank{
    has origin is LogLevel;
    LogLevelRank(origin is LogLevel){self.origin=origin;}
    value() is int{match origin{case LogLevel.debug{0;}case LogLevel.info{1;}case LogLevel.warning{2;}case LogLevel.error{3;}case LogLevel.critical{4;}}}
}
object InvalidLogLevel does Error{
    has origin is string;
    InvalidLogLevel(origin is string){self.origin=origin;}
    text() is string{"invalid log level: "+origin;}
}

test "logging levels have canonical names and a portable severity order" {
    test.is(LogLevelName(LogLevel.info).string(),"INFO");
    test.ok(LogLevelFromName("wArNiNg").value()==LogLevel.warning);
    test.ok(LogLevelOrder(LogLevel.debug,LogLevel.critical).value()==Order.less);
    test.ok(try{LogLevelFromName("trace").value();false;}catch e is InvalidLogLevel{true;});
}
