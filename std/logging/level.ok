module logging/level v1.0.0;

// Log levels, from debug to critical.
//
//     LogLevelFromName("warning").level();             // LogLevel.warning
//     LogLevelName(LogLevel.error).string();           // "ERROR"
//     LogLevelOrder(left: LogLevel.info, right: LogLevel.error).order();   // less

import "compare" take Order;

// How much a record matters.
enum LogLevel = (debug, info, warning, error, critical);

// The name of a level.
object LogLevelName {
    has origin is LogLevel;

    // The level.
    LogLevelName(origin is LogLevel) {
        self.origin = origin;
    }

    // `DEBUG`, `INFO`, `WARNING`, `ERROR` or `CRITICAL`.
    string() is string {
        match origin {
            case LogLevel.debug {
                "DEBUG";
            }
            case LogLevel.info {
                "INFO";
            }
            case LogLevel.warning {
                "WARNING";
            }
            case LogLevel.error {
                "ERROR";
            }
            case LogLevel.critical {
                "CRITICAL";
            }
        }
    }
}

// A level read from its name.
object LogLevelFromName {
    has origin is string;

    // The name.
    LogLevelFromName(origin is string) {
        self.origin = origin;
    }

    // The level; InvalidLogLevel for another name.
    level() is LogLevel {
        confirm origin.length() > 0 && origin.length() <= 8
            else throw InvalidLogLevel.origin(origin);
        let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        let lower = "abcdefghijklmnopqrstuvwxyz";
        let parts is @string = (0..origin.length()).map() -> index {
            let char = origin.slice(index, index + 1);
            let split = alphabet.split(char);
            if split.size() == 2 {
                lower.slice(split[0].length(), split[0].length() + 1);
            }
            else {
                char;
            }
        };
        match parts.join("") {
            case "debug" {
                LogLevel.debug;
            }
            case "info" {
                LogLevel.info;
            }
            case "warning" {
                LogLevel.warning;
            }
            case "error" {
                LogLevel.error;
            }
            case "critical" {
                LogLevel.critical;
            }
            else {
                throw InvalidLogLevel.origin(origin);
            }
        }
    }
}

// Levels compared.
object LogLevelOrder {
    has left, right is LogLevel;

    // left and right.
    LogLevelOrder(left is LogLevel, right is LogLevel) {
        self.left = left;
        self.right = right;
    }

    // less when left matters less than right.
    order() is Order {
        LogLevelRank(left).rank().order(LogLevelRank(right).rank());
    }
}

hidden object LogLevelRank {
    has origin is LogLevel;

    LogLevelRank(origin is LogLevel) {
        self.origin = origin;
    }

    rank() is int {
        match origin {
            case LogLevel.debug {
                0;
            }
            case LogLevel.info {
                1;
            }
            case LogLevel.warning {
                2;
            }
            case LogLevel.error {
                3;
            }
            case LogLevel.critical {
                4;
            }
        }
    }
}

// A name that is not a level.
enum InvalidLogLevel is Error = (origin(origin is string));

test "logging levels have canonical names and a portable severity order" {
    test.is(LogLevelName(LogLevel.info).string(), "INFO");
    test.ok(LogLevelFromName("wArNiNg").level() == LogLevel.warning);
    test.ok(LogLevelOrder(left: LogLevel.debug, right: LogLevel.critical).order() == Order.less);
    test.ok(try {
        LogLevelFromName("trace").level();
        false;
    }
    catch e is InvalidLogLevel {
        true;
    });
}
