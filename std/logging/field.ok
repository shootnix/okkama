module logging/field v1.0.0;
import "collections/sequence" take Sequencing;
import "json" take Json,JsonField,ParsedJson;
import "encoding/utf" take Utf8Encoded;
// Fields form one JSON object of at most 256 members, 32 levels and 1 MiB of
// compact text, checked once at construction; Json values are immutable.
object LogFields{
    has origin is Json;
    LogFields(members is Sequencing<JsonField>){
        let size=members.size();confirm size>=0 && size<=256 else throw InvalidLogField("field count exceeds 256");
        let snapshot is @JsonField=(0..size).map()->index{let item=members.item(index);confirm item.name()!="" && item.name().length()<=4096 else throw InvalidLogField("invalid field name");item;};
        for (0..size)->index{for (0..index)->previous{confirm snapshot[index].name()!=snapshot[previous].name() else throw InvalidLogField("duplicate field name");}}
        let fields=Json(snapshot);
        if size>0{
            let text=fields.string();
            confirm Utf8Encoded(text).bytes().size()<=1048576 else throw InvalidLogField("fields exceed 1 MiB");
            ParsedJson(text,32).value();
        }
        origin=fields;
    }
    membership(name is string) is bool{origin.has(name);}
    value(name is string) is Json{confirm self.membership(name) else throw MissingLogField(name);origin.get(name);}
    values() is Json{origin;}
    members() is @JsonField{origin.fields();}
}
object EmptyLogFields{EmptyLogFields();#projected
    value() is LogFields{LogFields([]);}
}
object CombinedLogFields{
    has base,added is LogFields;
    CombinedLogFields(base is LogFields,added is LogFields){self.base=base;self.added=added;}
    #projected
    value() is LogFields{
        let first=base.members();let second=added.members();
        if second.size()==0{return base;}
        if first.size()==0{return added;}
        let replacements is @JsonField=first.map()->member{if added.membership(member.name()){JsonField(member.name(),added.value(member.name()));}else{member;}};
        let tail is @JsonField=second.filter()->member{!base.membership(member.name());}.map()->member{member;};
        let merged is @JsonField=(0..replacements.size()+tail.size()).map()->index{if index<replacements.size(){replacements[index];}else{tail[index-replacements.size()];}};
        LogFields(merged);
    }
}
object MissingLogField does Error{
    has origin is string;MissingLogField(name is string){origin=name;}
    name() is string{origin;}text() is string{"missing log field: "+origin;}
}
object InvalidLogField does Error{
    has reason is string;InvalidLogField(reason is string){self.reason=reason;}
    text() is string{reason;}
}
