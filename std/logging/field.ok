module logging/field v1.0.0;

import "collections/sequence" take Sequencing;
import "json" take Json, JsonKind, JsonField, ParsedJson, JsonError;
import "encoding/utf" take Utf8Encoded;

// Fields form one JSON object of at most 256 members, 32 levels and 1 MiB of
// compact text, checked once at construction; Json values are immutable.
object LogFields {
    has origin is Json;

    LogFields(members is Sequencing<JsonField>) {
        let size = members.size();
        confirm size >= 0 && size <= 256
            else throw InvalidLogField.because("field count exceeds 256");
        let snapshot is @JsonField = (0..size).map() -> index {
            members.item(index);
        };
        let fields = try {
            Json(snapshot);
        }
        catch JsonError.duplicate_member(_) {
            throw InvalidLogField.because("duplicate field name");
        };
        origin = LogFieldLimits(fields).json();
    }

    LogFields(values is Json) {
        origin = LogFieldLimits(values).json();
    }

    membership(name is string) is bool {
        origin.has(name);
    }

    value(name is string) is Json {
        confirm self.membership(name) else throw MissingLogField.name(name);
        origin.get(name);
    }

    values() is Json {
        origin;
    }

    members() is @JsonField {
        origin.names().map() -> name {
            JsonField(name, origin.get(name));
        };
    }
}

hidden object LogFieldLimits {
    has fields is Json;

    LogFieldLimits(fields is Json) {
        self.fields = fields;
    }

    json() is Json {
        confirm fields.kind() == JsonKind.object_value
            else throw InvalidLogField.because("fields are not an object");
        let names = fields.names();
        confirm names.size() <= 256
            else throw InvalidLogField.because("field count exceeds 256");
        for names -> name {
            confirm name != "" && name.length() <= 4096
                else throw InvalidLogField.because("invalid field name");
        }
        if names.size() > 0 {
            let text = fields.string();
            confirm Utf8Encoded(text).bytes().size() <= 1048576
                else throw InvalidLogField.because("fields exceed 1 MiB");
            ParsedJson(text, 32).root();
        }
        fields;
    }
}

object EmptyLogFields {
    EmptyLogFields();

    fields() is LogFields {
        LogFields([]);
    }
}

object CombinedLogFields {
    has base, added is LogFields;

    CombinedLogFields(base is LogFields, added is LogFields) {
        self.base = base;
        self.added = added;
    }

    fields() is LogFields {
        if added.values().size() == 0 {
            return base;
        }
        if base.values().size() == 0 {
            return added;
        }
        LogFields(base.values().merged(added.values()));
    }
}

enum MissingLogField is Error = (name(name is string));

enum InvalidLogField is Error = (because(reason is string));

test "log fields keep member order, reject bad names and merge by name" {
    let fields = LogFields([JsonField("user", "ann"), JsonField("id", 7), JsonField("pass", "x")]);
    test.is(fields.values().string(), "{\"user\":\"ann\",\"id\":7,\"pass\":\"x\"}");
    test.ok(fields.membership("id") && !fields.membership("nope"));
    test.is(fields.value("user").string(), "\"ann\"");
    test.is(
        try {
            fields.value("nope").string();
        }
        catch failure is MissingLogField {
            failure.text();
        },
        "MissingLogField.name(\"nope\")"
    );
    test.is(EmptyLogFields().fields().values().string(), "{}");
    test.is(
        try {
            LogFields([JsonField("a", 1), JsonField("a", 2)]).values().string();
        }
        catch failure is InvalidLogField {
            failure.text();
        },
        "InvalidLogField.because(\"duplicate field name\")"
    );
    test.is(
        try {
            LogFields([JsonField("", 1)]).values().string();
        }
        catch failure is InvalidLogField {
            failure.text();
        },
        "InvalidLogField.because(\"invalid field name\")"
    );
    let many is @JsonField = (0..257).map() -> index {
        JsonField("k" + index.string(), index);
    };
    test.is(
        try {
            LogFields(many).values().string();
        }
        catch failure is InvalidLogField {
            failure.text();
        },
        "InvalidLogField.because(\"field count exceeds 256\")"
    );
    test.is(
        try {
            LogFields(ParsedJson("[1]").root()).values().string();
        }
        catch failure is InvalidLogField {
            failure.text();
        },
        "InvalidLogField.because(\"fields are not an object\")"
    );
    let added = LogFields([JsonField("id", 8), JsonField("trace", "t1")]);
    test.is(
        CombinedLogFields(base: fields, added: added).fields().values().string(),
        "{\"user\":\"ann\",\"id\":8,\"pass\":\"x\",\"trace\":\"t1\"}"
    );
    test.is(
        CombinedLogFields(base: added, added: fields).fields().values().string(),
        "{\"id\":7,\"trace\":\"t1\",\"user\":\"ann\",\"pass\":\"x\"}"
    );
    test.is(
        CombinedLogFields(base: EmptyLogFields().fields(), added: added).fields().values().string(),
        "{\"id\":8,\"trace\":\"t1\"}"
    );
    test.is(
        CombinedLogFields(base: fields, added: EmptyLogFields().fields()).fields().values().string(),
        fields.values().string()
    );
    test.is(LogFields(fields.members()).values().string(), fields.values().string());
}
