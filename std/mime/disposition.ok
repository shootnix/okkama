module mime/disposition v1.0.0;

import "mime/media_type" take MimeParameters, MimeToken, MimeScanning, InvalidMediaType;

// Eager immutable disposition value using the shared bounded MIME grammar.
// Extension kinds are retained, case-normalized. Filenames remain decoded
// strings: no path conversion, sanitization or filesystem effects.
// string() is a logical field body; see docs/std/mime-disposition.md.
object ContentDisposition {
    has token is string;
    has entries is MimeParameters;

    ContentDisposition(origin is string) {
        let parsed = try {
            MimeScanning(origin, 256, 1048576).disposition();
        }
        catch InvalidMediaType.located(offset, reason) {
            throw InvalidContentDisposition.located(offset, reason);
        };
        token = parsed.type();
        entries = parsed.parameters();
    }

    ContentDisposition(kind is string, parameters is MimeParameters) {
        token = try {
            MimeToken(kind).string();
        }
        catch InvalidMediaType.located(offset, reason) {
            throw InvalidContentDisposition.located(offset, reason);
        };
        entries = parameters;
    }

    ContentDisposition(origin is string, maximum_parameters is int, maximum_bytes is int) {
        let parsed = try {
            MimeScanning(origin, maximum_parameters, maximum_bytes).disposition();
        }
        catch InvalidMediaType.located(offset, reason) {
            throw InvalidContentDisposition.located(offset, reason);
        };
        token = parsed.type();
        entries = parsed.parameters();
    }

    parameters() is MimeParameters {
        entries;
    }

    string() is string {
        token + if entries.entries().size() == 0 {
            "";
        }
        else {
            "; " + entries.string();
        };
    }

    cap Disposition {
        kind is string {
            token;
        }
    }
}

enum InvalidContentDisposition is Error = (located(offset is int, reason is string));

enum MissingContentDisposition is Error = (missing);

test "content disposition retains filename data" {
    test.is(
        ContentDisposition("attachment; filename=report.txt").parameters().first("filename"),
        "report.txt"
    );
}

test "malformed disposition keeps the source offset" {
    let offset = try {
        ContentDisposition("attachment; =x");
        -1;
    }
    catch InvalidContentDisposition.located(offset, _) {
        offset;
    };
    test.is(offset, 12);
}
