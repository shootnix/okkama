module mime/media_type v1.0.0;

import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "encoding/utf" take Utf8Encoded, Utf8Decoded, InvalidUtf8;
import "url/percent" take PercentEncoded, PercentDecoded, UrlComponent, InvalidPercentEncoding;
import "strings/parse" take Number, InvalidInteger;
import "io/buffer" take ByteBuffer;
import "io/decorators" take ByteSnapshot;
import "error" take InvalidArgument;

// Immutable logical parameters and concrete media types. Parsing observes an
// unfolded ASCII field body eagerly; RFC 2231 parts assemble as bytes before
// UTF-8 decoding. Plain duplicates retain order; valid extensions supersede
// fallbacks. Defaults cap input at 1 MiB and 256 wire/source parameters.
// Serialization produces a logical field body; message/header owns folding.
// See docs/std/mime-media-type.md for strict grammar and offset contracts.
object MimeParameter {
    has key, text is string;

    MimeParameter(name is string, value is string) {
        confirm name.split("*").size() == 1
            else throw InvalidMediaType.located(0, "logical parameter name contains asterisk");
        key = MimeToken(name).string();
        let characters = value.characters();
        for (0..characters.size()) -> index {
            let code = characters[index].code();
            confirm code == 9 || (code >= 32 && code != 127)
                else throw InvalidMediaType.located(index, "control in parameter value");
        }
        text = value;
    }

    name() is string {
        key;
    }

    value() is string {
        text;
    }
}

object MimeParameters {
    has origin is @MimeParameter;

    MimeParameters(entries is Sequencing<MimeParameter>) {
        origin = MimeSnapshot(origin: entries, maximum: 256).entries();
    }

    // The same, one argument per part: MimeParameters(a, b).
    MimeParameters(entries is ...MimeParameter) {
        let listed is @MimeParameter = entries...;
        origin = MimeSnapshot(origin: listed, maximum: 256).entries();
    }

    MimeParameters(entries is Sequencing<MimeParameter>, maximum_parameters is int) {
        origin = MimeSnapshot(origin: entries, maximum: maximum_parameters).entries();
    }

    entries() is Sequencing<MimeParameter> {
        origin;
    }

    membership(name is string) is bool {
        let key = MimeToken(name).string();
        origin.reduce(false) -> found, entry {
            found || entry.name() == key;
        };
    }

    first(name is string) is string {
        let key = MimeToken(name).string();
        for origin -> entry {
            if entry.name() == key {
                return entry.value();
            }
        }
        throw MissingMimeParameter.name(key);
    }

    values(name is string) is Sequencing<string> {
        let key = MimeToken(name).string();
        let matching is @MimeParameter = origin.filter() -> entry {
            entry.name() == key;
        };
        let values is @string = matching.map() -> entry {
            entry.value();
        };
        values;
    }

    string() is string {
        let parts is @string = origin.map() -> entry {
            let value = entry.value();
            let bytes = Utf8Encoded(value).bytes();
            if bytes.size() != value.length() {
                entry.name() + "*=UTF-8''" + PercentEncoded(
                    origin: value,
                    component: UrlComponent.data
                ).string();
            }
            else {
                let tokens = MimeTokenCodes();
                let valid = value.characters().reduce(true) -> valid, character {
                    valid && tokens.token(character.code());
                };
                let token = value.length() > 0 && valid;
                let quoted = if token {
                    value;
                }
                else {
                    "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
                };
                entry.name() + "=" + quoted;
            }
        };
        parts.join("; ");
    }
}

object MediaType {
    has major, minor is string;
    has entries is MimeParameters;

    MediaType(origin is string) {
        let parsed = MimeScanning(origin: origin, maximum_parameters: 256, maximum_bytes: 1048576).media_type();
        major = parsed.type();
        minor = parsed.subtype();
        entries = parsed.parameters();
    }

    MediaType(origin is string, limits is MediaTypeLimits) {
        let parsed = MimeScanning(
            origin: origin,
            maximum_parameters: limits::Limits::parameters,
            maximum_bytes: limits::Limits::bytes
        ).media_type();
        major = parsed.type();
        minor = parsed.subtype();
        entries = parsed.parameters();
    }

    MediaType(type is string, subtype is string, parameters is MimeParameters) {
        confirm type != "*" && subtype != "*"
            else throw InvalidMediaType.located(0, "wildcard is not a concrete media type");
        major = MimeToken(type).string();
        minor = MimeToken(subtype).string();
        entries = parameters;
    }

    parameters() is MimeParameters {
        entries;
    }

    string() is string {
        major + "/" + minor + if entries.entries().size() == 0 {
            "";
        }
        else {
            "; " + entries.string();
        };
    }

    cap Type {
        type is string {
            major;
        }

        subtype is string {
            minor;
        }
    }
}

enum InvalidMediaType is Error = (located(offset is int, reason is string));

enum MissingMimeParameter is Error = (name(name is string));

enum MimeLimitExceeded is Error = (kind(kind is string));

object MediaTypeLimits {
    has maximum_parameters, maximum_bytes is int;

    MediaTypeLimits(parameters is int, bytes is int) {
        confirm parameters >= 0 && bytes >= 0
            else throw InvalidArgument.because("MIME limits must be nonnegative");
        maximum_parameters = parameters;
        maximum_bytes = bytes;
    }

    cap Limits {
        parameters is int {
            maximum_parameters;
        }

        bytes is int {
            maximum_bytes;
        }
    }
}

// Importable lexer, bounded snapshots and RFC 2231 assembly collaborators.
object MimeCharacter {
    has origin is string;

    MimeCharacter(origin is string) {
        self.origin = origin;
    }

    token() is bool {
        let bytes = Utf8Encoded(origin).bytes();
        bytes.size() == 1 && MimeTokenCodes().token(bytes[0].int());
    }
}

// RFC 2045 token characters by code (#161): visible ASCII except the
// tspecials ( ) < > @ , ; : \ " / [ ] ? =. A character outside ASCII is never
// one.
hidden object MimeTokenCodes {
    MimeTokenCodes();

    token(code is int) is bool {
        code >= 33
            && code <= 126
            && code != 40
            && code != 41
            && code != 60
            && code != 62
            && code != 64
            && code != 44
            && code != 59
            && code != 58
            && code != 92
            && code != 34
            && code != 47
            && code != 91
            && code != 93
            && code != 63
            && code != 61;
    }
}

object MimeToken {
    has text is string;

    MimeToken(origin is string) {
        confirm origin != "" else throw InvalidMediaType.located(0, "empty token");
        let tokens = MimeTokenCodes();
        let characters = origin.characters();
        for (0..characters.size()) -> index {
            confirm tokens.token(characters[index].code())
                else throw InvalidMediaType.located(index, "invalid token");
        }
        let bytes is @byte = Utf8Encoded(origin).bytes().map() -> octet {
            let code = octet.int();
            if code >= 65 && code <= 90 {
                (code + 32).byte();
            }
            else {
                octet;
            }
        };
        text = Utf8Decoded(bytes).string();
    }

    string() is string {
        text;
    }
}

hidden object MimeSnapshot {
    has origin is Sequencing<MimeParameter>;
    has maximum is int;

    MimeSnapshot(origin is Sequencing<MimeParameter>, maximum is int) {
        confirm maximum >= 0
            else throw InvalidArgument.because("MIME parameter limit must be nonnegative");
        self.origin = origin;
        self.maximum = maximum;
    }

    entries() is @MimeParameter {
        let count = origin.size();
        confirm count >= 0
            else throw InvalidArgument.because("MIME source size must be nonnegative");
        confirm count <= maximum else throw MimeLimitExceeded.kind("parameters");
        let entries is @MimeParameter = (0..count).map() -> index {
            origin.item(index);
        };
        entries;
    }
}

object MimeItems<T> {
    has reversed is List<T>;

    MimeItems() {
        let empty is List<T> = EmptyList();
        reversed = empty;
    }

    size() is int {
        reversed.size();
    }

    following(item is T) is ^MimeItems<T> {
        ^reversed = reversed.prefix(item);
    }

    entries() is @T {
        let reverse is @T = reversed.map() -> item {
            item;
        };
        let ordered is @T = (0..reverse.size()).map() -> index {
            reverse[reverse.size() - index - 1];
        };
        ordered;
    }
}

object MimePosition {
    has index is int;

    MimePosition(index is int) {
        self.index = index;
    }

    index() is int {
        index;
    }

    following(index is int) is ^MimePosition {
        ^index = index;
    }
}

hidden object MimeScanned {
    has text is string;
    has end is int;

    MimeScanned(text is string, end is int) {
        self.text = text;
        self.end = end;
    }

    text() is string {
        text;
    }

    end() is int {
        end;
    }
}

object MimeParsed {
    has major, minor is string;
    has entries is MimeParameters;

    MimeParsed(type is string, subtype is string, entries is MimeParameters) {
        major = type;
        minor = subtype;
        self.entries = entries;
    }

    type() is string {
        major;
    }

    subtype() is string {
        minor;
    }

    parameters() is MimeParameters {
        entries;
    }
}

object MimeScanning {
    has origin is string;
    has maximum_parameters, maximum_bytes is int;

    MimeScanning(origin is string, maximum_parameters is int, maximum_bytes is int) {
        confirm maximum_parameters >= 0 && maximum_bytes >= 0
            else throw InvalidArgument.because("MIME limits must be nonnegative");
        self.origin = origin;
        self.maximum_parameters = maximum_parameters;
        self.maximum_bytes = maximum_bytes;
    }

    media_type() is MimeParsed {
        self.validate();
        let major = self.token(self.space(0));
        let slash = self.space(major.end());
        confirm slash < origin.length() && self.codes()[slash].int() == 47
            else throw InvalidMediaType.located(slash, "missing subtype separator");
        let minor = self.token(self.space(slash + 1));
        confirm major.text() != "*" && minor.text() != "*"
            else throw InvalidMediaType.located(0, "wildcard is not a concrete media type");
        MimeParsed(
            type: MimeToken(major.text()).string(),
            subtype: MimeToken(minor.text()).string(),
            entries: self.parameters(minor.end())
        );
    }

    disposition() is MimeParsed {
        self.validate();
        let kind = self.token(self.space(0));
        MimeParsed(
            type: MimeToken(kind.text()).string(),
            subtype: "",
            entries: self.parameters(kind.end())
        );
    }

    // The field body's bytes, once (#161). validate() keeps them ASCII, so a
    // byte is a character and its index the character's.
    hidden codes() is @byte {
        once let bytes = Utf8Encoded(origin).bytes();
        bytes;
    }

    hidden tokens() is MimeTokenCodes {
        once let codes = MimeTokenCodes();
        codes;
    }

    hidden validate() is void {
        let codes = self.codes();
        confirm origin.length() <= maximum_bytes && codes.size() <= maximum_bytes
            else throw MimeLimitExceeded.kind("bytes");
        // Every character before the first offending byte is ASCII, so the
        // byte's index is the character's.
        for (0..codes.size()) -> index {
            let code = codes[index].int();
            confirm code == 9 || (code >= 32 && code <= 126)
                else throw InvalidMediaType.located(index, "expected unfolded ASCII field body");
        }
    }

    hidden parameters(start is int) is MimeParameters {
        let codes = self.codes();
        let position = MimePosition(self.space(start));
        let raw is MimeItems<MimeWireParameter> = MimeItems();
        loop {
            let index = position.index();
            last if index == origin.length();
            confirm codes[index].int() == 59
                else throw InvalidMediaType.located(index, "expected parameter separator");
            confirm raw.size() < maximum_parameters else throw MimeLimitExceeded.kind("parameters");
            let start = self.space(index + 1);
            let name = self.token(start);
            let equals = self.space(name.end());
            confirm equals < origin.length() && codes[equals].int() == 61
                else throw InvalidMediaType.located(equals, "missing parameter assignment");
            let at = self.space(equals + 1);
            let value = if at < origin.length() && codes[at].int() == 34 {
                self.quoted(at);
            }
            else {
                self.token(at);
            };
            raw = raw.following(
                MimeWireParameter(
                    name: name.text(),
                    value: value.text(),
                    offset: start,
                    maximum_sections: maximum_parameters
                )
            );
            position = position.following(self.space(value.end()));
        }
        MimeAssembly(origin: raw.entries(), maximum: maximum_parameters).parameters();
    }

    hidden space(start is int) is int {
        let codes = self.codes();
        let position = MimePosition(start);
        loop {
            let index = position.index();
            if index == codes.size() {
                return index;
            }
            let code = codes[index].int();
            if code != 32 && code != 9 {
                return index;
            }
            position = position.following(index + 1);
        }
    }

    hidden token(start is int) is MimeScanned {
        let codes = self.codes();
        let tokens = self.tokens();
        let position = MimePosition(start);
        loop {
            let index = position.index();
            last if index == codes.size() || !tokens.token(codes[index].int());
            position = position.following(index + 1);
        }
        confirm position.index() > start
            else throw InvalidMediaType.located(start, "expected token");
        MimeScanned(text: origin.slice(start, position.index()), end: position.index());
    }

    // The text between the quotes is copied in runs; a quoted pair ends a
    // run, and its escaped byte starts the next one.
    hidden quoted(start is int) is MimeScanned {
        let codes = self.codes();
        let position = MimePosition(start + 1);
        let run = MimePosition(start + 1);
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let writer = buffer.writing();
        loop {
            let index = position.index();
            confirm index < codes.size()
                else throw InvalidMediaType.located(start, "unterminated quoted string");
            let code = codes[index].int();
            if code == 34 {
                if index > run.index() {
                    writer.write(ByteSnapshot(codes.slice(run.index(), index)));
                }
                return MimeScanned(
                    text: Utf8Decoded(buffer.content().bytes()).string(),
                    end: index + 1
                );
            }
            if code == 92 {
                confirm codes.size() - index >= 2
                    else throw InvalidMediaType.located(index, "unfinished quoted pair");
                if index > run.index() {
                    writer.write(ByteSnapshot(codes.slice(run.index(), index)));
                }
                run = run.following(index + 1);
                position = position.following(index + 2);
            }
            else {
                position = position.following(index + 1);
            }
        }
    }
}

hidden object MimeWireParameter {
    has key, text is string;
    has number, position is int;
    has encoded is bool;

    MimeWireParameter(name is string, value is string, offset is int, maximum_sections is int) {
        let parts = name.split("*");
        confirm parts.size() <= 3
            else throw InvalidMediaType.located(offset, "invalid continuation name");
        key = try {
            MimeToken(parts[0]).string();
        }
        catch failure is InvalidMediaType {
            throw InvalidMediaType.located(offset, "invalid parameter name");
        };
        text = value;
        position = offset;
        if parts.size() == 1 {
            number = -2;
            encoded = false;
        }
        else if parts.size() == 2 && parts[1] == "" {
            number = -1;
            encoded = true;
        }
        else {
            let digits = parts[1];
            confirm digits.length() > 0
                && digits.length() <= maximum_sections.string().length()
                && (digits.length() == 1 || digits.slice(0, 1) != "0")
                else throw InvalidMediaType.located(offset, "invalid continuation index");
            let valid = digits.characters().reduce(true) -> valid, character {
                valid && character.code() >= 48 && character.code() <= 57;
            };
            confirm valid && (parts.size() == 2 || parts[2] == "")
                else throw InvalidMediaType.located(offset, "invalid continuation index");
            let parsed = try {
                Number(digits).int();
            }
            catch failure is InvalidInteger {
                throw InvalidMediaType.located(offset, "invalid continuation index");
            };
            confirm parsed < maximum_sections
                else throw InvalidMediaType.located(
                    offset,
                    "continuation index exceeds section bound"
                );
            number = parsed;
            encoded = parts.size() == 3;
        }
    }

    name() is string {
        key;
    }

    value() is string {
        text;
    }

    section() is int {
        number;
    }

    encoded() is bool {
        encoded;
    }

    offset() is int {
        position;
    }
}

hidden object MimeAssembly {
    has origin is @MimeWireParameter;
    has maximum is int;

    MimeAssembly(origin is @MimeWireParameter, maximum is int) {
        self.origin = origin;
        self.maximum = maximum;
    }

    parameters() is MimeParameters {
        let output is MimeItems<MimeParameter> = MimeItems();
        for (0..origin.size()) -> index {
            let entry = origin[index];
            let group is @MimeWireParameter = origin.filter() -> other {
                other.name() == entry.name();
            };
            let extended is @MimeWireParameter = group.filter() -> other {
                other.section() != -2;
            };
            if extended.size() == 0 {
                output = output.following(MimeParameter(name: entry.name(), value: entry.value()));
            }
            else {
                let prior = (0..index).reduce(false) -> found, position {
                    found || origin[position].name() == entry.name();
                };
                if !prior {
                    output = output.following(
                        MimeParameter(name: entry.name(), value: MimeExtended(extended).string())
                    );
                }
            }
        }
        MimeParameters(entries: output.entries(), maximum_parameters: maximum);
    }
}

hidden object MimeExtended {
    has origin is @MimeWireParameter;

    MimeExtended(origin is @MimeWireParameter) {
        self.origin = origin;
    }

    string() is string {
        let offset = origin[0].offset();
        let single is @MimeWireParameter = origin.filter() -> part {
            part.section() == -1;
        };
        confirm single.size() == 0 || (single.size() == 1 && origin.size() == 1)
            else throw InvalidMediaType.located(offset, "conflicting extended parameters");
        let ordered is @MimeWireParameter = if single.size() == 1 {
            single;
        }
        else {
            let parts is @MimeWireParameter = (0..origin.size()).map() -> index {
                let matches is @MimeWireParameter = origin.filter() -> part {
                    part.section() == index;
                };
                confirm matches.size() == 1
                    else throw InvalidMediaType.located(
                        offset,
                        "duplicate or missing continuation index"
                    );
                matches[0];
            };
            parts;
        };
        let initial = ordered[0];
        let prefix = MimeCharset(
            origin: initial.value(),
            encoded: initial.encoded(),
            offset: initial.offset()
        );
        let output = ByteBuffer();
        defer output.closing().close();
        let writer = output.writing();
        for (0..ordered.size()) -> index {
            let part = ordered[index];
            let text = if index == 0 {
                prefix.name();
            }
            else {
                part.value();
            };
            let bytes = if part.encoded() {
                MimeExtendedBytes(origin: text, offset: part.offset()).bytes();
            }
            else {
                Utf8Encoded(text).bytes();
            };
            writer.write(ByteSnapshot(bytes));
        }
        let bytes = output.content().bytes();
        if prefix.charset() != "utf-8" {
            let ascii = bytes.reduce(true) -> valid, octet {
                valid && octet.int() < 128;
            };
            confirm ascii
                else throw InvalidMediaType.located(offset, "non-ASCII bytes without UTF-8 charset");
        }
        let decoded = try {
            Utf8Decoded(bytes).string();
        }
        catch failure is InvalidUtf8 {
            throw InvalidMediaType.located(offset, "invalid extended UTF-8");
        };
        for decoded.characters() -> character {
            let code = character.code();
            confirm code == 9 || (code >= 32 && code != 127)
                else throw InvalidMediaType.located(offset, "control in extended value");
        }
        decoded;
    }
}

hidden object MimeCharset {
    has encoding, text is string;

    MimeCharset(origin is string, encoded is bool, offset is int) {
        if !encoded {
            encoding = "";
            text = origin;
        }
        else {
            let parts = origin.split("'");
            confirm parts.size() == 3
                else throw InvalidMediaType.located(
                    offset,
                    "extended value requires charset and language delimiters"
                );
            let charset = if parts[0] == "" {
                "";
            }
            else {
                try {
                    MimeToken(parts[0]).string();
                }
                catch failure is InvalidMediaType {
                    throw InvalidMediaType.located(offset, "invalid parameter charset");
                }
            };
            confirm charset == "" || charset == "utf-8" || charset == "us-ascii"
                else throw InvalidMediaType.located(offset, "unsupported parameter charset");
            let language = parts[1];
            let valid = language.characters().reduce(true) -> valid, character {
                let code = character.code();
                valid
                    && ((code >= 65 && code <= 90)
                    || (code >= 97 && code <= 122)
                    || (code >= 48 && code <= 57)
                    || code == 45);
            };
            confirm valid else throw InvalidMediaType.located(offset, "invalid parameter language");
            encoding = charset;
            text = parts[2];
        }
    }

    charset() is string {
        encoding;
    }

    name() is string {
        text;
    }
}

hidden object MimeExtendedBytes {
    has origin is string;
    has offset is int;

    MimeExtendedBytes(origin is string, offset is int) {
        self.origin = origin;
        self.offset = offset;
    }

    bytes() is @byte {
        let tokens = MimeTokenCodes();
        for origin.characters() -> character {
            let code = character.code();
            confirm (code == 37 || tokens.token(code)) && code != 42 && code != 39
                else throw InvalidMediaType.located(offset, "invalid extended parameter character");
        }
        try {
            PercentDecoded(origin).bytes();
        }
        catch failure is InvalidPercentEncoding {
            throw InvalidMediaType.located(offset, "invalid extended percent escape");
        }
    }
}

test "media type case and extended value are explicit" {
    let value = MediaType("Text/Plain; title*=UTF-8''caf%C3%A9");
    test.is(value::Type::type, "text");
    test.is(value.parameters().first("TITLE"), "café");
}

test "a quoted string keeps escaped characters and spaces" {
    let value = MediaType("multipart/mixed; boundary=\"a \\\"b\\\\ c\"");
    test.is(value.parameters().first("boundary"), "a \"b\\ c");
    test.is(MediaType("text/plain; name=\"\"").parameters().first("name"), "");
}

test "a parse failure names the offset of what is wrong" {
    let outside = try {
        MediaType("text/plаin");
        -1;
    }
    catch InvalidMediaType.located(at, _reason) {
        at;
    };
    test.is(outside, 7);
    let assignment = try {
        MediaType("text/plain; na(me=x");
        -1;
    }
    catch InvalidMediaType.located(at, _reason) {
        at;
    };
    test.is(assignment, 14);
    let unterminated = try {
        MediaType("text/plain; name=\"open");
        -1;
    }
    catch InvalidMediaType.located(at, _reason) {
        at;
    };
    test.is(unterminated, 17);
}

test "a parameter value holds any text but controls" {
    test.is(MimeParameter("title", "привет").value(), "привет");
    let control = try {
        MimeParameter("title", "при" + 1.char().string() + "вет");
        -1;
    }
    catch InvalidMediaType.located(at, _reason) {
        at;
    };
    test.is(control, 3);
    test.is(
        MediaType("text/plain; title*=UTF-8'ru'%D0%BC%D0%B8%D1%80").parameters().first("title"),
        "мир"
    );
    test.ok(
        try {
            MediaType("text/plain; title*=UTF-8'r_u'x");
            false;
        }
        catch e is InvalidMediaType {
            true;
        }
    );
    test.is(MimeToken("Text-Plain").string(), "text-plain");
    test.ok(
        MimeCharacter("a").token() && !MimeCharacter("/").token() && !MimeCharacter("ж").token()
    );
}
