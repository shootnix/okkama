module mime/transfer v1.0.0;

import "io/stream" take ByteSource;
import "io/decorators" take ByteSnapshot;
import "io/buffer" take ByteBuffer;
import "encoding/base64" take Base64Encoded, Base64Decoded, InvalidBase64;
import "encoding/quoted_printable" take QuotedPrintableEncoded, QuotedPrintableDecoded,
    InvalidQuotedPrintable;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "error" take InvalidArgument;

// Deferred, borrowed ByteSource views. Each observation reads the source once;
// no source is closed, cached or normalized. See docs/std/mime-transfer.md.
enum TransferEncoding = (seven_bit, eight_bit, binary, base64, quoted_printable);

object TransferEncodedBody does ByteSource {
    has origin is ByteSource;
    has encoding is TransferEncoding;
    has maximum is int;

    TransferEncodedBody(origin is ByteSource, encoding is TransferEncoding) {
        self.origin = origin;
        self.encoding = encoding;
        maximum = 16777216;
    }

    TransferEncodedBody(origin is ByteSource, encoding is TransferEncoding, maximum_bytes is int) {
        confirm maximum_bytes >= 0
            else throw InvalidArgument.because("transfer byte limit must be nonnegative");
        self.origin = origin;
        self.encoding = encoding;
        maximum = maximum_bytes;
    }

    bytes() is @byte {
        let snapshot = origin.bytes();
        confirm snapshot.size() <= maximum else throw TransferLimitExceeded.kind("input");
        let result is @byte = if encoding == TransferEncoding.base64 {
            MimeBase64Encoded(snapshot).bytes();
        }
        else {
            if encoding == TransferEncoding.quoted_printable {
                QuotedPrintableEncoded(snapshot).bytes();
            }
            else {
                TransferProfile(origin: snapshot, encoding: encoding).bytes();
            }
        };
        confirm result.size() <= maximum else throw TransferLimitExceeded.kind("output");
        result;
    }
}

object TransferDecodedBody does ByteSource {
    has origin is ByteSource;
    has encoding is TransferEncoding;
    has maximum is int;

    TransferDecodedBody(origin is ByteSource, encoding is TransferEncoding) {
        self.origin = origin;
        self.encoding = encoding;
        maximum = 16777216;
    }

    TransferDecodedBody(origin is ByteSource, encoding is TransferEncoding, maximum_bytes is int) {
        confirm maximum_bytes >= 0
            else throw InvalidArgument.because("transfer byte limit must be nonnegative");
        self.origin = origin;
        self.encoding = encoding;
        maximum = maximum_bytes;
    }

    bytes() is @byte {
        let snapshot = origin.bytes();
        confirm snapshot.size() <= maximum else throw TransferLimitExceeded.kind("input");
        let result is @byte = if encoding == TransferEncoding.base64 {
            MimeBase64Decoded(snapshot).bytes();
        }
        else {
            if encoding == TransferEncoding.quoted_printable {
                try {
                    QuotedPrintableDecoded(snapshot).bytes();
                }
                catch InvalidQuotedPrintable.at(offset) {
                    throw InvalidTransferEncoding.located(offset, "invalid quoted-printable");
                }
            }
            else {
                TransferProfile(origin: snapshot, encoding: encoding).bytes();
            }
        };
        confirm result.size() <= maximum else throw TransferLimitExceeded.kind("output");
        result;
    }
}

enum InvalidTransferEncoding is Error = (located(offset is int, reason is string));

enum TransferLimitExceeded is Error = (kind(kind is string));

hidden object TransferPosition {
    has index is int;

    TransferPosition(index is int) {
        self.index = index;
    }

    index() is int {
        index;
    }

    following(index is int) is ^TransferPosition {
        ^index = index;
    }
}

hidden object TransferProfile {
    has origin is @byte;
    has encoding is TransferEncoding;

    TransferProfile(origin is @byte, encoding is TransferEncoding) {
        self.origin = origin;
        self.encoding = encoding;
    }

    bytes() is @byte {
        if encoding == TransferEncoding.binary {
            return origin;
        }
        let line = TransferPosition(0);
        for (0..origin.size()) -> index {
            let code = origin[index].int();
            confirm code != 0
                else throw InvalidTransferEncoding.located(index, "NUL outside binary profile");
            confirm encoding != TransferEncoding.seven_bit || code <= 127
                else throw InvalidTransferEncoding.located(index, "byte outside seven-bit profile");
            if code == 13 {
                confirm index + 1 < origin.size() && origin[index + 1].int() == 10
                    else throw InvalidTransferEncoding.located(index, "bare CR");
            }
            else {
                if code == 10 {
                    confirm index > 0 && origin[index - 1].int() == 13
                        else throw InvalidTransferEncoding.located(index, "bare LF");
                    line = line.following(index + 1);
                }
                else {
                    confirm index - line.index() < 998
                        else throw InvalidTransferEncoding.located(index, "line exceeds 998 bytes");
                }
            }
        }
        origin;
    }
}

hidden object MimeBase64Encoded {
    has origin is @byte;

    MimeBase64Encoded(origin is @byte) {
        self.origin = origin;
    }

    bytes() is @byte {
        let encoded = Base64Encoded(origin).string();
        let count = ((encoded.length() + 75) / 76).int();
        let lines is @string = (0..count).map() -> index {
            let end = if (index + 1) * 76 < encoded.length() {
                (index + 1) * 76;
            }
            else {
                encoded.length();
            };
            encoded.slice(index * 76, end);
        };
        Utf8Encoded(lines.join("\r\n")).bytes();
    }
}

hidden object MimeBase64Decoded {
    has origin is @byte;

    MimeBase64Decoded(origin is @byte) {
        self.origin = origin;
    }

    bytes() is @byte {
        let buffer = ByteBuffer();
        defer buffer.closing().close();
        let line = TransferPosition(0);
        for (0..origin.size()) -> index {
            let code = origin[index].int();
            if code == 13 {
                confirm index + 1 < origin.size() && origin[index + 1].int() == 10
                    else throw InvalidTransferEncoding.located(index, "bare CR");
            }
            else {
                if code == 10 {
                    confirm index > 0 && origin[index - 1].int() == 13
                        else throw InvalidTransferEncoding.located(index, "bare LF");
                    line = line.following(index + 1);
                }
                else {
                    confirm index - line.index() < 76
                        else throw InvalidTransferEncoding.located(
                            index,
                            "Base64 line exceeds 76 bytes"
                        );
                    confirm code <= 127
                        else throw InvalidTransferEncoding.located(index, "non-ASCII Base64 byte");
                    if code != 9 && code != 32 {
                        buffer.writing().write([origin[index]]);
                    }
                }
            }
        }
        try {
            Base64Decoded(Utf8Decoded(buffer.content().bytes()).string()).bytes();
        }
        catch InvalidBase64.at(offset) {
            throw InvalidTransferEncoding.located(self.source_offset(offset), "invalid Base64");
        }
    }

    hidden source_offset(compact is int) is int {
        let position = TransferPosition(0);
        for (0..origin.size()) -> index {
            let code = origin[index].int();
            if code != 9 && code != 32 && code != 13 && code != 10 {
                if position.index() == compact {
                    return index;
                }
                position = position.following(position.index() + 1);
            }
        }
        origin.size();
    }
}

test "MIME binary preserves arbitrary bytes" {
    test.is(
        TransferEncodedBody(
            origin: ByteSnapshot([0.byte(), 255.byte()]),
            encoding: TransferEncoding.binary
        ).bytes(),
        [0.byte(), 255.byte()]
    );
}

test "seven bit rejects high bytes and empty Base64 stays empty" {
    let offset = try {
        TransferEncodedBody(
            origin: ByteSnapshot([255.byte()]),
            encoding: TransferEncoding.seven_bit
        ).bytes();
        -1;
    }
    catch InvalidTransferEncoding.located(offset, _) {
        offset;
    };
    test.is(offset, 0);
    let empty is @byte = [];
    test.is(
        TransferEncodedBody(
            origin: ByteSnapshot(empty),
            encoding: TransferEncoding.base64,
            maximum_bytes: 0
        ).bytes().size(),
        0
    );
}
