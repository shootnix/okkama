module terminal/prompt v1.0.0;

// Asking for a line or a secret.
//
//     let name = await PromptedLine(origin: session, prompt: "Name: ", limit: 256).string();
//     let password = await PromptedSecret(origin: session, prompt: "Password: ", limit: 1024).string();
//
// A secret is read without echo; the mode is restored afterwards.

import "terminal/session" take TerminalSession;
import "terminal/mode" take TerminalMode;
import "terminal/error" take TerminalUnavailable, TerminalInputLimit;
import "async/event" take Event;

// A line read after a prompt.
object PromptedLine {
    has origin is TerminalSession;
    has prompt is string;
    has limit is int;

    // Writes prompt to origin and reads at most limit bytes.
    PromptedLine(origin is TerminalSession, prompt is string, limit is int) {
        self.origin = origin;
        self.prompt = prompt;
        self.limit = limit;
    }

    // The line, without its newline.
    async string() is string {
        confirm limit > 0 && limit <= 1048576 else throw TerminalInputLimit.exceeded;
        origin.output().write(prompt);
        origin.output().flush();
        await origin.input().line(limit);
    }
}

// A line read after a prompt, without echo.
object PromptedSecret {
    has origin is TerminalSession;
    has prompt is string;
    has limit is int;

    // Writes prompt to origin and reads at most limit bytes without echo.
    PromptedSecret(origin is TerminalSession, prompt is string, limit is int) {
        self.origin = origin;
        self.prompt = prompt;
        self.limit = limit;
    }

    // The line, without its newline.
    async string() is string {
        confirm limit > 0 && limit <= 1048576 else throw TerminalInputLimit.exceeded;
        confirm origin.controlling() && origin.capabilities()::Support::input_interactive
            else throw TerminalUnavailable.because("secret input requires a controlling terminal");
        let complete = Event();
        let cleanup = SecretPromptCleanup(origin: origin, complete: complete);
        defer cleanup.close();
        let lease = origin.apply(TerminalMode.secret);
        defer lease.close();
        origin.output().write(prompt);
        origin.output().flush();
        let result = await origin.input().line(limit);
        complete.set();
        result;
    }
}

hidden object SecretPromptCleanup {
    has origin is TerminalSession;
    has complete is Event;

    SecretPromptCleanup(origin is TerminalSession, complete is Event) {
        self.origin = origin;
        self.complete = complete;
    }

    close() is void {
        if !complete.ready() {
            origin.close();
        }
    }
}
