module terminal/width v1.0.0;

// How many columns text takes on a terminal, by grapheme cluster: wide East
// Asian characters and emoji take two, combining marks none.
//
//     DisplayWidth("日本").columns();                        // 4
//     TruncatedDisplay(origin: title, width: 20, ellipsis: "…").string();
//     WrappedDisplay(origin: paragraph, width: 72).string();
//
// Control characters are refused with InvalidDisplayText.

import "runtime/unicode_character" take display_clusters, display_widths, display_invalid_index;

// The columns text takes.
object DisplayWidth {
    has origin is string;

    // The text.
    DisplayWidth(origin is string) {
        self.origin = origin;
    }

    // Its width; InvalidDisplayText for a control character.
    columns() is int {
        let invalid = display_invalid_index(origin);
        confirm invalid < 0
            else throw InvalidDisplayText.detailed(invalid, "control character in display text");
        display_widths(origin).reduce(0) -> width, cluster {
            width + cluster;
        };
    }
}

// Text cut to a width.
object TruncatedDisplay {
    has origin, ellipsis is string;
    has width is int;

    // origin cut to width columns, ellipsis included when cut;
    // InvalidDisplayWidth when negative.
    TruncatedDisplay(origin is string, width is int, ellipsis is string) {
        self.origin = origin;
        self.width = width;
        self.ellipsis = ellipsis;
    }

    // The text, whole when it fits.
    string() is string {
        confirm width >= 0 else throw InvalidDisplayWidth.invalid;
        let ending = DisplayWidth(ellipsis).columns();
        confirm ending <= width else throw InvalidDisplayWidth.invalid;
        let actual = DisplayWidth(origin).columns();
        if actual <= width {
            origin;
        }
        else {
            let clusters = display_clusters(origin);
            let sizes = display_widths(origin);
            let prefix = (0..clusters.size()).reduce(DisplayPrefix(width - ending)) -> old, index {
                old.added(clusters[index], sizes[index]);
            };
            prefix.string() + ellipsis;
        }
    }
}

// The start of a text that fits a width; used inside terminal/width.
object DisplayPrefix {
    has origin is string = "";
    has remaining is int;
    has ended is bool = false;

    // Empty, width columns at most.
    DisplayPrefix(width is int) {
        remaining = width;
    }

    // This prefix with cluster of width columns, when it fits.
    added(cluster is string, width is int) is ^DisplayPrefix {
        if !ended && width <= remaining {
            ^origin = origin + cluster;
            ^remaining = remaining - width;
        }
        else {
            ^ended = true;
        }
    }

    // The prefix.
    string() is string {
        origin;
    }
}

// Text with a character that has no width; index and reason say which.
enum InvalidDisplayText is Error = (detailed(index is int, reason is string));

// A negative width.
enum InvalidDisplayWidth is Error = (invalid);

// Wrap at extended grapheme boundaries, preserving text and existing lines.
object WrappedDisplay {
    has origin is string;
    has width is int;

    // origin wrapped to width columns at grapheme boundaries.
    WrappedDisplay(origin is string, width is int) {
        self.origin = origin;
        self.width = width;
    }

    // The wrapped text.
    string() is string {
        confirm width > 0 else throw InvalidDisplayWidth.invalid;
        origin.split("\n").map() -> line {
            DisplayWidth(line).columns();
            let clusters = display_clusters(line);
            let sizes = display_widths(line);
            let wrapped = (0..clusters.size()).reduce(DisplayLines(width)) -> old, index {
                old.added(clusters[index], sizes[index]);
            };
            wrapped.string();
        }.join("\n");
    }
}

// Lines being wrapped; used inside terminal/width.
object DisplayLines {
    has origin is string = "";
    has maximum, used is int;

    // No lines yet, width columns each.
    DisplayLines(width is int) {
        maximum = width;
        used = 0;
    }

    // These lines with cluster of width columns.
    added(cluster is string, width is int) is ^DisplayLines {
        confirm width <= maximum else throw InvalidDisplayWidth.invalid;
        let gap = if used > 0 && width > maximum - used {
            "\n";
        }
        else {
            "";
        };
        ^origin = origin + gap + cluster;
        ^used = if gap == "" {
            used + width;
        }
        else {
            width;
        };
    }

    // The lines joined.
    string() is string {
        origin;
    }
}

test "display coordinates preserve joined emoji and combining clusters" {
    test.is(DisplayWidth("é界👩‍💻").columns(), 5);
    test.is(TruncatedDisplay(origin: "👩‍💻a", width: 2, ellipsis: "").string(), "👩‍💻");
}
