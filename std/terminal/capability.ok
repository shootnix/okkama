module terminal/capability v1.0.0;

import "os/environment" take Environment;
import "strings/parse" take Number;

enum TerminalColorDepth = (disabled, basic, indexed, true_color);

enum ColorPolicy = (automatic, never, always);

object TerminalSize {
    has width, height is int;

    TerminalSize(columns is int, rows is int) {
        confirm columns >= 0 && rows >= 0 && columns <= 65535 && rows <= 65535
            else throw InvalidTerminalSize.invalid;
        width = columns;
        height = rows;
    }

    cap Size {
        columns is int {
            width;
        }

        rows is int {
            height;
        }
    }
}

object TerminalCapabilities {
    has input, output is bool;
    has depth is TerminalColorDepth;
    has geometry is TerminalSize;

    TerminalCapabilities(
        input_interactive is bool,
        output_interactive is bool,
        colors is TerminalColorDepth,
        size is TerminalSize
    ) {
        input = input_interactive;
        output = output_interactive;
        depth = colors;
        geometry = size;
    }

    size() is TerminalSize {
        geometry;
    }

    cap Support {
        input_interactive is bool {
            input;
        }

        output_interactive is bool {
            output;
        }

        colors is TerminalColorDepth {
            depth;
        }
    }
}

object DetectedTerminalCapabilities {
    has origin is TerminalCapabilities;

    DetectedTerminalCapabilities(
        input is bool,
        output is bool,
        native_depth is TerminalColorDepth,
        columns is int,
        rows is int,
        environment is Environment,
        policy is ColorPolicy
    ) {
        let term = if environment.membership("TERM") {
            environment.text("TERM");
        }
        else {
            "";
        };
        let disabled = policy == ColorPolicy.never
            || (policy == ColorPolicy.automatic
            && (!output
            || native_depth == TerminalColorDepth.disabled
            || environment.membership("NO_COLOR")
            || term == "dumb"));
        let depth = if disabled {
            TerminalColorDepth.disabled;
        }
        else {
            if native_depth == TerminalColorDepth.true_color
                || (environment.membership("COLORTERM")
                && (environment.text("COLORTERM") == "truecolor"
                || environment.text("COLORTERM") == "24bit")) {
                    TerminalColorDepth.true_color;
                }
                else {
                    if native_depth == TerminalColorDepth.indexed
                        || term.split("256color").size() > 1 {
                            TerminalColorDepth.indexed;
                        }
                        else {
                            TerminalColorDepth.basic;
                        }
                }
        };
        let width = if columns > 0 {
            columns;
        }
        else {
            TerminalFallback(environment: environment, name: "COLUMNS").size();
        };
        let height = if rows > 0 {
            rows;
        }
        else {
            TerminalFallback(environment: environment, name: "LINES").size();
        };
        origin = TerminalCapabilities(
            input_interactive: input,
            output_interactive: output,
            colors: depth,
            size: TerminalSize(columns: width, rows: height)
        );
    }

    capabilities() is TerminalCapabilities {
        origin;
    }
}

hidden object TerminalFallback {
    has environment is Environment;
    has name is string;

    TerminalFallback(environment is Environment, name is string) {
        self.environment = environment;
        self.name = name;
    }

    size() is int {
        if environment.membership(name) {
            let text = environment.text(name);
            let parsed = try {
                Number(text).int();
            }
            catch e is Error {
                0;
            };
            if parsed > 0 && parsed <= 65535 {
                parsed;
            }
            else {
                0;
            }
        }
        else {
            0;
        }
    }
}

enum InvalidTerminalSize is Error = (invalid);

test "a terminal size is two bounded counts" {
    let size = TerminalSize(columns: 80, rows: 24);
    test.is(size::Size::columns, 80);
    test.is(size::Size::rows, 24);
    test.throws(InvalidTerminalSize) {
        TerminalSize(columns: -1, rows: 24);
    };
    test.throws(InvalidTerminalSize) {
        TerminalSize(columns: 80, rows: 65536);
    };
}

test "detected capabilities follow the policy, NO_COLOR, TERM, COLORTERM and the size fallback" {
    let wide = Environment(values: ["TERM": "xterm-256color", "COLUMNS": "120", "LINES": "40"]);
    let found = DetectedTerminalCapabilities(
        input: true,
        output: true,
        native_depth: TerminalColorDepth.basic,
        columns: 0,
        rows: 0,
        environment: wide,
        policy: ColorPolicy.automatic
    ).capabilities();
    test.is(found::Support::colors == TerminalColorDepth.indexed, true);
    test.is(found::Support::input_interactive, true);
    test.is(found.size()::Size::columns, 120);
    test.is(found.size()::Size::rows, 40);
    let sized = DetectedTerminalCapabilities(
        input: false,
        output: true,
        native_depth: TerminalColorDepth.basic,
        columns: 100,
        rows: 30,
        environment: wide,
        policy: ColorPolicy.automatic
    ).capabilities();
    test.is(sized.size()::Size::columns, 100);
    let plain = Environment(values: ["TERM": "xterm", "NO_COLOR": "1", "COLUMNS": "wide"]);
    let quiet = DetectedTerminalCapabilities(
        input: true,
        output: true,
        native_depth: TerminalColorDepth.true_color,
        columns: 0,
        rows: 0,
        environment: plain,
        policy: ColorPolicy.automatic
    ).capabilities();
    test.is(quiet::Support::colors == TerminalColorDepth.disabled, true);
    test.is(quiet.size()::Size::columns, 0);
    let forced = DetectedTerminalCapabilities(
        input: false,
        output: false,
        native_depth: TerminalColorDepth.basic,
        columns: 0,
        rows: 0,
        environment: plain,
        policy: ColorPolicy.always
    ).capabilities();
    test.is(forced::Support::colors == TerminalColorDepth.basic, true);
    let piped = DetectedTerminalCapabilities(
        input: false,
        output: false,
        native_depth: TerminalColorDepth.true_color,
        columns: 0,
        rows: 0,
        environment: wide,
        policy: ColorPolicy.automatic
    ).capabilities();
    test.is(piped::Support::colors == TerminalColorDepth.disabled, true);
    let truecolor = Environment(values: ["TERM": "xterm", "COLORTERM": "truecolor"]);
    let rich = DetectedTerminalCapabilities(
        input: true,
        output: true,
        native_depth: TerminalColorDepth.basic,
        columns: 80,
        rows: 24,
        environment: truecolor,
        policy: ColorPolicy.automatic
    ).capabilities();
    test.is(rich::Support::colors == TerminalColorDepth.true_color, true);
    let never = DetectedTerminalCapabilities(
        input: true,
        output: true,
        native_depth: TerminalColorDepth.true_color,
        columns: 80,
        rows: 24,
        environment: truecolor,
        policy: ColorPolicy.never
    ).capabilities();
    test.is(never::Support::colors == TerminalColorDepth.disabled, true);
}
