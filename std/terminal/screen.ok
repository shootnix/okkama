module terminal/screen v1.0.0;

import "terminal/capability" take TerminalSize;
import "terminal/error" take TerminalUnavailable, TerminalProblem, TerminalClosed;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "runtime/application" take TerminalResizeState, terminal_resize_next, terminal_resize_closed,
    terminal_resize_close;
import "async/atomic" take Atomic;
import "async/lock" take Lock;
import "io/stream" take Closing;

enum ClearRegion = (screen, line, to_end, to_start);

object TerminalScreen {
    has origin is TerminalScreenApplying;

    TerminalScreen(origin is TerminalScreenApplying) {
        self.origin = origin;
    }

    clear(region is ClearRegion) is void {
        origin.clear(region);
    }

    move(row is int, column is int) is void {
        origin.move(row, column);
    }

    display_cursor(visible is bool) is void {
        origin.display_cursor(visible);
    }

    use_alternate_screen(enabled is bool) is void {
        origin.use_alternate_screen(enabled);
    }
}

role TerminalScreenApplying {
    clear(region is ClearRegion) is void;
    move(row is int, column is int) is void;
    display_cursor(visible is bool) is void;
    use_alternate_screen(enabled is bool) is void;
}

role TerminalResizeOpening {
    async resizes() is TerminalResizeReading;
    closed() is bool;
}

// Terminal geometry over time: the first size() reports the geometry when
// the source opened, and each later call waits for the next change (SIGWINCH)
// and reports the new geometry.
role TerminalResizeReading {
    async size() is TerminalSize;
    closed() is bool;
    close() is void;
}

// Private native boundary adapter, owned by the public TerminalResizes wrapper.
// It has no independent destroy hook that could shorten a borrowed role's life.
object TerminalResizeReader does TerminalResizeReading {
    has state is TerminalResizeState;

    TerminalResizeReader(state is TerminalResizeState) {
        self.state = state;
    }

    async size() is TerminalSize {
        let pending = terminal_resize_next(state);
        defer pending.cancel();
        let size = try {
            await pending;
        }
        catch e is NativeFailure {
            throw TerminalProblem(e).error();
        };
        TerminalSize(columns: size[0], rows: size[1]);
    }

    closed() is bool {
        terminal_resize_closed(state);
    }

    close() is void {
        terminal_resize_close(state);
    }
}

object TerminalResizes does Closing {
    has origin is TerminalResizeOpening;
    has source is Atomic<@TerminalResizeReading>;
    has stopped is Atomic<bool>;
    has lock is Lock;

    TerminalResizes(origin is TerminalResizeOpening) {
        self.origin = origin;
        let empty is @TerminalResizeReading = [];
        source = Atomic(empty);
        stopped = Atomic(false);
        lock = Lock();
    }

    async size() is TerminalSize {
        confirm !self.closed() else throw TerminalClosed.closed;
        let guard = await lock.guard();
        defer guard.close();
        confirm !self.closed() else throw TerminalClosed.closed;
        if source.value().size() == 0 {
            let state = await origin.resizes();
            source.replace([state]);
            if stopped.value() {
                state.close();
                throw TerminalClosed.closed;
            }
        }
        await source.value()[0].size();
    }

    closed() is bool {
        stopped.value()
            || origin.closed()
            || (source.value().size() > 0 && source.value()[0].closed());
    }

    close() is void {
        if !stopped.value() {
            stopped.replace(true);
            if source.value().size() > 0 {
                source.value()[0].close();
            }
        }
    }

    destroy {
        self.close();
    }
}

hidden object RecordedScreen does TerminalScreenApplying {
    has calls is Atomic<@string>;

    RecordedScreen() {
        let empty is @string = [];
        calls = Atomic(empty);
    }

    clear(region is ClearRegion) is void {
        self.record("clear " + if region == ClearRegion.line { "line"; } else { "other"; });
    }

    move(row is int, column is int) is void {
        self.record("move " + row.string() + "," + column.string());
    }

    display_cursor(visible is bool) is void {
        self.record("cursor " + visible.string());
    }

    use_alternate_screen(enabled is bool) is void {
        self.record("alternate " + enabled.string());
    }

    calls() is @string {
        calls.value();
    }

    hidden record(call is string) is void {
        calls.replace(calls.value() + [call]);
    }
}

hidden object ScriptedResizes does TerminalResizeOpening, TerminalResizeReading {
    has sizes is Atomic<@TerminalSize>;
    has finished is Atomic<bool>;

    ScriptedResizes() {
        sizes = Atomic([TerminalSize(columns: 80, rows: 24), TerminalSize(columns: 100, rows: 30)]);
        finished = Atomic(false);
    }

    async resizes() is TerminalResizeReading {
        self;
    }

    async size() is TerminalSize {
        let current = sizes.value().first();
        sizes.replace(sizes.value().slice(1, sizes.value().size()));
        current;
    }

    closed() is bool {
        finished.value();
    }

    close() is void {
        finished.replace(true);
    }
}

test "a screen passes its commands to the terminal" {
    let applied = RecordedScreen();
    let screen = TerminalScreen(applied);
    screen.clear(ClearRegion.line);
    screen.move(row: 2, column: 5);
    screen.display_cursor(false);
    screen.use_alternate_screen(true);
    test.is(applied.calls(), ["clear line", "move 2,5", "cursor false", "alternate true"]);
}

async test "resizes report the first geometry, then each change, until closed" {
    let source = ScriptedResizes();
    let resizes = TerminalResizes(source);
    test.is((await resizes.size())::Size::columns, 80);
    test.is((await resizes.size())::Size::rows, 30);
    resizes.close();
    test.is(resizes.closed(), true);
    test.is(source.closed(), true);
    test.throws(TerminalClosed) {
        await resizes.size();
    };
}
