module net/ip_registry v1.0.0;

// The IANA special-purpose address registries, built in; IpAddress.properties()
// reads them. Programs do not need this module directly.

import "encoding/hex" take HexDecoded;
import "error" take InvalidArgument;

// The registry flags of an address.
object IpClassification {
    has origin is @byte;

    // The flags of the address bytes origin.
    IpClassification(origin is @byte) {
        confirm origin.size() == 4 || origin.size() == 16
            else throw InvalidArgument.because("IP classification needs 4 or 16 bytes");
        self.origin = origin;
    }

    // The flags as bits.
    flags() is int {
        if origin.size() == 4 {
            // 0.0.0.0/32
            if PackedIpPrefix(origin: origin, prefix: "00000000", bits: 32).matches() {
                return 65;
            }
            // 192.0.0.8/32
            if PackedIpPrefix(origin: origin, prefix: "c0000008", bits: 32).matches() {
                return 0;
            }
            // 192.0.0.9/32
            if PackedIpPrefix(origin: origin, prefix: "c0000009", bits: 32).matches() {
                return 16;
            }
            // 192.0.0.10/32
            if PackedIpPrefix(origin: origin, prefix: "c000000a", bits: 32).matches() {
                return 16;
            }
            // 192.0.0.170/32
            if PackedIpPrefix(origin: origin, prefix: "c00000aa", bits: 32).matches() {
                return 64;
            }
            // 192.0.0.171/32
            if PackedIpPrefix(origin: origin, prefix: "c00000ab", bits: 32).matches() {
                return 64;
            }
            // 192.88.99.2/32
            if PackedIpPrefix(origin: origin, prefix: "c0586302", bits: 32).matches() {
                return 0;
            }
            // 255.255.255.255/32
            if PackedIpPrefix(origin: origin, prefix: "ffffffff", bits: 32).matches() {
                return 64;
            }
            // 192.0.0.0/29
            if PackedIpPrefix(origin: origin, prefix: "c0000000", bits: 29).matches() {
                return 0;
            }
            // 192.0.0.0/24
            if PackedIpPrefix(origin: origin, prefix: "c0000000", bits: 24).matches() {
                return 0;
            }
            // 192.0.2.0/24
            if PackedIpPrefix(origin: origin, prefix: "c0000200", bits: 24).matches() {
                return 128;
            }
            // 192.31.196.0/24
            if PackedIpPrefix(origin: origin, prefix: "c01fc400", bits: 24).matches() {
                return 16;
            }
            // 192.52.193.0/24
            if PackedIpPrefix(origin: origin, prefix: "c034c100", bits: 24).matches() {
                return 16;
            }
            // 192.88.99.0/24
            if PackedIpPrefix(origin: origin, prefix: "c0586300", bits: 24).matches() {
                return 0;
            }
            // 192.175.48.0/24
            if PackedIpPrefix(origin: origin, prefix: "c0af3000", bits: 24).matches() {
                return 16;
            }
            // 198.51.100.0/24
            if PackedIpPrefix(origin: origin, prefix: "c6336400", bits: 24).matches() {
                return 128;
            }
            // 203.0.113.0/24
            if PackedIpPrefix(origin: origin, prefix: "cb007100", bits: 24).matches() {
                return 128;
            }
            // 169.254.0.0/16
            if PackedIpPrefix(origin: origin, prefix: "a9fe0000", bits: 16).matches() {
                return 68;
            }
            // 192.168.0.0/16
            if PackedIpPrefix(origin: origin, prefix: "c0a80000", bits: 16).matches() {
                return 8;
            }
            // 198.18.0.0/15
            if PackedIpPrefix(origin: origin, prefix: "c6120000", bits: 15).matches() {
                return 0;
            }
            // 172.16.0.0/12
            if PackedIpPrefix(origin: origin, prefix: "ac100000", bits: 12).matches() {
                return 8;
            }
            // 100.64.0.0/10
            if PackedIpPrefix(origin: origin, prefix: "64400000", bits: 10).matches() {
                return 0;
            }
            // 0.0.0.0/8
            if PackedIpPrefix(origin: origin, prefix: "00000000", bits: 8).matches() {
                return 64;
            }
            // 10.0.0.0/8
            if PackedIpPrefix(origin: origin, prefix: "0a000000", bits: 8).matches() {
                return 8;
            }
            // 127.0.0.0/8
            if PackedIpPrefix(origin: origin, prefix: "7f000000", bits: 8).matches() {
                return 66;
            }
            // 240.0.0.0/4
            if PackedIpPrefix(origin: origin, prefix: "f0000000", bits: 4).matches() {
                return 64;
            }
            // 224.0.0.0/4
            if PackedIpPrefix(origin: origin, prefix: "e0000000", bits: 4).matches() {
                return 32;
            }
            // 0.0.0.0/0
            if PackedIpPrefix(origin: origin, prefix: "00000000", bits: 0).matches() {
                return 16;
            }
        }
        else {
            // ::/128
            if PackedIpPrefix(origin: origin, prefix: "00000000000000000000000000000000", bits: 128).matches() {
                return 65;
            }
            // ::1/128
            if PackedIpPrefix(origin: origin, prefix: "00000000000000000000000000000001", bits: 128).matches() {
                return 66;
            }
            // 2001:1::1/128
            if PackedIpPrefix(origin: origin, prefix: "20010001000000000000000000000001", bits: 128).matches() {
                return 16;
            }
            // 2001:1::2/128
            if PackedIpPrefix(origin: origin, prefix: "20010001000000000000000000000002", bits: 128).matches() {
                return 16;
            }
            // 2001:1::3/128
            if PackedIpPrefix(origin: origin, prefix: "20010001000000000000000000000003", bits: 128).matches() {
                return 16;
            }
            // ::ffff:0.0.0.0/96
            if PackedIpPrefix(origin: origin, prefix: "00000000000000000000ffff00000000", bits: 96).matches() {
                return 64;
            }
            // 64:ff9b::/96
            if PackedIpPrefix(origin: origin, prefix: "0064ff9b000000000000000000000000", bits: 96).matches() {
                return 16;
            }
            // 100::/64
            if PackedIpPrefix(origin: origin, prefix: "01000000000000000000000000000000", bits: 64).matches() {
                return 0;
            }
            // 100:0:0:1::/64
            if PackedIpPrefix(origin: origin, prefix: "01000000000000010000000000000000", bits: 64).matches() {
                return 0;
            }
            // 64:ff9b:1::/48
            if PackedIpPrefix(origin: origin, prefix: "0064ff9b000100000000000000000000", bits: 48).matches() {
                return 0;
            }
            // 2001:2::/48
            if PackedIpPrefix(origin: origin, prefix: "20010002000000000000000000000000", bits: 48).matches() {
                return 0;
            }
            // 2001:4:112::/48
            if PackedIpPrefix(origin: origin, prefix: "20010004011200000000000000000000", bits: 48).matches() {
                return 16;
            }
            // 2620:4f:8000::/48
            if PackedIpPrefix(origin: origin, prefix: "2620004f800000000000000000000000", bits: 48).matches() {
                return 16;
            }
            // 2001::/32
            if PackedIpPrefix(origin: origin, prefix: "20010000000000000000000000000000", bits: 32).matches() {
                return 0;
            }
            // 2001:3::/32
            if PackedIpPrefix(origin: origin, prefix: "20010003000000000000000000000000", bits: 32).matches() {
                return 16;
            }
            // 2001:db8::/32
            if PackedIpPrefix(origin: origin, prefix: "20010db8000000000000000000000000", bits: 32).matches() {
                return 128;
            }
            // 2001:10::/28
            if PackedIpPrefix(origin: origin, prefix: "20010010000000000000000000000000", bits: 28).matches() {
                return 0;
            }
            // 2001:20::/28
            if PackedIpPrefix(origin: origin, prefix: "20010020000000000000000000000000", bits: 28).matches() {
                return 16;
            }
            // 2001:30::/28
            if PackedIpPrefix(origin: origin, prefix: "20010030000000000000000000000000", bits: 28).matches() {
                return 16;
            }
            // 2001::/23
            if PackedIpPrefix(origin: origin, prefix: "20010000000000000000000000000000", bits: 23).matches() {
                return 0;
            }
            // 3fff::/20
            if PackedIpPrefix(origin: origin, prefix: "3fff0000000000000000000000000000", bits: 20).matches() {
                return 128;
            }
            // 2002::/16
            if PackedIpPrefix(origin: origin, prefix: "20020000000000000000000000000000", bits: 16).matches() {
                return 0;
            }
            // 5f00::/16
            if PackedIpPrefix(origin: origin, prefix: "5f000000000000000000000000000000", bits: 16).matches() {
                return 0;
            }
            // fe80::/10
            if PackedIpPrefix(origin: origin, prefix: "fe800000000000000000000000000000", bits: 10).matches() {
                return 68;
            }
            // fe80::/10
            if PackedIpPrefix(origin: origin, prefix: "fe800000000000000000000000000000", bits: 10).matches() {
                return 4;
            }
            // fec0::/10
            if PackedIpPrefix(origin: origin, prefix: "fec00000000000000000000000000000", bits: 10).matches() {
                return 64;
            }
            // fe00::/9
            if PackedIpPrefix(origin: origin, prefix: "fe000000000000000000000000000000", bits: 9).matches() {
                return 64;
            }
            // ::/8
            if PackedIpPrefix(origin: origin, prefix: "00000000000000000000000000000000", bits: 8).matches() {
                return 64;
            }
            // 100::/8
            if PackedIpPrefix(origin: origin, prefix: "01000000000000000000000000000000", bits: 8).matches() {
                return 64;
            }
            // ff00::/8
            if PackedIpPrefix(origin: origin, prefix: "ff000000000000000000000000000000", bits: 8).matches() {
                return 32;
            }
            // fc00::/7
            if PackedIpPrefix(origin: origin, prefix: "fc000000000000000000000000000000", bits: 7).matches() {
                return 8;
            }
            // 200::/7
            if PackedIpPrefix(origin: origin, prefix: "02000000000000000000000000000000", bits: 7).matches() {
                return 64;
            }
            // fc00::/7
            if PackedIpPrefix(origin: origin, prefix: "fc000000000000000000000000000000", bits: 7).matches() {
                return 8;
            }
            // 400::/6
            if PackedIpPrefix(origin: origin, prefix: "04000000000000000000000000000000", bits: 6).matches() {
                return 64;
            }
            // f800::/6
            if PackedIpPrefix(origin: origin, prefix: "f8000000000000000000000000000000", bits: 6).matches() {
                return 64;
            }
            // 800::/5
            if PackedIpPrefix(origin: origin, prefix: "08000000000000000000000000000000", bits: 5).matches() {
                return 64;
            }
            // f000::/5
            if PackedIpPrefix(origin: origin, prefix: "f0000000000000000000000000000000", bits: 5).matches() {
                return 64;
            }
            // 1000::/4
            if PackedIpPrefix(origin: origin, prefix: "10000000000000000000000000000000", bits: 4).matches() {
                return 64;
            }
            // e000::/4
            if PackedIpPrefix(origin: origin, prefix: "e0000000000000000000000000000000", bits: 4).matches() {
                return 64;
            }
            // 2000::/3
            if PackedIpPrefix(origin: origin, prefix: "20000000000000000000000000000000", bits: 3).matches() {
                return 16;
            }
            // 4000::/3
            if PackedIpPrefix(origin: origin, prefix: "40000000000000000000000000000000", bits: 3).matches() {
                return 64;
            }
            // 6000::/3
            if PackedIpPrefix(origin: origin, prefix: "60000000000000000000000000000000", bits: 3).matches() {
                return 64;
            }
            // 8000::/3
            if PackedIpPrefix(origin: origin, prefix: "80000000000000000000000000000000", bits: 3).matches() {
                return 64;
            }
            // a000::/3
            if PackedIpPrefix(origin: origin, prefix: "a0000000000000000000000000000000", bits: 3).matches() {
                return 64;
            }
            // c000::/3
            if PackedIpPrefix(origin: origin, prefix: "c0000000000000000000000000000000", bits: 3).matches() {
                return 64;
            }
        }
        0;
    }
}

// One numeric prefix comparison, bounded by the fixed address byte width.
hidden object PackedIpPrefix {
    has origin, pattern is @byte;
    has bits is int;

    PackedIpPrefix(origin is @byte, prefix is string, bits is int) {
        let decoded = HexDecoded(prefix).bytes();
        confirm origin.size() == decoded.size() && bits >= 0 && bits <= origin.size() * 8
            else throw InvalidArgument.because("invalid packed IP prefix");
        self.origin = origin;
        pattern = decoded;
        self.bits = bits;
    }

    matches() is bool {
        let whole = (bits / 8).int();
        for 0..whole -> index {
            if origin[index] != pattern[index] {
                return false;
            }
        }
        let remaining = bits % 8;
        if remaining > 0 {
            let mask = 256 - (1 << (8 - remaining));
            return (origin[whole].int() & mask) == (pattern[whole].int() & mask);
        }
        true;
    }
}

test "special-purpose exceptions override broader assignments" {
    test.is(IpClassification([byte(192), byte(0), byte(0), byte(9)]).flags(), 16);
    test.is(IpClassification([byte(192), byte(0), byte(0), byte(11)]).flags(), 0);
}

test "IPv6 reserved space excludes more specific assignments" {
    let reserved is @byte = (0..16).map() -> index {
        if index == 0 {
            byte(64);
        }
        else {
            byte(0);
        }
    };
    let translated is @byte = [
        byte(0),
        byte(100),
        byte(255),
        byte(155),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(0),
        byte(1)
    ];
    test.is(IpClassification(reserved).flags(), 64);
    test.is(IpClassification(translated).flags(), 16);
}
