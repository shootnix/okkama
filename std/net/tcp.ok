module net/tcp v1.0.0;

import "error" take InvalidArgument;
import "runtime/network" as network;
import "runtime/net" as net;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpVersion;
import "net/stream" take StreamConnection, StreamReading, StreamWriting, ConnectionEndpoints,
    StreamFailure;
import "net/failure" take NetworkOperation, NetworkClosed;
import "io/stream" take Closing;
import "io/decorators" take ByteSnapshot;
import "strings/parse" take Number;
import "net/ip" take IpAddress;
import "async/event" take Event;
import "async/collect" take FirstSuccessful, Raced;
import "async/scope" take FutureGroup;
import "async/atomic" take Atomic;
import "collections/sequence" take Sequencing;
import "time/clock" take Timing, SystemClock;
import "time/duration" take Duration, DurationUnit;
import "net/endpoint" take HostEndpoint, HostName;
import "net/dns" take Resolving, SystemResolution, FixedResolution, HostAddresses;

// Immutable connection option request. Defaults keep keepalive off and do not
// request disabling Nagle's algorithm. Construction applies no socket options;
// the eventual connection operation owns application and unsupported failures.
object TcpOptions {
    has keep is bool;
    has immediate is bool;

    TcpOptions() {
        keep = false;
        immediate = false;
    }

    TcpOptions(keep_alive is bool, no_delay is bool) {
        keep = keep_alive;
        immediate = no_delay;
    }

    keep_alive() is bool {
        keep;
    }

    no_delay() is bool {
        immediate;
    }
}

// Immutable listener request, to be applied before bind by the future listener.
// Defaults: no address reuse, no implicit dual stack, requested backlog 128.
// Backlog is non-negative and retained exactly; zero is valid. The OS can cap
// or reinterpret it, so this value does not observe the effective queue size.
// Unsupported settings are the consuming socket operation's responsibility.
object TcpListeningOptions {
    has reuse is bool;
    has dual is bool;
    has queued is int;

    TcpListeningOptions() {
        reuse = false;
        dual = false;
        queued = 128;
    }

    TcpListeningOptions(address_reuse is bool, dual_stack is bool, backlog is int) {
        confirm backlog >= 0
            else throw InvalidArgument.because(
                "TCP backlog must be non-negative: " + backlog.string()
            );
        reuse = address_reuse;
        dual = dual_stack;
        queued = backlog;
    }

    address_reuse() is bool {
        reuse;
    }

    dual_stack() is bool {
        dual;
    }

    backlog() is int {
        queued;
    }
}

object TcpConnection does Closing {
    has origin is StreamConnection;

    TcpConnection(state is network.SocketState) {
        origin = StreamConnection(state);
    }

    input() is StreamReading {
        origin.input();
    }

    output() is StreamWriting {
        origin.output();
    }

    endpoints() is ConnectionEndpoints<IpEndpoint> {
        origin.endpoints();
    }

    closed() is bool {
        origin.closed();
    }

    close() is void {
        origin.close();
    }
}

object TcpConnecting {
    has remote is @IpEndpoint;
    has host is string;
    has port is int;
    has resolver is Resolving;
    has options is TcpOptions;

    TcpConnecting(remote is IpEndpoint) {
        confirm remote::Parts::port > 0
            else throw InvalidArgument.because("TCP destination port must be positive");
        self.remote = [remote];
        host = "";
        port = remote::Parts::port;
        resolver = SystemResolution();
        options = TcpOptions();
    }

    TcpConnecting(remote is IpEndpoint, options is TcpOptions) {
        confirm remote::Parts::port > 0
            else throw InvalidArgument.because("TCP destination port must be positive");
        self.remote = [remote];
        host = "";
        port = remote::Parts::port;
        resolver = SystemResolution();
        self.options = options;
    }

    // TcpConnecting(address: IpAddress("127.0.0.1"), port: 8080, no_delay: true)
    TcpConnecting(address is IpAddress, port is int, keep_alive is bool = false, no_delay is bool = false) {
        confirm port > 0 && port <= 65535
            else throw InvalidArgument.because("TCP destination port must be 1..65535");
        remote = [IpEndpoint(address: address, port: port)];
        host = "";
        self.port = port;
        resolver = SystemResolution();
        options = TcpOptions(keep_alive: keep_alive, no_delay: no_delay);
    }

    // TcpConnecting(host: "example.com", port: 443): the resolver's addresses,
    // raced as RFC 8305 asks (the system's DNS unless resolver: is given).
    TcpConnecting(
        host is string,
        port is int,
        keep_alive is bool = false,
        no_delay is bool = false,
        resolver is Resolving = SystemResolution()
    ) {
        confirm host != "" else throw InvalidArgument.because("TCP destination host must not be empty");
        confirm port > 0 && port <= 65535
            else throw InvalidArgument.because("TCP destination port must be 1..65535");
        let none_yet is @IpEndpoint = [];
        remote = none_yet;
        self.host = host;
        self.port = port;
        self.resolver = resolver;
        options = TcpOptions(keep_alive: keep_alive, no_delay: no_delay);
    }

    async connection() is TcpConnection {
        if remote.size() == 1 {
            return await self.direct(remote[0]);
        }
        let endpoints = await resolver.addresses(HostEndpoint(host: HostName(host), port: port));
        await TcpEndpointRace(
            origins: endpoints,
            options: options,
            delay: Duration(milliseconds: 250),
            clock: SystemClock()
        ).connection();
    }

    hidden async direct(remote is IpEndpoint) is TcpConnection {
        try {
            let pending = network.tcp_connect(
                TcpEndpointWire(remote).bytes(),
                remote::Parts::zone,
                options.keep_alive(),
                options.no_delay()
            );
            let state = await pending;
            let ready = Event();
            let anchor = TcpUnpublished(state: state, ready: ready);
            defer anchor.close();
            let connection = TcpConnection(state);
            ready.set();
            connection;
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.connecting, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }
}

object TcpListening {
    has local is IpEndpoint;
    has options is TcpListeningOptions;
    has accepted is TcpOptions;

    TcpListening(local is IpEndpoint) {
        self.local = local;
        options = TcpListeningOptions();
        accepted = TcpOptions();
    }

    TcpListening(local is IpEndpoint, options is TcpListeningOptions) {
        self.local = local;
        self.options = options;
        accepted = TcpOptions();
    }

    TcpListening(local is IpEndpoint, options is TcpListeningOptions, accepted is TcpOptions) {
        self.local = local;
        self.options = options;
        self.accepted = accepted;
    }

    // TcpListening(port: 0).listener(): loopback unless address: is given;
    // port 0 picks a free port, and listener::Local::port tells which.
    TcpListening(
        port is int,
        address is IpAddress = IpAddress("127.0.0.1"),
        backlog is int = 128,
        address_reuse is bool = false,
        dual_stack is bool = false,
        keep_alive is bool = false,
        no_delay is bool = false
    ) {
        local = IpEndpoint(address: address, port: port);
        options = TcpListeningOptions(address_reuse: address_reuse, dual_stack: dual_stack, backlog: backlog);
        accepted = TcpOptions(keep_alive: keep_alive, no_delay: no_delay);
    }

    async listener() is TcpListener {
        let state = try {
            network.tcp_bound(
                TcpEndpointWire(local).bytes(),
                local::Parts::zone,
                options.address_reuse(),
                options.dual_stack()
            );
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.binding, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        };
        let ready = Event();
        let anchor = TcpListenerUnpublished(state: state, ready: ready);
        defer anchor.close();
        try {
            network.tcp_start_listening(state, options.backlog());
            let listener = TcpListener(state: state, accepted: accepted);
            ready.set();
            listener;
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.listening, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }
}

object TcpListener does Closing {
    has state is network.TcpListenerState;
    has local is IpEndpoint;
    has accepted is TcpOptions;

    TcpListener(state is network.TcpListenerState, accepted is TcpOptions) {
        let endpoint = try {
            let fields = network.tcp_listener_endpoint(state);
            IpEndpoint(address: IpAddress(fields[0]), port: Number(fields[1]).int(), zone: fields[2]);
        }
        catch e is NativeFailure {
            network.tcp_listener_close(state);
            throw;
        }
        catch e is Error {
            network.tcp_listener_close(state);
            throw;
        };
        self.state = state;
        local = endpoint;
        self.accepted = accepted;
    }

    local_endpoint() is IpEndpoint {
        local;
    }

    closed() is bool {
        network.tcp_listener_closed(state);
    }

    close() is void {
        try {
            network.tcp_listener_close(state);
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.closing, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }

    async connection() is TcpConnection {
        confirm !self.closed() else throw NetworkClosed.closed;
        try {
            let pending = network.tcp_accept(state, accepted.keep_alive(), accepted.no_delay());
            let peer = await pending;
            let ready = Event();
            let anchor = TcpUnpublished(state: peer, ready: ready);
            defer anchor.close();
            let connection = TcpConnection(peer);
            ready.set();
            connection;
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.accepting, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }

    destroy {
        network.tcp_listener_close(state);
    }

    cap Local {
        port is int {
            local::Parts::port;
        }
    }
}

hidden object TcpEndpointWire {
    has origin is IpEndpoint;

    TcpEndpointWire(origin is IpEndpoint) {
        self.origin = origin;
    }

    bytes() is @byte {
        net.ip_parse(
            if origin.address().version() == IpVersion.v4 {
                1;
            }
            else {
                2;
            },
            origin.address().string(),
            origin::Parts::port
        );
    }
}

hidden object TcpUnpublished {
    has state is network.SocketState;
    has ready is Event;

    TcpUnpublished(state is network.SocketState, ready is Event) {
        self.state = state;
        self.ready = ready;
    }

    close() is void {
        if !ready.ready() {
            network.close(state);
        }
    }
}

hidden object TcpListenerUnpublished {
    has state is network.TcpListenerState;
    has ready is Event;

    TcpListenerUnpublished(state is network.TcpListenerState, ready is Event) {
        self.state = state;
        self.ready = ready;
    }

    close() is void {
        if !ready.ready() {
            network.tcp_listener_close(state);
        }
    }
}

test "TCP defaults agree with explicit settings" {
    test.ok(TcpOptions() == TcpOptions(keep_alive: false, no_delay: false));
    test.ok(TcpListeningOptions() == TcpListeningOptions(address_reuse: false, dual_stack: false, backlog: 128));
}

test "TCP options preserve independent choices" {
    let options = TcpListeningOptions(address_reuse: true, dual_stack: false, backlog: 0);
    test.ok(options.address_reuse());
    test.ok(!options.dual_stack());
    test.is(options.backlog(), 0);
    test.ok(TcpOptions(keep_alive: false, no_delay: true).no_delay());
}

async test "numeric TCP reports actual OS-selected endpoints" {
    let listener is TcpListener = await TcpListening(port: 0).listener();
    defer listener.close();
    let accepting is async () is TcpConnection = listener.connection;
    let pending = spawn accepting();
    let client = await TcpConnecting(listener.local_endpoint()).connection();
    defer client.close();
    let server = await pending;
    defer server.close();
    test.ok(client.endpoints().remote_endpoint() == listener.local_endpoint());
    await client.output().write(ByteSnapshot([7.byte()]));
    test.is(await server.input().bytes(1), [7.byte()]);
}

// Snapshot bounded checked numeric candidates and interleave families while
// retaining the caller's first family and relative order within each family.
hidden object TcpRaceEndpoints {
    has ordered is @IpEndpoint;

    TcpRaceEndpoints(origins is Sequencing<IpEndpoint>) {
        let count = origins.size();
        confirm count >= 1 && count <= 256 else throw InvalidTcpRace.because("candidate count");
        let source is @IpEndpoint = (0..count).map() -> index {
            let endpoint = origins.item(index);
            confirm endpoint::Parts::port > 0 else throw InvalidTcpRace.because("destination port");
            endpoint;
        };
        let family = source[0].address().version();
        let first = source.filter() -> endpoint {
            endpoint.address().version() == family;
        };
        let second = source.filter() -> endpoint {
            endpoint.address().version() != family;
        };
        let pairs = if first.size() < second.size() {
            first.size();
        }
        else {
            second.size();
        };
        let merged is @IpEndpoint = (0..count).map() -> index {
            if index < 2 * pairs {
                if (index & 1) == 0 {
                    first[index >> 1];
                }
                else {
                    second[index >> 1];
                }
            }
            else {
                if first.size() > second.size() {
                    first[pairs + index - 2 * pairs];
                }
                else {
                    second[pairs + index - 2 * pairs];
                }
            }
        };
        ordered = merged;
    }

    items() is Sequencing<IpEndpoint> {
        ordered;
    }
}

// The racing engine behind TcpRacing (net/tcp_racing) and
// TcpConnecting(host:, port:): RFC 8305 staggered attempts, first success wins.
object TcpEndpointRace {
    has endpoints is Sequencing<IpEndpoint>;
    has options is TcpOptions;
    has delay is Duration;
    has clock is Timing;

    TcpEndpointRace(origins is Sequencing<IpEndpoint>) {
        endpoints = TcpRaceEndpoints(origins).items();
        options = TcpOptions();
        delay = Duration(milliseconds: 250);
        clock = SystemClock();
    }

    TcpEndpointRace(
        origins is Sequencing<IpEndpoint>,
        options is TcpOptions,
        delay is Duration,
        clock is Timing
    ) {
        confirm delay::Span::seconds >= 0.rat() else throw InvalidTcpRace.because("negative stagger");
        endpoints = TcpRaceEndpoints(origins).items();
        self.options = options;
        self.delay = delay;
        self.clock = clock;
    }

    async connection() is TcpConnection {
        let started is @Event = (0..endpoints.size()).map() -> index {
            Event();
        };
        let failed is @Event = (0..endpoints.size()).map() -> index {
            Event();
        };
        let attempts is @TcpRaceAttempt = (0..endpoints.size()).map() -> index {
            let prior_started = if index == 0 {
                Event(true);
            }
            else {
                started[index - 1];
            };
            let prior_failed = if index == 0 {
                Event();
            }
            else {
                failed[index - 1];
            };
            TcpRaceAttempt(
                position: index,
                endpoint: endpoints.item(index),
                options: options,
                delay: delay,
                clock: clock,
                prior_started: prior_started,
                prior_failed: prior_failed,
                started: started[index],
                failed: failed[index]
            );
        };
        let group is FutureGroup<TcpRaceWin> = FutureGroup();
        let keep is @int = [];
        let keeper = Atomic(keep);
        let published = Event();
        let cleanup = TcpRaceCleanup(group: group, attempts: attempts, keeper: keeper, published: published);
        defer await cleanup.close();
        let futures is @Future<TcpRaceWin> = attempts.map() -> attempt {
            let future = attempt.result();
            group.start(future);
            future;
        };
        let winner = await FirstSuccessful(origins: futures).outcome();
        keeper.replace([winner.position()]);
        // Dispose ready losers before publication, as well as pending losers
        // already cancelled by the selector. Cancellation during cleanup keeps
        // published false, so the winner is also reclaimed.
        for attempts -> attempt {
            await attempt.dispose(keeper.value());
        }
        published.set();
        winner.connection();
    }
}

hidden object TcpRaceWin {
    has position is int;
    has connection is TcpConnection;

    TcpRaceWin(position is int, connection is TcpConnection) {
        self.position = position;
        self.connection = connection;
    }

    position() is int {
        position;
    }

    connection() is TcpConnection {
        connection;
    }
}

hidden object TcpRaceAttempt {
    has position is int;
    has endpoint is IpEndpoint;
    has options is TcpOptions;
    has delay is Duration;
    has clock is Timing;
    has prior_started, prior_failed, started, failed is Event;
    has waiting is FutureGroup<bool>;
    has connecting is FutureGroup<TcpConnection>;
    has raw is Atomic<@Future<TcpConnection>>;

    TcpRaceAttempt(
        position is int,
        endpoint is IpEndpoint,
        options is TcpOptions,
        delay is Duration,
        clock is Timing,
        prior_started is Event,
        prior_failed is Event,
        started is Event,
        failed is Event
    ) {
        self.position = position;
        self.prior_started = prior_started;
        self.prior_failed = prior_failed;
        self.started = started;
        self.failed = failed;
        self.endpoint = endpoint;
        self.options = options;
        self.delay = delay;
        self.clock = clock;
        let timer is FutureGroup<bool> = FutureGroup();
        waiting = timer;
        let network is FutureGroup<TcpConnection> = FutureGroup();
        connecting = network;
        let empty is @Future<TcpConnection> = [];
        raw = Atomic(empty);
    }

    async result() is TcpRaceWin {
        let cleanup = TcpRaceAttemptCleanup(waiting: waiting, connecting: connecting);
        defer await cleanup.close();
        try {
            if position > 0 {
                if !prior_started.ready() {
                    let pending = TcpRaceSignal(prior_started).ready();
                    waiting.start(pending);
                    await pending;
                }
            }
            if position > 0 && delay::Span::seconds > 0.rat() && !prior_failed.ready() {
                let origins is @Future<bool> = [
                    TcpRaceDelay(clock: clock, delay: delay).ready(),
                    TcpRaceSignal(prior_failed).ready()
                ];
                let pending = Raced(origins: origins).winner();
                waiting.start(pending);
                await pending;
            }
            started.set();
            let pending = TcpConnecting(remote: endpoint, options: options).connection();
            raw.replace([pending]);
            connecting.start(pending);
            TcpRaceWin(position: position, connection: await pending);
        }
        catch e is Cancelled {
            throw;
        }
        catch e is Error {
            started.set();
            failed.set();
            throw;
        }
        catch e is NativeFailure {
            started.set();
            failed.set();
            throw;
        }
    }

    async dispose(keep is @int) is void {
        for raw.value() -> pending {
            let acquired is @TcpConnection = try {
                [await pending];
            }
            catch e is Cancelled {
                let empty is @TcpConnection = [];
                empty;
            }
            catch e is Error {
                let empty is @TcpConnection = [];
                empty;
            }
            catch e is NativeFailure {
                let empty is @TcpConnection = [];
                empty;
            };
            for acquired -> connection {
                if keep.size() == 0 || position != keep[0] {
                    connection.close();
                }
            }
        }
    }
}

hidden object TcpRaceDelay {
    has clock is Timing;
    has delay is Duration;

    TcpRaceDelay(clock is Timing, delay is Duration) {
        self.clock = clock;
        self.delay = delay;
    }

    async ready() is bool {
        await clock.wait(delay);
        true;
    }
}

hidden object TcpRaceSignal {
    has gate is Event;

    TcpRaceSignal(gate is Event) {
        self.gate = gate;
    }

    async ready() is bool {
        await gate.wait();
        true;
    }
}

hidden object TcpRaceAttemptCleanup {
    has waiting is FutureGroup<bool>;
    has connecting is FutureGroup<TcpConnection>;

    TcpRaceAttemptCleanup(waiting is FutureGroup<bool>, connecting is FutureGroup<TcpConnection>) {
        self.waiting = waiting;
        self.connecting = connecting;
    }

    async close() is void {
        if waiting.active() > 0 {
            waiting.cancel();
            defer await waiting.wait();
        }
        if connecting.active() > 0 {
            connecting.cancel();
            defer await connecting.wait();
        }
    }
}

hidden object TcpRaceCleanup {
    has group is FutureGroup<TcpRaceWin>;
    has attempts is @TcpRaceAttempt;
    has keeper is Atomic<@int>;
    has published is Event;

    TcpRaceCleanup(
        group is FutureGroup<TcpRaceWin>,
        attempts is @TcpRaceAttempt,
        keeper is Atomic<@int>,
        published is Event
    ) {
        self.group = group;
        self.attempts = attempts;
        self.keeper = keeper;
        self.published = published;
    }

    async close() is void {
        if group.active() > 0 {
            group.cancel();
            defer await group.wait();
        }
        let keep is @int = if published.ready() {
            keeper.value();
        }
        else {
            let empty is @int = [];
            empty;
        };
        for attempts -> attempt {
            await attempt.dispose(keep);
        }
    }
}

enum InvalidTcpRace is Error = (because(reason is string));

test "the race keeps the first family first and interleaves the other" {
    let four = IpEndpoint(address: IpAddress("127.0.0.1"), port: 80);
    let six = IpEndpoint(address: IpAddress("::1"), port: 80);
    let ordered = TcpRaceEndpoints([four, four, six]).items();
    test.is(ordered.size(), 3);
    test.is(ordered.item(1) == six, true);
}

async test "a listener on a port; connections by address and by host name" {
    let listener = await TcpListening(port: 0).listener();
    defer listener.close();
    let port = listener::Local::port;
    test.is(port > 0, true);
    test.is(listener.local_endpoint().address().string(), "127.0.0.1");
    let accepting is async () is TcpConnection = listener.connection;

    let first = spawn accepting();
    let by_address = await TcpConnecting(address: IpAddress("127.0.0.1"), port: port, no_delay: true).connection();
    defer by_address.close();
    let served = await first;
    defer served.close();
    test.is(by_address.endpoints().remote_endpoint()::Parts::port, port);

    let names = FixedResolution(HostAddresses(host: HostName("db.local"), addresses: [IpAddress("127.0.0.1")]));
    let second = spawn accepting();
    let by_name = await TcpConnecting(host: "db.local", port: port, resolver: names).connection();
    defer by_name.close();
    let other = await second;
    defer other.close();
    test.is(by_name.endpoints().remote_endpoint().address().string(), "127.0.0.1");

    test.throws(InvalidArgument) {
        TcpConnecting(host: "", port: port);
    };
    test.throws(InvalidArgument) {
        TcpConnecting(address: IpAddress("127.0.0.1"), port: 0);
    };
}
