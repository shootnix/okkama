// Accepts one connection, reads what the client says and answers pong.
hidden object TlsTestServer {
    has listener is tcp.TcpListener;
    has policy is TlsServerPolicy;

    TlsTestServer(listener is tcp.TcpListener, policy is TlsServerPolicy) {
        self.listener = listener;
        self.policy = policy;
    }

    async serve() is string {
        let accepted = await listener.connection();
        let secure = await TlsServerHandshake(
            origin: accepted,
            policy: policy,
            protocols: ["h2", "http/1.1"]
        ).connection();
        defer secure.close();
        let heard = Utf8Decoded(await secure.read_bytes(1024)).string();
        await secure.write_bytes(ByteSnapshot(Utf8Encoded("pong").bytes()));
        heard + " " + secure.details()::Session::protocol;
    }
}

async test "a TLS server answers a client that trusts its CA" {
    let identity = TlsIdentity(certificates: TLS_TEST_CERTIFICATE, key: TLS_TEST_KEY);
    let listener = await tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = TlsTestServer(listener: listener, policy: TlsServerPolicy(identity: identity));
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let plain = await tcp.TcpConnecting(
        address: IpAddress("127.0.0.1"),
        port: listener::Local::port
    ).connection();
    let versions is Set<TlsVersion> = OrderedSet([TlsVersion.tls1_2, TlsVersion.tls1_3]);
    let client = await TlsClientHandshake(
        origin: plain,
        server: roots.IpCertificateIdentity(IpAddress("127.0.0.1")),
        policy: TlsClientPolicy(
            trust: roots.PemTrustStore(TLS_TEST_CA),
            versions: versions,
            protocols: ["http/1.1"]
        )
    ).connection();
    defer client.close();
    await client.write_bytes(ByteSnapshot(Utf8Encoded("ping").bytes()));
    test.is(Utf8Decoded(await client.read_bytes(1024)).string(), "pong");
    test.is(client.details()::Session::protocol, "http/1.1");
    test.is(await serving, "ping http/1.1");
}

test "a TLS identity takes PEM certificates and a PKCS #8 key" {
    let identity = TlsIdentity(certificates: TLS_TEST_CERTIFICATE + TLS_TEST_CA, key: TLS_TEST_KEY);
    test.is(identity.chain().size(), 2);
    test.throws(InvalidTlsIdentity) {
        TlsIdentity(certificates: TLS_TEST_KEY, key: TLS_TEST_KEY);
    };
    test.throws(InvalidTlsIdentity) {
        TlsIdentity(certificates: TLS_TEST_CERTIFICATE, key: TLS_TEST_CERTIFICATE);
    };
    test.throws(InvalidTlsIdentity) {
        TlsIdentity(certificates: "", key: TLS_TEST_KEY);
    };
}
