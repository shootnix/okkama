module net/endpoint v1.0.0;

// Where to connect: a host name or an address, and a port.
//
//     let site = HostEndpoint(HostName("bücher.example"), 443);
//     site.host().ascii();                  // "xn--bcher-kva.example"
//     let local = IpEndpoint(IpAddress("127.0.0.1"), 8080);
//
// HostName checks the name and keeps its ASCII (IDNA) and Unicode forms.

import "net/ip" take IpAddress, IpVersion;
import "compare" take Comparing, Order;
import "runtime/idna" take hostname_ascii, hostname_unicode;

// A host name, checked, in its ASCII and Unicode forms.
object HostName does Comparing<HostName> {
    has ascii, unicode is string;

    // Reads origin in either form; anything that is not a host name is
    // InvalidHostName.
    HostName(origin is string) {
        confirm origin.length() > 0 && origin.length() <= 1024
            else throw InvalidHostName.origin(origin);
        let encoded = try {
            hostname_ascii(origin);
        }
        catch failure is NativeFailure {
            if failure.domain() == "core.idna" && failure.code() == "invalid_input" {
                throw InvalidHostName.origin(origin);
            }
            throw;
        };
        ascii = encoded;
        unicode = hostname_unicode(encoded);
    }

    // The ASCII form, with punycode labels: what goes on the wire.
    ascii() is string {
        ascii;
    }

    // The Unicode form: what people read.
    unicode() is string {
        unicode;
    }

    // Orders by the ASCII form.
    order(other is HostName) is Order {
        ascii.order(other.ascii());
    }
}

// A host name and a port.
object HostEndpoint {
    has host is HostName;
    has port is int;

    // host at port 0 to 65535.
    HostEndpoint(host is HostName, port is int) {
        confirm port >= 0 && port <= 65535 else throw InvalidPort.port(port);
        self.host = host;
        self.port = port;
    }

    // HostEndpoint(host: "api.example.test", port: 443).
    HostEndpoint(host is string, port is int) {
        confirm port >= 0 && port <= 65535 else throw InvalidPort.port(port);
        self.host = HostName(host);
        self.port = port;
    }

    // The host.
    host() is HostName {
        host;
    }

    // `host:port`.
    string() is string {
        host.ascii() + ":" + port.string();
    }

    // The port.
    cap Parts {
        port is int {
            port;
        }
    }
}

// Text that is not a host name.
enum InvalidHostName is Error = (origin(origin is string));

// Immutable numeric endpoint. Construction performs no DNS, interface lookup,
// service lookup or socket I/O. The original IpAddress stays undecorated.
// Ports are 0..65535. Zero represents an OS-assigned bind request; a consuming
// connect/send operation must reject it when a destination port is required.
//
//     IpEndpoint(IpAddress("fe80::1"),443,"eth0").string();
//     // "[fe80::1%eth0]:443"
//
// Empty zone means absent. Nonempty zones require IPv6 and ASCII letters,
// digits or -._~. This portable spelling subset preserves case/leading zeros;
// it does not assert that the interface exists. Numeric zones stay strings.
// string() is endpoint display text with a literal %, not a URI serializer.
// Validation reports InvalidPort before InvalidIpv6Zone if both are invalid.
object IpEndpoint {
    has origin is IpAddress;
    has number is int;
    has scope is string;

    // address at port 0 to 65535.
    IpEndpoint(address is IpAddress, port is int) {
        confirm port >= 0 && port <= 65535 else throw InvalidPort.port(port);
        origin = address;
        number = port;
        scope = "";
    }

    // An IPv6 link-local address in zone, at port.
    IpEndpoint(address is IpAddress, port is int, zone is string) {
        confirm port >= 0 && port <= 65535 else throw InvalidPort.port(port);
        confirm zone == "" || address.version() == IpVersion.v6
            else throw InvalidIpv6Zone.origin(zone);
        let valid = (0..zone.length()).reduce(true) -> valid, index {
            valid
                && "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~"
                .split(zone.slice(index, index + 1)).size() == 2;
        };
        confirm valid else throw InvalidIpv6Zone.origin(zone);
        origin = address;
        number = port;
        scope = zone;
    }

    // The address.
    address() is IpAddress {
        origin;
    }

    // `1.2.3.4:80` or `[::1]:80`.
    string() is string {
        let host = origin.string();
        let scoped = if scope == "" {
            host;
        }
        else {
            host + "%" + scope;
        };
        let formatted = if origin.version() == IpVersion.v6 {
            "[" + scoped + "]";
        }
        else {
            host;
        };
        formatted + ":" + number.string();
    }

    // The port and the IPv6 zone ("" when absent).
    cap Parts {
        port is int {
            number;
        }

        zone is string {
            scope;
        }
    }
}

// Invalid numeric port, preserving the attempted value for structured handling.
enum InvalidPort is Error = (port(port is int));

// Zone spelling or family failure. The diagnostic preserves the input verbatim.
enum InvalidIpv6Zone is Error = (origin(origin is string));

test "zone diagnostic preserves exact spelling" {
    test.is(InvalidIpv6Zone.origin("bad%zone").text(), "InvalidIpv6Zone.origin(\"bad%zone\")");
}

test "IPv6 endpoint formatting keeps scope outside the bare address" {
    let endpoint = IpEndpoint(address: IpAddress("fe80::1"), port: 443, zone: "eth0");
    test.is(endpoint.string(), "[fe80::1%eth0]:443");
    test.is(endpoint.address().string(), "fe80::1");
}

test "hostnames canonicalize through nontransitional IDNA before endpoint formatting" {
    test.is(HostEndpoint(host: HostName("BÜCHER.example"), port: 443).string(), "xn--bcher-kva.example:443");
    test.is(HostName("faß.de").unicode(), "faß.de");
}
