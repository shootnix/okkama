module net/stream v1.0.0;

// Immutable observations of the two ends of a connection. No resolution or
// connection occurs; exact values and direction are preserved for any common T.
//
//     let ends is ConnectionEndpoints<string>=ConnectionEndpoints("here","there");
//     ends.local_endpoint();  // "here"
//     ends.remote_endpoint(); // "there"

import "io/stream" take AsyncReading, AsyncWriting, ByteSource, Closing, InvalidReadLimit;
import "io/decorators" take ByteSnapshot;
import "encoding/utf" take Utf8Encoded;
import "runtime/network" as network;
import "net/failure" take NetworkClosed, NetworkError, NetworkOperation, NetworkFailure,
    NetworkFailureKind;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "strings/parse" take Number;
import "async/lock" take Lock, LockGuard;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "error" take InvalidState, InvalidArgument;
import "runtime/tls_transport" as tls;

// The two ends of a connection.
object ConnectionEndpoints<T> {
    has local is T;
    has remote is T;

    // local and remote ends.
    ConnectionEndpoints(local is T, remote is T) {
        self.local = local;
        self.remote = remote;
    }

    // This end.
    local_endpoint() is T {
        local;
    }

    // The other end.
    remote_endpoint() is T {
        remote;
    }
}

// Owned nonblocking IP stream. The native state is private; halves borrow this
// owner and share shutdown/queue identity across independently obtained views.
object StreamConnection does Closing {
    has state is network.SocketState;
    has ends is ConnectionEndpoints<IpEndpoint>;
    has writer_lock is Lock;
    has writer_count is Atomic<int>;
    has writer_closed is Event;
    has reader_busy is Atomic<bool>;

    // A connection over a runtime socket; TCP and TLS make them.
    StreamConnection(state is network.SocketState) {
        let snapshots = try {
            let local = network.tcp_endpoint(state, false);
            let remote = network.tcp_endpoint(state, true);
            ConnectionEndpoints(
                local: IpEndpoint(IpAddress(local[0]), Number(local[1]).int(), local[2]),
                remote: IpEndpoint(IpAddress(remote[0]), Number(remote[1]).int(), remote[2])
            );
        }
        catch e is NativeFailure {
            network.close(state);
            throw;
        }
        catch e is Error {
            network.close(state);
            throw;
        };
        self.state = state;
        ends = snapshots;
        writer_lock = Lock();
        writer_count = Atomic(0);
        writer_closed = Event();
        reader_busy = Atomic(false);
    }

    // The reading side.
    input() is StreamReading {
        StreamReading(self);
    }

    // The writing side.
    output() is StreamWriting {
        StreamWriting(self);
    }

    // Its two ends.
    endpoints() is ConnectionEndpoints<IpEndpoint> {
        ends;
    }

    // Whether the connection is closed.
    closed() is bool {
        network.closed(state);
    }

    // Closes the connection; closing again does nothing.
    close() is void {
        try {
            network.close(state);
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.closing, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }

    destroy {
        network.close(state);
    }

    // Whether the reading side is closed.
    input_closed() is bool {
        network.closed(state) || network.stream_half_closed(state, false);
    }

    // Used by input() and output(); programs read and write through those.
    close_input() is void {
        try {
            network.stream_shutdown(state, false);
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.shutting_down, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }

    // Used by input() and output(); programs read and write through those.
    async read_bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        confirm !self.input_closed() else throw NetworkClosed.closed;
        confirm reader_busy.compare_and_replace(false, true)
            else throw InvalidState.because("stream already has a pending read");
        let ticket = StreamReadTicket(reader_busy);
        defer ticket.close();
        try {
            let pending = network.stream_read(state, limit);
            await pending;
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.reading, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }

    // Whether the writing side is closed.
    output_closed() is bool {
        writer_closed.ready() || network.closed(state) || network.stream_half_closed(state, true);
    }

    // Used by input() and output(); programs read and write through those.
    close_output() is void {
        writer_closed.set();
        if writer_count.value() == 0 {
            self.shutdown_output();
        }
    }

    // Sends the end of the stream; the other side reads to its end.
    shutdown_output() is void {
        try {
            network.stream_shutdown(state, true);
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.shutting_down, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
    }

    // Used by input() and output(); programs read and write through those.
    reserve_output() is void {
        confirm !self.output_closed() else throw NetworkClosed.closed;
        confirm writer_count.value() < 9007199254740991
            else throw NetworkFailure.detailed(
                NetworkOperation.writing,
                NetworkFailureKind.resource_exhausted,
                "stream write queue is exhausted"
            );
        writer_count.replace(writer_count.value() + 1);
    }

    // Used by input() and output(); programs read and write through those.
    released_output() is void {
        writer_count.replace(writer_count.value() - 1);
        if writer_count.value() == 0 && writer_closed.ready() {
            self.shutdown_output();
        }
    }

    // Used by input() and output(); programs read and write through those.
    async write_bytes(source is ByteSource) is bool {
        self.reserve_output();
        let ticket = StreamWriteTicket(self.output());
        defer ticket.close();
        if !writer_lock.locked() {
            // A free lock grants its guard at once on every engine: there is
            // no wait to supervise, only the write itself (#503).
            let guard = await writer_lock.guard();
            defer guard.close();
            let writing is FutureGroup<bool> = FutureGroup();
            let settling = StreamWritingCleanup(writing);
            defer await settling.close();
            confirm !network.closed(state) && !network.stream_half_closed(state, true)
                else throw NetworkClosed.closed;
            let payload = source.bytes();
            try {
                let pending = network.stream_write(state, payload);
                writing.start(pending);
                await pending;
            }
            catch e is NativeFailure {
                let translated = StreamFailure(operation: NetworkOperation.writing, failure: e);
                if translated.applicable() {
                    throw translated.error();
                }
                throw;
            }
            return true;
        }
        let guards is FutureGroup<LockGuard> = FutureGroup();
        let writing is FutureGroup<bool> = FutureGroup();
        let empty is @Future<LockGuard> = [];
        let pending_guard = Atomic(empty);
        let taken = Event();
        let cleanup = StreamWriteCleanup(
            guards: guards,
            writing: writing,
            pending: pending_guard,
            taken: taken
        );
        defer await cleanup.close();
        let waiting = writer_lock.guard();
        pending_guard.replace([waiting]);
        guards.start(waiting);
        let guard = await waiting;
        taken.set();
        defer guard.close();
        confirm !network.closed(state) && !network.stream_half_closed(state, true)
            else throw NetworkClosed.closed;
        let payload = source.bytes();
        try {
            let pending = network.stream_write(state, payload);
            writing.start(pending);
            await pending;
        }
        catch e is NativeFailure {
            let translated = StreamFailure(operation: NetworkOperation.writing, failure: e);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        }
        true;
    }

    // Execute the existing consume/upgrade operation; never export SocketState.
    upgrade_tls(versions is int, protocols is @string, server is string) is tls.TlsState {
        confirm !reader_busy.value() && writer_count.value() == 0 && !writer_closed.ready()
            else throw InvalidState.because("TLS requires drained TCP operations");
        tls.client(state, versions, protocols, server);
    }

    // The server side of TLS over an accepted connection (#209).
    upgrade_tls_server(versions is int, protocols is @string, certificates is @@byte, key is @byte) is tls.TlsState {
        confirm !reader_busy.value() && writer_count.value() == 0 && !writer_closed.ready()
            else throw InvalidState.because("TLS requires drained TCP operations");
        tls.server(state, versions, protocols, certificates, key);
    }
}

// Internal upgrade bridge: capture private capabilities synchronously, check
// queued/pending operations at actual startup, then consume the native owner.
object TlsTcpOrigin {
    has input is StreamReading;

    // The TCP side a TLS session starts from; net/tls uses it.
    TlsTcpOrigin(input is StreamReading) {
        self.input = input;
    }

    // Starts a client session.
    client(versions is int, protocols is @string, server is string) is tls.TlsState {
        input.tls_client(versions, protocols, server);
    }

    // Starts a server session.
    server(versions is int, protocols is @string, certificates is @@byte, key is @byte) is tls.TlsState {
        input.tls_server(versions, protocols, certificates, key);
    }
}

// The reading side of a connection.
object StreamReading does AsyncReading, Closing {
    has owner is StreamConnection;

    // Made by input(); not constructed directly.
    StreamReading(owner is StreamConnection) {
        self.owner = owner;
    }

    // Whether the reading side is closed.
    closed() is bool {
        owner.input_closed();
    }

    // Closes the reading side; closing again does nothing.
    close() is void {
        owner.close_input();
    }

    // At most limit bytes once they come; [] when the other side has finished.
    async bytes(limit is int) is @byte {
        await owner.read_bytes(limit);
    }

    // Starts a TLS client session on this connection; net/tls uses it.
    tls_client(versions is int, protocols is @string, server is string) is tls.TlsState {
        owner.upgrade_tls(versions, protocols, server);
    }

    // Starts a TLS server session on this connection; net/tls uses it.
    tls_server(versions is int, protocols is @string, certificates is @@byte, key is @byte) is tls.TlsState {
        owner.upgrade_tls_server(versions, protocols, certificates, key);
    }
}

// The writing side of a connection.
object StreamWriting does AsyncWriting, Closing {
    has owner is StreamConnection;

    // Made by output(); not constructed directly.
    StreamWriting(owner is StreamConnection) {
        self.owner = owner;
    }

    // Whether the writing side is closed.
    closed() is bool {
        owner.output_closed();
    }

    // Closes the writing side; closing again does nothing.
    close() is void {
        owner.close_output();
    }

    // Sends the end of the stream.
    shutdown() is void {
        owner.shutdown_output();
    }

    // Used by input() and output(); programs read and write through those.
    reserve() is void {
        owner.reserve_output();
    }

    // Used by input() and output(); programs read and write through those.
    released() is void {
        owner.released_output();
    }

    // Writes the bytes of source once the network takes them.
    async write(source is ByteSource) is AsyncWriting {
        await owner.write_bytes(source);
        self;
    }

    // Writes the bytes once the network takes them.
    async write(bytes is @byte) is AsyncWriting {
        await owner.write_bytes(ByteSnapshot(bytes));
        self;
    }

    // Text, as UTF-8: await connection.output().write("hello\n").
    async write(values is ...string) is AsyncWriting {
        let text is @string = values...;
        await owner.write_bytes(Utf8Encoded(text.join("")));
        self;
    }
}

hidden object StreamWriteTicket {
    has owner is StreamWriting;

    StreamWriteTicket(owner is StreamWriting) {
        self.owner = owner;
    }

    close() is void {
        owner.released();
    }
}

hidden object StreamReadTicket {
    has busy is Atomic<bool>;

    StreamReadTicket(busy is Atomic<bool>) {
        self.busy = busy;
    }

    close() is void {
        busy.replace(false);
    }
}

// The write of an uncontended writer: cancelled, it waits for the native
// write to settle.
hidden object StreamWritingCleanup {
    has writing is FutureGroup<bool>;

    StreamWritingCleanup(writing is FutureGroup<bool>) {
        self.writing = writing;
    }

    async close() is void {
        if writing.active() > 0 {
            writing.cancel();
            await writing.wait();
        }
    }
}

// Waits for writes still in flight when a connection closes; used inside std.
object StreamWriteCleanup {
    has guards is FutureGroup<LockGuard>;
    has writing is FutureGroup<bool>;
    has pending is Atomic<@Future<LockGuard>>;
    has taken is Event;

    // The writes to wait for.
    StreamWriteCleanup(
        guards is FutureGroup<LockGuard>,
        writing is FutureGroup<bool>,
        pending is Atomic<@Future<LockGuard>>,
        taken is Event
    ) {
        self.guards = guards;
        self.writing = writing;
        self.pending = pending;
        self.taken = taken;
    }

    // Waits for them.
    async close() is void {
        if guards.active() > 0 {
            guards.cancel();
            defer await guards.wait();
        }
        if writing.active() > 0 {
            writing.cancel();
            defer await writing.wait();
        }
        // Grant can win just before cancellation reaches the adapted Future.
        // Its successful result is then owned, even though no caller bound it.
        if !taken.ready() {
            for pending.value() -> waiting {
                let granted is @LockGuard = try {
                    [await waiting];
                }
                catch e is Cancelled {
                    let empty is @LockGuard = [];
                    empty;
                };
                for granted -> guard {
                    guard.close();
                }
            }
        }
    }
}

// A runtime failure of a stream, as the error it means.
object StreamFailure {
    has operation is NetworkOperation;
    has failure is NativeFailure;

    // The failure of operation.
    StreamFailure(operation is NetworkOperation, failure is NativeFailure) {
        self.operation = operation;
        self.failure = failure;
    }

    // Whether it is a stream failure.
    applicable() is bool {
        NetworkError(operation: operation, failure: failure).applicable();
    }

    // The error.
    error() is Error {
        confirm self.applicable()
            else throw InvalidArgument.because(
                "native failure is not a terminal managed stream failure"
            );
        if failure.domain() == "core.net" && failure.code() == "already_closed" {
            return NetworkClosed.closed;
        }
        NetworkError(operation: operation, failure: failure).error();
    }
}

test "connection endpoint observations preserve direction" {
    let endpoints is ConnectionEndpoints<string> = ConnectionEndpoints(
        local: "local",
        remote: "remote"
    );
    test.is(endpoints.local_endpoint(), "local");
    test.is(endpoints.remote_endpoint(), "remote");
}
