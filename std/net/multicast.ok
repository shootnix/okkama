module net/multicast v1.0.0;

// Immutable multicast send-option request. Defaults request one hop and local
// delivery; loopback does not select a loopback network interface. Values are
// independent, and hop limits include both 0 and 255. There is no host-default
// sentinel, clamping or wrapping. Construction performs no socket I/O.
// Membership acquisition applies these settings and reports host failures.
// The first successful join pins the policy for the socket's remaining life.
//
//     let options=MulticastOptions(hop_limit:1,loopback:false);
//     options.hop_limit(); // 1

import "error" take InvalidArgument;
import "net/udp" take UdpSocket, UdpMembership;
import "net/ip" take IpAddress, IpVersion, IpProperty;
import "net/interface" take NetworkInterface;
import "net/failure" take NetworkClosed, NetworkError, NetworkOperation;
import "runtime/network";
import "runtime/net" take ip_parse;

// How multicast is sent: hop limit and loopback.
object MulticastOptions {
    has hops is int;
    has local_delivery is bool;

    // Hop limit 1, loopback on.
    MulticastOptions() {
        hops = 1;
        local_delivery = true;
    }

    // The options as given; hop_limit is 0 to 255.
    MulticastOptions(hop_limit is int, loopback is bool) {
        confirm hop_limit >= 0 && hop_limit <= 255
            else throw InvalidArgument.because(
                "multicast hop limit must be in 0..255: " + hop_limit.string()
            );
        hops = hop_limit;
        local_delivery = loopback;
    }

    // How many routers a datagram may cross.
    hop_limit() is int {
        hops;
    }

    // Whether this host hears its own sends.
    loopback() is bool {
        local_delivery;
    }
}

// An address that is not a multicast group.
enum InvalidMulticastGroup is Error = (origin(origin is string));

// Pure validated request. Every membership() call attempts a new acquisition;
// a duplicate live group fails. The socket is retained, never transferred.
object MulticastJoining {
    has socket is UdpSocket;
    has group is IpAddress;
    has interface is NetworkInterface;
    has options is MulticastOptions;

    // Joins group on interface with socket.
    MulticastJoining(
        socket is UdpSocket,
        group is IpAddress,
        interface is NetworkInterface,
        options is MulticastOptions
    ) {
        confirm group.properties().membership(IpProperty.multicast)
            else throw InvalidMulticastGroup.origin(group.string());
        self.socket = socket;
        self.group = group;
        self.interface = interface;
        self.options = options;
    }

    // Joins and gives the membership.
    membership() is MulticastMembership {
        MulticastMembership(socket: socket, group: group, interface: interface, options: options);
    }
}

// Owned any-source membership on the exact socket. Constructor is acquisition
// infrastructure for MulticastJoining.membership(), like fs/lock.FileLock.
// Observations survive close; aliases share closure. Retaining this object
// retains the parent owner. Closing it leaves once, keeping the socket open;
// closing the socket implicitly ends all memberships. Failed leave closes the
// parent to guarantee cleanup and reports the original failure.
object MulticastMembership does UdpMembership {
    has lease is UdpMembership;
    has owner is UdpSocket;
    has joined is IpAddress;
    has device is NetworkInterface;

    // A joined group.
    MulticastMembership(
        socket is UdpSocket,
        group is IpAddress,
        interface is NetworkInterface,
        options is MulticastOptions
    ) {
        confirm group.properties().membership(IpProperty.multicast)
            else throw InvalidMulticastGroup.origin(group.string());
        lease = try {
            socket.membership(group, interface, options.hop_limit(), options.loopback());
        }
        catch failure is NativeFailure {
            if failure.domain() == "core.net" && failure.code() == "already_closed" {
                throw NetworkClosed.closed;
            }
            if failure.domain() == "core.net" && failure.code() == "invalid_input" {
                throw InvalidArgument.because(failure.message());
            }
            let translated = NetworkError(operation: NetworkOperation.binding, failure: failure);
            if translated.applicable() {
                throw translated.error();
            }
            throw;
        };
        owner = socket;
        joined = group;
        device = interface;
    }

    // The group.
    group() is IpAddress {
        joined;
    }

    // The interface.
    interface() is NetworkInterface {
        device;
    }

    // Whether the membership is closed.
    closed() is bool {
        lease.closed();
    }

    // Closes the membership; closing again does nothing.
    close() is void {
        lease.close();
    }

    destroy {
        self.close();
    }
}

test "multicast defaults agree with explicit requests" {
    test.ok(MulticastOptions() == MulticastOptions(hop_limit: 1, loopback: true));
}

test "multicast hop boundaries and loopback are independent" {
    let local = MulticastOptions(hop_limit: 0, loopback: false);
    let widest = MulticastOptions(loopback: true, hop_limit: 255);
    test.is(local.hop_limit(), 0);
    test.ok(!local.loopback());
    test.is(widest.hop_limit(), 255);
    test.ok(widest.loopback());
}

test "multicast hop limit rejects host default and overflow" {
    let negative = try {
        MulticastOptions(hop_limit: -1, loopback: true);
        false;
    }
    catch failure is InvalidArgument {
        true;
    };
    let overflow = try {
        MulticastOptions(hop_limit: 256, loopback: false);
        false;
    }
    catch failure is InvalidArgument {
        true;
    };
    test.ok(negative && overflow);
}

test "invalid multicast group diagnostic preserves canonical address" {
    let failure = InvalidMulticastGroup.origin((IpAddress("2001:0db8::1")).string());
    test.is(failure.text(), "InvalidMulticastGroup.origin(\"2001:db8::1\")");
}
