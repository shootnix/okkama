module net/tcp_racing v1.0.0;

import "net/tcp" take TcpConnection, TcpOptions, TcpEndpointRace, InvalidTcpRace;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "collections/sequence" take Sequencing;
import "time/clock" take Timing;
import "time/duration" take Duration;

// Happy Eyeballs over numeric candidates (RFC 8305): attempts start a stagger
// apart, families interleave, and the first connection wins while the others
// are cancelled and closed. The engine lives in net/tcp, where
// TcpConnecting(host:, port:) races the resolver's addresses the same way.
object TcpRacing {
    has race is TcpEndpointRace;

    TcpRacing(origins is Sequencing<IpEndpoint>) {
        race = TcpEndpointRace(origins);
    }

    TcpRacing(
        origins is Sequencing<IpEndpoint>,
        options is TcpOptions,
        delay is Duration,
        clock is Timing
    ) {
        race = TcpEndpointRace(origins: origins, options: options, delay: delay, clock: clock);
    }

    async connection() is TcpConnection {
        await race.connection();
    }
}

test "TCP racing rejects an empty candidate list" {
    test.ok(try {
        TcpRacing([]);
        false;
    }
    catch e is InvalidTcpRace {
        true;
    });
}
