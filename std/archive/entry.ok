module archive/entry v1.0.0;

// Immutable archive member values, with already-bound paths and metadata.
// No filesystem reads, extraction, link resolution, permission changes or
// device creation. File data is an immutable byte snapshot already in memory;
// aggregate limits belong to the archive reader. No owned resources.
//
//     let entry = ArchiveFile(path, metadata, [byte(0), byte(255)]);
//     entry.data();       // exact bytes, repeatable, no I/O
//     entry.accept(to);   // exactly one to.file(entry) event
//
// Only ArchiveFile has data(). Links have target(); devices have major/minor.
// A symbolic target is relative to the link's parent; a hard target is relative
// to the archive root. Both use the strict ArchivePath grammar: no absolute or
// parent-traversing targets. This subset neither resolves links nor proves safe
// extraction. Cycles, existence and destination containment are checked later.
//
// accept() passes the concrete value unchanged to one nominal visitor action.
// The visitor controls effects, may retain entries, and its errors propagate.
// Repeated accepts repeat the event without consuming data or traversing links.
// The role fake emits an empty file named entry with UTC epoch metadata.

import "archive/path" take ArchivePath;
import "encoding/utf" take Utf8Encoded;
import "archive/metadata" take ArchiveMetadata, ArchiveModificationFromEpoch;

// What an archive member is.
enum ArchiveEntryKind = (file, directory, symbolic_link, hard_link, fifo, character_device, block_device);

// A member of an archive: a name, a kind, metadata and a visitor callback.
role ArchiveEntry {
    // Its name in the archive.
    path() is ArchivePath;
    // What it is.
    kind() is ArchiveEntryKind;
    // Its mode, time, owner and comment.
    metadata() is ArchiveMetadata;
    // Calls the visitor's one callback for this kind.
    accept(to is ArchiveEntryVisitor) is void;

    fake {
        path() is ArchivePath {
            ArchivePath("entry");
        }

        kind() is ArchiveEntryKind {
            ArchiveEntryKind.file;
        }

        metadata() is ArchiveMetadata {
            ArchiveMetadata(modified: ArchiveModificationFromEpoch(0.rat()).local_date_time(), comment: "");
        }

        accept(to is ArchiveEntryVisitor) is void {
            to.file(ArchiveFile(path: self.path(), metadata: self.metadata(), data: []));
        }
    }
}

// Typed variant dispatch for consumers of heterogeneous ArchiveEntry values.
// These actions receive concrete values, so no reflection/downcast is needed
// to obtain file bytes, link targets or device numbers.
role ArchiveEntryVisitor {
    // A regular file.
    file(entry is ArchiveFile) is void;
    // A directory.
    directory(entry is ArchiveDirectory) is void;
    // A symbolic link.
    symbolic_link(entry is ArchiveSymbolicLink) is void;
    // A hard link.
    hard_link(entry is ArchiveHardLink) is void;
    // A named pipe.
    fifo(entry is ArchiveFifo) is void;
    // A character or block device.
    device(entry is ArchiveDevice) is void;
}

// A regular file and its bytes.
object ArchiveFile does ArchiveEntry {
    has origin is ArchivePath;
    has attributes is ArchiveMetadata;
    has content is @byte;

    // path with metadata and data.
    ArchiveFile(path is ArchivePath, metadata is ArchiveMetadata, data is @byte) {
        origin = path;
        attributes = metadata;
        content = data;
    }

    // Text content, as UTF-8: ArchiveFile(path:, metadata:, text: "Read me first.\n").
    ArchiveFile(path is ArchivePath, metadata is ArchiveMetadata, text is string) {
        origin = path;
        attributes = metadata;
        content = Utf8Encoded(text).bytes();
    }

    // Its name in the archive.
    path() is ArchivePath {
        origin;
    }

    // What it is.
    kind() is ArchiveEntryKind {
        ArchiveEntryKind.file;
    }

    // Its mode, time, owner and comment.
    metadata() is ArchiveMetadata {
        attributes;
    }

    // Its bytes, the same each time.
    data() is @byte {
        content;
    }

    // Calls the visitor's one callback for this kind.
    accept(to is ArchiveEntryVisitor) is void {
        to.file(self);
    }
}

// A directory.
object ArchiveDirectory does ArchiveEntry {
    has origin is ArchivePath;
    has attributes is ArchiveMetadata;

    // A directory at path.
    ArchiveDirectory(path is ArchivePath, metadata is ArchiveMetadata) {
        origin = path;
        attributes = metadata;
    }

    // Its name in the archive.
    path() is ArchivePath {
        origin;
    }

    // What it is.
    kind() is ArchiveEntryKind {
        ArchiveEntryKind.directory;
    }

    // Its mode, time, owner and comment.
    metadata() is ArchiveMetadata {
        attributes;
    }

    // Calls the visitor's one callback for this kind.
    accept(to is ArchiveEntryVisitor) is void {
        to.directory(self);
    }
}

// A symbolic link and its target.
object ArchiveSymbolicLink does ArchiveEntry {
    has origin, destination is ArchivePath;
    has attributes is ArchiveMetadata;

    // A link at path to target.
    ArchiveSymbolicLink(path is ArchivePath, metadata is ArchiveMetadata, target is ArchivePath) {
        origin = path;
        attributes = metadata;
        destination = target;
    }

    // Its name in the archive.
    path() is ArchivePath {
        origin;
    }

    // What it is.
    kind() is ArchiveEntryKind {
        ArchiveEntryKind.symbolic_link;
    }

    // Its mode, time, owner and comment.
    metadata() is ArchiveMetadata {
        attributes;
    }

    // Where it points, as stored.
    target() is ArchivePath {
        destination;
    }

    // Calls the visitor's one callback for this kind.
    accept(to is ArchiveEntryVisitor) is void {
        to.symbolic_link(self);
    }
}

// A second name for an earlier member.
object ArchiveHardLink does ArchiveEntry {
    has origin, destination is ArchivePath;
    has attributes is ArchiveMetadata;

    // A link at path to target.
    ArchiveHardLink(path is ArchivePath, metadata is ArchiveMetadata, target is ArchivePath) {
        origin = path;
        attributes = metadata;
        destination = target;
    }

    // Its name in the archive.
    path() is ArchivePath {
        origin;
    }

    // What it is.
    kind() is ArchiveEntryKind {
        ArchiveEntryKind.hard_link;
    }

    // Its mode, time, owner and comment.
    metadata() is ArchiveMetadata {
        attributes;
    }

    // The member it names.
    target() is ArchivePath {
        destination;
    }

    // Calls the visitor's one callback for this kind.
    accept(to is ArchiveEntryVisitor) is void {
        to.hard_link(self);
    }
}

// A named pipe.
object ArchiveFifo does ArchiveEntry {
    has origin is ArchivePath;
    has attributes is ArchiveMetadata;

    // A pipe at path.
    ArchiveFifo(path is ArchivePath, metadata is ArchiveMetadata) {
        origin = path;
        attributes = metadata;
    }

    // Its name in the archive.
    path() is ArchivePath {
        origin;
    }

    // What it is.
    kind() is ArchiveEntryKind {
        ArchiveEntryKind.fifo;
    }

    // Its mode, time, owner and comment.
    metadata() is ArchiveMetadata {
        attributes;
    }

    // Calls the visitor's one callback for this kind.
    accept(to is ArchiveEntryVisitor) is void {
        to.fifo(self);
    }
}

// Device metadata only: validate kind before numbers; preserve all nonnegative
// int coordinates without narrowing them to an OS-specific device identifier.
object ArchiveDevice does ArchiveEntry {
    has origin is ArchivePath;
    has entry_kind is ArchiveEntryKind;
    has attributes is ArchiveMetadata;
    has major_number, minor_number is int;

    // A character or block device with its major and minor numbers; another
    // kind is InvalidArchiveDevice.
    ArchiveDevice(
        path is ArchivePath,
        kind is ArchiveEntryKind,
        metadata is ArchiveMetadata,
        major is int,
        minor is int
    ) {
        confirm kind == ArchiveEntryKind.character_device || kind == ArchiveEntryKind.block_device
            else throw InvalidArchiveDevice.because("expected character or block kind");
        confirm major >= 0 && minor >= 0
            else throw InvalidArchiveDevice.because("negative device number");
        origin = path;
        entry_kind = kind;
        attributes = metadata;
        major_number = major;
        minor_number = minor;
    }

    // Its name in the archive.
    path() is ArchivePath {
        origin;
    }

    // character_device or block_device.
    kind() is ArchiveEntryKind {
        entry_kind;
    }

    // Its mode, time, owner and comment.
    metadata() is ArchiveMetadata {
        attributes;
    }

    // The major device number.
    major() is int {
        major_number;
    }

    // The minor device number.
    minor() is int {
        minor_number;
    }

    // Calls the visitor's device callback.
    accept(to is ArchiveEntryVisitor) is void {
        to.device(self);
    }
}

// A device of a kind that is not a device, or numbers out of range.
enum InvalidArchiveDevice is Error = (because(reason is string));

test "archive entries preserve the role coordinates and file bytes" {
    let source = ArchiveEntry.fake();
    let file = ArchiveFile(path: source.path(), metadata: source.metadata(), data: [byte(0), byte(255)]);
    let directory = ArchiveDirectory(path: source.path(), metadata: source.metadata());
    test.is(file.kind(), ArchiveEntryKind.file);
    test.is(directory.kind(), ArchiveEntryKind.directory);
    test.is(file.path(), directory.path());
    test.is(file.data(), [byte(0), byte(255)]);
    test.is(file.data(), [byte(0), byte(255)]);
}

test "archive symbolic and hard links keep distinct kinds" {
    let source = ArchiveEntry.fake();
    let symbolic = ArchiveSymbolicLink(path: source.path(), metadata: source.metadata(), target: source.path());
    let hard = ArchiveHardLink(path: source.path(), metadata: source.metadata(), target: source.path());
    test.ok(symbolic.kind() != hard.kind());
    test.is(symbolic.target(), hard.target());
    test.is(ArchiveFifo(path: source.path(), metadata: source.metadata()).kind(), ArchiveEntryKind.fifo);
}

test "archive devices reject contradictory kind and negative numbers" {
    let source = ArchiveEntry.fake();
    let device = ArchiveDevice(
        path: source.path(),
        kind: ArchiveEntryKind.block_device,
        metadata: source.metadata(),
        major: 0,
        minor: 7
    );
    test.is(device.major(), 0);
    test.is(device.minor(), 7);
    test.ok(try {
        ArchiveDevice(path: source.path(), kind: ArchiveEntryKind.file, metadata: source.metadata(), major: 0, minor: 0);
        false;
    }
    catch error is InvalidArchiveDevice {
        true;
    });
    test.ok(try {
        ArchiveDevice(path: source.path(), kind: ArchiveEntryKind.character_device, metadata: source.metadata(), major: -1, minor: 0);
        false;
    }
    catch error is InvalidArchiveDevice {
        true;
    });
}

test "a file entry takes text content" {
    let stamp = ArchiveMetadata(modified: ArchiveModificationFromEpoch(0.rat()).local_date_time(), comment: "");
    let file = ArchiveFile(path: ArchivePath("a.txt"), metadata: stamp, text: "hé");
    test.is(file.data(), [104.byte(), 195.byte(), 169.byte()]);
}
