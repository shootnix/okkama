module encoding/bytes v1.0.0;

import "encoding/utf" take ByteOrder, InvalidUtf8;
import "encoding/binary" take Signedness;
import "error" take InvalidArgument, OutOfRange;
import "runtime/bytes" take
    bytes_find,
    bytes_utf8_invalid,
    bytes_text,
    bytes_decimal_invalid,
    bytes_decimal,
    bytes_equal,
    bytes_integer_fits,
    bytes_integer;

// Parsing primitives over byte values: search and range views that read the
// bytes in place, without slicing them into new arrays first.
//
//     let frame is @byte = ...; // "VALUE key 0 5\r\nhello\r\n"
//     let eol is int = ByteSearch(frame, Utf8Encoded("\r\n").bytes()).from(0);
//     let space is int = ByteSearch(frame, [byte(32)]).from(10);
//     let size is int = ByteRange(frame, space + 1, eol).decimal();      // 5
//     let value is string = ByteRange(frame, eol + 2, eol + 2 + size).text();
//
// Offsets are byte offsets into the source. A range is start..end, end
// excluded. InvalidUtf8 and InvalidByteDecimal report offsets relative to the
// range start, as if the range were decoded on its own.

// The first byte at which a range stops being an ASCII decimal integer
// (optional leading '-', then at least one digit 0-9). An empty range, or a
// lone '-', fails at its end.
enum InvalidByteDecimal is Error = (at(offset is int));

object ByteSearch {
    has source is @byte;
    has pattern is @byte;

    ByteSearch(source is @byte, pattern is @byte) {
        confirm pattern.size() > 0
            else throw InvalidArgument.because("byte search pattern must not be empty");
        self.source = source;
        self.pattern = pattern;
    }

    // The first offset >= start at which the pattern begins, or -1.
    from(start is int) is int {
        confirm start >= 0 && start <= source.size()
            else throw OutOfRange.because("byte search start is outside the source");
        bytes_find(source, pattern, start);
    }
}

object ByteRange {
    has source is @byte;
    has start is int;
    has end is int;

    ByteRange(source is @byte, start is int, end is int) {
        confirm start >= 0 && start <= end && end <= source.size()
            else throw OutOfRange.because("byte range is outside the source");
        self.source = source;
        self.start = start;
        self.end = end;
    }

    size() is int {
        end - start;
    }

    // The range decoded as strict UTF-8.
    text() is string {
        let invalid is int = bytes_utf8_invalid(source, start, end);
        confirm invalid < 0 else throw InvalidUtf8.at(invalid);
        bytes_text(source, start, end);
    }

    // The range read as an ASCII decimal integer, such as "42" or "-7".
    decimal() is int {
        let invalid is int = bytes_decimal_invalid(source, start, end);
        confirm invalid < 0 else throw InvalidByteDecimal.at(invalid);
        bytes_decimal(source, start, end);
    }

    // The range, 1 to 8 bytes, read as one fixed-width integer, as
    // IntegerFromBytes(range.bytes(), signedness, order).value() reads it.
    integer(signedness is Signedness, order is ByteOrder) is int {
        confirm end > start && end - start <= 8
            else throw InvalidArgument.because("integer input width must be 1 to 8 bytes");
        let signed is bool = signedness == Signedness.signed;
        let big is bool = order == ByteOrder.big;
        confirm bytes_integer_fits(source, start, end, signed, big)
            else throw InvalidArgument.because("decoded integer is outside the int range");
        bytes_integer(source, start, end, signed, big);
    }

    // Whether the range holds exactly the bytes of other.
    equals(other is @byte) is bool {
        bytes_equal(source, start, end, other);
    }

    // A copy of the range.
    bytes() is @byte {
        source.slice(start, end);
    }
}

test "byte search finds patterns from an offset" {
    let source is @byte = [byte(97), byte(13), byte(10), byte(98), byte(13), byte(10)];
    let crlf is @byte = [byte(13), byte(10)];
    test.is(ByteSearch(source, crlf).from(0), 1);
    test.is(ByteSearch(source, crlf).from(2), 4);
    test.is(ByteSearch(source, crlf).from(5), -1);
    test.is(ByteSearch(source, crlf).from(6), -1);
    test.is(ByteSearch(source, [byte(98)]).from(0), 3);
    test.is(ByteSearch([], crlf).from(0), -1);
    test.is(try {ByteSearch(source, crlf).from(7); "found";} catch OutOfRange.because(reason) {reason;}, "byte search start is outside the source");
    test.is(try {ByteSearch(source, []).from(0); "found";} catch InvalidArgument.because(reason) {reason;}, "byte search pattern must not be empty");
}

test "byte ranges decode UTF-8 in place" {
    let source is @byte = [byte(120), byte(208), byte(175), byte(121), byte(255)];
    test.is(ByteRange(source, 1, 3).text(), "Я");
    test.is(ByteRange(source, 0, 4).text(), "xЯy");
    test.is(ByteRange(source, 2, 2).text(), "");
    test.is(try {ByteRange(source, 2, 4).text(); -1;} catch InvalidUtf8.at(offset) {offset;}, 0);
    test.is(try {ByteRange(source, 3, 5).text(); -1;} catch InvalidUtf8.at(offset) {offset;}, 1);
    test.is(try {ByteRange(source, 0, 2).text(); -1;} catch InvalidUtf8.at(offset) {offset;}, 1);
    test.is(try {ByteRange(source, 3, 6); "made";} catch OutOfRange.because(reason) {reason;}, "byte range is outside the source");
    test.is(try {ByteRange(source, 3, 2); "made";} catch OutOfRange.because(reason) {reason;}, "byte range is outside the source");
}

test "byte ranges read ASCII decimals" {
    let source is @byte = [byte(32), byte(52), byte(50), byte(32), byte(45), byte(55), byte(45), byte(48), byte(120)];
    test.is(ByteRange(source, 1, 3).decimal(), 42);
    test.is(ByteRange(source, 4, 6).decimal(), -7);
    test.is(ByteRange(source, 6, 8).decimal(), 0);
    test.is(try {ByteRange(source, 0, 3).decimal(); 0;} catch InvalidByteDecimal.at(offset) {offset;}, 0);
    test.is(try {ByteRange(source, 1, 4).decimal(); 0;} catch InvalidByteDecimal.at(offset) {offset;}, 2);
    test.is(try {ByteRange(source, 7, 9).decimal(); 0;} catch InvalidByteDecimal.at(offset) {offset;}, 1);
    test.is(try {ByteRange(source, 1, 1).decimal(); 0;} catch InvalidByteDecimal.at(offset) {offset;}, 0);
    test.is(try {ByteRange(source, 4, 5).decimal(); 0;} catch InvalidByteDecimal.at(offset) {offset;}, 1);
    test.is(try {ByteRange(source, 4, 7).decimal(); 0;} catch InvalidByteDecimal.at(offset) {offset;}, 2);
    let large is @byte = [byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57), byte(57)];
    test.is(ByteRange(large, 0, 20).decimal(), 99999999999999999999);
}

test "byte ranges read fixed-width integers like IntegerFromBytes" {
    let source is @byte = [byte(0), byte(1), byte(2), byte(255), byte(254)];
    test.is(ByteRange(source, 1, 3).integer(Signedness.unsigned, ByteOrder.big), 258);
    test.is(ByteRange(source, 1, 3).integer(Signedness.unsigned, ByteOrder.little), 513);
    test.is(ByteRange(source, 3, 5).integer(Signedness.signed, ByteOrder.big), -2);
    test.is(ByteRange(source, 3, 5).integer(Signedness.unsigned, ByteOrder.big), 65534);
    test.is(ByteRange(source, 3, 5).integer(Signedness.signed, ByteOrder.little), -257);
    test.is(ByteRange(source, 0, 5).integer(Signedness.unsigned, ByteOrder.big), 16973822);
    let wide is @byte = [byte(255), byte(255), byte(255), byte(255), byte(255), byte(255), byte(255), byte(255)];
    test.is(ByteRange(wide, 0, 8).integer(Signedness.signed, ByteOrder.big), -1);
    test.is(try {ByteRange(wide, 0, 8).integer(Signedness.unsigned, ByteOrder.big); "read";} catch InvalidArgument.because(reason) {reason;}, "decoded integer is outside the int range");
    test.is(try {ByteRange(source, 2, 2).integer(Signedness.unsigned, ByteOrder.big); "read";} catch InvalidArgument.because(reason) {reason;}, "integer input width must be 1 to 8 bytes");
    test.is(try {ByteRange([byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(1)], 0, 9).integer(Signedness.unsigned, ByteOrder.big); "read";} catch InvalidArgument.because(reason) {reason;}, "integer input width must be 1 to 8 bytes");
}

test "byte ranges compare and copy" {
    let source is @byte = [byte(71), byte(69), byte(84), byte(32), byte(47)];
    test.is(ByteRange(source, 0, 3).equals([byte(71), byte(69), byte(84)]), true);
    test.is(ByteRange(source, 0, 3).equals([byte(71), byte(69)]), false);
    test.is(ByteRange(source, 1, 1).equals([]), true);
    test.is(ByteRange(source, 3, 5).bytes(), [byte(32), byte(47)]);
    test.is(ByteRange(source, 3, 5).size(), 2);
}
