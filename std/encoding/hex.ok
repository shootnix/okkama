module encoding/hex v1.0.0;

import "runtime/hex" take hex_encode, hex_valid_prefix, hex_decode;

// Strict hexadecimal encoding.
//
//     HexEncoded(origin: [byte(0), byte(171), byte(255)]).string();
//     // "00abff"
//
//     HexDecoded(origin: "00ABff").bytes();
//     // [0, 171, 255]
//
// Encoding always uses lowercase ASCII without a prefix. Decoding accepts
// lowercase and uppercase ASCII digits, but rejects `0x`, whitespace,
// separators, underscores and every non-ASCII lookalike. Input length must be
// even. InvalidHex.offset() is a Unicode-scalar offset in the source string;
// an unmatched final nibble reports origin.length().

// Bytes as lowercase hexadecimal text.
object HexEncoded {
    has origin is @byte;

    // Encodes origin.
    HexEncoded(origin is @byte) {
        self.origin = origin;
    }

    // The encoded text.
    string() is string {
        hex_encode(origin);
    }
}

// Hexadecimal text back to bytes, either case; anything else is InvalidHex.
object HexDecoded {
    has origin is string;

    // Decodes origin.
    HexDecoded(origin is string) {
        self.origin = origin;
    }

    // The decoded bytes.
    bytes() is @byte {
        let offset is int = hex_valid_prefix(origin);
        confirm offset == origin.length() else throw InvalidHex.at(offset);
        confirm origin.length() % 2 == 0
            else throw InvalidHex.at(origin.length());
        hex_decode(origin);
    }
}

// Text that is not hexadecimal pairs; offset says where.
enum InvalidHex is Error = (at(offset is int));

test "hex writes lowercase and reads either case" {
    test.is(HexEncoded(origin: [byte(0), byte(171), byte(255)]).string(), "00abff");
    test.is(HexDecoded(origin: "00ABff").bytes(), [byte(0), byte(171), byte(255)]);
    let empty is @byte = [];
    test.is(HexEncoded(origin: empty).string(), "");
    test.is(HexDecoded(origin: "").bytes().size(), 0);
}

test "hex refuses prefixes, separators and odd lengths" {
    let offset = (text is string) is int {
        try {
            HexDecoded(origin: text).bytes();
            -1;
        }
        catch InvalidHex.at(offset) {
            offset;
        }
    };
    test.is(offset("0x00"), 1);
    test.is(offset("00 ab"), 2);
    test.is(offset("abc"), 3);
    test.is(offset("zz"), 0);
}
