module encoding/base85 v1.0.0;

import "runtime/base85" take base85_encode, base85_invalid_offset, base85_decode;

// Strict Base85 codecs with two genuinely implemented variants.
//
// ascii85 uses the contiguous `!` through `u` alphabet. It emits and accepts
// `z` for a complete four-zero-byte group, but rejects Adobe `<~ ~>` wrappers,
// whitespace and the nonstandard `y` abbreviation.
//
// rfc1924 uses this exact alphabet:
//
//     0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz
//     !#$%&()*+-;<=>?@^_`{|}~
//
// Both variants encode four bytes as five characters. A final one-, two- or
// three-byte input group becomes two, three or four characters. A single
// trailing encoded character is invalid. Decoding rejects values above
// 0xFFFFFFFF and noncanonical partial groups. InvalidBase85.offset() is a
// Unicode-scalar offset in encoded input.
//
// Z85 is deliberately absent: its fixed 4-byte/5-character block contract
// would make encoding partial and deserves a separate consumer-driven API.

enum Base85Alphabet = (ascii85, rfc1924);

object Base85Encoded {
    has origin is @byte;
    has alphabet is Base85Alphabet;

    Base85Encoded(origin is @byte, alphabet is Base85Alphabet) {
        self.origin = origin;
        self.alphabet = alphabet;
    }

    string() is string {
        base85_encode(origin, self.alphabet_name());
    }

    hidden alphabet_name() is string {
        if alphabet == Base85Alphabet.ascii85 {
            "ascii85";
        }
        else {
            "rfc1924";
        }
    }
}

object Base85Decoded {
    has origin is string;
    has alphabet is Base85Alphabet;

    Base85Decoded(origin is string, alphabet is Base85Alphabet) {
        self.origin = origin;
        self.alphabet = alphabet;
    }

    bytes() is @byte {
        let name is string = self.alphabet_name();
        let offset is int = base85_invalid_offset(origin, name);
        confirm offset == -1 else throw InvalidBase85.at(offset);
        base85_decode(origin, name);
    }

    hidden alphabet_name() is string {
        if alphabet == Base85Alphabet.ascii85 {
            "ascii85";
        }
        else {
            "rfc1924";
        }
    }
}

enum InvalidBase85 is Error = (at(offset is int));

test "both base85 variants round-trip" {
    let man = [byte(77), byte(97), byte(110), byte(32)];
    let hi = [byte(104), byte(105)];
    test.is(Base85Encoded(origin: man, alphabet: Base85Alphabet.ascii85).string(), "9jqo^");
    test.is(Base85Encoded(origin: hi, alphabet: Base85Alphabet.ascii85).string(), "BP@");
    test.is(Base85Encoded(origin: [byte(0), byte(0), byte(0), byte(0)], alphabet: Base85Alphabet.ascii85).string(), "z");
    test.is(Base85Decoded(origin: "9jqo^BP@", alphabet: Base85Alphabet.ascii85).bytes(), man + hi);
    test.is(Base85Encoded(origin: man, alphabet: Base85Alphabet.rfc1924).string(), "O<`^z");
    test.is(Base85Encoded(origin: hi, alphabet: Base85Alphabet.rfc1924).string(), "XlV");
    test.is(Base85Decoded(origin: "O<`^zXlV", alphabet: Base85Alphabet.rfc1924).bytes(), man + hi);
}

test "base85 refuses a lone final character and wrappers" {
    let offset = (text is string, alphabet is Base85Alphabet) is int {
        try {
            Base85Decoded(origin: text, alphabet: alphabet).bytes();
            -1;
        }
        catch InvalidBase85.at(offset) {
            offset;
        }
    };
    test.ok(offset("9jqo^B", Base85Alphabet.ascii85) >= 5);
    // `<` is in the ascii85 alphabet; the wrapper's `~` is not.
    test.is(offset("<~9jqo^~>", Base85Alphabet.ascii85), 1);
    test.is(offset("9jqo^ BP@", Base85Alphabet.ascii85), 5);
}
