module encoding/base32 v1.0.0;

import "runtime/base32" take base32_encode, base32_invalid_offset, base32_decode;

// Strict RFC 4648 Base32.
//
//     Base32Encoded(origin: [byte(102), byte(111), byte(111)]).string();
//     // "MZXW6==="
//
//     Base32Decoded(origin: "MZXW6===").bytes();
//     // [102, 111, 111]
//
// The alphabet is uppercase ASCII A-Z followed by 2-7. Encoding always emits
// canonical `=` padding to a multiple of eight characters. Decoding requires
// that exact padding and rejects lowercase, 0/1 aliases, whitespace,
// separators, misplaced padding and nonzero unused trailing bits. Empty input
// is valid. InvalidBase32.offset() is a Unicode-scalar offset; a structurally
// incomplete final quantum reports origin.length().

// Bytes as RFC 4648 Base32 text, padded.
object Base32Encoded {
    has origin is @byte;

    // Encodes origin.
    Base32Encoded(origin is @byte) {
        self.origin = origin;
    }

    // The encoded text.
    string() is string {
        base32_encode(origin);
    }
}

// RFC 4648 Base32 text back to bytes; anything else is InvalidBase32.
object Base32Decoded {
    has origin is string;

    // Decodes origin.
    Base32Decoded(origin is string) {
        self.origin = origin;
    }

    // The decoded bytes.
    bytes() is @byte {
        let offset is int = base32_invalid_offset(origin);
        confirm offset == -1 else throw InvalidBase32.at(offset);
        base32_decode(origin);
    }
}

// Text that is not strict Base32; offset says where.
enum InvalidBase32 is Error = (at(offset is int));

test "base32 round-trips with canonical padding" {
    let foobar = [byte(102), byte(111), byte(111), byte(98), byte(97), byte(114)];
    test.is(Base32Encoded(origin: foobar).string(), "MZXW6YTBOI======");
    test.is(Base32Decoded(origin: "MZXW6YTBOI======").bytes(), foobar);
    let empty is @byte = [];
    test.is(Base32Encoded(origin: empty).string(), "");
    test.is(Base32Decoded(origin: "").bytes().size(), 0);
}

test "base32 refuses lowercase and broken padding" {
    for ["mzxw6===", "MZXW6==", "MZXW6=A=", "MZ XW6==="] -> invalid {
        test.ok(
            try {
                Base32Decoded(origin: invalid).bytes();
                false;
            }
            catch InvalidBase32.at(offset) {
                offset >= 0 && offset <= invalid.length();
            }
        );
    }
    test.is(
        try {
            Base32Decoded(origin: "mZXW6===").bytes();
            -1;
        }
        catch InvalidBase32.at(offset) {
            offset;
        },
        0
    );
}
