module encoding/binary v1.0.0;

import "encoding/utf" take ByteOrder;
import "error" take InvalidArgument;
import "runtime/binary" take binary_integer_fits, binary_integer_bytes,
    binary_integer_from_bytes_fits, binary_integer_from_bytes, binary_float_fits,
    binary_float_bytes, binary_float_finite, binary_float_from_bytes;

// Explicit fixed-width numeric binary representations.
//
//     let network is @byte = IntegerBytes(
//         value: -2,
//         size: 2,
//         signedness: Signedness.signed,
//         order: ByteOrder.big,
//     ).bytes(); // [255, 254]
//
//     let measurement is float = Binary(
//         bytes: [byte(64), byte(32), byte(0), byte(0)],
//         order: ByteOrder.big,
//     ).float(FloatWidth.bits32); // 2.5
//     let port is int = Binary(bytes: header, order: ByteOrder.big).int(Signedness.unsigned);
//
// Signed integers use two's complement; unsigned integers use ordinary
// magnitude. Encoding is exact and never truncates, wraps or saturates.
// Decoding must fit Okkama's signed 64-bit int, although redundant leading
// zero or sign-extension bytes are accepted. Integer widths are positive.
//
// Floats use IEEE 754 binary32 or binary64 with explicit byte order. binary32
// encoding rounds to nearest with ties to even. Okkama floats are finite, so
// decoding an infinity or NaN is rejected. Signed zero and subnormal values
// retain their IEEE representation. No API uses machine-native byte order.
//
// A generic BinaryLayout/Packed/Unpacked layer is intentionally absent. Until
// the language has typed heterogeneous product values, such an API would need
// either an untyped value bag or a string format DSL. Callers compose these
// typed scalar representations into protocol-specific objects instead.

// Whether the bytes hold a two's-complement signed number.
enum Signedness = (signed, unsigned);

// A 4-byte or an 8-byte IEEE 754 float.
enum FloatWidth = (bits32, bits64);

// Bytes read as a number in a byte order: an integer of their width, or an
// IEEE 754 float of the width given.
object Binary {
    has origin is @byte;
    has order is ByteOrder;

    // Bytes read in order.
    Binary(bytes is @byte, order is ByteOrder) {
        origin = bytes;
        self.order = order;
    }

    // The bytes as an integer of their width.
    int(signedness is Signedness) is int {
        confirm origin.size() > 0
            else throw InvalidArgument.because("integer input width must be positive");
        let sign is string = if signedness == Signedness.signed {
            "signed";
        }
        else {
            "unsigned";
        };
        let order_name is string = self.order_name();
        confirm binary_integer_from_bytes_fits(origin, sign, order_name)
            else throw InvalidArgument.because("decoded integer is outside the int range");
        binary_integer_from_bytes(origin, sign, order_name);
    }

    // The bytes as a float of width.
    float(width is FloatWidth) is float {
        let bits is int = if width == FloatWidth.bits32 {
            32;
        }
        else {
            64;
        };
        confirm origin.size() * 8 == bits
            else throw InvalidArgument.because(
                "floating-point input width does not match FloatWidth"
            );
        let order_name is string = self.order_name();
        confirm binary_float_finite(origin, bits, order_name)
            else throw InvalidArgument.because("binary floating-point value must be finite");
        binary_float_from_bytes(origin, bits, order_name);
    }

    hidden order_name() is string {
        if order == ByteOrder.big {
            "big";
        }
        else {
            "little";
        }
    }
}

// An integer as size bytes in a byte order.
object IntegerBytes {
    has origin is int;
    has size is int;
    has signedness is Signedness;
    has order is ByteOrder;

    // value as size bytes; a value that does not fit is OutOfRange.
    IntegerBytes(value is int, size is int, signedness is Signedness, order is ByteOrder) {
        origin = value;
        self.size = size;
        self.signedness = signedness;
        self.order = order;
    }

    // The bytes.
    bytes() is @byte {
        confirm size > 0
            else throw InvalidArgument.because("integer byte size must be positive");
        let sign is string = self.signedness_name();
        confirm binary_integer_fits(origin, size, sign)
            else throw InvalidArgument.because("integer does not fit the requested binary width");
        binary_integer_bytes(origin, size, sign, self.order_name());
    }

    hidden signedness_name() is string {
        if signedness == Signedness.signed {
            "signed";
        }
        else {
            "unsigned";
        }
    }

    hidden order_name() is string {
        if order == ByteOrder.big {
            "big";
        }
        else {
            "little";
        }
    }
}

// A float as 4 or 8 bytes in a byte order.
object FloatBytes {
    has origin is float;
    has width is FloatWidth;
    has order is ByteOrder;

    // value as width bytes.
    FloatBytes(value is float, width is FloatWidth, order is ByteOrder) {
        origin = value;
        self.width = width;
        self.order = order;
    }

    // The bytes.
    bytes() is @byte {
        let bits is int = self.width_bits();
        confirm binary_float_fits(origin, bits)
            else throw InvalidArgument.because("float does not fit the requested binary width");
        binary_float_bytes(origin, bits, self.order_name());
    }

    hidden width_bits() is int {
        if width == FloatWidth.bits32 {
            32;
        }
        else {
            64;
        }
    }

    hidden order_name() is string {
        if order == ByteOrder.big {
            "big";
        }
        else {
            "little";
        }
    }
}

test "integers round-trip through both byte orders" {
    let big = IntegerBytes(value: -2, size: 2, signedness: Signedness.signed, order: ByteOrder.big).bytes();
    test.is(big, [byte(255), byte(254)]);
    test.is(Binary(bytes: big, order: ByteOrder.big).int(Signedness.signed), -2);
    test.is(Binary(bytes: big, order: ByteOrder.big).int(Signedness.unsigned), 65534);
    let little = IntegerBytes(value: 258, size: 4, signedness: Signedness.unsigned, order: ByteOrder.little).bytes();
    test.is(little, [byte(2), byte(1), byte(0), byte(0)]);
    test.is(Binary(bytes: little, order: ByteOrder.little).int(Signedness.unsigned), 258);
    test.is(Binary(bytes: [byte(0), byte(0), byte(0), byte(1)], order: ByteOrder.big).int(Signedness.signed), 1);
}

test "integer widths and ranges are refused, never wrapped" {
    let refused = (work is () is @byte) is string {
        try {
            work();
            "accepted";
        }
        catch error is InvalidArgument {
            "refused";
        }
    };
    test.is(refused(() is @byte {
        IntegerBytes(value: 256, size: 1, signedness: Signedness.unsigned, order: ByteOrder.big).bytes();
    }), "refused");
    test.is(refused(() is @byte {
        IntegerBytes(value: -1, size: 2, signedness: Signedness.unsigned, order: ByteOrder.big).bytes();
    }), "refused");
    test.is(refused(() is @byte {
        IntegerBytes(value: 1, size: 0, signedness: Signedness.signed, order: ByteOrder.big).bytes();
    }), "refused");
    let empty is @byte = [];
    test.is(
        try {
            Binary(bytes: empty, order: ByteOrder.big).int(Signedness.signed);
        }
        catch error is InvalidArgument {
            -1;
        },
        -1
    );
    let wide is @byte = [byte(1), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0)];
    test.is(
        try {
            Binary(bytes: wide, order: ByteOrder.big).int(Signedness.unsigned);
        }
        catch error is InvalidArgument {
            -1;
        },
        -1
    );
}

test "floats keep their IEEE 754 form" {
    test.is(Binary(bytes: [byte(64), byte(32), byte(0), byte(0)], order: ByteOrder.big).float(FloatWidth.bits32), 2.5);
    let encoded = FloatBytes(value: -0.75, width: FloatWidth.bits64, order: ByteOrder.little).bytes();
    test.is(encoded.size(), 8);
    test.is(Binary(bytes: encoded, order: ByteOrder.little).float(FloatWidth.bits64), -0.75);
    test.is(
        try {
            Binary(bytes: encoded, order: ByteOrder.little).float(FloatWidth.bits32);
        }
        catch error is InvalidArgument {
            1.0;
        },
        1.0
    );
    let infinity = [byte(127), byte(128), byte(0), byte(0)];
    test.is(
        try {
            Binary(bytes: infinity, order: ByteOrder.big).float(FloatWidth.bits32);
        }
        catch error is InvalidArgument {
            1.0;
        },
        1.0
    );
}
