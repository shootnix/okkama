module encoding/quoted_printable v1.0.0;

import "runtime/quoted_printable" take quoted_printable_encode, quoted_printable_invalid_offset,
    quoted_printable_decode;

// Strict RFC 2045 quoted-printable over bytes.
//
//     QuotedPrintableEncoded(
//         origin: [byte(0), byte(61), byte(255)],
//     ).bytes();
//     // ASCII bytes for "=00=3D=FF"
//
// Encoding uses uppercase `=HH`, preserves CRLF hard line breaks, and inserts
// `=\r\n` soft breaks so every physical line is at most 76 bytes. Bare CR and
// LF are encoded rather than normalized. Space and tab remain literal inside
// a line, but are encoded at end of input or immediately before CRLF.
//
// Decoding accepts uppercase or lowercase ASCII hex. It rejects malformed
// escapes, bare CR/LF, non-ASCII literals, trailing literal whitespace and
// physical lines longer than 76 bytes. No replacement, newline conversion or
// charset conversion occurs. InvalidQuotedPrintable.offset() is the byte
// offset of the first violation.

// Bytes as RFC 2045 quoted-printable, lines at most 76 characters.
object QuotedPrintableEncoded {
    has origin is @byte;

    // Encodes origin.
    QuotedPrintableEncoded(origin is @byte) {
        self.origin = origin;
    }

    // The encoded bytes.
    bytes() is @byte {
        quoted_printable_encode(origin);
    }
}

// Quoted-printable back to bytes; anything else is InvalidQuotedPrintable.
object QuotedPrintableDecoded {
    has origin is @byte;

    // Decodes origin.
    QuotedPrintableDecoded(origin is @byte) {
        self.origin = origin;
    }

    // The decoded bytes.
    bytes() is @byte {
        let offset is int = quoted_printable_invalid_offset(origin);
        confirm offset == -1 else throw InvalidQuotedPrintable.at(offset);
        quoted_printable_decode(origin);
    }
}

// Bytes that are not strict quoted-printable; offset says where.
enum InvalidQuotedPrintable is Error = (at(offset is int));

test "quoted-printable escapes what is not plain text" {
    let escaped = QuotedPrintableEncoded(origin: [byte(0), byte(61), byte(255)]).bytes();
    test.is(escaped, [byte(61), byte(48), byte(48), byte(61), byte(51), byte(68), byte(61), byte(70), byte(70)]);
    test.is(QuotedPrintableDecoded(origin: escaped).bytes(), [byte(0), byte(61), byte(255)]);
    // Space at the end of input is escaped; inside a line it stays.
    test.is(QuotedPrintableEncoded(origin: [byte(97), byte(32), byte(98), byte(32)]).bytes(),
        [byte(97), byte(32), byte(98), byte(61), byte(50), byte(48)]);
    // Lowercase hex is read too.
    test.is(QuotedPrintableDecoded(origin: [byte(61), byte(51), byte(100)]).bytes(), [byte(61)]);
}

test "quoted-printable keeps lines within 76 bytes" {
    let long is @byte = (0..100).map() -> index {
        byte(97);
    };
    let encoded = QuotedPrintableEncoded(origin: long).bytes();
    test.ok(encoded.size() > 100);
    test.is(QuotedPrintableDecoded(origin: encoded).bytes(), long);
    test.is(
        try {
            QuotedPrintableDecoded(origin: [byte(61), byte(71), byte(48)]).bytes();
            -1;
        }
        catch InvalidQuotedPrintable.at(offset) {
            offset;
        },
        0
    );
    test.is(
        try {
            QuotedPrintableDecoded(origin: long).bytes();
            -1;
        }
        catch InvalidQuotedPrintable.at(offset) {
            offset;
        } >= 0,
        true
    );
}
