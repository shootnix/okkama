module math/constants v1.0.0;

// Finite mathematical constants as immutable projected values.
//
//     let circle is float = value Pi();
//     let turn is float = value Tau();
//     let growth is float = value Euler();
//
// Okkama does not yet have immutable module-level value declarations, so each
// constant is represented by a stateless value object. The projection returns
// the nearest builtin float. Tau is defined from Pi to keep their relationship
// explicit.
//
// Infinity and NaN deliberately do not live here. Builtin float is finite by
// contract, and introducing symbolic substitutes would not make them usable by
// ordinary floating-point arithmetic. If non-finite floats are ever admitted,
// that must be a language-wide numeric-model decision rather than a stdlib
// constant leaking through the existing boundary.

object Pi {
    Pi();

    #projected
    value() is float { 3.141592653589793; }
}

object Tau {
    Tau();

    #projected
    value() is float { (value Pi()) * 2.0; }
}

object Euler {
    Euler();

    #projected
    value() is float { 2.718281828459045; }
}
