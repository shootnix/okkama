module math/constants v1.0.0;

// Finite mathematical constants, as module constants (#153):
//
//     let circle is float = PI * radius * radius;
//     let turn is float = TAU;
//     let growth is float = E;
//
// Each is the nearest builtin float; TAU is defined from PI to keep their
// relationship explicit.
//
// Infinity and NaN deliberately do not live here. Builtin float is finite by
// contract, and introducing symbolic substitutes would not make them usable by
// ordinary floating-point arithmetic. If non-finite floats are ever admitted,
// that must be a language-wide numeric-model decision rather than a stdlib
// constant leaking through the existing boundary.

// π, the ratio of a circle's circumference to its diameter.
const PI = 3.141592653589793;

// τ = 2π, a full turn in radians.
const TAU = PI * 2.0;

// e, the base of the natural logarithm.
const E = 2.718281828459045;

test "constants keep their relationship" {
    test.is(TAU, PI * 2.0);
    test.ok(E > 2.718 && E < 2.719);
}
