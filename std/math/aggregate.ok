module math/aggregate v1.0.0;

import "collections/iteration" take Iterating, CursorItems;
import "collections/sequence" take Sequencing, EmptySequence;
import "collections/combining" take StrictlyZipped, UnequalSizes;
import "compare" take Comparing, Order;
import "runtime/math_aggregate" take aggregate_square_root;

// One-pass aggregates over Iterating values. Plain arrays are Iterating, so
// no wrapper object is needed:
//
//     let smallest is int = value Minimum(values: numbers);
//     let largest is int = value Maximum(values: [3, 9, 4]);
//     let total is float = value AccurateSum(values: measurements);
//     let length is float = value Hypotenuse(values: coordinates);
//     let gap is float = value Distance(left: first, right: second);
//
// Minimum and Maximum use intrinsic Comparing<T> and throw EmptySequence for an
// empty source. Sum, AccurateSum and SumOfProducts return 0.0 for empty input;
// Product returns 1.0; Hypotenuse returns 0.0.
//
// Sum is a plain left fold. AccurateSum uses Neumaier compensation and is the
// default when cancellation accuracy matters. Hypotenuse and Distance use a
// scaled sum of squares, avoiding direct x*x overflow and underflow.
// SumOfProducts traverses both inputs once and throws UnequalSizes when only
// one ends. Distance checks its sequencing sizes before reading either value.

object Minimum<T: Comparing<T>> {
    has origin is Iterating<T>;

    Minimum(values is Iterating<T>) {
        origin = values;
    }

    #projected
    value() is T {
        let cursor = origin.cursor();
        confirm cursor.available() else throw EmptySequence();
        CursorItems(cursor: cursor.successor()).reduce(cursor.item()) -> minimum, item {
            if item.order(minimum) == Order.less { item; } else { minimum; }
        };
    }
}

object Maximum<T: Comparing<T>> {
    has origin is Iterating<T>;

    Maximum(values is Iterating<T>) {
        origin = values;
    }

    #projected
    value() is T {
        let cursor = origin.cursor();
        confirm cursor.available() else throw EmptySequence();
        CursorItems(cursor: cursor.successor()).reduce(cursor.item()) -> maximum, item {
            if item.order(maximum) == Order.greater { item; } else { maximum; }
        };
    }
}

object Sum {
    has origin is Iterating<float>;

    Sum(values is Iterating<float>) {
        origin = values;
    }

    #projected
    value() is float {
        origin.reduce(0.0) -> total, item { total + item; };
    }
}

object AccurateSum {
    has origin is Iterating<float>;

    AccurateSum(values is Iterating<float>) {
        origin = values;
    }

    #projected
    value() is float {
        origin.reduce(AccurateTotal(sum: 0.0, correction: 0.0)) -> total, item {
            total.addition(item);
        }.value();
    }
}

object AccurateTotal {
    has total is float;
    has correction is float;

    AccurateTotal(sum is float, correction is float) {
        total = sum;
        self.correction = correction;
    }

    addition(value is float) is AccurateTotal {
        let revised is float = total + value;
        let error is float = if self.magnitude(total) >= self.magnitude(value) {
            (total - revised) + value;
        } else {
            (value - revised) + total;
        };
        AccurateTotal(sum: revised, correction: correction + error);
    }

    value() is float {
        total + correction;
    }

    private:

    magnitude(value is float) is float {
        if value < 0.0 { -value; } else { value; }
    }
}

object Product {
    has origin is Iterating<float>;

    Product(values is Iterating<float>) {
        origin = values;
    }

    #projected
    value() is float {
        origin.reduce(1.0) -> product, item { product * item; };
    }
}

object SumOfProducts {
    has left is Iterating<float>;
    has right is Iterating<float>;

    SumOfProducts(left is Iterating<float>, right is Iterating<float>) {
        self.left = left;
        self.right = right;
    }

    #projected
    value() is float {
        StrictlyZipped(left: left, right: right).reduce(0.0) -> total, pair {
            total + pair.first() * pair.second();
        };
    }
}

object Hypotenuse {
    has origin is Iterating<float>;

    Hypotenuse(values is Iterating<float>) {
        origin = values;
    }

    #projected
    value() is float {
        origin.reduce(ScaledSquares(scale: 0.0, squares: 1.0)) -> state, item {
            state.addition(item);
        }.value();
    }
}

object Distance {
    has left is Sequencing<float>;
    has right is Sequencing<float>;

    Distance(left is Sequencing<float>, right is Sequencing<float>) {
        self.left = left;
        self.right = right;
    }

    #projected
    value() is float {
        confirm left.size() == right.size() else throw UnequalSizes();
        (0..left.size()).reduce(ScaledSquares(scale: 0.0, squares: 1.0)) -> state, index {
            state.addition(left.item(index) - right.item(index));
        }.value();
    }
}

object ScaledSquares {
    has scaling is float;
    has total is float;

    ScaledSquares(scale is float, squares is float) {
        scaling = scale;
        total = squares;
    }

    addition(value is float) is ScaledSquares {
        let magnitude is float = if value < 0.0 { -value; } else { value; };
        if magnitude == 0.0 {
            self;
        }
        else if scaling < magnitude {
            let ratio is float = scaling / magnitude;
            ScaledSquares(
                scale: magnitude,
                squares: 1.0 + total * ratio * ratio,
            );
        }
        else {
            let ratio is float = magnitude / scaling;
            ScaledSquares(
                scale: scaling,
                squares: total + ratio * ratio,
            );
        }
    }

    value() is float {
        if scaling == 0.0 {
            0.0;
        }
        else {
            scaling * aggregate_square_root(total);
        }
    }
}
