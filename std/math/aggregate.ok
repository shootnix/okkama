module math/aggregate v1.0.0;

import "collections/iteration" take Iterating, CursorItems;
import "collections/sequence" take Sequencing, EmptySequence;
import "collections/combining" take StrictlyZipped, UnequalSizes;
import "compare" take Comparing, Order;
import "runtime/math_aggregate" take aggregate_square_root;

// One-pass aggregates over Iterating values. Plain arrays are Iterating, so
// no wrapper object is needed:
//
//     let smallest is int = Extremes(numbers).minimum();
//     let largest is int = Extremes([3, 9, 4]).maximum();
//     let total is float = Numbers(measurements).accurate_sum();
//     let length is float = Numbers(coordinates).hypotenuse();
//     let gap is float = Vectors(left: first, right: second).distance();
//
// Extremes uses intrinsic Comparing<T> and throws EmptySequence for an empty
// source. sum, accurate_sum and dot return 0.0 for empty input; product
// returns 1.0; hypotenuse returns 0.0.
//
// sum is a plain left fold. accurate_sum uses Neumaier compensation and is the
// default when cancellation accuracy matters. hypotenuse and distance use a
// scaled sum of squares, avoiding direct x*x overflow and underflow. dot
// traverses both inputs once and throws UnequalSizes when only one ends;
// distance checks the sizes before reading either value.

// The least and the greatest item of a source.
object Extremes<T: Comparing<T>> {
    has origin is Iterating<T>;

    // The least and greatest of values, found in one pass; EmptySequence when
    // there are none.
    Extremes(values is Iterating<T>) {
        origin = values;
    }

    // The least value.
    minimum() is T {
        let cursor = origin.cursor();
        confirm cursor.available() else throw EmptySequence.empty;
        CursorItems(cursor: cursor.successor()).reduce(cursor.item()) -> minimum, item {
            if item.order(minimum) == Order.less {
                item;
            }
            else {
                minimum;
            }
        };
    }

    // The greatest value.
    maximum() is T {
        let cursor = origin.cursor();
        confirm cursor.available() else throw EmptySequence.empty;
        CursorItems(cursor: cursor.successor()).reduce(cursor.item()) -> maximum, item {
            if item.order(maximum) == Order.greater {
                item;
            }
            else {
                maximum;
            }
        };
    }
}

// Sums, the product and the Euclidean length of floats.
object Numbers {
    has origin is Iterating<float>;

    // Floats to add up or multiply, read in one pass.
    Numbers(values is Iterating<float>) {
        origin = values;
    }

    // The plain sum.
    sum() is float {
        origin.reduce(0.0) -> total, item {
            total + item;
        };
    }

    // The sum with compensated rounding, as Python's math.fsum.
    accurate_sum() is float {
        origin.reduce(RunningSum(sum: 0.0, correction: 0.0)) -> total, item {
            total.addition(item);
        }.sum();
    }

    // The product.
    product() is float {
        origin.reduce(1.0) -> product, item {
            product * item;
        };
    }

    // The square root of the sum of squares, without overflow along the way.
    hypotenuse() is float {
        origin.reduce(RunningNorm(scale: 0.0, squares: 1.0)) -> state, item {
            state.addition(item);
        }.norm();
    }
}

// Two vectors of floats: their dot product and the distance between them.
object Vectors {
    has left is Sequencing<float>;
    has right is Sequencing<float>;

    // Two vectors of the same length; UnequalSizes otherwise.
    Vectors(left is Sequencing<float>, right is Sequencing<float>) {
        self.left = left;
        self.right = right;
    }

    // The dot product.
    dot() is float {
        StrictlyZipped(left: left, right: right).reduce(0.0) -> total, pair {
            total + pair.first() * pair.second();
        };
    }

    // The Euclidean distance between them.
    distance() is float {
        confirm left.size() == right.size() else throw UnequalSizes.unequal;
        (0..left.size()).reduce(RunningNorm(scale: 0.0, squares: 1.0)) -> state, index {
            state.addition(left.item(index) - right.item(index));
        }.norm();
    }
}

// A Neumaier-compensated running sum.
hidden object RunningSum {
    has total is float;
    has correction is float;

    RunningSum(sum is float, correction is float) {
        total = sum;
        self.correction = correction;
    }

    addition(value is float) is RunningSum {
        let revised is float = total + value;
        let error is float = if self.magnitude(total) >= self.magnitude(value) {
            (total - revised) + value;
        }
        else {
            (value - revised) + total;
        };
        RunningSum(sum: revised, correction: correction + error);
    }

    sum() is float {
        total + correction;
    }

    hidden magnitude(value is float) is float {
        if value < 0.0 {
            -value;
        }
        else {
            value;
        }
    }
}

// A running scaled sum of squares, read as the Euclidean norm.
hidden object RunningNorm {
    has scaling is float;
    has total is float;

    RunningNorm(scale is float, squares is float) {
        scaling = scale;
        total = squares;
    }

    addition(value is float) is RunningNorm {
        let magnitude is float = if value < 0.0 {
            -value;
        }
        else {
            value;
        };
        if magnitude == 0.0 {
            self;
        }
        else if scaling < magnitude {
            let ratio is float = scaling / magnitude;
            RunningNorm(
                scale: magnitude,
                squares: 1.0 + total * ratio * ratio,
            );
        }
        else {
            let ratio is float = magnitude / scaling;
            RunningNorm(
                scale: scaling,
                squares: total + ratio * ratio,
            );
        }
    }

    norm() is float {
        if scaling == 0.0 {
            0.0;
        }
        else {
            scaling * aggregate_square_root(total);
        }
    }
}

test "extremes of a source, and an empty one is refused" {
    test.is(Extremes([3, 9, 4]).minimum(), 3);
    test.is(Extremes([3, 9, 4]).maximum(), 9);
    test.is(Extremes(["pear", "apple"]).minimum(), "apple");
    let empty is @int = [];
    test.ok(try {
        Extremes(empty).minimum();
        false;
    }
    catch e is EmptySequence {
        true;
    });
}

test "sums, product and hypotenuse of floats" {
    test.is(Numbers([1.0, 2.0, 3.5]).sum(), 6.5);
    test.is(Numbers([1.0e16, 1.0, -1.0e16]).accurate_sum(), 1.0);
    test.is(Numbers([2.0, 3.0, 0.5]).product(), 3.0);
    test.is(Numbers([3.0, 4.0]).hypotenuse(), 5.0);
    let empty is @float = [];
    test.is(Numbers(empty).sum(), 0.0);
    test.is(Numbers(empty).product(), 1.0);
    test.is(Numbers(empty).hypotenuse(), 0.0);
}

test "dot product and distance of two vectors" {
    test.is(Vectors(left: [1.0, 2.0, 3.0], right: [4.0, 5.0, 6.0]).dot(), 32.0);
    test.is(Vectors(left: [0.0, 0.0], right: [3.0, 4.0]).distance(), 5.0);
    test.ok(try {
        Vectors(left: [1.0], right: [1.0, 2.0]).distance();
        false;
    }
    catch e is UnequalSizes {
        true;
    });
    test.ok(try {
        Vectors(left: [1.0], right: [1.0, 2.0]).dot();
        false;
    }
    catch e is UnequalSizes {
        true;
    });
}
