module math/decimal v1.0.0;

import "compare" take Comparing, Order;
import "numbers/bigint" take BigInt;
import "runtime/decimal" take decimal_valid, decimal_canonical, decimal_coefficient,
    decimal_exponent, decimal_order;

// Exact immutable decimal value. Construction never trims whitespace and
// never passes through float. Equivalent spellings share one canonical form:
//
//     Decimal("001.2000").string(); // "1.2"
//     Decimal("1000").string();     // "1e3"

object Decimal does Comparing<Decimal> {
    has origin is string;

    Decimal(origin is string) {
        confirm decimal_valid(origin) else throw InvalidDecimal.origin(origin);
        self.origin = decimal_canonical(origin);
    }

    coefficient() is BigInt {
        BigInt(decimal_coefficient(origin));
    }

    exponent() is int {
        decimal_exponent(origin);
    }

    order(other is Decimal) is Order {
        let result = decimal_order(origin, other.string());
        if result < 0 {
            Order.less;
        }
        else {
            if result > 0 {
                Order.greater;
            }
            else {
                Order.equal;
            }
        }
    }

    string() is string {
        origin;
    }
}

enum InvalidDecimal is Error = (origin(origin is string));

test "equivalent spellings share one canonical form" {
    test.is(Decimal("001.2000").string(), "1.2");
    test.is(Decimal("1000").string(), "1e3");
    test.is(Decimal("1.2").order(Decimal("1.20")), Order.equal);
    test.is(Decimal("-0.5").order(Decimal("0.25")), Order.less);
    test.is(Decimal("1e3").order(Decimal("999")), Order.greater);
    test.is(Decimal("12.5").exponent(), -1);
    test.is(Decimal("12.5").coefficient().string(), "125");
    for ["", " 1", "1 ", "1..2", "+-1", "abc"] -> invalid {
        test.is(
            try {
                Decimal(invalid).string();
            }
            catch InvalidDecimal.origin(origin) {
                "[" + origin + "]";
            },
            "[" + invalid + "]"
        );
    }
}
