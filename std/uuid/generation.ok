module uuid/generation v1.0.0;

import "compare" take Comparing, Order;
import "uuid/value" take Uuid, UuidBytes, UuidText, UuidVariant;
import "random/source" take SecureRandom;
import "random/distribution" take Distribution;
import "encoding/utf" take Utf8Encoded;
import "error" take InvalidArgument;
import "runtime/uuid" take uuid_named, uuid_versioned, uuid_custom, uuid_string, uuid_version,
    uuid_variant;

// RFC-compatible UUID generation that does not depend on host UUID libraries.
// Each maker is itself a Uuid:
//
//     let dns = UuidText(origin: "6ba7b810-9dad-11d1-80b4-00c04fd430c8");
//     let legacy is Uuid = Uuid3(namespace: dns, name: "example.com");
//     let stable is Uuid = Uuid5(namespace: dns, name: "example.com");
//     let custom is Uuid = Uuid8(high: 1, middle: 2, low: 3);
//     let random is Uuid = Uuid4s(random: SecureRandom()).sample();
//
// UUID 3 hashes namespace bytes followed by the exact UTF-8 name with MD5.
// UUID 5 does the same with SHA-1 and retains its first 128 bits. Both then set
// their version and RFC variant bits. The hash is computed once, on the first
// question.
//
// UUID 8 exposes all 122 custom bits explicitly: high is the most-significant
// 48 bits, middle is 12 bits after the version field, and low is the final 62
// bits after the variant field. All three inputs are unsigned and bounded.
//
// UUID 7 is intentionally absent until time/clock supplies a wall-clock
// Instant contract. Its generator must retain a shared monotonic
// per-millisecond counter. UUID 1 and UUID 6 are excluded from v3 until a
// privacy-preserving explicit node-identity capability is approved.

// Version 3: the MD5 of a namespace and a name, always the same for both.
object Uuid3 does Uuid, Comparing<Uuid> {
    has namespace is Uuid;
    has name is string;

    // The UUID of name in namespace.
    Uuid3(namespace is Uuid, name is string) {
        self.namespace = namespace;
        self.name = name;
    }

    // The namespace bytes and the UTF-8 name, hashed with MD5.
    bytes() is @byte {
        once let hashed = uuid_named(namespace.bytes(), Utf8Encoded(origin: name).bytes(), 3);
        hashed;
    }

    // The canonical lowercase text: `6ba7b810-9dad-11d1-80b4-00c04fd430c8`.
    string() is string {
        uuid_string(self.bytes());
    }

    // Its version number.
    version() is int {
        3;
    }

    // Its variant.
    variant() is UuidVariant {
        UuidVariant.rfc;
    }

    // Orders by the bytes.
    order(other is Uuid) is Order {
        self.string().order(other.string());
    }
}

// Version 5: the SHA-1 of a namespace and a name, always the same for both.
object Uuid5 does Uuid, Comparing<Uuid> {
    has namespace is Uuid;
    has name is string;

    // The UUID of name in namespace.
    Uuid5(namespace is Uuid, name is string) {
        self.namespace = namespace;
        self.name = name;
    }

    // The namespace bytes and the UTF-8 name, hashed with SHA-1.
    bytes() is @byte {
        once let hashed = uuid_named(namespace.bytes(), Utf8Encoded(origin: name).bytes(), 5);
        hashed;
    }

    // The canonical lowercase text: `6ba7b810-9dad-11d1-80b4-00c04fd430c8`.
    string() is string {
        uuid_string(self.bytes());
    }

    // Its version number.
    version() is int {
        5;
    }

    // Its variant.
    variant() is UuidVariant {
        UuidVariant.rfc;
    }

    // Orders by the bytes.
    order(other is Uuid) is Order {
        self.string().order(other.string());
    }
}

// Version 8: 122 bits of your own.
object Uuid8 does Uuid, Comparing<Uuid> {
    has high is int;
    has middle is int;
    has low is int;

    // high is 48 bits, middle 12 and low 62.
    Uuid8(high is int, middle is int, low is int) {
        confirm high >= 0 && high <= 281474976710655
            else throw InvalidArgument.because("UUID 8 high field must fit 48 bits");
        confirm middle >= 0 && middle <= 4095
            else throw InvalidArgument.because("UUID 8 middle field must fit 12 bits");
        confirm low >= 0 && low <= 4611686018427387903
            else throw InvalidArgument.because("UUID 8 low field must fit 62 bits");
        self.high = high;
        self.middle = middle;
        self.low = low;
    }

    // The 16 bytes.
    bytes() is @byte {
        uuid_custom(high, middle, low);
    }

    // The canonical lowercase text: `6ba7b810-9dad-11d1-80b4-00c04fd430c8`.
    string() is string {
        uuid_string(self.bytes());
    }

    // Its version number.
    version() is int {
        8;
    }

    // Its variant.
    variant() is UuidVariant {
        UuidVariant.rfc;
    }

    // Orders by the bytes.
    order(other is Uuid) is Order {
        self.string().order(other.string());
    }
}

// Random version 4 UUIDs.
object Uuid4s does Distribution<Uuid> {
    has random is SecureRandom;

    // UUIDs from random.
    Uuid4s(random is SecureRandom) {
        self.random = random;
    }

    // A new random UUID.
    sample() is Uuid {
        UuidBytes(origin: uuid_versioned(random.bytes(16), 4));
    }
}

test "named UUIDs match RFC 4122 vectors" {
    let dns = UuidText(origin: "6ba7b810-9dad-11d1-80b4-00c04fd430c8");
    let legacy = Uuid3(namespace: dns, name: "www.example.com");
    test.is(legacy.string(), "5df41881-3aed-3515-88a7-2f4a814cf09e");
    test.is(legacy.version(), 3);
    test.is(legacy.bytes(), UuidText(origin: legacy.string()).bytes());
    test.ok(UuidText(origin: legacy.string()).version() == 3);
    let stable = Uuid5(namespace: dns, name: "www.example.com");
    test.is(stable.string(), "2ed6657d-e927-568b-95e1-2665a8aea6a2");
    test.ok(UuidText(origin: stable.string()).variant() == UuidVariant.rfc);
    test.ok(stable.order(legacy) == Order.less);
}

test "custom UUIDs place their bits and refuse what does not fit" {
    let custom = Uuid8(high: 0, middle: 0, low: 0);
    test.is(custom.string(), "00000000-0000-8000-8000-000000000000");
    test.is(UuidText(origin: Uuid8(high: 281474976710655, middle: 4095, low: 4611686018427387903).string()).version(), 8);
    test.throws(InvalidArgument) {
        Uuid8(high: 281474976710656, middle: 0, low: 0);
    };
    test.throws(InvalidArgument) {
        Uuid8(high: 0, middle: 4096, low: 0);
    };
    test.throws(InvalidArgument) {
        Uuid8(high: 0, middle: 0, low: -1);
    };
}

test "random UUIDs are version 4, RFC variant, and differ" {
    let source = Uuid4s(random: SecureRandom());
    let first = source.sample();
    let second = source.sample();
    test.is(first.version(), 4);
    test.ok(first.variant() == UuidVariant.rfc);
    test.ok(first.string() != second.string());
}
