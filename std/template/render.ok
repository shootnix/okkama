module template/render v1.0.0;

// Writing a filled text template piece by piece to a destination, without
// building the whole text.
//
//     TemplateOutput(origin: template, data: bindings, destination: Stdout()).write();
//
// What was written before a failure stays written.

import "template/compile" take TextTemplate;
import "template/model" take TemplateStrings, TemplateBindings;
import "io/stream" take WritingText;
import "io/buffer" take ByteBuffer;
import "io/text" take Utf8Output;
import "encoding/utf" take Utf8Decoded;

// A template, its values and where it goes.
object TemplateOutput {
    has origin is TextTemplate;
    has data is TemplateStrings;
    has destination is WritingText;

    // Fills origin from data into destination.
    TemplateOutput(origin is TextTemplate, data is TemplateStrings, destination is WritingText) {
        self.origin = origin;
        self.data = data;
        self.destination = destination;
    }

    // Writes it, checking the whole source first.
    write() is void {
        origin.write(data, destination);
    }
}

test "streamed template command repeats and borrows destination" {
    let out = ByteBuffer();
    let command = TemplateOutput(
        origin: TextTemplate("Hello {{name}}"),
        data: TemplateStrings.fake(),
        destination: Utf8Output(origin: out.writing())
    );
    command.write();
    command.write();
    test.is(Utf8Decoded(out.content().bytes()).string(), "Hello AdaHello Ada");
    test.is(out.closing().closed(), false);
}

test "empty streamed template has no implicit newline" {
    let out = ByteBuffer();
    TemplateOutput(
        origin: TextTemplate(origin: "", maximum_input: 0, maximum_nodes: 0, maximum_output: 0),
        data: TemplateBindings(),
        destination: Utf8Output(origin: out.writing())
    ).write();
    test.is(out.content().size(), 0);
}
