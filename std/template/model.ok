module template/model v1.0.0;

import "template/path" take TemplatePath;

import "collections/sequence" take Sequencing;
import "compare" take Order;

// Explicit immutable string data for plain template interpolation. No arbitrary
// application objects, reflection, implicit JSON traversal, HTML trust or I/O.
// TemplateBinding(TemplatePath(["user","name"]), "Ada") binds exact coordinates.
// Its path()/string() expose those coordinates without parsing or escaping.
//
// TemplateBindings snapshots a Sequencing<TemplateBinding>; optional nonnegative
// maximum_bindings defaults to 1024. Empty/zero is valid. size() is read once;
// negative size/excess count fails before item access; then ascending items are
// read exactly once. Duplicate validation observes the completed snapshot.
// Path identity compares segment sequences: ["a.b"] differs from ["a","b"].
// Borrowed sources are never closed. Source exceptions propagate unchanged.
//
// string(path) returns a present value, including "", or MissingTemplateValue.
// Repeated queries never revisit the source. Returned strings/paths outlive this
// snapshot. Duplicate checking O(n²), lookup O(n), within the explicit item bound.
// Values are retained strings, not copied buffers; count does not bound text
// lengths. Compile/render objects supply independent source/output limits.
// No native handles/external resources or destroy.
// Run: OKKAMA_STDLIB_DIR=std perl okkama-pl/bin/okkama -t std/template/model.ok
role TemplateStrings {
    string(path is TemplatePath) is string;

    fake {
        string(path is TemplatePath) is string {
            test.is(path.string(), "name");
            "Ada";
        }
    }
}

object TemplateBinding {
    has key is TemplatePath;
    has value is string;

    TemplateBinding(path is TemplatePath, value is string) {
        key = path;
        self.value = value;
    }

    path() is TemplatePath {
        key;
    }

    string() is string {
        value;
    }
}

object TemplateBindings does TemplateStrings {
    has origin is @TemplateBinding;

    TemplateBindings(values is Sequencing<TemplateBinding>) {
        origin = TemplateBindingSnapshot(source: values, maximum: 1024).items();
    }

    TemplateBindings(values is Sequencing<TemplateBinding>, maximum_bindings is int) {
        origin = TemplateBindingSnapshot(source: values, maximum: maximum_bindings).items();
    }

    string(path is TemplatePath) is string {
        let found = (0..origin.size()).reduce(-1) -> previous, index {
            if origin[index].path().order(path) == Order.equal {
                index;
            }
            else {
                previous;
            }
        };
        confirm found >= 0 else throw MissingTemplateValue.path(path.string());
        origin[found].string();
    }
}

// Internal bounded snapshot collaborator; importable because module declarations
// have no private visibility. No item is reread during duplicate validation.
hidden object TemplateBindingSnapshot {
    has origin is @TemplateBinding;

    TemplateBindingSnapshot(source is Sequencing<TemplateBinding>, maximum is int) {
        confirm maximum >= 0 else throw InvalidTemplateBindingLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidTemplateBindingSize.invalid;
        confirm size <= maximum else throw TemplateBindingLimitExceeded.exceeded;
        let snapshot is @TemplateBinding = (0..size).map() -> index {
            source.item(index);
        };
        for (0..size) -> index {
            for (0..index) -> previous {
                confirm snapshot[index].path().order(snapshot[previous].path()) != Order.equal
                    else throw DuplicateTemplateValue.path((snapshot[index].path()).string());
            }
        }
        origin = snapshot;
    }

    items() is @TemplateBinding {
        origin;
    }
}

enum MissingTemplateValue is Error = (path(path is string));

enum DuplicateTemplateValue is Error = (path(path is string));

enum InvalidTemplateBindingLimit is Error = (invalid);

enum InvalidTemplateBindingSize is Error = (invalid);

enum TemplateBindingLimitExceeded is Error = (exceeded);

test "explicit template strings have exact nominal paths" {
    let data is TemplateStrings = TemplateBindings([
        TemplateBinding(path: TemplatePath(["user.name"]), value: "literal"),
        TemplateBinding(path: TemplatePath(["user", "name"]), value: "nested")
    ]);
    test.is(data.string(TemplatePath(["user.name"])), "literal");
    test.is(data.string(TemplatePath(["user", "name"])), "nested");
    test.is(TemplateStrings.fake().string(TemplatePath(["name"])), "Ada");
}

test "template binding errors retain path and budget contracts" {
    test.is(
        try {
            TemplateBindings(values: [], maximum_bindings: 0).string(TemplatePath(["missing"]));
            "";
        }
        catch MissingTemplateValue.path(path) {
            path.string();
        },
        "missing"
    );
    test.ok(try {
        TemplateBindings(values: [], maximum_bindings: -1);
        false;
    }
    catch error is InvalidTemplateBindingLimit {
        true;
    });
    test.ok(try {
        TemplateBindings(values: [TemplateBinding(path: TemplatePath(["a"]), value: "")], maximum_bindings: 0);
        false;
    }
    catch error is TemplateBindingLimitExceeded {
        true;
    });
    test.is(
        try {
            TemplateBindings([
                TemplateBinding(path: TemplatePath(["x"]), value: "1"),
                TemplateBinding(path: TemplatePath(["x"]), value: "2")
            ]);
            "";
        }
        catch DuplicateTemplateValue.path(path) {
            path.string();
        },
        "x"
    );
}
