module template/path v1.0.0;

// Template paths: `user.name` as its parts.
//
//     TemplatePath("user", "name").string();                 // "user.name"
//     TemplatePathFromString("user.name").path();
//
// By default at most 64 parts and 4096 characters.

import "collections/sequence" take Sequencing;
import "collections/list" take List, EmptyList;
import "compare" take Comparing, Order;

object TemplatePath does Comparing<TemplatePath> {
    has origin is @string;

    TemplatePath(segments is Sequencing<string>) {
        origin = TemplatePathSnapshot(source: segments, maximum_segments: 64, maximum_length: 4096).items();
    }

    // The same, one argument per part: TemplatePath(a, b).
    TemplatePath(segments is ...string) {
        let listed is @string = segments...;
        origin = TemplatePathSnapshot(source: listed, maximum_segments: 64, maximum_length: 4096).items();
    }

    TemplatePath(segments is Sequencing<string>, maximum_segments is int, maximum_length is int) {
        origin = TemplatePathSnapshot(
            source: segments,
            maximum_segments: maximum_segments,
            maximum_length: maximum_length
        ).items();
    }

    segments() is Sequencing<string> {
        origin;
    }

    string() is string {
        origin.join(".");
    }

    order(other is TemplatePath) is Order {
        let right = other.segments();
        let count = if origin.size() < right.size() {
            origin.size();
        }
        else {
            right.size();
        };
        let prefix = (0..count).reduce(Order.equal) -> previous, index {
            if previous == Order.equal {
                origin[index].order(right.item(index));
            }
            else {
                previous;
            }
        };
        if prefix == Order.equal {
            origin.size().order(right.size());
        }
        else {
            prefix;
        }
    }
}

object TemplatePathFromString {
    has origin is string;
    has maximum_segments, maximum_length is int;

    TemplatePathFromString(origin is string) {
        self.origin = origin;
        maximum_segments = 64;
        maximum_length = 4096;
    }

    TemplatePathFromString(origin is string, maximum_segments is int, maximum_length is int) {
        confirm maximum_segments >= 0 && maximum_length >= 0
            else throw InvalidTemplatePathLimit.invalid;
        self.origin = origin;
        self.maximum_segments = maximum_segments;
        self.maximum_length = maximum_length;
    }

    path() is TemplatePath {
        confirm origin.length() <= maximum_length else throw TemplatePathLimitExceeded.exceeded;
        confirm origin != "" && origin != "."
            else throw InvalidTemplatePath.because("empty or reserved template path");
        TemplatePath(
            segments: origin.split("."),
            maximum_segments: maximum_segments,
            maximum_length: maximum_length
        );
    }
}

// Internal snapshot collaborators. Public only because modules have no private
// declaration visibility. Revisions retain immutable list tails; no mutation.
// Validate each item and remaining length before retaining it.
hidden object TemplatePathSnapshot {
    has origin is @string;

    TemplatePathSnapshot(
        source is Sequencing<string>,
        maximum_segments is int,
        maximum_length is int
    ) {
        confirm maximum_segments >= 0 && maximum_length >= 0
            else throw InvalidTemplatePathLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidTemplatePathSize.invalid;
        confirm size > 0 else throw InvalidTemplatePath.because("empty template path");
        confirm size <= maximum_segments else throw TemplatePathLimitExceeded.exceeded;
        let parts = (0..size).reduce(TemplatePathParts(maximum_length)) -> previous, index {
            previous.following(source.item(index));
        };
        origin = parts.items();
    }

    items() is @string {
        origin;
    }
}

hidden object TemplatePathParts {
    has maximum is int;
    has used is int = 0;
    has origin is List<string>;

    TemplatePathParts(maximum is int) {
        confirm maximum >= 0 else throw InvalidTemplatePathLimit.invalid;
        self.maximum = maximum;
        let empty is List<string> = EmptyList();
        origin = empty;
    }

    following(segment is string) is ^TemplatePathParts {
        confirm segment != "" else throw InvalidTemplatePath.because("empty template path segment");
        let gap = if origin.size() > 0 {
            1;
        }
        else {
            0;
        };
        confirm gap <= maximum - used && segment.length() <= maximum - used - gap
            else throw TemplatePathLimitExceeded.exceeded;
        ^used = used + gap + segment.length();
        ^origin = origin.prefix(segment);
    }

    items() is @string {
        let reversed is @string = origin.map() -> segment {
            segment;
        };
        (0..reversed.size()).map() -> index {
            reversed[reversed.size() - 1 - index];
        };
    }
}

enum InvalidTemplatePath is Error = (because(reason is string));

enum InvalidTemplatePathSize is Error = (invalid);

enum InvalidTemplatePathLimit is Error = (invalid);

enum TemplatePathLimitExceeded is Error = (exceeded);

test "template path coordinates and comparison are nominal" {
    let path = TemplatePathFromString("user.name").path();
    test.is(path.string(), "user.name");
    test.is(path.segments().size(), 2);
    test.is(TemplatePath("a.b").order(TemplatePath("a", "b")), Order.greater);
}

test "template paths reject syntax and resource bounds" {
    test.ok(try {
        TemplatePathFromString(".").path();
        false;
    }
    catch error is InvalidTemplatePath {
        true;
    });
    test.ok(try {
        TemplatePath("");
        false;
    }
    catch error is InvalidTemplatePath {
        true;
    });
    test.is(
        TemplatePath(segments: ["é", "😀"], maximum_segments: 2, maximum_length: 3).string(),
        "é.😀"
    );
    test.ok(try {
        TemplatePath(segments: ["é", "😀"], maximum_segments: 2, maximum_length: 2);
        false;
    }
    catch error is TemplatePathLimitExceeded {
        true;
    });
    test.ok(try {
        TemplatePath(segments: ["a"], maximum_segments: -1, maximum_length: 3);
        false;
    }
    catch error is InvalidTemplatePathLimit {
        true;
    });
}
