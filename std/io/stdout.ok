module io/stdout v1.0.0;

import "io/stream" take Writing, WritingText, ByteSource, IncompleteWrite;
import "encoding/utf" take Utf8Encoded;
import "runtime/stdio" take stdout_write, stderr_write, stdout_flush;

// Process standard output capabilities.
//
//     Stdout().write("answer: ", answer.string());
//     Stdout().writeln("ready");
//     Stdout() <- "raw UTF-8 text" <- packet <- "\n";
//
//     Stderr().writeln("cannot continue");
//
// ByteSource writes preserve the exact source octets. Text writes encode every
// string as strict UTF-8, concatenate only by writing arguments in order, and
// add no separators. writeln appends exactly one LF after all arguments. Empty
// write() emits nothing; empty writeln() emits one LF. No method formats
// arbitrary values: callers use explicit .string() or strings/format objects.
//
// Standard output is buffered by the runtime, for every Stdout value at once: a
// terminal gets each line as it ends, a pipe or a file gets the bytes in blocks.
// Stdout().flush() writes out what is pending. The runtime also does that
// before anything goes to standard error, before standard input is read from a
// terminal, before a child process starts and when the program ends. Standard
// error is not buffered; Stderr().flush() has nothing to do.
//
// The runtime boundary reports an accepted prefix length. A short count is
// exposed as IncompleteWrite; errors are never retried here.

object Stdout does Writing, WritingText {
    Stdout();

    write(source is ByteSource) is void {
        self.write_bytes(source.bytes());
    }

    write(bytes is @byte) is void {
        self.write_bytes(bytes);
    }

    flush() is void {
        stdout_flush();
    }

    write(values is ...string) is void {
        let data is @string = values...;
        for data -> value {
            self.write_text(value);
        }
    }

    writeln(values is ...string) is void {
        let data is @string = values...;
        for data -> value {
            self.write_text(value);
        }
        self.write_text("\n");
    }

    hidden write_text(value is string) is void {
        self.write_bytes(Utf8Encoded(origin: value).bytes());
    }

    hidden write_bytes(value is @byte) is void {
        let written is int = stdout_write(value);
        confirm written == value.size() else throw IncompleteWrite.after(written);
    }
}

object Stderr does Writing, WritingText {
    Stderr();

    write(source is ByteSource) is void {
        self.write_bytes(source.bytes());
    }

    write(bytes is @byte) is void {
        self.write_bytes(bytes);
    }

    flush() is void {}

    write(values is ...string) is void {
        let data is @string = values...;
        for data -> value {
            self.write_text(value);
        }
    }

    writeln(values is ...string) is void {
        let data is @string = values...;
        for data -> value {
            self.write_text(value);
        }
        self.write_text("\n");
    }

    hidden write_text(value is string) is void {
        self.write_bytes(Utf8Encoded(origin: value).bytes());
    }

    hidden write_bytes(value is @byte) is void {
        let written is int = stderr_write(value);
        confirm written == value.size() else throw IncompleteWrite.after(written);
    }
}

test "empty writes emit nothing and flush is a no-op" {
    Stdout().write();
    Stdout().flush();
    Stderr().write();
    Stderr().flush();
    test.ok(true);
}
