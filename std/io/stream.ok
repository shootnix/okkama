module io/stream v1.0.0;

// Small nominal contracts for byte and text streams.
//
//     writer.write(packet);
//     writer.flush();
//     writer <- "header: " <- payload <- "\n";
//
// `<-` accepts a formal ByteSource. Only inside that operator, builtin string
// is adapted through strict UTF-8 and builtin @byte is adapted without any
// transformation. Explicit `writer <- array_expression...` writes each source
// in order after evaluating the array once; empty arrays make no writes.
// No other value is converted implicitly. The operator calls
// Writing.write(), then returns the same Writing capability so left-associated
// chains remain commands rather than builders. Every operand is evaluated once
// from left to right; a failed write prevents evaluation of later sources.
//
// Writing.write() either consumes the complete source or throws
// IncompleteWrite.after(written) with the consumed prefix length. It does not
// retry, flush or close implicitly. Reading.bytes(limit) requires limit > 0. An empty result is
// normal EOF, remains empty on later reads, and is not an error.

role ByteSource {
    bytes() is @byte;
}

role Writing {
    write(source is ByteSource) is void;
    write(bytes is @byte) is void;
    flush() is void;
}

role Reading {
    bytes(limit is int) is @byte;
}

// Nominal asynchronous byte input. A positive limit bounds each result; short
// reads are valid and empty bytes mean permanent orderly EOF. Implementations
// reject non-positive limits with InvalidReadLimit. Each call returns
// a lazy Future; repeated await of that Future observes the same read outcome.
// This role does not imply synchronous Reading, resource ownership or close().
role AsyncReading {
    async bytes(limit is int) is @byte;
}

// Nominal asynchronous all-or-failure output, returning the same capability.
// ByteSource materialization belongs to the started write; failures propagate.
// A failed write may already have emitted a prefix: no rollback/replay promise.
// Await each write explicitly; this role has no flush() or synchronous Writing
// conformance and is not an operand for the synchronous stream-write operator.
// Concrete socket halves must separately implement serialization and cleanup.
role AsyncWriting {
    async write(source is ByteSource) is AsyncWriting;
    async write(bytes is @byte) is AsyncWriting;
}

role WritingText {
    write(values is ...string) is void;
    writeln(values is ...string) is void;
}

role ReadingText {
    line() is string;
    content() is string;
}

role Closing {
    closed() is bool;
    close() is void;
}

// IncompleteWrite.after(written) carries the consumed prefix length;
// InvalidReadLimit.limit(value) carries the rejected limit.
enum IncompleteWrite is Error = (after(written is int));

enum InvalidReadLimit is Error = (limit(value is int));
