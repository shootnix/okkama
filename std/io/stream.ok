module io/stream v1.0.0;

// The roles every byte and text stream of std plays: Reading and Writing for
// bytes, AsyncReading and AsyncWriting for streams that wait, ReadingText and
// WritingText for text, ByteSource for something that has bytes, and Closing.
//
//     writer.write(packet);
//     writer <- "header: " <- payload <- "\n";
//     writer.flush();
//     let piece = reader.bytes(4096);          // [] is the end
//
// `<-` writes any ByteSource; only inside that operator a string is written as
// strict UTF-8 and an @byte as it is. Explicit `writer <- parts...` writes each
// element of the array in order. The operator calls Writing.write and gives
// back the same Writing, so chains read left to right; a failed write stops the
// chain.
//
// Writing.write takes the whole source or throws IncompleteWrite.after(written)
// with the number of bytes taken; it neither retries, nor flushes, nor closes.
// Reading.bytes(limit) needs limit > 0 and returns at most limit bytes; an
// empty result is the end, and stays the end.
//
// # Errors
//
// - IncompleteWrite.after(written): a write took only the first written bytes.
// - InvalidReadLimit.limit(value): a read limit below one.

// Something that has bytes to write: Utf8Encoded(text), ByteSnapshot(bytes) and
// more.
role ByteSource {
    // The bytes, the same ones each time.
    bytes() is @byte;
}

// A byte output: files, sockets, buffers, Stdout.
role Writing {
    // Writes all the bytes of source, or throws IncompleteWrite with how many
    // went.
    write(source is ByteSource) is void;
    // Writes all the bytes, or throws IncompleteWrite with how many went.
    write(bytes is @byte) is void;
    // Sends on whatever the output still holds.
    flush() is void;
}

// A byte input read in pieces.
role Reading {
    // At most limit bytes (limit > 0); [] at the end.
    bytes(limit is int) is @byte;
}

// Nominal asynchronous byte input. A positive limit bounds each result; short
// reads are valid and empty bytes mean permanent orderly EOF. Implementations
// reject non-positive limits with InvalidReadLimit. Each call returns
// a lazy Future; repeated await of that Future observes the same read outcome.
// This role does not imply synchronous Reading, resource ownership or close().
role AsyncReading {
    // At most limit bytes once they come; [] at the end.
    async bytes(limit is int) is @byte;
}

// Nominal asynchronous all-or-failure output, returning the same capability.
// ByteSource materialization belongs to the started write; failures propagate.
// A failed write may already have emitted a prefix: no rollback/replay promise.
// Await each write explicitly; this role has no flush() or synchronous Writing
// conformance and is not an operand for the synchronous stream-write operator.
// Concrete socket halves must separately implement serialization and cleanup.
role AsyncWriting {
    // Writes all the bytes of source and gives back this output, for chaining.
    async write(source is ByteSource) is AsyncWriting;
    // Writes all the bytes and gives back this output, for chaining.
    async write(bytes is @byte) is AsyncWriting;
}

// A text output: arguments are written in order, as UTF-8 unless the output
// says otherwise.
role WritingText {
    // Writes the strings one after another, with nothing between them.
    write(values is ...string) is void;
    // Writes the strings and then one LF.
    writeln(values is ...string) is void;
}

// A text input read by lines or whole.
role ReadingText {
    // The next line without its line end.
    line() is string;
    // Everything that is left, as one string.
    content() is string;
}

// A resource that can be closed; closing twice is fine.
role Closing {
    // Whether it is closed.
    closed() is bool;
    // Closes it; a closed resource stays closed.
    close() is void;
}

// A write that took only part of its bytes: written says how many.
enum IncompleteWrite is Error = (after(written is int));

// A read limit below one.
enum InvalidReadLimit is Error = (limit(value is int));
