module io/input v1.0.0;

import "io/stream" take AsyncReading;
import "async/atomic" take Atomic;
import "encoding/bytes" take ByteSearch, ByteRange;
import "error" take InvalidArgument, OutOfRange;
import "runtime/bytes" take bytes_join;

// Buffered reading of an asynchronous byte stream, for protocol parsers.
//
//     let input = ByteInput(connection);
//     let status = await input.line([byte(13), byte(10)], 1024) else [];
//     if await input.ensure(5) {
//         let tag is byte = input.peek(0);
//         let size is int = input.range(1, 5).integer(Signedness.signed, ByteOrder.big);
//         input.skip(5);
//         let body is @byte = await input.ensure(size) ?? input.take(size) !! [];
//     }
//
// ensure(count) reads from the source until count unconsumed bytes are
// buffered or the source ends. peek, range, take and skip work on those
// buffered bytes only, at offsets counted from the first unconsumed byte;
// asking for more than available() fails with OutOfRange. range() is a view
// of the buffer, valid until the next ensure() or line(), which may replace
// the buffer. An input belongs to one reader: concurrent calls are not
// serialized.

// A line(terminator, limit) found no terminator within limit bytes.
enum LineTooLong is Error = (after(limit is int));

object ByteInput {
    has source is AsyncReading;
    has buffer is Atomic<@byte>;
    has position is Atomic<int>;
    has finished is Atomic<bool>;

    ByteInput(source is AsyncReading) {
        self.source = source;
        buffer = Atomic([]);
        position = Atomic(0);
        finished = Atomic(false);
    }

    // Whether count unconsumed bytes are buffered, reading the source as
    // needed; false when it ended first.
    async ensure(count is int) is bool {
        confirm count >= 0 else throw InvalidArgument.because("byte count must not be negative");
        loop {
            last true if self.available() >= count;
            last false if !(await self.fill(count - self.available()));
        }
    }

    // Unconsumed buffered bytes.
    available() is int {
        buffer.value().size() - position.value();
    }

    // The buffered byte at offset at.
    peek(at is int) is byte {
        confirm at >= 0 && at < self.available()
            else throw OutOfRange.because("peek is outside the buffered input");
        buffer.value()[position.value() + at];
    }

    // The buffered bytes start..end, without consuming or copying them.
    range(start is int, end is int) is ByteRange {
        confirm start >= 0 && start <= end && end <= self.available()
            else throw OutOfRange.because("range is outside the buffered input");
        let at is int = position.value();
        ByteRange(buffer.value(), at + start, at + end);
    }

    // Consume count buffered bytes and return them.
    take(count is int) is @byte {
        self.consume(count);
        let at is int = position.value();
        buffer.value().slice(at - count, at);
    }

    // Consume count buffered bytes.
    skip(count is int) is void {
        self.consume(count);
    }

    // The next line without its terminator, consumed together with it.
    // Maybe.none at the end of the source; unterminated bytes before the end
    // are the last line. A line longer than limit fails with LineTooLong.
    async line(terminator is @byte, limit is int) is Maybe<@byte> {
        confirm terminator.size() > 0
            else throw InvalidArgument.because("line terminator must not be empty");
        confirm limit >= 0 else throw InvalidArgument.because("line limit must not be negative");
        let searched = Atomic(0);
        loop {
            let at is int = position.value();
            let found is int = ByteSearch(buffer.value(), terminator).from(at + searched.value());
            if found >= 0 {
                confirm found - at <= limit else throw LineTooLong.after(limit);
                position.replace(found + terminator.size());
                last Maybe.some(buffer.value().slice(at, found));
            }
            confirm self.available() < limit + terminator.size()
                else throw LineTooLong.after(limit);
            // A terminator may straddle the next read: search its tail again.
            let tail is int = self.available() - terminator.size() + 1;
            searched.replace(if tail > 0 {
                tail;
            }
            else {
                0;
            });
            if !(await self.fill(1)) {
                last Maybe<@byte>.none if self.available() == 0;
                confirm self.available() <= limit else throw LineTooLong.after(limit);
                let rest is @byte = self.take(self.available());
                last Maybe.some(rest);
            }
        }
    }

    private:

    consume(count is int) is void {
        confirm count >= 0 && count <= self.available()
            else throw OutOfRange.because("count is outside the buffered input");
        position.replace(position.value() + count);
    }

    // Read at least one more byte (asking for wanted, at least 64 KiB) after
    // the unconsumed ones; false at the end of the source.
    async fill(wanted is int) is bool {
        if finished.value() {
            false;
        }
        else {
            let chunk is @byte = await source.bytes(if wanted > 65536 {
                wanted;
            }
            else {
                65536;
            });
            if chunk.size() == 0 {
                finished.replace(true);
                false;
            }
            else {
                buffer.replace(bytes_join(buffer.value(), position.value(), chunk));
                position.replace(0);
                true;
            }
        }
    }
}

hidden object ChunkReading does AsyncReading {
    has chunks is @@byte;
    has cursor is Atomic<int>;

    ChunkReading(chunks is @@byte) {
        self.chunks = chunks;
        cursor = Atomic(0);
    }

    async bytes(limit is int) is @byte {
        let at is int = cursor.value();
        if at >= chunks.size() {
            [];
        }
        else {
            cursor.replace(at + 1);
            chunks[at];
        }
    }
}

async test "lines are found across reads" {
    let crlf is @byte = [byte(13), byte(10)];
    let input = ByteInput(
        ChunkReading(
            [[byte(97), byte(98), byte(13)], [byte(10), byte(99), byte(13), byte(10)], [byte(100)]]
        )
    );
    test.is(await input.line(crlf, 10) else [byte(0)], [byte(97), byte(98)]);
    test.is(await input.line(crlf, 10) else [byte(0)], [byte(99)]);
    test.is(await input.line(crlf, 10) else [byte(0)], [byte(100)]);
    test.is(await input.line(crlf, 10) else [byte(0)], [byte(0)]);
}

async test "buffered bytes are peeked, viewed and consumed" {
    let input = ByteInput(ChunkReading([[byte(1), byte(2)], [byte(3), byte(4), byte(5)]]));
    test.is(input.available(), 0);
    test.is(await input.ensure(4), true);
    test.is(input.available(), 5);
    test.is(input.peek(0), byte(1));
    test.is(input.range(1, 3).bytes(), [byte(2), byte(3)]);
    input.skip(1);
    test.is(input.take(2), [byte(2), byte(3)]);
    test.is(await input.ensure(3), false);
    test.is(input.available(), 2);
    test.is(input.take(2), [byte(4), byte(5)]);
    test.is(await input.ensure(0), true);
    test.is(await input.ensure(1), false);
}

async test "limits and bounds fail with typed errors" {
    let lf is @byte = [byte(10)];
    let long = ByteInput(ChunkReading([[byte(97), byte(98), byte(99), byte(10)]]));
    test.is(
        try {
            await long.line(lf, 2);
            0;
        }
        catch LineTooLong.after(limit) {
            limit;
        },
        2
    );
    let exact = ByteInput(ChunkReading([[byte(97), byte(98), byte(10)]]));
    test.is(await exact.line(lf, 2) else [], [byte(97), byte(98)]);
    let unterminated = ByteInput(ChunkReading([[byte(97), byte(98), byte(99)]]));
    test.is(
        try {
            await unterminated.line(lf, 2);
            0;
        }
        catch LineTooLong.after(limit) {
            limit;
        },
        2
    );
    let wide = ByteInput(ChunkReading([[byte(97), byte(98), byte(99)]]));
    test.is(
        try {
            await wide.line([byte(13), byte(10)], 2);
            0;
        }
        catch LineTooLong.after(limit) {
            limit;
        },
        2
    );
    let short = ByteInput(ChunkReading([[byte(1)]]));
    test.is(await short.ensure(1), true);
    test.is(
        try {
            short.take(2);
            "taken";
        }
        catch OutOfRange.because(reason) {
            reason;
        },
        "count is outside the buffered input"
    );
    test.is(
        try {
            short.peek(1);
            "peeked";
        }
        catch OutOfRange.because(reason) {
            reason;
        },
        "peek is outside the buffered input"
    );
    test.is(
        try {
            short.range(0, 2);
            "made";
        }
        catch OutOfRange.because(reason) {
            reason;
        },
        "range is outside the buffered input"
    );
}
