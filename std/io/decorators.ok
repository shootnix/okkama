module io/decorators v1.0.0;

// Readers and writers that wrap others: read ahead, stop at a limit, read one
// source after another, write to several outputs, or write nowhere.
//
//     let buffered = BufferedReading(origin: socket, capacity: 8192);
//     let header = buffered.bytes(32);
//     let prefix = LimitedReading(origin: file, limit: 1024);
//     let combined = ChainedReading(origins: parts);
//     TeeWriting(destinations: outputs).write(packet);
//     Discarding().write(packet);
//
// None of them owns or closes what it wraps.
//
// - BufferedReading reads ahead only when its cache is empty: it asks for the
//   larger of the size asked and its capacity, hands out what was asked and
//   keeps the rest. close() clears only its cache.
// - LimitedReading gives at most limit bytes over all its reads.
// - ChainedReading moves to the next origin when the current one ends with [].
// - TeeWriting takes one snapshot of the source and writes it to each
//   destination in order; the first failure stops the rest, and outputs already
//   written are not undone.
// - Discarding reads source.bytes() once and keeps nothing.

import "io/stream" take ByteSource, Reading, Writing, Closing, InvalidReadLimit;
import "collections/sequence" take Sequencing;
import "error" take InvalidArgument;
import "io/buffer" take ByteBuffer;
import "runtime/buffer" take BufferState, buffer_state_create, buffer_state_read,
    buffer_state_append, buffer_state_size, buffer_state_closed, buffer_state_close;
import "runtime/io_decorators" take LimitedReadingState, ChainedReadingState,
    limited_reading_state_create, limited_reading_state_remaining, limited_reading_state_consume,
    chained_reading_state_create, chained_reading_state_position, chained_reading_state_advance;

// Reads ahead from origin in pieces of at least capacity bytes, 8192 unless
// told.
object BufferedReading does Reading, Closing {
    has origin is Reading;
    has capacity is int;
    has cache is BufferState;

    // Reads ahead 8192 bytes at a time.
    BufferedReading(origin is Reading) {
        self.origin = origin;
        capacity = 8192;
        cache = buffer_state_create([]);
    }

    // Reads ahead at least capacity bytes at a time; capacity must be positive.
    BufferedReading(origin is Reading, capacity is int) {
        confirm capacity > 0
            else throw InvalidArgument.because("buffer capacity must be positive");
        self.origin = origin;
        self.capacity = capacity;
        cache = buffer_state_create([]);
    }

    // At most limit bytes, from the cache first; [] at the end.
    bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        confirm !self.closed() else throw ClosedReading.closed;
        if buffer_state_size(cache) == 0 {
            let requested is int = if limit > capacity {
                limit;
            }
            else {
                capacity;
            };
            let chunk is @byte = origin.bytes(requested);
            confirm chunk.size() <= requested
                else throw InvalidReading.because("origin returned more bytes than requested");
            buffer_state_append(cache, chunk);
        }
        let available is int = buffer_state_size(cache);
        if available == 0 {
            [];
        }
        else {
            let amount is int = if limit < available {
                limit;
            }
            else {
                available;
            };
            buffer_state_read(cache, amount);
        }
    }

    // Whether the cache is closed.
    closed() is bool {
        buffer_state_closed(cache);
    }

    // Drops the cache; origin stays open.
    close() is void {
        buffer_state_close(cache);
    }
}

// At most limit bytes of origin, over all reads together.
object LimitedReading does Reading {
    has origin is Reading;
    has state is LimitedReadingState;

    // Reads at most limit bytes of origin; limit must not be negative.
    LimitedReading(origin is Reading, limit is int) {
        confirm limit >= 0
            else throw InvalidArgument.because("reading limit cannot be negative");
        self.origin = origin;
        state = limited_reading_state_create(limit);
    }

    // At most size bytes and no more than are left of the limit; [] once it is
    // used up.
    bytes(size is int) is @byte {
        confirm size > 0 else throw InvalidReadLimit.limit(size);
        let remaining is int = limited_reading_state_remaining(state);
        if remaining == 0 {
            [];
        }
        else {
            let requested is int = if size < remaining {
                size;
            }
            else {
                remaining;
            };
            let chunk is @byte = origin.bytes(requested);
            confirm chunk.size() <= requested
                else throw InvalidReading.because("origin exceeded the limited-reading request");
            limited_reading_state_consume(state, chunk.size());
            chunk;
        }
    }
}

// The origins read one after another, as one input.
object ChainedReading does Reading {
    has origins is Sequencing<Reading>;
    has state is ChainedReadingState;

    // Reads each origin to its end, in order.
    ChainedReading(origins is Sequencing<Reading>) {
        self.origins = origins;
        state = chained_reading_state_create();
    }

    // At most size bytes of the current origin; [] after the last one ends.
    bytes(size is int) is @byte {
        confirm size > 0 else throw InvalidReadLimit.limit(size);
        loop {
            let position is int = chained_reading_state_position(state);
            last [] if position >= origins.size();
            let chunk is @byte = origins.item(position).bytes(size);
            confirm chunk.size() <= size
                else throw InvalidReading.because(
                    "chained origin returned more bytes than requested"
                );
            last chunk if chunk.size() > 0;
            chained_reading_state_advance(state);
        }
    }
}

// Bytes as a ByteSource, for writing them with `<-` or Writing.write.
object ByteSnapshot does ByteSource {
    has value is @byte;

    // A source of exactly these bytes.
    ByteSnapshot(origin is @byte) {
        value = origin;
    }

    // The bytes.
    bytes() is @byte {
        value;
    }
}

// One write sent to several outputs in order.
object TeeWriting does Writing {
    has destinations is Sequencing<Writing>;

    // Writes to every destination, in sequence order.
    TeeWriting(destinations is Sequencing<Writing>) {
        self.destinations = destinations;
    }

    // Writes one snapshot of source to each destination; the first failure
    // stops the rest.
    write(source is ByteSource) is void {
        self.write(source.bytes());
    }

    // Writes the bytes to each destination; the first failure stops the rest.
    write(bytes is @byte) is void {
        for (0..destinations.size()) -> index {
            destinations.item(index).write(bytes);
        }
    }

    // Flushes each destination in order.
    flush() is void {
        for (0..destinations.size()) -> index {
            destinations.item(index).flush();
        }
    }
}

// An output that throws everything away, for tests and measurements.
object Discarding does Writing {
    // An output that keeps nothing.
    Discarding();

    // Reads source.bytes() once and drops them.
    write(source is ByteSource) is void {
        source.bytes();
    }

    // Drops the bytes.
    write(bytes is @byte) is void {
        return;
    }

    // Nothing to do.
    flush() is void {}
}

// The reading was closed.
enum ClosedReading is Error = (closed);

// A decorator was given something it cannot use; message says what.
enum InvalidReading is Error = (because(message is string));

test "buffered and limited readings" {
    let source = ByteBuffer(initial: [byte(1), byte(2), byte(3), byte(4), byte(5)]);
    let buffered = BufferedReading(origin: source.reading(), capacity: 4);
    test.is(buffered.bytes(1), [byte(1)]);
    // Four bytes were read ahead; three are cached.
    test.is(source.content().size(), 1);
    test.is(buffered.bytes(10), [byte(2), byte(3), byte(4)]);
    test.is(buffered.bytes(10), [byte(5)]);
    test.is(buffered.bytes(10).size(), 0);
    buffered.close();
    test.ok(buffered.closed());
    test.is(
        try {
            buffered.bytes(1).size();
        }
        catch error is ClosedReading {
            -1;
        },
        -1
    );
    let limited = LimitedReading(
        origin: ByteBuffer(initial: [byte(9), byte(8), byte(7)]).reading(),
        limit: 2
    );
    test.is(limited.bytes(1), [byte(9)]);
    test.is(limited.bytes(5), [byte(8)]);
    test.is(limited.bytes(5).size(), 0);
}

test "chained readings, snapshots, tees and discarding" {
    let first = ByteBuffer(initial: [byte(1)]);
    let empty = ByteBuffer();
    let third = ByteBuffer(initial: [byte(2), byte(3)]);
    let parts is @Reading = [first.reading(), empty.reading(), empty.reading(), third.reading()];
    let chained = ChainedReading(origins: parts);
    test.is(chained.bytes(10), [byte(1)]);
    test.is(chained.bytes(10), [byte(2), byte(3)]);
    test.is(chained.bytes(10).size(), 0);
    test.is(ByteSnapshot([byte(4)]).bytes(), [byte(4)]);
    let left = ByteBuffer();
    let right = ByteBuffer();
    let outputs is @Writing = [left.writing(), right.writing()];
    TeeWriting(destinations: outputs).write([byte(7), byte(8)]);
    test.is(left.content().bytes(), [byte(7), byte(8)]);
    test.is(right.content().bytes(), [byte(7), byte(8)]);
    Discarding().write([byte(1)]);
}
