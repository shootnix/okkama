; 30! with a loop: exact integers grow into BigInt transparently.
sparrow 10
module "factorial" "1.0.0"
type t0 int
type t1 bool
type t2 str
type t3 byte
type t4 array t3

function f0 "write" native "runtime/stdio@1::stdout_write/1" {
    registers [t4]
    params [r0]
    result t0
}

; r0 n, r1 product, r2 one, r3 limit, r4 n <= limit, r5..r8 printing
function f1 "main" {
    registers [t0, t0, t0, t0, t1, t2, t2, t2, t4]
    params []
    result t0
    0: const r0, int 1
    1: const r1, int 1
    2: const r2, int 1
    3: const r3, int 30
    4: int.cmp le, r4, r0, r3
    5: br r4, @6, @9
    6: int.mul r1, r1, r0
    7: int.add r0, r0, r2
    8: jmp @4
    9: cvt r5, r1
    10: const r6, str "\n"
    11: str.concat r7, r5, r6
    12: str.utf8 r8, r7
    13: call _, f0, [r8]
    14: const r0, int 0
    15: ret r0
}

entry f1
