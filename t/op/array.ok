module t v1.0.0;

// t/op: arrays (Book ch. 8.1 and 10).
import "tap" take Tap;

main() is int {
    let t = Tap(29);
    let xs = [10, 20, 30];
    t = t.is(xs[1], 20, "indexing");
    t = t.is(xs[9] else 0, 0, "else on an index out of bounds");
    t = t.is(xs.size(), 3, "size");
    t = t.is(xs.first(), 10, "first");
    t = t.is(xs.last(), 30, "last");
    t = t.is(xs.item(2), 30, "item");
    t = t.is(xs.slice(1, 3).size(), 2, "slice");
    t = t.ok(xs.slice(1, 3) == [20, 30], "slice is end-exclusive");
    let typed is @int = [1, 2, 3,];
    t = t.is(typed.size(), 3, "a trailing comma");
    let spread = [0, 2..=4, 9];
    t = t.ok(spread == [0, 2, 3, 4, 9], "ranges expand in a literal");
    t = t.ok(xs.contains(20) && !xs.contains(25), "contains");
    t = t.ok((xs.index_of(30) else -1) == 2, "index_of");
    t = t.ok(xs.reversed() == [30, 20, 10], "reversed");
    t = t.ok(xs.take(2) == [10, 20], "take");
    t = t.ok(xs.drop(2) == [30], "drop");
    t = t.ok(xs.take(9) == xs, "take more than there is");
    let empty = [];
    t = t.is(empty.size(), 0, "the empty array");
    t = t.ok([[1], [2, 3]] != [[1], [3, 2]], "deep equality keeps order");
    let nested is @@int = [[1], [2, 3]];
    t = t.is(nested[1][0], 2, "nested arrays");
    let original = [1, 2];
    let longer = original + [3];
    t = t.ok(original == [1, 2] && longer == [1, 2, 3], "arrays are immutable");
    t = t.is(@string("a", "b").size(), 2, "@string(...)");
    // replaced(index, value) (#250): a new array, the receiver unchanged.
    let swapped = xs.replaced(1, 99);
    t = t.ok(swapped == [10, 99, 30] && xs == [10, 20, 30], "replaced leaves the receiver");
    t = t.ok(xs.replaced(0, 1) == [1, 20, 30] && xs.replaced(2, 3) == [10, 20, 3], "replaced at both ends");
    t = t.ok([5].replaced(0, 6) == [6], "replaced in a one-element array");
    t = t.ok(xs.replaced(0, 1).replaced(1, 2).replaced(2, 3) == [1, 2, 3], "replaced in a chain");
    t = t.ok(nested.replaced(0, []) == [[], [2, 3]], "replaced with an empty element");
    // removed_at(index) (#251): by position; `-` removes by value.
    t = t.ok(xs.removed_at(1) == [10, 30] && xs == [10, 20, 30], "removed_at leaves the receiver");
    t = t.ok([5].removed_at(0) == [] && xs.removed_at(0).removed_at(1) == [20], "removed_at down to empty and in a chain");
    t = t.ok([1, 2, 1].removed_at(0) == [2, 1] && [1, 2, 1] - [1] == [2], "removed_at is by position, - by value");
    t.done();
}
