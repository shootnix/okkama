module t v1.0.0;

// t/op: scalar casts T(value) and array casts @T(...) (Book ch. 5.1.1).
import "tap" take Tap;

main() is int {
    let t = Tap(12);
    t = t.is(string(101), "101", "string(int)");
    t = t.is(int(-3.9), -3, "int(float) truncates");
    t = t.is(float(3), 3.0, "float(int)");
    t = t.is(int(7 / 2), 3, "int(rat)");
    t = t.is(string(1 / 3), "1/3", "string(rat) is canonical");
    t = t.is(string(true), "true", "string(bool)");
    t = t.is(string('q'), "q", "string(char)");
    let labels = @string(101, byte(2), true);
    t = t.is(labels.join(","), "101,2,true", "@string(...) converts each operand");
    let packet = @byte(122, 11, 22);
    t = t.is(packet[0].int(), 122, "@byte(...)");
    let more = [1, 2];
    t = t.is(@byte(0, more..., 255).size(), 4, "spread in an array cast");
    t = t.is(@int().size(), 0, "empty array cast");
    t = t.is(7.byte().int(), 7, "int.byte()");
    t.done();
}
