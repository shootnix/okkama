module app;
import "io/stdout" take Stdout;
import "async/atomic" take Atomic;

// Exercises every runtime helper of the Sparrow core (#23); the test reads
// the helper counts of `--stats`.
enum Boom is Error = (boom(code is int));

object Guard {
    has name is string;
    Guard(name is string) { self.name = name; }
    label() is string { name; }
    destroy { Stdout().writeln("destroy " + name); }
}

object Square {
    has n is int;
    Square(n is int) { self.n = n; }
    async run() is int { n * n; }
}

object Tasks {
    Tasks();
    async run() is int {
        let first = await Square(7).run();
        let pending = spawn Square(8).run();
        let second = await pending;
        let idle = spawn Square(9).run();
        idle.cancel();
        first + second;
    }
}

object Work {
    Work();
    adder(amount is int) is (int) is int {
        (value is int) is int { value + amount; };
    }
    fail(code is int) is int { throw Boom.boom(code); }
    guarded(n is int) is string {
        let guard = Guard("guard-" + n.string());
        guard.label() + "!";
    }
    attempt(code is int) is int {
        try { self.fail(code); } catch Boom.boom(found) { found; }
    }
    index(items is @int, at is int) is int { items[at]; }
}

async main() is int {
    let out = Stdout();
    let work = Work();
    let base = 1000000000000000000000;
    let big = base * base + 7;
    let bigger = big * 3;
    out.writeln((bigger > big).string() + " " + big.string());
    let words = (0..400).map()->i{ "w" + i.string(); };
    let joined = words.reduce("")->text,word{ text + word; };
    out.writeln(joined.length().string());
    let pair = [big, bigger, base];
    out.writeln(pair.size().string());
    let prices is %string:int = ["apple": 120, "pear": 140];
    out.writeln((prices["apple"] else 0).string());
    let counter = Atomic(0);
    counter.replace(counter.value() + 5);
    out.writeln(counter.value().string());
    out.writeln(work.attempt(42).string());
    out.writeln(work.guarded(3));
    out.writeln("a,b,c".split(",").size().string());
    let add = work.adder(10);
    out.writeln(add(5).string());
    let squares = (0..20000).map()->i{ Square(i); };
    out.writeln(squares.size().string());
    let steps = (0..100000).reduce(0)->sum,i{ sum + i % 3; };
    out.writeln(steps.string());
    out.writeln((await Tasks().run()).string());
    // Last: an index out of bounds traps and ends the program (exit 1).
    work.index([1, 2, 3], 9);
}
