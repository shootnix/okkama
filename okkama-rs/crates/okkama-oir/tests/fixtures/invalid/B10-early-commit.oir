func @deferred() -> void [extern "fixture.deferred"] summary(Mvoid);
scope S action in @main
func @main(%value: Res facts(managed(deps=dfull_value)), %deps: deps; %packet: own, %q: scope<S>) -> (Res, own, deps) summary(Mverify5) {
    dependency dfull_value: dependency = retention(value=%value, selection=selection(%value))
    dependency dfull_result: dependency = retention(value=%result, selection=selection(%result))
    boundary B0 lexical in S
^entry in S:
    %pending: pending = exit.prepare return %value, %packet, deps(%deps) at B0
    (%result: Res facts(managed(deps=dfull_result)), %out: own, %full: deps) = exit.commit %pending, destination caller, result Res
    ret %result, %out, %full
}
