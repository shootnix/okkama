// spec: 9.3;10.4; status: accept; expected-rule: -
module M9-accept
requires core
scope S action in @main
protocol group holders [frame, scope] rules [protocol_rule(transition=settle, from=frame, to=scope, normal=protocol_poststate(holder=scope, state=settled))] roots [frame_slots]
func @main(%cleanup: cleanup-state, %a: task-state, %b: task-state) -> cleanup-state {
^entry in S:
    %first: cleanup-state = cleanup.settle %cleanup, %b, protocol group
    %second: cleanup-state = cleanup.settle %first, %a, protocol group
    %plan: cleanup-state = cleanup.plan %second
    ret %plan
}
