oir 2 own
// spec: 6.5;A.2.M1; status: semantic-reject; expected-rule: OIR2-B5.2
module M1-object-method-is-not-observation
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=bound)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
summary Mverify3 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [] contract call_contract(results=[], failures=[thrown, program, panic, native, cancelled], publication=atomic)
summary Mverify5 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [] contract call_contract(results=[], failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @new(%label: str) -> Res [extern "fixture.new"] summary(Mnew);
func @label(%r: Res) -> str [extern "fixture.label"] summary(Mlabel);
func @destroy(%self: Res) -> void [extern "fixture.destroy", destroy Res] summary(Mverify3);
func @deferred() -> void [extern "fixture.deferred"] summary(Mvoid);
scope S action in @main
summary Mobs observation parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], publication=atomic)
func @main(%value: Res facts(managed(deps=dfull_value))) -> void summary(Mverify5) {
    dependency dfull_value: dependency = retention(value=%value, selection=selection(%value))
^entry in S:
    %text: str = call @label(%value) summary(Mobs)
    ret
}
