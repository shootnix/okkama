oir 2 low
// spec: A.2.M8; status: accept; expected-rule: -
module M8-accept
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown],
    publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
func @main(%pending: pending, %cleanup: cleanup-state) -> cleanup-state {
^entry in S:
    %shielded: cleanup-state = cleanup.shield %cleanup
    %delivered: cleanup-state = cleanup.deliver_cancel %shielded
    %aborted: cleanup-state = exit.abort %pending, %delivered
    ret %aborted
}
