oir 2 own
module cancellation
scope S action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
func @f(%future: future<int>) -> void [async] summary(M0) {
^entry in S:
    invoke.own await %future, result int
        normal ^ok($value, $deps)
        unwind ^failed($failure, $task, $receipt)
^ok(%v: int, %d: deps) in S:
    ret
^failed(%e: failure, %t: task-state, %r: receipt) in S:
    raise %e
}
