oir 2 own
// spec: 16.4; status: v2; expected-rule: -
module defer
requires core
native object Res
scope S action in @main
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown, program, panic, native, cancelled], publication=atomic)
summary M1 call-boundary contract call_contract(failures=[thrown], publication=atomic)
summary Mverify4 call-boundary parameters [] results [] contract call_contract(results=[], failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @Res.new(%name: str; %in: own) -> (Res, own) [extern "fixture.Res.new"] summary(M0);
func @risky() -> void [extern "fixture.risky"] summary(M1);
summary Mlog call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[thrown], publication=atomic)
func @log(%text: str) -> void [extern "fixture.log"] summary(Mlog);
func @main() -> void summary(Mverify4) {
    dependency dfull_r: dependency = retention(value=%r, selection=selection(%r))
    dependency dfull_r1: dependency = retention(value=%r1, selection=selection(%r1))
    dependency dfull_r2: dependency = retention(value=%r2, selection=selection(%r2))
^entry:
    %q0: scope<S> = scope.begin S
    br ^make
^make:
    invoke.own call @Res.new("r"; own.empty)
        normal ^have($value, $packet)
        unwind ^create_failed($failure)
^create_failed(%make_error: failure):
    %creation_failure: failure = scope.unwind %q0, %make_error, effects scope_effects(failures=[thrown, program, panic, native], suspends=true, cancel=false)
    raise %creation_failure
^have(%r: Res facts(managed(deps=dfull_r)), %pr: own):
    %q1: scope<S> = own.admit %q0, %pr
    br ^body(%r, %q1)
^body(%r1: Res facts(managed(deps=dfull_r1)), %q2: scope<S>) unwind ^body_failed(%r1, %q2):
    call @risky()
    br ^normal_defer(%q2)
^normal_defer(%q3: scope<S>) unwind ^defer_failed(%q3):
    call @log("d")
    br ^close(%q3)
^body_failed(%r2: Res facts(managed(deps=dfull_r2)), %q4: scope<S>, %body_error: failure):
    br ^failure_defer(%q4, %body_error)
^failure_defer(%q5: scope<S>, %f1: failure) unwind ^secondary(%q5, %f1):
    call @log("d")
    br ^unwind_close(%q5, %f1)
^secondary(%q6: scope<S>, %primary: failure, %cleanup: failure):
    %joined: failure = fail.secondary %primary, %cleanup
    br ^unwind_close(%q6, %joined)
^defer_failed(%q7: scope<S>, %f2: failure):
    br ^unwind_close(%q7, %f2)
^unwind_close(%q8: scope<S>, %f3: failure):
    %g: failure = scope.unwind %q8, %f3, effects scope_effects(failures=[thrown, program, panic, native], suspends=true, cancel=false)
    raise %g
^close(%q9: scope<S>):
    invoke.own scope.end %q9, effects scope_effects(failures=[thrown, program, panic, native], suspends=true, cancel=false)
        normal ^done($closed)
        unwind ^closed_failed($closed, $failure)
^closed_failed(%s: closed, %f4: failure):
    raise %f4
^done(%s1: closed):
    ret
}
