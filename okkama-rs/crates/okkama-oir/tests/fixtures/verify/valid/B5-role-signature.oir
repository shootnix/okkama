oir 2 high
module role_call
role Read {
    read() -> int
}
scope S action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], publication=atomic)
func @f(%receiver: Read) -> void {
^entry in S:
    %v: int = call.role %receiver, Read slot 0() summary(M0)
    ret
}
