^entry in S:
    [i0] %q: scope<S> = scope.begin S
    [i1] %admitted: scope<S> = own.accept %q, %input
    [i2] %c: cleanup-state = cleanup.begin %admitted, close 0, effects scope_effects(failures=[thrown, program, panic,
        native], suspends=true, cancel=false)
    [i3] %c1: cleanup-state = cleanup.shield %c
    [i4] %c2: cleanup-state = cleanup.settle.empty %c1, schedule 0
    [i5] %c3: cleanup-state = cleanup.plan %c2, plan 0
    br ^next(%c3)
^next(%state: cleanup-state) in S:
    cleanup.next %state selected ^destroy($state, $selected) done ^finish($state)
^destroy(%claimed: cleanup-state, %key: stable-key) in S:
    [i6] (%after: cleanup-state, %step_failure: failure-state) = cleanup.destroy %claimed, %key
    failure.dispatch %step_failure none ^next(%after) some ^record(%after, $failure)
^record(%failed: cleanup-state, %failure: failure) in S:
    [i7] %recorded: cleanup-state = cleanup.failure %failed, %failure
    br ^next(%recorded)
^finish(%remaining: cleanup-state) in S:
    [i8] (%closed: closed, %fs: failure-state, %xs: exit-state) = cleanup.finish %remaining
    exit.dispatch 0 %closed %fs %xs success ^done($closed) failure ^failed($closed, $failure)
