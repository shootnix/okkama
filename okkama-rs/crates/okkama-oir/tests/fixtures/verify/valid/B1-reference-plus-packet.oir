oir 2 own
module core
scope S action in @f
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)]  contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @f(%x: int, %p: own) -> own summary(M0) {
^entry in S:
    %n: int = int.add %x, %x
    ret %p
}
