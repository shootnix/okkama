oir 2 own
module multi_result
scope S action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
func @f(%p: own, %x: int) -> void summary(M0) {
^entry in S:
    (%r: own, %s: own, %d: deps) = own.split %p, selection(%x)
    %m: own = own.move %r
    %n: own = own.move %s
    ret
}
