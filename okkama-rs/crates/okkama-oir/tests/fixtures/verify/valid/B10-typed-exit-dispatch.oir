oir 2 low
module cleanup_empty
protocol Services kind services
scope S action in @f
summary Mf internal contract call_contract(publication=atomic)
func @f(%schedule: type) -> own summary(Mf) {
    low.metadata cleanup_metadata(closes=[cleanup_close(source=scope(S), after_defers=^entry, reserve=true,
        active_failure=false, effects=scope_effects(failures=[], suspends=false, cancel=false))],
        schedules=[cleanup_schedule(close=0, holders=[], dictionary=some(%schedule), protocol=some(Services))],
        plans=[cleanup_plan(close=0, sources=[scope_inventory, whole_reserve_on_failure], direct=none)],
        roots=[root_requirement(boundary=before_instruction(i9), bindings=[root_binding(value=%settled,
        trace=cleanup_activation)], through_suspend=false)], proofs=[])
    boundary B0 lexical in S
^entry in S:
    %q: scope<S> = scope.begin S
    %value: int = const 1
    %empty: own = own.empty
    (%left: own, %right: own, %deps: deps) = own.split %empty, selection(%value)
    %packet: own = own.join [%left, %right]
    %pending: pending = exit.prepare return %value, %packet, deps(%deps) at B0
    %c: cleanup-state = cleanup.begin %q, pending %pending, close 0, effects scope_effects(failures=[], suspends=false,
        cancel=false)
    %shield: cleanup-state = cleanup.shield %c
    %settled: cleanup-state = cleanup.settle.empty %shield, schedule 0
    [i9] %planned: cleanup-state = cleanup.plan %settled, plan 0
    (%closed: closed, %fs: failure-state, %xs: exit-state) = cleanup.finish %planned
    exit.dispatch 0 %closed %fs %xs pending ^done($closed, $pending)
^done(%done: closed, %ready: pending) in S:
    (%v: int, %out: own, %full: deps) = exit.commit %ready, destination caller, result int
    ret %out
}
