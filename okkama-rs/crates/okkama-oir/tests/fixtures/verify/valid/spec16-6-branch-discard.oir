oir 2 own
module resources
object R {
    field x: int
    destroy @destroy
}
scope Sd action in @destroy
scope S action in @f
scope SB branch in @f parent S
summary Md call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @destroy(%self: R facts(managed(deps=dd))) -> void [destroy R] summary(Md) {
    dependency dd: dependency = retention(value=%self, selection=selection(%self))
^entry in Sd:
    ret
}
scope Sc action in @create
summary Mc internal results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R], failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @create(%input: own) -> (R, own) [ctor R] summary(Mc) {
    key kc: key = created(site=0, instance=%made)
    dependency dc: dependency = key(kc)
    boundary Bc call in Sc
^entry in Sc:
    invoke.own obj.new R { x: 1; %input }
        normal ^ok($value, $packet)
        unwind ^bad($packet, $failure)
^ok(%made: R facts(managed(deps=dc)), %packet: own) in Sc:
    ret %made, %packet
^bad(%rest: own, %failure: failure) in Sc:
    %closed: closed = end %rest, boundary Bc
    raise %failure
}
summary Mmark call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
func @mark(%text: str) -> void [extern "fixture.mark"] summary(Mmark);
func @f(%choose: bool) -> void summary(M0) {
    key k0: key = created(site=0, instance=%resource)
    dependency d0: dependency = key(k0)
^entry in S:
    cond %choose, ^selected(), ^after()
^selected in SB:
    %q: scope<SB> = scope.begin SB
    invoke.own call @create(; own.empty)
        normal ^have($value, $packet, %q)
        unwind ^create_failed(%q, $failure)
^have(%resource: R facts(managed(deps=d0)), %packet: own, %state: scope<SB>) in SB:
    %admitted: scope<SB> = own.admit %state, %packet
    invoke.own scope.end %admitted
        normal ^after()
        unwind ^closed_failed($failure)
^after in S:
    // Branch cleanup is complete before the subsequent marker call (A|).
    call @mark("|")
    ret
^create_failed(%open: scope<SB>, %error: failure) in SB:
    %final: failure = scope.unwind %open, %error
    raise %final
^closed_failed(%failure: failure) in S:
    raise %failure
}
