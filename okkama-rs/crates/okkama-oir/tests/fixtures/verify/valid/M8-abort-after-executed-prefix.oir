oir 2 low
module resources

object R {
    field x: int
    destroy @destroy
}
scope S0 action in @destroy
scope S1 action in @f
scope S2 block in @f parent S1
scope S3 action in @create
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(publication=atomic)
summary M1 internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary M2 internal results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R],
    failures=[thrown, program, panic, native, cancelled], publication=atomic)
protocol P0 kind services

func @destroy(%0: R facts(managed(deps=d0))) -> void [destroy R] summary(M0) {
    low.metadata cleanup_metadata(closes=[], schedules=[], plans=[], roots=[root_requirement(boundary=terminator(^b0),
        through_suspend=true), root_requirement(boundary=entry(^b0), bindings=[root_binding(value=%0, trace=value(R))],
        through_suspend=true), ], proofs=[])
    dependency d0: dependency = retention(value=%0, selection=selection(%0))
    ^b0 in S0:
    ret
}

