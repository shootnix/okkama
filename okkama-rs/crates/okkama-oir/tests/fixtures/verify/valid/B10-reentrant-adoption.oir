summary Mf internal contract call_contract(publication=atomic)
func @destroy(%self: R facts(managed(deps=dd))) -> void [destroy R] summary(Md) {
    low.metadata cleanup_metadata(closes=[], schedules=[], plans=[],
        roots=[root_requirement(boundary=terminator(^entry), through_suspend=true),
        root_requirement(boundary=entry(^entry), bindings=[root_binding(value=%self, trace=value(R))],
        through_suspend=true), ], proofs=[])
    dependency dd: dependency = retention(value=%self, selection=selection(%self))
^entry in SD:
    ret
}
