oir 2 own
module cleanup_effects
object R {
    field x: int
    destroy @destroy
}
scope SD action in @destroy
scope S action in @f
summary Md internal parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[thrown], suspends=true, publication=atomic)
summary Mf call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[thrown], suspends=true, publication=atomic)
func @destroy(%self: R facts(managed(deps=dd))) -> void [destroy R, async] summary(Md) {
    dependency dd: dependency = retention(value=%self, selection=selection(%self))
^entry in SD:
    ret
}
func @f(%r: R facts(managed(deps=dr))) -> void summary(Mf) {
    dependency dr: dependency = retention(value=%r, selection=selection(%r))
^entry in S:
    ret
}
