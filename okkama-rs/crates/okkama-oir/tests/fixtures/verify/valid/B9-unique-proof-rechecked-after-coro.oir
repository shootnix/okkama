module unique_cache
protocol Services kind services holders [scope, group, receipt, cache] rules [protocol_rule(transition=settle,
    from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=group, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt, to=scope,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled))]
scope ST action in @task
scope S action in @f
summary Mt internal contract call_contract(publication=atomic)
func @task() -> void summary(Mt) {
^entry in ST:
    ret
}
summary Mf internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @f(%schedule: type, %success_schedule: type) -> void [async] summary(Mf) {
    key k0: key = service_of(value=%future, kind=cache)
    dependency d0: dependency = key(k0)
    service.schedule Schedule0 owner S, protocol Services, dictionary %schedule, duties [%task, %receipt, %cache]
    service.schedule Success owner S, protocol Services, dictionary %success_schedule, duties [%cache]
^entry in S:
    %q: scope<S> = scope.begin S
    %empty: own = own.empty
    (%left: own, %right: own, %deps: deps) = own.split %empty, selection(0)
    %inputs: own = own.join [%left, %right]
    %frame: frame<@task> = frame.alloc @task
    [imake] (%future: future<void> facts(managed(deps=d0)), %cache: cache-state, %owner: scope<S>) = fut.new %inputs,
        %deps, %q, environment frame(%frame), owner S
    %unique: unique-cache = unique_cache.proof proof unique_cache_proof(future=%future, scope=S, region=[^entry],
        evidence=unique_cache_evidence(creation=instruction(imake), no_external_storage=true, no_other_waiters=true,
        no_live_views=true, no_collector_retention=true, scheduler_cannot_publish=true))
    invoke.own await.take %future, %unique, boundary temporary(awaiting=S)
        normal ^ok($packet, $deps)
        unwind ^bad($failure, $task, $receipt)
^ok(%packet: own, %full: deps) in S:
    %accepted: scope<S> = own.accept %owner, %packet
    invoke.own scope.end %accepted, effects scope_effects(failures=[thrown, program, panic, native], suspends=true)
        normal ^done($closed)
        unwind ^failed($closed, $failure)
^bad(%failure0: failure, %task: task-state, %receipt: receipt) in S:
    %combined: failure = scope.unwind %owner, %failure0, effects scope_effects(failures=[thrown, program, panic,
        native], suspends=true)
    raise %combined
^done(%done: closed) in S:
    ret
^failed(%closed2: closed, %final: failure) in S:
    raise %final
}
