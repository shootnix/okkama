oir 2 own
module unwind_merge
scope S action in @f
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @f(%x: int) -> void summary(M0) {
^entry in S unwind ^handler:
    %local: int = int.add %x, %x
    %risk: int = int.mod %x, %x
    br ^merge
^handler(%f: failure) in S:
    br ^merge
^merge in S:
    %use: int = int.add %x, %x
    ret
}
