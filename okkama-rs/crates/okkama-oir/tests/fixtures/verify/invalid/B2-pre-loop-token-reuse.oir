oir 2 own
// expect OIR2-B2.1 instruction:0:0
module core
scope S action in @f
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)]  contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @f(%again: bool, %p: own) -> void summary(M0) {
    boundary B0 call in S
^entry in S:
    br ^loop
^loop in S:
    %moved: own = own.move %p
    %closed: closed = end %moved, boundary B0
    cond %again, ^loop, ^done
^done in S:
    ret
}
