module builder_overwrite_retention
object R {
    destroy @destroy
}
scope S action in @main
summary Md call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary Mn call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R], publication=atomic)
summary M0 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @destroy(%self: R) -> void [extern "fixture.destroy", destroy R] summary(Md);
func @new(%name: str; %input: own) -> (R, own, deps) [extern "fixture.new"] summary(Mn);
func @main() -> void summary(M0) {
    dependency da: dependency = retention(value=%a, selection=selection(%a))
    dependency db: dependency = retention(value=%b, selection=selection(%b))
    dependency dm: dependency = retention(value=%map, selection=selection(%map))
    boundary B0 call in S
^entry in S:
    %e0: own = own.empty
    %label: str = const "resource"
