    %e1: own = own.empty
    (%b: R facts(managed(deps=db)), %pb: own, %db: deps) = call @new(%label; %e1)
    %buffer: mbuilder<str, R> = mbuilder.new key str, value R
    %key: str = const "same-key"
    %journal: own = own.join [%pa, %pb]
    invoke.own mbuilder.put %buffer, %key, %a, packet %journal
        normal ^overwrite($buffer, $packet)
        unwind ^abandon($buffer, $packet, $failure)
^overwrite(%first: mbuilder<str, R>, %p1: own) in S:
    invoke.own mbuilder.put %first, %key, %b, packet %p1
        normal ^finish($buffer, $packet)
        unwind ^abandon($buffer, $packet, $failure)
^finish(%second: mbuilder<str, R>, %p2: own) in S:
    invoke.own mbuilder.finish %second, packet %p2
        normal ^split($value, $packet)
        unwind ^abandon($buffer, $packet, $failure)
^split(%map: map<str, R> facts(managed(deps=dm)), %p3: own) in S:
    (%probe_rest: own, %probe_selected: own, %probe_deps: deps) = own.split %p3, selection(%map)
    %probe: own = own.join [%probe_rest, %probe_selected]
    invoke.own own.split.checked %probe, selection(%map)
        normal ^close_rest($rest, $selected, $external_deps)
        unwind ^split_failed($packet, $failure)
^close_rest(%rest: own, %selected: own, %external: deps) in S:
    invoke.own end %rest, boundary B0
        normal ^use(%selected)
        unwind ^rest_failed($failure, %selected)
^use(%current: own) in S:
    %length: int = map.len %map
    %closed: closed = end %current, boundary B0
