^rest_failed(%error: failure, %remaining: own) in S:
    %closed2: closed = end %remaining, boundary B0
    raise %error
^abandon(%old_buffer: mbuilder<str, R>, %old_journal: own, %failure: failure) in S:
    %all: own = mbuilder.abandon %old_buffer, packet %old_journal
