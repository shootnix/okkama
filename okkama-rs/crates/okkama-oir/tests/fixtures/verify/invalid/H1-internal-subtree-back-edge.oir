oir 2 high
// expect OIR2-H1 scope:1
module parent_loop
scope S action in @f
scope SI iteration in @f parent S
scope SB block in @f parent SI
func @f(%c: bool) -> void {
^entry in S:
    br ^iteration
^iteration in SI:
    br ^child
^child in SB:
    cond %c, ^iteration, ^step
^step in S:
    cond %c, ^iteration, ^out
^out in S:
    ret
}
