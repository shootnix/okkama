oir 2 own
// expect OIR2-B6.3 instruction:0:1
module core
scope S action in @f
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)]  contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @f(%q0: scope<S>, %p: own, %x: int) -> void summary(M0) {
^entry in S unwind ^failed(%q0):
    %q1: scope<S> = own.admit %q0, %p
    %n: int = int.mod %x, %x
    br ^close(%q1)
^close(%q2: scope<S>) in S:
    invoke.own scope.end %q2, effects scope_effects(failures=[thrown, program, panic, native], suspends=true, cancel=false)
        normal ^done($closed)
        unwind ^closed_failed($closed, $failure)
^failed(%old: scope<S>, %failure: failure) in S:
    %final: failure = scope.unwind %old, %failure, effects scope_effects(failures=[thrown, program, panic, native], suspends=true, cancel=false)
    raise %final
^done(%c: closed) in S:
    ret
^closed_failed(%cf: closed, %f: failure) in S:
    raise %f
}
