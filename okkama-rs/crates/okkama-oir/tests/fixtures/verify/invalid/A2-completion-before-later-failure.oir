oir 2 high
// expect OIR2-A2 instruction:0:9
module constructor
object C {
    field x: int
    field $pending: bool
}
scope S action in @f
func @f(%x: int) -> C [ctor C] {
    boundary B0 lexical in S
^entry in S unwind ^failed:
    %u: int = undef ty int
    %p: bool = undef ty bool
    %o: C = obj.new C { x: %u, $pending: %p } construction incomplete
    br ^body(%o, %x)
^body(%self: C, %input: int) in S unwind ^repair(%self):
    obj.init %self, 1, field field_ref(declaration=C, index=0)
    obj.init %self, false, field field_ref(declaration=C, index=1)
    %risk: int = int.mod %input, %input
    exit.prepare return %self at B0
    ret %self
^repair(%early: C, %failure: failure) in S:
    obj.init %early, false, field field_ref(declaration=C, index=1)
    raise %failure
^failed(%e: failure) in S:
    raise %e
}
