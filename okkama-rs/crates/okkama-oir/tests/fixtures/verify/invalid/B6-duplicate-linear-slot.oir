oir 2 own
// expect OIR2-B6.2 edge:0:0
module verify
requires core
scope S action in @f
summary M0 internal contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @f(%p: own) -> void summary(M0) {
^entry in S:
    %local: int = const 1
    invoke.own own.split.checked %p, selection(%local)
        normal ^ok($rest, $rest, $external_deps, %local)
        unwind ^failed($packet, $failure, %local)
^ok(%r: own, %s: own, %d: deps, %x: int) in S:
    ret
^failed(%q: own, %e: failure, %y: int) in S:
    raise %e
}
