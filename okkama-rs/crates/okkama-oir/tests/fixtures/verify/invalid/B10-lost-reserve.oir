oir 2 own
// expect OIR2-B10.1 terminator:0:0
module core
scope S action in @f
summary M0 internal   contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @f(%q: scope<S>, %failure: failure, %pending: pending) -> failure summary(M0) {
^entry in S:
    (%f: failure, %rest: pending) = scope.unwind %q, %failure, reserve %pending
    ret %f
}
