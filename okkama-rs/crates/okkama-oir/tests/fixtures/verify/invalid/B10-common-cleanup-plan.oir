oir 2 low
// expect OIR2-B10.2 instruction:0:4
module cleanup_empty
protocol Services kind services
scope S action in @f
summary Mf internal contract call_contract(publication=atomic)
func @f(%schedule: type) -> void summary(Mf) {
    low.metadata cleanup_metadata(closes=[cleanup_close(source=scope(S), after_defers=^entry, reserve=false,
        active_failure=false, effects=scope_effects(failures=[], suspends=false, cancel=false))],
        schedules=[cleanup_schedule(close=0, holders=[], dictionary=some(%schedule), protocol=some(Services))],
        plans=[cleanup_plan(close=0, sources=[scope_inventory], direct=some(0))],
        roots=[root_requirement(boundary=before_instruction(i4), bindings=[root_binding(value=%settled,
        trace=cleanup_activation)], through_suspend=false)], proofs=[order_proof(state=%q,
        slots=[direct_slot(identity=%schedule, descriptor=%schedule, destroy=@f, origin=singleton, active_at=^entry)],
        suffixes=[suffix(completed=1, remaining=[], roots=[])], reserve_empty=true)])
^entry in S:
    %q: scope<S> = scope.begin S
    %c: cleanup-state = cleanup.begin %q, close 0, effects scope_effects(failures=[], suspends=false, cancel=false)
    %shield: cleanup-state = cleanup.shield %c
    %settled: cleanup-state = cleanup.settle.empty %shield, schedule 0
    [i4] %planned: cleanup-state = cleanup.plan %settled, plan 0
    (%closed: closed, %fs: failure-state, %xs: exit-state) = cleanup.finish %planned
    exit.dispatch 0 %closed %fs %xs success ^done($closed)
^done(%done: closed) in S:
    ret
}
