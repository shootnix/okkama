summary Mverify5 internal parameters [parameter_effect(convention=borrow, destination=none)] results [] contract call_contract(results=[], failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @new(%label: str) -> Res [extern "fixture.new"] summary(Mnew);
func @label(%r: Res) -> str [extern "fixture.label"] summary(Mlabel);
func @destroy(%self: Res) -> void [extern "fixture.destroy", destroy Res] summary(Mverify3);
func @deferred() -> void [extern "fixture.deferred"] summary(Mvoid);
scope S action in @main
func @main(%q: scope<S>, %packet: own, %value: Res facts(managed(deps=dfull_value))) -> (scope<S>, own) summary(Mverify5) {
    dependency dfull_value: dependency = retention(value=%value, selection=selection(%value))
^entry in S:
    %bound: scope<S> = own.accept %q, %packet
    (%rest: scope<S>, %offered: own, %external: deps) = scope.split %bound, selection(%value)
    invoke.own call @label(%value; %offered)
        normal ^ok($value, $packet, $deps)
        unwind ^bad($failure)
^ok(%label: str, %out: own, %deps: deps) in S:
    ret %rest, %out
^bad(%failure: failure) in S:
    raise %failure
}
