oir 2 own
// expect OIR2-B2.3 instruction:0:0
module core
scope S action in @f
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)]  contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @f(%v: any facts(managed(deps=d0)), %p: own) -> own summary(M0) {
    key k0: key = created(site=0, instance=%v)
    dependency d0: dependency = key(k0)
    selection s0: selection = value(%v)
^entry in S:
    %out: own = own.move %p facts(provenance=[provenance_fact(obligations=s0, state=unbound_result)])
    ret %out
}
