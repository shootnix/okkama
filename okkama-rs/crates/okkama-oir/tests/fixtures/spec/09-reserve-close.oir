oir 2 own
// spec: 9.1;9.2;9.3;10.4; status: v2; expected-rule: -
module 09-reserve-close
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=bound)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
summary Mverify3 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [] contract call_contract(results=[], failures=[thrown, program, panic, native, cancelled], publication=atomic)
summary Mverify5 internal parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], aliases=[parameter(0)], external_deps=[0], provenance=bound)] contract call_contract(results=[Res], failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @new(%label: str) -> Res [extern "fixture.new"] summary(Mnew);
func @label(%r: Res) -> str [extern "fixture.label"] summary(Mlabel);
func @destroy(%self: Res) -> void [extern "fixture.destroy", destroy Res] summary(Mverify3);
func @deferred() -> void [extern "fixture.deferred"] summary(Mvoid);
summary Mcleanup call-boundary results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[Res], publication=atomic)
func @cleanup_A(%input: own) -> (Res, own, deps) [extern "fixture.cleanup_A"] summary(Mcleanup);
scope S action in @main
func @main(%value: Res facts(managed(deps=dfull_value)), %deps: deps; %packet: own) -> (Res, own, deps) [async] summary(Mverify5) {
    dependency dfull_value: dependency = retention(value=%value, selection=selection(%value))
    dependency dfull_result: dependency = retention(value=%result, selection=selection(%result))
    dependency dcleanup: dependency = retention(value=%cleanup, selection=selection(%cleanup))
    boundary B0 lexical in S
^entry in S:
    %q: scope<S> = scope.begin S
    (%cleanup: Res facts(managed(deps=dcleanup)), %pa: own, %da: deps) = call @cleanup_A(; own.empty)
    %with_A: scope<S> = own.admit %q, %pa
    %accepted: scope<S> = own.accept %with_A, %packet
    invoke.own scope.split %accepted, selection(%value)
        normal ^prepare($state, $selected, $external_deps)
        unwind ^split_failed($state, $failure)
^prepare(%rest: scope<S>, %part: own, %external: deps) in S:
    %pending: pending = exit.prepare return %value, %part, deps(%deps) at B0
    invoke.own scope.end %rest, reserve %pending, effects scope_effects(failures=[thrown, program, panic, native], suspends=true, cancel=false)
        normal ^commit($closed, $pending)
        unwind ^failed($closed, $failure)
^commit(%closed: closed, %reserved: pending) in S:
    (%result: Res facts(managed(deps=dfull_result)), %out: own, %full: deps) = exit.commit %reserved, destination caller, result Res
    ret %result, %out, %full
^split_failed(%open: scope<S>, %split_error: failure) in S:
    %combined: failure = scope.unwind %open, %split_error, effects scope_effects(failures=[thrown, program, panic, native], suspends=true, cancel=false)
    raise %combined
^failed(%closed2: closed, %failure: failure) in S:
    br ^outer_failure(%failure)
^outer_failure(%error: failure) in S:
    raise %error
}
