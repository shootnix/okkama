oir 2 own
// spec: 9.1;9.2;9.3;10.4; status: v2; expected-rule: -
module 09-reserve-close
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
func @main(%value: Res, %deps: deps; %packet: own, %q: scope<S>) -> (Res, own, deps) {
    boundary B0 lexical in S
^entry in S:
    %pending: pending = exit.prepare return %value, %packet, deps(%deps) at B0
    invoke.own scope.end %q, reserve %pending
        normal ^commit($closed, $pending)
        unwind ^failed($closed, $failure, $pending)
^commit(%closed: closed, %reserved: pending) in S:
    (%result: Res, %out: own, %full: deps) = exit.commit %reserved, destination caller, result Res
    ret %result, %out, %full
^failed(%closed2: closed, %failure: failure, %remaining: pending) in S:
    br ^outer_failure(%failure, %remaining)
^outer_failure(%error: failure, %outer_reserve: pending) in S:
    raise %error
}
