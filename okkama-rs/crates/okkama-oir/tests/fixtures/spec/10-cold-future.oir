oir 2 high
// spec: 10.1; status: v2; expected-rule: -
module 10-cold-future
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
summary Mcreate call-boundary parameters [parameter_effect(convention=take, destination=result), parameter_effect(convention=take, destination=result)] contract call_contract(results=[future<str>], publication=atomic)
summary Mbody call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown, cancelled], publication=atomic)
func @read(%receiver: Res, %arg: Res) -> future<str> summary(Mcreate) async-creation(Mcreate) async-body(Mbody);
func @main() -> future<str> {
^entry in S unwind ^failed:
    %receiver: Res = call @new("R")
    %arg: Res = call @new("A")
    %fu: future<str> = call @read(%receiver, %arg)
    result.exit edge normal(0), value %fu, demand want, prepare none
    ret %fu
^failed(%failure: failure) in S:
    raise %failure
}
