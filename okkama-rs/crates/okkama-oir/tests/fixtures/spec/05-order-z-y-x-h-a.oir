oir 2 high
// spec: 5.1; status: v2; expected-rule: -
module 05-order-z-y-x-h-a
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=bound)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res [extern "fixture.new"] summary(Mnew);
func @label(%r: Res) -> str [extern "fixture.label"] summary(Mlabel);
func @destroy(%self: Res) -> void [extern "fixture.destroy", destroy Res];
func @deferred() -> void [extern "fixture.deferred"] summary(Mvoid);
scope S action in @main
summary Mholder call-boundary parameters [parameter_effect(convention=take, retention=some(parameter(0)), destination=result), parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], aliases=[parameter(0)], external_deps=[0], provenance=unbound_result)] contract call_contract(results=[Holder], failures=[thrown], publication=atomic)
func @Holder.new(%res: Res, %label: str) -> Holder [extern "fixture.Holder.new", ctor Holder] summary(Mholder);
func @main() -> void {
    binding b0 "a": Res in S
    binding b1 "b": Res in S
    binding b2 "h": Holder in S
^entry in S unwind ^failed:
    %a: Res = call @new("a")
    %h: Holder = call @Holder.new(consume %a, "h")
    bind %h, binding b2
    %x: Res = call @new("x")
    %y: Res = call @new("y")
    %rs: array<Res> = array.new [%x, %y], ty array<Res>
    %z: Res = call @new("z")
    ret
^failed(%failure: failure) in S:
    raise %failure
}
