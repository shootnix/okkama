oir 2 high
// spec: 11; status: v2; expected-rule: -
module 11-borrowed-closure
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=bound)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res [extern "fixture.new"] summary(Mnew);
func @label(%r: Res) -> str [extern "fixture.label", lambda captures 1] summary(Mlabel);
func @destroy(%self: Res) -> void [extern "fixture.destroy", destroy Res];
func @deferred() -> void [extern "fixture.deferred"] summary(Mvoid);
scope S action in @main
summary Mclosure call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=bound)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
object Stored {
    field action: fn() -> str
}
scope Sstored block in @main parent S
summary Mstored call-boundary parameters [parameter_effect(convention=take, retention=some(parameter(0)), destination=result)] results [result_relation(fresh=[0], aliases=[parameter(0)], external_deps=[0], provenance=unbound_result)] contract call_contract(results=[Stored], failures=[thrown], publication=atomic)
summary Mget call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(aliases=[parameter(0)], external_deps=[0], provenance=bound)] contract call_contract(results=[fn() -> str], failures=[thrown], publication=atomic)
func @Stored.new(%action: fn() -> str) -> Stored [extern "fixture.Stored.new", ctor Stored] summary(Mstored);
func @Stored.action(%self: Stored) -> fn() -> str [extern "fixture.Stored.action", method Stored] summary(Mget);
func @main() -> void {
    binding b0 "a": Res in S
^entry in S unwind ^failed:
    %a: Res = call @new("A")
    bind %a, binding b0
    %f: fn() -> str = fn.closure @label, [%a], ty fn() -> str
    br ^inner
^inner in Sstored unwind ^failed:
    %stored: Stored = call @Stored.new(consume %f)
    %callback: fn() -> str = call @Stored.action(%stored)
    %result: str = fn.call %callback() summary(Mclosure)
    discard %result
    result.exit edge normal(0), value %result, demand discard, prepare none
    br ^outer
^outer in S unwind ^failed:
    %alive: str = call @label(%a)
    ret
^failed(%failure: failure) in S:
    raise %failure
}
