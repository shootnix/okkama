oir 2 high
// spec: 7.2; status: v2; expected-rule: -
module 07-cell-borrow
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
native object Cell
summary Mreplace call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] results [result_relation(aliases=[parameter(0)], external_deps=[0, 1], provenance=bound)] contract call_contract(results=[Res], failures=[program], publication=atomic)
summary Mget call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(aliases=[parameter(0)], external_deps=[0], provenance=bound)] contract call_contract(results=[Res], failures=[program], publication=atomic)
func @Cell.replace(%storage: Cell, %new: Res) -> Res summary(Mreplace);
func @Cell.get(%storage: Cell) -> Res summary(Mget);
func @main(%storage: Cell, %a: Res, %b: Res) -> void {
^entry in S unwind ^failed:
    %old: Res = call @Cell.replace(%storage, %b)
    %read: Res = call @Cell.get(%storage)
    %still_alive: str = call @label(%a)
    ret
^failed(%failure: failure) in S:
    raise %failure
}
