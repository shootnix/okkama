oir 2 coro
// spec: 10.4;12; status: v2; expected-rule: -
module 12-frame-states
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
protocol frame_protocol holders [frame, scope] rules [protocol_rule(transition=cancel, from=frame, to=scope, normal=protocol_poststate(holder=scope, state=closed))] roots [frame_slots, cleanup_remainder]
func @main(%frame: frame<@main>, %packet: own, %cleanup: cleanup-state) -> void {
^entry in S:
    %saved: frame<@main> = frame.save %frame, slots [frame_slot(slot=2, value=%packet, mode=consume)], continuation 7
    (%resumed: frame<@main>, %restored: own) = frame.resume %saved, slots [saved_slot(slot=2, ty=own, linear=true)]
    %cancelled: cleanup-state = frame.cancel %resumed, %cleanup, protocol frame_protocol
    ret
}
