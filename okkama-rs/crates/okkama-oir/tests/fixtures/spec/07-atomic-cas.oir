oir 2 high
// spec: 7.2; status: v2; expected-rule: -
module 07-atomic-cas
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
native object Atomic
summary Mcas call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[bool], failures=[program], publication=atomic)
func @Atomic.cas(%storage: Atomic, %expected: Res, %revised: Res) -> bool summary(Mcas);
func @main(%storage: Atomic, %expected: Res, %revised: Res) -> bool {
^entry in S unwind ^failed:
    %success: bool = call @Atomic.cas(%storage, %expected, %revised)
    result.exit edge normal(0), value %success, demand want, prepare none
    ret %success
^failed(%failure: failure) in S:
    raise %failure
}
