^commit(%closed: closed, %reservation: pending) in S:
    (%result: Connection facts(managed(deps=dfull_result)), %out: own, %deps: deps) = exit.commit %reservation, destination caller, result Connection
    ret %result, %out, %deps
^failed(%closed2: closed, %failure: failure) in S:
