oir 2 own
// spec: 4.2;15.1; status: v2; expected-rule: -
module 04-checked-split
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
func @main(%part: Res; %input: own) -> (own, own, deps) {
    boundary B0 call in S
^entry in S:
    invoke.own own.split.checked %input, selection(%part)
        normal ^ok($rest, $selected, $external_deps)
        unwind ^bad($packet, $failure)
^ok(%rest: own, %part_packet: own, %external: deps) in S:
    ret %rest, %part_packet, %external
^bad(%original: own, %failure: failure) in S:
    invoke.own end %original, boundary B0
        normal ^failed_closed($closed, %failure)
        unwind ^failed_twice($closed, $failure, %failure)
^failed_closed(%closed: closed, %primary: failure) in S:
    raise %primary
^failed_twice(%closed2: closed, %secondary: failure, %prior: failure) in S:
    %joined: failure = fail.secondary %prior, %secondary
    raise %joined
}
