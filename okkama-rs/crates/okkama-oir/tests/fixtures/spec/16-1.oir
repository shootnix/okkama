oir 2 own
// spec: 16.1; status: v2; expected-rule: -
module resource
requires core
object File {
    field path: str
    destroy @File.destroy
}
object FileText {
    field file: File
}
scope S action in @main
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[File], failures=[thrown], publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=take, retention=some(parameter(0)), destination=result)] results [result_relation(aliases=[parameter(0)], external_deps=[0], provenance=bound)] contract call_contract(results=[FileText], failures=[thrown], publication=atomic)
summary M2 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[int], failures=[thrown], publication=atomic)
func @File.new#0(%path: str; %input: own) -> (File, own, deps) summary(M0);
func @File.text(%file: File; %input: own) -> (FileText, own, deps) summary(M1);
func @FileText.size(%text: FileText; %input: own) -> (int, own, deps) summary(M2);
func @File.destroy(%self: File) -> void;
func @main(%path: str) -> int {
^entry in S:
    %q0: scope<S> = scope.begin S
    %empty0: own = own.empty
    invoke.own call @File.new#0(%path; %empty0)
        normal ^file($value, $packet, $deps, %q0)
        unwind ^failed($failure, %q0)
^file(%file: File, %pf: own, %df: deps, %q1: scope<S>) in S:
    %q2: scope<S> = own.admit %q1, %pf
    %empty1: own = own.empty
    invoke.own call @File.text(consume %file; %empty1)
        normal ^text($value, $packet, $deps, %q2)
        unwind ^failed($failure, %q2)
^text(%text: FileText, %pt: own, %dt: deps, %q3: scope<S>) in S:
    %q4: scope<S> = own.admit %q3, %pt
    %empty2: own = own.empty
    invoke.own call @FileText.size(%text; %empty2)
        normal ^size($value, $packet, $deps, %q4)
        unwind ^failed($failure, %q4)
^size(%n: int, %pn: own, %dn: deps, %q5: scope<S>) in S:
    %q6: scope<S> = own.admit %q5, %pn
    invoke.own scope.end %q6
        normal ^done($closed, %n)
        unwind ^closed_failed($closed, $failure)
^failed(%failure: failure, %open: scope<S>) in S:
    %final: failure = scope.unwind %open, %failure
    raise %final
^closed_failed(%closed: closed, %cleanup_failure: failure) in S:
    raise %cleanup_failure
^done(%closed2: closed, %answer: int) in S:
    ret %answer
}
