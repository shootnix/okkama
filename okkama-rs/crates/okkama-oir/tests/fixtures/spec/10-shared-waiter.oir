oir 2 own
// spec: 10.4;9.3; status: v2; expected-rule: -
module 10-shared-waiter
requires core
object Res {
    field label: str
    destroy @destroy
}
object Holder {
    field res: Res
    field label: str
}
enum Stop is Error = (stop)
enum Cleanup is Error = (failed)
summary Mnew call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Res], failures=[thrown], publication=atomic)
summary Mlabel call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(results=[str], failures=[thrown], publication=atomic)
summary Mvoid call-boundary contract call_contract(failures=[thrown], publication=atomic)
func @new(%label: str) -> Res summary(Mnew);
func @label(%r: Res) -> str summary(Mlabel);
func @destroy(%self: Res) -> void;
func @deferred() -> void summary(Mvoid);
scope S action in @main
protocol group holders [frame, cache] rules [protocol_rule(transition=settle, from=frame, to=cache, normal=protocol_poststate(holder=cache, state=settled))] roots [cache, frame_slots]
func @main(%fu: future<Res>) -> void {
^entry in S:
    fut.cancel %fu
    invoke.own await %fu, result Res
        normal ^ready($value, $deps)
        unwind ^cancelled($failure, $task, $receipt)
^ready(%value: Res, %deps: deps) in S:
    ret
^cancelled(%failure: failure, %child: task-state, %receipt: receipt) in S:
    (%settled: task-state, %remainder: own, %settle_failure: failure-state) = fut.settle %child, protocol group
    raise %failure
}
