oir 2 low
// spec: 16.1; status: v2; expected-rule: -
module resource
requires core
object File {
    field path: str
    destroy @File.destroy
}
object FileText {
    field file: File
}
scope S action in @main
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
        [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[File], failures=[thrown,
        program, panic, native], publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=take, retention=some(parameter(0)),
        destination=result)] results [result_relation(aliases=[parameter(0)], external_deps=[0], provenance=bound)]
        contract call_contract(results=[FileText], failures=[thrown], publication=atomic)
summary M2 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
        [result_relation(provenance=bound)] contract call_contract(results=[int], failures=[thrown], publication=atomic)
summary Mverify4 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [] contract
        call_contract(results=[], failures=[thrown, program, panic, native], publication=atomic)
summary Mverify5 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
        [result_relation(fresh=[0], aliases=[parameter(0)], external_deps=[0], provenance=bound)] contract
        call_contract(results=[int], failures=[thrown, program, panic, native], publication=atomic)
func @File.new#0(%path: str; %input: own) -> (File, own, deps) [extern "fixture.File.new#0"] summary(M0);
func @File.text(%file: File; %input: own) -> (FileText, own, deps) [extern "fixture.File.text"] summary(M1);
func @FileText.size(%text: FileText; %input: own) -> (int, own, deps) [extern "fixture.FileText.size"] summary(M2);
func @File.destroy(%self: File) -> void [extern "fixture.File.destroy", destroy File] summary(Mverify4);
func @main(%path: str) -> int summary(Mverify5) {
    low.metadata cleanup_metadata(closes=[cleanup_close(source=scope(S), after_defers=^size, reserve=false,
        active_failure=false, effects=scope_effects(failures=[thrown, program, panic, native], suspends=false,
        cancel=false)),
        cleanup_close(source=scope(S), after_defers=^failed, reserve=false, active_failure=true,
        effects=scope_effects(failures=[thrown, program, panic, native], suspends=false, cancel=false))],
        schedules=[cleanup_schedule(close=0, holders=[]), cleanup_schedule(close=1, holders=[])],
        plans=[cleanup_plan(close=0, sources=[scope_inventory]), cleanup_plan(close=1, sources=[scope_inventory])],
        roots=[])
    binding bfile "file": File in S
    dependency dfull_file: dependency = retention(value=%file, selection=selection(%file))
    dependency dfull_text: dependency = retention(value=%text, selection=selection(%text))
^entry in S:
    %q0: scope<S> = scope.begin S
    %empty0: own = own.empty
    invoke.own call @File.new#0(%path; %empty0)
        normal ^file($value, $packet, $deps, %q0)
        unwind ^failed($failure, %q0)
^file(%file: File facts(managed(deps=dfull_file)), %pf: own, %df: deps, %q1: scope<S>) in S:
    %q2: scope<S> = own.bind binding elaborated_binding(binding=bfile, resource=resource_value(value=%file, packet=%pf),
        state=%q1, original_scope=S)
    %empty1: own = own.empty
    invoke.own call @File.text(consume %file; %empty1)
        normal ^text($value, $packet, $deps, %q2)
        unwind ^failed($failure, %q2)
^text(%text: FileText facts(managed(deps=dfull_text)), %pt: own, %dt: deps, %q3: scope<S>) in S:
    %q4: scope<S> = own.admit %q3, %pt
    %empty2: own = own.empty
    invoke.own call @FileText.size(%text; %empty2)
        normal ^size($value, $packet, $deps, %q4)
        unwind ^failed($failure, %q4)
^size(%n: int, %pn: own, %dn: deps, %q5: scope<S>) in S:
    %q6: scope<S> = own.admit %q5, %pn
    %c00: cleanup-state = cleanup.begin %q6, close 0, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=false, cancel=false)
    %c10: cleanup-state = cleanup.settle.empty %c00, schedule 0
    %c20: cleanup-state = cleanup.plan %c10, plan 0
    br ^next0(%c20)
^failed(%failure: failure, %open: scope<S>) in S:
    %c01: cleanup-state = cleanup.begin %open, failure %failure, close 1, effects scope_effects(failures=[thrown,
        program, panic, native], suspends=false, cancel=false)
    %c11: cleanup-state = cleanup.settle.empty %c01, schedule 1
    %c21: cleanup-state = cleanup.plan %c11, plan 1
    br ^next1(%c21)
^closed_failed(%closed: closed, %cleanup_failure: failure) in S:
    raise %cleanup_failure
^done(%closed2: closed, %answer: int) in S:
    ret %answer
^next0(%cn0: cleanup-state) in S:
    cleanup.next %cn0 selected ^destroy0($state, $selected) done ^finish0($state)
^destroy0(%cd0: cleanup-state, %selected0: stable-key) in S:
    (%dead0: cleanup-state, %captured0: failure-state) = cleanup.destroy %cd0, %selected0
    failure.dispatch %captured0 none ^next0(%dead0) some ^record0(%dead0, $failure)
^record0(%cr0: cleanup-state, %new_failure0: failure) in S:
    %recorded0: cleanup-state = cleanup.failure %cr0, %new_failure0
    br ^next0(%recorded0)
^finish0(%cf0: cleanup-state) in S:
    (%closed_final0: closed, %failures0: failure-state, %exit0: exit-state) = cleanup.finish %cf0
    exit.dispatch 0 %closed_final0 %failures0 %exit0 success ^done($closed, %n) failure ^closed_failed($closed,
        $failure)
^continued1(%final: failure) in S:
    raise %final
^next1(%cn1: cleanup-state) in S:
    cleanup.next %cn1 selected ^destroy1($state, $selected) done ^finish1($state)
^destroy1(%cd1: cleanup-state, %selected1: stable-key) in S:
    (%dead1: cleanup-state, %captured1: failure-state) = cleanup.destroy %cd1, %selected1
    failure.dispatch %captured1 none ^next1(%dead1) some ^record1(%dead1, $failure)
^record1(%cr1: cleanup-state, %new_failure1: failure) in S:
    %recorded1: cleanup-state = cleanup.failure %cr1, %new_failure1
    br ^next1(%recorded1)
^finish1(%cf1: cleanup-state) in S:
    (%closed_final1: closed, %failures1: failure-state, %exit1: exit-state) = cleanup.finish %cf1
    exit.dispatch 1 %closed_final1 %failures1 %exit1 failure ^continued1($failure)
}
