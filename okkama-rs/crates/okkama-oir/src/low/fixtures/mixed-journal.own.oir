oir 2 own
// S(1), J1(2), J2(3): static and rebind history use one selector; expected J2 J1 S.
module mixed_journal
object Res {
    destroy @destroy
}
summary Md internal parameters [parameter_effect(convention=borrow, destination=none)]
    contract call_contract(failures=[], publication=atomic)
func @destroy(%self: Res) -> void [extern "fixture.destroy", destroy Res] summary(Md);
summary Mn call-boundary results [result_relation(fresh=[0], provenance=unbound_result)]
    contract call_contract(results=[Res], publication=atomic)
func @new() -> (Res, own, deps) [extern "fixture.new"] summary(Mn);
scope S action in @main
scope SI iteration in @main parent S
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)]
    results [result_relation(aliases=[parameter(0)], external_deps=[0], provenance=bound)]
    contract call_contract(results=[Res], failures=[thrown, program, panic, native], publication=atomic)
func @main(%out: Res facts(managed(deps=dout)), %again: bool) -> Res [ctor Res] summary(M0) {
    binding bx "x": Res in S
    dependency dout: dependency = retention(value=%out, selection=selection(%out))
    dependency ds: dependency = retention(value=%static, selection=selection(%static))
    dependency da: dependency = retention(value=%a, selection=selection(%a))
^entry in S:
    %q0: scope<S> = scope.begin S
    %descriptor: type = type.of ty Res, descriptor descriptor_contract(managed=managed, retention=parameter(0),
        cleanup=@destroy, async_destroy=false, summary=Md)
    (%static: Res facts(managed(deps=ds)), %ps: own, %ds: deps) = call @new(; own.empty)
    %with_static: scope<S> = own.admit %q0, %ps
    %initial_packet: own = own.empty
    %initial: scope<S> = own.bind binding elaborated_binding(binding=bx,
        resource=resource_value(value=%out, packet=%initial_packet), state=%with_static, original_scope=S)
    br ^iteration(%initial)
^iteration(%current: scope<S>) in SI:
    %ea: own = own.empty
    invoke.own obj.new Res {; %ea} construction complete
        normal ^a($value, $packet, %current)
        unwind ^create_failed($packet, $failure, %current)
^a(%a: Res facts(managed(deps=da)), %pa: own, %qa: scope<S>) in SI:
    %q1: scope<S> = own.rebind binding elaborated_binding(binding=bx,
        resource=resource_value(value=%a, packet=%pa), state=%qa, original_scope=S)
    cond %again, ^iteration(%q1), ^close(%q1)
^close(%closing: scope<S>) in S:
    invoke.own scope.end %closing, effects scope_effects(failures=[thrown])
        normal ^done($closed)
        unwind ^failed($closed, $failure)
^create_failed(%rest: own, %error: failure, %open: scope<S>) in S:
    %restored: scope<S> = own.admit %open, %rest
    %combined: failure = scope.unwind %restored, %error, effects scope_effects(failures=[thrown])
    raise %combined
^done(%closed: closed) in S:
    ret %out
^failed(%closed_failed: closed, %failure: failure) in S:
    raise %failure
}
