oir 2 low
module iteration

object Res {
    destroy @destroy
}
scope S0 action in @main
scope S1 iteration in @main parent S0
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)] contract
        call_contract(failures=[thrown], publication=atomic)
summary M1 internal parameters [parameter_effect(convention=borrow, destination=none),
        parameter_effect(convention=borrow, destination=none)] results [result_relation(aliases=[parameter(0)],
        external_deps=[0], provenance=bound)] contract call_contract(results=[Res], failures=[thrown, program,
        panic, native], publication=atomic)

func @destroy(%arg0: Res) -> void [extern "fixture.destroy", destroy Res] summary(M0);

func @main(%0: Res facts(managed(deps=d0)), %1: bool) -> Res [ctor Res] summary(M1) {
    low.metadata cleanup_metadata(closes=[cleanup_close(source=scope(S1), after_defers=^b2,
        effects=scope_effects(failures=[thrown], suspends=false, cancel=false)), cleanup_close(source=scope(S1),
        after_defers=^b3, active_failure=true, effects=scope_effects(failures=[thrown], suspends=false,
        cancel=false)), ], schedules=[cleanup_schedule(close=0), cleanup_schedule(close=1), ],
        plans=[cleanup_plan(close=0, sources=[scope_inventory], direct=some(0)), cleanup_plan(close=1,
        sources=[scope_inventory]), ], roots=[], proofs=[order_proof(state=%8, slots=[direct_slot(identity=%5,
        descriptor=%3, destroy=@destroy, origin=create(site=terminator(^b1)), active_at=^b2)],
        preserves=[preserve(from=%2, to=%7), preserve(from=%7, to=%8), preserve(from=%4, to=%6), preserve(from=%6,
        to=%8)], suffixes=[suffix(completed=1)], reserve_empty=true), ])
    dependency d0: dependency = retention(value=%0, selection=selection(%0))
    dependency d1: dependency = retention(value=%5, selection=selection(%5))
    ^b0 in S0:
    br ^b1
    ^b1 in S0:
    %2: scope<S1> = scope.begin S1
    %3: type = type.of ty Res, descriptor descriptor_contract(managed=managed, retention=parameter(0),
        cleanup=@destroy, summary=M0)
    %4: own = own.empty
    invoke.own obj.new Res {; %4 }
        normal ^b2($value, $packet, %2)
        unwind ^b3($packet, $failure, %2)
    ^b2(%5: Res facts(managed(deps=d1)), %6: own, %7: scope<S1>) in S1:
    %8: scope<S1> = own.admit %7, %6
    %9: cleanup-state = cleanup.begin %8, close 0, effects scope_effects(failures=[thrown], suspends=false,
        cancel=false)
    %10: cleanup-state = cleanup.settle.empty %9, schedule 0
    %11: cleanup-state = cleanup.plan %10, plan 0
    br ^b8(%11)
    ^b3(%12: own, %13: failure, %14: scope<S1>) in S1:
    %15: scope<S1> = own.admit %14, %12
    %16: cleanup-state = cleanup.begin %15, failure %13, close 1, effects scope_effects(failures=[thrown],
        suspends=false, cancel=false)
    %17: cleanup-state = cleanup.settle.empty %16, schedule 1
    %18: cleanup-state = cleanup.plan %17, plan 1
    br ^b12(%18)
    ^b4(%19: closed) in S0:
    cond %1, ^b1, ^b5
    ^b5 in S0:
    ret %0
    ^b6(%20: closed, %21: failure) in S0:
    raise %21
    ^b7(%22: cleanup-state) in S1:
    (%23: closed, %24: failure-state, %25: exit-state) = cleanup.finish %22
    exit.dispatch 0 %23 %24 %25 success ^b4($closed) failure ^b6($closed, $failure)
    ^b8(%26: cleanup-state) in S1:
    (%27: cleanup-state, %28: failure-state) = destroy.direct %26, %5, %3, destroy @destroy
    failure.dispatch %28 none ^b10(%27) some ^b9(%27, $failure)
    ^b9(%29: cleanup-state, %30: failure) in S1:
    %31: cleanup-state = cleanup.failure %29, %30
    br ^b10(%31)
    ^b10(%32: cleanup-state) in S1:
    br ^b7(%32)
    ^b11(%33: failure) in S1:
    raise %33
    ^b12(%34: cleanup-state) in S1:
    cleanup.next %34 selected ^b13($state, $selected) done ^b15($state)
    ^b13(%35: cleanup-state, %36: stable-key) in S1:
    (%37: cleanup-state, %38: failure-state) = cleanup.destroy %35, %36
    failure.dispatch %38 none ^b12(%37) some ^b14(%37, $failure)
    ^b14(%39: cleanup-state, %40: failure) in S1:
    %41: cleanup-state = cleanup.failure %39, %40
    br ^b12(%41)
    ^b15(%42: cleanup-state) in S1:
    (%43: closed, %44: failure-state, %45: exit-state) = cleanup.finish %42
    exit.dispatch 1 %43 %44 %45 failure ^b11($failure)
}
