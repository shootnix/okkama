^entry in S:
    [i0] %q0: scope<S> = scope.begin S
    [i1] %descriptor: type = type.of ty Res, descriptor descriptor_contract(managed=managed,
        retention=parameter(0), cleanup=@destroy, async_destroy=false, summary=Md)
    [i2] %inline0: own = own.empty
    [i3] (%static: Res facts(managed(deps=ds)), %ps: own, %ds: deps) = call @new(; %inline0)
    [i4] %with_static: scope<S> = own.admit %q0, %ps
    [i5] %initial_packet: own = own.empty
    [i6] %initial: scope<S> = own.bind binding elaborated_binding(binding=bx,
        resource=resource_value(value=%out, packet=%initial_packet), state=%with_static, original_scope=S)
    br ^iteration(%initial)
^iteration(%current: scope<S>) in SI:
    [i7] %ea: own = own.empty
    invoke.own obj.new Res {; %ea} construction complete
        normal ^a($value, $packet, %current)
        unwind ^create_failed($packet, $failure, %current)
^a(%a: Res facts(managed(deps=da)), %pa: own, %qa: scope<S>) in SI:
    [i8] %q1: scope<S> = own.rebind binding elaborated_binding(binding=bx, resource=resource_value(value=%a,
        packet=%pa), state=%qa, original_scope=S)
    cond %again, ^iteration(%q1), ^close(%q1)
^close(%closing: scope<S>) in S:
    [i9] %c0: cleanup-state = cleanup.begin %closing, close 0, effects scope_effects(failures=[thrown])
    [i10] %m0_settled: cleanup-state = cleanup.settle.empty %c0, schedule 0
    [i11] %m0_planned: cleanup-state = cleanup.plan %m0_settled, plan 0
    br ^m0_next(%m0_planned)
^create_failed(%rest: own, %error: failure, %open: scope<S>) in S:
    [i12] %rq: scope<S> = own.admit %open, %rest
    [i13] %c1: cleanup-state = cleanup.begin %rq, failure %error, close 1, effects scope_effects(failures=[thrown])
    [i14] %m1_settled: cleanup-state = cleanup.settle.empty %c1, schedule 1
    [i15] %m1_planned: cleanup-state = cleanup.plan %m1_settled, plan 1
    br ^m1_next(%m1_planned)
^done(%closed: closed) in S:
    ret %out
^failed(%closed_failed: closed, %failure: failure) in S:
    raise %failure
^m0_next(%m0_state: cleanup-state) in S:
    cleanup.next %m0_state selected ^m0_destroy($state, $selected) done ^m0_finish($state)
^m0_destroy(%m0_claimed: cleanup-state, %m0_key: stable-key) in S:
    [i16] (%m0_after: cleanup-state, %m0_step: failure-state) = cleanup.destroy %m0_claimed, %m0_key
    failure.dispatch %m0_step none ^m0_next(%m0_after) some ^m0_record(%m0_after, $failure)
^m0_record(%m0_failed: cleanup-state, %m0_error: failure) in S:
    [i17] %m0_recorded: cleanup-state = cleanup.failure %m0_failed, %m0_error
    br ^m0_next(%m0_recorded)
^m0_finish(%m0_remaining: cleanup-state) in S:
    [i18] (%m0_closed: closed, %m0_fs: failure-state, %m0_xs: exit-state) = cleanup.finish %m0_remaining
    exit.dispatch 0 %m0_closed %m0_fs %m0_xs success ^done($closed) failure ^failed($closed, $failure)
^m1_continue(%combined: failure) in S:
    raise %combined
^m1_next(%m1_state: cleanup-state) in S:
    cleanup.next %m1_state selected ^m1_destroy($state, $selected) done ^m1_finish($state)
^m1_destroy(%m1_claimed: cleanup-state, %m1_key: stable-key) in S:
    [i19] (%m1_after: cleanup-state, %m1_step: failure-state) = cleanup.destroy %m1_claimed, %m1_key
    failure.dispatch %m1_step none ^m1_next(%m1_after) some ^m1_record(%m1_after, $failure)
^m1_record(%m1_failed: cleanup-state, %m1_error: failure) in S:
    [i20] %m1_recorded: cleanup-state = cleanup.failure %m1_failed, %m1_error
    br ^m1_next(%m1_recorded)
^m1_finish(%m1_remaining: cleanup-state) in S:
    [i21] (%m1_closed: closed, %m1_fs: failure-state, %m1_xs: exit-state) = cleanup.finish %m1_remaining
    exit.dispatch 1 %m1_closed %m1_fs %m1_xs failure ^m1_continue($failure)
