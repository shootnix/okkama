oir 2 own
// Independent creation events a then b: destroy b then a (Champ G1 7.3).
module iteration
object Res {
    destroy @destroy
}
summary Md internal parameters [parameter_effect(convention=borrow, destination=none)]
    contract call_contract(failures=[thrown], publication=atomic)
func @destroy(%self: Res) -> void [extern "fixture.destroy", destroy Res] summary(Md);
scope S action in @main
scope SI iteration in @main parent S
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)]
    results [result_relation(aliases=[parameter(0)], external_deps=[0], provenance=bound)]
    contract call_contract(results=[Res], failures=[thrown, program, panic, native], publication=atomic)
func @main(%out: Res facts(managed(deps=dout)), %again: bool) -> Res [ctor Res] summary(M0) {
    dependency dout: dependency = retention(value=%out, selection=selection(%out))
    dependency da: dependency = retention(value=%a, selection=selection(%a))
^entry in S:
    br ^iteration()
^iteration in S:
    %q0: scope<SI> = scope.begin SI
    %descriptor: type = type.of ty Res, descriptor descriptor_contract(managed=managed, retention=parameter(0),
        cleanup=@destroy, async_destroy=false, summary=Md)
    %ea: own = own.empty
    invoke.own obj.new Res {; %ea} construction complete
        normal ^a($value, $packet, %q0)
        unwind ^create_failed($packet, $failure, %q0)
^a(%a: Res facts(managed(deps=da)), %pa: own, %qa: scope<SI>) in SI:
    %q1: scope<SI> = own.admit %qa, %pa
    invoke.own scope.end %q1, effects scope_effects(failures=[thrown])
        normal ^next($closed)
        unwind ^failed($closed, $failure)
^create_failed(%rest: own, %error: failure, %open: scope<SI>) in SI:
    %restored: scope<SI> = own.admit %open, %rest
    %combined: failure = scope.unwind %restored, %error, effects scope_effects(failures=[thrown])
    raise %combined
^next(%closed: closed) in S:
    cond %again, ^iteration(), ^done()
^done in S:
    ret %out
^failed(%closed_failed: closed, %failure: failure) in S:
    raise %failure
}
