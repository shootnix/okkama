module async_completions v1.0.0;
import "async/collect" take FutureCompletions, NoFutures;
import "runtime/time" take sleep_nanoseconds;
import "async/event" take Event;
object Job {
    has value is int;
    has delay is string;
    has done is Event;
    Job(:value,:delay,:done);
    async run() is int {defer done.set();await sleep_nanoseconds(delay);value;}
}
object Read {
    has stream is FutureCompletions<int>;
    Read(:stream);
    async run() is int {let ready=await stream.completion();await ready;}
}
async main() is int {
    let signal=Event();
    let slow=Job(value:11,delay:"1000000",done:signal).run();
    let fast=Job(value:31,delay:"0",done:signal).run();
    let stream is FutureCompletions<int> = FutureCompletions(origins:[slow,fast,fast]);
    confirm stream.remaining_count() == 3 && !signal.ready();
    let a=await stream.completion();
    confirm a == fast && (await a) == 31;
    let b=await stream.completion();
    confirm b == fast && (await b) == 31;
    let c=await stream.completion();
    confirm c == slow && (await c) == 11;
    confirm stream.remaining_count() == 0;
    let empty=try {await stream.completion();false;} catch failure is NoFutures {true;};
    confirm empty;
    let first_done=Event();
    let last_done=Event();
    let pending is FutureCompletions<int> = FutureCompletions(origins:[Job(value:10,delay:"9223372036854775807",done:first_done).run(),Job(value:20,delay:"9223372036854775807",done:last_done).run()]);
    let first=spawn Read(stream:pending).run();
    let second=spawn Read(stream:pending).run();
    first.cancel();
    let cancelled=try {await first;false;} catch failure is Cancelled {true;};
    let aborted=try {await second;false;} catch failure is Cancelled {true;};
    confirm cancelled && aborted && first_done.ready() && last_done.ready();
    confirm pending.remaining_count() == 0;
    42;
}
