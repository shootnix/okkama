module async_channel_resources v1.0.0;
import "async/channel" take Channel, Sending;
import "async/atomic" take Atomic;
object Resource {
    has destroyed is Atomic<int>;
    Resource(:destroyed);
    value() is int {42;}
    destroy {destroyed.replace(destroyed.value()+1);}
}
object Sender {
    has output is Sending<Resource>;
    has destroyed is Atomic<int>;
    Sender(:output,:destroyed);
    async run() is int {
        let resource=Resource(destroyed:destroyed);
        await output.send(resource);
        0;
    }
}
async main() is int {
    let destroyed=Atomic(0);
    let channel is Channel<Resource> = Channel(capacity:1);
    await Sender(output:channel.sending(),destroyed:destroyed).run();
    confirm destroyed.value() == 1;
    let resource=await channel.receiving().item();
    confirm resource.value() == 42 && destroyed.value() == 1;
    42;
}
