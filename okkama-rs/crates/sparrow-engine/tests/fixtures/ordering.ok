module ordering_fixture v1.0.0;
import "compare" take Comparing, Order;
object Problem does Error {Problem();text() is string {"comparison failed";}}
object Item does Comparing<Item> {
    has key is int;
    has serial is int;
    Item(:key,:serial);
    value() is int {key;}
    identity() is int {serial;}
    order(other is Item) is Order {key.order(other.value());}
}
object Bad does Comparing<Bad> {
    Bad();
    order(other is Bad) is Order {throw Problem();}
}
main() is int {
    let original is @Item = (0..201).map() -> index {Item(key:200-index,serial:index);};
    let ordered=original.ordering();
    confirm original[0].value()==200 && ordered[0].value()==0 && ordered[200].value()==200;
    for (1..201) -> index {confirm ordered[index-1].value()<ordered[index].value();}
    let stable=[Item(key:2,serial:0),Item(key:1,serial:1),Item(key:2,serial:2),Item(key:1,serial:3)].ordering();
    confirm stable[0].identity()==1 && stable[1].identity()==3 && stable[2].identity()==0 && stable[3].identity()==2;
    let failed=try {[Bad(),Bad()].ordering();false;} catch failure is Problem {true;};
    confirm failed;
    let numbers=[3,-1,3,0,9223372036854775808].ordering();
    confirm numbers==[-1,0,3,3,9223372036854775808];
    let empty is @Item = [];
    confirm empty.ordering().size()==0;
    confirm [Item(key:7,serial:9)].ordering()[0].identity()==9;
    42;
}
