module main v1.0.0;
import "runtime/network" as network;
import "async/scope" take FutureGroup;
async main() is int {
    let cancelled = network.dns_addresses("must-not-resolve.invalid", 42);
    cancelled.cancel();
    confirm cancelled.cancelled() else panic "unstarted resolution did not cancel";
    let first = network.dns_addresses("127.0.0.1", 4242);
    let group is FutureGroup<@@string> = FutureGroup();
    group.start(first);
    let values = await first;
    let cached = await first;
    confirm values.size() == 1 && cached[0][0] == "127.0.0.1" && values[0][1] == "4242" && values[0][2] == "" else panic "bad resolver answer";
    await group.wait();
    let invalid = try { await network.dns_addresses("bad name", 0); false; }
        catch e is NativeFailure { e.domain() == "core.net" && e.code() == "invalid_input"; };
    confirm invalid else panic "invalid name escaped native failure";
    let reverse = try { await network.dns_name("not-an-ip"); false; }
        catch e is NativeFailure { e.code() == "invalid_input"; };
    confirm reverse else panic "invalid reverse lookup";
    42;
}
