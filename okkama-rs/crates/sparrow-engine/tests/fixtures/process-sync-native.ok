module main v1.0.0;
import "os/process" take Process;
import "os/command" take Command;
import "os/environment" take Environment;
import "fs/path" take Path;
import "fs/directory" take Directory;
main() is int {
    let process = Process(command: Command(program: Path("/bin/sleep"), arguments: ["60"], environment: Environment(), directory: Directory(path: Path("."))));
    confirm process.id() > 0 else panic "missing process ID";
    process.close();
    process.close();
    42;
}
