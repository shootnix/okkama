module async_spawn_shutdown v1.0.0;
import "runtime/time" take sleep_nanoseconds;
object CleanupFailure does Error {
    CleanupFailure();
    text() is string { "cleanup"; }
}
object Resource {
    Resource();
    destroy { throw CleanupFailure(); }
}
object Job {
    Job();
    async run() is int {
        let resource = Resource();
        await sleep_nanoseconds("9223372036854775807");
        0;
    }
}
async main() is int {
    spawn Job().run();
    42;
}
