module async_group_failures v1.0.0;
import "async/scope" take FutureGroup;
object Problem does Error {
    has label is string;
    Problem(:label);
    text() is string { label; }
}
object Work {
    has label is string;
    Work(:label);
    async run() is int { throw Problem(label: label); }
}
async main() is int {
    let group is FutureGroup<int> = FutureGroup();
    group.start(Work(label: "first").run());
    group.start(Work(label: "second").run());
    await group.wait();
    42;
}
