module main v1.0.0;
import "net/unix" take UnixPaired;
import "io/decorators" take ByteSnapshot;
async main() is int {
    let pair=await UnixPaired().result();
    let left=pair.first();let right=pair.second();
    defer left.close();defer right.close();
    await left.output().write(ByteSnapshot([0.byte(),255.byte(),42.byte()]));
    confirm (await right.input().bytes(3))==[0.byte(),255.byte(),42.byte()] else panic "Unix payload changed";
    left.close();
    confirm (await right.input().bytes(1)).size()==0 else panic "Unix EOF missing";
    42;
}
