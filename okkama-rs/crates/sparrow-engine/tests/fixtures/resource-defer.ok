module resource_defer v1.0.0;
object Failure does Error {
    has code is int;
    Failure(:code);
    text() is string { "failure"; }
    value() is int { code; }
}
object Resource {
    Resource();
    destroy { throw Failure(code: 3); }
}
object Action {
    Action();
    fail() is void { throw Failure(code: 42); }
}
main() is int {
    let answer = try {
        let resource = Resource();
        defer Action().fail();
        0;
    } catch failure is Failure { failure.value(); };
    answer;
}
