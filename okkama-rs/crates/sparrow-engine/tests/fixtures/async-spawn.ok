module async_spawn v1.0.0;
import "runtime/time" take sleep_nanoseconds;
object Job {
    Job();
    async value() is string {
        await sleep_nanoseconds("1000000");
        "done";
    }
}
object Reader {
    has pending is Future<string>;
    Reader(:pending);
    async value() is int {
        let first = await pending;
        let second = await pending;
        if first == "done" && second == "done" { 21; } else { 0; };
    }
}
async main() is int {
    let pending = spawn Job().value();
    let left = spawn Reader(pending: pending).value();
    let right = spawn Reader(pending: pending).value();
    (await left) + (await right);
}
