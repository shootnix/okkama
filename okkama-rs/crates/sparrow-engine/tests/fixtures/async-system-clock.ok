module async_system_clock v1.0.0;
import "async/timeout" take Within, Before, TimedOut;
import "time/duration" take Duration, DurationUnit;
import "time/clock" take SystemClock;
import "runtime/time" take sleep_nanoseconds, clock_domain;
import "async/event" take Event;
object Work {
    has done is Event;
    Work(:done);
    async run() is int {defer done.set();await sleep_nanoseconds("9223372036854775807");42;}
}
async main() is int {
    let clock=SystemClock();
    let start=clock.monotonic_instant();
    let delay=Duration(value:1.rat(),unit:DurationUnit.millisecond);
    await clock.wait(delay);
    confirm clock.monotonic_instant().minus(start).seconds() >= delay.seconds();
    confirm clock.instant().unix_duration().seconds() > 0.rat();
    confirm clock_domain(false) == clock_domain(false);
    let refused=try {clock_domain(true);false;} catch failure is NativeFailure {failure.code() == "permission_denied";};
    confirm refused;
    let done=Event();
    let task=Work(done:done).run();
    let bounded is Within<int> = Within(origin:task,limit:delay,clock:clock);
    let expired=try {await bounded.result();false;} catch failure is TimedOut {true;};
    confirm expired && task.cancelled() && done.ready();
    let cleanup=Event();
    let future=Work(done:cleanup).run();
    let before is Before<int> = Before(origin:future,deadline:clock.monotonic_instant().plus(delay),clock:clock);
    let elapsed=try {await before.result();false;} catch failure is TimedOut {true;};
    confirm elapsed && future.cancelled() && cleanup.ready();
    42;
}
