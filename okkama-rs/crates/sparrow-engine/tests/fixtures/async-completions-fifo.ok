module async_completions_fifo v1.0.0;
import "async/collect" take FutureCompletions, NoFutures;
import "async/channel" take Channel, Receiving;
object Source {
    has input is Receiving<int>;
    Source(:input);
    async run() is int {await input.item();}
}
object Read {
    has stream is FutureCompletions<int>;
    Read(:stream);
    async run() is int {let ready=await stream.completion();await ready;}
}
async main() is int {
    let channel is Channel<int> = Channel(capacity:0);
    let input=channel.receiving();
    let output=channel.sending();
    let a=Source(input:input).run();
    let b=Source(input:input).run();
    let stream is FutureCompletions<int> = FutureCompletions(origins:[a,b]);
    let first=spawn Read(stream:stream).run();
    let second=spawn Read(stream:stream).run();
    let excess=try {await stream.completion();false;} catch failure is NoFutures {true;};
    confirm excess && !a.cancelled() && !b.cancelled();
    await output.send(1);
    confirm (await a) == 1;
    confirm stream.remaining_count() == 1;
    await output.send(41);
    confirm (await first) == 1;
    confirm (await second) == 41;
    confirm stream.remaining_count() == 0;
    42;
}
