module async_cancellation_token v1.0.0;
import "async/cancellation" take Cancellation, Cancelling;
object Reader {
    has token is Cancelling;
    Reader(:token);
    async run() is int { await token.wait(); 21; }
}
async main() is int {
    let cancellation = Cancellation();
    let token = cancellation.cancelling();
    token.check();
    let abandoned = spawn Reader(token: token).run();
    let active = spawn Reader(token: cancellation.cancelling()).run();
    abandoned.cancel();
    let initially_clear = !token.requested();
    cancellation.cancel();
    cancellation.cancel();
    let checked = try { token.check(); 0; } catch failure is Cancelled { 21; };
    let cancelled = try { await abandoned; false; } catch failure is Cancelled { true; };
    let result = await active;
    await token.wait();
    if initially_clear && cancelled && token.requested() { checked + result; } else { 0; };
}
