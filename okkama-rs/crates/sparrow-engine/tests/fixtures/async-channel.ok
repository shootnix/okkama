module async_channel v1.0.0;
import "async/channel" take Channel, Sending, Receiving, ChannelClosed;

object Sender {
    has output is Sending<int>;
    has value is int;
    Sender(:output, :value);
    async run() is int { await output.send(value); value; }
}
object Receiver {
    has input is Receiving<int>;
    Receiver(:input);
    async run() is int { await input.item(); }
}
async main() is int {
    let channel is Channel<int> = Channel(capacity: 1);
    let output = channel.sending();
    let input = channel.receiving();
    await output.send(10);
    let first = spawn Sender(output: output, value: 20).run();
    let cancelled = spawn Sender(output: output, value: 99).run();
    let second = spawn Sender(output: output, value: 30).run();
    confirm !first.done() && !second.done();
    cancelled.cancel();
    let removed = try { await cancelled; false; } catch failure is Cancelled { true; };
    confirm removed;
    confirm (await input.item()) == 10;
    confirm (await input.item()) == 20;
    confirm (await input.item()) == 30;
    confirm (await first) == 20;
    confirm (await second) == 30;
    let a = spawn Receiver(input: input).run();
    let dropped = spawn Receiver(input: input).run();
    let b = spawn Receiver(input: input).run();
    dropped.cancel();
    await output.send(11);
    await output.send(31);
    confirm (await a) == 11;
    confirm (await b) == 31;
    let gone = try { await dropped; false; } catch failure is Cancelled { true; };
    confirm gone;
    let blocked = spawn Receiver(input: input).run();
    output.close();
    output.close();
    let closed = try { await blocked; false; } catch failure is ChannelClosed { true; };
    confirm closed;
    let rendezvous is Channel<int> = Channel(capacity: 0);
    let send = spawn Sender(output: rendezvous.sending(), value: 42).run();
    confirm !send.done();
    confirm (await rendezvous.receiving().item()) == 42;
    await send;
}
