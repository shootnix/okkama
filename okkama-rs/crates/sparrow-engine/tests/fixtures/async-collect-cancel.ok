module async_collect_cancel v1.0.0;
import "async/collect" take AllFutures;
import "async/event" take Event;
import "runtime/time" take sleep_nanoseconds;
object Job {
    has started is Event;
    has done is Event;
    Job(:started,:done);
    async run() is int {
        defer done.set();
        started.set();
        await sleep_nanoseconds("9223372036854775807");
        0;
    }
}
object Waiting {
    has all is AllFutures<int>;
    Waiting(:all);
    async run() is int { await all.results(); 0; }
}
async main() is int {
    let first = Event();
    let second = Event();
    let a = Event();
    let b = Event();
    let all is AllFutures<int> = AllFutures(origins: [Job(started: first,done:a).run(),Job(started:second,done:b).run()]);
    let pending = spawn Waiting(all:all).run();
    confirm first.ready() && second.ready();
    pending.cancel();
    let cancelled = try {await pending;false;} catch failure is Cancelled {true;};
    confirm cancelled && a.ready() && b.ready();
    42;
}
