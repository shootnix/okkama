module async_group v1.0.0;
import "async/scope" take FutureGroup, FinishedFutureGroup;
import "async/event" take Event;
object Work {
    has begin is Event;
    has gate is Event;
    has done is Event;
    Work(:begin, :gate, :done);
    async run() is int {
        begin.set();
        defer done.set();
        await gate.wait();
        21;
    }
}
object Waiting {
    has group is FutureGroup<int>;
    Waiting(:group);
    async run() is int { await group.wait(); 42; }
}
async main() is int {
    let group is FutureGroup<int> = FutureGroup();
    let begin = Event();
    let gate = Event();
    let done = Event();
    let pending = Work(begin: begin, gate: gate, done: done).run();
    group.start(pending);
    group.start(pending);
    confirm begin.ready() && !done.ready() && group.active() == 1;
    group.cancel();
    group.cancel();
    await group.wait();
    await group.wait();
    confirm done.ready() && group.active() == 0;
    group.start(pending);
    let sealed = try { group.start(Work(begin: begin, gate: gate, done: done).run()); false; }
        catch failure is FinishedFutureGroup { true; };
    confirm sealed;
    let second is FutureGroup<int> = FutureGroup();
    let final = Event();
    second.start(Work(begin: begin, gate: gate, done: final).run());
    let waiter = spawn Waiting(group: second).run();
    waiter.cancel();
    let cancelled = try { await waiter; false; } catch failure is Cancelled { true; };
    confirm cancelled && final.ready() && second.active() == 0;
    42;
}
