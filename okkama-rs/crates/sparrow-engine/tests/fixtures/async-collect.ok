module async_collect v1.0.0;
import "async/collect" take AllFutures, Raced, FirstSuccessful, NoFutures;
import "runtime/time" take sleep_nanoseconds;
import "async/event" take Event;
object Job {
    has value is int;
    has delay is string;
    has done is Event;
    Job(:value, :delay, :done);
    async run() is int {
        defer done.set();
        await sleep_nanoseconds(delay);
        value;
    }
}
object Problem does Error {
    Problem();
    text() is string { "attempt failed"; }
}
object Broken {
    Broken();
    async run() is int { throw Problem(); }
}
async main() is int {
    let done = Event();
    let first = Job(value: 11, delay: "1000000", done: done).run();
    let second = Job(value: 31, delay: "0", done: done).run();
    let all is AllFutures<int> = AllFutures(origins: [first, second, first]);
    let f = all.results();
    confirm f == all.results();
    let values = await f;
    confirm values.size() == 3 && values.item(0) == 11 && values.item(1) == 31 && values.item(2) == 11;
    confirm (await all.results()).item(0) == 11;
    let empty is AllFutures<int> = AllFutures(origins: []);
    confirm (await empty.results()).size() == 0;
    let cleaned = Event();
    let slow = Job(value: 99, delay: "9223372036854775807", done: cleaned).run();
    let fast = Job(value: 42, delay: "1000000", done: done).run();
    let race is Raced<int> = Raced(origins: [slow, fast]);
    confirm race.result() == race.result();
    confirm (await race.result()) == 42 && cleaned.ready() && slow.cancelled();
    let success is FirstSuccessful<int> = FirstSuccessful(origins: [Broken().run(), Job(value: 42, delay: "1000000", done: done).run()]);
    confirm (await success.result()) == 42;
    let rejected is Raced<int> = Raced(origins: [Broken().run(), Job(value: 99, delay: "1000000", done: done).run()]);
    let failed = try { await rejected.result(); false; } catch failure is Problem { true; };
    confirm failed;
    42;
}
