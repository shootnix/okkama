module async_native_error_role v1.0.0;
import "runtime/time" take sleep_nanoseconds;
async main() is int {
    let result = try { await sleep_nanoseconds("01"); 0; }
    catch failure is Error {
        if failure.text() == "Wait duration must be a canonical non-negative integer" { 42; } else { 0; };
    };
    result;
}
