module async_cached v1.0.0;
object Job {
    has result is int;
    Job(:result);
    async run() is int { result; }
}
object Dormant {
    Dormant();
    async run() is int { panic "cold body must not run"; }
}
async main() is int {
    let unused = Dormant().run();
    let pending = Job(result: 21).run();
    let first = await pending;
    let second = await pending;
    first + second;
}
