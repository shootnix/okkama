module async_timeout v1.0.0;
import "async/timeout" take Within, Before, TimedOut;
import "time/duration" take Duration, DurationUnit;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "async/event" take Event;
import "async/atomic" take Atomic;
import "runtime/time" take sleep_nanoseconds;
object Clock does Timing {
    has calls is Atomic<int>;
    has done is Event;
    has delay is string;
    Clock(:calls,:done,:delay);
    instant() is Instant {Instant(origin:Duration(value:0.rat(),unit:DurationUnit.second));}
    monotonic_instant() is MonotonicInstant {MonotonicInstant(origin:Duration(value:10.rat(),unit:DurationUnit.second));}
    async wait(duration is Duration) is void {
        calls.replace(calls.value()+1);
        defer done.set();
        await sleep_nanoseconds(delay);
    }
}
object Problem does Error {Problem();text() is string {"clock failed";}}
object BrokenClock does Timing {
    BrokenClock();
    instant() is Instant {throw Problem();}
    monotonic_instant() is MonotonicInstant {throw Problem();}
    async wait(duration is Duration) is void {throw Problem();}
}
object Waiting {
    has origin is Within<int>;
    Waiting(:origin);
    async run() is int {await origin.result();}
}
object Work {
    has done is Event;
    has delay is string;
    Work(:done,:delay);
    async run() is int {defer done.set();await sleep_nanoseconds(delay);42;}
}
async main() is int {
    let calls=Atomic(0);
    let clockDone=Event();
    let clock=Clock(calls:calls,done:clockDone,delay:"9223372036854775807");
    let zero=Duration(value:0.rat(),unit:DurationUnit.second);
    let positive=Duration(value:1.rat(),unit:DurationUnit.second);
    let done=Event();
    let ready is Within<int> = Within(origin:Work(done:done,delay:"0").run(),limit:zero,clock:clock);
    confirm ready.result() == ready.result();
    confirm (await ready.result()) == 42 && calls.value() == 0;
    let cancelled=Event();
    let slow=Work(done:cancelled,delay:"9223372036854775807").run();
    let expired is Within<int> = Within(origin:slow,limit:zero,clock:clock);
    let timeout=try {await expired.result();false;} catch failure is TimedOut {true;};
    confirm timeout && cancelled.ready() && slow.cancelled() && calls.value() == 0;
    let win is Within<int> = Within(origin:Work(done:done,delay:"1000000").run(),limit:positive,clock:clock);
    confirm (await win.result()) == 42 && calls.value() == 1 && clockDone.ready();
    let timerDone=Event();
    let instantClock=Clock(calls:calls,done:timerDone,delay:"0");
    let timedChild=Work(done:Event(),delay:"9223372036854775807").run();
    let deadline=MonotonicInstant(origin:Duration(value:11.rat(),unit:DurationUnit.second));
    let before is Before<int> = Before(origin:timedChild,deadline:deadline,clock:instantClock);
    let elapsed=try {await before.result();false;} catch failure is TimedOut {true;};
    confirm elapsed && timedChild.cancelled() && timerDone.ready();
    let failedChild=Work(done:Event(),delay:"9223372036854775807").run();
    let broken is Within<int> = Within(origin:failedChild,limit:positive,clock:BrokenClock());
    let failed=try {await broken.result();false;} catch failure is Problem {true;};
    confirm failed && failedChild.cancelled();
    let setupChild=Work(done:Event(),delay:"9223372036854775807").run();
    let setup is Before<int> = Before(origin:setupChild,deadline:deadline,clock:BrokenClock());
    let rejected=try {await setup.result();false;} catch failure is Problem {true;};
    confirm rejected && setupChild.cancelled();
    let cleanup=Event();
    let timerCleanup=Event();
    let hangingClock=Clock(calls:calls,done:timerCleanup,delay:"9223372036854775807");
    let child=Work(done:cleanup,delay:"9223372036854775807").run();
    let bounded is Within<int> = Within(origin:child,limit:positive,clock:hangingClock);
    let parent=spawn Waiting(origin:bounded).run();
    parent.cancel();
    let stopped=try {await parent;false;} catch failure is Cancelled {true;};
    confirm stopped && child.cancelled() && cleanup.ready() && timerCleanup.ready();
    42;
}
