module main v1.0.0;
import "runtime/network" as net;
import "runtime/network" take SocketState;
import "runtime/net" take ip_parse;
import "runtime/number_text" take int_parse;
import "async/scope" take FutureGroup;
async main() is int {
    let listener=net.tcp_bound(ip_parse(1,"127.0.0.1",0),"",false,false);
    net.tcp_start_listening(listener,32);
    let endpoint=net.tcp_listener_endpoint(listener);
    let group is FutureGroup<SocketState>=FutureGroup();
    let pending=net.tcp_accept(listener,false,true);group.start(pending);
    let client=await net.tcp_connect(ip_parse(1,endpoint[0],int_parse(endpoint[1],10)),"",false,true);
    let server=await pending;await group.wait();
    let cancelled=net.stream_read(server,3);cancelled.cancel();
    confirm cancelled.cancelled() && !net.closed(server) else panic "read cancellation closed stream";
    let read=net.stream_read(server,3);
    let duplicate=try {await net.stream_read(server,1);false;} catch e is NativeFailure {e.code()=="resource_exhausted";};
    confirm duplicate else panic "duplicate reader accepted";
    await net.stream_write(client,[0.byte(),128.byte(),255.byte()]);
    confirm (await read)==[0.byte(),128.byte(),255.byte()] else panic "payload changed";
    net.stream_shutdown(client,true);
    confirm (await net.stream_read(server,1)).size()==0 else panic "EOF missing";
    let awaiting=net.stream_read(client,1);net.close(client);
    let closed=try {await awaiting;false;} catch e is NativeFailure {e.code()=="already_closed";};
    confirm closed else panic "close failed to wake reader";
    net.close(client);net.close(server);net.tcp_listener_close(listener);
    confirm net.tcp_listener_closed(listener) else panic "listener remained open";
    42;
}
