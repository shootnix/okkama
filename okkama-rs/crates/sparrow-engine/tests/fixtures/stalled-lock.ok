module stalled_lock v1.0.0;
import "async/lock" take Lock;
import "async/event" take Event;
async main() is int {
    let cleaned=Event();
    defer cleaned.set();
    let lock=Lock();
    let held=await lock.guard();
    defer held.close();
    let another=await lock.guard();
    another.close();
    42;
}
