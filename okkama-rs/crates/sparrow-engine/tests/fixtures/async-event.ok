module async_event v1.0.0;
import "async/event" take Event;
object Reader {
    has event is Event;
    Reader(:event);
    async run() is int { await event.wait(); 21; }
}
async main() is int {
    let event = Event();
    let cancelled = spawn Reader(event: event).run();
    let active = spawn Reader(event: event).run();
    cancelled.cancel();
    event.set();
    event.set();
    let first = try { await cancelled; 0; } catch failure is Cancelled { 21; };
    let second = await active;
    await event.wait();
    await Event(ready: true).wait();
    if event.ready() { first + second; } else { 0; };
}
