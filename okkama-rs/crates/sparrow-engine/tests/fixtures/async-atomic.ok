module async_atomic v1.0.0;
import "async/atomic" take Atomic, AtomicClosed;
main() is int {
    let cell = Atomic("one");
    let original = cell.value();
    cell.replace("two");
    let mismatch = cell.compare_and_replace("one", "wrong");
    let matched = cell.compare_and_replace("two", "three");
    let published = cell.value();
    cell.close();
    cell.close();
    let failed_read = try { cell.value(); false; } catch failure is AtomicClosed { true; };
    let failed_write = try { cell.replace("four"); false; } catch failure is AtomicClosed { true; };
    let failed_cas = try { cell.compare_and_replace("three", "four"); false; } catch failure is AtomicClosed { true; };
    if original == "one" && published == "three" && !mismatch && matched && cell.closed() && failed_read && failed_write && failed_cas { 42; } else { 0; };
}
