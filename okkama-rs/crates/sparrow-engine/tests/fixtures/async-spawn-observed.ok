module async_spawn_observed v1.0.0;
object Problem does Error {
    Problem();
    text() is string { "problem"; }
}
object Job {
    Job();
    async run() is int { throw Problem(); }
}
async main() is int {
    let pending = spawn Job().run();
    let first = try { await pending; } catch failure is Problem { 21; };
    let second = try { await pending; } catch failure is Problem { 21; };
    first + second;
}
