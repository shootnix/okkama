module main v1.0.0;
import "runtime/network" as net;
import "runtime/net" take ip_parse;
import "runtime/number_text" take int_parse;
async main() is int {
    let sender=net.udp_bound(ip_parse(1,"127.0.0.1",0),"",false,false,false);
    let receiver=net.udp_bound(ip_parse(1,"127.0.0.1",0),"",false,false,false);
    let endpoint=net.local_endpoint(receiver);
    let target=ip_parse(1,endpoint[0],int_parse(endpoint[1],10));
    let cancelled=net.udp_receive(receiver,1);cancelled.cancel();
    confirm !net.closed(receiver) else panic "receive cancellation closed UDP";
    let pending=net.udp_receive(receiver,2);
    confirm (await net.udp_send(sender,target,"",[0.byte(),255.byte(),42.byte()]))==3 else panic "partial packet";
    let packet=await pending;
    confirm net.packet_truncated(packet) && net.packet_bytes(packet)==[0.byte(),255.byte()] else panic "UDP truncation changed";
    confirm net.packet_source(packet)[1]==net.local_endpoint(sender)[1] else panic "source changed";
    await net.udp_connect(sender,target,"");
    let empty is @byte=[];
    await net.udp_connected_send(sender,empty);
    let zero=await net.udp_receive(receiver,1);
    confirm !net.packet_truncated(zero) && net.packet_bytes(zero).size()==0 else panic "empty packet lost";
    let closing=net.udp_receive(receiver,1);net.close(receiver);
    let closed=try {await closing;false;} catch e is NativeFailure {e.code()=="already_closed";};
    confirm closed else panic "UDP close did not wake receiver";
    net.close(sender);42;
}
