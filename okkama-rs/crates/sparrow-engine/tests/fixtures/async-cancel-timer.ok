module async_cancel_timer v1.0.0;
import "runtime/time" take sleep_nanoseconds;
async main() is int {
    let pending = sleep_nanoseconds("9223372036854775807");
    pending.cancel();
    let answer = try { await pending; 0; } catch failure is Error {
        confirm failure.text() == "Operation was cancelled" else panic "cancel text";
        42;
    };
    confirm pending.done() && pending.cancelled() else panic "cancel status";
    answer;
}
