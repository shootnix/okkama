module async_spawn_eager v1.0.0;
object Walk {
    Walk();
    async descend(depth is int) is int {
        if depth == 0 { 42; } else { await self.descend(depth - 1); };
    }
}
async main() is int {
    let pending = spawn Walk().descend(200);
    if pending.done() { await pending; } else { 0; };
}
