module async_native_rethrow v1.0.0;
import "runtime/time" take sleep_nanoseconds;
object Relay {
    has error is Error;
    Relay(:error);
    fail() is int { throw error; }
}
async main() is int {
    let result = try {
        let inner = try { await sleep_nanoseconds("01"); 0; }
        catch failure is NativeFailure { Relay(error: failure).fail(); };
        inner;
    } catch failure is NativeFailure {
        if failure.code() == "invalid_input" { 42; } else { 0; };
    };
    result;
}
