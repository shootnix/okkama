module main v1.0.0;
import "os/command" take Command;
import "os/command_capture" take CommandCapture;
import "os/pipeline_capture" take PipelineCapture;
import "os/environment" take Environment;
import "fs/path" take Path;
import "fs/directory" take Directory;
import "encoding/utf" take Utf8Decoded;
async main() is int {
    let env=Environment();let directory=Directory(path:Path("."));
    let first=Command(program:Path("printf"),arguments:["%s|%s","a b","c;d"],environment:env,directory:directory);
    let capture=await CommandCapture(origin:first,limit:4096).completion();
    confirm capture.exit().success() else panic "command failed";
    confirm Utf8Decoded(origin:capture.output()).string()=="a b|c;d" else panic "arguments changed";
    let second=Command(program:Path("tr"),arguments:["a-z","A-Z"],environment:env,directory:directory);
    let pipeline=await PipelineCapture(commands:[first,second],limit:4096).completion();
    confirm Utf8Decoded(origin:pipeline.output()).string()=="A B|C;D" else panic "pipeline changed bytes";
    confirm pipeline.exits().size()==2 else panic "pipeline status count";
    confirm pipeline.errors().size()==2 else panic "pipeline stderr count";
    confirm pipeline.exits()[0].success() && pipeline.exits()[1].success() else panic "pipeline failed";
    42;
}
