module async_error_text_spawn v1.0.0;
import "async/event" take Event;
import "runtime/time" take sleep_nanoseconds;
object Background {
    has done is Event;
    Background(:done);
    async run() is int {
        defer done.set();
        await sleep_nanoseconds("9223372036854775807");
        0;
    }
}
object Problem does Error {
    has done is Event;
    Problem(:done);
    text() is string {
        spawn Background(done:done).run();
        "background failure";
    }
}
object Failing {
    has done is Event;
    Failing(:done);
    async run() is int {throw Problem(done:done);}
}
async main() is int {spawn Failing(done:Event()).run();42;}
