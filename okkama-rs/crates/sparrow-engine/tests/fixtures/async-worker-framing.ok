module async_worker_framing v1.0.0;
object Calculator {
    has seed is int;
    Calculator(:seed);
    calculate(input is int) is int {seed * input;}
    array(values is @int) is @int {values.map() -> value {value+seed;};}
    text(value is string) is string {value;}
}
async main() is int {
    let action is (int) is int =Calculator(seed:7).calculate;
    let bound=spawn action(6);
    let values=spawn Calculator(seed:2).array(values:[1,2,3]);
    let text=spawn Calculator(seed:0).text(value:"OKW1 fake frame OKL1 🦀");
    confirm (await bound) == 42;
    confirm (await bound) == 42;
    confirm (await values)[2] == 5;
    confirm (await text) == "OKW1 fake frame OKL1 🦀";
    42;
}
