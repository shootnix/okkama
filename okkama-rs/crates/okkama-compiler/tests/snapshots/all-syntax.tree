Program
  module: ModuleDecl
    path: [syntax, tour]
    version: v1.2.3
  imports:
    - ImportDecl
      path: "io/stdout"
      alias: (none)
      take: [Stdout]
    - ImportDecl
      path: "async/channel"
      alias: channels
      take: [Channel, Sending]
    - ImportDecl
      path: "runtime/time"
      alias: (none)
      take: []
  items:
    - EnumDecl
      name: Color
      cases: [red, green, blue]
    - EnumDecl
      name: Nothing
      cases: []
    - NativeActionDecl
      async: true
      name: sleep_ms
      params:
        - Param
          name: duration
          variadic: false
          type: NamedType
            path: [int]
            args: []
      result: VoidResult
    - NativeActionDecl
      async: false
      name: clock_ticks
      params: []
      result: NamedType
        path: [int]
        args: []
    - NativeObjectDecl
      name: Handle
    - RoleDecl
      name: Comparing
      generics:
        - GenericParam
          name: T
          bound: (none)
      members:
        - ActionSignature
          async: false
          name: order
          params:
            - Param
              name: other
              variadic: false
              type: NamedType
                path: [T]
                args: []
          result: NamedType
            path: [int]
            args: []
        - ActionSignature
          async: true
          name: refresh
          params: []
          result: SuccessorResult
            type: NamedType
              path: [Comparing]
              args:
                - NamedType
                  path: [T]
                  args: []
        - ActionSignature
          async: false
          name: has
          params:
            - Param
              name: expected
              variadic: false
              type: NamedType
                path: [T]
                args: []
          result: NamedType
            path: [bool]
            args: []
        - FakeDecl
          body: FakeBody
            members:
              - HasDecl
                names: [calls]
                type: NamedType
                  path: [int]
                  args: []
                default: IntLiteral
                  radix: decimal
                  digits: 0
              - ShorthandConstructor
                name: Comparing
                fields: []
                body: (none)
              - ActionDecl
                async: false
                visibility: public
                projection: (none)
                name: order
                params:
                  - Param
                    name: other
                    variadic: false
                    type: NamedType
                      path: [T]
                      args: []
                result: NamedType
                  path: [int]
                  args: []
                body: Block
                  statements:
                    - ExpressionStatement
                      expression: IntLiteral
                        radix: decimal
                        digits: 0
                      condition: (none)
              - ActionDecl
                async: true
                visibility: public
                projection: (none)
                name: refresh
                params: []
                result: SuccessorResult
                  type: NamedType
                    path: [Comparing]
                    args:
                      - NamedType
                        path: [T]
                        args: []
                body: Block
                  statements:
                    - SuccessorAssignStatement
                      name: calls
                      value: Binary
                        operator: +
                        left: NameExpression
                          name: calls
                        right: IntLiteral
                          radix: decimal
                          digits: 1
              - ActionDecl
                async: false
                visibility: public
                projection: (none)
                name: has
                params:
                  - Param
                    name: expected
                    variadic: false
                    type: NamedType
                      path: [T]
                      args: []
                result: NamedType
                  path: [bool]
                  args: []
                body: Block
                  statements:
                    - ExpressionStatement
                      expression: BoolLiteral
                        value: false
                      condition: (none)
              - DestroyDecl
                body: Block
                  statements:
                    - ExpressionStatement
                      expression: NameExpression
                        name: calls
                      condition: (none)
        - TestDecl
          async: false
          name: "role test"
          body: Block
            statements:
              - ExpressionStatement
                expression: Call
                  callee: Get
                    object: NameExpression
                      name: test
                    name: ok
                  arguments:
                    - Argument
                      name: (none)
                      value: BoolLiteral
                        value: true
                condition: (none)
    - ObjectDecl
      name: Account
      generics:
        - GenericParam
          name: T
          bound: NamedType
            path: [Comparing]
            args:
              - NamedType
                path: [T]
                args: []
        - GenericParam
          name: U
          bound: (none)
      roles:
        - NamedType
          path: [Comparing]
          args:
            - NamedType
              path: [T]
              args: []
        - NamedType
          path: [io, Printable]
          args: []
      members:
        - HasDecl
          names: [owner, nickname]
          type: NamedType
            path: [string]
            args: []
          default: (none)
        - HasDecl
          names: [balance]
          type: NamedType
            path: [int]
            args: []
          default: IntLiteral
            radix: decimal
            digits: 0
        - HasDecl
          names: [callback]
          type: ActionType
            async: false
            params:
              - NamedType
                path: [int]
                args: []
              - NamedType
                path: [string]
                args: []
            result: VoidResult
          default: (none)
        - HasDecl
          names: [loader]
          type: ActionType
            async: true
            params:
              - NamedType
                path: [Request]
                args: []
            result: NamedType
              path: [Response]
              args: []
          default: (none)
        - HasDecl
          names: [pairs]
          type: MapType
            key: NamedType
              path: [string]
              args: []
            value: ArrayType
              element: NamedType
                path: [int]
                args: []
          default: (none)
        - HasDecl
          names: [nested]
          type: NamedType
            path: [Box]
            args:
              - NamedType
                path: [Box]
                args:
                  - NamedType
                    path: [int]
                    args: []
          default: (none)
        - HasDecl
          names: [untyped]
          type: (none)
          default: StringLiteral
            form: quoted
            value: "default"
        - ShorthandConstructor
          name: Account
          fields: [owner, nickname]
          body: (none)
        - ShorthandConstructor
          name: Account
          fields: []
          body: (none)
        - FullConstructor
          name: Account
          params:
            - Param
              name: owner
              variadic: false
              type: NamedType
                path: [string]
                args: []
            - Param
              name: rest
              variadic: true
              type: NamedType
                path: [string]
                args: []
          body: Block
            statements:
              - SelfFieldBindStatement
                name: owner
                value: NameExpression
                  name: owner
              - FieldBindStatement
                name: nickname
                value: Index
                  object: NameExpression
                    name: rest
                  index: IntLiteral
                    radix: decimal
                    digits: 0
                  fallback: StringLiteral
                    form: quoted
                    value: "none"
        - ShorthandConstructor
          name: Account
          fields: [balance]
          body: Block
            statements:
              - ConfirmStatement
                condition: Binary
                  operator: >=
                  left: NameExpression
                    name: balance
                  right: IntLiteral
                    radix: decimal
                    digits: 0
                fallback: ConfirmThrow
                  value: Call
                    callee: NameExpression
                      name: Negative
                    arguments:
                      - Argument
                        name: (none)
                        value: NameExpression
                          name: balance
        - DestroyDecl
          body: Block
            statements:
              - ExpressionStatement
                expression: NameExpression
                  name: owner
                condition: (none)
        - CapDecl
          owner: (none)
          name: Summary
          fields:
            - ComputedField
              name: label
              type: NamedType
                path: [string]
                args: []
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: +
                      left: Binary
                        operator: +
                        left: NameExpression
                          name: owner
                        right: StringLiteral
                          form: quoted
                          value: " "
                      right: NameExpression
                        name: nickname
                    condition: (none)
            - ComputedField
              name: public_balance
              type: NamedType
                path: [int]
                args: []
              body: Block
                statements:
                  - ExpressionStatement
                    expression: NameExpression
                      name: balance
                    condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: ProjectionDirective
            alias: (none)
          name: total
          params: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: NameExpression
                  name: balance
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: ProjectionDirective
            alias: described
          name: describe
          params: []
          result: NamedType
            path: [string]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Get
                  object: SelfExpression
                  name: owner
                condition: (none)
        - ActionDecl
          async: true
          visibility: public
          projection: (none)
          name: load
          params:
            - Param
              name: id
              variadic: false
              type: NamedType
                path: [int]
                args: []
          result: ArrayType
            element: NamedType
              path: [T]
              args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Await
                  value: Call
                    callee: NameExpression
                      name: fetch
                    arguments:
                      - Argument
                        name: (none)
                        value: NameExpression
                          name: id
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: order
          params:
            - Param
              name: other
              variadic: false
              type: NamedType
                path: [T]
                args: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: IntLiteral
                  radix: decimal
                  digits: 0
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: is
          params:
            - Param
              name: actual
              variadic: false
              type: NamedType
                path: [any]
                args: []
            - Param
              name: expected
              variadic: false
              type: NamedType
                path: [any]
                args: []
          result: VoidResult
          body: Block
            statements: []
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: has
          params:
            - Param
              name: expected
              variadic: false
              type: NamedType
                path: [T]
                args: []
          result: NamedType
            path: [bool]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: BoolLiteral
                  value: true
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: deposit
          params:
            - Param
              name: amount
              variadic: false
              type: NamedType
                path: [int]
                args: []
          result: SuccessorResult
            type: NamedType
              path: [Account]
              args:
                - NamedType
                  path: [T]
                  args: []
                - NamedType
                  path: [U]
                  args: []
          body: Block
            statements:
              - SuccessorAssignStatement
                name: balance
                value: Binary
                  operator: +
                  left: NameExpression
                    name: balance
                  right: NameExpression
                    name: amount
        - TestDecl
          async: false
          name: "object test"
          body: Block
            statements:
              - ExpressionStatement
                expression: Call
                  callee: Get
                    object: NameExpression
                      name: test
                    name: is
                  arguments:
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 1
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 1
                condition: (none)
        - TestDecl
          async: true
          name: "async object test"
          body: Block
            statements:
              - ExpressionStatement
                expression: Await
                  value: Call
                    callee: NameExpression
                      name: nothing
                    arguments: []
                condition: (none)
        - PrivateSection
          actions:
            - ActionDecl
              async: false
              visibility: private
              projection: (none)
              name: helper
              params: []
              result: VoidResult
              body: Block
                statements: []
            - ActionDecl
              async: false
              visibility: private
              projection: ProjectionDirective
                alias: secret
              name: hidden
              params: []
              result: NamedType
                path: [string]
                args: []
              body: Block
                statements:
                  - ExpressionStatement
                    expression: StringLiteral
                      form: quoted
                      value: "x"
                    condition: (none)
    - CapDecl
      owner: Account
      name: Audit
      fields:
        - ComputedField
          name: trail
          type: ArrayType
            element: NamedType
              path: [string]
              args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: ArrayLiteral
                  elements:
                    - OwnerField
                      owner: Account
                      name: owner
                condition: (none)
    - TestDecl
      async: false
      name: "module test"
      body: Block
        statements:
          - ExpressionStatement
            expression: Call
              callee: Get
                object: NameExpression
                  name: test
                name: ok
              arguments:
                - Argument
                  name: (none)
                  value: Binary
                    operator: ==
                    left: Call
                      callee: Get
                        object: Call
                          callee: Get
                            object: NameExpression
                              name: Comparing
                            name: fake
                          arguments: []
                        name: has
                      arguments:
                        - Argument
                          name: (none)
                          value: IntLiteral
                            radix: decimal
                            digits: 1
                    right: BoolLiteral
                      value: false
            condition: (none)
    - TestDecl
      async: true
      name: "module async test"
      body: Block
        statements:
          - LetStatement
            name: value
            type: (none)
            value: Await
              value: Call
                callee: Get
                  object: Call
                    callee: NameExpression
                      name: Account
                    arguments: []
                  name: load
                arguments:
                  - Argument
                    name: (none)
                    value: IntLiteral
                      radix: decimal
                      digits: 1
    - ActionDecl
      async: true
      visibility: public
      projection: (none)
      name: main
      params: []
      result: NamedType
        path: [int]
        args: []
      body: Block
        statements:
          - LetStatement
            name: out
            type: (none)
            value: Call
              callee: NameExpression
                name: Stdout
              arguments: []
          - LetStatement
            name: count
            type: NamedType
              path: [int]
              args: []
            value: Binary
              operator: -
              left: Binary
                operator: +
                left: Binary
                  operator: +
                  left: IntLiteral
                    radix: hexadecimal
                    digits: 1F
                  right: IntLiteral
                    radix: binary
                    digits: 1010
                right: IntLiteral
                  radix: decimal
                  digits: 1000
              right: Binary
                operator: %
                left: Binary
                  operator: /
                  left: Binary
                    operator: *
                    left: IntLiteral
                      radix: decimal
                      digits: 7
                    right: IntLiteral
                      radix: decimal
                      digits: 3
                  right: IntLiteral
                    radix: decimal
                    digits: 2
                right: IntLiteral
                  radix: decimal
                  digits: 4
          - LetStatement
            name: ratio
            type: (none)
            value: FloatLiteral
              value: 3.14
          - LetStatement
            name: letter
            type: (none)
            value: CharLiteral
              value: "x"
          - LetStatement
            name: escaped
            type: (none)
            value: StringLiteral
              form: quoted
              value: "tab\there \"quoted\" \\ end"
          - LetStatement
            name: raw
            type: (none)
            value: StringLiteral
              form: fenced
              value: "raw \"text\" \\n stays"
          - LetStatement
            name: flags
            type: (none)
            value: Binary
              operator: ||
              left: Unary
                operator: !
                operand: BoolLiteral
                  value: true
              right: Binary
                operator: &&
                left: BoolLiteral
                  value: false
                right: Unary
                  operator: !
                  operand: Grouping
                    expression: Binary
                      operator: !=
                      left: IntLiteral
                        radix: decimal
                        digits: 1
                      right: IntLiteral
                        radix: decimal
                        digits: 2
          - LetStatement
            name: bits
            type: (none)
            value: Binary
              operator: |
              left: Binary
                operator: &
                left: Unary
                  operator: ~
                  operand: IntLiteral
                    radix: decimal
                    digits: 1
                right: IntLiteral
                  radix: decimal
                  digits: 3
              right: Binary
                operator: ^
                left: IntLiteral
                  radix: decimal
                  digits: 4
                right: Binary
                  operator: >>>
                  left: Binary
                    operator: >>
                    left: Binary
                      operator: <<
                      left: IntLiteral
                        radix: decimal
                        digits: 5
                      right: IntLiteral
                        radix: decimal
                        digits: 1
                    right: IntLiteral
                      radix: decimal
                      digits: 1
                  right: IntLiteral
                    radix: decimal
                    digits: 1
          - LetStatement
            name: compare
            type: (none)
            value: Binary
              operator: &&
              left: Binary
                operator: ==
                left: Binary
                  operator: <
                  left: IntLiteral
                    radix: decimal
                    digits: 1
                  right: IntLiteral
                    radix: decimal
                    digits: 2
                right: Binary
                  operator: >
                  left: IntLiteral
                    radix: decimal
                    digits: 3
                  right: IntLiteral
                    radix: decimal
                    digits: 4
              right: Binary
                operator: !=
                left: Binary
                  operator: <=
                  left: IntLiteral
                    radix: decimal
                    digits: 5
                  right: IntLiteral
                    radix: decimal
                    digits: 6
                right: Binary
                  operator: >=
                  left: IntLiteral
                    radix: decimal
                    digits: 7
                  right: IntLiteral
                    radix: decimal
                    digits: 8
          - LetStatement
            name: range
            type: (none)
            value: Range
              operator: ..
              start: IntLiteral
                radix: decimal
                digits: 1
              end: IntLiteral
                radix: decimal
                digits: 10
          - LetStatement
            name: inclusive
            type: (none)
            value: Range
              operator: ..=
              start: IntLiteral
                radix: decimal
                digits: 1
              end: IntLiteral
                radix: decimal
                digits: 10
          - LetStatement
            name: list
            type: ArrayType
              element: NamedType
                path: [int]
                args: []
            value: ArrayLiteral
              elements:
                - IntLiteral
                  radix: decimal
                  digits: 1
                - IntLiteral
                  radix: decimal
                  digits: 2
                - IntLiteral
                  radix: decimal
                  digits: 3
          - LetStatement
            name: empty_list
            type: (none)
            value: ArrayLiteral
              elements: []
          - LetStatement
            name: table
            type: (none)
            value: MapLiteral
              entries:
                - MapEntry
                  key: StringLiteral
                    form: quoted
                    value: "a"
                  value: IntLiteral
                    radix: decimal
                    digits: 1
                - MapEntry
                  key: StringLiteral
                    form: quoted
                    value: "b"
                  value: IntLiteral
                    radix: decimal
                    digits: 2
          - LetStatement
            name: empty_table
            type: (none)
            value: MapLiteral
              entries: []
          - LetStatement
            name: first
            type: (none)
            value: Index
              object: NameExpression
                name: list
              index: IntLiteral
                radix: decimal
                digits: 0
              fallback: Unary
                operator: -
                operand: IntLiteral
                  radix: decimal
                  digits: 1
          - LetStatement
            name: picked
            type: (none)
            value: Index
              object: NameExpression
                name: table
              index: StringLiteral
                form: quoted
                value: "a"
              fallback: (none)
          - LetStatement
            name: cast
            type: (none)
            value: ArrayCast
              target: byte
              arguments:
                - Argument
                  name: (none)
                  value: IntLiteral
                    radix: decimal
                    digits: 104
                - Argument
                  name: (none)
                  value: IntLiteral
                    radix: decimal
                    digits: 105
          - LetStatement
            name: spread
            type: (none)
            value: ArrayCast
              target: string
              arguments:
                - Argument
                  name: (none)
                  value: Unpack
                    operand: NameExpression
                      name: list
                - Argument
                  name: (none)
                  value: IntLiteral
                    radix: decimal
                    digits: 4
          - LetStatement
            name: single
            type: (none)
            value: Call
              callee: NameExpression
                name: byte
              arguments:
                - Argument
                  name: (none)
                  value: IntLiteral
                    radix: decimal
                    digits: 112
          - LetStatement
            name: projected
            type: (none)
            value: Projection
              prefix: described
              construction: Call
                callee: NameExpression
                  name: Account
                arguments:
                  - Argument
                    name: owner
                    value: StringLiteral
                      form: quoted
                      value: "ada"
                  - Argument
                    name: nickname
                    value: StringLiteral
                      form: quoted
                      value: "a"
          - LetStatement
            name: qualified
            type: (none)
            value: Projection
              prefix: total
              construction: Call
                callee: Get
                  object: NameExpression
                    name: channels
                  name: Channel
                arguments:
                  - Argument
                    name: capacity
                    value: IntLiteral
                      radix: decimal
                      digits: 1
          - LetStatement
            name: doubled
            type: (none)
            value: Functional
              operation: map
              receiver: NameExpression
                name: list
              arguments: []
              bindings: [item]
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: *
                      left: NameExpression
                        name: item
                      right: IntLiteral
                        radix: decimal
                        digits: 2
                    condition: (none)
          - LetStatement
            name: evens
            type: (none)
            value: Functional
              operation: filter
              receiver: NameExpression
                name: list
              arguments: []
              bindings: [item]
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: ==
                      left: Binary
                        operator: %
                        left: NameExpression
                          name: item
                        right: IntLiteral
                          radix: decimal
                          digits: 2
                      right: IntLiteral
                        radix: decimal
                        digits: 0
                    condition: (none)
          - LetStatement
            name: sum
            type: (none)
            value: Functional
              operation: reduce
              receiver: NameExpression
                name: list
              arguments:
                - Argument
                  name: (none)
                  value: IntLiteral
                    radix: decimal
                    digits: 0
              bindings: [acc, item]
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: +
                      left: NameExpression
                        name: acc
                      right: NameExpression
                        name: item
                    condition: (none)
          - LetStatement
            name: callback
            type: (none)
            value: AnonymousAction
              params:
                - Param
                  name: value
                  variadic: false
                  type: NamedType
                    path: [int]
                    args: []
                - Param
                  name: label
                  variadic: false
                  type: NamedType
                    path: [string]
                    args: []
              result: VoidResult
              body: Block
                statements:
                  - ExpressionStatement
                    expression: StreamWrite
                      sink: NameExpression
                        name: out
                      source: NameExpression
                        name: label
                    condition: (none)
          - LetStatement
            name: maker
            type: (none)
            value: AnonymousAction
              params: []
              result: ActionType
                async: false
                params:
                  - NamedType
                    path: [int]
                    args: []
                result: NamedType
                  path: [int]
                  args: []
              body: Block
                statements:
                  - ExpressionStatement
                    expression: AnonymousAction
                      params:
                        - Param
                          name: x
                          variadic: false
                          type: NamedType
                            path: [int]
                            args: []
                      result: NamedType
                        path: [int]
                        args: []
                      body: Block
                        statements:
                          - ExpressionStatement
                            expression: NameExpression
                              name: x
                            condition: (none)
                    condition: (none)
          - LetStatement
            name: chosen
            type: (none)
            value: IfExpression
              condition: NameExpression
                name: flags
              then: Block
                statements:
                  - ExpressionStatement
                    expression: IntLiteral
                      radix: decimal
                      digits: 1
                    condition: (none)
              else: Block
                statements:
                  - ExpressionStatement
                    expression: IntLiteral
                      radix: decimal
                      digits: 2
                    condition: (none)
          - LetStatement
            name: named
            type: (none)
            value: MatchExpression
              subject: NameExpression
                name: letter
              cases:
                - MatchCase
                  patterns:
                    - CharLiteral
                      value: "x"
                    - CharLiteral
                      value: "y"
                  body: Block
                    statements:
                      - ExpressionStatement
                        expression: StringLiteral
                          form: quoted
                          value: "near"
                        condition: (none)
              else: Block
                statements:
                  - ExpressionStatement
                    expression: StringLiteral
                      form: quoted
                      value: "far"
                    condition: (none)
