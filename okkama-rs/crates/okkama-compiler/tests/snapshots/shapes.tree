Program
  module: ModuleDecl
    path: [shapes]
    version: v1.0.0
  imports:
    - ImportDecl
      path: "io/stdout"
      alias: (none)
      take: [Stdout]
  items:
    - EnumDecl
      name: Kind
      cases: [square, rectangle]
    - RoleDecl
      name: Shape
      generics: []
      members:
        - ActionSignature
          async: false
          name: area
          params: []
          result: NamedType
            path: [int]
            args: []
        - ActionSignature
          async: false
          name: kind
          params: []
          result: NamedType
            path: [Kind]
            args: []
    - ObjectDecl
      name: Square
      generics: []
      roles:
        - NamedType
          path: [Shape]
          args: []
      members:
        - HasDecl
          names: [side]
          type: NamedType
            path: [int]
            args: []
          default: (none)
        - ShorthandConstructor
          name: Square
          fields: [side]
          body: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: area
          params: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Binary
                  operator: *
                  left: NameExpression
                    name: side
                  right: NameExpression
                    name: side
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: kind
          params: []
          result: NamedType
            path: [Kind]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Get
                  object: NameExpression
                    name: Kind
                  name: square
                condition: (none)
    - ObjectDecl
      name: Rectangle
      generics: []
      roles:
        - NamedType
          path: [Shape]
          args: []
      members:
        - HasDecl
          names: [width, height]
          type: NamedType
            path: [int]
            args: []
          default: (none)
        - HasDecl
          names: [label]
          type: NamedType
            path: [string]
            args: []
          default: StringLiteral
            form: quoted
            value: "rectangle"
        - FullConstructor
          name: Rectangle
          params:
            - Param
              name: width
              variadic: false
              type: NamedType
                path: [int]
                args: []
            - Param
              name: height
              variadic: false
              type: NamedType
                path: [int]
                args: []
          body: Block
            statements:
              - SelfFieldBindStatement
                name: width
                value: NameExpression
                  name: width
              - SelfFieldBindStatement
                name: height
                value: NameExpression
                  name: height
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: area
          params: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Binary
                  operator: *
                  left: NameExpression
                    name: width
                  right: NameExpression
                    name: height
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: kind
          params: []
          result: NamedType
            path: [Kind]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Get
                  object: NameExpression
                    name: Kind
                  name: rectangle
                condition: (none)
        - CapDecl
          owner: (none)
          name: Size
          fields:
            - ComputedField
              name: perimeter
              type: NamedType
                path: [int]
                args: []
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: *
                      left: IntLiteral
                        radix: decimal
                        digits: 2
                      right: Grouping
                        expression: Binary
                          operator: +
                          left: NameExpression
                            name: width
                          right: NameExpression
                            name: height
                    condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: ProjectionDirective
            alias: described
          name: description
          params: []
          result: NamedType
            path: [string]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Binary
                  operator: +
                  left: Binary
                    operator: +
                    left: NameExpression
                      name: label
                    right: StringLiteral
                      form: quoted
                      value: " "
                  right: Call
                    callee: Get
                      object: Call
                        callee: Get
                          object: SelfExpression
                          name: area
                        arguments: []
                      name: string
                    arguments: []
                condition: (none)
        - PrivateSection
          actions:
            - ActionDecl
              async: false
              visibility: private
              projection: (none)
              name: unused
              params: []
              result: NamedType
                path: [int]
                args: []
              body: Block
                statements:
                  - ExpressionStatement
                    expression: IntLiteral
                      radix: decimal
                      digits: 0
                    condition: (none)
    - ObjectDecl
      name: Box
      generics:
        - GenericParam
          name: T
          bound: (none)
      roles: []
      members:
        - HasDecl
          names: [item]
          type: NamedType
            path: [T]
            args: []
          default: (none)
        - ShorthandConstructor
          name: Box
          fields: [item]
          body: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: item
          params: []
          result: NamedType
            path: [T]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: NameExpression
                  name: item
                condition: (none)
    - ActionDecl
      async: false
      visibility: public
      projection: (none)
      name: main
      params: []
      result: NamedType
        path: [int]
        args: []
      body: Block
        statements:
          - LetStatement
            name: out
            type: (none)
            value: Call
              callee: NameExpression
                name: Stdout
              arguments: []
          - LetStatement
            name: shapes
            type: ArrayType
              element: NamedType
                path: [Shape]
                args: []
            value: ArrayLiteral
              elements:
                - Call
                  callee: NameExpression
                    name: Square
                  arguments:
                    - Argument
                      name: side
                      value: IntLiteral
                        radix: decimal
                        digits: 3
                - Call
                  callee: NameExpression
                    name: Rectangle
                  arguments:
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 2
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 5
          - ForStatement
            source: NameExpression
              name: shapes
            bindings:
              - ForBinding
                name: shape
                batch: (none)
            body: Block
              statements:
                - LetStatement
                  name: name
                  type: (none)
                  value: MatchExpression
                    subject: Call
                      callee: Get
                        object: NameExpression
                          name: shape
                        name: kind
                      arguments: []
                    cases:
                      - MatchCase
                        patterns:
                          - Get
                            object: NameExpression
                              name: Kind
                            name: square
                        body: Block
                          statements:
                            - ExpressionStatement
                              expression: StringLiteral
                                form: quoted
                                value: "square"
                              condition: (none)
                    else: Block
                      statements:
                        - ExpressionStatement
                          expression: StringLiteral
                            form: quoted
                            value: "other"
                          condition: (none)
                - ExpressionStatement
                  expression: StreamWrite
                    sink: StreamWrite
                      sink: NameExpression
                        name: out
                      source: Binary
                        operator: +
                        left: Binary
                          operator: +
                          left: NameExpression
                            name: name
                          right: StringLiteral
                            form: quoted
                            value: " "
                        right: Call
                          callee: Get
                            object: Call
                              callee: Get
                                object: NameExpression
                                  name: shape
                                name: area
                              arguments: []
                            name: string
                          arguments: []
                    source: StringLiteral
                      form: endl
                      value: "\n"
                  condition: (none)
          - LetStatement
            name: size
            type: NestedType
              owner: NamedType
                path: [Rectangle]
                args: []
              name: Size
            value: Select
              object: Call
                callee: NameExpression
                  name: Rectangle
                arguments:
                  - Argument
                    name: (none)
                    value: IntLiteral
                      radix: decimal
                      digits: 2
                  - Argument
                    name: (none)
                    value: IntLiteral
                      radix: decimal
                      digits: 5
              name: Size
          - LetStatement
            name: boxed
            type: NamedType
              path: [Box]
              args:
                - NamedType
                  path: [string]
                  args: []
            value: Call
              callee: NameExpression
                name: Box
              arguments:
                - Argument
                  name: item
                  value: Projection
                    prefix: described
                    construction: Call
                      callee: NameExpression
                        name: Rectangle
                      arguments:
                        - Argument
                          name: (none)
                          value: IntLiteral
                            radix: decimal
                            digits: 1
                        - Argument
                          name: (none)
                          value: IntLiteral
                            radix: decimal
                            digits: 4
          - ExpressionStatement
            expression: StreamWrite
              sink: StreamWrite
                sink: NameExpression
                  name: out
                source: Binary
                  operator: +
                  left: Binary
                    operator: +
                    left: Call
                      callee: Get
                        object: NameExpression
                          name: boxed
                        name: item
                      arguments: []
                    right: StringLiteral
                      form: quoted
                      value: " / "
                  right: Call
                    callee: Get
                      object: Select
                        object: NameExpression
                          name: size
                        name: perimeter
                      name: string
                    arguments: []
              source: StringLiteral
                form: endl
                value: "\n"
            condition: (none)
          - ExpressionStatement
            expression: IntLiteral
              radix: decimal
              digits: 0
            condition: (none)
