Program
  module: ModuleDecl
    path: [examples, arithmetic]
    version: v1.0.0
  imports: []
  items:
    - ActionDecl
      async: false
      visibility: public
      projection: (none)
      name: main
      params: []
      result: NamedType
        path: [int]
        args: []
      body: Block
        statements:
          - ExpressionStatement
            expression: Binary
              operator: +
              left: IntLiteral
                radix: decimal
                digits: 1
              right: IntLiteral
                radix: decimal
                digits: 1
            condition: (none)
