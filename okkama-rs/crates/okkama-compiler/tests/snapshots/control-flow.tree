Program
  module: ModuleDecl
    path: [flow]
    version: v1.0.0
  imports:
    - ImportDecl
      path: "io/stdout"
      alias: (none)
      take: [Stdout]
  items:
    - ObjectDecl
      name: TooLarge
      generics: []
      roles:
        - NamedType
          path: [Error]
          args: []
      members:
        - HasDecl
          names: [value]
          type: NamedType
            path: [int]
            args: []
          default: (none)
        - ShorthandConstructor
          name: TooLarge
          fields: [value]
          body: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: text
          params: []
          result: NamedType
            path: [string]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Binary
                  operator: +
                  left: StringLiteral
                    form: quoted
                    value: "too large: "
                  right: Call
                    callee: Get
                      object: NameExpression
                        name: value
                      name: string
                    arguments: []
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: value
          params: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: NameExpression
                  name: value
                condition: (none)
    - ObjectDecl
      name: Checker
      generics: []
      roles: []
      members:
        - ShorthandConstructor
          name: Checker
          fields: []
          body: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: check
          params:
            - Param
              name: value
              variadic: false
              type: NamedType
                path: [int]
                args: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - IfStatement
                condition: Binary
                  operator: >
                  left: NameExpression
                    name: value
                  right: IntLiteral
                    radix: decimal
                    digits: 100
                then: Block
                  statements:
                    - ThrowStatement
                      value: Call
                        callee: NameExpression
                          name: TooLarge
                        arguments:
                          - Argument
                            name: value
                            value: NameExpression
                              name: value
                else: (none)
              - ExpressionStatement
                expression: NameExpression
                  name: value
                condition: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: classify
          params:
            - Param
              name: value
              variadic: false
              type: NamedType
                path: [int]
                args: []
          result: NamedType
            path: [string]
            args: []
          body: Block
            statements:
              - IfStatement
                condition: Binary
                  operator: <
                  left: NameExpression
                    name: value
                  right: IntLiteral
                    radix: decimal
                    digits: 0
                then: Block
                  statements:
                    - ReturnStatement
                      value: StringLiteral
                        form: quoted
                        value: "negative"
                else: IfStatement
                  condition: Binary
                    operator: ==
                    left: NameExpression
                      name: value
                    right: IntLiteral
                      radix: decimal
                      digits: 0
                  then: Block
                    statements:
                      - ReturnStatement
                        value: StringLiteral
                          form: quoted
                          value: "zero"
                  else: (none)
              - ExpressionStatement
                expression: StringLiteral
                  form: quoted
                  value: "positive"
                condition: (none)
    - ActionDecl
      async: false
      visibility: public
      projection: (none)
      name: main
      params: []
      result: NamedType
        path: [int]
        args: []
      body: Block
        statements:
          - LetStatement
            name: out
            type: (none)
            value: Call
              callee: NameExpression
                name: Stdout
              arguments: []
          - LetStatement
            name: checker
            type: (none)
            value: Call
              callee: NameExpression
                name: Checker
              arguments: []
          - ForStatement
            source: Range
              operator: ..=
              start: IntLiteral
                radix: decimal
                digits: 1
              end: IntLiteral
                radix: decimal
                digits: 10
            bindings:
              - ForBinding
                name: number
                batch: (none)
            body: Block
              statements:
                - NextStatement
                  condition: Binary
                    operator: ==
                    left: Binary
                      operator: %
                      left: NameExpression
                        name: number
                      right: IntLiteral
                        radix: decimal
                        digits: 2
                    right: IntLiteral
                      radix: decimal
                      digits: 0
                - ExpressionStatement
                  expression: StreamWrite
                    sink: StreamWrite
                      sink: NameExpression
                        name: out
                      source: Call
                        callee: Get
                          object: NameExpression
                            name: number
                          name: string
                        arguments: []
                    source: StringLiteral
                      form: quoted
                      value: " "
                  condition: (none)
          - ExpressionStatement
            expression: StreamWrite
              sink: NameExpression
                name: out
              source: StringLiteral
                form: endl
                value: "\n"
            condition: (none)
          - LetStatement
            name: odd
            type: (none)
            value: Functional
              operation: filter
              receiver: Grouping
                expression: Range
                  operator: ..=
                  start: IntLiteral
                    radix: decimal
                    digits: 1
                  end: IntLiteral
                    radix: decimal
                    digits: 10
              arguments: []
              bindings: [number]
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: ==
                      left: Binary
                        operator: %
                        left: NameExpression
                          name: number
                        right: IntLiteral
                          radix: decimal
                          digits: 2
                      right: IntLiteral
                        radix: decimal
                        digits: 1
                    condition: (none)
          - LetStatement
            name: total
            type: (none)
            value: LoopExpression
              body: Block
                statements:
                  - LastStatement
                    value: Functional
                      operation: reduce
                      receiver: NameExpression
                        name: odd
                      arguments:
                        - Argument
                          name: (none)
                          value: IntLiteral
                            radix: decimal
                            digits: 0
                      bindings: [sum, number]
                      body: Block
                        statements:
                          - ExpressionStatement
                            expression: Binary
                              operator: +
                              left: NameExpression
                                name: sum
                              right: NameExpression
                                name: number
                            condition: (none)
                    condition: (none)
          - LetStatement
            name: guarded
            type: (none)
            value: TryExpression
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Call
                      callee: Get
                        object: NameExpression
                          name: checker
                        name: check
                      arguments:
                        - Argument
                          name: (none)
                          value: IntLiteral
                            radix: decimal
                            digits: 500
                    condition: (none)
              catches:
                - CatchClause
                  name: error
                  type: NamedType
                    path: [TooLarge]
                    args: []
                  body: Block
                    statements:
                      - ExpressionStatement
                        expression: Binary
                          operator: -
                          left: Call
                            callee: Get
                              object: NameExpression
                                name: error
                              name: value
                            arguments: []
                          right: IntLiteral
                            radix: decimal
                            digits: 400
                        condition: (none)
          - LetStatement
            name: words
            type: (none)
            value: ArrayLiteral
              elements:
                - Call
                  callee: Get
                    object: NameExpression
                      name: checker
                    name: classify
                  arguments:
                    - Argument
                      name: (none)
                      value: Unary
                        operator: -
                        operand: IntLiteral
                          radix: decimal
                          digits: 1
                - Call
                  callee: Get
                    object: NameExpression
                      name: checker
                    name: classify
                  arguments:
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 0
                - Call
                  callee: Get
                    object: NameExpression
                      name: checker
                    name: classify
                  arguments:
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 7
          - ExpressionStatement
            expression: StreamWrite
              sink: StreamWrite
                sink: NameExpression
                  name: out
                source: Binary
                  operator: +
                  left: Binary
                    operator: +
                    left: Call
                      callee: Get
                        object: NameExpression
                          name: total
                        name: string
                      arguments: []
                    right: StringLiteral
                      form: quoted
                      value: " "
                  right: Call
                    callee: Get
                      object: NameExpression
                        name: guarded
                      name: string
                    arguments: []
              source: StringLiteral
                form: endl
                value: "\n"
            condition: (none)
          - ConfirmStatement
            condition: Binary
              operator: ==
              left: NameExpression
                name: total
              right: IntLiteral
                radix: decimal
                digits: 25
            fallback: ConfirmPanic
              value: StringLiteral
                form: quoted
                value: "unexpected total"
          - ConfirmStatement
            condition: Binary
              operator: ==
              left: NameExpression
                name: guarded
              right: IntLiteral
                radix: decimal
                digits: 100
            fallback: (none)
          - ConfirmStatement
            condition: Binary
              operator: ==
              left: Grouping
                expression: Index
                  object: NameExpression
                    name: words
                  index: IntLiteral
                    radix: decimal
                    digits: 2
                  fallback: StringLiteral
                    form: quoted
                    value: "none"
              right: StringLiteral
                form: quoted
                value: "positive"
            fallback: (none)
          - ExpressionStatement
            expression: IntLiteral
              radix: decimal
              digits: 0
            condition: (none)
