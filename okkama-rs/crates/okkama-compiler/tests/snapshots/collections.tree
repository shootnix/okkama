Program
  module: ModuleDecl
    path: [collections]
    version: v1.0.0
  imports:
    - ImportDecl
      path: "io/stdout"
      alias: (none)
      take: [Stdout]
  items:
    - ObjectDecl
      name: Stats
      generics: []
      roles: []
      members:
        - ShorthandConstructor
          name: Stats
          fields: []
          body: (none)
        - ActionDecl
          async: false
          visibility: public
          projection: (none)
          name: sum
          params:
            - Param
              name: values
              variadic: true
              type: NamedType
                path: [int]
                args: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - LetStatement
                name: all
                type: ArrayType
                  element: NamedType
                    path: [int]
                    args: []
                value: Unpack
                  operand: NameExpression
                    name: values
              - ExpressionStatement
                expression: Functional
                  operation: reduce
                  receiver: NameExpression
                    name: all
                  arguments:
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 0
                  bindings: [total, value]
                  body: Block
                    statements:
                      - ExpressionStatement
                        expression: Binary
                          operator: +
                          left: NameExpression
                            name: total
                          right: NameExpression
                            name: value
                        condition: (none)
                condition: (none)
    - ActionDecl
      async: false
      visibility: public
      projection: (none)
      name: main
      params: []
      result: NamedType
        path: [int]
        args: []
      body: Block
        statements:
          - LetStatement
            name: out
            type: (none)
            value: Call
              callee: NameExpression
                name: Stdout
              arguments: []
          - LetStatement
            name: numbers
            type: (none)
            value: ArrayLiteral
              elements:
                - IntLiteral
                  radix: decimal
                  digits: 1
                - IntLiteral
                  radix: decimal
                  digits: 2
                - IntLiteral
                  radix: decimal
                  digits: 3
                - IntLiteral
                  radix: decimal
                  digits: 4
                - IntLiteral
                  radix: decimal
                  digits: 5
                - IntLiteral
                  radix: decimal
                  digits: 6
          - LetStatement
            name: squares
            type: (none)
            value: Functional
              operation: map
              receiver: NameExpression
                name: numbers
              arguments: []
              bindings: [value]
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: *
                      left: NameExpression
                        name: value
                      right: NameExpression
                        name: value
                    condition: (none)
          - LetStatement
            name: even
            type: (none)
            value: Functional
              operation: filter
              receiver: NameExpression
                name: squares
              arguments: []
              bindings: [value]
              body: Block
                statements:
                  - ExpressionStatement
                    expression: Binary
                      operator: ==
                      left: Binary
                        operator: %
                        left: NameExpression
                          name: value
                        right: IntLiteral
                          radix: decimal
                          digits: 2
                      right: IntLiteral
                        radix: decimal
                        digits: 0
                    condition: (none)
          - LetStatement
            name: ages
            type: MapType
              key: NamedType
                path: [string]
                args: []
              value: NamedType
                path: [int]
                args: []
            value: MapLiteral
              entries:
                - MapEntry
                  key: StringLiteral
                    form: quoted
                    value: "ada"
                  value: IntLiteral
                    radix: decimal
                    digits: 36
                - MapEntry
                  key: StringLiteral
                    form: quoted
                    value: "alan"
                  value: IntLiteral
                    radix: decimal
                    digits: 41
          - LetStatement
            name: missing
            type: (none)
            value: Index
              object: NameExpression
                name: ages
              index: StringLiteral
                form: quoted
                value: "grace"
              fallback: IntLiteral
                radix: decimal
                digits: 0
          - LetStatement
            name: total
            type: (none)
            value: Call
              callee: Get
                object: Call
                  callee: NameExpression
                    name: Stats
                  arguments: []
                name: sum
              arguments:
                - Argument
                  name: (none)
                  value: Unpack
                    operand: NameExpression
                      name: even
          - ExpressionStatement
            expression: StreamWrite
              sink: StreamWrite
                sink: NameExpression
                  name: out
                source: Unpack
                  operand: ArrayCast
                    target: string
                    arguments:
                      - Argument
                        name: (none)
                        value: NameExpression
                          name: total
                      - Argument
                        name: (none)
                        value: NameExpression
                          name: missing
                      - Argument
                        name: (none)
                        value: Index
                          object: NameExpression
                            name: ages
                          index: StringLiteral
                            form: quoted
                            value: "ada"
                          fallback: IntLiteral
                            radix: decimal
                            digits: 0
              source: StringLiteral
                form: endl
                value: "\n"
            condition: (none)
          - ExpressionStatement
            expression: StreamWrite
              sink: StreamWrite
                sink: NameExpression
                  name: out
                source: ArrayCast
                  target: byte
                  arguments:
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 104
                    - Argument
                      name: (none)
                      value: IntLiteral
                        radix: decimal
                        digits: 105
              source: StringLiteral
                form: endl
                value: "\n"
            condition: (none)
          - ConfirmStatement
            condition: Binary
              operator: ==
              left: NameExpression
                name: total
              right: IntLiteral
                radix: decimal
                digits: 56
            fallback: (none)
          - ExpressionStatement
            expression: IntLiteral
              radix: decimal
              digits: 0
            condition: (none)
