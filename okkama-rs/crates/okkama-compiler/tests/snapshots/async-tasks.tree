Program
  module: ModuleDecl
    path: [tasks]
    version: v1.0.0
  imports:
    - ImportDecl
      path: "io/stdout"
      alias: (none)
      take: [Stdout]
    - ImportDecl
      path: "async/channel"
      alias: (none)
      take: [Channel, Sending]
  items:
    - ObjectDecl
      name: Producer
      generics: []
      roles: []
      members:
        - HasDecl
          names: [output]
          type: NamedType
            path: [Sending]
            args:
              - NamedType
                path: [int]
                args: []
          default: (none)
        - ShorthandConstructor
          name: Producer
          fields: [output]
          body: (none)
        - ActionDecl
          async: true
          visibility: public
          projection: (none)
          name: run
          params: []
          result: NamedType
            path: [int]
            args: []
          body: Block
            statements:
              - ExpressionStatement
                expression: Await
                  value: Call
                    callee: Get
                      object: NameExpression
                        name: output
                      name: send
                    arguments:
                      - Argument
                        name: (none)
                        value: IntLiteral
                          radix: decimal
                          digits: 1
                condition: (none)
              - ExpressionStatement
                expression: Await
                  value: Call
                    callee: Get
                      object: NameExpression
                        name: output
                      name: send
                    arguments:
                      - Argument
                        name: (none)
                        value: IntLiteral
                          radix: decimal
                          digits: 2
                condition: (none)
              - ExpressionStatement
                expression: Await
                  value: Call
                    callee: Get
                      object: NameExpression
                        name: output
                      name: send
                    arguments:
                      - Argument
                        name: (none)
                        value: IntLiteral
                          radix: decimal
                          digits: 3
                condition: (none)
              - ExpressionStatement
                expression: IntLiteral
                  radix: decimal
                  digits: 3
                condition: (none)
    - ActionDecl
      async: true
      visibility: public
      projection: (none)
      name: main
      params: []
      result: NamedType
        path: [int]
        args: []
      body: Block
        statements:
          - LetStatement
            name: out
            type: (none)
            value: Call
              callee: NameExpression
                name: Stdout
              arguments: []
          - LetStatement
            name: channel
            type: NamedType
              path: [Channel]
              args:
                - NamedType
                  path: [int]
                  args: []
            value: Call
              callee: NameExpression
                name: Channel
              arguments:
                - Argument
                  name: capacity
                  value: IntLiteral
                    radix: decimal
                    digits: 3
          - LetStatement
            name: task
            type: (none)
            value: Spawn
              call: Call
                callee: Get
                  object: Call
                    callee: NameExpression
                      name: Producer
                    arguments:
                      - Argument
                        name: output
                        value: Call
                          callee: Get
                            object: NameExpression
                              name: channel
                            name: sending
                          arguments: []
                  name: run
                arguments: []
          - LetStatement
            name: first
            type: (none)
            value: Await
              value: Call
                callee: Get
                  object: Call
                    callee: Get
                      object: NameExpression
                        name: channel
                      name: receiving
                    arguments: []
                  name: item
                arguments: []
          - LetStatement
            name: second
            type: (none)
            value: Await
              value: Call
                callee: Get
                  object: Call
                    callee: Get
                      object: NameExpression
                        name: channel
                      name: receiving
                    arguments: []
                  name: item
                arguments: []
          - LetStatement
            name: third
            type: (none)
            value: Await
              value: Call
                callee: Get
                  object: Call
                    callee: Get
                      object: NameExpression
                        name: channel
                      name: receiving
                    arguments: []
                  name: item
                arguments: []
          - LetStatement
            name: sent
            type: (none)
            value: Await
              value: NameExpression
                name: task
          - ExpressionStatement
            expression: StreamWrite
              sink: StreamWrite
                sink: NameExpression
                  name: out
                source: Call
                  callee: Get
                    object: Grouping
                      expression: Binary
                        operator: +
                        left: Binary
                          operator: +
                          left: NameExpression
                            name: first
                          right: NameExpression
                            name: second
                        right: NameExpression
                          name: third
                    name: string
                  arguments: []
              source: StringLiteral
                form: endl
                value: "\n"
            condition: (none)
          - ConfirmStatement
            condition: Binary
              operator: ==
              left: NameExpression
                name: sent
              right: IntLiteral
                radix: decimal
                digits: 3
            fallback: (none)
          - ExpressionStatement
            expression: IntLiteral
              radix: decimal
              digits: 0
            condition: (none)
