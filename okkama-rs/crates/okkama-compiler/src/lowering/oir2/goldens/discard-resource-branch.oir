oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
}
scope S0 action in @app.Res.label#0
scope S1 action in @app.Res.renamed#1
scope S2 action in @main
scope S3 branch in @main parent S2
scope S4 branch in @main parent S2
scope S5 action in @app.Res.new#0

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "s": str in S5
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %1: str = undef ty str
    bind %0, binding b0
    stage %0, action S5, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S5:
    raise %3
}

func @app.Res.label#0(%0: app.Res) -> str [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: str = obj.get %0, name
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.renamed#1(%0: app.Res, %1: str) -> ^app.Res [successor app.Res] {
    binding b0 "s": str in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %2: str = obj.get %0, name
    bind %1, binding b0
    stage %1, action S1, field field_ref(declaration=app.Res, index=0)
    %3: ^app.Res = obj.next %0 { name: %1 }
    want %3
    [i5] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #5
    ret %3
    ^b1(%4: failure) in S1:
    raise %4
}

func @main() -> int [entry] {
    boundary B0 lexical in S2
    boundary B1 lexical in S3
    boundary B2 lexical in S4
    selection s0: selection = union([])
    selection s1: selection = union([])
    ^b0 in S2 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S2:
    raise %1
    ^b2 in S2 unwind ^b1:
    %2: str = const "checkpoint"
    [i2] %3: app.Res = call @app.Res.new#0(%2)
    temp %3, S2
    discard %3
    %4: int = const 0
    want %4
    [i7] exit.prepare return %4 at B0
    result.exit edge normal(0), value %3, demand discard, prepare none
    result.exit edge normal(0), value %4, demand want, prepare #7
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b3 in S3 unwind ^b1:
    %5: str = const "A"
    [i9] %6: app.Res = call @app.Res.new#0(%5)
    temp %6, S3
    discard %6
    exit.prepare fallthrough select s0 at B1
    result.exit edge normal(0), value %6, demand discard, prepare none
    high.effects at #9 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b2
    ^b4 in S4 unwind ^b1:
    exit.prepare fallthrough select s1 at B2
    br ^b2
}
