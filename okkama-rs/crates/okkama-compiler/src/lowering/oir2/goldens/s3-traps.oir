oir 2 high
module app
requires core
entry @main

object app.Work {
}

enum app.Stop is Error = (now)
scope S0 action in @app.Work.check#0
scope S1 action in @app.Work.expected#1
scope S2 action in @app.Work.emergency#2
scope S3 action in @main
scope S4 try in @main parent S3
scope S5 catch in @main parent S3
scope S6 action in @app.Work.new#0

func @app.Work.new#0() -> app.Work [ctor app.Work] {
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %0: app.Work = obj.new app.Work { }
    want %0
    exit.prepare return %0 at B0
    ret %0
    ^b1(%1: failure) in S6:
    raise %1
}

func @app.Work.check#0(%0: app.Work, %1: bool) -> void [method app.Work] {
    binding b0 "b": bool in S0
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    cond %1, ^b2(%1), ^b3(%1)
    ^b1(%2: failure) in S0:
    raise %2
    ^b2(%3: bool) in S0 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b3(%4: bool) in S0 unwind ^b1:
    trap confirm "confirm failed"
}

func @app.Work.expected#1(%0: app.Work, %1: bool) -> void [method app.Work] {
    binding b0 "b": bool in S1
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    bind %1, binding b0
    cond %1, ^b2(%1), ^b3(%1)
    ^b1(%2: failure) in S1:
    raise %2
    ^b2(%3: bool) in S1 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b3(%4: bool) in S1 unwind ^b1:
    %5: app.Stop = enum.case app.Stop, case 0
    throw %5
}

func @app.Work.emergency#2(%0: app.Work, %1: bool) -> void [method app.Work] {
    binding b0 "b": bool in S2
    boundary B0 lexical in S2
    selection s0: selection = union([])
    ^b0 in S2 unwind ^b1:
    bind %1, binding b0
    cond %1, ^b2(%1), ^b3(%1)
    ^b1(%2: failure) in S2:
    raise %2
    ^b2(%3: bool) in S2 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b3(%4: bool) in S2 unwind ^b1:
    %5: str = const "emergency"
