oir 2 high
module app
requires core
entry @main

object app.O {
}
scope S0 action in @app.O.accept#0
scope S1 action in @main
scope S2 action in @app.O.new#0

func @app.O.new#0() -> app.O [ctor app.O] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.O = obj.new app.O { }
    want %0
    exit.prepare return %0 at B0
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

func @app.O.accept#0(%0: app.O, %1: app.O, %2: app.O) -> void [method app.O] {
    binding b0 "a": app.O in S0
    binding b1 "b": app.O in S0
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    bind %2, binding b1
    discard %1
    discard %2
    exit.prepare return select s0 at B0
    ret
    ^b1(%3: failure) in S0:
    raise %3
}

func @main() -> int [entry] {
    binding b0 "bound": app.O in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %0: app.O = call @app.O.new#0()
    bind %0, binding b0
    %1: app.O = call @app.O.new#0()
    %2: app.O = call @app.O.new#0()
    call @app.O.accept#0(%1, %0, %2)
    %3: int = const 0
    want %3
    exit.prepare return %3 at B0
    ret %3
    ^b1(%4: failure) in S1:
    raise %4
}
