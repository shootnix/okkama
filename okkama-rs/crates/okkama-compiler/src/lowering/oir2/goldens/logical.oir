oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 branch in @main parent S0
scope S2 branch in @main parent S0
scope S3 branch in @main parent S0
scope S4 branch in @main parent S0
scope S5 branch in @main parent S0
scope S6 branch in @main parent S0

func @main() -> int [entry] {
    binding b0 "b": bool in S0
    boundary B0 lexical in S0
    boundary B1 lexical in S1
    boundary B2 lexical in S2
    boundary B3 lexical in S3
    boundary B4 lexical in S4
    boundary B5 lexical in S5
    boundary B6 lexical in S6
    ^b0 in S0 unwind ^b1:
    %0: bool = const false
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: bool) in S0 unwind ^b1:
    cond %2, ^b6, ^b7
    ^b3 in S1 unwind ^b1:
    %3: int = const 1
    %4: int = const 0
    %5: int = int.mod %3, %4
    %6: int = const 0
    %7: bool = int.eq %5, %6
    want %7
    [i7] exit.prepare fallthrough %7 at B1
    result.exit edge normal(0), value %7, demand want, prepare #7
    br ^b2(%7)
    ^b4 in S2 unwind ^b1:
    %8: bool = const false
    want %8
    [i10] exit.prepare fallthrough %8 at B2
    result.exit edge normal(0), value %8, demand want, prepare #10
    br ^b2(%8)
    ^b5(%9: bool) in S0 unwind ^b1:
    bind %9, binding b0
    cond %9, ^b9(%9), ^b10(%9)
    ^b6 in S3 unwind ^b1:
    %10: bool = const true
    want %10
    [i14] exit.prepare fallthrough %10 at B3
    result.exit edge normal(0), value %10, demand want, prepare #14
    br ^b5(%10)
    ^b7 in S4 unwind ^b1:
    %11: bool = const false
    %12: bool = bool.not %11
    want %12
    [i18] exit.prepare fallthrough %12 at B4
    result.exit edge normal(0), value %12, demand want, prepare #18
    br ^b5(%12)
    ^b8(%13: int, %14: bool) in S0 unwind ^b1:
    want %13
    [i20] exit.prepare return %13 at B0
    result.exit edge normal(0), value %13, demand want, prepare #20
    ret %13
    ^b9(%15: bool) in S5 unwind ^b1:
    %16: int = const 1
    want %16
    [i23] exit.prepare fallthrough %16 at B5
    want %15
    [i25] exit.prepare fallthrough %15 at B5
    result.exit edge normal(0), value %16, demand want, prepare #23
    result.exit edge normal(0), value %15, demand want, prepare #25
    br ^b8(%16, %15)
    ^b10(%17: bool) in S6 unwind ^b1:
    %18: int = const 0
    want %18
    [i28] exit.prepare fallthrough %18 at B6
    want %17
    [i30] exit.prepare fallthrough %17 at B6
    result.exit edge normal(0), value %18, demand want, prepare #28
    result.exit edge normal(0), value %17, demand want, prepare #30
    br ^b8(%18, %17)
}
