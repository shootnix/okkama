oir 2 high
module app
requires core
entry @main

enum app.Stop is Error = (now, later)
scope S0 action in @main

func @main() -> int [entry] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: app.Stop = enum.case app.Stop, case 0
    discard %0
    %1: int = const 0
    want %1
    [i4] exit.prepare return %1 at B0
    result.exit edge normal(0), value %0, demand discard, prepare none
    result.exit edge normal(0), value %1, demand want, prepare #4
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}
