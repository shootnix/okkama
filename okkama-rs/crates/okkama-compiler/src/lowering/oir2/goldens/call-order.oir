oir 2 high
module app
requires core
entry @main

object app.O {
}
scope S0 action in @app.O.next#0
scope S1 action in @app.O.accept#1
scope S2 action in @main
scope S3 action in @app.O.new#0

func @app.O.new#0() -> app.O [ctor app.O] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: app.O = obj.new app.O { }
    want %0
    exit.prepare return %0 at B0
    ret %0
    ^b1(%1: failure) in S3:
    raise %1
}

func @app.O.next#0(%0: app.O) -> ^app.O [successor app.O] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: ^app.O = obj.next %0 { }
    want %1
    exit.prepare return %1 at B0
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.O.accept#1(%0: app.O, %1: app.O, %2: app.O) -> app.O [method app.O] {
    binding b0 "a": app.O in S1
    binding b1 "b": app.O in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    bind %1, binding b0
    bind %2, binding b1
    want %2
    exit.prepare return %2 at B0
    ret %2
    ^b1(%3: failure) in S1:
    raise %3
}

func @main() -> int [entry] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.O = call @app.O.new#0()
    %1: app.O = call @app.O.new#0()
    %2: ^app.O = call @app.O.next#0(%1)
    %3: app.O = call @app.O.new#0()
    %4: app.O = succ.take %2, ty app.O
    %5: app.O = call @app.O.accept#1(%0, %4, %3)
    discard %5
    %6: int = const 0
    want %6
    exit.prepare return %6 at B0
    ret %6
    ^b1(%7: failure) in S2:
    raise %7
}
