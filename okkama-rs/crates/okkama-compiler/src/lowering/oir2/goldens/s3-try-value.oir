oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
    destroy @app.Res.destroy
}

enum app.Stop is Error = (now)
scope S0 action in @app.Res.destroy
scope S1 action in @main
scope S2 try in @main parent S1
scope S3 catch in @main parent S1
scope S4 try in @main parent S1
scope S5 catch in @main parent S1
scope S6 action in @app.Res.new#0

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "s": str in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: str = undef ty str
    bind %0, binding b0
    stage %0, action S6, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    exit.prepare return %2 at B0
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: str = obj.get %0, name
    discard %1
    exit.prepare return select s0 at B0
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "e": app.Stop in S3
    binding b1 "r": app.Res in S1
    binding b2 "e": app.Stop in S5
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S3
    boundary B3 lexical in S4
    boundary B4 lexical in S5
    ^b0 in S1 unwind ^b1:
    br ^b4
    ^b1(%0: failure) in S1:
    raise %0
    ^b2(%1: app.Res) in S1 unwind ^b1:
    bind %1, binding b1
    discard %1
    br ^b11(%1)
    ^b3(%2: failure) in S1 unwind ^b1:
    catch %2 is app.Stop, ^b5(%2, $value), ^b6(%2)
    ^b4 in S2 unwind ^b3:
    %3: str = const "body"
    %4: app.Res = call @app.Res.new#0(%3)
    want %4
    exit.prepare fallthrough %4 at B1
    br ^b2(%4)
    ^b5(%5: failure, %6: app.Stop) in S3 unwind ^b1:
    bind %6, binding b0
    br ^b8(%5)
    ^b6(%7: failure) in S1 unwind ^b1:
    raise %7
    ^b7(%8: failure, %9: failure) in S1 unwind ^b1:
    %10: failure = fail.caused %9, %8
    raise %10
    ^b8(%11: failure) in S3 unwind ^b7(%11):
    %12: str = const "caught"
    %13: app.Res = call @app.Res.new#0(%12)
    want %13
    exit.prepare fallthrough %13 at B2
    br ^b2(%13)
    ^b9(%14: app.Res) in S1 unwind ^b1:
    %15: int = const 0
    want %15
    exit.prepare return %15 at B0
    ret %15
    ^b10(%16: app.Res, %17: failure) in S1 unwind ^b1:
    catch %17 is app.Stop, ^b12(%16, %17, $value), ^b13(%16, %17)
    ^b11(%18: app.Res) in S4 unwind ^b10(%18):
    %19: str = const "discard"
    %20: app.Res = call @app.Res.new#0(%19)
    temp %20, S4
    discard %20
    want %18
    exit.prepare fallthrough %18 at B3
    br ^b9(%18)
    ^b12(%21: app.Res, %22: failure, %23: app.Stop) in S5 unwind ^b1:
    bind %23, binding b2
    br ^b15(%21, %22)
    ^b13(%24: app.Res, %25: failure) in S1 unwind ^b1:
    raise %25
    ^b14(%26: app.Res, %27: failure, %28: failure) in S1 unwind ^b1:
    %29: failure = fail.caused %28, %27
    raise %29
    ^b15(%30: app.Res, %31: failure) in S5 unwind ^b14(%30, %31):
    %32: str = const "discard-catch"
    %33: app.Res = call @app.Res.new#0(%32)
    temp %33, S5
    discard %33
    want %30
    exit.prepare fallthrough %30 at B4
    br ^b9(%30)
}
