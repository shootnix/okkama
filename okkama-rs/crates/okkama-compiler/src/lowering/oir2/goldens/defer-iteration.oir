oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
}
scope S0 action in @app.Res.label#0
scope S1 action in @app.Res.renamed#1
scope S2 action in @main
scope S3 iteration in @main parent S2
scope S4 branch in @main parent S3
scope S5 branch in @main parent S3
scope S6 action in @app.Res.new#0
scope S7 action in @main.defer#0

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "s": str in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: str = undef ty str
    bind %0, binding b0
    stage %0, action S6, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    exit.prepare return %2 at B0
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Res.label#0(%0: app.Res) -> str [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: str = obj.get %0, name
    want %1
    exit.prepare return %1 at B0
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.renamed#1(%0: app.Res, %1: str) -> ^app.Res [successor app.Res] {
    binding b0 "s": str in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %2: str = obj.get %0, name
    bind %1, binding b0
    stage %1, action S1, field field_ref(declaration=app.Res, index=0)
    %3: ^app.Res = obj.next %0 { name: %1 }
    want %3
    exit.prepare return %3 at B0
    ret %3
    ^b1(%4: failure) in S1:
    raise %4
}

func @main() -> int [entry] {
    binding b0 "i": int in S3
    binding b1 "r": app.Res in S3
    boundary B0 lexical in S2
    boundary B1 loop in S3
    boundary B2 lexical in S5
    selection s0: selection = union([])
    selection s1: selection = union([])
    ^b0 in S2 unwind ^b1:
    %0: int = const 0
    %1: int = const 3
    %2: range = range.new %0, %1
    br ^b3(%0)
    ^b1(%3: failure) in S2:
    raise %3
    ^b2 in S2 unwind ^b1:
    %4: int = const 0
    want %4
    exit.prepare return %4 at B0
    ret %4
    ^b3(%5: int) in S2 unwind ^b1:
    %6: bool = int.lt %5, %1
    cond %6, ^b4, ^b5
    ^b4 in S3 unwind ^b1:
    bind %5, binding b0
    %7: str = const "iteration"
    %8: app.Res = call @app.Res.new#0(%7)
    bind %8, binding b1
    defer.register S3, action defer_action(function=@main.defer#0, bindings=[b1])
    br ^b7(%5, %8)
    ^b5 in S2 unwind ^b1:
    br ^b2
    ^b6 in S2 unwind ^b1:
    %9: int = const 1
    %10: int = int.add %5, %9
    br ^b3(%10)
    ^b7(%11: int, %12: app.Res) in S3 unwind ^b8:
    %13: int = const 1
    %14: bool = int.eq %11, %13
    cond %14, ^b10(%11, %12), ^b11(%11, %12)
    ^b8(%15: failure) in S2:
    raise %15
    ^b9(%16: int, %17: app.Res) in S3 unwind ^b8:
    exit.prepare fallthrough select s1 at B1
    br ^b6
    ^b10(%18: int, %19: app.Res) in S4 unwind ^b8:
    exit.prepare next select s0 at B1
    br ^b6
    ^b11(%20: int, %21: app.Res) in S5 unwind ^b8:
    want %20
    exit.prepare fallthrough %20 at B2
    want %21
    exit.prepare fallthrough %21 at B2
    br ^b9(%20, %21)
}

func @main.defer#0(%0: app.Res) -> void {
    binding b0 "r": app.Res in S7
    boundary B0 lexical in S7
    selection s0: selection = union([])
    ^b0 in S7 unwind ^b1:
    bind %0, binding b0
    %1: str = call @app.Res.label#0(%0)
    discard %1
    exit.prepare return select s0 at B0
    ret
    ^b1(%2: failure) in S7:
    raise %2
}
