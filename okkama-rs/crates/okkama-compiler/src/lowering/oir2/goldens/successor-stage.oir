oir 2 high
module app
requires core
entry @main

object app.O {
    field n: int = @app.O.default#0
}
scope S0 action in @app.O.default#0
scope S1 action in @app.O.bump#0
scope S2 block in @app.O.bump#0 parent S1
scope S3 action in @main
scope S4 action in @app.O.new#0

func @app.O.default#0() -> int [default app.O.n] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S0:
    raise %1
}

func @app.O.new#0() -> app.O [ctor app.O] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: int = undef ty int
    [i1] %1: int = call @app.O.default#0()
    stage %1, action S4, field field_ref(declaration=app.O, index=0)
    %2: app.O = obj.new app.O { n: %1 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.O.bump#0(%0: app.O) -> ^app.O [successor app.O] {
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    br ^b3
    ^b1(%2: failure) in S1:
    raise %2
    ^b2(%3: int) in S1 unwind ^b1:
    %4: int = obj.get %0, n
    %5: int = const 2
    %6: int = int.add %4, %5
    stage %6, action S1, field field_ref(declaration=app.O, index=0)
    %7: ^app.O = obj.next %0 { n: %6 }
    want %7
    [i7] exit.prepare return %7 at B0
    result.exit edge normal(0), value %7, demand want, prepare #7
    ret %7
    ^b3 in S2 unwind ^b1:
    %8: int = obj.get %0, n
    %9: int = const 1
    %10: int = int.add %8, %9
    stage %10, action S1, field field_ref(declaration=app.O, index=0)
    want %10
    [i13] exit.prepare fallthrough %10 at B1
    result.exit edge normal(0), value %10, demand want, prepare #13
    br ^b2(%10)
}

func @main() -> int [entry] {
    binding b0 "o": app.O in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    [i0] %0: app.O = call @app.O.new#0()
    bind %0, binding b0
    [i2] %1: ^app.O = call @app.O.bump#0(%0)
    %2: app.O = succ.take %1, ty app.O
    rebind %2, binding b0, target S3
    %3: int = const 0
    want %3
    [i7] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #7
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S3:
    raise %4
}
