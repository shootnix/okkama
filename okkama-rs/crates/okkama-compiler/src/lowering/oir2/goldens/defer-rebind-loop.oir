oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
}
scope S0 action in @app.Res.label#0
scope S1 action in @app.Res.renamed#1
scope S2 action in @main
scope S3 iteration in @main parent S2
scope S4 action in @app.Res.new#0
scope S5 action in @main.defer#0

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "s": str in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: str = undef ty str
    bind %0, binding b0
    stage %0, action S4, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    exit.prepare return %2 at B0
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Res.label#0(%0: app.Res) -> str [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: str = obj.get %0, name
    want %1
    exit.prepare return %1 at B0
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.renamed#1(%0: app.Res, %1: str) -> ^app.Res [successor app.Res] {
    binding b0 "s": str in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %2: str = obj.get %0, name
    bind %1, binding b0
    stage %1, action S1, field field_ref(declaration=app.Res, index=0)
    %3: ^app.Res = obj.next %0 { name: %1 }
    want %3
    exit.prepare return %3 at B0
    ret %3
    ^b1(%4: failure) in S1:
    raise %4
}

func @main() -> int [entry] {
    binding b0 "r": app.Res in S2
    binding b1 "i": int in S3
    boundary B0 lexical in S2
    boundary B1 loop in S3
    ^b0 in S2 unwind ^b1:
    %0: str = const "A"
    %1: app.Res = call @app.Res.new#0(%0)
    bind %1, binding b0
    defer.register S2, action defer_action(function=@main.defer#0, bindings=[b0])
    br ^b2(%1)
    ^b1(%2: failure) in S2:
    raise %2
    ^b2(%3: app.Res) in S2 unwind ^b3:
    %4: int = const 1
    %5: int = const 3
    %6: range = range.new %4, %5, inclusive true
    br ^b5(%4, %3)
    ^b3(%7: failure) in S2:
    raise %7
    ^b4(%8: app.Res) in S2 unwind ^b3:
    %9: int = const 0
    want %9
    exit.prepare return %9 at B0
    ret %9
    ^b5(%10: int, %11: app.Res) in S2 unwind ^b3:
    %12: bool = int.le %10, %5
    cond %12, ^b6, ^b7
    ^b6 in S3 unwind ^b3:
    bind %10, binding b1
    %13: str = const "B"
    %14: ^app.Res = call @app.Res.renamed#1(%11, %13)
    %15: app.Res = succ.take %14, ty app.Res
    rebind %15, binding b0, target S2
    want %15
    exit.prepare fallthrough %15 at B1
    br ^b8(%15)
    ^b7 in S2 unwind ^b3:
    br ^b4(%11)
    ^b8(%16: app.Res) in S2 unwind ^b3:
    %17: int = const 1
    %18: int = int.add %10, %17
    br ^b5(%18, %16)
}

func @main.defer#0(%0: app.Res) -> void {
    binding b0 "r": app.Res in S5
    boundary B0 lexical in S5
    selection s0: selection = union([])
    ^b0 in S5 unwind ^b1:
    bind %0, binding b0
    %1: str = call @app.Res.label#0(%0)
    discard %1
    exit.prepare return select s0 at B0
    ret
    ^b1(%2: failure) in S5:
    raise %2
}
