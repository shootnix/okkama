oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
    destroy @app.Res.destroy
}

object app.Work {
}

enum app.Stop is Error = (now)
scope S0 action in @app.Res.destroy
scope S1 action in @app.Work.make#0
scope S2 try in @app.Work.make#0 parent S1
scope S3 catch in @app.Work.make#0 parent S1
scope S4 action in @main
scope S5 action in @app.Res.new#0
scope S6 action in @app.Work.new#0

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "s": str in S5
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %1: str = undef ty str
    bind %0, binding b0
    stage %0, action S5, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S5:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: str = obj.get %0, name
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Work.new#0() -> app.Work [ctor app.Work] {
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %0: app.Work = obj.new app.Work { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S6:
    raise %1
}

func @app.Work.make#0(%0: app.Work) -> app.Res [method app.Work] {
    binding b0 "r": app.Res in S2
    binding b1 "e": app.Stop in S3
    boundary B0 lexical in S1
    boundary B1 lexical in S3
    ^b0 in S1 unwind ^b1:
    br ^b4
    ^b1(%1: failure) in S1:
    raise %1
    ^b2(%2: app.Res) in S1 unwind ^b1:
    want %2
    [i1] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #1
    ret %2
    ^b3(%3: failure) in S1 unwind ^b1:
    catch %3 is app.Stop, ^b5(%3, $value), ^b6(%3)
    ^b4 in S2 unwind ^b3:
    %4: str = const "try"
    [i3] %5: app.Res = call @app.Res.new#0(%4)
    bind %5, binding b0
    want %5
    [i6] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #6
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %5
    ^b5(%6: failure, %7: app.Stop) in S3 unwind ^b1:
    bind %7, binding b1
    br ^b8(%6)
    ^b6(%8: failure) in S1 unwind ^b1:
    raise %8
    ^b7(%9: failure, %10: failure) in S1 unwind ^b1:
    %11: failure = fail.caused %10, %9
    raise %11
    ^b8(%12: failure) in S3 unwind ^b7(%12):
    %13: str = const "catch"
    [i10] %14: app.Res = call @app.Res.new#0(%13)
    want %14
    [i12] exit.prepare fallthrough %14 at B1
    result.exit edge normal(0), value %14, demand want, prepare #12
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b2(%14)
}

func @main() -> int [entry] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    [i0] %0: app.Work = call @app.Work.new#0()
    [i1] %1: app.Res = call @app.Work.make#0(%0)
    temp %1, S4
    discard %1
    %2: int = const 0
    want %2
    [i6] exit.prepare return %2 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    result.exit edge normal(0), value %2, demand want, prepare #6
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}
