oir 2 high
module app
requires core
entry @main
scope S0 action in @main

func @main() -> int [entry] {
    binding b0 "s": str in S0
    binding b1 "b": bool in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: bool = const true
    %1: str = cvt %0, from bool, to str
    %2: int = const 12
    %3: str = cvt %2, from int, to str
    %4: str = str.concat %1, %3
    bind %4, binding b0
    %5: str = const "x"
    %6: bool = str.ne %4, %5
    bind %6, binding b1
    %7: int = str.len %4
    want %7
    [i11] exit.prepare return %7 at B0
    result.exit edge normal(0), value %7, demand want, prepare #11
    ret %7
    ^b1(%8: failure) in S0:
    raise %8
}
