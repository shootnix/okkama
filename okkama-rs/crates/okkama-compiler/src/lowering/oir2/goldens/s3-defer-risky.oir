oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
    destroy @app.Res.destroy
}

object app.Work {
}

enum app.Stop is Error = (now)
scope S0 action in @app.Res.destroy
scope S1 action in @app.Work.risky#0
scope S2 action in @app.Work.log#1
scope S3 action in @main
scope S4 block in @main parent S3
scope S5 action in @app.Res.new#0
scope S6 action in @app.Work.new#0
scope S7 action in @main.defer#0

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "s": str in S5
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %1: str = undef ty str
    bind %0, binding b0
    stage %0, action S5, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S5:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: str = obj.get %0, name
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Work.new#0() -> app.Work [ctor app.Work] {
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %0: app.Work = obj.new app.Work { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S6:
    raise %1
}

func @app.Work.risky#0(%0: app.Work) -> void [method app.Work] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: app.Stop = enum.case app.Stop, case 0
    throw %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Work.log#1(%0: app.Work) -> void [method app.Work] {
    boundary B0 lexical in S2
    selection s0: selection = union([])
    ^b0 in S2 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b1(%1: failure) in S2:
    raise %1
}

func @main() -> int [entry] {
    binding b0 "r": app.Res in S4
    boundary B0 lexical in S3
    boundary B1 lexical in S4
    selection s0: selection = union([])
    ^b0 in S3 unwind ^b1:
    br ^b3
    ^b1(%0: failure) in S3:
    raise %0
    ^b2 in S3 unwind ^b1:
    %1: int = const 0
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b3 in S4 unwind ^b1:
    %2: str = const "r"
    [i4] %3: app.Res = call @app.Res.new#0(%2)
    bind %3, binding b0
    defer.register S4, action defer_action(function=@main.defer#0)
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b4(%3)
    ^b4(%4: app.Res) in S4 unwind ^b5:
    [i7] %5: app.Work = call @app.Work.new#0()
    [i8] call @app.Work.risky#0(%5)
    exit.prepare fallthrough select s0 at B1
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b2
    ^b5(%6: failure) in S3:
    raise %6
}

func @main.defer#0() -> void {
    boundary B0 lexical in S7
    selection s0: selection = union([])
    ^b0 in S7 unwind ^b1:
    [i0] %0: app.Work = call @app.Work.new#0()
    [i1] call @app.Work.log#1(%0)
    exit.prepare return select s0 at B0
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret
    ^b1(%1: failure) in S7:
    raise %1
}
