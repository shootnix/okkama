oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
    destroy @app.Res.destroy
}

object app.Work {
}

enum app.Stop is Error = (now)
scope S0 action in @app.Res.destroy
scope S1 action in @app.Work.take#0
scope S2 action in @app.Work.fail#1
scope S3 action in @main
scope S4 try in @main parent S3
scope S5 catch in @main parent S3
scope S6 action in @app.Res.new#0
scope S7 action in @app.Work.new#0

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "s": str in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: str = undef ty str
    bind %0, binding b0
    stage %0, action S6, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: str = obj.get %0, name
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Work.new#0() -> app.Work [ctor app.Work] {
    boundary B0 lexical in S7
    ^b0 in S7 unwind ^b1:
    %0: app.Work = obj.new app.Work { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S7:
    raise %1
}

func @app.Work.take#0(%0: app.Work, %1: app.Res, %2: int) -> void [method app.Work] {
    binding b0 "a": app.Res in S1
    binding b1 "b": int in S1
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    bind %1, binding b0
    bind %2, binding b1
    exit.prepare return select s0 at B0
    ret
    ^b1(%3: failure) in S1:
    raise %3
}

func @app.Work.fail#1(%0: app.Work) -> int [method app.Work] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: app.Stop = enum.case app.Stop, case 0
    throw %1
    ^b1(%2: failure) in S2:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "e": app.Stop in S5
    boundary B0 lexical in S3
    boundary B1 lexical in S4
    boundary B2 lexical in S5
    selection s0: selection = union([])
    selection s1: selection = union([])
    ^b0 in S3 unwind ^b1:
    br ^b4
    ^b1(%0: failure) in S3:
    raise %0
    ^b2 in S3 unwind ^b1:
    %1: int = const 0
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b3(%2: failure) in S3 unwind ^b1:
    catch %2 is app.Stop, ^b5(%2, $value), ^b6(%2)
    ^b4 in S4 unwind ^b3:
    [i3] %3: app.Work = call @app.Work.new#0()
    %4: str = const "A"
    [i5] %5: app.Res = call @app.Res.new#0(%4)
    [i6] %6: app.Work = call @app.Work.new#0()
    [i7] %7: int = call @app.Work.fail#1(%6)
    [i8] call @app.Work.take#0(%3, %5, %7)
    exit.prepare fallthrough select s0 at B1
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #5 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b2
    ^b5(%8: failure, %9: app.Stop) in S5 unwind ^b1:
    bind %9, binding b0
    br ^b8(%8)
    ^b6(%10: failure) in S3 unwind ^b1:
    raise %10
    ^b7(%11: failure, %12: failure) in S3 unwind ^b1:
    %13: failure = fail.caused %12, %11
    raise %13
    ^b8(%14: failure) in S5 unwind ^b7(%14):
    discard %9
    exit.prepare fallthrough select s1 at B2
    result.exit edge normal(0), value %9, demand discard, prepare none
    br ^b2
}
