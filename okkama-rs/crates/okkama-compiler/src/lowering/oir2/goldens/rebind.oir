oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 branch in @main parent S1
scope S3 branch in @main parent S1
func @main() -> int [entry] {
    binding b0 "n": int in S0
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S3
    ^b0 in S0 unwind ^b1:
    %0: int = const 0
    bind %0, binding b0
    br ^b3(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: int) in S0 unwind ^b1:
    want %2
    exit.prepare return %2 at B0
    ret %2
    ^b3(%3: int) in S0 unwind ^b1:
    br ^b4(%3)
    ^b4(%4: int) in S1 unwind ^b1:
    %5: int = const 1
    %6: int = int.add %4, %5
    rebind %6, binding b0, target S0
    %7: int = const 2
    %8: bool = int.gt %6, %7
    cond %8, ^b6(%6), ^b7(%6)
    ^b5(%9: int) in S1 unwind ^b1:
    want %9
    exit.prepare next %9 at B1
    br ^b3(%9)
    ^b6(%10: int) in S2 unwind ^b1:
    want %10
    exit.prepare last %10 at B1
    br ^b2(%10)
    ^b7(%11: int) in S3 unwind ^b1:
    want %11
    exit.prepare fallthrough %11 at B2
    br ^b5(%11)
}
