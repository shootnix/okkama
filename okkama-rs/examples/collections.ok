module collections v1.0.0;

import "io/stdout" take Stdout;

// Arrays, maps, functional suffixes, index fallbacks, casts and unpacking.
// Prints two lines and exits with status 0.

object Stats {
    Stats();

    sum(values is ...int) is int {
        let all is @int = values...;
        all.reduce(0) -> total, value { total + value; };
    }
}

main() is int {
    let out = Stdout();
    let numbers = [1, 2, 3, 4, 5, 6];
    let squares = numbers.map() -> value { value * value; };
    let even = squares.filter() -> value { value % 2 == 0; };
    let ages is %string:int = ["ada": 36, "alan": 41];
    let missing = ages["grace"] else 0;
    let total = Stats().sum(even...);

    out <- @string(total, missing, ages["ada"] else 0)... <- endl;
    out <- @byte(104, 105) <- endl;
    confirm total == 56;
    0;
}
