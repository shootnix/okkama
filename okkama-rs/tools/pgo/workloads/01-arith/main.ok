module bench/arith v1.0.0;

// Целочисленная арифметика в цикле: линейный конгруэнтный генератор.
// Цикл — хвостовая рекурсия (исполняется циклом, §11.6.1).
import "io/stdout" take Stdout;

object Lcg {
    Lcg();

    run(left is int, state is int, sum is int) is int {
        if left == 0 {
            sum;
        } else {
            let following = (state * 1103515245 + 12345) % 2147483648;
            self.run(left - 1, following, sum + following % 1000);
        }
    }
}

main() is int {
    Stdout().writeln(Lcg().run(3000000, 42, 0).string());
    0;
}
