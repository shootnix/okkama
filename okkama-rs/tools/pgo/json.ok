// PGO training: JSON written, parsed and read back through codecs.
//
// Builds 3 000 orders in code, writes them compact and indented, parses the
// text and reads it back into orders. Prints a checksum so a broken build
// fails the training run.

module pgo/json;

import "json" take Json, JsonField, ParsedJson;
import "math/decimal" take Decimal;
import "io/stdout" take Stdout;

object Line {
    has sku is string;
    has qty is int;
    Line(:sku, :qty);
    sku() is string { sku; }
    quantity() is int { qty; }
}

object Order {
    has id is int;
    has name is string;
    has note is string;
    has total is Decimal;
    has paid is bool;
    has lines is @Line;
    Order(:id, :name, :note, :total, :paid, :lines);
    id() is int { id; }
    name() is string { name; }
    note() is string { note; }
    total() is Decimal { total; }
    paid() is bool { paid; }
    lines() is @Line { lines; }
    quantity() is int { lines.reduce(0) -> sum, line { sum + line.quantity(); }; }
}

object LineJson {
    LineJson();
    value(view is Json) is Line { Line(sku: view.text("sku"), qty: view.optional("qty").int(1)); }
    json(line is Line) is Json { Json([JsonField("sku", line.sku()), JsonField("qty", line.quantity())]); }
}

object OrderJson {
    OrderJson();

    value(view is Json) is Order {
        Order(
            id: view.int("id"),
            name: view.get("customer").text("name"),
            note: view.optional("note").text(""),
            total: view.number("total"),
            paid: view.optional("paid").boolean(false),
            lines: view.list("lines").map() -> line { LineJson().value(line); }
        );
    }

    json(order is Order) is Json {
        let lines is @Json = order.lines().map() -> line { LineJson().json(line); };
        Json([
            JsonField("id", order.id()),
            JsonField("customer", Json([JsonField("name", order.name())])),
            JsonField("note", order.note()),
            JsonField("total", order.total()),
            JsonField("paid", order.paid()),
            JsonField("tags", Json(items: [Json("a"), Json("b \"q\"\n")])),
            JsonField("lines", Json(items: lines))
        ]);
    }
}

main() is int {
    let orders is @Order = (0..3000).map() -> id {
        let lines is @Line = (0..(id % 4 + 1)).map() -> index { Line(sku: "SKU-" + index.string(), qty: index + 1); };
        Order(id: id, name: "Customer " + id.string(), note: if id % 3 == 0 { "gift"; } else { ""; },
            total: Decimal(id.string() + "." + (id % 100).string()), paid: id % 2 == 0, lines: lines);
    };
    let values is @Json = orders.map() -> order { OrderJson().json(order); };
    let text = Json(items: values).string();
    let decoded is @Order = ParsedJson(text).value().items().map() -> row { OrderJson().value(row); };
    let pretty = ParsedJson(text).value().pretty(2);
    let view = ParsedJson(pretty).value();
    let names = view.items().reduce(0) -> sum, row { sum + row.get("customer").text("name").length(); };
    let quantity = decoded.reduce(0) -> sum, order { sum + order.quantity(); };
    Stdout().writeln(decoded.size().string() + " " + quantity.string() + " " + names.string() + " "
        + ParsedJson(text).value().string().length().string());
    0;
}
